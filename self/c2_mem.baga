// c2_mem.baga — LP8-H: bump арена + mem_mark/rewind/persist за self.
// Моделът е src/codegen_c.c без --rc, опростен: няма per-alloc header и
// free-list (drop на str е no-op — данните живеят в арената). Rewind
// free()-ва ephemeral блоковете над mark-а; persist веригата не се пипа.
// concat/substr/chr/to_str минават през baga_alloc, иначе rewind не
// връща памет (историческият malloc runtime).

fn emit_mem_runtime() {
    write("typedef struct baga_ABlk { struct baga_ABlk *next; size_t used, cap; char data[]; } baga_ABlk;\n")
    write("static __thread baga_ABlk *baga_arena_head = NULL;\n")
    write("static __thread baga_ABlk *baga_persist_head = NULL;\n")
    write("static __thread int64_t baga_persist_depth = 0;\n")
    write("static void baga_mem_persist_begin(void) { baga_persist_depth++; }\n")
    write("static void baga_mem_persist_end(void) {\n")
    write("    if (baga_persist_depth <= 0) { fprintf(stderr, \"baga: mem_persist_end без mem_persist_begin\\n\"); exit(1); }\n")
    write("    baga_persist_depth--;\n")
    write("}\n")
    write("static void *baga_alloc(size_t n) {\n")
    write("    size_t an = (n + 15) & ~(size_t)15; if (an == 0) an = 16;\n")
    write("    int persist = baga_persist_depth > 0;\n")
    write("    baga_ABlk **hp = persist ? &baga_persist_head : &baga_arena_head;\n")
    write("    baga_ABlk *b = *hp;\n")
    write("    if (!b || b->used + an > b->cap) {\n")
    write("        size_t cap = an > 8192 ? an : 8192;\n")
    write("        b = (baga_ABlk *)malloc(sizeof(baga_ABlk) + cap);\n")
    write("        if (!b) { fprintf(stderr, \"baga: oom\\n\"); exit(1); }\n")
    write("        b->next = *hp; b->used = 0; b->cap = cap; *hp = b;\n")
    write("    }\n")
    write("    void *p = b->data + b->used; b->used += an; return p;\n")
    write("}\n")
    write("typedef struct { baga_ABlk *head; size_t used; } baga_MMark;\n")
    write("static int64_t baga_mem_mark(void) {\n")
    write("    baga_MMark *m = (baga_MMark *)malloc(sizeof(baga_MMark));\n")
    write("    if (!m) { fprintf(stderr, \"baga: mem_mark: няма памет\\n\"); exit(1); }\n")
    write("    m->head = baga_arena_head;\n")
    write("    m->used = baga_arena_head ? baga_arena_head->used : 0;\n")
    write("    return (int64_t)(intptr_t)m;\n")
    write("}\n")
    write("static void baga_mem_rewind(int64_t h) {\n")
    write("    baga_MMark *m = (baga_MMark *)(intptr_t)h;\n")
    write("    if (!m) { fprintf(stderr, \"baga: mem_rewind: невалиден mark\\n\"); exit(1); }\n")
    write("    baga_ABlk *b = baga_arena_head;\n")
    write("    while (b && b != m->head) {\n")
    write("        baga_ABlk *nx = b->next; free(b); b = nx;\n")
    write("    }\n")
    write("    if (b != m->head) {\n")
    write("        fprintf(stderr, \"baga: mem_rewind: mark не е в arena веригата (двоен rewind или нарушен LIFO ред)\\n\");\n")
    write("        exit(1);\n")
    write("    }\n")
    write("    baga_arena_head = m->head;\n")
    write("    if (m->head) m->head->used = m->used;\n")
    write("    free(m);\n")
    write("}\n")
    write("static int64_t baga_len(const char *s) { return (int64_t)strlen(s); }\n")
    write("static int64_t baga_char_at(const char *s, int64_t i) { return (int64_t)(unsigned char)s[i]; }\n")
    write("static int64_t baga_byte_at(const char *s, int64_t i) { return (int64_t)(unsigned char)s[i]; }\n")
    write("static const char *baga_byte_chr(int64_t c) { char *r = baga_alloc(2); r[0] = (char)c; r[1] = 0; return r; }\n")
    write("static const char *baga_substr(const char *s, int64_t a, int64_t b) {\n")
    write("    int64_t n = b - a; if (n < 0) n = 0;\n")
    write("    char *r = baga_alloc((size_t)n + 1); memcpy(r, s + a, (size_t)n); r[n] = 0; return r; }\n")
    write("static const char *baga_concat(const char *a, const char *b) {\n")
    write("    size_t la = strlen(a), lb = strlen(b);\n")
    write("    char *r = baga_alloc(la + lb + 1); memcpy(r, a, la); memcpy(r + la, b, lb + 1); return r; }\n")
    write("static int64_t baga_str_eq(const char *a, const char *b) { return strcmp(a, b) == 0; }\n")
    write("static const char *baga_chr(int64_t c) {\n")
    write("    char *r = baga_alloc(5);\n")
    write("    if (c < 0x80) { r[0] = (char)c; r[1] = 0; }\n")
    write("    else if (c < 0x800) { r[0] = (char)(0xC0|(c>>6)); r[1] = (char)(0x80|(c&0x3F)); r[2] = 0; }\n")
    write("    else if (c < 0x10000) { r[0] = (char)(0xE0|(c>>12)); r[1] = (char)(0x80|((c>>6)&0x3F)); r[2] = (char)(0x80|(c&0x3F)); r[3] = 0; }\n")
    write("    else { r[0] = (char)(0xF0|(c>>18)); r[1] = (char)(0x80|((c>>12)&0x3F)); r[2] = (char)(0x80|((c>>6)&0x3F)); r[3] = (char)(0x80|(c&0x3F)); r[4] = 0; }\n")
    write("    return r; }\n")
    write("static int64_t baga_ord(const char *s) {\n")
    write("    unsigned char c = (unsigned char)s[0]; if (!c) return 0;\n")
    write("    if (c < 0x80) return c;\n")
    write("    if ((c&0xE0)==0xC0) return ((int64_t)(c&0x1F)<<6)|((int64_t)(unsigned char)s[1]&0x3F);\n")
    write("    if ((c&0xF0)==0xE0) return ((int64_t)(c&0x0F)<<12)|(((int64_t)(unsigned char)s[1]&0x3F)<<6)|((int64_t)(unsigned char)s[2]&0x3F);\n")
    write("    return ((int64_t)(c&0x07)<<18)|(((int64_t)(unsigned char)s[1]&0x3F)<<12)|(((int64_t)(unsigned char)s[2]&0x3F)<<6)|((int64_t)(unsigned char)s[3]&0x3F); }\n")
    write("static const char *baga_i64_to_str(int64_t x) { char *r = baga_alloc(24); snprintf(r, 24, \"%lld\", (long long)x); return r; }\n")
    write("static const char *baga_f64_to_str(double x) { char *r = baga_alloc(32); snprintf(r, 32, \"%g\", x); return r; }\n")
}
