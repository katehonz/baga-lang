// compiler.baga — self-hosted компилатор на Бага
// Фаза 2: lexer + parser + codegen → C код
// Използване: ./baga self/compiler.baga
// Генерира /tmp/baga_out.c от examples/zdravei.baga

// ============================================================
//  AST builder (linked list)
// ============================================================

fn ast_kind(nk: Vec, nt: Vec, fc: Vec, ns: Vec, kind: i64, text: str) -> i64 {
    let idx = vec_len(nk)
    vec_push(nk, kind)
    vec_push_str(nt, text)
    vec_push(fc, 0 - 1)
    vec_push(ns, 0 - 1)
    idx
}

fn ast_child(fc: Vec, ns: Vec, parent: i64, child: i64) {
    vec_set(ns, child, 0 - 1)
    if vec_get(fc, parent) < 0 {
        vec_set(fc, parent, child)
    } else {
        let mut last = vec_get(fc, parent)
        while vec_get(ns, last) >= 0 {
            last = vec_get(ns, last)
        }
        vec_set(ns, last, child)
    }
}

fn first_child(fc: Vec, idx: i64) -> i64 { vec_get(fc, idx) }
fn next_sibling(ns: Vec, idx: i64) -> i64 { vec_get(ns, idx) }
fn node_kind(nk: Vec, idx: i64) -> i64 { vec_get(nk, idx) }
fn node_text(nt: Vec, idx: i64) -> str { vec_get_str(nt, idx) }

// ============================================================
//  Tokenizer
// ============================================================

fn is_digit(c: i64) -> i64 {
    if c >= 48 { if c <= 57 { return 1 } }
    0
}

fn is_alpha(c: i64) -> i64 {
    if c >= 97 { if c <= 122 { return 1 } }
    if c >= 65 { if c <= 90 { return 1 } }
    if c == 95 { return 1 }
    if c >= 128 { return 1 }
    0
}

fn is_alnum(c: i64) -> i64 {
    if is_alpha(c) == 1 { return 1 }
    is_digit(c)
}

fn kw_kind(s: str) -> i64 {
    if str_eq(s, "fn") { return 1 }
    if str_eq(s, "let") { return 2 }
    if str_eq(s, "mut") { return 3 }
    if str_eq(s, "if") { return 4 }
    if str_eq(s, "else") { return 5 }
    if str_eq(s, "while") { return 6 }
    if str_eq(s, "for") { return 7 }
    if str_eq(s, "in") { return 8 }
    if str_eq(s, "return") { return 9 }
    if str_eq(s, "true") { return 14 }
    if str_eq(s, "false") { return 15 }
    if str_eq(s, "break") { return 17 }
    if str_eq(s, "continue") { return 18 }
    if str_eq(s, "catch") { return 16 }
    0
}

fn tokenize(src: str, tk: Vec, tt: Vec) {
    let mut pos: i64 = 0
    let n = len(src)
    while pos < n {
        let c = char_at(src, pos)
        if c == 32 { pos = pos + 1; continue }
        if c == 10 { pos = pos + 1; continue }
        if c == 13 { pos = pos + 1; continue }
        if c == 9  { pos = pos + 1; continue }
        if c == 47 {
            if pos + 1 < n {
                if char_at(src, pos + 1) == 47 {
                    while pos < n {
                        if char_at(src, pos) == 10 { break }
                        pos = pos + 1
                    }
                    continue
                }
            }
        }
        if is_alpha(c) == 1 {
            let start = pos
            while pos < n {
                if is_alnum(char_at(src, pos)) == 1 { pos = pos + 1 } else { break }
            }
            let text = substr(src, start, pos)
            let kw = kw_kind(text)
            if kw > 0 { vec_push(tk, kw) } else { vec_push(tk, 0) }
            vec_push_str(tt, text)
            continue
        }
        if is_digit(c) == 1 {
            let start = pos
            while pos < n {
                if is_digit(char_at(src, pos)) == 1 { pos = pos + 1 } else { break }
            }
            let mut is_float: i64 = 0
            if pos + 1 < n {
                if char_at(src, pos) == 46 {
                    if is_digit(char_at(src, pos + 1)) == 1 {
                        is_float = 1
                        pos = pos + 1
                        while pos < n {
                            if is_digit(char_at(src, pos)) == 1 { pos = pos + 1 } else { break }
                        }
                    }
                }
            }
            if is_float == 1 { vec_push(tk, 102) } else { vec_push(tk, 100) }
            vec_push_str(tt, substr(src, start, pos))
            continue
        }
        if c == 34 {
            pos = pos + 1
            let mut sval = ""
            while pos < n {
                let sc = char_at(src, pos)
                if sc == 34 { break }
                if sc == 92 {
                    pos = pos + 1
                    let ec = char_at(src, pos)
                    let mut eh: i64 = 0
                    if ec == 110 { sval = concat(sval, chr(10)); eh = 1 }
                    if ec == 116 { sval = concat(sval, chr(9)); eh = 1 }
                    if ec == 92 { sval = concat(sval, chr(92)); eh = 1 }
                    if ec == 34 { sval = concat(sval, chr(34)); eh = 1 }
                    if eh == 0 { sval = concat(sval, chr(ec)) }
                } else {
                    sval = concat(sval, chr(sc))
                }
                pos = pos + 1
            }
            vec_push(tk, 101)
            vec_push_str(tt, sval)
            if pos < n { pos = pos + 1 }
            continue
        }
        if pos + 1 < n {
            let c2 = char_at(src, pos + 1)
            let mut h: i64 = 0
            if c == 45 { if c2 == 62 { vec_push(tk, 200); vec_push_str(tt, "->"); pos = pos + 2; h = 1 } }
            if c == 61 { if c2 == 61 { vec_push(tk, 201); vec_push_str(tt, "=="); pos = pos + 2; h = 1 } }
            if c == 33 { if c2 == 61 { vec_push(tk, 203); vec_push_str(tt, "!="); pos = pos + 2; h = 1 } }
            if c == 60 { if c2 == 61 { vec_push(tk, 204); vec_push_str(tt, "<="); pos = pos + 2; h = 1 } }
            if c == 62 { if c2 == 61 { vec_push(tk, 206); vec_push_str(tt, ">="); pos = pos + 2; h = 1 } }
            if c == 38 { if c2 == 38 { vec_push(tk, 208); vec_push_str(tt, "&&"); pos = pos + 2; h = 1 } }
            if c == 124 { if c2 == 124 { vec_push(tk, 209); vec_push_str(tt, "||"); pos = pos + 2; h = 1 } }
            if c == 46 { if c2 == 46 { vec_push(tk, 210); vec_push_str(tt, ".."); pos = pos + 2; h = 1 } }
            if c == 43 { if c2 == 61 { vec_push(tk, 211); vec_push_str(tt, "+="); pos = pos + 2; h = 1 } }
            if c == 45 { if c2 == 61 { vec_push(tk, 212); vec_push_str(tt, "-="); pos = pos + 2; h = 1 } }
            if c == 42 { if c2 == 61 { vec_push(tk, 213); vec_push_str(tt, "*="); pos = pos + 2; h = 1 } }
            if c == 47 { if c2 == 61 { vec_push(tk, 214); vec_push_str(tt, "/="); pos = pos + 2; h = 1 } }
            if h == 1 { continue }
        }
        vec_push(tk, 300)
        vec_push_str(tt, chr(c))
        pos = pos + 1
    }
    vec_push(tk, 999)
    vec_push_str(tt, "")
}

// ============================================================
//  Parser
// ============================================================

fn is_single(tk: Vec, tt: Vec, pos: i64, ch: str) -> i64 {
    if vec_get(tk, pos) == 300 {
        if str_eq(vec_get_str(tt, pos), ch) { return 1 }
    }
    0
}

fn parse_expr(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64

fn parse_primary(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let k = vec_get(tk, vec_get(pos, 0))
    let t = vec_get_str(tt, vec_get(pos, 0))
    if k == 100 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        return ast_kind(nk, nt, fc, ns, 0, t)
    }
    if k == 102 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        return ast_kind(nk, nt, fc, ns, 19, t)
    }
    if k == 101 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        return ast_kind(nk, nt, fc, ns, 1, t)
    }
    if k == 14 { vec_set(pos, 0, vec_get(pos, 0) + 1); return ast_kind(nk, nt, fc, ns, 20, "1") }
    if k == 15 { vec_set(pos, 0, vec_get(pos, 0) + 1); return ast_kind(nk, nt, fc, ns, 20, "0") }
    if k == 0 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        if str_eq(t, "match") == 1 {
            let scrut = parse_expr(tk, tt, pos, nk, nt, fc, ns)
            let mnode = ast_kind(nk, nt, fc, ns, 26, "")
            ast_child(fc, ns, mnode, scrut)
            if is_single(tk, tt, vec_get(pos, 0), "{") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
            while is_single(tk, tt, vec_get(pos, 0), "}") == 0 {
                if vec_get(tk, vec_get(pos, 0)) == 999 { break }
                let pat = parse_primary(tk, tt, pos, nk, nt, fc, ns)
                let mut is_wild: i64 = 0
                if node_kind(nk, pat) == 2 {
                    if str_eq(node_text(nt, pat), "_") == 1 { is_wild = 1 }
                }
                if is_single(tk, tt, vec_get(pos, 0), "=") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
                if is_single(tk, tt, vec_get(pos, 0), ">") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
                let body = parse_expr(tk, tt, pos, nk, nt, fc, ns)
                let mut atext = ""
                if is_wild == 1 { atext = "_" }
                let arm = ast_kind(nk, nt, fc, ns, 27, atext)
                if is_wild == 0 { ast_child(fc, ns, arm, pat) }
                ast_child(fc, ns, arm, body)
                ast_child(fc, ns, mnode, arm)
                if is_single(tk, tt, vec_get(pos, 0), ",") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
            }
            if is_single(tk, tt, vec_get(pos, 0), "}") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
            return mnode
        }
        let mut base = ast_kind(nk, nt, fc, ns, 2, t)
        if is_single(tk, tt, vec_get(pos, 0), "(") == 1 {
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            let call = ast_kind(nk, nt, fc, ns, 4, "")
            ast_child(fc, ns, call, base)
            if is_single(tk, tt, vec_get(pos, 0), ")") == 0 {
                let arg = parse_expr(tk, tt, pos, nk, nt, fc, ns)
                ast_child(fc, ns, call, arg)
                while is_single(tk, tt, vec_get(pos, 0), ",") == 1 {
                    vec_set(pos, 0, vec_get(pos, 0) + 1)
                    let a2 = parse_expr(tk, tt, pos, nk, nt, fc, ns)
                    ast_child(fc, ns, call, a2)
                }
            }
            if is_single(tk, tt, vec_get(pos, 0), ")") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
            base = call
        }
        if is_single(tk, tt, vec_get(pos, 0), "{") == 1 {
            let p1 = vec_get(pos, 0) + 1
            let p2 = vec_get(pos, 0) + 2
            let is_lit: i64 = 0
            if p2 < vec_len(tk) {
                if vec_get(tk, p1) == 0 {
                    if is_single(tk, tt, p2, ":") == 1 { is_lit = 1 }
                }
            }
            if is_lit == 1 {
                vec_set(pos, 0, vec_get(pos, 0) + 1)
                let lit = ast_kind(nk, nt, fc, ns, 22, t)
                while is_single(tk, tt, vec_get(pos, 0), "}") == 0 {
                    if vec_get(tk, vec_get(pos, 0)) == 999 { break }
                    let fname = vec_get_str(tt, vec_get(pos, 0))
                    vec_set(pos, 0, vec_get(pos, 0) + 1)
                    if is_single(tk, tt, vec_get(pos, 0), ":") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
                    let val = parse_expr(tk, tt, pos, nk, nt, fc, ns)
                    let fi = ast_kind(nk, nt, fc, ns, 24, fname)
                    ast_child(fc, ns, fi, val)
                    ast_child(fc, ns, lit, fi)
                    if is_single(tk, tt, vec_get(pos, 0), ",") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
                }
                if is_single(tk, tt, vec_get(pos, 0), "}") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
                base = lit
            }
        }
        while is_single(tk, tt, vec_get(pos, 0), ".") == 1 {
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            let fname = vec_get_str(tt, vec_get(pos, 0))
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            let fnode = ast_kind(nk, nt, fc, ns, 23, fname)
            ast_child(fc, ns, fnode, base)
            base = fnode
        }
        return base
    }
    if is_single(tk, tt, vec_get(pos, 0), "(") == 1 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let e = parse_expr(tk, tt, pos, nk, nt, fc, ns)
        if is_single(tk, tt, vec_get(pos, 0), ")") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
        return e
    }
    vec_set(pos, 0, vec_get(pos, 0) + 1)
    ast_kind(nk, nt, fc, ns, 0, "0")
}

fn parse_mul(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut left = parse_primary(tk, tt, pos, nk, nt, fc, ns)
    while vec_get(pos, 0) < vec_len(tk) {
        let mut op: str = ""
        if is_single(tk, tt, vec_get(pos, 0), "*") == 1 { op = "*" }
        if is_single(tk, tt, vec_get(pos, 0), "/") == 1 { op = "/" }
        if is_single(tk, tt, vec_get(pos, 0), "%") == 1 { op = "%" }
        if str_eq(op, "") == 1 { break }
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let right = parse_primary(tk, tt, pos, nk, nt, fc, ns)
        let node = ast_kind(nk, nt, fc, ns, 3, op)
        ast_child(fc, ns, node, left)
        ast_child(fc, ns, node, right)
        left = node
    }
    left
}

fn parse_add(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut left = parse_mul(tk, tt, pos, nk, nt, fc, ns)
    while vec_get(pos, 0) < vec_len(tk) {
        let mut op: str = ""
        if is_single(tk, tt, vec_get(pos, 0), "+") == 1 { op = "+" }
        if is_single(tk, tt, vec_get(pos, 0), "-") == 1 { op = "-" }
        if str_eq(op, "") == 1 { break }
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let right = parse_mul(tk, tt, pos, nk, nt, fc, ns)
        let node = ast_kind(nk, nt, fc, ns, 3, op)
        ast_child(fc, ns, node, left)
        ast_child(fc, ns, node, right)
        left = node
    }
    left
}

fn parse_cmp(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut left = parse_add(tk, tt, pos, nk, nt, fc, ns)
    while vec_get(pos, 0) < vec_len(tk) {
        let mut op: str = ""
        let k = vec_get(tk, vec_get(pos, 0))
        if k == 201 { op = "==" }
        if k == 203 { op = "!=" }
        if k == 204 { op = "<=" }
        if k == 206 { op = ">=" }
        if is_single(tk, tt, vec_get(pos, 0), "<") == 1 { op = "<" }
        if is_single(tk, tt, vec_get(pos, 0), ">") == 1 { op = ">" }
        if str_eq(op, "") == 1 { break }
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let right = parse_add(tk, tt, pos, nk, nt, fc, ns)
        let node = ast_kind(nk, nt, fc, ns, 3, op)
        ast_child(fc, ns, node, left)
        ast_child(fc, ns, node, right)
        left = node
    }
    left
}

fn parse_expr(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    parse_cmp(tk, tt, pos, nk, nt, fc, ns)
}

fn parse_block(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let block = ast_kind(nk, nt, fc, ns, 5, "")
    if is_single(tk, tt, vec_get(pos, 0), "{") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
    while vec_get(pos, 0) < vec_len(tk) {
        if is_single(tk, tt, vec_get(pos, 0), "}") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1); break }
        if vec_get(tk, vec_get(pos, 0)) == 999 { break }
        let s = parse_stmt(tk, tt, pos, nk, nt, fc, ns)
        ast_child(fc, ns, block, s)
    }
    block
}

fn parse_stmt(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let k = vec_get(tk, vec_get(pos, 0))
    if k == 2 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        if vec_get(tk, vec_get(pos, 0)) == 3 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
        let name = vec_get_str(tt, vec_get(pos, 0))
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        if is_single(tk, tt, vec_get(pos, 0), ":") == 1 {
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            let ltype = parse_type_name(tk, tt, pos)
        }
        if is_single(tk, tt, vec_get(pos, 0), "=") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
        let init = parse_expr(tk, tt, pos, nk, nt, fc, ns)
        // skip catch !E => handler (compile-time only)
        if vec_get(tk, vec_get(pos, 0)) == 16 {
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            if is_single(tk, tt, vec_get(pos, 0), "=") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
            if is_single(tk, tt, vec_get(pos, 0), ">") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
            let handler = parse_expr(tk, tt, pos, nk, nt, fc, ns)
        }
        let node = ast_kind(nk, nt, fc, ns, 6, name)
        ast_child(fc, ns, node, init)
        return node
    }
    if k == 9 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let node = ast_kind(nk, nt, fc, ns, 7, "")
        if is_single(tk, tt, vec_get(pos, 0), "}") == 0 {
            if vec_get(tk, vec_get(pos, 0)) != 999 {
                let val = parse_expr(tk, tt, pos, nk, nt, fc, ns)
                ast_child(fc, ns, node, val)
            }
        }
        return node
    }
    if k == 4 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let cond = parse_expr(tk, tt, pos, nk, nt, fc, ns)
        let then_br = parse_block(tk, tt, pos, nk, nt, fc, ns)
        let node = ast_kind(nk, nt, fc, ns, 8, "")
        ast_child(fc, ns, node, cond)
        ast_child(fc, ns, node, then_br)
        if vec_get(tk, vec_get(pos, 0)) == 5 {
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            let else_br = parse_block(tk, tt, pos, nk, nt, fc, ns)
            ast_child(fc, ns, node, else_br)
        }
        return node
    }
    if k == 6 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let cond = parse_expr(tk, tt, pos, nk, nt, fc, ns)
        let body = parse_block(tk, tt, pos, nk, nt, fc, ns)
        let node = ast_kind(nk, nt, fc, ns, 9, "")
        ast_child(fc, ns, node, cond)
        ast_child(fc, ns, node, body)
        return node
    }
    // break
    if k == 17 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        return ast_kind(nk, nt, fc, ns, 14, "")
    }
    // continue
    if k == 18 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        return ast_kind(nk, nt, fc, ns, 15, "")
    }
    // for i in lo..hi { body }
    if k == 7 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let var = vec_get_str(tt, vec_get(pos, 0))
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        // skip in
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let lo = parse_expr(tk, tt, pos, nk, nt, fc, ns)
        // skip ..
        if vec_get(tk, vec_get(pos, 0)) == 210 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
        let hi = parse_expr(tk, tt, pos, nk, nt, fc, ns)
        let body = parse_block(tk, tt, pos, nk, nt, fc, ns)
        let node = ast_kind(nk, nt, fc, ns, 18, var)
        ast_child(fc, ns, node, lo)
        ast_child(fc, ns, node, hi)
        ast_child(fc, ns, node, body)
        return node
    }
    let e = parse_expr(tk, tt, pos, nk, nt, fc, ns)
    // assignment: IDENT = expr
    if node_kind(nk, e) == 2 {
        if is_single(tk, tt, vec_get(pos, 0), "=") == 1 {
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            let val = parse_expr(tk, tt, pos, nk, nt, fc, ns)
            let anode = ast_kind(nk, nt, fc, ns, 17, node_text(nt, e))
            ast_child(fc, ns, anode, val)
            return anode
        }
        // compound assignment: IDENT += / -= / *= / /= expr  →  IDENT = IDENT op expr
        let ct = vec_get(tk, vec_get(pos, 0))
        let mut cop = ""
        if ct == 211 { cop = "+" }
        if ct == 212 { cop = "-" }
        if ct == 213 { cop = "*" }
        if ct == 214 { cop = "/" }
        if str_eq(cop, "") == 0 {
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            let val = parse_expr(tk, tt, pos, nk, nt, fc, ns)
            let anode = ast_kind(nk, nt, fc, ns, 17, node_text(nt, e))
            let binop = ast_kind(nk, nt, fc, ns, 3, cop)
            let lhs = ast_kind(nk, nt, fc, ns, 2, node_text(nt, e))
            ast_child(fc, ns, binop, lhs)
            ast_child(fc, ns, binop, val)
            ast_child(fc, ns, anode, binop)
            return anode
        }
    }
    // skip catch !E => handler (compile-time only)
    if vec_get(tk, vec_get(pos, 0)) == 16 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        if is_single(tk, tt, vec_get(pos, 0), "=") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
        if is_single(tk, tt, vec_get(pos, 0), ">") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
        let handler = parse_expr(tk, tt, pos, nk, nt, fc, ns)
    }
    let node = ast_kind(nk, nt, fc, ns, 10, "")
    ast_child(fc, ns, node, e)
    node
}

fn parse_struct(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    vec_set(pos, 0, vec_get(pos, 0) + 1)
    let name = vec_get_str(tt, vec_get(pos, 0))
    vec_set(pos, 0, vec_get(pos, 0) + 1)
    let node = ast_kind(nk, nt, fc, ns, 21, name)
    if is_single(tk, tt, vec_get(pos, 0), "{") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
    while is_single(tk, tt, vec_get(pos, 0), "}") == 0 {
        if vec_get(tk, vec_get(pos, 0)) == 999 { break }
        let fname = vec_get_str(tt, vec_get(pos, 0))
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        if is_single(tk, tt, vec_get(pos, 0), ":") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
        let ftype = vec_get_str(tt, vec_get(pos, 0))
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let fld = ast_kind(nk, nt, fc, ns, 25, concat(fname, concat(":", ftype)))
        ast_child(fc, ns, node, fld)
        if is_single(tk, tt, vec_get(pos, 0), ",") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
    }
    if is_single(tk, tt, vec_get(pos, 0), "}") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
    node
}

fn parse_enum(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    vec_set(pos, 0, vec_get(pos, 0) + 1)
    let name = vec_get_str(tt, vec_get(pos, 0))
    vec_set(pos, 0, vec_get(pos, 0) + 1)
    let node = ast_kind(nk, nt, fc, ns, 28, name)
    if is_single(tk, tt, vec_get(pos, 0), "{") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
    while is_single(tk, tt, vec_get(pos, 0), "}") == 0 {
        if vec_get(tk, vec_get(pos, 0)) == 999 { break }
        let vname = vec_get_str(tt, vec_get(pos, 0))
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let vn = ast_kind(nk, nt, fc, ns, 29, vname)
        ast_child(fc, ns, node, vn)
        if is_single(tk, tt, vec_get(pos, 0), ",") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
    }
    if is_single(tk, tt, vec_get(pos, 0), "}") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
    node
}

fn parse_type_name(tk: Vec, tt: Vec, pos: Vec) -> str {
    let name = vec_get_str(tt, vec_get(pos, 0))
    vec_set(pos, 0, vec_get(pos, 0) + 1)
    if is_single(tk, tt, vec_get(pos, 0), "<") == 1 {
        let mut depth: i64 = 0
        while vec_get(tk, vec_get(pos, 0)) != 999 {
            if is_single(tk, tt, vec_get(pos, 0), "<") == 1 { depth = depth + 1 }
            if is_single(tk, tt, vec_get(pos, 0), ">") == 1 { depth = depth - 1 }
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            if depth == 0 { break }
        }
    }
    name
}

fn parse_fn(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    vec_set(pos, 0, vec_get(pos, 0) + 1)
    let name = vec_get_str(tt, vec_get(pos, 0))
    vec_set(pos, 0, vec_get(pos, 0) + 1)
    let node = ast_kind(nk, nt, fc, ns, 11, name)
    if is_single(tk, tt, vec_get(pos, 0), "(") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
    while is_single(tk, tt, vec_get(pos, 0), ")") == 0 {
        if vec_get(tk, vec_get(pos, 0)) == 999 { break }
        let pname = vec_get_str(tt, vec_get(pos, 0))
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        if is_single(tk, tt, vec_get(pos, 0), ":") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
        let ptype = parse_type_name(tk, tt, pos)
        let param = ast_kind(nk, nt, fc, ns, 12, concat(pname, concat(":", ptype)))
        ast_child(fc, ns, node, param)
        if is_single(tk, tt, vec_get(pos, 0), ",") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
    }
    if is_single(tk, tt, vec_get(pos, 0), ")") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
    if vec_get(tk, vec_get(pos, 0)) == 200 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let rettype = parse_type_name(tk, tt, pos)
        let tnode = ast_kind(nk, nt, fc, ns, 16, rettype)
        ast_child(fc, ns, node, tnode)
    }
    // forward declaration: no body if next token is not {
    if is_single(tk, tt, vec_get(pos, 0), "{") == 0 {
        return node
    }
    let body = parse_block(tk, tt, pos, nk, nt, fc, ns)
    ast_child(fc, ns, node, body)
    node
}

// ============================================================
//  Codegen: AST → C
// ============================================================

fn int_to_str(n: i64) -> str {
    if n == 0 { return "0" }
    let mut result = ""
    let mut v = n
    while v > 0 {
        let d = v - (v / 10) * 10
        result = concat(chr(48 + d), result)
        v = v / 10
    }
    result
}

fn mangle(name: str) -> str {
    let mut result = "b_"
    let mut i: i64 = 0
    let n = len(name)
    while i < n {
        let c = char_at(name, i)
        if c >= 97 { if c <= 122 { result = concat(result, chr(c)); i = i + 1; continue } }
        if c >= 65 { if c <= 90 { result = concat(result, chr(c)); i = i + 1; continue } }
        if c >= 48 { if c <= 57 { result = concat(result, chr(c)); i = i + 1; continue } }
        if c == 95 { result = concat(result, "_"); i = i + 1; continue }
        result = concat(result, concat("_", int_to_str(c)))
        i = i + 1
    }
    result
}

fn indent_str(depth: i64) -> str {
    let mut s = ""
    let mut i: i64 = 0
    while i < depth {
        s = concat(s, "    ")
        i = i + 1
    }
    s
}

fn c_escape(s: str) -> str {
    let mut result = ""
    let mut i: i64 = 0
    let n = len(s)
    let bs = chr(92)
    while i < n {
        let c = char_at(s, i)
        let mut handled: i64 = 0
        if c == 34 { result = concat(result, concat(bs, chr(34))); handled = 1 }
        if c == 92 { result = concat(result, concat(bs, bs)); handled = 1 }
        if c == 10 { result = concat(result, concat(bs, "x0a")); handled = 1 }
        if c == 9 { result = concat(result, concat(bs, "x09")); handled = 1 }
        if handled == 0 { result = concat(result, chr(c)) }
        i = i + 1
    }
    result
}

fn enum_variant_cname(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, name: str) -> str {
    let mut e = first_child(fc, prog)
    while e >= 0 {
        if node_kind(nk, e) == 28 {
            let mut v = first_child(fc, e)
            while v >= 0 {
                if str_eq(node_text(nt, v), name) == 1 {
                    return concat(concat(mangle(node_text(nt, e)), "_"), mangle(name))
                }
                v = next_sibling(ns, v)
            }
        }
        e = next_sibling(ns, e)
    }
    ""
}

fn emit_expr(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, idx: i64) -> str {
    let k = node_kind(nk, idx)
    let t = node_text(nt, idx)

    // INT
    if k == 0 { return concat(t, "LL") }
    // FLOAT (суров текст — валиден C double литерал)
    if k == 19 { return t }
    // BOOL (1/0 като C int)
    if k == 20 { return t }
    // STRUCT LIT: (b_Име){ .b_поле = стойност, ... }
    if k == 22 {
        let mut r = concat(concat("(", mangle(t)), "){ ")
        let mut fi = first_child(fc, idx)
        let mut first_f: i64 = 1
        while fi >= 0 {
            if first_f == 0 { r = concat(r, ", ") }
            let val = first_child(fc, fi)
            r = concat(concat(concat(r, "."), concat(mangle(node_text(nt, fi)), " = ")), emit_expr(nk, nt, fc, ns, prog, val))
            first_f = 0
            fi = next_sibling(ns, fi)
        }
        return concat(r, " }")
    }
    // FIELD ACCESS: obj.b_поле
    if k == 23 {
        let obj = first_child(fc, idx)
        return concat(concat(emit_expr(nk, nt, fc, ns, prog, obj), "."), mangle(t))
    }
    // MATCH: GCC statement expression ({ T _mrN=0; int64_t _mvN=e; if..else..; _mrN; })
    if k == 26 {
        let mexpr = first_child(fc, idx)
        let arm1 = next_sibling(ns, mexpr)
        let mut ctype = "int64_t"
        if arm1 >= 0 {
            let mut b1 = first_child(fc, arm1)
            if str_eq(node_text(nt, arm1), "_") == 0 { b1 = next_sibling(ns, b1) }
            if b1 >= 0 {
                if expr_is_str(nk, nt, fc, ns, prog, b1) == 1 { ctype = "const char *" }
                else {
                    if expr_is_float(nk, nt, fc, ns, prog, b1) == 1 { ctype = "double" }
                    else { if expr_is_bool(nk, nt, fc, ns, prog, b1) == 1 { ctype = "int" } }
                }
            }
        }
        let suf = int_to_str(idx)
        let mut r = concat(concat(concat(concat(concat("({ ", ctype), concat(" _mr", suf)), concat(" = 0; int64_t _mv", suf)), " = "), concat(emit_expr(nk, nt, fc, ns, prog, mexpr), "; "))
        let mut arm = arm1
        let mut first_arm: i64 = 1
        while arm >= 0 {
            let mut abody = first_child(fc, arm)
            if str_eq(node_text(nt, arm), "_") == 1 {
                r = concat(r, "else { ")
            } else {
                let pat = abody
                abody = next_sibling(ns, pat)
                if first_arm == 0 { r = concat(r, "else ") }
                r = concat(concat(concat(concat(concat(r, "if (_mv"), suf), " == "), emit_expr(nk, nt, fc, ns, prog, pat)), ") { ")
            }
            r = concat(concat(concat(concat(r, "_mr"), suf), " = "), concat(emit_expr(nk, nt, fc, ns, prog, abody), "; } "))
            first_arm = 0
            arm = next_sibling(ns, arm)
        }
        return concat(concat(concat(r, "_mr"), suf), "; })")
    }
    // STR
    if k == 1 { return concat(concat("\"", c_escape(t)), "\"") }
    // IDENT (enum вариант → константа, иначе mangle)
    if k == 2 {
        let ev = enum_variant_cname(nk, nt, fc, ns, prog, t)
        if str_eq(ev, "") == 0 { return ev }
        return mangle(t)
    }
    // BINARY
    if k == 3 {
        let left = first_child(fc, idx)
        let right = next_sibling(ns, left)
        return concat(concat(concat("(", emit_expr(nk, nt, fc, ns, prog, left)), concat(" ", t)), concat(" ", concat(emit_expr(nk, nt, fc, ns, prog, right), ")")))
    }
    // CALL
    if k == 4 {
        let callee = first_child(fc, idx)
        // check for builtin
        let mut cname = ""
        if node_kind(nk, callee) == 2 {
            let bn = node_text(nt, callee)
            let a1 = next_sibling(ns, callee)
            if str_eq(bn, "len") == 1 { cname = "baga_len" }
            if str_eq(bn, "char_at") == 1 { cname = "baga_char_at" }
            if str_eq(bn, "substr") == 1 { cname = "baga_substr" }
            if str_eq(bn, "concat") == 1 { cname = "baga_concat" }
            if str_eq(bn, "str_eq") == 1 { cname = "baga_str_eq" }
            if str_eq(bn, "chr") == 1 { cname = "baga_chr" }
            if str_eq(bn, "ord") == 1 { cname = "baga_ord" }
            if str_eq(bn, "read_file") == 1 { cname = "baga_read_file" }
            if str_eq(bn, "write") == 1 { cname = "baga_write" }
            if str_eq(bn, "vec_new") == 1 { cname = "baga_vec_new" }
            if str_eq(bn, "vec_push") == 1 {
                cname = "baga_vec_push_i64"
                if a1 >= 0 {
                    let elem = next_sibling(ns, a1)
                    if elem >= 0 {
                        if expr_is_str(nk, nt, fc, ns, prog, elem) == 1 { cname = "baga_vec_push_str" }
                    }
                }
            }
            if str_eq(bn, "vec_push_str") == 1 { cname = "baga_vec_push_str" }
            if str_eq(bn, "vec_get") == 1 {
                cname = "baga_vec_get_i64"
                if a1 >= 0 {
                    if vec_is_str(nk, nt, fc, ns, prog, a1) == 1 { cname = "baga_vec_get_str" }
                }
            }
            if str_eq(bn, "vec_get_str") == 1 { cname = "baga_vec_get_str" }
            if str_eq(bn, "vec_set") == 1 {
                cname = "baga_vec_set_i64"
                if a1 >= 0 {
                    let ai = next_sibling(ns, a1)
                    let elem = next_sibling(ns, ai)
                    if elem >= 0 {
                        if expr_is_str(nk, nt, fc, ns, prog, elem) == 1 { cname = "baga_vec_set_str" }
                    }
                }
            }
            if str_eq(bn, "vec_set_str") == 1 { cname = "baga_vec_set_str" }
            if str_eq(bn, "vec_len") == 1 { cname = "baga_vec_len" }
            if str_eq(bn, "arg_count") == 1 { cname = "baga_arg_count" }
            if str_eq(bn, "arg") == 1 { cname = "baga_arg" }
        }
        let mut result = ""
        if str_eq(cname, "") == 0 {
            result = concat(cname, "(")
        } else {
            result = concat(emit_expr(nk, nt, fc, ns, prog, callee), "(")
        }
        let mut arg = next_sibling(ns, callee)
        let mut first_arg: i64 = 1
        while arg >= 0 {
            if first_arg == 0 { result = concat(result, ", ") }
            result = concat(result, emit_expr(nk, nt, fc, ns, prog, arg))
            first_arg = 0
            arg = next_sibling(ns, arg)
        }
        return concat(result, ")")
    }
    "0"
}

fn fn_ret_c_type(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, fname: str) -> str {
    let mut f = first_child(fc, prog)
    while f >= 0 {
        if node_kind(nk, f) == 11 {
            if str_eq(node_text(nt, f), fname) == 1 {
                let mut c = first_child(fc, f)
                while c >= 0 {
                    if node_kind(nk, c) == 16 { return c_type(node_text(nt, c)) }
                    c = next_sibling(ns, c)
                }
                return "int64_t"
            }
        }
        f = next_sibling(ns, f)
    }
    "int64_t"
}

fn expr_is_str(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, idx: i64) -> i64 {
    let k = node_kind(nk, idx)
    if k == 1 { return 1 }
    if k == 4 {
        let cal = first_child(fc, idx)
        if node_kind(nk, cal) == 2 {
            let bn = node_text(nt, cal)
            if str_eq(bn, "concat") == 1 { return 1 }
            if str_eq(bn, "substr") == 1 { return 1 }
            if str_eq(bn, "chr") == 1 { return 1 }
            if str_eq(bn, "read_file") == 1 { return 1 }
            if str_eq(bn, "arg") == 1 { return 1 }
            if str_eq(bn, "vec_get_str") == 1 { return 1 }
            if str_eq(bn, "vec_get") == 1 {
                let va1 = next_sibling(ns, cal)
                if va1 >= 0 {
                    if vec_is_str(nk, nt, fc, ns, prog, va1) == 1 { return 1 }
                }
            }
            let rt = fn_ret_c_type(nk, nt, fc, ns, prog, bn)
            if str_eq(rt, "const char *") == 1 { return 1 }
        }
    }
    if k == 2 {
        let vname = node_text(nt, idx)
        let mut f = first_child(fc, prog)
        while f >= 0 {
            if node_kind(nk, f) == 11 {
                let mut c = first_child(fc, f)
                while c >= 0 {
                    if node_kind(nk, c) == 5 {
                        let mut s = first_child(fc, c)
                        while s >= 0 {
                            if node_kind(nk, s) == 6 {
                                if str_eq(node_text(nt, s), vname) == 1 {
                                    let init = first_child(fc, s)
                                    return expr_is_str(nk, nt, fc, ns, prog, init)
                                }
                            }
                            s = next_sibling(ns, s)
                        }
                    }
                    c = next_sibling(ns, c)
                }
            }
            f = next_sibling(ns, f)
        }
    }
    0
}

fn expr_is_float(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, idx: i64) -> i64 {
    let k = node_kind(nk, idx)
    if k == 19 { return 1 }
    if k == 3 {
        let left = first_child(fc, idx)
        let right = next_sibling(ns, left)
        if expr_is_float(nk, nt, fc, ns, prog, left) == 1 { return 1 }
        if expr_is_float(nk, nt, fc, ns, prog, right) == 1 { return 1 }
        return 0
    }
    if k == 4 {
        let cal = first_child(fc, idx)
        if node_kind(nk, cal) == 2 {
            let bn = node_text(nt, cal)
            let rt = fn_ret_c_type(nk, nt, fc, ns, prog, bn)
            if str_eq(rt, "double") == 1 { return 1 }
        }
        return 0
    }
    if k == 2 {
        let vname = node_text(nt, idx)
        let mut f = first_child(fc, prog)
        while f >= 0 {
            if node_kind(nk, f) == 11 {
                let mut c = first_child(fc, f)
                while c >= 0 {
                    if node_kind(nk, c) == 5 {
                        let mut s = first_child(fc, c)
                        while s >= 0 {
                            if node_kind(nk, s) == 6 {
                                if str_eq(node_text(nt, s), vname) == 1 {
                                    let init = first_child(fc, s)
                                    return expr_is_float(nk, nt, fc, ns, prog, init)
                                }
                            }
                            s = next_sibling(ns, s)
                        }
                    }
                    c = next_sibling(ns, c)
                }
            }
            f = next_sibling(ns, f)
        }
    }
    0
}

fn expr_is_bool(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, idx: i64) -> i64 {
    let k = node_kind(nk, idx)
    if k == 20 { return 1 }
    if k == 3 {
        let op = node_text(nt, idx)
        if str_eq(op, "==") == 1 { return 1 }
        if str_eq(op, "!=") == 1 { return 1 }
        if str_eq(op, "<") == 1 { return 1 }
        if str_eq(op, ">") == 1 { return 1 }
        if str_eq(op, "<=") == 1 { return 1 }
        if str_eq(op, ">=") == 1 { return 1 }
        if str_eq(op, "&&") == 1 { return 1 }
        if str_eq(op, "||") == 1 { return 1 }
        return 0
    }
    if k == 4 {
        let cal = first_child(fc, idx)
        if node_kind(nk, cal) == 2 {
            let bn = node_text(nt, cal)
            if str_eq(bn, "str_eq") == 1 { return 1 }
            let rt = fn_ret_c_type(nk, nt, fc, ns, prog, bn)
            if str_eq(rt, "int") == 1 { return 1 }
        }
        return 0
    }
    if k == 2 {
        let vname = node_text(nt, idx)
        let mut f = first_child(fc, prog)
        while f >= 0 {
            if node_kind(nk, f) == 11 {
                let mut c = first_child(fc, f)
                while c >= 0 {
                    if node_kind(nk, c) == 5 {
                        let mut s = first_child(fc, c)
                        while s >= 0 {
                            if node_kind(nk, s) == 6 {
                                if str_eq(node_text(nt, s), vname) == 1 {
                                    let init = first_child(fc, s)
                                    return expr_is_bool(nk, nt, fc, ns, prog, init)
                                }
                            }
                            s = next_sibling(ns, s)
                        }
                    }
                    c = next_sibling(ns, c)
                }
            }
            f = next_sibling(ns, f)
        }
    }
    0
}

fn vec_is_str(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, vnode: i64) -> i64 {
    if node_kind(nk, vnode) != 2 { return 0 }
    let vname = node_text(nt, vnode)
    let mut f = first_child(fc, prog)
    while f >= 0 {
        if node_kind(nk, f) == 11 {
            let mut c = first_child(fc, f)
            while c >= 0 {
                if node_kind(nk, c) == 5 {
                    let mut s = first_child(fc, c)
                    while s >= 0 {
                        if node_kind(nk, s) == 10 {
                            let e = first_child(fc, s)
                            if node_kind(nk, e) == 4 {
                                let cal = first_child(fc, e)
                                if node_kind(nk, cal) == 2 {
                                    let bn = node_text(nt, cal)
                                    let a1 = next_sibling(ns, cal)
                                    if a1 >= 0 {
                                        if node_kind(nk, a1) == 2 {
                                            if str_eq(node_text(nt, a1), vname) == 1 {
                                                if str_eq(bn, "vec_push_str") == 1 { return 1 }
                                                if str_eq(bn, "vec_set_str") == 1 { return 1 }
                                                if str_eq(bn, "vec_push") == 1 {
                                                    let elem = next_sibling(ns, a1)
                                                    if elem >= 0 {
                                                        if expr_is_str(nk, nt, fc, ns, prog, elem) == 1 { return 1 }
                                                    }
                                                }
                                                if str_eq(bn, "vec_set") == 1 {
                                                    let ai = next_sibling(ns, a1)
                                                    let elem = next_sibling(ns, ai)
                                                    if elem >= 0 {
                                                        if expr_is_str(nk, nt, fc, ns, prog, elem) == 1 { return 1 }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        s = next_sibling(ns, s)
                    }
                }
                c = next_sibling(ns, c)
            }
        }
        f = next_sibling(ns, f)
    }
    0
}

fn emit_stmt(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, idx: i64, depth: i64) {
    let k = node_kind(nk, idx)
    let ind = indent_str(depth)

    // BLOCK
    if k == 5 {
        write(concat(ind, "{\n"))
        let mut child = first_child(fc, idx)
        while child >= 0 {
            emit_stmt(nk, nt, fc, ns, prog, child, depth + 1)
            child = next_sibling(ns, child)
        }
        write(concat(ind, "}\n"))
        return
    }
    // LET
    if k == 6 {
        let init = first_child(fc, idx)
        // detect type from init expression
        let mut ctype = "int64_t"
        if node_kind(nk, init) == 1 { ctype = "const char *" }
        if node_kind(nk, init) == 22 { ctype = mangle(node_text(nt, init)) }
        if node_kind(nk, init) == 4 {
            let cal = first_child(fc, init)
            if node_kind(nk, cal) == 2 {
                let bn = node_text(nt, cal)
                if str_eq(bn, "concat") == 1 { ctype = "const char *" }
                if str_eq(bn, "substr") == 1 { ctype = "const char *" }
                if str_eq(bn, "chr") == 1 { ctype = "const char *" }
                if str_eq(bn, "read_file") == 1 { ctype = "const char *" }
                if str_eq(bn, "arg") == 1 { ctype = "const char *" }
                if str_eq(bn, "vec_get_str") == 1 { ctype = "const char *" }
                if str_eq(bn, "vec_new") == 1 { ctype = "baga_Vec *" }
                // user function: look up return type
                let rt = fn_ret_c_type(nk, nt, fc, ns, prog, bn)
                if str_eq(rt, "const char *") == 1 { ctype = "const char *" }
                if str_eq(rt, "baga_Vec *") == 1 { ctype = "baga_Vec *" }
            }
        }
        if expr_is_float(nk, nt, fc, ns, prog, init) == 1 { ctype = "double" }
        write(concat(concat(concat(concat(ind, concat(ctype, " ")), mangle(node_text(nt, idx))), " = "), concat(emit_expr(nk, nt, fc, ns, prog, init), ";\n")))
        return
    }
    // RETURN
    if k == 7 {
        let val = first_child(fc, idx)
        if val >= 0 {
            write(concat(concat(ind, "return "), concat(emit_expr(nk, nt, fc, ns, prog, val), ";\n")))
        } else {
            write(concat(ind, "return;\n"))
        }
        return
    }
    // IF
    if k == 8 {
        let cond = first_child(fc, idx)
        let then_br = next_sibling(ns, cond)
        let else_br = next_sibling(ns, then_br)
        write(concat(concat(ind, "if ("), concat(emit_expr(nk, nt, fc, ns, prog, cond), ") {\n")))
        let mut s = first_child(fc, then_br)
        while s >= 0 {
            emit_stmt(nk, nt, fc, ns, prog, s, depth + 1)
            s = next_sibling(ns, s)
        }
        if else_br >= 0 {
            write(concat(ind, "} else {\n"))
            let mut s2 = first_child(fc, else_br)
            while s2 >= 0 {
                emit_stmt(nk, nt, fc, ns, prog, s2, depth + 1)
                s2 = next_sibling(ns, s2)
            }
        }
        write(concat(ind, "}\n"))
        return
    }
    // WHILE
    if k == 9 {
        let cond = first_child(fc, idx)
        let body = next_sibling(ns, cond)
        write(concat(concat(ind, "while ("), concat(emit_expr(nk, nt, fc, ns, prog, cond), ") {\n")))
        let mut s = first_child(fc, body)
        while s >= 0 {
            emit_stmt(nk, nt, fc, ns, prog, s, depth + 1)
            s = next_sibling(ns, s)
        }
        write(concat(ind, "}\n"))
        return
    }
    // EXPR_STMT
    if k == 10 {
        let e = first_child(fc, idx)
        // check for print call
        if node_kind(nk, e) == 4 {
            let callee = first_child(fc, e)
            if node_kind(nk, callee) == 2 {
                let cname2 = node_text(nt, callee)
                if str_eq(cname2, "print") == 1 {
                    let arg = next_sibling(ns, callee)
                    if arg >= 0 {
                        if expr_is_str(nk, nt, fc, ns, prog, arg) == 1 {
                            write(concat(concat(ind, "printf(\"%s\\n\", "), concat(emit_expr(nk, nt, fc, ns, prog, arg), ");\n")))
                        } else {
                            if expr_is_float(nk, nt, fc, ns, prog, arg) == 1 {
                                write(concat(concat(ind, "printf(\"%g\\n\", "), concat(emit_expr(nk, nt, fc, ns, prog, arg), ");\n")))
                            } else {
                                if expr_is_bool(nk, nt, fc, ns, prog, arg) == 1 {
                                    write(concat(concat(ind, "printf(\"%s\\n\", ("), concat(emit_expr(nk, nt, fc, ns, prog, arg), ") ? \"true\" : \"false\");\n")))
                                } else {
                                    write(concat(concat(ind, "printf(\"%lld\\n\", (long long)("), concat(emit_expr(nk, nt, fc, ns, prog, arg), "));\n")))
                                }
                            }
                        }
                    } else {
                        write(concat(ind, "printf(\"\\n\");\n"))
                    }
                    return
                }
            }
        }
        write(concat(concat(ind, emit_expr(nk, nt, fc, ns, prog, e)), ";\n"))
        return
    }
    // BREAK
    if k == 14 {
        write(concat(ind, "break;\n"))
        return
    }
    // CONTINUE
    if k == 15 {
        write(concat(ind, "continue;\n"))
        return
    }
    // ASSIGN
    if k == 17 {
        let val = first_child(fc, idx)
        write(concat(concat(concat(ind, mangle(node_text(nt, idx))), " = "), concat(emit_expr(nk, nt, fc, ns, prog, val), ";\n")))
        return
    }
    // FOR
    if k == 18 {
        let lo = first_child(fc, idx)
        let hi = next_sibling(ns, lo)
        let body = next_sibling(ns, hi)
        let v = mangle(node_text(nt, idx))
        write(concat(concat(concat(concat(ind, "for (int64_t "), v), " = "), concat(emit_expr(nk, nt, fc, ns, prog, lo), "; ")))
        write(concat(concat(concat(v, " < "), emit_expr(nk, nt, fc, ns, prog, hi)), concat("; ", concat(v, "++) {\n"))))
        let mut s = first_child(fc, body)
        while s >= 0 {
            emit_stmt(nk, nt, fc, ns, prog, s, depth + 1)
            s = next_sibling(ns, s)
        }
        write(concat(ind, "}\n"))
        return
    }
}

fn c_type(t: str) -> str {
    if str_eq(t, "i64") == 1 { return "int64_t" }
    if str_eq(t, "str") == 1 { return "const char *" }
    if str_eq(t, "Vec") == 1 { return "baga_Vec *" }
    if str_eq(t, "f64") == 1 { return "double" }
    if str_eq(t, "bool") == 1 { return "int" }
    if str_eq(t, "") == 1 { return "int64_t" }
    mangle(t)
}

fn emit_fn(nk: Vec, nt: Vec, fc: Vec, ns: Vec, idx: i64) {
    let name = node_text(nt, idx)
    let mut child = first_child(fc, idx)

    let mut params = ""
    let mut rettype = "void"
    while child >= 0 {
        let ck = node_kind(nk, child)
        if ck == 12 {
            let ptext = node_text(nt, child)
            let mut ci: i64 = 0
            let pn = len(ptext)
            while ci < pn {
                if char_at(ptext, ci) == 58 { break }
                ci = ci + 1
            }
            let pname = substr(ptext, 0, ci)
            let mut ptype = "i64"
            if ci + 1 < pn { ptype = substr(ptext, ci + 1, pn) }
            if str_eq(params, "") == 0 { params = concat(params, ", ") }
            params = concat(params, concat(c_type(ptype), concat(" ", mangle(pname))))
        }
        if ck == 16 { rettype = c_type(node_text(nt, child)) }
        child = next_sibling(ns, child)
    }

    if str_eq(params, "") == 1 { params = "void" }
    write(concat(concat(concat(concat(rettype, " "), mangle(name)), concat("(", params)), ");\n"))
}

fn emit_fn_def(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, idx: i64) {
    let name = node_text(nt, idx)
    let mut child = first_child(fc, idx)

    let mut params = ""
    let mut rettype = "void"
    let mut body: i64 = 0 - 1
    while child >= 0 {
        let ck = node_kind(nk, child)
        if ck == 12 {
            let ptext = node_text(nt, child)
            let mut ci: i64 = 0
            let pn = len(ptext)
            while ci < pn {
                if char_at(ptext, ci) == 58 { break }
                ci = ci + 1
            }
            let pname = substr(ptext, 0, ci)
            let mut ptype = "i64"
            if ci + 1 < pn { ptype = substr(ptext, ci + 1, pn) }
            if str_eq(params, "") == 0 { params = concat(params, ", ") }
            params = concat(params, concat(c_type(ptype), concat(" ", mangle(pname))))
        }
        if ck == 16 { rettype = c_type(node_text(nt, child)) }
        if ck == 5 { body = child }
        child = next_sibling(ns, child)
    }

    if str_eq(params, "") == 1 { params = "void" }
    write(concat(concat(concat(concat(rettype, " "), mangle(name)), concat("(", params)), ") {\n"))

    // emit body statements
    if body >= 0 {
        let mut s = first_child(fc, body)
        while s >= 0 {
            let next_s = next_sibling(ns, s)
            // implicit return: last expr stmt in non-void fn
            if next_s < 0 {
                if str_eq(rettype, "void") == 0 {
                    if node_kind(nk, s) == 10 {
                        let e = first_child(fc, s)
                        write(concat("    return ", concat(emit_expr(nk, nt, fc, ns, prog, e), ";\n")))
                        s = next_s
                        continue
                    }
                }
            }
            emit_stmt(nk, nt, fc, ns, prog, s, 1)
            s = next_s
        }
    }

    write("}\n\n")
}

// ============================================================
//  Main
// ============================================================

fn main() {
    let src = read_file(arg(0)) catch !IO => ""

    let tk = vec_new()
    let tt = vec_new()
    tokenize(src, tk, tt)

    let nk = vec_new()
    let nt = vec_new()
    let fc = vec_new()
    let ns = vec_new()

    let prog = ast_kind(nk, nt, fc, ns, 13, "")
    let pos = vec_new()
    vec_push(pos, 0)

    let mut iterations: i64 = 0
    while vec_get(tk, vec_get(pos, 0)) != 999 {
        iterations = iterations + 1
        if iterations > 100000 { break }
        if vec_get(tk, vec_get(pos, 0)) == 1 {
            let f = parse_fn(tk, tt, pos, nk, nt, fc, ns)
            ast_child(fc, ns, prog, f)
        } else {
            if vec_get(tk, vec_get(pos, 0)) == 0 {
                if str_eq(vec_get_str(tt, vec_get(pos, 0)), "struct") == 1 {
                    let s = parse_struct(tk, tt, pos, nk, nt, fc, ns)
                    ast_child(fc, ns, prog, s)
                } else {
                    if str_eq(vec_get_str(tt, vec_get(pos, 0)), "enum") == 1 {
                        let en = parse_enum(tk, tt, pos, nk, nt, fc, ns)
                        ast_child(fc, ns, prog, en)
                    } else {
                        if str_eq(vec_get_str(tt, vec_get(pos, 0)), "spec") == 1 {
                            vec_set(pos, 0, vec_get(pos, 0) + 1)
                            vec_set(pos, 0, vec_get(pos, 0) + 1)
                            if is_single(tk, tt, vec_get(pos, 0), "{") == 1 {
                                let mut depth: i64 = 0
                                while vec_get(tk, vec_get(pos, 0)) != 999 {
                                    if is_single(tk, tt, vec_get(pos, 0), "{") == 1 { depth = depth + 1 }
                                    if is_single(tk, tt, vec_get(pos, 0), "}") == 1 { depth = depth - 1 }
                                    vec_set(pos, 0, vec_get(pos, 0) + 1)
                                    if depth == 0 { break }
                                }
                            }
                        } else {
                            vec_set(pos, 0, vec_get(pos, 0) + 1)
                        }
                    }
                }
            } else {
                vec_set(pos, 0, vec_get(pos, 0) + 1)
            }
        }
    }

    // emit C code
    write("/* Генериран от Бага self-hosted компилатор */\n")
    write("#include <stdio.h>\n")
    write("#include <stdlib.h>\n")
    write("#include <stdint.h>\n")
    write("#include <string.h>\n\n")
    // runtime helpers
    write("static int64_t baga_len(const char *s) { return (int64_t)strlen(s); }\n")
    write("static int64_t baga_char_at(const char *s, int64_t i) { return (int64_t)(unsigned char)s[i]; }\n")
    write("static const char *baga_substr(const char *s, int64_t a, int64_t b) {\n")
    write("    int64_t n = b - a; if (n < 0) n = 0;\n")
    write("    char *r = malloc((size_t)n + 1); memcpy(r, s + a, (size_t)n); r[n] = 0; return r; }\n")
    write("static const char *baga_concat(const char *a, const char *b) {\n")
    write("    size_t la = strlen(a), lb = strlen(b);\n")
    write("    char *r = malloc(la + lb + 1); memcpy(r, a, la); memcpy(r + la, b, lb + 1); return r; }\n")
    write("static int64_t baga_str_eq(const char *a, const char *b) { return strcmp(a, b) == 0; }\n")
    write("static const char *baga_chr(int64_t c) { char *r = malloc(2); r[0] = (char)c; r[1] = 0; return r; }\n")
    write("static int64_t baga_ord(const char *s) { return s[0] ? (int64_t)(unsigned char)s[0] : 0; }\n")
    write("static const char *baga_read_file(const char *path) {\n")
    write("    FILE *f = fopen(path, \"rb\"); if (!f) return \"\";\n")
    write("    fseek(f, 0, SEEK_END); long sz = ftell(f); fseek(f, 0, SEEK_SET);\n")
    write("    char *buf = malloc((size_t)sz + 1); fread(buf, 1, (size_t)sz, f); buf[sz] = 0; fclose(f); return buf; }\n")
    write("static void baga_write(const char *s) { printf(\"%s\", s); }\n")
    write("typedef struct { void **data; int64_t len; int64_t cap; } baga_Vec;\n")
    write("static baga_Vec *baga_vec_new(void) {\n")
    write("    baga_Vec *v = malloc(sizeof(baga_Vec));\n")
    write("    v->cap = 8; v->len = 0; v->data = malloc(8 * sizeof(void *)); return v; }\n")
    write("static void baga_vec_grow(baga_Vec *v) {\n")
    write("    if (v->len == v->cap) { v->cap *= 2; v->data = realloc(v->data, (size_t)v->cap * sizeof(void *)); } }\n")
    write("static void baga_vec_push_i64(baga_Vec *v, int64_t x) { baga_vec_grow(v); v->data[v->len++] = (void *)(intptr_t)x; }\n")
    write("static int64_t baga_vec_get_i64(baga_Vec *v, int64_t i) { return (int64_t)(intptr_t)v->data[i]; }\n")
    write("static void baga_vec_set_i64(baga_Vec *v, int64_t i, int64_t x) { v->data[i] = (void *)(intptr_t)x; }\n")
    write("static void baga_vec_push_str(baga_Vec *v, const char *s) { baga_vec_grow(v); v->data[v->len++] = (void *)s; }\n")
    write("static const char *baga_vec_get_str(baga_Vec *v, int64_t i) { return (const char *)v->data[i]; }\n")
    write("static void baga_vec_set_str(baga_Vec *v, int64_t i, const char *s) { v->data[i] = (void *)s; }\n")
    write("static int64_t baga_vec_len(baga_Vec *v) { return v->len; }\n")
    write("static int baga_argc = 0;\n")
    write("static char **baga_argv = 0;\n")
    write("static int64_t baga_arg_count(void) { return baga_argc > 0 ? baga_argc - 1 : 0; }\n")
    write("static const char *baga_arg(int64_t i) { return (i + 1 < baga_argc) ? baga_argv[i + 1] : \"\"; }\n\n")

    // enum declarations
    let mut en = first_child(fc, prog)
    while en >= 0 {
        if node_kind(nk, en) == 28 {
            write("typedef enum {\n")
            let mut v = first_child(fc, en)
            let mut vi: i64 = 0
            while v >= 0 {
                write(concat(concat(concat(concat("    ", mangle(node_text(nt, en))), "_"), concat(mangle(node_text(nt, v)), " = ")), concat(int_to_str(vi), ",\n")))
                vi = vi + 1
                v = next_sibling(ns, v)
            }
            write(concat(concat("} ", mangle(node_text(nt, en))), ";\n\n"))
        }
        en = next_sibling(ns, en)
    }

    // struct declarations
    let mut st = first_child(fc, prog)
    while st >= 0 {
        if node_kind(nk, st) == 21 {
            write("typedef struct {\n")
            let mut fld = first_child(fc, st)
            while fld >= 0 {
                let ftext = node_text(nt, fld)
                let mut ci: i64 = 0
                let fnl = len(ftext)
                while ci < fnl {
                    if char_at(ftext, ci) == 58 { break }
                    ci = ci + 1
                }
                let fname = substr(ftext, 0, ci)
                let mut ftype = "i64"
                if ci + 1 < fnl { ftype = substr(ftext, ci + 1, fnl) }
                write(concat(concat(concat("    ", c_type(ftype)), concat(" ", mangle(fname))), ";\n"))
                fld = next_sibling(ns, fld)
            }
            write(concat(concat("} ", mangle(node_text(nt, st))), ";\n\n"))
        }
        st = next_sibling(ns, st)
    }

    // forward declarations
    let mut f = first_child(fc, prog)
    while f >= 0 {
        if node_kind(nk, f) == 11 {
            emit_fn(nk, nt, fc, ns, f)
        }
        f = next_sibling(ns, f)
    }
    write("\n")

    // function definitions (skip forward declarations)
    let mut f2 = first_child(fc, prog)
    while f2 >= 0 {
        if node_kind(nk, f2) == 11 {
            // check if has body (BLOCK child)
            let mut c2 = first_child(fc, f2)
            let mut has_body: i64 = 0
            while c2 >= 0 {
                if node_kind(nk, c2) == 5 { has_body = 1 }
                c2 = next_sibling(ns, c2)
            }
            if has_body == 1 {
                emit_fn_def(nk, nt, fc, ns, prog, f2)
            }
        }
        f2 = next_sibling(ns, f2)
    }

    // C main
    write("int main(int argc, char **argv) {\n")
    write("    baga_argc = argc; baga_argv = argv;\n")
    write("    b_main();\n")
    write("    return 0;\n")
    write("}\n")
}
