// compiler.baga — self-hosted компилатор на Бага
// Фаза 2: lexer + parser + codegen → C код
// Използване: ./baga self/compiler.baga
// Генерира /tmp/baga_out.c от examples/zdravei.baga
// Модули: c2_ast / c2_lex / c2_parse* / c2_emit_* / c2_check / c2_spec.

import "c2_ast.baga"
import "c2_lex.baga"
import "c2_parse.baga"
import "c2_parse_stmt.baga"
import "c2_emit_expr.baga"
import "c2_emit_stmt.baga"
import "c2_check.baga"
import "c2_spec.baga"
import "c2_import.baga"

// ============================================================
//  Main
// ============================================================

fn main() {
    let mut test_specs: i64 = 0
    let mut file = arg(0)
    if str_eq(arg(0), "--test-specs") == 1 {
        test_specs = 1
        file = arg(1)
    }
    let mut src = read_file(file) catch !IO => ""

    let mut tk = vec_new()
    let mut tt = vec_new()
    let mut imported = vec_new()
    vec_push_str(imported, file)
    resolve_file(tk, tt, file, imported)
    vec_push(tk, 999)
    vec_push_str(tt, "")

    let mut nk = vec_new()
    let mut nt = vec_new()
    let mut fc = vec_new()
    let mut ns = vec_new()

    let mut prog = ast_kind(nk, nt, fc, ns, 13, "")
    let mut pos = vec_new()
    vec_push(pos, 0)

    let mut iterations: i64 = 0
    while vec_get(tk, vec_get(pos, 0)) != 999 {
        iterations = iterations + 1
        if iterations > 100000 { break }
        if vec_get(tk, vec_get(pos, 0)) == 1 {
            let mut f = parse_fn(tk, tt, pos, nk, nt, fc, ns)
            ast_child(fc, ns, prog, f)
        } else {
            if vec_get(tk, vec_get(pos, 0)) == 0 {
                if str_eq(vec_get_str(tt, vec_get(pos, 0)), "extern") == 1 {
                    // extern fn <име>(...) -> T !E — FFI декларация (kind 35)
                    vec_set(pos, 0, vec_get(pos, 0) + 1)
                    if vec_get(tk, vec_get(pos, 0)) == 1 {
                        let mut ef = parse_fn(tk, tt, pos, nk, nt, fc, ns)
                        vec_set(nk, ef, 35)
                        ast_child(fc, ns, prog, ef)
                    }
                } else {
                    if str_eq(vec_get_str(tt, vec_get(pos, 0)), "struct") == 1 {
                        let mut s = parse_struct(tk, tt, pos, nk, nt, fc, ns)
                        ast_child(fc, ns, prog, s)
                    } else {
                        if str_eq(vec_get_str(tt, vec_get(pos, 0)), "enum") == 1 {
                            let mut en = parse_enum(tk, tt, pos, nk, nt, fc, ns)
                            ast_child(fc, ns, prog, en)
                        } else {
                            if str_eq(vec_get_str(tt, vec_get(pos, 0)), "spec") == 1 {
                                let mut sp = parse_spec(tk, tt, pos, nk, nt, fc, ns)
                                ast_child(fc, ns, prog, sp)
                            } else {
                                vec_set(pos, 0, vec_get(pos, 0) + 1)
                            }
                        }
                    }
                }
            } else {
                vec_set(pos, 0, vec_get(pos, 0) + 1)
            }
        }
    }

    // checker: отхвърля невалидни програми (аргументи + vec смесване)
    check_program(nk, nt, fc, ns, prog)

    // emit C code
    write("/* Генериран от Бага self-hosted компилатор */\n")
    write("#include <stdio.h>\n")
    write("#include <stdlib.h>\n")
    write("#include <stdint.h>\n")
    write("#include <string.h>\n\n")
    // runtime helpers
    write("static int64_t baga_len(const char *s) { return (int64_t)strlen(s); }\n")
    write("static int64_t baga_char_at(const char *s, int64_t i) { return (int64_t)(unsigned char)s[i]; }\n")
    write("static int64_t baga_byte_at(const char *s, int64_t i) { return (int64_t)(unsigned char)s[i]; }\n")
    write("static const char *baga_byte_chr(int64_t c) { char *r = malloc(2); r[0] = (char)c; r[1] = 0; return r; }\n")
    write("static const char *baga_substr(const char *s, int64_t a, int64_t b) {\n")
    write("    int64_t n = b - a; if (n < 0) n = 0;\n")
    write("    char *r = malloc((size_t)n + 1); memcpy(r, s + a, (size_t)n); r[n] = 0; return r; }\n")
    write("static const char *baga_concat(const char *a, const char *b) {\n")
    write("    size_t la = strlen(a), lb = strlen(b);\n")
    write("    char *r = malloc(la + lb + 1); memcpy(r, a, la); memcpy(r + la, b, lb + 1); return r; }\n")
    write("static int64_t baga_str_eq(const char *a, const char *b) { return strcmp(a, b) == 0; }\n")
    write("static const char *baga_chr(int64_t c) {\n")
    write("    char *r = malloc(5);\n")
    write("    if (c < 0x80) { r[0] = (char)c; r[1] = 0; }\n")
    write("    else if (c < 0x800) { r[0] = (char)(0xC0|(c>>6)); r[1] = (char)(0x80|(c&0x3F)); r[2] = 0; }\n")
    write("    else if (c < 0x10000) { r[0] = (char)(0xE0|(c>>12)); r[1] = (char)(0x80|((c>>6)&0x3F)); r[2] = (char)(0x80|(c&0x3F)); r[3] = 0; }\n")
    write("    else { r[0] = (char)(0xF0|(c>>18)); r[1] = (char)(0x80|((c>>12)&0x3F)); r[2] = (char)(0x80|((c>>6)&0x3F)); r[3] = (char)(0x80|(c&0x3F)); r[4] = 0; }\n")
    write("    return r; }\n")
    write("static int64_t baga_ord(const char *s) {\n")
    write("    unsigned char c = (unsigned char)s[0]; if (!c) return 0;\n")
    write("    if (c < 0x80) return c;\n")
    write("    if ((c&0xE0)==0xC0) return ((int64_t)(c&0x1F)<<6)|((int64_t)(unsigned char)s[1]&0x3F);\n")
    write("    if ((c&0xF0)==0xE0) return ((int64_t)(c&0x0F)<<12)|(((int64_t)(unsigned char)s[1]&0x3F)<<6)|((int64_t)(unsigned char)s[2]&0x3F);\n")
    write("    return ((int64_t)(c&0x07)<<18)|(((int64_t)(unsigned char)s[1]&0x3F)<<12)|(((int64_t)(unsigned char)s[2]&0x3F)<<6)|((int64_t)(unsigned char)s[3]&0x3F); }\n")
    write("static const char *baga_i64_to_str(int64_t x) { char *r = malloc(24); snprintf(r, 24, \"%lld\", (long long)x); return r; }\n")
    write("typedef struct { unsigned char *data; int64_t len; } baga_bytes;\n")
    write("static int64_t baga_bytes_len(baga_bytes b) { return b.len; }\n")
    write("static int64_t baga_bytes_at(baga_bytes b, int64_t i) { return (int64_t)b.data[i]; }\n")
    write("static baga_bytes baga_bytes_slice(baga_bytes b, int64_t a, int64_t c) {\n")
    write("    if (a < 0) a = 0; if (c > b.len) c = b.len; if (c < a) c = a;\n")
    write("    baga_bytes r; r.len = c - a; r.data = malloc((size_t)(r.len ? r.len : 1));\n")
    write("    memcpy(r.data, b.data + a, (size_t)r.len); return r; }\n")
    write("static baga_bytes baga_bytes_concat(baga_bytes a, baga_bytes b) {\n")
    write("    baga_bytes r; r.len = a.len + b.len; r.data = malloc((size_t)(r.len ? r.len : 1));\n")
    write("    memcpy(r.data, a.data, (size_t)a.len); memcpy(r.data + a.len, b.data, (size_t)b.len); return r; }\n")
    write("static baga_bytes baga_bytes_from_str(const char *s) {\n")
    write("    int64_t n = (int64_t)strlen(s); baga_bytes r; r.len = n; r.data = malloc((size_t)(n ? n : 1));\n")
    write("    memcpy(r.data, s, (size_t)n); return r; }\n")
    write("static const char *baga_bytes_to_str(baga_bytes b) {\n")
    write("    char *r = malloc((size_t)b.len + 1); memcpy(r, b.data, (size_t)b.len); r[b.len] = 0; return r; }\n")
    write("static int baga_hex_val(int c) {\n")
    write("    if (c >= '0' && c <= '9') return c - '0';\n")
    write("    if (c >= 'a' && c <= 'f') return c - 'a' + 10;\n")
    write("    if (c >= 'A' && c <= 'F') return c - 'A' + 10;\n")
    write("    return -1; }\n")
    write("static const char *baga_hex_encode(baga_bytes b) {\n")
    write("    static const char *hx = \"0123456789abcdef\";\n")
    write("    char *r = malloc((size_t)b.len * 2 + 1);\n")
    write("    for (int64_t i = 0; i < b.len; i++) { r[i*2] = hx[b.data[i] >> 4]; r[i*2+1] = hx[b.data[i] & 15]; }\n")
    write("    r[b.len * 2] = 0; return r; }\n")
    write("static baga_bytes baga_hex_decode(const char *s) {\n")
    write("    int64_t n = (int64_t)strlen(s); unsigned char *buf = malloc((size_t)(n / 2 + 1)); int64_t len = 0;\n")
    write("    for (int64_t i = 0; i + 1 < n; ) {\n")
    write("        int hi = baga_hex_val(s[i]); int lo = baga_hex_val(s[i+1]);\n")
    write("        if (hi < 0 || lo < 0) { i++; continue; }\n")
    write("        buf[len++] = (unsigned char)(hi * 16 + lo); i += 2; }\n")
    write("    baga_bytes r; r.data = buf; r.len = len; return r; }\n")
    write("static baga_bytes baga_bytes_from_hex(const char *s) { return baga_hex_decode(s); }\n")
    write("static const char *baga_read_file(const char *path) {\n")
    write("    FILE *f = fopen(path, \"rb\"); if (!f) return \"\";\n")
    write("    fseek(f, 0, SEEK_END); long sz = ftell(f); fseek(f, 0, SEEK_SET);\n")
    write("    char *buf = malloc((size_t)sz + 1); fread(buf, 1, (size_t)sz, f); buf[sz] = 0; fclose(f); return buf; }\n")
    write("static void baga_write(const char *s) { printf(\"%s\", s); }\n")
    write("typedef struct { void **data; int64_t len; int64_t cap; } baga_Vec;\n")
    write("static baga_Vec *baga_vec_new(void) {\n")
    write("    baga_Vec *v = malloc(sizeof(baga_Vec));\n")
    write("    v->cap = 8; v->len = 0; v->data = malloc(8 * sizeof(void *)); return v; }\n")
    write("static void baga_vec_grow(baga_Vec *v) {\n")
    write("    if (v->len == v->cap) { v->cap *= 2; v->data = realloc(v->data, (size_t)v->cap * sizeof(void *)); } }\n")
    write("static void baga_vec_push_i64(baga_Vec *v, int64_t x) { baga_vec_grow(v); v->data[v->len++] = (void *)(intptr_t)x; }\n")
    write("static int64_t baga_vec_get_i64(baga_Vec *v, int64_t i) { return (int64_t)(intptr_t)v->data[i]; }\n")
    write("static void baga_vec_set_i64(baga_Vec *v, int64_t i, int64_t x) { v->data[i] = (void *)(intptr_t)x; }\n")
    write("static void baga_vec_push_str(baga_Vec *v, const char *s) { baga_vec_grow(v); v->data[v->len++] = (void *)s; }\n")
    write("static const char *baga_vec_get_str(baga_Vec *v, int64_t i) { return (const char *)v->data[i]; }\n")
    write("static void baga_vec_set_str(baga_Vec *v, int64_t i, const char *s) { v->data[i] = (void *)s; }\n")
    write("static void baga_vec_push_f64(baga_Vec *v, double x) { union { double d; void *p; } u; u.d = x; baga_vec_grow(v); v->data[v->len++] = u.p; }\n")
    write("static double baga_vec_get_f64(baga_Vec *v, int64_t i) { union { double d; void *p; } u; u.p = v->data[i]; return u.d; }\n")
    write("static void baga_vec_set_f64(baga_Vec *v, int64_t i, double x) { union { double d; void *p; } u; u.d = x; v->data[i] = u.p; }\n")
    write("static int64_t baga_vec_len(baga_Vec *v) { return v->len; }\n")
    write("static baga_Vec *baga_vec_slice_i64(baga_Vec *v, int64_t a, int64_t b) {\n")
    write("    if (a < 0) a = 0; if (b > v->len) b = v->len; if (b < a) b = a;\n")
    write("    baga_Vec *r = baga_vec_new();\n")
    write("    for (int64_t i = a; i < b; i++) baga_vec_push_i64(r, (int64_t)(intptr_t)v->data[i]);\n")
    write("    return r; }\n")
    write("static baga_Vec *baga_vec_slice_str(baga_Vec *v, int64_t a, int64_t b) {\n")
    write("    if (a < 0) a = 0; if (b > v->len) b = v->len; if (b < a) b = a;\n")
    write("    baga_Vec *r = baga_vec_new();\n")
    write("    for (int64_t i = a; i < b; i++) baga_vec_push_str(r, (const char *)v->data[i]);\n")
    write("    return r; }\n")
    write("static baga_Vec *baga_vec_slice_f64(baga_Vec *v, int64_t a, int64_t b) {\n")
    write("    if (a < 0) a = 0; if (b > v->len) b = v->len; if (b < a) b = a;\n")
    write("    baga_Vec *r = baga_vec_new();\n")
    write("    for (int64_t i = a; i < b; i++) { union { double d; void *p; } u; u.p = v->data[i]; baga_vec_push_f64(r, u.d); }\n")
    write("    return r; }\n")
    write("static baga_Vec *baga_vec_concat_i64(baga_Vec *v, baga_Vec *w) {\n")
    write("    baga_Vec *r = baga_vec_new();\n")
    write("    for (int64_t i = 0; i < v->len; i++) baga_vec_push_i64(r, (int64_t)(intptr_t)v->data[i]);\n")
    write("    for (int64_t i = 0; i < w->len; i++) baga_vec_push_i64(r, (int64_t)(intptr_t)w->data[i]);\n")
    write("    return r; }\n")
    write("static baga_Vec *baga_vec_concat_str(baga_Vec *v, baga_Vec *w) {\n")
    write("    baga_Vec *r = baga_vec_new();\n")
    write("    for (int64_t i = 0; i < v->len; i++) baga_vec_push_str(r, (const char *)v->data[i]);\n")
    write("    for (int64_t i = 0; i < w->len; i++) baga_vec_push_str(r, (const char *)w->data[i]);\n")
    write("    return r; }\n")
    write("static baga_Vec *baga_vec_concat_f64(baga_Vec *v, baga_Vec *w) {\n")
    write("    baga_Vec *r = baga_vec_new();\n")
    write("    for (int64_t i = 0; i < v->len; i++) { union { double d; void *p; } u; u.p = v->data[i]; baga_vec_push_f64(r, u.d); }\n")
    write("    for (int64_t i = 0; i < w->len; i++) { union { double d; void *p; } u; u.p = w->data[i]; baga_vec_push_f64(r, u.d); }\n")
    write("    return r; }\n")
    write("static int baga_argc = 0;\n")
    write("static char **baga_argv = 0;\n")
    write("static int64_t baga_arg_count(void) { return baga_argc > 0 ? baga_argc - 1 : 0; }\n")
    write("static const char *baga_arg(int64_t i) { return (i + 1 < baga_argc) ? baga_argv[i + 1] : \"\"; }\n")
    write("static void baga_exit(int64_t c) { exit((int)c); }\n")
    write("static void baga_eprintln(const char *s) { fprintf(stderr, \"%s\\n\", s); }\n")
    write("static int64_t baga_cur_args[16];\n")
    write("static int baga_cur_nargs = 0;\n")
    write("static uint64_t baga_seed = 0x243F6A8885A308D3ULL;\n")
    write("static int64_t baga_rand_i64(int64_t lo, int64_t hi) {\n")
    write("    baga_seed ^= baga_seed << 13; baga_seed ^= baga_seed >> 7; baga_seed ^= baga_seed << 17;\n")
    write("    return lo + (int64_t)(baga_seed % (uint64_t)(hi - lo + 1));\n")
    write("}\n")
    write("static void baga_spec_fail(const char *spec, const char *kind, int64_t idx, const char *expr) {\n")
    write("    if (strcmp(kind, \"requires\") == 0)\n")
    write("        fprintf(stderr, \"spec '%s': requires #%lld нарушено: %s\\n\", spec, (long long)idx, expr);\n")
    write("    else\n")
    write("        fprintf(stderr, \"spec '%s': ensures #%lld нарушена: %s\\n\", spec, (long long)idx, expr);\n")
    write("    if (baga_cur_nargs > 0) {\n")
    write("        fprintf(stderr, \"  вход: \");\n")
    write("        for (int i = 0; i < baga_cur_nargs; i++)\n")
    write("            fprintf(stderr, \"%s%lld\", i ? \", \" : \"\", (long long)baga_cur_args[i]);\n")
    write("        fprintf(stderr, \"\\n\");\n")
    write("    }\n")
    write("    exit(1);\n")
    write("}\n")
    write("/* arena allocator: bump allocation, free-all-at-once */\n")
    write("typedef struct { char *base; int64_t used; int64_t cap; } baga_Arena;\n")
    write("static int64_t baga_arena_new(void) {\n")
    write("    baga_Arena *a = malloc(sizeof(baga_Arena));\n")
    write("    a->cap = 65536; a->used = 0; a->base = malloc((size_t)a->cap);\n")
    write("    return (int64_t)(intptr_t)a;\n")
    write("}\n")
    write("static int64_t baga_arena_alloc(int64_t h, int64_t size) {\n")
    write("    baga_Arena *a = (baga_Arena *)(intptr_t)h;\n")
    write("    if (a->used + size > a->cap) {\n")
    write("        int64_t nc = (a->used + size) * 2;\n")
    write("        a->base = realloc(a->base, (size_t)nc); a->cap = nc;\n")
    write("    }\n")
    write("    char *p = a->base + a->used; a->used += size;\n")
    write("    return (int64_t)(intptr_t)p;\n")
    write("}\n")
    write("static void baga_arena_reset(int64_t h) {\n")
    write("    baga_Arena *a = (baga_Arena *)(intptr_t)h; a->used = 0;\n")
    write("}\n")
    write("static void baga_arena_free(int64_t h) {\n")
    write("    baga_Arena *a = (baga_Arena *)(intptr_t)h;\n")
    write("    free(a->base); free(a);\n")
    write("}\n\n")

    // enum declarations
    let mut en = first_child(fc, prog)
    while en >= 0 {
        if node_kind(nk, en) == 28 {
            write("typedef enum {\n")
            let mut v = first_child(fc, en)
            let mut vi: i64 = 0
            while v >= 0 {
                write(concat(concat(concat(concat("    ", mangle(node_text(nt, en))), "_"), concat(mangle(node_text(nt, v)), " = ")), concat(int_to_str(vi), ",\n")))
                vi = vi + 1
                v = next_sibling(ns, v)
            }
            write(concat(concat("} ", mangle(node_text(nt, en))), ";\n\n"))
        }
        en = next_sibling(ns, en)
    }

    // struct declarations
    let mut st = first_child(fc, prog)
    while st >= 0 {
        if node_kind(nk, st) == 21 {
            write("typedef struct {\n")
            let mut fld = first_child(fc, st)
            while fld >= 0 {
                let mut ftext = node_text(nt, fld)
                let mut ci: i64 = 0
                let mut fnl = len(ftext)
                while ci < fnl {
                    if char_at(ftext, ci) == 58 { break }
                    ci = ci + 1
                }
                let mut fname = substr(ftext, 0, ci)
                let mut ftype = "i64"
                if ci + 1 < fnl { ftype = substr(ftext, ci + 1, fnl) }
                write(concat(concat(concat("    ", c_type(ftype)), concat(" ", mangle(fname))), ";\n"))
                fld = next_sibling(ns, fld)
            }
            write(concat(concat("} ", mangle(node_text(nt, st))), ";\n\n"))
        }
        st = next_sibling(ns, st)
    }

    // forward declarations
    let mut f = first_child(fc, prog)
    while f >= 0 {
        if node_kind(nk, f) == 11 {
            emit_fn(nk, nt, fc, ns, prog, f)
        }
        if node_kind(nk, f) == 35 {
            emit_extern_fn(nk, nt, fc, ns, prog, f)
        }
        f = next_sibling(ns, f)
    }
    write("\n")

    // function definitions (skip forward declarations)
    let mut f2 = first_child(fc, prog)
    while f2 >= 0 {
        if node_kind(nk, f2) == 11 {
            // check if has body (BLOCK child)
            let mut c2 = first_child(fc, f2)
            let mut has_body: i64 = 0
            while c2 >= 0 {
                if node_kind(nk, c2) == 5 { has_body = 1 }
                c2 = next_sibling(ns, c2)
            }
            if has_body == 1 {
                emit_fn_def(nk, nt, fc, ns, prog, f2)
            }
        }
        f2 = next_sibling(ns, f2)
    }

    // C main (или test driver при --test-specs)
    if test_specs == 1 {
        emit_test_driver(nk, nt, fc, ns, prog)
    } else {
        write("int main(int argc, char **argv) {\n")
        write("    baga_argc = argc; baga_argv = argv;\n")
        write("    b_main();\n")
        write("    return 0;\n")
        write("}\n")
    }
}
