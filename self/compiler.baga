// compiler.baga — self-hosted компилатор на Бага
// Фаза 2: lexer + parser + codegen → C код
// Използване: ./baga self/compiler.baga
// Генерира /tmp/baga_out.c от examples/zdravei.baga

// ============================================================
//  AST builder (linked list)
// ============================================================

fn ast_kind(nk: Vec, nt: Vec, fc: Vec, ns: Vec, kind: i64, text: str) -> i64 {
    let mut idx = vec_len(nk)
    vec_push(nk, kind)
    vec_push_str(nt, text)
    vec_push(fc, 0 - 1)
    vec_push(ns, 0 - 1)
    idx
}

fn ast_child(fc: Vec, ns: Vec, parent: i64, child: i64) {
    vec_set(ns, child, 0 - 1)
    if vec_get(fc, parent) < 0 {
        vec_set(fc, parent, child)
    } else {
        let mut last = vec_get(fc, parent)
        while vec_get(ns, last) >= 0 {
            last = vec_get(ns, last)
        }
        vec_set(ns, last, child)
    }
}

fn first_child(fc: Vec, idx: i64) -> i64 { vec_get(fc, idx) }
fn next_sibling(ns: Vec, idx: i64) -> i64 { vec_get(ns, idx) }
fn node_kind(nk: Vec, idx: i64) -> i64 { vec_get(nk, idx) }
fn node_text(nt: Vec, idx: i64) -> str { vec_get_str(nt, idx) }

// index of the first occurrence of byte ch in s at or after position from, or -1
fn bfind(s: str, ch: i64, from: i64) -> i64 {
    let mut n = len(s)
    let mut i = from
    while i < n {
        if char_at(s, i) == ch { return i }
        i = i + 1
    }
    0 - 1
}

// ============================================================
//  Tokenizer
// ============================================================

fn is_digit(c: i64) -> i64 {
    if c >= 48 { if c <= 57 { return 1 } }
    0
}

fn is_alpha(c: i64) -> i64 {
    if c >= 97 { if c <= 122 { return 1 } }
    if c >= 65 { if c <= 90 { return 1 } }
    if c == 95 { return 1 }
    if c >= 128 { return 1 }
    0
}

fn is_alnum(c: i64) -> i64 {
    if is_alpha(c) == 1 { return 1 }
    is_digit(c)
}

fn kw_kind(s: str) -> i64 {
    if str_eq(s, "fn") { return 1 }
    if str_eq(s, "let") { return 2 }
    if str_eq(s, "mut") { return 3 }
    if str_eq(s, "if") { return 4 }
    if str_eq(s, "else") { return 5 }
    if str_eq(s, "while") { return 6 }
    if str_eq(s, "for") { return 7 }
    if str_eq(s, "in") { return 8 }
    if str_eq(s, "return") { return 9 }
    if str_eq(s, "true") { return 14 }
    if str_eq(s, "false") { return 15 }
    if str_eq(s, "break") { return 17 }
    if str_eq(s, "continue") { return 18 }
    if str_eq(s, "catch") { return 16 }
    0
}

fn tokenize(src: str, tk: Vec, tt: Vec) {
    let mut pos: i64 = 0
    let mut n = len(src)
    while pos < n {
        let mut c = char_at(src, pos)
        if c == 32 { pos = pos + 1; continue }
        if c == 10 { pos = pos + 1; continue }
        if c == 13 { pos = pos + 1; continue }
        if c == 9  { pos = pos + 1; continue }
        if c == 47 {
            if pos + 1 < n {
                if char_at(src, pos + 1) == 47 {
                    while pos < n {
                        if char_at(src, pos) == 10 { break }
                        pos = pos + 1
                    }
                    continue
                }
            }
        }
        if is_alpha(c) == 1 {
            let start = pos
            while pos < n {
                if is_alnum(char_at(src, pos)) == 1 { pos = pos + 1 } else { break }
            }
            let mut text = substr(src, start, pos)
            // x"deadbeef" — hex bytes literal (kind 103)
            if str_eq(text, "x") == 1 && pos < n && char_at(src, pos) == 34 {
                pos = pos + 1
                let mut hs = pos
                while pos < n && char_at(src, pos) != 34 { pos = pos + 1 }
                vec_push(tk, 103)
                vec_push_str(tt, substr(src, hs, pos))
                if pos < n { pos = pos + 1 }
                continue
            }
            let mut kw = kw_kind(text)
            if kw > 0 { vec_push(tk, kw) } else { vec_push(tk, 0) }
            vec_push_str(tt, text)
            continue
        }
        if is_digit(c) == 1 {
            let mut start = pos
            while pos < n {
                if is_digit(char_at(src, pos)) == 1 { pos = pos + 1 } else { break }
            }
            let mut is_float: i64 = 0
            if pos + 1 < n {
                if char_at(src, pos) == 46 {
                    if is_digit(char_at(src, pos + 1)) == 1 {
                        is_float = 1
                        pos = pos + 1
                        while pos < n {
                            if is_digit(char_at(src, pos)) == 1 { pos = pos + 1 } else { break }
                        }
                    }
                }
            }
            if is_float == 1 { vec_push(tk, 102) } else { vec_push(tk, 100) }
            vec_push_str(tt, substr(src, start, pos))
            continue
        }
        if c == 34 {
            pos = pos + 1
            let mut sval = ""
            while pos < n {
                let mut sc = char_at(src, pos)
                if sc == 34 { break }
                if sc == 92 {
                    pos = pos + 1
                    let mut ec = char_at(src, pos)
                    let mut eh: i64 = 0
                    if ec == 110 { sval = concat(sval, byte_chr(10)); eh = 1 }
                    if ec == 116 { sval = concat(sval, byte_chr(9)); eh = 1 }
                    if ec == 92 { sval = concat(sval, byte_chr(92)); eh = 1 }
                    if ec == 34 { sval = concat(sval, byte_chr(34)); eh = 1 }
                    if eh == 0 { sval = concat(sval, byte_chr(ec)) }
                } else {
                    sval = concat(sval, byte_chr(sc))
                }
                pos = pos + 1
            }
            vec_push(tk, 101)
            vec_push_str(tt, sval)
            if pos < n { pos = pos + 1 }
            continue
        }
        if pos + 1 < n {
            let mut c2 = char_at(src, pos + 1)
            let mut h: i64 = 0
            if c == 45 { if c2 == 62 { vec_push(tk, 200); vec_push_str(tt, "->"); pos = pos + 2; h = 1 } }
            if c == 61 { if c2 == 61 { vec_push(tk, 201); vec_push_str(tt, "=="); pos = pos + 2; h = 1 } }
            if c == 33 { if c2 == 61 { vec_push(tk, 203); vec_push_str(tt, "!="); pos = pos + 2; h = 1 } }
            if c == 60 { if c2 == 61 { vec_push(tk, 204); vec_push_str(tt, "<="); pos = pos + 2; h = 1 } }
            if c == 60 { if c2 == 60 { vec_push(tk, 205); vec_push_str(tt, "<<"); pos = pos + 2; h = 1 } }
            if c == 62 { if c2 == 61 { vec_push(tk, 206); vec_push_str(tt, ">="); pos = pos + 2; h = 1 } }
            if c == 62 { if c2 == 62 { vec_push(tk, 207); vec_push_str(tt, ">>"); pos = pos + 2; h = 1 } }
            if c == 38 { if c2 == 38 { vec_push(tk, 208); vec_push_str(tt, "&&"); pos = pos + 2; h = 1 } }
            if c == 124 { if c2 == 124 { vec_push(tk, 209); vec_push_str(tt, "||"); pos = pos + 2; h = 1 } }
            if c == 46 { if c2 == 46 { vec_push(tk, 210); vec_push_str(tt, ".."); pos = pos + 2; h = 1 } }
            if c == 43 { if c2 == 61 { vec_push(tk, 211); vec_push_str(tt, "+="); pos = pos + 2; h = 1 } }
            if c == 45 { if c2 == 61 { vec_push(tk, 212); vec_push_str(tt, "-="); pos = pos + 2; h = 1 } }
            if c == 42 { if c2 == 61 { vec_push(tk, 213); vec_push_str(tt, "*="); pos = pos + 2; h = 1 } }
            if c == 47 { if c2 == 61 { vec_push(tk, 214); vec_push_str(tt, "/="); pos = pos + 2; h = 1 } }
            if h == 1 { continue }
        }
        vec_push(tk, 300)
        vec_push_str(tt, byte_chr(c))
        pos = pos + 1
    }
    vec_push(tk, 999)
    vec_push_str(tt, "")
}

// ============================================================
//  Parser
// ============================================================

fn is_single(tk: Vec, tt: Vec, pos: i64, ch: str) -> i64 {
    if vec_get(tk, pos) == 300 {
        if str_eq(vec_get_str(tt, pos), ch) { return 1 }
    }
    0
}

fn parse_expr(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64

fn parse_primary(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut k = vec_get(tk, vec_get(pos, 0))
    let mut t = vec_get_str(tt, vec_get(pos, 0))
    if k == 1 {
        self_unsupported("fn стойности / ламбди (L5 closures)")
    }
    if is_single(tk, tt, vec_get(pos, 0), "-") == 1 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut operand = parse_primary(tk, tt, pos, nk, nt, fc, ns)
        let mut neg = ast_kind(nk, nt, fc, ns, 3, "-")
        let mut zero = ast_kind(nk, nt, fc, ns, 0, "0")
        ast_child(fc, ns, neg, zero)
        ast_child(fc, ns, neg, operand)
        return neg
    }
    if k == 100 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        return ast_kind(nk, nt, fc, ns, 0, t)
    }
    if k == 102 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        return ast_kind(nk, nt, fc, ns, 19, t)
    }
    if k == 101 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        // string interpolation: ${expr} -> concat chain with TO_STR (kind 28)
        if bfind(t, 36, 0) < 0 {
            return ast_kind(nk, nt, fc, ns, 1, t)
        }
        let mut parts = vec_new()
        let mut lit = ""
        let mut n = len(t)
        let mut i: i64 = 0
        while i < n {
            let mut c = char_at(t, i)
            if c == 36 && i + 1 < n && char_at(t, i + 1) == 36 {
                lit = concat(lit, byte_chr(36))
                i = i + 2
            } else {
                if c == 36 && i + 1 < n && char_at(t, i + 1) == 123 {
                    if len(lit) > 0 { vec_push(parts, ast_kind(nk, nt, fc, ns, 1, lit)); lit = "" }
                    let mut j = i + 2
                    let mut depth: i64 = 1
                    while j < n && depth > 0 {
                        let mut cj = char_at(t, j)
                        if cj == 123 { depth = depth + 1 } else { if cj == 125 { depth = depth - 1 } }
                        if depth == 0 { break }
                        j = j + 1
                    }
                    let mut expr_s = substr(t, i + 2, j)
                    let mut etk = vec_new()
                    let mut ett = vec_new()
                    tokenize(expr_s, etk, ett)
                    let mut epos = vec_new()
                    vec_push(epos, 0)
                    let mut enode = parse_expr(etk, ett, epos, nk, nt, fc, ns)
                    let mut ts = ast_kind(nk, nt, fc, ns, 33, "")
                    ast_child(fc, ns, ts, enode)
                    vec_push(parts, ts)
                    i = j + 1
                } else {
                    lit = concat(lit, byte_chr(c))
                    i = i + 1
                }
            }
        }
        if len(lit) > 0 { vec_push(parts, ast_kind(nk, nt, fc, ns, 1, lit)) }
        let mut np = vec_len(parts)
        if np == 0 { return ast_kind(nk, nt, fc, ns, 1, "") }
        let mut acc = vec_get(parts, np - 1)
        let mut pi = np - 2
        while pi >= 0 {
            let call = ast_kind(nk, nt, fc, ns, 4, "")
            let mut callee = ast_kind(nk, nt, fc, ns, 2, "concat")
            ast_child(fc, ns, call, callee)
            ast_child(fc, ns, call, vec_get(parts, pi))
            ast_child(fc, ns, call, acc)
            acc = call
            pi = pi - 1
        }
        return acc
    }
    if k == 103 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        return ast_kind(nk, nt, fc, ns, 34, t)
    }
    if k == 14 { vec_set(pos, 0, vec_get(pos, 0) + 1); return ast_kind(nk, nt, fc, ns, 20, "1") }
    if k == 15 { vec_set(pos, 0, vec_get(pos, 0) + 1); return ast_kind(nk, nt, fc, ns, 20, "0") }
    if k == 0 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        if str_eq(t, "match") == 1 {
            let mut scrut = parse_expr(tk, tt, pos, nk, nt, fc, ns)
            let mut mnode = ast_kind(nk, nt, fc, ns, 26, "")
            ast_child(fc, ns, mnode, scrut)
            if is_single(tk, tt, vec_get(pos, 0), "{") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
            while is_single(tk, tt, vec_get(pos, 0), "}") == 0 {
                if vec_get(tk, vec_get(pos, 0)) == 999 { break }
                let mut pat = parse_primary(tk, tt, pos, nk, nt, fc, ns)
                let mut is_wild: i64 = 0
                if node_kind(nk, pat) == 2 {
                    if str_eq(node_text(nt, pat), "_") == 1 { is_wild = 1 }
                }
                if is_single(tk, tt, vec_get(pos, 0), "=") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
                if is_single(tk, tt, vec_get(pos, 0), ">") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
                let mut body = parse_expr(tk, tt, pos, nk, nt, fc, ns)
                let mut atext = ""
                if is_wild == 1 { atext = "_" }
                let mut arm = ast_kind(nk, nt, fc, ns, 27, atext)
                if is_wild == 0 { ast_child(fc, ns, arm, pat) }
                ast_child(fc, ns, arm, body)
                ast_child(fc, ns, mnode, arm)
                if is_single(tk, tt, vec_get(pos, 0), ",") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
            }
            if is_single(tk, tt, vec_get(pos, 0), "}") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
            return mnode
        }
        let mut base = ast_kind(nk, nt, fc, ns, 2, t)
        if is_single(tk, tt, vec_get(pos, 0), "(") == 1 {
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            let mut call = ast_kind(nk, nt, fc, ns, 4, "")
            ast_child(fc, ns, call, base)
            if is_single(tk, tt, vec_get(pos, 0), ")") == 0 {
                let mut arg = parse_expr(tk, tt, pos, nk, nt, fc, ns)
                ast_child(fc, ns, call, arg)
                while is_single(tk, tt, vec_get(pos, 0), ",") == 1 {
                    vec_set(pos, 0, vec_get(pos, 0) + 1)
                    let mut a2 = parse_expr(tk, tt, pos, nk, nt, fc, ns)
                    ast_child(fc, ns, call, a2)
                }
            }
            if is_single(tk, tt, vec_get(pos, 0), ")") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
            base = call
        }
        if is_single(tk, tt, vec_get(pos, 0), "{") == 1 {
            let mut p1 = vec_get(pos, 0) + 1
            let mut p2 = vec_get(pos, 0) + 2
            let mut is_lit: i64 = 0
            if p2 < vec_len(tk) {
                if vec_get(tk, p1) == 0 {
                    if is_single(tk, tt, p2, ":") == 1 { is_lit = 1 }
                }
            }
            if is_lit == 1 {
                vec_set(pos, 0, vec_get(pos, 0) + 1)
                let mut lit = ast_kind(nk, nt, fc, ns, 22, t)
                while is_single(tk, tt, vec_get(pos, 0), "}") == 0 {
                    if vec_get(tk, vec_get(pos, 0)) == 999 { break }
                    let fname = vec_get_str(tt, vec_get(pos, 0))
                    vec_set(pos, 0, vec_get(pos, 0) + 1)
                    if is_single(tk, tt, vec_get(pos, 0), ":") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
                    let mut val = parse_expr(tk, tt, pos, nk, nt, fc, ns)
                    let mut fi = ast_kind(nk, nt, fc, ns, 24, fname)
                    ast_child(fc, ns, fi, val)
                    ast_child(fc, ns, lit, fi)
                    if is_single(tk, tt, vec_get(pos, 0), ",") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
                }
                if is_single(tk, tt, vec_get(pos, 0), "}") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
                base = lit
            }
        }
        while is_single(tk, tt, vec_get(pos, 0), ".") == 1 {
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            let mut fname = vec_get_str(tt, vec_get(pos, 0))
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            let mut fnode = ast_kind(nk, nt, fc, ns, 23, fname)
            ast_child(fc, ns, fnode, base)
            base = fnode
        }
        while is_single(tk, tt, vec_get(pos, 0), "?") == 1 {
            vec_set(pos, 0, vec_get(pos, 0) + 1)
        }
        return base
    }
    if is_single(tk, tt, vec_get(pos, 0), "(") == 1 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut e = parse_expr(tk, tt, pos, nk, nt, fc, ns)
        if is_single(tk, tt, vec_get(pos, 0), ")") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
        return e
    }
    vec_set(pos, 0, vec_get(pos, 0) + 1)
    ast_kind(nk, nt, fc, ns, 0, "0")
}

fn parse_mul(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut left = parse_primary(tk, tt, pos, nk, nt, fc, ns)
    while vec_get(pos, 0) < vec_len(tk) {
        let mut op: str = ""
        if is_single(tk, tt, vec_get(pos, 0), "*") == 1 { op = "*" }
        if is_single(tk, tt, vec_get(pos, 0), "/") == 1 { op = "/" }
        if is_single(tk, tt, vec_get(pos, 0), "%") == 1 { op = "%" }
        if str_eq(op, "") == 1 { break }
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut right = parse_primary(tk, tt, pos, nk, nt, fc, ns)
        let mut node = ast_kind(nk, nt, fc, ns, 3, op)
        ast_child(fc, ns, node, left)
        ast_child(fc, ns, node, right)
        left = node
    }
    left
}

fn parse_add(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut left = parse_mul(tk, tt, pos, nk, nt, fc, ns)
    while vec_get(pos, 0) < vec_len(tk) {
        let mut op: str = ""
        if is_single(tk, tt, vec_get(pos, 0), "+") == 1 { op = "+" }
        if is_single(tk, tt, vec_get(pos, 0), "-") == 1 { op = "-" }
        if str_eq(op, "") == 1 { break }
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut right = parse_mul(tk, tt, pos, nk, nt, fc, ns)
        let mut node = ast_kind(nk, nt, fc, ns, 3, op)
        ast_child(fc, ns, node, left)
        ast_child(fc, ns, node, right)
        left = node
    }
    left
}

fn parse_shift(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut left = parse_add(tk, tt, pos, nk, nt, fc, ns)
    while vec_get(pos, 0) < vec_len(tk) {
        let mut op: str = ""
        let mut k = vec_get(tk, vec_get(pos, 0))
        if k == 205 { op = "<<" }
        if k == 207 { op = ">>" }
        if str_eq(op, "") == 1 { break }
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut right = parse_add(tk, tt, pos, nk, nt, fc, ns)
        let mut node = ast_kind(nk, nt, fc, ns, 3, op)
        ast_child(fc, ns, node, left)
        ast_child(fc, ns, node, right)
        left = node
    }
    left
}

fn parse_cmp(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut left = parse_shift(tk, tt, pos, nk, nt, fc, ns)
    while vec_get(pos, 0) < vec_len(tk) {
        let mut op: str = ""
        let mut k = vec_get(tk, vec_get(pos, 0))
        if k == 201 { op = "==" }
        if k == 203 { op = "!=" }
        if k == 204 { op = "<=" }
        if k == 206 { op = ">=" }
        if is_single(tk, tt, vec_get(pos, 0), "<") == 1 { op = "<" }
        if is_single(tk, tt, vec_get(pos, 0), ">") == 1 { op = ">" }
        if str_eq(op, "") == 1 { break }
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut right = parse_shift(tk, tt, pos, nk, nt, fc, ns)
        let mut node = ast_kind(nk, nt, fc, ns, 3, op)
        ast_child(fc, ns, node, left)
        ast_child(fc, ns, node, right)
        left = node
    }
    left
}

fn parse_bitand(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut left = parse_cmp(tk, tt, pos, nk, nt, fc, ns)
    while vec_get(pos, 0) < vec_len(tk) {
        if is_single(tk, tt, vec_get(pos, 0), "&") == 0 { break }
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut right = parse_cmp(tk, tt, pos, nk, nt, fc, ns)
        let mut node = ast_kind(nk, nt, fc, ns, 3, "&")
        ast_child(fc, ns, node, left)
        ast_child(fc, ns, node, right)
        left = node
    }
    left
}

fn parse_bitxor(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut left = parse_bitand(tk, tt, pos, nk, nt, fc, ns)
    while vec_get(pos, 0) < vec_len(tk) {
        if is_single(tk, tt, vec_get(pos, 0), "^") == 0 { break }
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut right = parse_bitand(tk, tt, pos, nk, nt, fc, ns)
        let mut node = ast_kind(nk, nt, fc, ns, 3, "^")
        ast_child(fc, ns, node, left)
        ast_child(fc, ns, node, right)
        left = node
    }
    left
}

fn parse_bitor(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut left = parse_bitxor(tk, tt, pos, nk, nt, fc, ns)
    while vec_get(pos, 0) < vec_len(tk) {
        if is_single(tk, tt, vec_get(pos, 0), "|") == 0 { break }
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut right = parse_bitxor(tk, tt, pos, nk, nt, fc, ns)
        let mut node = ast_kind(nk, nt, fc, ns, 3, "|")
        ast_child(fc, ns, node, left)
        ast_child(fc, ns, node, right)
        left = node
    }
    left
}

fn parse_and(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut left = parse_bitor(tk, tt, pos, nk, nt, fc, ns)
    while vec_get(pos, 0) < vec_len(tk) {
        if vec_get(tk, vec_get(pos, 0)) != 208 { break }
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut right = parse_bitor(tk, tt, pos, nk, nt, fc, ns)
        let mut node = ast_kind(nk, nt, fc, ns, 3, "&&")
        ast_child(fc, ns, node, left)
        ast_child(fc, ns, node, right)
        left = node
    }
    left
}

fn parse_or(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut left = parse_and(tk, tt, pos, nk, nt, fc, ns)
    while vec_get(pos, 0) < vec_len(tk) {
        if vec_get(tk, vec_get(pos, 0)) != 209 { break }
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut right = parse_and(tk, tt, pos, nk, nt, fc, ns)
        let mut node = ast_kind(nk, nt, fc, ns, 3, "||")
        ast_child(fc, ns, node, left)
        ast_child(fc, ns, node, right)
        left = node
    }
    left
}

fn parse_expr(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    parse_or(tk, tt, pos, nk, nt, fc, ns)
}

fn parse_block(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut block = ast_kind(nk, nt, fc, ns, 5, "")
    if is_single(tk, tt, vec_get(pos, 0), "{") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
    while vec_get(pos, 0) < vec_len(tk) {
        if is_single(tk, tt, vec_get(pos, 0), "}") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1); break }
        if vec_get(tk, vec_get(pos, 0)) == 999 { break }
        let mut s = parse_stmt(tk, tt, pos, nk, nt, fc, ns)
        ast_child(fc, ns, block, s)
    }
    block
}

fn parse_stmt(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut k = vec_get(tk, vec_get(pos, 0))
    if k == 2 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        if vec_get(tk, vec_get(pos, 0)) == 3 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
        let mut name = vec_get_str(tt, vec_get(pos, 0))
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        if is_single(tk, tt, vec_get(pos, 0), ":") == 1 {
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            let mut ltype = parse_type_name(tk, tt, pos)
        }
        if is_single(tk, tt, vec_get(pos, 0), "=") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
        let mut init = parse_expr(tk, tt, pos, nk, nt, fc, ns)
        // skip catch !E => handler (compile-time only), възможно верижно
        while vec_get(tk, vec_get(pos, 0)) == 16 {
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            if is_single(tk, tt, vec_get(pos, 0), "=") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
            if is_single(tk, tt, vec_get(pos, 0), ">") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
            let handler = parse_expr(tk, tt, pos, nk, nt, fc, ns)
        }
        let node = ast_kind(nk, nt, fc, ns, 6, name)
        ast_child(fc, ns, node, init)
        return node
    }
    if k == 9 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let node = ast_kind(nk, nt, fc, ns, 7, "")
        if is_single(tk, tt, vec_get(pos, 0), "}") == 0 {
            if vec_get(tk, vec_get(pos, 0)) != 999 {
                let val = parse_expr(tk, tt, pos, nk, nt, fc, ns)
                ast_child(fc, ns, node, val)
            }
        }
        return node
    }
    if k == 4 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let cond = parse_expr(tk, tt, pos, nk, nt, fc, ns)
        let mut then_br = parse_block(tk, tt, pos, nk, nt, fc, ns)
        let node = ast_kind(nk, nt, fc, ns, 8, "")
        ast_child(fc, ns, node, cond)
        ast_child(fc, ns, node, then_br)
        if vec_get(tk, vec_get(pos, 0)) == 5 {
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            let mut else_br = parse_block(tk, tt, pos, nk, nt, fc, ns)
            ast_child(fc, ns, node, else_br)
        }
        return node
    }
    if k == 6 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut cond = parse_expr(tk, tt, pos, nk, nt, fc, ns)
        let body = parse_block(tk, tt, pos, nk, nt, fc, ns)
        let node = ast_kind(nk, nt, fc, ns, 9, "")
        ast_child(fc, ns, node, cond)
        ast_child(fc, ns, node, body)
        return node
    }
    // break
    if k == 17 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        return ast_kind(nk, nt, fc, ns, 14, "")
    }
    // continue
    if k == 18 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        return ast_kind(nk, nt, fc, ns, 15, "")
    }
    // for i in lo..hi { body }
    if k == 7 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut var = vec_get_str(tt, vec_get(pos, 0))
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        // skip in
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut lo = parse_expr(tk, tt, pos, nk, nt, fc, ns)
        // skip ..
        if vec_get(tk, vec_get(pos, 0)) == 210 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
        let mut hi = parse_expr(tk, tt, pos, nk, nt, fc, ns)
        let mut body = parse_block(tk, tt, pos, nk, nt, fc, ns)
        let node = ast_kind(nk, nt, fc, ns, 18, var)
        ast_child(fc, ns, node, lo)
        ast_child(fc, ns, node, hi)
        ast_child(fc, ns, node, body)
        return node
    }
    let mut e = parse_expr(tk, tt, pos, nk, nt, fc, ns)
    // assignment: IDENT = expr
    if node_kind(nk, e) == 2 {
        if is_single(tk, tt, vec_get(pos, 0), "=") == 1 {
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            let val = parse_expr(tk, tt, pos, nk, nt, fc, ns)
            let anode = ast_kind(nk, nt, fc, ns, 17, node_text(nt, e))
            ast_child(fc, ns, anode, val)
            return anode
        }
        // compound assignment: IDENT += / -= / *= / /= expr  →  IDENT = IDENT op expr
        let mut ct = vec_get(tk, vec_get(pos, 0))
        let mut cop = ""
        if ct == 211 { cop = "+" }
        if ct == 212 { cop = "-" }
        if ct == 213 { cop = "*" }
        if ct == 214 { cop = "/" }
        if str_eq(cop, "") == 0 {
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            let mut val = parse_expr(tk, tt, pos, nk, nt, fc, ns)
            let mut anode = ast_kind(nk, nt, fc, ns, 17, node_text(nt, e))
            let mut binop = ast_kind(nk, nt, fc, ns, 3, cop)
            let mut lhs = ast_kind(nk, nt, fc, ns, 2, node_text(nt, e))
            ast_child(fc, ns, binop, lhs)
            ast_child(fc, ns, binop, val)
            ast_child(fc, ns, anode, binop)
            return anode
        }
    }
    // skip catch !E => handler (compile-time only), възможно верижно
    while vec_get(tk, vec_get(pos, 0)) == 16 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        if is_single(tk, tt, vec_get(pos, 0), "=") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
        if is_single(tk, tt, vec_get(pos, 0), ">") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
        let mut handler = parse_expr(tk, tt, pos, nk, nt, fc, ns)
    }
    let mut node = ast_kind(nk, nt, fc, ns, 10, "")
    ast_child(fc, ns, node, e)
    node
}

fn parse_struct(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    vec_set(pos, 0, vec_get(pos, 0) + 1)
    let mut name = vec_get_str(tt, vec_get(pos, 0))
    vec_set(pos, 0, vec_get(pos, 0) + 1)
    let mut node = ast_kind(nk, nt, fc, ns, 21, name)
    if is_single(tk, tt, vec_get(pos, 0), "{") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
    while is_single(tk, tt, vec_get(pos, 0), "}") == 0 {
        if vec_get(tk, vec_get(pos, 0)) == 999 { break }
        let mut fname = vec_get_str(tt, vec_get(pos, 0))
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        if is_single(tk, tt, vec_get(pos, 0), ":") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
        let mut ftype = vec_get_str(tt, vec_get(pos, 0))
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut fld = ast_kind(nk, nt, fc, ns, 25, concat(fname, concat(":", ftype)))
        ast_child(fc, ns, node, fld)
        if is_single(tk, tt, vec_get(pos, 0), ",") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
    }
    if is_single(tk, tt, vec_get(pos, 0), "}") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
    node
}

// LP7: честен отказ на language ниво вместо счупен C на изхода.
fn self_unsupported(what: str) {
    eprintln(concat(concat("неподдържан конструкт в self компилатора: ", what), " — използвай C bootstrap './baga'"))
    exit(1)
}

fn parse_enum(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    vec_set(pos, 0, vec_get(pos, 0) + 1)
    let mut name = vec_get_str(tt, vec_get(pos, 0))
    vec_set(pos, 0, vec_get(pos, 0) + 1)
    let mut node = ast_kind(nk, nt, fc, ns, 28, name)
    if is_single(tk, tt, vec_get(pos, 0), "{") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
    while is_single(tk, tt, vec_get(pos, 0), "}") == 0 {
        if vec_get(tk, vec_get(pos, 0)) == 999 { break }
        let mut vname = vec_get_str(tt, vec_get(pos, 0))
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        if is_single(tk, tt, vec_get(pos, 0), "(") == 1 {
            self_unsupported(concat(concat("сум enum с payload-и (вариант '", vname), "')"))
        }
        let mut vn = ast_kind(nk, nt, fc, ns, 29, vname)
        ast_child(fc, ns, node, vn)
        if is_single(tk, tt, vec_get(pos, 0), ",") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
    }
    if is_single(tk, tt, vec_get(pos, 0), "}") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
    node
}

fn is_section_keyword(s: str) -> i64 {
    if str_eq(s, "input") == 1 { return 1 }
    if str_eq(s, "output") == 1 { return 1 }
    if str_eq(s, "requires") == 1 { return 1 }
    if str_eq(s, "ensures") == 1 { return 1 }
    if str_eq(s, "guarantees") == 1 { return 1 }
    0
}

fn tokens_text(tt: Vec, start: i64, end: i64) -> str {
    let mut r = ""
    let mut i = start
    while i < end {
        if str_eq(r, "") == 0 { r = concat(r, " ") }
        r = concat(r, vec_get_str(tt, i))
        i = i + 1
    }
    r
}

fn at_section(tk: Vec, tt: Vec, pos: Vec) -> i64 {
    let mut p = vec_get(pos, 0)
    if vec_get(tk, p) == 0 {
        if p + 1 < vec_len(tk) {
            if is_section_keyword(vec_get_str(tt, p)) == 1 {
                if is_single(tk, tt, p + 1, ":") == 1 { return 1 }
            }
        }
    }
    0
}

fn parse_spec(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    vec_set(pos, 0, vec_get(pos, 0) + 1)
    let mut name = vec_get_str(tt, vec_get(pos, 0))
    vec_set(pos, 0, vec_get(pos, 0) + 1)
    let mut node = ast_kind(nk, nt, fc, ns, 30, name)
    if is_single(tk, tt, vec_get(pos, 0), "{") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
    while is_single(tk, tt, vec_get(pos, 0), "}") == 0 {
        if vec_get(tk, vec_get(pos, 0)) == 999 { break }
        let mut sec = vec_get_str(tt, vec_get(pos, 0))
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        if is_single(tk, tt, vec_get(pos, 0), ":") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
        if str_eq(sec, "output") == 1 {
            let mut otype = parse_type_name(tk, tt, pos)
            let mut onode = ast_kind(nk, nt, fc, ns, 16, otype)
            ast_child(fc, ns, node, onode)
        } else {
            if str_eq(sec, "requires") == 1 {
                while is_single(tk, tt, vec_get(pos, 0), "}") == 0 {
                    if at_section(tk, tt, pos) == 1 { break }
                    let st = vec_get(pos, 0)
                    let expr = parse_expr(tk, tt, pos, nk, nt, fc, ns)
                    let enode = ast_kind(nk, nt, fc, ns, 31, tokens_text(tt, st, vec_get(pos, 0)))
                    ast_child(fc, ns, enode, expr)
                    ast_child(fc, ns, node, enode)
                    if is_single(tk, tt, vec_get(pos, 0), ",") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) } else { break }
                }
            } else {
                if str_eq(sec, "ensures") == 1 {
                    while is_single(tk, tt, vec_get(pos, 0), "}") == 0 {
                        if at_section(tk, tt, pos) == 1 { break }
                        let mut st = vec_get(pos, 0)
                        let mut expr = parse_expr(tk, tt, pos, nk, nt, fc, ns)
                        let mut enode = ast_kind(nk, nt, fc, ns, 32, tokens_text(tt, st, vec_get(pos, 0)))
                        ast_child(fc, ns, enode, expr)
                        ast_child(fc, ns, node, enode)
                        if is_single(tk, tt, vec_get(pos, 0), ",") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) } else { break }
                    }
                } else {
                    if str_eq(sec, "input") == 1 {
                        while is_single(tk, tt, vec_get(pos, 0), "}") == 0 {
                            if at_section(tk, tt, pos) == 1 { break }
                            if vec_get(tk, vec_get(pos, 0)) == 999 { break }
                            let mut pname = vec_get_str(tt, vec_get(pos, 0))
                            vec_set(pos, 0, vec_get(pos, 0) + 1)
                            if is_single(tk, tt, vec_get(pos, 0), ":") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
                            let mut ptype = parse_type_name(tk, tt, pos)
                            let mut pnode = ast_kind(nk, nt, fc, ns, 12, concat(pname, concat(":", ptype)))
                            ast_child(fc, ns, node, pnode)
                            if is_single(tk, tt, vec_get(pos, 0), ",") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
                        }
                    } else {
                        while is_single(tk, tt, vec_get(pos, 0), "}") == 0 {
                            if at_section(tk, tt, pos) == 1 { break }
                            if vec_get(tk, vec_get(pos, 0)) == 999 { break }
                            vec_set(pos, 0, vec_get(pos, 0) + 1)
                        }
                    }
                }
            }
        }
    }
    if is_single(tk, tt, vec_get(pos, 0), "}") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
    node
}

fn parse_type_name(tk: Vec, tt: Vec, pos: Vec) -> str {
    let mut name = vec_get_str(tt, vec_get(pos, 0))
    vec_set(pos, 0, vec_get(pos, 0) + 1)
    if is_single(tk, tt, vec_get(pos, 0), "<") == 1 {
        let mut depth: i64 = 0
        while vec_get(tk, vec_get(pos, 0)) != 999 {
            if is_single(tk, tt, vec_get(pos, 0), "<") == 1 { depth = depth + 1 }
            if is_single(tk, tt, vec_get(pos, 0), ">") == 1 { depth = depth - 1 }
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            if depth == 0 { break }
        }
    }
    name
}

fn parse_fn(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    vec_set(pos, 0, vec_get(pos, 0) + 1)
    let mut name = vec_get_str(tt, vec_get(pos, 0))
    vec_set(pos, 0, vec_get(pos, 0) + 1)
    let mut node = ast_kind(nk, nt, fc, ns, 11, name)
    if is_single(tk, tt, vec_get(pos, 0), "(") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
    while is_single(tk, tt, vec_get(pos, 0), ")") == 0 {
        if vec_get(tk, vec_get(pos, 0)) == 999 { break }
        let mut pname = vec_get_str(tt, vec_get(pos, 0))
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        if is_single(tk, tt, vec_get(pos, 0), ":") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
        let mut ptype = parse_type_name(tk, tt, pos)
        let mut param = ast_kind(nk, nt, fc, ns, 12, concat(pname, concat(":", ptype)))
        ast_child(fc, ns, node, param)
        if is_single(tk, tt, vec_get(pos, 0), ",") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
    }
    if is_single(tk, tt, vec_get(pos, 0), ")") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
    if vec_get(tk, vec_get(pos, 0)) == 200 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut rettype = parse_type_name(tk, tt, pos)
        let mut tnode = ast_kind(nk, nt, fc, ns, 16, rettype)
        ast_child(fc, ns, node, tnode)
        while is_single(tk, tt, vec_get(pos, 0), "!") == 1 {
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            vec_set(pos, 0, vec_get(pos, 0) + 1)
        }
    }
    // forward declaration: no body if next token is not {
    if is_single(tk, tt, vec_get(pos, 0), "{") == 0 {
        return node
    }
    let mut body = parse_block(tk, tt, pos, nk, nt, fc, ns)
    ast_child(fc, ns, node, body)
    node
}

// ============================================================
//  Codegen: AST → C
// ============================================================

fn int_to_str(n: i64) -> str {
    if n == 0 { return "0" }
    let mut result = ""
    let mut v = n
    while v > 0 {
        let mut d = v - (v / 10) * 10
        result = concat(byte_chr(48 + d), result)
        v = v / 10
    }
    result
}

fn mangle(name: str) -> str {
    let mut result = "b_"
    let mut i: i64 = 0
    let mut n = len(name)
    while i < n {
        let mut c = char_at(name, i)
        if c >= 97 { if c <= 122 { result = concat(result, byte_chr(c)); i = i + 1; continue } }
        if c >= 65 { if c <= 90 { result = concat(result, byte_chr(c)); i = i + 1; continue } }
        if c >= 48 { if c <= 57 { result = concat(result, byte_chr(c)); i = i + 1; continue } }
        if c == 95 { result = concat(result, "_"); i = i + 1; continue }
        result = concat(result, concat("_", int_to_str(c)))
        i = i + 1
    }
    result
}

fn indent_str(depth: i64) -> str {
    let mut s = ""
    let mut i: i64 = 0
    while i < depth {
        s = concat(s, "    ")
        i = i + 1
    }
    s
}

fn c_escape(s: str) -> str {
    let mut result = ""
    let mut i: i64 = 0
    let mut n = len(s)
    let mut bs = byte_chr(92)
    while i < n {
        let mut c = char_at(s, i)
        let mut handled: i64 = 0
        if c == 34 { result = concat(result, concat(bs, byte_chr(34))); handled = 1 }
        if c == 92 { result = concat(result, concat(bs, bs)); handled = 1 }
        if c == 10 { result = concat(result, concat(bs, "x0a")); handled = 1 }
        if c == 9 { result = concat(result, concat(bs, "x09")); handled = 1 }
        if handled == 0 { result = concat(result, byte_chr(c)) }
        i = i + 1
    }
    result
}

fn enum_variant_cname(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, name: str) -> str {
    let mut e = first_child(fc, prog)
    while e >= 0 {
        if node_kind(nk, e) == 28 {
            let mut v = first_child(fc, e)
            while v >= 0 {
                if str_eq(node_text(nt, v), name) == 1 {
                    return concat(concat(mangle(node_text(nt, e)), "_"), mangle(name))
                }
                v = next_sibling(ns, v)
            }
        }
        e = next_sibling(ns, e)
    }
    ""
}

fn emit_expr(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, idx: i64) -> str {
    let mut k = node_kind(nk, idx)
    let mut t = node_text(nt, idx)

    // INT
    if k == 0 { return concat(t, "LL") }
    // FLOAT (суров текст — валиден C double литерал)
    if k == 19 { return t }
    // BOOL (1/0 като C int)
    if k == 20 { return t }
    // STRUCT LIT: (b_Име){ .b_поле = стойност, ... }
    if k == 22 {
        let mut r = concat(concat("(", mangle(t)), "){ ")
        let mut fi = first_child(fc, idx)
        let mut first_f: i64 = 1
        while fi >= 0 {
            if first_f == 0 { r = concat(r, ", ") }
            let mut val = first_child(fc, fi)
            r = concat(concat(concat(r, "."), concat(mangle(node_text(nt, fi)), " = ")), emit_expr(nk, nt, fc, ns, prog, val))
            first_f = 0
            fi = next_sibling(ns, fi)
        }
        return concat(r, " }")
    }
    // FIELD ACCESS: obj.b_поле
    if k == 23 {
        let mut obj = first_child(fc, idx)
        return concat(concat(emit_expr(nk, nt, fc, ns, prog, obj), "."), mangle(t))
    }
    // MATCH: GCC statement expression ({ T _mrN=0; int64_t _mvN=e; if..else..; _mrN; })
    if k == 26 {
        let mut mexpr = first_child(fc, idx)
        let mut arm1 = next_sibling(ns, mexpr)
        let mut ctype = "int64_t"
        if arm1 >= 0 {
            let mut b1 = first_child(fc, arm1)
            if str_eq(node_text(nt, arm1), "_") == 0 { b1 = next_sibling(ns, b1) }
            if b1 >= 0 {
                if expr_is_str(nk, nt, fc, ns, prog, b1) == 1 { ctype = "const char *" }
                else {
                    if expr_is_float(nk, nt, fc, ns, prog, b1) == 1 { ctype = "double" }
                    else { if expr_is_bool(nk, nt, fc, ns, prog, b1) == 1 { ctype = "int" } }
                }
            }
        }
        let mut suf = int_to_str(idx)
        let mut r = concat(concat(concat(concat(concat("({ ", ctype), concat(" _mr", suf)), concat(" = 0; int64_t _mv", suf)), " = "), concat(emit_expr(nk, nt, fc, ns, prog, mexpr), "; "))
        let mut arm = arm1
        let mut first_arm: i64 = 1
        while arm >= 0 {
            let mut abody = first_child(fc, arm)
            if str_eq(node_text(nt, arm), "_") == 1 {
                r = concat(r, "else { ")
            } else {
                let mut pat = abody
                abody = next_sibling(ns, pat)
                if first_arm == 0 { r = concat(r, "else ") }
                r = concat(concat(concat(concat(concat(r, "if (_mv"), suf), " == "), emit_expr(nk, nt, fc, ns, prog, pat)), ") { ")
            }
            r = concat(concat(concat(concat(r, "_mr"), suf), " = "), concat(emit_expr(nk, nt, fc, ns, prog, abody), "; } "))
            first_arm = 0
            arm = next_sibling(ns, arm)
        }
        return concat(concat(concat(r, "_mr"), suf), "; })")
    }
    // TO_STR (интерполация): конверсия според типа (heuristic)
    if k == 33 {
        let mut e = first_child(fc, idx)
        if expr_is_str(nk, nt, fc, ns, prog, e) == 1 {
            return emit_expr(nk, nt, fc, ns, prog, e)
        }
        if expr_is_bool(nk, nt, fc, ns, prog, e) == 1 {
            return concat(concat(concat("((", emit_expr(nk, nt, fc, ns, prog, e)), ") ? \"true\" : \"false\")"), "")
        }
        return concat("baga_i64_to_str(", concat(emit_expr(nk, nt, fc, ns, prog, e), ")"))
    }
    // STR
    if k == 1 { return concat(concat("\"", c_escape(t)), "\"") }
    // BYTES LIT (x"deadbeef")
    if k == 34 { return concat("baga_bytes_from_hex(", concat(concat("\"", c_escape(t)), "\")")) }
    // IDENT (enum вариант → константа, иначе mangle)
    if k == 2 {
        let mut ev = enum_variant_cname(nk, nt, fc, ns, prog, t)
        if str_eq(ev, "") == 0 { return ev }
        return mangle(t)
    }
    // BINARY
    if k == 3 {
        let mut left = first_child(fc, idx)
        let mut right = next_sibling(ns, left)
        return concat(concat(concat("(", emit_expr(nk, nt, fc, ns, prog, left)), concat(" ", t)), concat(" ", concat(emit_expr(nk, nt, fc, ns, prog, right), ")")))
    }
    // CALL
    if k == 4 {
        let mut callee = first_child(fc, idx)
        // check for builtin
        let mut cname = ""
        if node_kind(nk, callee) == 2 {
            let mut bn = node_text(nt, callee)
            // LP7: builtin-и извън подмножеството на self компилатора
            if str_eq(bn, "drop") == 1 { self_unsupported("drop (MEM-1)") }
            if str_eq(bn, "go") == 1 { self_unsupported("go/!Par конкурентност") }
            if str_eq(bn, "join") == 1 { self_unsupported("join/!Par конкурентност") }
            if str_eq(bn, "detach") == 1 { self_unsupported("detach/!Par конкурентност") }
            if str_eq(bn, "chan_new") == 1 { self_unsupported("канали (!Par)") }
            if str_eq(bn, "chan_send") == 1 { self_unsupported("канали (!Par)") }
            if str_eq(bn, "chan_recv") == 1 { self_unsupported("канали (!Par)") }
            if str_eq(bn, "chan_recv2") == 1 { self_unsupported("канали (!Par)") }
            if str_eq(bn, "chan_try_recv") == 1 { self_unsupported("канали (!Par)") }
            if str_eq(bn, "chan_recv_timeout") == 1 { self_unsupported("канали (!Par)") }
            if str_eq(bn, "chan_select2") == 1 { self_unsupported("канали (!Par)") }
            if str_eq(bn, "chan_select2_wait") == 1 { self_unsupported("канали (!Par)") }
            if str_eq(bn, "chan_select2_timeout") == 1 { self_unsupported("канали (!Par)") }
            if str_eq(bn, "chan_close") == 1 { self_unsupported("канали (!Par)") }
            if str_eq(bn, "chan_len") == 1 { self_unsupported("канали (!Par)") }
            if str_eq(bn, "mutex_new") == 1 { self_unsupported("mutex-и (!Par)") }
            if str_eq(bn, "mutex_lock") == 1 { self_unsupported("mutex-и (!Par)") }
            if str_eq(bn, "mutex_unlock") == 1 { self_unsupported("mutex-и (!Par)") }
            if str_eq(bn, "sleep_ms") == 1 { self_unsupported("sleep_ms (!Par)") }
            if str_eq(bn, "signal_watch") == 1 { self_unsupported("C1 сигнали") }
            if str_eq(bn, "signal_check") == 1 { self_unsupported("C1 сигнали") }
            if str_eq(bn, "signal_clear") == 1 { self_unsupported("C1 сигнали") }
            if str_eq(bn, "signal_wait") == 1 { self_unsupported("C1 сигнали") }
            if str_eq(bn, "signal_raise") == 1 { self_unsupported("C1 сигнали") }
            if str_eq(bn, "cell2") == 1 { self_unsupported("cell2 heap двойки") }
            if str_eq(bn, "cell2_0") == 1 { self_unsupported("cell2 heap двойки") }
            if str_eq(bn, "cell2_1") == 1 { self_unsupported("cell2 heap двойки") }
            let mut a1 = next_sibling(ns, callee)
            if str_eq(bn, "len") == 1 { cname = "baga_len" }
            if str_eq(bn, "char_at") == 1 { cname = "baga_char_at" }
            if str_eq(bn, "byte_at") == 1 { cname = "baga_byte_at" }
            if str_eq(bn, "byte_chr") == 1 { cname = "baga_byte_chr" }
            if str_eq(bn, "substr") == 1 { cname = "baga_substr" }
            if str_eq(bn, "concat") == 1 { cname = "baga_concat" }
            if str_eq(bn, "str_eq") == 1 { cname = "baga_str_eq" }
            if str_eq(bn, "chr") == 1 { cname = "baga_chr" }
            if str_eq(bn, "ord") == 1 { cname = "baga_ord" }
            if str_eq(bn, "bytes_len") == 1 { cname = "baga_bytes_len" }
            if str_eq(bn, "bytes_at") == 1 { cname = "baga_bytes_at" }
            if str_eq(bn, "bytes_slice") == 1 { cname = "baga_bytes_slice" }
            if str_eq(bn, "bytes_concat") == 1 { cname = "baga_bytes_concat" }
            if str_eq(bn, "bytes_of_str") == 1 { cname = "baga_bytes_from_str" }
            if str_eq(bn, "str_of_bytes") == 1 { cname = "baga_bytes_to_str" }
            if str_eq(bn, "hex_encode") == 1 { cname = "baga_hex_encode" }
            if str_eq(bn, "hex_decode") == 1 { cname = "baga_hex_decode" }
            if str_eq(bn, "read_file") == 1 { cname = "baga_read_file" }
            if str_eq(bn, "write") == 1 { cname = "baga_write" }
            if str_eq(bn, "vec_new") == 1 { cname = "baga_vec_new" }
            if str_eq(bn, "vec_push") == 1 {
                cname = "baga_vec_push_i64"
                if a1 >= 0 {
                    let elem = next_sibling(ns, a1)
                    if elem >= 0 {
                        if expr_is_str(nk, nt, fc, ns, prog, elem) == 1 { cname = "baga_vec_push_str" }
                        if expr_is_float(nk, nt, fc, ns, prog, elem) == 1 { cname = "baga_vec_push_f64" }
                    }
                }
            }
            if str_eq(bn, "vec_push_str") == 1 { cname = "baga_vec_push_str" }
            if str_eq(bn, "vec_get") == 1 {
                cname = "baga_vec_get_i64"
                if a1 >= 0 {
                    if vec_is_str(nk, nt, fc, ns, prog, a1) == 1 { cname = "baga_vec_get_str" }
                    if vec_is_f64(nk, nt, fc, ns, prog, a1) == 1 { cname = "baga_vec_get_f64" }
                }
            }
            if str_eq(bn, "vec_get_str") == 1 { cname = "baga_vec_get_str" }
            if str_eq(bn, "vec_set") == 1 {
                cname = "baga_vec_set_i64"
                if a1 >= 0 {
                    let mut ai = next_sibling(ns, a1)
                    let mut elem = next_sibling(ns, ai)
                    if elem >= 0 {
                        if expr_is_str(nk, nt, fc, ns, prog, elem) == 1 { cname = "baga_vec_set_str" }
                        if expr_is_float(nk, nt, fc, ns, prog, elem) == 1 { cname = "baga_vec_set_f64" }
                    }
                }
            }
            if str_eq(bn, "vec_set_str") == 1 { cname = "baga_vec_set_str" }
            if str_eq(bn, "vec_len") == 1 { cname = "baga_vec_len" }
            if str_eq(bn, "vec_slice") == 1 {
                cname = "baga_vec_slice_i64"
                if a1 >= 0 {
                    if vec_is_str(nk, nt, fc, ns, prog, a1) == 1 { cname = "baga_vec_slice_str" }
                    if vec_is_f64(nk, nt, fc, ns, prog, a1) == 1 { cname = "baga_vec_slice_f64" }
                }
            }
            if str_eq(bn, "vec_concat") == 1 {
                cname = "baga_vec_concat_i64"
                if a1 >= 0 {
                    if vec_is_str(nk, nt, fc, ns, prog, a1) == 1 { cname = "baga_vec_concat_str" }
                    if vec_is_f64(nk, nt, fc, ns, prog, a1) == 1 { cname = "baga_vec_concat_f64" }
                }
            }
            if str_eq(bn, "arg_count") == 1 { cname = "baga_arg_count" }
            if str_eq(bn, "arg") == 1 { cname = "baga_arg" }
            if str_eq(bn, "exit") == 1 { cname = "baga_exit" }
            if str_eq(bn, "eprintln") == 1 { cname = "baga_eprintln" }
            if str_eq(bn, "arena_new") == 1 { cname = "baga_arena_new" }
            if str_eq(bn, "arena_alloc") == 1 { cname = "baga_arena_alloc" }
            if str_eq(bn, "arena_reset") == 1 { cname = "baga_arena_reset" }
            if str_eq(bn, "arena_free") == 1 { cname = "baga_arena_free" }
            // MEM-4: bump arena има само C bootstrap-ът; тук runtime-ът е malloc
            if str_eq(bn, "mem_mark") == 1 { self_unsupported("mem_mark") }
            if str_eq(bn, "mem_rewind") == 1 { self_unsupported("mem_rewind") }
            if str_eq(bn, "mem_persist_begin") == 1 { self_unsupported("mem_persist_begin") }
            if str_eq(bn, "mem_persist_end") == 1 { self_unsupported("mem_persist_end") }
            // extern fn (FFI) — директно име, без builtin диспеч (последен печели)
            if is_extern_fn(nk, nt, fc, ns, prog, bn) == 1 { cname = bn }
        }
        let mut result = ""
        if str_eq(cname, "") == 0 {
            result = concat(cname, "(")
        } else {
            result = concat(emit_expr(nk, nt, fc, ns, prog, callee), "(")
        }
        let mut arg = next_sibling(ns, callee)
        let mut first_arg: i64 = 1
        while arg >= 0 {
            if first_arg == 0 { result = concat(result, ", ") }
            result = concat(result, emit_expr(nk, nt, fc, ns, prog, arg))
            first_arg = 0
            arg = next_sibling(ns, arg)
        }
        return concat(result, ")")
    }
    "0"
}

fn fn_ret_c_type(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, fname: str) -> str {
    let mut f = first_child(fc, prog)
    while f >= 0 {
        if node_kind(nk, f) == 11 {
            if str_eq(node_text(nt, f), fname) == 1 {
                let mut c = first_child(fc, f)
                while c >= 0 {
                    if node_kind(nk, c) == 16 { return c_type(node_text(nt, c)) }
                    c = next_sibling(ns, c)
                }
                return "int64_t"
            }
        }
        f = next_sibling(ns, f)
    }
    "int64_t"
}

fn expr_is_str(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, idx: i64) -> i64 {
    let mut k = node_kind(nk, idx)
    if k == 1 { return 1 }
    if k == 4 {
        let mut cal = first_child(fc, idx)
        if node_kind(nk, cal) == 2 {
            let mut bn = node_text(nt, cal)
            if str_eq(bn, "concat") == 1 { return 1 }
            if str_eq(bn, "substr") == 1 { return 1 }
            if str_eq(bn, "chr") == 1 { return 1 }
            if str_eq(bn, "read_file") == 1 { return 1 }
            if str_eq(bn, "arg") == 1 { return 1 }
            if str_eq(bn, "vec_get_str") == 1 { return 1 }
            if str_eq(bn, "hex_encode") == 1 { return 1 }
            if str_eq(bn, "str_of_bytes") == 1 { return 1 }
            if str_eq(bn, "vec_get") == 1 {
                let mut va1 = next_sibling(ns, cal)
                if va1 >= 0 {
                    if vec_is_str(nk, nt, fc, ns, prog, va1) == 1 { return 1 }
                }
            }
            let mut rt = fn_ret_c_type(nk, nt, fc, ns, prog, bn)
            if str_eq(rt, "const char *") == 1 { return 1 }
        }
    }
    if k == 2 {
        let mut vname = node_text(nt, idx)
        let mut f = first_child(fc, prog)
        while f >= 0 {
            if node_kind(nk, f) == 11 {
                let mut c = first_child(fc, f)
                while c >= 0 {
                    if node_kind(nk, c) == 5 {
                        let mut s = first_child(fc, c)
                        while s >= 0 {
                            if node_kind(nk, s) == 6 {
                                if str_eq(node_text(nt, s), vname) == 1 {
                                    let mut init = first_child(fc, s)
                                    return expr_is_str(nk, nt, fc, ns, prog, init)
                                }
                            }
                            s = next_sibling(ns, s)
                        }
                    }
                    c = next_sibling(ns, c)
                }
            }
            f = next_sibling(ns, f)
        }
    }
    0
}

fn expr_is_float(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, idx: i64) -> i64 {
    let mut k = node_kind(nk, idx)
    if k == 19 { return 1 }
    if k == 3 {
        let mut left = first_child(fc, idx)
        let mut right = next_sibling(ns, left)
        if expr_is_float(nk, nt, fc, ns, prog, left) == 1 { return 1 }
        if expr_is_float(nk, nt, fc, ns, prog, right) == 1 { return 1 }
        return 0
    }
    if k == 4 {
        let mut cal = first_child(fc, idx)
        if node_kind(nk, cal) == 2 {
            let mut bn = node_text(nt, cal)
            if str_eq(bn, "vec_get") == 1 {
                let mut a1 = next_sibling(ns, cal)
                if a1 >= 0 {
                    if vec_is_f64(nk, nt, fc, ns, prog, a1) == 1 { return 1 }
                }
            }
            let mut rt = fn_ret_c_type(nk, nt, fc, ns, prog, bn)
            if str_eq(rt, "double") == 1 { return 1 }
        }
        return 0
    }
    if k == 2 {
        let mut vname = node_text(nt, idx)
        let mut f = first_child(fc, prog)
        while f >= 0 {
            if node_kind(nk, f) == 11 {
                let mut c = first_child(fc, f)
                while c >= 0 {
                    if node_kind(nk, c) == 5 {
                        let mut s = first_child(fc, c)
                        while s >= 0 {
                            if node_kind(nk, s) == 6 {
                                if str_eq(node_text(nt, s), vname) == 1 {
                                    let mut init = first_child(fc, s)
                                    return expr_is_float(nk, nt, fc, ns, prog, init)
                                }
                            }
                            s = next_sibling(ns, s)
                        }
                    }
                    c = next_sibling(ns, c)
                }
            }
            f = next_sibling(ns, f)
        }
    }
    0
}

// Като expr_is_float, но НЕ разрешава vec_get (няма vec_is_f64). Ползва се от
// vec_is_f64 за класификация на push-елемент, за да не се получи безкрайна
// взаимна рекурсия expr_is_float ↔ vec_is_f64 при vec_push(v, ... vec_get(v) ...).
fn expr_is_float_shallow(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, idx: i64) -> i64 {
    let mut k = node_kind(nk, idx)
    if k == 19 { return 1 }
    if k == 3 {
        let mut left = first_child(fc, idx)
        let mut right = next_sibling(ns, left)
        if expr_is_float_shallow(nk, nt, fc, ns, prog, left) == 1 { return 1 }
        if expr_is_float_shallow(nk, nt, fc, ns, prog, right) == 1 { return 1 }
        return 0
    }
    if k == 4 {
        let mut cal = first_child(fc, idx)
        if node_kind(nk, cal) == 2 {
            let mut bn = node_text(nt, cal)
            let mut rt = fn_ret_c_type(nk, nt, fc, ns, prog, bn)
            if str_eq(rt, "double") == 1 { return 1 }
        }
        return 0
    }
    if k == 2 {
        let mut vname = node_text(nt, idx)
        let mut f = first_child(fc, prog)
        while f >= 0 {
            if node_kind(nk, f) == 11 {
                let mut c = first_child(fc, f)
                while c >= 0 {
                    if node_kind(nk, c) == 5 {
                        let mut s = first_child(fc, c)
                        while s >= 0 {
                            if node_kind(nk, s) == 6 {
                                if str_eq(node_text(nt, s), vname) == 1 {
                                    let mut init = first_child(fc, s)
                                    return expr_is_float_shallow(nk, nt, fc, ns, prog, init)
                                }
                            }
                            s = next_sibling(ns, s)
                        }
                    }
                    c = next_sibling(ns, c)
                }
            }
            f = next_sibling(ns, f)
        }
    }
    0
}

fn expr_is_bool(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, idx: i64) -> i64 {
    let mut k = node_kind(nk, idx)
    if k == 20 { return 1 }
    if k == 3 {
        let mut op = node_text(nt, idx)
        if str_eq(op, "==") == 1 { return 1 }
        if str_eq(op, "!=") == 1 { return 1 }
        if str_eq(op, "<") == 1 { return 1 }
        if str_eq(op, ">") == 1 { return 1 }
        if str_eq(op, "<=") == 1 { return 1 }
        if str_eq(op, ">=") == 1 { return 1 }
        if str_eq(op, "&&") == 1 { return 1 }
        if str_eq(op, "||") == 1 { return 1 }
        return 0
    }
    if k == 4 {
        let mut cal = first_child(fc, idx)
        if node_kind(nk, cal) == 2 {
            let mut bn = node_text(nt, cal)
            if str_eq(bn, "str_eq") == 1 { return 1 }
            let mut rt = fn_ret_c_type(nk, nt, fc, ns, prog, bn)
            if str_eq(rt, "int") == 1 { return 1 }
        }
        return 0
    }
    if k == 2 {
        let mut vname = node_text(nt, idx)
        let mut f = first_child(fc, prog)
        while f >= 0 {
            if node_kind(nk, f) == 11 {
                let mut c = first_child(fc, f)
                while c >= 0 {
                    if node_kind(nk, c) == 5 {
                        let mut s = first_child(fc, c)
                        while s >= 0 {
                            if node_kind(nk, s) == 6 {
                                if str_eq(node_text(nt, s), vname) == 1 {
                                    let mut init = first_child(fc, s)
                                    return expr_is_bool(nk, nt, fc, ns, prog, init)
                                }
                            }
                            s = next_sibling(ns, s)
                        }
                    }
                    c = next_sibling(ns, c)
                }
            }
            f = next_sibling(ns, f)
        }
    }
    0
}

fn vec_is_str(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, vnode: i64) -> i64 {
    if node_kind(nk, vnode) != 2 { return 0 }
    let mut vname = node_text(nt, vnode)
    let mut f = first_child(fc, prog)
    while f >= 0 {
        if node_kind(nk, f) == 11 {
            let mut c = first_child(fc, f)
            while c >= 0 {
                if node_kind(nk, c) == 5 {
                    let mut s = first_child(fc, c)
                    while s >= 0 {
                        if node_kind(nk, s) == 10 {
                            let mut e = first_child(fc, s)
                            if node_kind(nk, e) == 4 {
                                let mut cal = first_child(fc, e)
                                if node_kind(nk, cal) == 2 {
                                    let mut bn = node_text(nt, cal)
                                    let mut a1 = next_sibling(ns, cal)
                                    if a1 >= 0 {
                                        if node_kind(nk, a1) == 2 {
                                            if str_eq(node_text(nt, a1), vname) == 1 {
                                                if str_eq(bn, "vec_push_str") == 1 { return 1 }
                                                if str_eq(bn, "vec_set_str") == 1 { return 1 }
                                                if str_eq(bn, "vec_push") == 1 {
                                                    let elem = next_sibling(ns, a1)
                                                    if elem >= 0 {
                                                        if expr_is_str(nk, nt, fc, ns, prog, elem) == 1 { return 1 }
                                                    }
                                                }
                                                if str_eq(bn, "vec_set") == 1 {
                                                    let mut ai = next_sibling(ns, a1)
                                                    let mut elem = next_sibling(ns, ai)
                                                    if elem >= 0 {
                                                        if expr_is_str(nk, nt, fc, ns, prog, elem) == 1 { return 1 }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        s = next_sibling(ns, s)
                    }
                }
                c = next_sibling(ns, c)
            }
        }
        f = next_sibling(ns, f)
    }
    0
}

fn vec_is_f64(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, vnode: i64) -> i64 {
    if node_kind(nk, vnode) != 2 { return 0 }
    let mut vname = node_text(nt, vnode)
    let mut f = first_child(fc, prog)
    while f >= 0 {
        if node_kind(nk, f) == 11 {
            let mut c = first_child(fc, f)
            while c >= 0 {
                if node_kind(nk, c) == 5 {
                    let mut s = first_child(fc, c)
                    while s >= 0 {
                        if node_kind(nk, s) == 10 {
                            let mut e = first_child(fc, s)
                            if node_kind(nk, e) == 4 {
                                let mut cal = first_child(fc, e)
                                if node_kind(nk, cal) == 2 {
                                    let mut bn = node_text(nt, cal)
                                    let mut a1 = next_sibling(ns, cal)
                                    if a1 >= 0 {
                                        if node_kind(nk, a1) == 2 {
                                            if str_eq(node_text(nt, a1), vname) == 1 {
                                                if str_eq(bn, "vec_push") == 1 {
                                                    let elem = next_sibling(ns, a1)
                                                    if elem >= 0 {
                                                        if expr_is_float_shallow(nk, nt, fc, ns, prog, elem) == 1 { return 1 }
                                                    }
                                                }
                                                if str_eq(bn, "vec_set") == 1 {
                                                    let mut ai = next_sibling(ns, a1)
                                                    let mut elem = next_sibling(ns, ai)
                                                    if elem >= 0 {
                                                        if expr_is_float_shallow(nk, nt, fc, ns, prog, elem) == 1 { return 1 }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        s = next_sibling(ns, s)
                    }
                }
                c = next_sibling(ns, c)
            }
        }
        f = next_sibling(ns, f)
    }
    0
}

fn emit_stmt(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, idx: i64, depth: i64) {
    let mut k = node_kind(nk, idx)
    let mut ind = indent_str(depth)

    // BLOCK
    if k == 5 {
        write(concat(ind, "{\n"))
        let mut child = first_child(fc, idx)
        while child >= 0 {
            emit_stmt(nk, nt, fc, ns, prog, child, depth + 1)
            child = next_sibling(ns, child)
        }
        write(concat(ind, "}\n"))
        return
    }
    // LET
    if k == 6 {
        let mut init = first_child(fc, idx)
        // detect type from init expression
        let mut ctype = "int64_t"
        if node_kind(nk, init) == 1 { ctype = "const char *" }
        if node_kind(nk, init) == 34 { ctype = "baga_bytes" }
        if node_kind(nk, init) == 22 { ctype = mangle(node_text(nt, init)) }
        if node_kind(nk, init) == 4 {
            let mut cal = first_child(fc, init)
            if node_kind(nk, cal) == 2 {
                let mut bn = node_text(nt, cal)
                if str_eq(bn, "concat") == 1 { ctype = "const char *" }
                if str_eq(bn, "substr") == 1 { ctype = "const char *" }
                if str_eq(bn, "chr") == 1 { ctype = "const char *" }
                if str_eq(bn, "read_file") == 1 { ctype = "const char *" }
                if str_eq(bn, "arg") == 1 { ctype = "const char *" }
                if str_eq(bn, "vec_get_str") == 1 { ctype = "const char *" }
                if str_eq(bn, "vec_new") == 1 { ctype = "baga_Vec *" }
                if str_eq(bn, "bytes_of_str") == 1 { ctype = "baga_bytes" }
                if str_eq(bn, "bytes_slice") == 1 { ctype = "baga_bytes" }
                if str_eq(bn, "bytes_concat") == 1 { ctype = "baga_bytes" }
                if str_eq(bn, "hex_decode") == 1 { ctype = "baga_bytes" }
                // user function: look up return type
                let mut rt = fn_ret_c_type(nk, nt, fc, ns, prog, bn)
                if str_eq(rt, "const char *") == 1 { ctype = "const char *" }
                if str_eq(rt, "baga_Vec *") == 1 { ctype = "baga_Vec *" }
                if str_eq(rt, "baga_bytes") == 1 { ctype = "baga_bytes" }
            }
        }
        if expr_is_float(nk, nt, fc, ns, prog, init) == 1 { ctype = "double" }
        write(concat(concat(concat(concat(ind, concat(ctype, " ")), mangle(node_text(nt, idx))), " = "), concat(emit_expr(nk, nt, fc, ns, prog, init), ";\n")))
        return
    }
    // RETURN
    if k == 7 {
        let val = first_child(fc, idx)
        if val >= 0 {
            write(concat(concat(ind, "return "), concat(emit_expr(nk, nt, fc, ns, prog, val), ";\n")))
        } else {
            write(concat(ind, "return;\n"))
        }
        return
    }
    // IF
    if k == 8 {
        let cond = first_child(fc, idx)
        let mut then_br = next_sibling(ns, cond)
        let mut else_br = next_sibling(ns, then_br)
        write(concat(concat(ind, "if ("), concat(emit_expr(nk, nt, fc, ns, prog, cond), ") {\n")))
        let mut s = first_child(fc, then_br)
        while s >= 0 {
            emit_stmt(nk, nt, fc, ns, prog, s, depth + 1)
            s = next_sibling(ns, s)
        }
        if else_br >= 0 {
            write(concat(ind, "} else {\n"))
            let mut s2 = first_child(fc, else_br)
            while s2 >= 0 {
                emit_stmt(nk, nt, fc, ns, prog, s2, depth + 1)
                s2 = next_sibling(ns, s2)
            }
        }
        write(concat(ind, "}\n"))
        return
    }
    // WHILE
    if k == 9 {
        let mut cond = first_child(fc, idx)
        let body = next_sibling(ns, cond)
        write(concat(concat(ind, "while ("), concat(emit_expr(nk, nt, fc, ns, prog, cond), ") {\n")))
        let mut s = first_child(fc, body)
        while s >= 0 {
            emit_stmt(nk, nt, fc, ns, prog, s, depth + 1)
            s = next_sibling(ns, s)
        }
        write(concat(ind, "}\n"))
        return
    }
    // EXPR_STMT
    if k == 10 {
        let mut e = first_child(fc, idx)
        // check for print call
        if node_kind(nk, e) == 4 {
            let mut callee = first_child(fc, e)
            if node_kind(nk, callee) == 2 {
                let mut cname2 = node_text(nt, callee)
                if str_eq(cname2, "print") == 1 {
                    let mut arg = next_sibling(ns, callee)
                    if arg >= 0 {
                        if expr_is_str(nk, nt, fc, ns, prog, arg) == 1 {
                            write(concat(concat(ind, "printf(\"%s\\n\", "), concat(emit_expr(nk, nt, fc, ns, prog, arg), ");\n")))
                        } else {
                            if expr_is_float(nk, nt, fc, ns, prog, arg) == 1 {
                                write(concat(concat(ind, "printf(\"%g\\n\", "), concat(emit_expr(nk, nt, fc, ns, prog, arg), ");\n")))
                            } else {
                                if expr_is_bool(nk, nt, fc, ns, prog, arg) == 1 {
                                    write(concat(concat(ind, "printf(\"%s\\n\", ("), concat(emit_expr(nk, nt, fc, ns, prog, arg), ") ? \"true\" : \"false\");\n")))
                                } else {
                                    write(concat(concat(ind, "printf(\"%lld\\n\", (long long)("), concat(emit_expr(nk, nt, fc, ns, prog, arg), "));\n")))
                                }
                            }
                        }
                    } else {
                        write(concat(ind, "printf(\"\\n\");\n"))
                    }
                    return
                }
            }
        }
        write(concat(concat(ind, emit_expr(nk, nt, fc, ns, prog, e)), ";\n"))
        return
    }
    // BREAK
    if k == 14 {
        write(concat(ind, "break;\n"))
        return
    }
    // CONTINUE
    if k == 15 {
        write(concat(ind, "continue;\n"))
        return
    }
    // ASSIGN
    if k == 17 {
        let mut val = first_child(fc, idx)
        write(concat(concat(concat(ind, mangle(node_text(nt, idx))), " = "), concat(emit_expr(nk, nt, fc, ns, prog, val), ";\n")))
        return
    }
    // FOR
    if k == 18 {
        let mut lo = first_child(fc, idx)
        let mut hi = next_sibling(ns, lo)
        let mut body = next_sibling(ns, hi)
        let mut v = mangle(node_text(nt, idx))
        write(concat(concat(concat(concat(ind, "for (int64_t "), v), " = "), concat(emit_expr(nk, nt, fc, ns, prog, lo), "; ")))
        write(concat(concat(concat(v, " < "), emit_expr(nk, nt, fc, ns, prog, hi)), concat("; ", concat(v, "++) {\n"))))
        let mut s = first_child(fc, body)
        while s >= 0 {
            emit_stmt(nk, nt, fc, ns, prog, s, depth + 1)
            s = next_sibling(ns, s)
        }
        write(concat(ind, "}\n"))
        return
    }
}

fn c_type(t: str) -> str {
    if str_eq(t, "i64") == 1 { return "int64_t" }
    if str_eq(t, "str") == 1 { return "const char *" }
    if str_eq(t, "bytes") == 1 { return "baga_bytes" }
    if str_eq(t, "Vec") == 1 { return "baga_Vec *" }
    if str_eq(t, "f64") == 1 { return "double" }
    if str_eq(t, "bool") == 1 { return "int" }
    if str_eq(t, "void") == 1 { return "void" }
    if str_eq(t, "") == 1 { return "int64_t" }
    mangle(t)
}

fn emit_fn(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, idx: i64) {
    let mut name = node_text(nt, idx)
    let mut child = first_child(fc, idx)

    let mut params = ""
    let mut rettype = "void"
    while child >= 0 {
        let mut ck = node_kind(nk, child)
        if ck == 12 {
            let mut ptext = node_text(nt, child)
            let mut ci: i64 = 0
            let mut pn = len(ptext)
            while ci < pn {
                if char_at(ptext, ci) == 58 { break }
                ci = ci + 1
            }
            let mut pname = substr(ptext, 0, ci)
            let mut ptype = "i64"
            if ci + 1 < pn { ptype = substr(ptext, ci + 1, pn) }
            if str_eq(params, "") == 0 { params = concat(params, ", ") }
            params = concat(params, concat(c_type(ptype), concat(" ", mangle(pname))))
        }
        if ck == 16 { rettype = c_type(node_text(nt, child)) }
        child = next_sibling(ns, child)
    }

    if str_eq(params, "") == 1 { params = "void" }
    let mut spc = find_spec(nk, nt, fc, ns, prog, name)
    if spc >= 0 {
        let mut d1 = concat(rettype, " ")
        let mut d2 = concat(mangle(name), "_impl")
        let mut d3 = concat("(", concat(params, ");\n"))
        write(concat(concat(d1, d2), d3))
    }
    write(concat(concat(concat(concat(rettype, " "), mangle(name)), concat("(", params)), ");\n"))
}

// extern fn (FFI): прототип с директното C име и C ABI типове, без mangle
fn emit_extern_fn(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, idx: i64) {
    let mut name = node_text(nt, idx)
    let mut child = first_child(fc, idx)
    let mut params = ""
    let mut rettype = "int64_t"
    while child >= 0 {
        let mut ck = node_kind(nk, child)
        if ck == 12 {
            let mut ptext = node_text(nt, child)
            let mut ci: i64 = 0
            let mut pn = len(ptext)
            while ci < pn {
                if char_at(ptext, ci) == 58 { break }
                ci = ci + 1
            }
            let mut ptype = "i64"
            if ci + 1 < pn { ptype = substr(ptext, ci + 1, pn) }
            if str_eq(params, "") == 0 { params = concat(params, ", ") }
            params = concat(params, c_type(ptype))
        }
        if ck == 16 { rettype = c_type(node_text(nt, child)) }
        child = next_sibling(ns, child)
    }
    if str_eq(params, "") == 1 { params = "void" }
    write(concat(concat(concat(concat(rettype, " "), name), concat("(", params)), ");\n"))
}

fn emit_fn_def(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, idx: i64) {
    let mut name = node_text(nt, idx)
    let mut child = first_child(fc, idx)

    let mut params = ""
    let mut argnames = ""
    let mut rettype = "void"
    let mut body: i64 = 0 - 1
    while child >= 0 {
        let mut ck = node_kind(nk, child)
        if ck == 12 {
            let mut ptext = node_text(nt, child)
            let mut ci: i64 = 0
            let mut pn = len(ptext)
            while ci < pn {
                if char_at(ptext, ci) == 58 { break }
                ci = ci + 1
            }
            let mut pname = substr(ptext, 0, ci)
            let mut ptype = "i64"
            if ci + 1 < pn { ptype = substr(ptext, ci + 1, pn) }
            if str_eq(params, "") == 0 { params = concat(params, ", ") }
            params = concat(params, concat(c_type(ptype), concat(" ", mangle(pname))))
            if str_eq(argnames, "") == 0 { argnames = concat(argnames, ", ") }
            argnames = concat(argnames, mangle(pname))
        }
        if ck == 16 { rettype = c_type(node_text(nt, child)) }
        if ck == 5 { body = child }
        child = next_sibling(ns, child)
    }

    let mut spc = find_spec(nk, nt, fc, ns, prog, name)
    let mut fn_m = mangle(name)
    let mut impl_m = fn_m
    if spc >= 0 { impl_m = concat(fn_m, "_impl") }

    if str_eq(params, "") == 1 { params = "void" }
    write(concat(concat(concat(concat(rettype, " "), impl_m), concat("(", params)), ") {\n"))

    // emit body statements
    if body >= 0 {
        let mut s = first_child(fc, body)
        while s >= 0 {
            let mut next_s = next_sibling(ns, s)
            // implicit return: last expr stmt in non-void fn
            if next_s < 0 {
                if str_eq(rettype, "void") == 0 {
                    if node_kind(nk, s) == 10 {
                        let mut e = first_child(fc, s)
                        write(concat("    return ", concat(emit_expr(nk, nt, fc, ns, prog, e), ";\n")))
                        s = next_s
                        continue
                    }
                }
            }
            emit_stmt(nk, nt, fc, ns, prog, s, 1)
            s = next_s
        }
    }

    write("}\n\n")

    // wrapper с requires/ensures проверки (ако fn има spec)
    if spc >= 0 {
        let mut spec_name = node_text(nt, spc)
        let mut wh1 = concat(rettype, " ")
        let mut wh2 = concat("(", concat(params, ") {\n"))
        write(concat(concat(wh1, fn_m), wh2))
        let mut ri: i64 = 0
        let mut c = first_child(fc, spc)
        while c >= 0 {
            if node_kind(nk, c) == 31 {
                let expr = first_child(fc, c)
                ri = ri + 1
                let s1 = concat("    if (!(", emit_expr(nk, nt, fc, ns, prog, expr))
                let s2 = concat(s1, ")) baga_spec_fail(\"")
                let s3 = concat(s2, c_escape(spec_name))
                let s4 = concat(s3, "\", \"requires\", ")
                let s5 = concat(s4, int_to_str(ri))
                let s6 = concat(s5, ", \"")
                let s7 = concat(s6, c_escape(node_text(nt, c)))
                write(concat(s7, "\");\n"))
            }
            c = next_sibling(ns, c)
        }
        let mut ic1 = concat("    ", concat(rettype, " b_output = "))
        let mut ic2 = concat("(", concat(argnames, ");\n"))
        write(concat(concat(ic1, impl_m), ic2))
        let mut ei: i64 = 0
        c = first_child(fc, spc)
        while c >= 0 {
            if node_kind(nk, c) == 32 {
                let mut expr = first_child(fc, c)
                ei = ei + 1
                let mut s1 = concat("    if (!(", emit_expr(nk, nt, fc, ns, prog, expr))
                let mut s2 = concat(s1, ")) baga_spec_fail(\"")
                let mut s3 = concat(s2, c_escape(spec_name))
                let mut s4 = concat(s3, "\", \"ensures\", ")
                let mut s5 = concat(s4, int_to_str(ei))
                let mut s6 = concat(s5, ", \"")
                let mut s7 = concat(s6, c_escape(node_text(nt, c)))
                write(concat(s7, "\");\n"))
            }
            c = next_sibling(ns, c)
        }
        write("    return b_output;\n")
        write("}\n\n")
    }
}

// ============================================================
//  Checker (минимален: типове на аргументи + vec смесване)
// ============================================================

fn typekind_of_typename(name: str) -> i64 {
    if str_eq(name, "i64") == 1 { return 0 }
    if str_eq(name, "i32") == 1 { return 0 }
    if str_eq(name, "str") == 1 { return 1 }
    if str_eq(name, "f64") == 1 { return 2 }
    if str_eq(name, "bool") == 1 { return 3 }
    if str_eq(name, "Vec") == 1 { return 4 }
    0 - 1
}

fn typekind_name(k: i64) -> str {
    if k == 0 { return "i64" }
    if k == 1 { return "str" }
    if k == 2 { return "f64" }
    if k == 3 { return "bool" }
    if k == 4 { return "Vec" }
    "?"
}

fn is_user_fn(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, name: str) -> i64 {
    let mut f = first_child(fc, prog)
    while f >= 0 {
        if node_kind(nk, f) == 11 {
            if str_eq(node_text(nt, f), name) == 1 { return 1 }
        }
        f = next_sibling(ns, f)
    }
    0
}

fn is_extern_fn(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, name: str) -> i64 {
    let mut f = first_child(fc, prog)
    while f >= 0 {
        if node_kind(nk, f) == 35 {
            if str_eq(node_text(nt, f), name) == 1 { return 1 }
        }
        f = next_sibling(ns, f)
    }
    0
}

fn fn_param_count(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, name: str) -> i64 {
    let mut f = first_child(fc, prog)
    while f >= 0 {
        if node_kind(nk, f) == 11 {
            if str_eq(node_text(nt, f), name) == 1 {
                let mut cnt: i64 = 0
                let mut c = first_child(fc, f)
                while c >= 0 {
                    if node_kind(nk, c) == 12 { cnt = cnt + 1 }
                    c = next_sibling(ns, c)
                }
                return cnt
            }
        }
        f = next_sibling(ns, f)
    }
    0
}

fn fn_param_typekind(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, name: str, pidx: i64) -> i64 {
    let mut f = first_child(fc, prog)
    while f >= 0 {
        if node_kind(nk, f) == 11 {
            if str_eq(node_text(nt, f), name) == 1 {
                let mut cnt: i64 = 0
                let mut c = first_child(fc, f)
                while c >= 0 {
                    if node_kind(nk, c) == 12 {
                        if cnt == pidx {
                            let mut ptext = node_text(nt, c)
                            let mut ci: i64 = 0
                            let mut pn = len(ptext)
                            while ci < pn {
                                if char_at(ptext, ci) == 58 { break }
                                ci = ci + 1
                            }
                            let mut ptype = ""
                            if ci + 1 < pn { ptype = substr(ptext, ci + 1, pn) }
                            return typekind_of_typename(ptype)
                        }
                        cnt = cnt + 1
                    }
                    c = next_sibling(ns, c)
                }
            }
        }
        f = next_sibling(ns, f)
    }
    0 - 1
}

fn fn_ret_typekind(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, name: str) -> i64 {
    let mut f = first_child(fc, prog)
    while f >= 0 {
        if node_kind(nk, f) == 11 {
            if str_eq(node_text(nt, f), name) == 1 {
                let mut c = first_child(fc, f)
                while c >= 0 {
                    if node_kind(nk, c) == 16 { return typekind_of_typename(node_text(nt, c)) }
                    c = next_sibling(ns, c)
                }
                return 0 - 1
            }
        }
        f = next_sibling(ns, f)
    }
    0 - 1
}

fn expr_typekind(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, idx: i64) -> i64 {
    let mut k = node_kind(nk, idx)
    if k == 0 { return 0 }
    if k == 1 { return 1 }
    if k == 19 { return 2 }
    if k == 20 { return 3 }
    if k == 22 { return 5 }
    if k == 4 {
        let mut cal = first_child(fc, idx)
        if node_kind(nk, cal) == 2 {
            let mut bn = node_text(nt, cal)
            if is_user_fn(nk, nt, fc, ns, prog, bn) == 1 {
                return fn_ret_typekind(nk, nt, fc, ns, prog, bn)
            }
            if str_eq(bn, "len") == 1 { return 0 }
            if str_eq(bn, "vec_len") == 1 { return 0 }
            if str_eq(bn, "ord") == 1 { return 0 }
            if str_eq(bn, "char_at") == 1 { return 0 }
            if str_eq(bn, "arg_count") == 1 { return 0 }
            if str_eq(bn, "concat") == 1 { return 1 }
            if str_eq(bn, "substr") == 1 { return 1 }
            if str_eq(bn, "chr") == 1 { return 1 }
            if str_eq(bn, "arg") == 1 { return 1 }
            if str_eq(bn, "vec_get_str") == 1 { return 1 }
            if str_eq(bn, "str_eq") == 1 { return 3 }
        }
        return 0 - 1
    }
    if k == 2 {
        let mut ev = enum_variant_cname(nk, nt, fc, ns, prog, node_text(nt, idx))
        if str_eq(ev, "") == 0 { return 0 }
    }
    0 - 1
}

fn check_call(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, idx: i64) {
    let mut cal = first_child(fc, idx)
    if node_kind(nk, cal) != 2 { return }
    let mut fname = node_text(nt, cal)
    if is_user_fn(nk, nt, fc, ns, prog, fname) == 0 { return }
    let mut nargs: i64 = 0
    let mut a = next_sibling(ns, cal)
    while a >= 0 {
        nargs = nargs + 1
        a = next_sibling(ns, a)
    }
    let mut pcount = fn_param_count(nk, nt, fc, ns, prog, fname)
    if nargs != pcount {
        eprintln(concat(concat(concat(concat(concat("'", fname), "' очаква "), int_to_str(pcount)), " аргумента, получих "), int_to_str(nargs)))
        exit(1)
    }
    let mut ai: i64 = 0
    let mut arg = next_sibling(ns, cal)
    while arg >= 0 {
        let mut at = expr_typekind(nk, nt, fc, ns, prog, arg)
        let mut pt = fn_param_typekind(nk, nt, fc, ns, prog, fname, ai)
        if at >= 0 {
            if pt >= 0 {
                if at != pt {
                    eprintln(concat(concat(concat(concat(concat(concat(concat("'", fname), "': аргумент #"), int_to_str(ai + 1)), " е от тип "), typekind_name(at)), ", но параметърът е "), typekind_name(pt)))
                    exit(1)
                }
            }
        }
        ai = ai + 1
        arg = next_sibling(ns, arg)
    }
}

fn vec_first_type(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, name: str) -> i64 {
    let mut f = first_child(fc, prog)
    while f >= 0 {
        if node_kind(nk, f) == 11 {
            let mut c = first_child(fc, f)
            while c >= 0 {
                if node_kind(nk, c) == 5 {
                    let mut s = first_child(fc, c)
                    while s >= 0 {
                        if node_kind(nk, s) == 10 {
                            let mut e = first_child(fc, s)
                            if node_kind(nk, e) == 4 {
                                let mut cal = first_child(fc, e)
                                if node_kind(nk, cal) == 2 {
                                    let mut bn = node_text(nt, cal)
                                    let mut a1 = next_sibling(ns, cal)
                                    if a1 >= 0 {
                                        if node_kind(nk, a1) == 2 {
                                            if str_eq(node_text(nt, a1), name) == 1 {
                                                if str_eq(bn, "vec_push_str") == 1 { return 1 }
                                                if str_eq(bn, "vec_set_str") == 1 { return 1 }
                                                if str_eq(bn, "vec_push") == 1 {
                                                    let elem = next_sibling(ns, a1)
                                                    if elem >= 0 {
                                                        if expr_is_str(nk, nt, fc, ns, prog, elem) == 1 { return 1 }
                                                        if expr_is_float(nk, nt, fc, ns, prog, elem) == 1 { return 2 }
                                                        return 0
                                                    }
                                                }
                                                if str_eq(bn, "vec_set") == 1 {
                                                    let mut ai2 = next_sibling(ns, a1)
                                                    let mut elem = next_sibling(ns, ai2)
                                                    if elem >= 0 {
                                                        if expr_is_str(nk, nt, fc, ns, prog, elem) == 1 { return 1 }
                                                        if expr_is_float(nk, nt, fc, ns, prog, elem) == 1 { return 2 }
                                                        return 0
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        s = next_sibling(ns, s)
                    }
                }
                c = next_sibling(ns, c)
            }
        }
        f = next_sibling(ns, f)
    }
    0 - 1
}

fn check_vec_push(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, idx: i64) {
    let mut cal = first_child(fc, idx)
    if node_kind(nk, cal) != 2 { return }
    let mut bn = node_text(nt, cal)
    let mut is_push: i64 = 0
    if str_eq(bn, "vec_push") == 1 { is_push = 1 }
    if str_eq(bn, "vec_set") == 1 { is_push = 1 }
    if str_eq(bn, "vec_push_str") == 1 { is_push = 1 }
    if str_eq(bn, "vec_set_str") == 1 { is_push = 1 }
    if is_push == 0 { return }
    let mut a1 = next_sibling(ns, cal)
    if a1 < 0 { return }
    if node_kind(nk, a1) != 2 { return }
    let mut vname = node_text(nt, a1)
    // тип на текущия елемент: 0=i64, 1=str, 2=f64
    let mut cur: i64 = 0
    if str_eq(bn, "vec_push_str") == 1 { cur = 1 }
    if str_eq(bn, "vec_set_str") == 1 { cur = 1 }
    if str_eq(bn, "vec_push") == 1 {
        let elem = next_sibling(ns, a1)
        if elem >= 0 {
            if expr_is_str(nk, nt, fc, ns, prog, elem) == 1 { cur = 1 }
            if expr_is_float(nk, nt, fc, ns, prog, elem) == 1 { cur = 2 }
        }
    }
    if str_eq(bn, "vec_set") == 1 {
        let mut ai = next_sibling(ns, a1)
        let mut elem = next_sibling(ns, ai)
        if elem >= 0 {
            if expr_is_str(nk, nt, fc, ns, prog, elem) == 1 { cur = 1 }
            if expr_is_float(nk, nt, fc, ns, prog, elem) == 1 { cur = 2 }
        }
    }
    let mut first = vec_first_type(nk, nt, fc, ns, prog, vname)
    if first >= 0 {
        if cur != first {
            eprintln(concat(concat(concat(concat("vec_push: елемент от тип ", typekind_name(cur)), ", но векторът е Vec<"), typekind_name(first)), ">"))
            exit(1)
        }
    }
}

fn check_node(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, idx: i64) {
    if idx < 0 { return }
    if node_kind(nk, idx) == 4 {
        check_call(nk, nt, fc, ns, prog, idx)
        check_vec_push(nk, nt, fc, ns, prog, idx)
    }
    let mut c = first_child(fc, idx)
    while c >= 0 {
        check_node(nk, nt, fc, ns, prog, c)
        c = next_sibling(ns, c)
    }
}

fn find_spec(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, fn_name: str) -> i64 {
    let mut s = first_child(fc, prog)
    while s >= 0 {
        if node_kind(nk, s) == 30 {
            if str_eq(node_text(nt, s), fn_name) == 1 {
                let mut c = first_child(fc, s)
                while c >= 0 {
                    let mut ck = node_kind(nk, c)
                    if ck == 31 { return s }
                    if ck == 32 { return s }
                    c = next_sibling(ns, c)
                }
            }
        }
        s = next_sibling(ns, s)
    }
    0 - 1
}

fn check_specs(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64) {
    let mut s = first_child(fc, prog)
    while s >= 0 {
        if node_kind(nk, s) == 30 {
            let mut spec_name = node_text(nt, s)
            let mut out_tk = 0 - 1
            let mut c = first_child(fc, s)
            while c >= 0 {
                if node_kind(nk, c) == 16 { out_tk = typekind_of_typename(node_text(nt, c)) }
                c = next_sibling(ns, c)
            }
            if out_tk >= 0 {
                if is_user_fn(nk, nt, fc, ns, prog, spec_name) == 1 {
                    let mut fn_ret = fn_ret_typekind(nk, nt, fc, ns, prog, spec_name)
                    if fn_ret >= 0 {
                        if out_tk != fn_ret {
                            eprintln(concat(concat(concat(concat(concat("spec '", spec_name), "': output е "), typekind_name(out_tk)), ", но функцията връща "), typekind_name(fn_ret)))
                            exit(1)
                        }
                    }
                }
            }
        }
        s = next_sibling(ns, s)
    }
}

fn check_program(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64) {
    check_specs(nk, nt, fc, ns, prog)
    check_node(nk, nt, fc, ns, prog, prog)
}

// ============================================================
//  --test-specs (property-based)
// ============================================================

fn spec_has_checks(nk: Vec, nt: Vec, fc: Vec, ns: Vec, spc: i64) -> i64 {
    let mut c = first_child(fc, spc)
    while c >= 0 {
        let mut ck = node_kind(nk, c)
        if ck == 31 { return 1 }
        if ck == 32 { return 1 }
        c = next_sibling(ns, c)
    }
    0
}

fn spec_inputs_testable(nk: Vec, nt: Vec, fc: Vec, ns: Vec, spc: i64) -> i64 {
    let mut c = first_child(fc, spc)
    while c >= 0 {
        if node_kind(nk, c) == 12 {
            let mut ptext = node_text(nt, c)
            let mut ci: i64 = 0
            let mut pn = len(ptext)
            while ci < pn {
                if char_at(ptext, ci) == 58 { break }
                ci = ci + 1
            }
            let mut ptype = ""
            if ci + 1 < pn { ptype = substr(ptext, ci + 1, pn) }
            if str_eq(ptype, "i64") == 0 {
                if str_eq(ptype, "bool") == 0 { return 0 }
            }
        }
        c = next_sibling(ns, c)
    }
    1
}

fn emit_requires_predicate(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, spc: i64) {
    let mut mn = mangle(node_text(nt, spc))
    let mut req_name = concat("b__req_", substr(mn, 2, len(mn)))
    let mut params = ""
    let mut c = first_child(fc, spc)
    while c >= 0 {
        if node_kind(nk, c) == 12 {
            let mut ptext = node_text(nt, c)
            let mut ci: i64 = 0
            let mut pn = len(ptext)
            while ci < pn {
                if char_at(ptext, ci) == 58 { break }
                ci = ci + 1
            }
            let mut pname = substr(ptext, 0, ci)
            let mut ptype = "i64"
            if ci + 1 < pn { ptype = substr(ptext, ci + 1, pn) }
            if str_eq(params, "") == 0 { params = concat(params, ", ") }
            params = concat(params, concat(c_type(ptype), concat(" ", mangle(pname))))
        }
        c = next_sibling(ns, c)
    }
    if str_eq(params, "") == 1 { params = "void" }
    write(concat(concat(concat("static int ", req_name), "("), concat(params, ") {\n")))
    let mut body = ""
    let mut c2 = first_child(fc, spc)
    while c2 >= 0 {
        if node_kind(nk, c2) == 31 {
            let mut expr = first_child(fc, c2)
            if str_eq(body, "") == 0 { body = concat(body, " && ") }
            body = concat(body, concat("(", concat(emit_expr(nk, nt, fc, ns, prog, expr), ")")))
        }
        c2 = next_sibling(ns, c2)
    }
    if str_eq(body, "") == 1 { body = "1" }
    write(concat(concat("    return ", body), ";\n}\n\n"))
}

fn emit_spec_test(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, spc: i64) {
    let mut spec_name = node_text(nt, spc)
    let mut mn = mangle(spec_name)
    let mut req_name = concat("b__req_", substr(mn, 2, len(mn)))
    let mut fn_name = mn
    let mut np: i64 = 0
    let mut c = first_child(fc, spc)
    while c >= 0 {
        if node_kind(nk, c) == 12 { np = np + 1 }
        c = next_sibling(ns, c)
    }
    let mut arr_n = np
    if arr_n == 0 { arr_n = 1 }
    let mut callargs = ""
    let mut j: i64 = 0
    while j < np {
        if str_eq(callargs, "") == 0 { callargs = concat(callargs, ", ") }
        callargs = concat(callargs, concat("args[", concat(int_to_str(j), "]")))
        j = j + 1
    }
    write("    { int passed = 0, skipped = 0;\n")
    write("      for (int t = 0; t < 100; t++) {\n")
    write(concat(concat("          int64_t args[", int_to_str(arr_n)), "];\n"))
    write("          int ok = 0;\n")
    write("          for (long tr = 0; tr < 1000000 && !ok; tr++) {\n")
    let mut c2 = first_child(fc, spc)
    let mut idx: i64 = 0
    while c2 >= 0 {
        if node_kind(nk, c2) == 12 {
            let mut ptext = node_text(nt, c2)
            let mut ci: i64 = 0
            let mut pn = len(ptext)
            while ci < pn {
                if char_at(ptext, ci) == 58 { break }
                ci = ci + 1
            }
            let mut ptype = "i64"
            if ci + 1 < pn { ptype = substr(ptext, ci + 1, pn) }
            if str_eq(ptype, "bool") == 1 {
                write(concat(concat("              args[", int_to_str(idx)), "] = baga_rand_i64(0, 1);\n"))
            } else {
                write(concat(concat("              args[", int_to_str(idx)), "] = baga_rand_i64(-1000, 1000);\n"))
            }
            idx = idx + 1
        }
        c2 = next_sibling(ns, c2)
    }
    write(concat(concat(concat(concat("              ok = ", req_name), "("), callargs), ");\n"))
    write("              if (!ok) skipped++;\n")
    write("          }\n")
    write("          if (!ok) continue;\n")
    write(concat(concat("          baga_cur_nargs = ", int_to_str(np)), ";\n"))
    let mut k: i64 = 0
    while k < np {
        write(concat(concat(concat(concat("          baga_cur_args[", int_to_str(k)), "] = args["), int_to_str(k)), "];\n"))
        k = k + 1
    }
    write(concat(concat(concat(concat("          (void)", fn_name), "("), callargs), ");\n"))
    write("          passed++;\n      }\n")
    write(concat(concat("      printf(\"", c_escape(spec_name)), ": %d/100 теста минаха (%d пропуснати от requires)\\n\", passed, skipped);\n"))
    write("    }\n")
}

fn emit_test_driver(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64) {
    let mut s = first_child(fc, prog)
    while s >= 0 {
        if node_kind(nk, s) == 30 {
            if spec_has_checks(nk, nt, fc, ns, s) == 1 {
                if spec_inputs_testable(nk, nt, fc, ns, s) == 1 {
                    emit_requires_predicate(nk, nt, fc, ns, prog, s)
                }
            }
        }
        s = next_sibling(ns, s)
    }
    let mut n_tested: i64 = 0
    s = first_child(fc, prog)
    while s >= 0 {
        if node_kind(nk, s) == 30 {
            if spec_has_checks(nk, nt, fc, ns, s) == 1 {
                if spec_inputs_testable(nk, nt, fc, ns, s) == 1 { n_tested = n_tested + 1 }
            }
        }
        s = next_sibling(ns, s)
    }
    write("int main(int argc, char **argv) {\n")
    write("    baga_argc = argc; baga_argv = argv;\n")
    if n_tested == 0 {
        write("    printf(\"няма spec-ове за тестване\\n\");\n")
        write("    return 0;\n}\n")
        return
    }
    s = first_child(fc, prog)
    while s >= 0 {
        if node_kind(nk, s) == 30 {
            if spec_has_checks(nk, nt, fc, ns, s) == 1 {
                let mut spec_name = node_text(nt, s)
                if spec_inputs_testable(nk, nt, fc, ns, s) == 0 {
                    write(concat(concat("    printf(\"", c_escape(spec_name)), ": пропусната (неподдържан тип за --test-specs)\\n\");\n"))
                } else {
                    emit_spec_test(nk, nt, fc, ns, prog, s)
                }
            }
        }
        s = next_sibling(ns, s)
    }
    write("    printf(\"Всички spec тестове минаха. ⚔️\\n\");\n")
    write("    return 0;\n}\n")
}

// ============================================================
//  Main
// ============================================================

fn main() {
    let mut test_specs: i64 = 0
    let mut file = arg(0)
    if str_eq(arg(0), "--test-specs") == 1 {
        test_specs = 1
        file = arg(1)
    }
    let mut src = read_file(file) catch !IO => ""

    let mut tk = vec_new()
    let mut tt = vec_new()
    tokenize(src, tk, tt)

    let mut nk = vec_new()
    let mut nt = vec_new()
    let mut fc = vec_new()
    let mut ns = vec_new()

    let mut prog = ast_kind(nk, nt, fc, ns, 13, "")
    let mut pos = vec_new()
    vec_push(pos, 0)

    let mut iterations: i64 = 0
    while vec_get(tk, vec_get(pos, 0)) != 999 {
        iterations = iterations + 1
        if iterations > 100000 { break }
        if vec_get(tk, vec_get(pos, 0)) == 1 {
            let mut f = parse_fn(tk, tt, pos, nk, nt, fc, ns)
            ast_child(fc, ns, prog, f)
        } else {
            if vec_get(tk, vec_get(pos, 0)) == 0 {
                if str_eq(vec_get_str(tt, vec_get(pos, 0)), "extern") == 1 {
                    // extern fn <име>(...) -> T !E — FFI декларация (kind 35)
                    vec_set(pos, 0, vec_get(pos, 0) + 1)
                    if vec_get(tk, vec_get(pos, 0)) == 1 {
                        let mut ef = parse_fn(tk, tt, pos, nk, nt, fc, ns)
                        vec_set(nk, ef, 35)
                        ast_child(fc, ns, prog, ef)
                    }
                } else {
                    if str_eq(vec_get_str(tt, vec_get(pos, 0)), "struct") == 1 {
                        let mut s = parse_struct(tk, tt, pos, nk, nt, fc, ns)
                        ast_child(fc, ns, prog, s)
                    } else {
                        if str_eq(vec_get_str(tt, vec_get(pos, 0)), "enum") == 1 {
                            let mut en = parse_enum(tk, tt, pos, nk, nt, fc, ns)
                            ast_child(fc, ns, prog, en)
                        } else {
                            if str_eq(vec_get_str(tt, vec_get(pos, 0)), "spec") == 1 {
                                let mut sp = parse_spec(tk, tt, pos, nk, nt, fc, ns)
                                ast_child(fc, ns, prog, sp)
                            } else {
                                vec_set(pos, 0, vec_get(pos, 0) + 1)
                            }
                        }
                    }
                }
            } else {
                vec_set(pos, 0, vec_get(pos, 0) + 1)
            }
        }
    }

    // checker: отхвърля невалидни програми (аргументи + vec смесване)
    check_program(nk, nt, fc, ns, prog)

    // emit C code
    write("/* Генериран от Бага self-hosted компилатор */\n")
    write("#include <stdio.h>\n")
    write("#include <stdlib.h>\n")
    write("#include <stdint.h>\n")
    write("#include <string.h>\n\n")
    // runtime helpers
    write("static int64_t baga_len(const char *s) { return (int64_t)strlen(s); }\n")
    write("static int64_t baga_char_at(const char *s, int64_t i) { return (int64_t)(unsigned char)s[i]; }\n")
    write("static int64_t baga_byte_at(const char *s, int64_t i) { return (int64_t)(unsigned char)s[i]; }\n")
    write("static const char *baga_byte_chr(int64_t c) { char *r = malloc(2); r[0] = (char)c; r[1] = 0; return r; }\n")
    write("static const char *baga_substr(const char *s, int64_t a, int64_t b) {\n")
    write("    int64_t n = b - a; if (n < 0) n = 0;\n")
    write("    char *r = malloc((size_t)n + 1); memcpy(r, s + a, (size_t)n); r[n] = 0; return r; }\n")
    write("static const char *baga_concat(const char *a, const char *b) {\n")
    write("    size_t la = strlen(a), lb = strlen(b);\n")
    write("    char *r = malloc(la + lb + 1); memcpy(r, a, la); memcpy(r + la, b, lb + 1); return r; }\n")
    write("static int64_t baga_str_eq(const char *a, const char *b) { return strcmp(a, b) == 0; }\n")
    write("static const char *baga_chr(int64_t c) {\n")
    write("    char *r = malloc(5);\n")
    write("    if (c < 0x80) { r[0] = (char)c; r[1] = 0; }\n")
    write("    else if (c < 0x800) { r[0] = (char)(0xC0|(c>>6)); r[1] = (char)(0x80|(c&0x3F)); r[2] = 0; }\n")
    write("    else if (c < 0x10000) { r[0] = (char)(0xE0|(c>>12)); r[1] = (char)(0x80|((c>>6)&0x3F)); r[2] = (char)(0x80|(c&0x3F)); r[3] = 0; }\n")
    write("    else { r[0] = (char)(0xF0|(c>>18)); r[1] = (char)(0x80|((c>>12)&0x3F)); r[2] = (char)(0x80|((c>>6)&0x3F)); r[3] = (char)(0x80|(c&0x3F)); r[4] = 0; }\n")
    write("    return r; }\n")
    write("static int64_t baga_ord(const char *s) {\n")
    write("    unsigned char c = (unsigned char)s[0]; if (!c) return 0;\n")
    write("    if (c < 0x80) return c;\n")
    write("    if ((c&0xE0)==0xC0) return ((int64_t)(c&0x1F)<<6)|((int64_t)(unsigned char)s[1]&0x3F);\n")
    write("    if ((c&0xF0)==0xE0) return ((int64_t)(c&0x0F)<<12)|(((int64_t)(unsigned char)s[1]&0x3F)<<6)|((int64_t)(unsigned char)s[2]&0x3F);\n")
    write("    return ((int64_t)(c&0x07)<<18)|(((int64_t)(unsigned char)s[1]&0x3F)<<12)|(((int64_t)(unsigned char)s[2]&0x3F)<<6)|((int64_t)(unsigned char)s[3]&0x3F); }\n")
    write("static const char *baga_i64_to_str(int64_t x) { char *r = malloc(24); snprintf(r, 24, \"%lld\", (long long)x); return r; }\n")
    write("typedef struct { unsigned char *data; int64_t len; } baga_bytes;\n")
    write("static int64_t baga_bytes_len(baga_bytes b) { return b.len; }\n")
    write("static int64_t baga_bytes_at(baga_bytes b, int64_t i) { return (int64_t)b.data[i]; }\n")
    write("static baga_bytes baga_bytes_slice(baga_bytes b, int64_t a, int64_t c) {\n")
    write("    if (a < 0) a = 0; if (c > b.len) c = b.len; if (c < a) c = a;\n")
    write("    baga_bytes r; r.len = c - a; r.data = malloc((size_t)(r.len ? r.len : 1));\n")
    write("    memcpy(r.data, b.data + a, (size_t)r.len); return r; }\n")
    write("static baga_bytes baga_bytes_concat(baga_bytes a, baga_bytes b) {\n")
    write("    baga_bytes r; r.len = a.len + b.len; r.data = malloc((size_t)(r.len ? r.len : 1));\n")
    write("    memcpy(r.data, a.data, (size_t)a.len); memcpy(r.data + a.len, b.data, (size_t)b.len); return r; }\n")
    write("static baga_bytes baga_bytes_from_str(const char *s) {\n")
    write("    int64_t n = (int64_t)strlen(s); baga_bytes r; r.len = n; r.data = malloc((size_t)(n ? n : 1));\n")
    write("    memcpy(r.data, s, (size_t)n); return r; }\n")
    write("static const char *baga_bytes_to_str(baga_bytes b) {\n")
    write("    char *r = malloc((size_t)b.len + 1); memcpy(r, b.data, (size_t)b.len); r[b.len] = 0; return r; }\n")
    write("static int baga_hex_val(int c) {\n")
    write("    if (c >= '0' && c <= '9') return c - '0';\n")
    write("    if (c >= 'a' && c <= 'f') return c - 'a' + 10;\n")
    write("    if (c >= 'A' && c <= 'F') return c - 'A' + 10;\n")
    write("    return -1; }\n")
    write("static const char *baga_hex_encode(baga_bytes b) {\n")
    write("    static const char *hx = \"0123456789abcdef\";\n")
    write("    char *r = malloc((size_t)b.len * 2 + 1);\n")
    write("    for (int64_t i = 0; i < b.len; i++) { r[i*2] = hx[b.data[i] >> 4]; r[i*2+1] = hx[b.data[i] & 15]; }\n")
    write("    r[b.len * 2] = 0; return r; }\n")
    write("static baga_bytes baga_hex_decode(const char *s) {\n")
    write("    int64_t n = (int64_t)strlen(s); unsigned char *buf = malloc((size_t)(n / 2 + 1)); int64_t len = 0;\n")
    write("    for (int64_t i = 0; i + 1 < n; ) {\n")
    write("        int hi = baga_hex_val(s[i]); int lo = baga_hex_val(s[i+1]);\n")
    write("        if (hi < 0 || lo < 0) { i++; continue; }\n")
    write("        buf[len++] = (unsigned char)(hi * 16 + lo); i += 2; }\n")
    write("    baga_bytes r; r.data = buf; r.len = len; return r; }\n")
    write("static baga_bytes baga_bytes_from_hex(const char *s) { return baga_hex_decode(s); }\n")
    write("static const char *baga_read_file(const char *path) {\n")
    write("    FILE *f = fopen(path, \"rb\"); if (!f) return \"\";\n")
    write("    fseek(f, 0, SEEK_END); long sz = ftell(f); fseek(f, 0, SEEK_SET);\n")
    write("    char *buf = malloc((size_t)sz + 1); fread(buf, 1, (size_t)sz, f); buf[sz] = 0; fclose(f); return buf; }\n")
    write("static void baga_write(const char *s) { printf(\"%s\", s); }\n")
    write("typedef struct { void **data; int64_t len; int64_t cap; } baga_Vec;\n")
    write("static baga_Vec *baga_vec_new(void) {\n")
    write("    baga_Vec *v = malloc(sizeof(baga_Vec));\n")
    write("    v->cap = 8; v->len = 0; v->data = malloc(8 * sizeof(void *)); return v; }\n")
    write("static void baga_vec_grow(baga_Vec *v) {\n")
    write("    if (v->len == v->cap) { v->cap *= 2; v->data = realloc(v->data, (size_t)v->cap * sizeof(void *)); } }\n")
    write("static void baga_vec_push_i64(baga_Vec *v, int64_t x) { baga_vec_grow(v); v->data[v->len++] = (void *)(intptr_t)x; }\n")
    write("static int64_t baga_vec_get_i64(baga_Vec *v, int64_t i) { return (int64_t)(intptr_t)v->data[i]; }\n")
    write("static void baga_vec_set_i64(baga_Vec *v, int64_t i, int64_t x) { v->data[i] = (void *)(intptr_t)x; }\n")
    write("static void baga_vec_push_str(baga_Vec *v, const char *s) { baga_vec_grow(v); v->data[v->len++] = (void *)s; }\n")
    write("static const char *baga_vec_get_str(baga_Vec *v, int64_t i) { return (const char *)v->data[i]; }\n")
    write("static void baga_vec_set_str(baga_Vec *v, int64_t i, const char *s) { v->data[i] = (void *)s; }\n")
    write("static void baga_vec_push_f64(baga_Vec *v, double x) { union { double d; void *p; } u; u.d = x; baga_vec_grow(v); v->data[v->len++] = u.p; }\n")
    write("static double baga_vec_get_f64(baga_Vec *v, int64_t i) { union { double d; void *p; } u; u.p = v->data[i]; return u.d; }\n")
    write("static void baga_vec_set_f64(baga_Vec *v, int64_t i, double x) { union { double d; void *p; } u; u.d = x; v->data[i] = u.p; }\n")
    write("static int64_t baga_vec_len(baga_Vec *v) { return v->len; }\n")
    write("static baga_Vec *baga_vec_slice_i64(baga_Vec *v, int64_t a, int64_t b) {\n")
    write("    if (a < 0) a = 0; if (b > v->len) b = v->len; if (b < a) b = a;\n")
    write("    baga_Vec *r = baga_vec_new();\n")
    write("    for (int64_t i = a; i < b; i++) baga_vec_push_i64(r, (int64_t)(intptr_t)v->data[i]);\n")
    write("    return r; }\n")
    write("static baga_Vec *baga_vec_slice_str(baga_Vec *v, int64_t a, int64_t b) {\n")
    write("    if (a < 0) a = 0; if (b > v->len) b = v->len; if (b < a) b = a;\n")
    write("    baga_Vec *r = baga_vec_new();\n")
    write("    for (int64_t i = a; i < b; i++) baga_vec_push_str(r, (const char *)v->data[i]);\n")
    write("    return r; }\n")
    write("static baga_Vec *baga_vec_slice_f64(baga_Vec *v, int64_t a, int64_t b) {\n")
    write("    if (a < 0) a = 0; if (b > v->len) b = v->len; if (b < a) b = a;\n")
    write("    baga_Vec *r = baga_vec_new();\n")
    write("    for (int64_t i = a; i < b; i++) { union { double d; void *p; } u; u.p = v->data[i]; baga_vec_push_f64(r, u.d); }\n")
    write("    return r; }\n")
    write("static baga_Vec *baga_vec_concat_i64(baga_Vec *v, baga_Vec *w) {\n")
    write("    baga_Vec *r = baga_vec_new();\n")
    write("    for (int64_t i = 0; i < v->len; i++) baga_vec_push_i64(r, (int64_t)(intptr_t)v->data[i]);\n")
    write("    for (int64_t i = 0; i < w->len; i++) baga_vec_push_i64(r, (int64_t)(intptr_t)w->data[i]);\n")
    write("    return r; }\n")
    write("static baga_Vec *baga_vec_concat_str(baga_Vec *v, baga_Vec *w) {\n")
    write("    baga_Vec *r = baga_vec_new();\n")
    write("    for (int64_t i = 0; i < v->len; i++) baga_vec_push_str(r, (const char *)v->data[i]);\n")
    write("    for (int64_t i = 0; i < w->len; i++) baga_vec_push_str(r, (const char *)w->data[i]);\n")
    write("    return r; }\n")
    write("static baga_Vec *baga_vec_concat_f64(baga_Vec *v, baga_Vec *w) {\n")
    write("    baga_Vec *r = baga_vec_new();\n")
    write("    for (int64_t i = 0; i < v->len; i++) { union { double d; void *p; } u; u.p = v->data[i]; baga_vec_push_f64(r, u.d); }\n")
    write("    for (int64_t i = 0; i < w->len; i++) { union { double d; void *p; } u; u.p = w->data[i]; baga_vec_push_f64(r, u.d); }\n")
    write("    return r; }\n")
    write("static int baga_argc = 0;\n")
    write("static char **baga_argv = 0;\n")
    write("static int64_t baga_arg_count(void) { return baga_argc > 0 ? baga_argc - 1 : 0; }\n")
    write("static const char *baga_arg(int64_t i) { return (i + 1 < baga_argc) ? baga_argv[i + 1] : \"\"; }\n")
    write("static void baga_exit(int64_t c) { exit((int)c); }\n")
    write("static void baga_eprintln(const char *s) { fprintf(stderr, \"%s\\n\", s); }\n")
    write("static int64_t baga_cur_args[16];\n")
    write("static int baga_cur_nargs = 0;\n")
    write("static uint64_t baga_seed = 0x243F6A8885A308D3ULL;\n")
    write("static int64_t baga_rand_i64(int64_t lo, int64_t hi) {\n")
    write("    baga_seed ^= baga_seed << 13; baga_seed ^= baga_seed >> 7; baga_seed ^= baga_seed << 17;\n")
    write("    return lo + (int64_t)(baga_seed % (uint64_t)(hi - lo + 1));\n")
    write("}\n")
    write("static void baga_spec_fail(const char *spec, const char *kind, int64_t idx, const char *expr) {\n")
    write("    if (strcmp(kind, \"requires\") == 0)\n")
    write("        fprintf(stderr, \"spec '%s': requires #%lld нарушено: %s\\n\", spec, (long long)idx, expr);\n")
    write("    else\n")
    write("        fprintf(stderr, \"spec '%s': ensures #%lld нарушена: %s\\n\", spec, (long long)idx, expr);\n")
    write("    if (baga_cur_nargs > 0) {\n")
    write("        fprintf(stderr, \"  вход: \");\n")
    write("        for (int i = 0; i < baga_cur_nargs; i++)\n")
    write("            fprintf(stderr, \"%s%lld\", i ? \", \" : \"\", (long long)baga_cur_args[i]);\n")
    write("        fprintf(stderr, \"\\n\");\n")
    write("    }\n")
    write("    exit(1);\n")
    write("}\n")
    write("/* arena allocator: bump allocation, free-all-at-once */\n")
    write("typedef struct { char *base; int64_t used; int64_t cap; } baga_Arena;\n")
    write("static int64_t baga_arena_new(void) {\n")
    write("    baga_Arena *a = malloc(sizeof(baga_Arena));\n")
    write("    a->cap = 65536; a->used = 0; a->base = malloc((size_t)a->cap);\n")
    write("    return (int64_t)(intptr_t)a;\n")
    write("}\n")
    write("static int64_t baga_arena_alloc(int64_t h, int64_t size) {\n")
    write("    baga_Arena *a = (baga_Arena *)(intptr_t)h;\n")
    write("    if (a->used + size > a->cap) {\n")
    write("        int64_t nc = (a->used + size) * 2;\n")
    write("        a->base = realloc(a->base, (size_t)nc); a->cap = nc;\n")
    write("    }\n")
    write("    char *p = a->base + a->used; a->used += size;\n")
    write("    return (int64_t)(intptr_t)p;\n")
    write("}\n")
    write("static void baga_arena_reset(int64_t h) {\n")
    write("    baga_Arena *a = (baga_Arena *)(intptr_t)h; a->used = 0;\n")
    write("}\n")
    write("static void baga_arena_free(int64_t h) {\n")
    write("    baga_Arena *a = (baga_Arena *)(intptr_t)h;\n")
    write("    free(a->base); free(a);\n")
    write("}\n\n")

    // enum declarations
    let mut en = first_child(fc, prog)
    while en >= 0 {
        if node_kind(nk, en) == 28 {
            write("typedef enum {\n")
            let mut v = first_child(fc, en)
            let mut vi: i64 = 0
            while v >= 0 {
                write(concat(concat(concat(concat("    ", mangle(node_text(nt, en))), "_"), concat(mangle(node_text(nt, v)), " = ")), concat(int_to_str(vi), ",\n")))
                vi = vi + 1
                v = next_sibling(ns, v)
            }
            write(concat(concat("} ", mangle(node_text(nt, en))), ";\n\n"))
        }
        en = next_sibling(ns, en)
    }

    // struct declarations
    let mut st = first_child(fc, prog)
    while st >= 0 {
        if node_kind(nk, st) == 21 {
            write("typedef struct {\n")
            let mut fld = first_child(fc, st)
            while fld >= 0 {
                let mut ftext = node_text(nt, fld)
                let mut ci: i64 = 0
                let mut fnl = len(ftext)
                while ci < fnl {
                    if char_at(ftext, ci) == 58 { break }
                    ci = ci + 1
                }
                let mut fname = substr(ftext, 0, ci)
                let mut ftype = "i64"
                if ci + 1 < fnl { ftype = substr(ftext, ci + 1, fnl) }
                write(concat(concat(concat("    ", c_type(ftype)), concat(" ", mangle(fname))), ";\n"))
                fld = next_sibling(ns, fld)
            }
            write(concat(concat("} ", mangle(node_text(nt, st))), ";\n\n"))
        }
        st = next_sibling(ns, st)
    }

    // forward declarations
    let mut f = first_child(fc, prog)
    while f >= 0 {
        if node_kind(nk, f) == 11 {
            emit_fn(nk, nt, fc, ns, prog, f)
        }
        if node_kind(nk, f) == 35 {
            emit_extern_fn(nk, nt, fc, ns, prog, f)
        }
        f = next_sibling(ns, f)
    }
    write("\n")

    // function definitions (skip forward declarations)
    let mut f2 = first_child(fc, prog)
    while f2 >= 0 {
        if node_kind(nk, f2) == 11 {
            // check if has body (BLOCK child)
            let mut c2 = first_child(fc, f2)
            let mut has_body: i64 = 0
            while c2 >= 0 {
                if node_kind(nk, c2) == 5 { has_body = 1 }
                c2 = next_sibling(ns, c2)
            }
            if has_body == 1 {
                emit_fn_def(nk, nt, fc, ns, prog, f2)
            }
        }
        f2 = next_sibling(ns, f2)
    }

    // C main (или test driver при --test-specs)
    if test_specs == 1 {
        emit_test_driver(nk, nt, fc, ns, prog)
    } else {
        write("int main(int argc, char **argv) {\n")
        write("    baga_argc = argc; baga_argv = argv;\n")
        write("    b_main();\n")
        write("    return 0;\n")
        write("}\n")
    }
}
