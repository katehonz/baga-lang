// c2_par.baga — LP8 вълна E: !Par конкурентност (go/join/chan/select/pool)
//
// Пренос на par runtime-а на C bootstrap-а (src/codegen_c.c, секцията
// "concurrency (!Par): OS threads + i64 channels (CSP)") като емитван C:
// pthread нишки с join handle-и (magic + detached състояние), блокиращи
// i64 канали с mutex+cond, non-blocking/timed select над два канала,
// bounded worker pool (pool_map). Емитва се безусловно в preamble-а,
// както при bootstrap-а — -pthread вече е в link флаговете.
//
// Извън покритието (остават language-ниво отказ): C1 сигналите
// (signal_watch/check/clear/wait/raise) — не се ползват от par*
// примерите и runtime-ът им е отделна машинерия (sigaction).

// par builtin → C runtime име ("" = не е par builtin)
fn par_builtin_cname(bn: str) -> str {
    if str_eq(bn, "join") == 1 { return "baga_join" }
    if str_eq(bn, "detach") == 1 { return "baga_detach" }
    if str_eq(bn, "chan_new") == 1 { return "baga_chan_new" }
    if str_eq(bn, "chan_send") == 1 { return "baga_chan_send" }
    if str_eq(bn, "chan_recv") == 1 { return "baga_chan_recv" }
    if str_eq(bn, "chan_recv2") == 1 { return "baga_chan_recv2" }
    if str_eq(bn, "chan_try_recv") == 1 { return "baga_chan_try_recv" }
    if str_eq(bn, "chan_recv_timeout") == 1 { return "baga_chan_recv_timeout" }
    if str_eq(bn, "chan_select2") == 1 { return "baga_chan_select2" }
    if str_eq(bn, "chan_select2_wait") == 1 { return "baga_chan_select2_wait" }
    if str_eq(bn, "chan_select2_timeout") == 1 { return "baga_chan_select2_timeout" }
    if str_eq(bn, "chan_close") == 1 { return "baga_chan_close" }
    if str_eq(bn, "chan_len") == 1 { return "baga_chan_len" }
    if str_eq(bn, "mutex_new") == 1 { return "baga_mutex_new" }
    if str_eq(bn, "mutex_lock") == 1 { return "baga_mutex_lock" }
    if str_eq(bn, "mutex_unlock") == 1 { return "baga_mutex_unlock" }
    if str_eq(bn, "sleep_ms") == 1 { return "baga_sleep_ms" }
    return ""
}

// go/go_bg/pool_map: първият аргумент е fn идентификатор, кастнат към
// baga_par_fn (като bootstrap-а; НЕ през __clo handle). "" = не е такова повикване.
fn emit_par_call(nk: Vec, nt: Vec, fc: Vec, ns: Vec, prog: i64, callee: i64, bn: str) -> str {
    if str_eq(bn, "go") == 1 || str_eq(bn, "go_bg") == 1 {
        let mut ga1 = next_sibling(ns, callee)
        let mut ga2: i64 = 0 - 1
        if ga1 >= 0 { ga2 = next_sibling(ns, ga1) }
        if ga1 >= 0 && ga2 >= 0 {
            if node_kind(nk, ga1) == 2 {
                let mut gfn = "baga_go"
                if str_eq(bn, "go_bg") == 1 { gfn = "baga_go_bg" }
                return concat(concat(concat(concat(gfn, "((baga_par_fn)"), mangle(node_text(nt, ga1))), ", "), concat(emit_expr(nk, nt, fc, ns, prog, ga2), ")"))
            }
        }
        return ""
    }
    if str_eq(bn, "pool_map") == 1 {
        let mut pa1 = next_sibling(ns, callee)
        let mut pa2: i64 = 0 - 1
        let mut pa3: i64 = 0 - 1
        if pa1 >= 0 { pa2 = next_sibling(ns, pa1) }
        if pa2 >= 0 { pa3 = next_sibling(ns, pa2) }
        if pa1 >= 0 && pa3 >= 0 {
            if node_kind(nk, pa1) == 2 {
                return concat(concat(concat(concat(concat("baga_pool_map((baga_par_fn)", mangle(node_text(nt, pa1))), ", "), concat(emit_expr(nk, nt, fc, ns, prog, pa2), ", ")), emit_expr(nk, nt, fc, ns, prog, pa3)), ")")
            }
        }
        return ""
    }
    return ""
}

fn emit_par_runtime() {    write("/* ---- concurrency (!Par): OS threads + i64 channels (CSP) — като C bootstrap-а ---- */\n")
    write("typedef int64_t (*baga_par_fn)(int64_t);\n")
    write("typedef struct {\n")
    write("    uint32_t magic;\n")
    write("    baga_par_fn fn; int64_t arg; int64_t result; pthread_t th;\n")
    write("    int joined; int detached;\n")
    write("} baga_JoinHandle;\n")
    write("#define BAGA_HANDLE_MAGIC 0xBA6A0001u\n")
    write("static void *baga_par_trampoline(void *p) {\n")
    write("    baga_JoinHandle *h = (baga_JoinHandle *)p;\n")
    write("    h->result = h->fn(h->arg);\n")
    write("    /* 0=joinable, 1=detach requested, 2=finished (joinable) */\n")
    write("    int old = __sync_lock_test_and_set(&h->detached, 2);\n")
    write("    if (old == 1) free(h);\n")
    write("    return NULL;\n")
    write("}\n")
    write("static int64_t baga_go(baga_par_fn fn, int64_t arg) {\n")
    write("    baga_JoinHandle *h = (baga_JoinHandle *)calloc(1, sizeof(baga_JoinHandle));\n")
    write("    if (!h) { fprintf(stderr, \"baga: go: out of memory\\n\"); exit(1); }\n")
    write("    h->fn = fn; h->arg = arg; h->joined = 0; h->detached = 0;\n")
    write("    h->magic = BAGA_HANDLE_MAGIC;\n")
    write("    if (pthread_create(&h->th, NULL, baga_par_trampoline, h) != 0) {\n")
    write("        fprintf(stderr, \"baga: go: pthread_create failed\\n\"); exit(1);\n")
    write("    }\n")
    write("    return (int64_t)(intptr_t)h;\n")
    write("}\n")
    write("static int64_t baga_go_bg(baga_par_fn fn, int64_t arg) {\n")
    write("    baga_JoinHandle *h = (baga_JoinHandle *)calloc(1, sizeof(baga_JoinHandle));\n")
    write("    if (!h) { fprintf(stderr, \"baga: go_bg: out of memory\\n\"); exit(1); }\n")
    write("    h->fn = fn; h->arg = arg; h->joined = 0; h->detached = 1;\n")
    write("    h->magic = BAGA_HANDLE_MAGIC;\n")
    write("    pthread_attr_t attr; pthread_attr_init(&attr);\n")
    write("    pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);\n")
    write("    if (pthread_create(&h->th, &attr, baga_par_trampoline, h) != 0) {\n")
    write("        fprintf(stderr, \"baga: go_bg: pthread_create failed\\n\"); exit(1);\n")
    write("    }\n")
    write("    pthread_attr_destroy(&attr);\n")
    write("    return 0;\n")
    write("}\n")
    write("static int64_t baga_join(int64_t handle) {\n")
    write("    baga_JoinHandle *h = (baga_JoinHandle *)(intptr_t)handle;\n")
    write("    if (!h) return 0;\n")
    write("    if ((uintptr_t)h < 4096) {\n")
    write("        fprintf(stderr, \"baga: join: невалиден handle\\n\"); exit(1);\n")
    write("    }\n")
    write("    if (h->magic != BAGA_HANDLE_MAGIC) {\n")
    write("        fprintf(stderr, \"baga: join: невалиден handle\\n\"); exit(1);\n")
    write("    }\n")
    write("    if (h->detached == 1) {\n")
    write("        fprintf(stderr, \"baga: join: handle detached\\n\"); exit(1);\n")
    write("    }\n")
    write("    if (!h->joined) { pthread_join(h->th, NULL); h->joined = 1; }\n")
    write("    int64_t r = h->result; free(h); return r;\n")
    write("}\n")
    write("static int64_t baga_detach(int64_t handle) {\n")
    write("    baga_JoinHandle *h = (baga_JoinHandle *)(intptr_t)handle;\n")
    write("    if (!h || h->magic != BAGA_HANDLE_MAGIC || h->joined) return -1;\n")
    write("    int old = __sync_lock_test_and_set(&h->detached, 1);\n")
    write("    if (old == 2) { free(h); return 0; }\n")
    write("    if (old == 1) return 0;\n")
    write("    pthread_detach(h->th);\n")
    write("    return 0;\n")
    write("}\n")
    write("typedef struct {\n")
    write("    int64_t *buf; int64_t cap, len, head; int closed;\n")
    write("    pthread_mutex_t mu; pthread_cond_t not_empty, not_full;\n")
    write("} baga_Chan;\n")
    write("static int64_t baga_chan_new(int64_t cap) {\n")
    write("    if (cap < 1) cap = 1;\n")
    write("    baga_Chan *c = (baga_Chan *)calloc(1, sizeof(baga_Chan));\n")
    write("    if (!c) { fprintf(stderr, \"baga: chan_new: oom\\n\"); exit(1); }\n")
    write("    c->cap = cap; c->buf = (int64_t *)malloc((size_t)cap * sizeof(int64_t));\n")
    write("    if (!c->buf) { fprintf(stderr, \"baga: chan_new: oom\\n\"); exit(1); }\n")
    write("    pthread_mutex_init(&c->mu, NULL);\n")
    write("    pthread_cond_init(&c->not_empty, NULL);\n")
    write("    pthread_cond_init(&c->not_full, NULL);\n")
    write("    return (int64_t)(intptr_t)c;\n")
    write("}\n")
    write("static int64_t baga_chan_send(int64_t ch, int64_t v) {\n")
    write("    baga_Chan *c = (baga_Chan *)(intptr_t)ch;\n")
    write("    if (!c) return -1;\n")
    write("    pthread_mutex_lock(&c->mu);\n")
    write("    while (c->len == c->cap && !c->closed) pthread_cond_wait(&c->not_full, &c->mu);\n")
    write("    if (c->closed) { pthread_mutex_unlock(&c->mu); return -1; }\n")
    write("    int64_t i = (c->head + c->len) % c->cap;\n")
    write("    c->buf[i] = v; c->len++;\n")
    write("    pthread_cond_signal(&c->not_empty);\n")
    write("    pthread_mutex_unlock(&c->mu);\n")
    write("    return 0;\n")
    write("}\n")
    write("static int64_t baga_chan_recv(int64_t ch) {\n")
    write("    baga_Chan *c = (baga_Chan *)(intptr_t)ch;\n")
    write("    if (!c) return 0;\n")
    write("    pthread_mutex_lock(&c->mu);\n")
    write("    while (c->len == 0 && !c->closed) pthread_cond_wait(&c->not_empty, &c->mu);\n")
    write("    if (c->len == 0) { pthread_mutex_unlock(&c->mu); return 0; }\n")
    write("    int64_t v = c->buf[c->head];\n")
    write("    c->head = (c->head + 1) % c->cap; c->len--;\n")
    write("    pthread_cond_signal(&c->not_full);\n")
    write("    pthread_mutex_unlock(&c->mu);\n")
    write("    return v;\n")
    write("}\n")
    write("static int64_t baga_chan_recv2(int64_t ch) {\n")
    write("    baga_Chan *c = (baga_Chan *)(intptr_t)ch;\n")
    write("    if (!c) return baga_cell2(0, 0);\n")
    write("    pthread_mutex_lock(&c->mu);\n")
    write("    while (c->len == 0 && !c->closed) pthread_cond_wait(&c->not_empty, &c->mu);\n")
    write("    if (c->len == 0) { pthread_mutex_unlock(&c->mu); return baga_cell2(0, 0); }\n")
    write("    int64_t v = c->buf[c->head];\n")
    write("    c->head = (c->head + 1) % c->cap; c->len--;\n")
    write("    pthread_cond_signal(&c->not_full);\n")
    write("    pthread_mutex_unlock(&c->mu);\n")
    write("    return baga_cell2(1, v);\n")
    write("}\n")
    write("static int64_t baga_chan_try_recv(int64_t ch) {\n")
    write("    baga_Chan *c = (baga_Chan *)(intptr_t)ch;\n")
    write("    if (!c) return baga_cell2(2, 0);\n")
    write("    pthread_mutex_lock(&c->mu);\n")
    write("    if (c->len == 0) {\n")
    write("        int st = c->closed ? 2 : 0;\n")
    write("        pthread_mutex_unlock(&c->mu);\n")
    write("        return baga_cell2(st, 0);\n")
    write("    }\n")
    write("    int64_t v = c->buf[c->head];\n")
    write("    c->head = (c->head + 1) % c->cap; c->len--;\n")
    write("    pthread_cond_signal(&c->not_full);\n")
    write("    pthread_mutex_unlock(&c->mu);\n")
    write("    return baga_cell2(1, v);\n")
    write("}\n")
    write("static int64_t baga_chan_recv_timeout(int64_t ch, int64_t ms) {\n")
    write("    baga_Chan *c = (baga_Chan *)(intptr_t)ch;\n")
    write("    if (!c) return baga_cell2(2, 0);\n")
    write("    if (ms < 0) ms = 0;\n")
    write("    struct timespec abs; clock_gettime(CLOCK_REALTIME, &abs);\n")
    write("    abs.tv_sec += ms / 1000;\n")
    write("    abs.tv_nsec += (ms % 1000) * 1000000L;\n")
    write("    if (abs.tv_nsec >= 1000000000L) { abs.tv_sec++; abs.tv_nsec -= 1000000000L; }\n")
    write("    pthread_mutex_lock(&c->mu);\n")
    write("    while (c->len == 0 && !c->closed) {\n")
    write("        int rc = pthread_cond_timedwait(&c->not_empty, &c->mu, &abs);\n")
    write("        if (rc == ETIMEDOUT) { pthread_mutex_unlock(&c->mu); return baga_cell2(0, 0); }\n")
    write("    }\n")
    write("    if (c->len == 0) { pthread_mutex_unlock(&c->mu); return baga_cell2(2, 0); }\n")
    write("    int64_t v = c->buf[c->head];\n")
    write("    c->head = (c->head + 1) % c->cap; c->len--;\n")
    write("    pthread_cond_signal(&c->not_full);\n")
    write("    pthread_mutex_unlock(&c->mu);\n")
    write("    return baga_cell2(1, v);\n")
    write("}\n")
    write("static int64_t baga_sleep_ms(int64_t ms) {\n")
    write("    if (ms <= 0) return 0;\n")
    write("    struct timespec ts; ts.tv_sec = ms / 1000; ts.tv_nsec = (ms % 1000) * 1000000L;\n")
    write("    while (nanosleep(&ts, &ts) == -1 && errno == EINTR) {}\n")
    write("    return 0;\n")
    write("}\n")
    write("static int64_t baga_chan_select2(int64_t c0, int64_t c1) {\n")
    write("    baga_Chan *a = (baga_Chan *)(intptr_t)c0;\n")
    write("    baga_Chan *b = (baga_Chan *)(intptr_t)c1;\n")
    write("    if (!a && !b) return baga_cell2(3, 0);\n")
    write("    int64_t la = 0, lb = 0; int ca = 1, cb = 1;\n")
    write("    if (a) { pthread_mutex_lock(&a->mu); la = a->len; ca = a->closed; pthread_mutex_unlock(&a->mu); }\n")
    write("    if (b) { pthread_mutex_lock(&b->mu); lb = b->len; cb = b->closed; pthread_mutex_unlock(&b->mu); }\n")
    write("    if (la == 0 && lb == 0) {\n")
    write("        if ((!a || ca) && (!b || cb)) return baga_cell2(3, 0);\n")
    write("        return baga_cell2(2, 0);\n")
    write("    }\n")
    write("    int prefer0 = (la >= lb);\n")
    write("    if (prefer0 && la > 0) {\n")
    write("        int64_t pr = baga_chan_try_recv(c0);\n")
    write("        if (baga_cell2_0(pr) == 1) return baga_cell2(0, baga_cell2_1(pr));\n")
    write("    }\n")
    write("    if (lb > 0) {\n")
    write("        int64_t pr = baga_chan_try_recv(c1);\n")
    write("        if (baga_cell2_0(pr) == 1) return baga_cell2(1, baga_cell2_1(pr));\n")
    write("    }\n")
    write("    if (la > 0) {\n")
    write("        int64_t pr = baga_chan_try_recv(c0);\n")
    write("        if (baga_cell2_0(pr) == 1) return baga_cell2(0, baga_cell2_1(pr));\n")
    write("    }\n")
    write("    return baga_cell2(2, 0);\n")
    write("}\n")
    write("static int64_t baga_chan_select2_wait(int64_t c0, int64_t c1) {\n")
    write("    int flip = 0;\n")
    write("    for (;;) {\n")
    write("        int64_t r = baga_chan_select2(c0, c1);\n")
    write("        int64_t w = baga_cell2_0(r);\n")
    write("        if (w != 2) return r;\n")
    write("        baga_Chan *a = (baga_Chan *)(intptr_t)c0;\n")
    write("        baga_Chan *b = (baga_Chan *)(intptr_t)c1;\n")
    write("        baga_Chan *wa = NULL, *wb = NULL;\n")
    write("        if (a && b) {\n")
    write("            if ((uintptr_t)a < (uintptr_t)b) { wa = a; wb = b; }\n")
    write("            else { wa = b; wb = a; }\n")
    write("        } else { wa = a ? a : b; }\n")
    write("        baga_Chan *wait = (flip && wb) ? wb : wa;\n")
    write("        flip = !flip;\n")
    write("        if (!wait) return baga_cell2(3, 0);\n")
    write("        struct timespec abs; clock_gettime(CLOCK_REALTIME, &abs);\n")
    write("        abs.tv_nsec += 5000000L;\n")
    write("        if (abs.tv_nsec >= 1000000000L) { abs.tv_sec++; abs.tv_nsec -= 1000000000L; }\n")
    write("        pthread_mutex_lock(&wait->mu);\n")
    write("        if (wait->len == 0 && !wait->closed)\n")
    write("            pthread_cond_timedwait(&wait->not_empty, &wait->mu, &abs);\n")
    write("        pthread_mutex_unlock(&wait->mu);\n")
    write("    }\n")
    write("}\n")
    write("static int64_t baga_chan_select2_timeout(int64_t c0, int64_t c1, int64_t ms) {\n")
    write("    if (ms < 0) ms = 0;\n")
    write("    struct timespec deadline; clock_gettime(CLOCK_REALTIME, &deadline);\n")
    write("    deadline.tv_sec += ms / 1000;\n")
    write("    deadline.tv_nsec += (ms % 1000) * 1000000L;\n")
    write("    if (deadline.tv_nsec >= 1000000000L) { deadline.tv_sec++; deadline.tv_nsec -= 1000000000L; }\n")
    write("    int flip = 0;\n")
    write("    for (;;) {\n")
    write("        int64_t r = baga_chan_select2(c0, c1);\n")
    write("        int64_t w = baga_cell2_0(r);\n")
    write("        if (w != 2) return r;\n")
    write("        struct timespec now; clock_gettime(CLOCK_REALTIME, &now);\n")
    write("        if (now.tv_sec > deadline.tv_sec ||\n")
    write("            (now.tv_sec == deadline.tv_sec && now.tv_nsec >= deadline.tv_nsec))\n")
    write("            return baga_cell2(2, 0);\n")
    write("        baga_Chan *a = (baga_Chan *)(intptr_t)c0;\n")
    write("        baga_Chan *b = (baga_Chan *)(intptr_t)c1;\n")
    write("        baga_Chan *wa = NULL, *wb = NULL;\n")
    write("        if (a && b) {\n")
    write("            if ((uintptr_t)a < (uintptr_t)b) { wa = a; wb = b; }\n")
    write("            else { wa = b; wb = a; }\n")
    write("        } else { wa = a ? a : b; }\n")
    write("        baga_Chan *wait = (flip && wb) ? wb : wa;\n")
    write("        flip = !flip;\n")
    write("        if (!wait) return baga_cell2(3, 0);\n")
    write("        pthread_mutex_lock(&wait->mu);\n")
    write("        if (wait->len == 0 && !wait->closed)\n")
    write("            pthread_cond_timedwait(&wait->not_empty, &wait->mu, &deadline);\n")
    write("        pthread_mutex_unlock(&wait->mu);\n")
    write("    }\n")
    write("}\n")
    write("static int64_t baga_chan_close(int64_t ch) {\n")
    write("    baga_Chan *c = (baga_Chan *)(intptr_t)ch;\n")
    write("    if (!c) return -1;\n")
    write("    pthread_mutex_lock(&c->mu);\n")
    write("    c->closed = 1;\n")
    write("    pthread_cond_broadcast(&c->not_empty);\n")
    write("    pthread_cond_broadcast(&c->not_full);\n")
    write("    pthread_mutex_unlock(&c->mu);\n")
    write("    return 0;\n")
    write("}\n")
    write("static int64_t baga_chan_len(int64_t ch) {\n")
    write("    baga_Chan *c = (baga_Chan *)(intptr_t)ch;\n")
    write("    if (!c) return 0;\n")
    write("    pthread_mutex_lock(&c->mu);\n")
    write("    int64_t n = c->len;\n")
    write("    pthread_mutex_unlock(&c->mu);\n")
    write("    return n;\n")
    write("}\n")
    write("typedef struct { pthread_mutex_t mu; pthread_t owner; int locked; } baga_Mutex;\n")
    write("static int64_t baga_mutex_new(void) {\n")
    write("    baga_Mutex *m = (baga_Mutex *)calloc(1, sizeof(baga_Mutex));\n")
    write("    if (!m) { fprintf(stderr, \"baga: mutex_new: oom\\n\"); exit(1); }\n")
    write("    pthread_mutex_init(&m->mu, NULL);\n")
    write("    return (int64_t)(intptr_t)m;\n")
    write("}\n")
    write("static int64_t baga_mutex_lock(int64_t h) {\n")
    write("    baga_Mutex *m = (baga_Mutex *)(intptr_t)h;\n")
    write("    if (!m) return -1;\n")
    write("    if (m->locked && pthread_equal(m->owner, pthread_self())) {\n")
    write("        fprintf(stderr, \"baga: mutex_lock: double-lock от същата нишка\\n\"); exit(1);\n")
    write("    }\n")
    write("    int rc = pthread_mutex_lock(&m->mu);\n")
    write("    m->owner = pthread_self(); m->locked = 1;\n")
    write("    return (int64_t)rc;\n")
    write("}\n")
    write("static int64_t baga_mutex_unlock(int64_t h) {\n")
    write("    baga_Mutex *m = (baga_Mutex *)(intptr_t)h;\n")
    write("    if (!m) return -1;\n")
    write("    m->locked = 0;\n")
    write("    return (int64_t)pthread_mutex_unlock(&m->mu);\n")
    write("}\n")
    write("typedef struct {\n")
    write("    baga_par_fn fn; baga_Vec *in; int64_t jobs; int64_t results;\n")
    write("} baga_PoolCtx;\n")
    write("static int64_t baga_pool_worker(int64_t ctx_h) {\n")
    write("    baga_PoolCtx *ctx = (baga_PoolCtx *)(intptr_t)ctx_h;\n")
    write("    for (;;) {\n")
    write("        int64_t pr = baga_chan_recv2(ctx->jobs);\n")
    write("        if (baga_cell2_0(pr) == 0) break;\n")
    write("        int64_t idx = baga_cell2_1(pr);\n")
    write("        int64_t arg = baga_vec_get_i64(ctx->in, idx);\n")
    write("        int64_t r = ctx->fn(arg);\n")
    write("        baga_chan_send(ctx->results, baga_cell2(idx, r));\n")
    write("    }\n")
    write("    return 0;\n")
    write("}\n")
    write("static baga_Vec *baga_pool_map(baga_par_fn fn, baga_Vec *in, int64_t nw) {\n")
    write("    int64_t n = baga_vec_len(in);\n")
    write("    baga_Vec *out = baga_vec_new();\n")
    write("    if (n <= 0) return out;\n")
    write("    for (int64_t i = 0; i < n; i++) baga_vec_push_i64(out, 0);\n")
    write("    if (nw < 1) nw = 1;\n")
    write("    if (nw > n) nw = n;\n")
    write("    int64_t jobs = baga_chan_new(n);\n")
    write("    int64_t results = baga_chan_new(n);\n")
    write("    baga_PoolCtx *ctx = (baga_PoolCtx *)calloc(1, sizeof(baga_PoolCtx));\n")
    write("    if (!ctx) { fprintf(stderr, \"baga: pool_map: oom\\n\"); exit(1); }\n")
    write("    ctx->fn = fn; ctx->in = in; ctx->jobs = jobs; ctx->results = results;\n")
    write("    int64_t *hs = (int64_t *)malloc((size_t)nw * sizeof(int64_t));\n")
    write("    if (!hs) { fprintf(stderr, \"baga: pool_map: oom\\n\"); exit(1); }\n")
    write("    for (int64_t w = 0; w < nw; w++)\n")
    write("        hs[w] = baga_go(baga_pool_worker, (int64_t)(intptr_t)ctx);\n")
    write("    for (int64_t i = 0; i < n; i++) baga_chan_send(jobs, i);\n")
    write("    baga_chan_close(jobs);\n")
    write("    for (int64_t i = 0; i < n; i++) {\n")
    write("        int64_t pair = baga_chan_recv(results);\n")
    write("        int64_t idx = baga_cell2_0(pair);\n")
    write("        int64_t r = baga_cell2_1(pair);\n")
    write("        if (idx >= 0 && idx < n) baga_vec_set_i64(out, idx, r);\n")
    write("    }\n")
    write("    for (int64_t w = 0; w < nw; w++) baga_join(hs[w]);\n")
    write("    free(hs); free(ctx);\n")
    write("    return out;\n")
    write("}\n")
    write("\n")
}
