// c2_parse.baga — парсер: изрази (primary → оператори по приоритет),
// block/stmt. Декларациите (fn/struct/enum/spec) са в c2_parse_stmt.baga.

import "c2_ast.baga"
import "c2_lex.baga"

// ============================================================
//  Parser
// ============================================================

fn is_single(tk: Vec, tt: Vec, pos: i64, ch: str) -> i64 {
    if vec_get(tk, pos) == 300 {
        if str_eq(vec_get_str(tt, pos), ch) { return 1 }
    }
    0
}

fn parse_expr(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64

fn parse_primary(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut k = vec_get(tk, vec_get(pos, 0))
    let mut t = vec_get_str(tt, vec_get(pos, 0))
    if k == 1 {
        self_unsupported("fn стойности / ламбди (L5 closures)")
    }
    if is_single(tk, tt, vec_get(pos, 0), "-") == 1 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut operand = parse_primary(tk, tt, pos, nk, nt, fc, ns)
        let mut neg = ast_kind(nk, nt, fc, ns, 3, "-")
        let mut zero = ast_kind(nk, nt, fc, ns, 0, "0")
        ast_child(fc, ns, neg, zero)
        ast_child(fc, ns, neg, operand)
        return neg
    }
    if k == 100 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        return ast_kind(nk, nt, fc, ns, 0, t)
    }
    if k == 102 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        return ast_kind(nk, nt, fc, ns, 19, t)
    }
    if k == 101 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        // string interpolation: ${expr} -> concat chain with TO_STR (kind 28)
        if bfind(t, 36, 0) < 0 {
            return ast_kind(nk, nt, fc, ns, 1, t)
        }
        let mut parts = vec_new()
        let mut lit = ""
        let mut n = len(t)
        let mut i: i64 = 0
        while i < n {
            let mut c = char_at(t, i)
            if c == 36 && i + 1 < n && char_at(t, i + 1) == 36 {
                lit = concat(lit, byte_chr(36))
                i = i + 2
            } else {
                if c == 36 && i + 1 < n && char_at(t, i + 1) == 123 {
                    if len(lit) > 0 { vec_push(parts, ast_kind(nk, nt, fc, ns, 1, lit)); lit = "" }
                    let mut j = i + 2
                    let mut depth: i64 = 1
                    while j < n && depth > 0 {
                        let mut cj = char_at(t, j)
                        if cj == 123 { depth = depth + 1 } else { if cj == 125 { depth = depth - 1 } }
                        if depth == 0 { break }
                        j = j + 1
                    }
                    let mut expr_s = substr(t, i + 2, j)
                    let mut etk = vec_new()
                    let mut ett = vec_new()
                    tokenize(expr_s, etk, ett)
                    let mut epos = vec_new()
                    vec_push(epos, 0)
                    let mut enode = parse_expr(etk, ett, epos, nk, nt, fc, ns)
                    let mut ts = ast_kind(nk, nt, fc, ns, 33, "")
                    ast_child(fc, ns, ts, enode)
                    vec_push(parts, ts)
                    i = j + 1
                } else {
                    lit = concat(lit, byte_chr(c))
                    i = i + 1
                }
            }
        }
        if len(lit) > 0 { vec_push(parts, ast_kind(nk, nt, fc, ns, 1, lit)) }
        let mut np = vec_len(parts)
        if np == 0 { return ast_kind(nk, nt, fc, ns, 1, "") }
        let mut acc = vec_get(parts, np - 1)
        let mut pi = np - 2
        while pi >= 0 {
            let call = ast_kind(nk, nt, fc, ns, 4, "")
            let mut callee = ast_kind(nk, nt, fc, ns, 2, "concat")
            ast_child(fc, ns, call, callee)
            ast_child(fc, ns, call, vec_get(parts, pi))
            ast_child(fc, ns, call, acc)
            acc = call
            pi = pi - 1
        }
        return acc
    }
    if k == 103 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        return ast_kind(nk, nt, fc, ns, 34, t)
    }
    if k == 14 { vec_set(pos, 0, vec_get(pos, 0) + 1); return ast_kind(nk, nt, fc, ns, 20, "1") }
    if k == 15 { vec_set(pos, 0, vec_get(pos, 0) + 1); return ast_kind(nk, nt, fc, ns, 20, "0") }
    if k == 0 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        if str_eq(t, "match") == 1 {
            let mut scrut = parse_expr(tk, tt, pos, nk, nt, fc, ns)
            let mut mnode = ast_kind(nk, nt, fc, ns, 26, "")
            ast_child(fc, ns, mnode, scrut)
            if is_single(tk, tt, vec_get(pos, 0), "{") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
            while is_single(tk, tt, vec_get(pos, 0), "}") == 0 {
                if vec_get(tk, vec_get(pos, 0)) == 999 { break }
                let mut pat = parse_primary(tk, tt, pos, nk, nt, fc, ns)
                let mut is_wild: i64 = 0
                if node_kind(nk, pat) == 2 {
                    if str_eq(node_text(nt, pat), "_") == 1 { is_wild = 1 }
                }
                if is_single(tk, tt, vec_get(pos, 0), "=") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
                if is_single(tk, tt, vec_get(pos, 0), ">") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
                let mut body = parse_expr(tk, tt, pos, nk, nt, fc, ns)
                let mut atext = ""
                if is_wild == 1 { atext = "_" }
                let mut arm = ast_kind(nk, nt, fc, ns, 27, atext)
                if is_wild == 0 { ast_child(fc, ns, arm, pat) }
                ast_child(fc, ns, arm, body)
                ast_child(fc, ns, mnode, arm)
                if is_single(tk, tt, vec_get(pos, 0), ",") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
            }
            if is_single(tk, tt, vec_get(pos, 0), "}") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
            return mnode
        }
        let mut base = ast_kind(nk, nt, fc, ns, 2, t)
        if is_single(tk, tt, vec_get(pos, 0), "(") == 1 {
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            let mut call = ast_kind(nk, nt, fc, ns, 4, "")
            ast_child(fc, ns, call, base)
            if is_single(tk, tt, vec_get(pos, 0), ")") == 0 {
                let mut arg = parse_expr(tk, tt, pos, nk, nt, fc, ns)
                ast_child(fc, ns, call, arg)
                while is_single(tk, tt, vec_get(pos, 0), ",") == 1 {
                    vec_set(pos, 0, vec_get(pos, 0) + 1)
                    let mut a2 = parse_expr(tk, tt, pos, nk, nt, fc, ns)
                    ast_child(fc, ns, call, a2)
                }
            }
            if is_single(tk, tt, vec_get(pos, 0), ")") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
            base = call
        }
        if is_single(tk, tt, vec_get(pos, 0), "{") == 1 {
            let mut p1 = vec_get(pos, 0) + 1
            let mut p2 = vec_get(pos, 0) + 2
            let mut is_lit: i64 = 0
            if p2 < vec_len(tk) {
                if vec_get(tk, p1) == 0 {
                    if is_single(tk, tt, p2, ":") == 1 { is_lit = 1 }
                }
            }
            if is_lit == 1 {
                vec_set(pos, 0, vec_get(pos, 0) + 1)
                let mut lit = ast_kind(nk, nt, fc, ns, 22, t)
                while is_single(tk, tt, vec_get(pos, 0), "}") == 0 {
                    if vec_get(tk, vec_get(pos, 0)) == 999 { break }
                    let fname = vec_get_str(tt, vec_get(pos, 0))
                    vec_set(pos, 0, vec_get(pos, 0) + 1)
                    if is_single(tk, tt, vec_get(pos, 0), ":") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
                    let mut val = parse_expr(tk, tt, pos, nk, nt, fc, ns)
                    let mut fi = ast_kind(nk, nt, fc, ns, 24, fname)
                    ast_child(fc, ns, fi, val)
                    ast_child(fc, ns, lit, fi)
                    if is_single(tk, tt, vec_get(pos, 0), ",") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
                }
                if is_single(tk, tt, vec_get(pos, 0), "}") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
                base = lit
            }
        }
        while is_single(tk, tt, vec_get(pos, 0), ".") == 1 {
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            let mut fname = vec_get_str(tt, vec_get(pos, 0))
            vec_set(pos, 0, vec_get(pos, 0) + 1)
            let mut fnode = ast_kind(nk, nt, fc, ns, 23, fname)
            ast_child(fc, ns, fnode, base)
            base = fnode
        }
        while is_single(tk, tt, vec_get(pos, 0), "?") == 1 {
            vec_set(pos, 0, vec_get(pos, 0) + 1)
        }
        return base
    }
    if is_single(tk, tt, vec_get(pos, 0), "(") == 1 {
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut e = parse_expr(tk, tt, pos, nk, nt, fc, ns)
        if is_single(tk, tt, vec_get(pos, 0), ")") == 1 { vec_set(pos, 0, vec_get(pos, 0) + 1) }
        return e
    }
    vec_set(pos, 0, vec_get(pos, 0) + 1)
    ast_kind(nk, nt, fc, ns, 0, "0")
}

fn parse_mul(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut left = parse_primary(tk, tt, pos, nk, nt, fc, ns)
    while vec_get(pos, 0) < vec_len(tk) {
        let mut op: str = ""
        if is_single(tk, tt, vec_get(pos, 0), "*") == 1 { op = "*" }
        if is_single(tk, tt, vec_get(pos, 0), "/") == 1 { op = "/" }
        if is_single(tk, tt, vec_get(pos, 0), "%") == 1 { op = "%" }
        if str_eq(op, "") == 1 { break }
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut right = parse_primary(tk, tt, pos, nk, nt, fc, ns)
        let mut node = ast_kind(nk, nt, fc, ns, 3, op)
        ast_child(fc, ns, node, left)
        ast_child(fc, ns, node, right)
        left = node
    }
    left
}

fn parse_add(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut left = parse_mul(tk, tt, pos, nk, nt, fc, ns)
    while vec_get(pos, 0) < vec_len(tk) {
        let mut op: str = ""
        if is_single(tk, tt, vec_get(pos, 0), "+") == 1 { op = "+" }
        if is_single(tk, tt, vec_get(pos, 0), "-") == 1 { op = "-" }
        if str_eq(op, "") == 1 { break }
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut right = parse_mul(tk, tt, pos, nk, nt, fc, ns)
        let mut node = ast_kind(nk, nt, fc, ns, 3, op)
        ast_child(fc, ns, node, left)
        ast_child(fc, ns, node, right)
        left = node
    }
    left
}

fn parse_shift(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut left = parse_add(tk, tt, pos, nk, nt, fc, ns)
    while vec_get(pos, 0) < vec_len(tk) {
        let mut op: str = ""
        let mut k = vec_get(tk, vec_get(pos, 0))
        if k == 205 { op = "<<" }
        if k == 207 { op = ">>" }
        if str_eq(op, "") == 1 { break }
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut right = parse_add(tk, tt, pos, nk, nt, fc, ns)
        let mut node = ast_kind(nk, nt, fc, ns, 3, op)
        ast_child(fc, ns, node, left)
        ast_child(fc, ns, node, right)
        left = node
    }
    left
}

fn parse_cmp(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut left = parse_shift(tk, tt, pos, nk, nt, fc, ns)
    while vec_get(pos, 0) < vec_len(tk) {
        let mut op: str = ""
        let mut k = vec_get(tk, vec_get(pos, 0))
        if k == 201 { op = "==" }
        if k == 203 { op = "!=" }
        if k == 204 { op = "<=" }
        if k == 206 { op = ">=" }
        if is_single(tk, tt, vec_get(pos, 0), "<") == 1 { op = "<" }
        if is_single(tk, tt, vec_get(pos, 0), ">") == 1 { op = ">" }
        if str_eq(op, "") == 1 { break }
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut right = parse_shift(tk, tt, pos, nk, nt, fc, ns)
        let mut node = ast_kind(nk, nt, fc, ns, 3, op)
        ast_child(fc, ns, node, left)
        ast_child(fc, ns, node, right)
        left = node
    }
    left
}

fn parse_bitand(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut left = parse_cmp(tk, tt, pos, nk, nt, fc, ns)
    while vec_get(pos, 0) < vec_len(tk) {
        if is_single(tk, tt, vec_get(pos, 0), "&") == 0 { break }
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut right = parse_cmp(tk, tt, pos, nk, nt, fc, ns)
        let mut node = ast_kind(nk, nt, fc, ns, 3, "&")
        ast_child(fc, ns, node, left)
        ast_child(fc, ns, node, right)
        left = node
    }
    left
}

fn parse_bitxor(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut left = parse_bitand(tk, tt, pos, nk, nt, fc, ns)
    while vec_get(pos, 0) < vec_len(tk) {
        if is_single(tk, tt, vec_get(pos, 0), "^") == 0 { break }
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut right = parse_bitand(tk, tt, pos, nk, nt, fc, ns)
        let mut node = ast_kind(nk, nt, fc, ns, 3, "^")
        ast_child(fc, ns, node, left)
        ast_child(fc, ns, node, right)
        left = node
    }
    left
}

fn parse_bitor(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut left = parse_bitxor(tk, tt, pos, nk, nt, fc, ns)
    while vec_get(pos, 0) < vec_len(tk) {
        if is_single(tk, tt, vec_get(pos, 0), "|") == 0 { break }
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut right = parse_bitxor(tk, tt, pos, nk, nt, fc, ns)
        let mut node = ast_kind(nk, nt, fc, ns, 3, "|")
        ast_child(fc, ns, node, left)
        ast_child(fc, ns, node, right)
        left = node
    }
    left
}

fn parse_and(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut left = parse_bitor(tk, tt, pos, nk, nt, fc, ns)
    while vec_get(pos, 0) < vec_len(tk) {
        if vec_get(tk, vec_get(pos, 0)) != 208 { break }
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut right = parse_bitor(tk, tt, pos, nk, nt, fc, ns)
        let mut node = ast_kind(nk, nt, fc, ns, 3, "&&")
        ast_child(fc, ns, node, left)
        ast_child(fc, ns, node, right)
        left = node
    }
    left
}

fn parse_or(tk: Vec, tt: Vec, pos: Vec, nk: Vec, nt: Vec, fc: Vec, ns: Vec) -> i64 {
    let mut left = parse_and(tk, tt, pos, nk, nt, fc, ns)
    while vec_get(pos, 0) < vec_len(tk) {
        if vec_get(tk, vec_get(pos, 0)) != 209 { break }
        vec_set(pos, 0, vec_get(pos, 0) + 1)
        let mut right = parse_and(tk, tt, pos, nk, nt, fc, ns)
        let mut node = ast_kind(nk, nt, fc, ns, 3, "||")
        ast_child(fc, ns, node, left)
        ast_child(fc, ns, node, right)
        left = node
    }
    left
}

