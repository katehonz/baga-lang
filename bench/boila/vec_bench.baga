// vec_bench.baga — P8/V2: bulk VECTOR seed + kNN latency gate.
// Env: VEC_BENCH_PHASE=write|query  VEC_BENCH_TOTAL  VEC_BENCH_CHUNK
//      VEC_BENCH_NCHUNKS  VEC_BENCH_DIM (default 16; bulk path supports 128d)
// Gate (PLAN): 100k×128d recall@10≥0.95 / <20 ms — measured at feasible scale.
//
// Write path: SQL CREATE only; data rows via boila_put + packed fixed-point
// vectors (no SQL string literals — Q2 arena residual for 128d).

import "boilaDB/server/databases.baga"
import "boilaDB/server/exec_server.baga"
import "boilaDB/storage/shards.baga"
import "boilaDB/catalog/schema.baga"
import "boilaDB/core/codec.baga"
import "boilaDB/core/value.baga"
import "boilaDB/core/row.baga"
import "boilaDB/vector/distance.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/time/time.baga"
import "std/bytes/bytes.baga"

fn wipe_shard_path(prefix: str) -> i64 !IO {
    unlink(concat(prefix, ".wal"))?
    unlink(concat(prefix, ".manifest"))?
    unlink(concat(prefix, ".manifest.log"))?
    let mut g: i64 = 1
    while g <= 400 {
        unlink(concat(concat(prefix, ".sst."), int_to_str(g)))?
        unlink(concat(concat(prefix, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

fn wipe_root(root: str) -> i64 !IO {
    wipe_shard_path(concat(root, "/.meta"))?
    let mut i: i64 = 0
    while i < 2 {
        wipe_shard_path(concat(concat(root, "/boila.db.s"), int_to_str(i)))?
        i = i + 1
    }
    return 0
}

// Deterministic unit-ish vector as fixed-point string for dim dims (query SQL).
// Component d of id: ((id * 17 + d * 31) % 200 - 100) / 100.0
fn vec_lit(id: i64, dim: i64) -> str {
    let mut s = "["
    let mut d: i64 = 0
    while d < dim {
        if d > 0 {
            s = concat(s, ",")
        }
        let raw = (id * 17 + d * 31) % 200 - 100
        let mut abs = raw
        let mut neg = 0
        if abs < 0 {
            neg = 1
            abs = 0 - abs
        }
        let whole = abs / 100
        let frac = abs % 100
        if neg == 1 {
            s = concat(s, "-")
        }
        s = concat(s, int_to_str(whole))
        s = concat(s, ".")
        if frac < 10 {
            s = concat(s, "0")
        }
        s = concat(s, int_to_str(frac))
        d = d + 1
    }
    return concat(s, "]")
}

// Packed VECTOR val: same components as vec_lit, fixed-point ×1e6 (raw*10000).
fn vec_val(id: i64, dim: i64) -> BoilaVal {
    let mut body = bytes_new(0)
    let mut d: i64 = 0
    while d < dim {
        let raw = (id * 17 + d * 31) % 200 - 100
        // raw/100.0 as f64 → ×1e6 fp = raw * 10000
        body = bytes_concat(body, boila_enc_i32_be(raw * 10000))
        d = d + 1
    }
    return boila_val_vector(dim, body)
}

fn main() -> i64 !IO !Time !Par {
    let root = "/tmp/baga_boila_vec_bench"
    let mut phase = env("VEC_BENCH_PHASE")
    if phase == "" {
        phase = "write"
    }
    let mut dim: i64 = 16
    if env("VEC_BENCH_DIM") != "" {
        dim = parse_int(env("VEC_BENCH_DIM"))
    }

    if phase == "query" {
        let mut srv = boila_server_open(root, 2, 256, 4, 4)?
        let qv = vec_lit(0, dim)
        let mut sql = "SELECT id FROM items WHERE emb <-> '"
        sql = concat(sql, qv)
        sql = concat(sql, "' LIMIT 10")
        let w = boila_server_exec(srv, "boila", sql)?
        srv = w.srv
        if w.ok == 0 {
            print(concat("query setup fail: ", w.err))
            return 1
        }
        let t0 = monotonic_us()?
        let mut reps: i64 = 0
        let mut nrows: i64 = 0
        while reps < 20 {
            let q = boila_server_exec(srv, "boila", sql)?
            srv = q.srv
            nrows = vec_len(q.res.rows)
            reps = reps + 1
        }
        let t1 = monotonic_us()?
        let us = (t1 - t0) / 20
        print(concat(concat(concat("kNN L2 LIMIT 10: ", int_to_str(us)), " us ("), concat(int_to_str(nrows), " rows)")))
        let mut verdict = "FAIL (gate < 20000 us)"
        if us < 20000 {
            verdict = "OK — < 20 ms"
        }
        print(concat("gate: ", verdict))
        print(concat(concat("dim=", int_to_str(dim)), " (PLAN target 128d)"))
        boila_server_close(srv)?
        return 0
    }

    let mut chunk: i64 = 0
    if env("VEC_BENCH_CHUNK") != "" {
        chunk = parse_int(env("VEC_BENCH_CHUNK"))
    }
    let mut nchunks: i64 = 20
    if env("VEC_BENCH_NCHUNKS") != "" {
        nchunks = parse_int(env("VEC_BENCH_NCHUNKS"))
    }
    let mut total: i64 = 10000
    if env("VEC_BENCH_TOTAL") != "" {
        total = parse_int(env("VEC_BENCH_TOTAL"))
    }
    let per = total / nchunks
    let lo = chunk * per
    let mut hi = lo + per
    if chunk == nchunks - 1 {
        hi = total
    }

    if chunk == 0 {
        wipe_root(root)?
    }
    let mut srv = boila_server_open(root, 2, 256, 4, 4)?
    if chunk == 0 {
        let mut ddl = "CREATE TABLE items (id BIGINT, emb VECTOR("
        ddl = concat(ddl, int_to_str(dim))
        ddl = concat(ddl, "), PRIMARY KEY (id))")
        let c1 = boila_server_exec(srv, "boila", ddl)?
        srv = c1.srv
        if c1.ok == 0 {
            print(concat("setup fail: ", c1.err))
            return 1
        }
    }
    // resolve table id for bulk put
    let db = boila_srv_db(srv, "boila")?
    srv = db.srv
    if db.ok == 0 {
        print(concat("open db fail: ", db.err))
        return 1
    }
    let mut s = db.store
    let cat = boila_cat_by_name(s, "items")?
    s = cat.s
    if cat.ok == 0 {
        print(concat("cat fail: ", cat.err))
        return 1
    }
    let tid = cat.table.id
    let t0 = monotonic_us()?
    let mut id = lo
    while id < hi {
        let row: Vec<BoilaVal> = vec_new()
        vec_push(row, boila_val_i64(id))
        vec_push(row, vec_val(id, dim))
        s = boila_put(s, boila_cf_data(), tid, boila_val_enc(boila_val_i64(id)), boila_row_enc(row))?
        id = id + 1
    }
    // periodic flush every 2k to bound memtable
    s = boila_flush(s)?
    srv = boila_srv_store_putback(srv, "boila", s)
    let t1 = monotonic_us()?
    print(concat(concat(concat(concat(concat("chunk ", int_to_str(chunk)), concat(": items ", int_to_str(lo))), concat("..", int_to_str(hi))), concat(" bulk ", int_to_str((t1 - t0) / 1000))), " ms"))
    if chunk == nchunks - 1 {
        let t2 = monotonic_us()?
        let c2 = boila_server_exec(srv, "boila", "CREATE INDEX items_hnsw ON items USING hnsw (emb)")?
        srv = c2.srv
        if c2.ok == 0 {
            print(concat("hnsw fail: ", c2.err))
            return 1
        }
        let t3 = monotonic_us()?
        print(concat(concat("hnsw build: ", int_to_str((t3 - t2) / 1000)), " ms"))
    }
    boila_server_close(srv)?
    return 0
}
