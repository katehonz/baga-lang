// ts_bench.baga — P9/S5: bulk time-series seed + time_bucket range gate.
// Env: TS_BENCH_PHASE=write|query  TS_BENCH_TOTAL  TS_BENCH_CHUNK  TS_BENCH_NCHUNKS
// Gate (PLAN): 1M points range+bucket < 50 ms — measured at largest feasible.

import "boilaDB/server/databases.baga"
import "boilaDB/server/exec_server.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/time/time.baga"

fn wipe_shard_path(prefix: str) -> i64 !IO {
    unlink(concat(prefix, ".wal"))?
    unlink(concat(prefix, ".manifest"))?
    unlink(concat(prefix, ".manifest.log"))?
    let mut g: i64 = 1
    while g <= 400 {
        unlink(concat(concat(prefix, ".sst."), int_to_str(g)))?
        unlink(concat(concat(prefix, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

fn wipe_root(root: str) -> i64 !IO {
    wipe_shard_path(concat(root, "/.meta"))?
    let mut i: i64 = 0
    while i < 2 {
        wipe_shard_path(concat(concat(root, "/boila.db.s"), int_to_str(i)))?
        i = i + 1
    }
    return 0
}

fn main() -> i64 !IO !Time !Par {
    let root = "/tmp/baga_boila_ts_bench"
    let mut phase = env("TS_BENCH_PHASE")
    if phase == "" {
        phase = "write"
    }

    if phase == "query" {
        let mut srv = boila_server_open(root, 2, 256, 4, 4)?
        // warm
        let w = boila_server_exec(srv, "boila", "SELECT count(*), sum(v) FROM pts GROUP BY time_bucket('1m', ts)")?
        srv = w.srv
        if w.ok == 0 {
            print(concat("query setup fail: ", w.err))
            return 1
        }
        let t0 = monotonic_us()?
        let mut reps: i64 = 0
        let mut nrows: i64 = 0
        while reps < 10 {
            let q = boila_server_exec(srv, "boila", "SELECT count(*), sum(v) FROM pts GROUP BY time_bucket('1m', ts)")?
            srv = q.srv
            nrows = vec_len(q.res.rows)
            reps = reps + 1
        }
        let t1 = monotonic_us()?
        let us = (t1 - t0) / 10
        print(concat(concat("time_bucket GROUP BY: ", int_to_str(us)), concat(" us (", concat(int_to_str(nrows), " buckets)"))))
        // PK range scan + bucket
        let t2 = monotonic_us()?
        reps = 0
        while reps < 10 {
            let q = boila_server_exec(srv, "boila", "SELECT count(*), sum(v) FROM pts WHERE id >= 0 AND id < 1000000 GROUP BY time_bucket('1h', ts)")?
            srv = q.srv
            reps = reps + 1
        }
        let t3 = monotonic_us()?
        let us2 = (t3 - t2) / 10
        print(concat(concat("range+bucket 1h: ", int_to_str(us2)), " us"))
        // secondary pts_ts_ix: half-open window (last 10k points by ts)
        // ts = 1000000 + id → window [1000000+total-10000, 1000000+total)
        let mut total: i64 = 100000
        if env("TS_BENCH_TOTAL") != "" {
            total = parse_int(env("TS_BENCH_TOTAL"))
        }
        let win = 10000
        let mut lo = 1000000
        if total > win {
            lo = 1000000 + total - win
        }
        let hi = 1000000 + total
        let tsql = concat(concat(concat(concat(
            "SELECT count(*), sum(v) FROM pts WHERE ts >= ", int_to_str(lo)),
            " AND ts < "), int_to_str(hi)),
            " GROUP BY time_bucket('1m', ts)")
        let t4 = monotonic_us()?
        reps = 0
        let mut nb: i64 = 0
        while reps < 10 {
            let q = boila_server_exec(srv, "boila", tsql)?
            srv = q.srv
            nb = vec_len(q.res.rows)
            reps = reps + 1
        }
        let t5 = monotonic_us()?
        let us3 = (t5 - t4) / 10
        print(concat(concat("ts-ix window+bucket: ", int_to_str(us3)), concat(" us (", concat(int_to_str(nb), " buckets)"))))
        let mut verdict = "FAIL (gate < 50000 us)"
        if us < 50000 && us2 < 50000 {
            verdict = "OK — both < 50 ms"
        }
        print(concat("gate: ", verdict))
        boila_server_close(srv)?
        return 0
    }

    let mut chunk: i64 = 0
    if env("TS_BENCH_CHUNK") != "" {
        chunk = parse_int(env("TS_BENCH_CHUNK"))
    }
    let mut nchunks: i64 = 20
    if env("TS_BENCH_NCHUNKS") != "" {
        nchunks = parse_int(env("TS_BENCH_NCHUNKS"))
    }
    let mut total: i64 = 100000
    if env("TS_BENCH_TOTAL") != "" {
        total = parse_int(env("TS_BENCH_TOTAL"))
    }
    let per = total / nchunks
    let lo = chunk * per
    let mut hi = lo + per
    if chunk == nchunks - 1 {
        hi = total
    }

    if chunk == 0 {
        wipe_root(root)?
    }
    let mut srv = boila_server_open(root, 2, 256, 4, 4)?
    if chunk == 0 {
        let c1 = boila_server_exec(srv, "boila", "CREATE TABLE pts (id BIGINT, ts BIGINT, v BIGINT, PRIMARY KEY (id))")?
        srv = c1.srv
        if c1.ok == 0 {
            print(concat("setup fail: ", c1.err))
            return 1
        }
        // secondary on ts (range + sort-order for time scans)
        let c2 = boila_server_exec(srv, "boila", "CREATE INDEX pts_ts_ix ON pts (ts)")?
        srv = c2.srv
        if c2.ok == 0 {
            print(concat("ix fail: ", c2.err))
            return 1
        }
    }
    let batch: i64 = 500
    let t0 = monotonic_us()?
    let mut base = lo
    while base < hi {
        let mut n = batch
        if base + n > hi {
            n = hi - base
        }
        let mut sql = "INSERT INTO pts (id, ts, v) VALUES "
        let mut i: i64 = 0
        while i < n {
            if i > 0 {
                sql = concat(sql, ", ")
            }
            let id = base + i
            // 1s steps from epoch base; v = id % 97
            let ts = 1000000 + id
            let v = id % 97
            sql = concat(sql, "(")
            sql = concat(sql, int_to_str(id))
            sql = concat(sql, ", ")
            sql = concat(sql, int_to_str(ts))
            sql = concat(sql, ", ")
            sql = concat(sql, int_to_str(v))
            sql = concat(sql, ")")
            i = i + 1
        }
        let r = boila_server_exec(srv, "boila", sql)?
        srv = r.srv
        if r.ok == 0 {
            print(concat("insert fail at ", concat(int_to_str(base), concat(": ", r.err))))
            return 1
        }
        base = base + batch
    }
    let t1 = monotonic_us()?
    print(concat(concat(concat(concat(concat("chunk ", int_to_str(chunk)), concat(": pts ", int_to_str(lo))), concat("..", int_to_str(hi))), concat(" in ", int_to_str((t1 - t0) / 1000))), " ms"))
    boila_server_close(srv)?
    return 0
}
