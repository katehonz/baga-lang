// mt_ladder.baga — concurrent HTTP ladder vs MT serve (raw TCP client).
// Ladder clients=1/4/8/16/32 × 200 point SELECTs. Honest: not 10k OS threads.

import "boilaDB/storage/databases.baga"
import "boilaDB/sql/exec_server.baga"
import "boilaDB/api/serve_mt.baga"
import "boilaDB/api/http_sql.baga"
import "boilaDB/txn/mvcc.baga"
import "httpdbaga/http.baga"
import "std/net/tcp.baga"
import "std/net/poll.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"
import "std/time/time.baga"

fn wipe_one(prefix: str) -> i64 !IO !Par {
    unlink(concat(prefix, ".wal"))?
    unlink(concat(prefix, ".manifest"))?
    unlink(concat(prefix, ".manifest.log"))?
    let mut g: i64 = 1
    while g <= 40 {
        unlink(concat(concat(prefix, ".sst."), int_to_str(g)))?
        unlink(concat(concat(prefix, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

fn wipe_root(root: str) -> i64 !IO !Par {
    wipe_one(concat(root, "/.meta"))?
    let mut i: i64 = 0
    while i < 4 {
        wipe_one(concat(concat(root, "/boila.db.s"), int_to_str(i)))?
        i = i + 1
    }
    return 0
}

fn seed_db(root: str, nrows: i64) -> i64 !IO !Time !Par {
    let mut srv = boila_server_open(root, 4, 256, 4, 16)?
    if srv.ok == 0 {
        return 0
    }
    let c = boila_server_exec(srv, "boila", "CREATE TABLE t (id BIGINT, v TEXT, PRIMARY KEY (id))")?
    srv = c.srv
    if c.ok == 0 {
        boila_server_close(srv)?
        return 0
    }
    let mut i: i64 = 0
    while i < nrows {
        let sql = concat(concat("INSERT INTO t (id, v) VALUES (", int_to_str(i)), ", 'x')")
        let o = boila_server_exec(srv, "boila", sql)?
        srv = o.srv
        i = i + 1
    }
    boila_server_close(srv)?
    return 1
}

fn mt_http_conn(ctx: i64) -> i64 !IO !Net !Time !Par {
    let fd = cell2_0(ctx)
    let pack = cell2_1(ctx)
    tcp_set_nodelay(fd)?
    let mut txn = boila_txn_new()
    let mut r = http_reader(fd)
    let mut keep = true
    while keep {
        let out = http_read_request_r(r)?
        r = out.reader
        if out.err != 0 || http_method(out.req) == "" {
            keep = false
        } else {
            let ka = http_keepalive(out.req)
            let method = http_method(out.req)
            let path = http_path_only(out.req)
            if method == "POST" && path == "/sql" {
                let mut db = http_query_param(out.req, "db")
                if db == "" {
                    db = "boila"
                }
                let ex = boila_mt_exec(pack, txn, db, http_body(out.req))?
                txn = ex.txn
                http_respond_keepalive(fd, boila_http_encode(ex).resp, ka)?
            } else {
                if method == "GET" && path == "/health" {
                    http_respond_keepalive(fd, http_json_response(200, "{\"ok\":1}"), ka)?
                } else {
                    http_respond_keepalive(fd, http_json_response(404, "{}"), 0)?
                    keep = false
                }
            }
            if ka == 0 {
                keep = false
            }
        }
    }
    if txn.active == 1 {
        txn = boila_txn_rollback(txn)
    }
    tcp_close(fd)?
    boila_mt_end_conn(pack)?
    return 0
}

fn mt_serve(port: i64) -> i64 !Net !IO !Time !Par {
    let root = "/tmp/baga_boila_mt_ladder"
    let srv0 = boila_server_open_mt(root, 4, 256, 4, 16)?
    if srv0.ok == 0 {
        return 1
    }
    let pack = boila_mt_new(srv0, 128)?
    let listener = tcp_listen(port)?
    let pollfds: Vec<i64> = vec_new()
    vec_push(pollfds, listener)
    while true {
        let pr = poll_wait(pollfds, 200)?
        if pr.ok < 0 {
            return 1
        }
        if poll_has(pr.ready, listener) == 1 {
            let fd = tcp_accept(listener)?
            if fd >= 0 {
                if boila_mt_try_conn(pack)? == 0 {
                    tcp_close(fd)?
                } else {
                    go_bg(mt_http_conn, cell2(fd, pack))
                }
            }
        }
    }
    return 0
}

// Minimal HTTP/1.1 POST /sql — one req, read to close. Returns 1 if "ok":true.
fn sql_post(port: i64, sql: str) -> i64 !Net !IO !Par {
    let fd = tcp_connect("127.0.0.1", port)?
    if fd < 0 {
        return 0
    }
    let mut req = "POST /sql?db=boila HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\nContent-Length: "
    req = concat(req, int_to_str(len(sql)))
    req = concat(req, "\r\n\r\n")
    req = concat(req, sql)
    let w = tcp_write(fd, req)?
    if w != 0 {
        tcp_close(fd)?
        return 0
    }
    let mut body = ""
    let mut rounds: i64 = 0
    while rounds < 200 {
        let chunk = tcp_read(fd, 4096)?
        if chunk == "" {
            rounds = 200
        } else {
            body = concat(body, chunk)
            rounds = rounds + 1
        }
    }
    tcp_close(fd)?
    if str_find(body, "\"ok\":true") >= 0 {
        return 1
    }
    return 0
}

fn health_ok(port: i64) -> i64 !Net !IO !Par {
    let fd = tcp_connect("127.0.0.1", port)?
    if fd < 0 {
        return 0
    }
    let w = tcp_write(fd, "GET /health HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")?
    if w != 0 {
        tcp_close(fd)?
        return 0
    }
    let mut body = ""
    let mut r: i64 = 0
    while r < 50 {
        let c = tcp_read(fd, 1024)?
        if c == "" {
            r = 50
        } else {
            body = concat(body, c)
            r = r + 1
        }
    }
    tcp_close(fd)?
    if str_find(body, "200") >= 0 {
        return 1
    }
    return 0
}

// ctx = cell2(port, cell2(nops, seed))
fn mt_worker(ctx: i64) -> i64 !Net !IO !Time !Par {
    let port = cell2_0(ctx)
    let pack = cell2_1(ctx)
    let nops = cell2_0(pack)
    let seed = cell2_1(pack)
    let mut okc: i64 = 0
    let mut i: i64 = 0
    while i < nops {
        let id = (seed + i) % 1000
        let sql = concat("SELECT id FROM t WHERE id = ", int_to_str(id))
        okc = okc + sql_post(port, sql)?
        i = i + 1
    }
    return okc
}

fn run_level(port: i64, clients: i64, ops_each: i64) -> i64 !Net !IO !Time !Par {
    let handles: Vec<i64> = vec_new()
    let mut c: i64 = 0
    let t0 = monotonic_us()?
    while c < clients {
        vec_push(handles, go(mt_worker, cell2(port, cell2(ops_each, c * 17))))
        c = c + 1
    }
    let mut okc: i64 = 0
    let mut i: i64 = 0
    while i < vec_len(handles) {
        okc = okc + join(vec_get(handles, i))
        i = i + 1
    }
    let t1 = monotonic_us()?
    let total = clients * ops_each
    let us = t1 - t0
    let mut ops: i64 = 0
    if us > 0 {
        ops = (total * 1000000) / us
    }
    print(concat(concat(concat(concat(concat(concat("  c=", int_to_str(clients)), " n="), int_to_str(total)), " ok="), int_to_str(okc)), concat(" ops/s≈", int_to_str(ops))))
    return okc
}

fn main() -> i64 !Net !IO !Time !Par {
    print("boila mt_ladder (concurrent HTTP point SELECT):")
    let root = "/tmp/baga_boila_mt_ladder"
    let port: i64 = 16590
    wipe_root(root)?
    if seed_db(root, 1000)? == 0 {
        print("  seed FAIL")
        return 1
    }
    go_bg(mt_serve, port)
    sleep_ms(400)
    let mut ready: i64 = 0
    let mut w: i64 = 0
    while w < 50 && ready == 0 {
        if health_ok(port)? == 1 {
            ready = 1
        } else {
            sleep_ms(100)
        }
        w = w + 1
    }
    if ready == 0 {
        print("  serve not ready")
        return 1
    }
    let ops_each: i64 = 200
    let mut all_ok: i64 = 1
    let mut li: i64 = 0
    let levels: Vec<i64> = vec_new()
    vec_push(levels, 1)
    vec_push(levels, 4)
    vec_push(levels, 8)
    vec_push(levels, 16)
    vec_push(levels, 32)
    while li < vec_len(levels) {
        let n = vec_get(levels, li)
        let ok = run_level(port, n, ops_each)?
        if ok < n * ops_each {
            all_ok = 0
        }
        li = li + 1
    }
    if all_ok == 1 {
        print("mt_ladder: ALL levels ok")
        return 0
    }
    print("mt_ladder: partial fails")
    return 1
}
