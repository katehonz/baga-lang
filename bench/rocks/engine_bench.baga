// engine_bench.baga — pure rocksbaga engine microbench (no RESP/TCP).
// Workload aligned with bench/rocks/rocksdb_bench.py for head-to-head.
//
// Env:
//   BENCH_N      key count (default 10000)
//   BENCH_VLEN   value bytes (default 100)
//   BENCH_MODE   durable | batch  (default durable)
//     durable: sync_every=1  (fsync each put — worst case, fairest vs RocksDB sync)
//     batch:   sync_every=N  (fsync every N puts; closer to bulk load)
//
// Output lines (machine-parseable):
//   META n=… vlen=… mode=…
//   PUT_MS=… PUT_OPS=…
//   GET_SEQ_MS=… GET_SEQ_OPS=…
//   GET_RND_MS=… GET_RND_OPS=…
//   OK

import "rocksbaga/db/engine.baga"
import "std/time/time.baga"
import "std/str/str.baga"
import "std/os/os.baga"
import "std/bytes/bytes.baga"

fn pad_key(i: i64) -> str {
    // k00000001 — build without O(width) concat-in-loop on hot path
    let s = int_to_str(i)
    let pad = 8 - len(s)
    if pad <= 0 {
        return concat("k", s)
    }
    return concat("k", concat(str_repeat("0", pad), s))
}

fn wipe_prefix(prefix: str) -> i64 !IO {
    unlink(concat(prefix, ".wal"))?
    unlink(concat(prefix, ".manifest"))?
    let mut g: i64 = 1
    while g <= 200 {
        unlink(concat(concat(prefix, ".sst."), int_to_str(g)))?
        unlink(concat(concat(prefix, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

fn ops_per_s(n: i64, ms: i64) -> i64 {
    if ms <= 0 {
        return n * 1000
    }
    return (n * 1000) / ms
}

fn main() -> i64 !IO !Time {
    let mut n: i64 = 10000
    let en = env("BENCH_N")?
    if en != "" {
        n = parse_int(en)
        if n < 100 {
            n = 100
        }
    }
    let mut vlen: i64 = 100
    let ev = env("BENCH_VLEN")?
    if ev != "" {
        vlen = parse_int(ev)
        if vlen < 1 {
            vlen = 1
        }
        if vlen > 4096 {
            vlen = 4096
        }
    }
    let mut mode = env("BENCH_MODE")?
    if mode == "" {
        mode = "durable"
    }
    let prefix = "/tmp/baga_rocks_bench"
    wipe_prefix(prefix)?

    // flush_at: moderately small so compaction runs; not every put
    let mut db = lsm_open(prefix, 64, 4)?
    if db.ok == 0 {
        print("FAIL open")
        return 1
    }
    if mode == "batch" {
        db.sync_every = n   // one fsync window for whole fill (or at end)
        if db.sync_every < 100 {
            db.sync_every = 100
        }
    } else {
        db.sync_every = 1
        mode = "durable"
    }

    print(concat(concat(concat(concat(concat("META n=", int_to_str(n)), " vlen="), int_to_str(vlen)), " mode="), mode))

    // Fixed payload (same on RocksDB side) — measures engine, not string build.
    let val = str_repeat("x", vlen)

    // --- PUT fill ---
    let t0 = monotonic_ms()?
    let mut i: i64 = 0
    while i < n {
        db = lsm_put(db, pad_key(i), val)?
        if db.ok == 0 {
            print("FAIL put")
            return 1
        }
        i = i + 1
    }
    // force durable boundary for batch mode
    if mode == "batch" {
        fdatasync(db.wal_fd)?
        db = lsm_flush_force(db)?
    }
    let t1 = monotonic_ms()?
    let mut put_ms = t1 - t0
    if put_ms < 0 {
        put_ms = 0
    }
    print(concat(concat(concat("PUT_MS=", int_to_str(put_ms)), " PUT_OPS="), int_to_str(ops_per_s(n, put_ms))))

    // Reopen for GET so both sides start from disk-backed state (not only warm memtable).
    lsm_close(db)?
    db = lsm_open(prefix, 64, 4)?
    if db.ok == 0 {
        print("FAIL reopen")
        return 1
    }
    db.sync_every = 1

    // --- sequential GET ---
    let t2 = monotonic_ms()?
    i = 0
    let mut hits: i64 = 0
    while i < n {
        let g = lsm_get(db, pad_key(i))?
        db = g.db
        if g.found == 1 {
            hits = hits + 1
        }
        i = i + 1
    }
    let t3 = monotonic_ms()?
    let mut gseq_ms = t3 - t2
    if gseq_ms < 0 {
        gseq_ms = 0
    }
    print(concat(concat(concat("GET_SEQ_MS=", int_to_str(gseq_ms)), " GET_SEQ_OPS="), int_to_str(ops_per_s(n, gseq_ms))))
    if hits != n {
        print(concat(concat("FAIL hits=", int_to_str(hits)), concat(" want=", int_to_str(n))))
        return 1
    }

    // --- pseudo-random GET (LCG) ---
    let t4 = monotonic_ms()?
    i = 0
    let mut x: i64 = 1
    hits = 0
    while i < n {
        x = (x * 1103515245 + 12345) & 2147483647
        let mut idx = x % n
        if idx < 0 {
            idx = 0 - idx
        }
        let g2 = lsm_get(db, pad_key(idx))?
        db = g2.db
        if g2.found == 1 {
            hits = hits + 1
        }
        i = i + 1
    }
    let t5 = monotonic_ms()?
    let mut grnd_ms = t5 - t4
    if grnd_ms < 0 {
        grnd_ms = 0
    }
    print(concat(concat(concat("GET_RND_MS=", int_to_str(grnd_ms)), " GET_RND_OPS="), int_to_str(ops_per_s(n, grnd_ms))))
    if hits != n {
        print(concat("FAIL rnd hits=", int_to_str(hits)))
        return 1
    }

    lsm_close(db)?
    print("OK")
    return 0
}
