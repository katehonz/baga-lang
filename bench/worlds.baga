// bench/worlds.baga — W1 bench: wvec (офсетен контейнер в свят) срещу Vec.
//
// За концептуалния документ (docs/worlds-bg.md): throughput на push/get,
// размер на dump, цена на dump/load, и къде живее паметта (Vec — в
// thread-local bump арената, видима за MEM-6; светът — отделна malloc
// верига, невидима за mem_arena_bytes по дизайн).
//
// Числата са от една машина — смисълът е в СЪОТНОШЕНИЯТА, не в абсолютните
// стойности. Checksum-ите трябва да съвпадат (валидация, не само timing).
//
//   ./baga -I . bench/worlds.baga

import "std/time/time.baga"

fn bench_vec(n: i64) -> i64 !Time {
    let before = mem_peak_bytes()
    let t0 = monotonic_us()
    let v = vec_new()
    let mut i: i64 = 0
    while i < n {
        vec_push(v, i)
        i = i + 1
    }
    let t1 = monotonic_us()
    let mut s: i64 = 0
    let mut j: i64 = 0
    while j < n {
        s = s + vec_get(v, j)
        j = j + 1
    }
    let t2 = monotonic_us()
    print(concat("vec_push_us       ", i64_to_str(t1 - t0)))
    print(concat("vec_getsum_us     ", i64_to_str(t2 - t1)))
    print(concat("vec_checksum      ", i64_to_str(s)))
    print(concat("vec_bump_peak_d   ", i64_to_str(mem_peak_bytes() - before)))
    return 0
}

fn bench_world(n: i64) -> i64 !Time {
    // Светът е отделна malloc верига — bump телеметрията не го вижда.
    let bump_before = mem_peak_bytes()
    let w = world_new()
    let t0 = monotonic_us()
    let v = wvec_new(w)
    let mut i: i64 = 0
    while i < n {
        wvec_push(w, v, i)
        i = i + 1
    }
    let t1 = monotonic_us()
    let mut s: i64 = 0
    let mut j: i64 = 0
    while j < n {
        s = s + wvec_get(w, v, j)
        j = j + 1
    }
    let t2 = monotonic_us()
    world_freeze(w)
    let t3 = monotonic_us()
    let dump = world_dump(w)
    let t4 = monotonic_us()
    let w2 = world_load(dump)
    let t5 = monotonic_us()
    let loaded = wvec_get(w2, v, n - 1)
    print(concat("wvec_push_us      ", i64_to_str(t1 - t0)))
    print(concat("wvec_getsum_us    ", i64_to_str(t2 - t1)))
    print(concat("wvec_checksum     ", i64_to_str(s)))
    print(concat("dump_bytes        ", i64_to_str(bytes_len(dump))))
    // W2.10: същият свят, но компактиран образ — dump-ът е живите байтове,
    // без growth garbage. dump_compact е ЧЕТЕНЕ, затова работи и върху
    // замразен свят (w е замразен по-горе).
    print(concat("dump_compact_bytes", i64_to_str(bytes_len(world_dump_compact(w)))))
    print(concat("dump_us           ", i64_to_str(t4 - t3)))
    print(concat("load_us           ", i64_to_str(t5 - t4)))
    print(concat("load_last_val     ", i64_to_str(loaded)))
    print(concat("world_bump_delta  ", i64_to_str(mem_peak_bytes() - bump_before)))
    // W2.3: вътрешна променяемост — lazy кеш върху ВЕЧЕ ЗАМРАЗЕН свят. Всеки
    // достъп минава през mutex (неконкурентна цена); кешът е извън региона,
    // затова dump-ът горе не го носи.
    let c0 = monotonic_us()
    let mut k: i64 = 0
    while k < n {
        wcache_set(w, k, k * 2)
        k = k + 1
    }
    let c1 = monotonic_us()
    let mut cs: i64 = 0
    let mut m: i64 = 0
    while m < n {
        cs = cs + wcache_get(w, m)
        m = m + 1
    }
    let c2 = monotonic_us()
    print(concat("wcache_set_us     ", i64_to_str(c1 - c0)))
    print(concat("wcache_get_us     ", i64_to_str(c2 - c1)))
    print(concat("wcache_checksum   ", i64_to_str(cs)))
    print(concat("wcache_len        ", i64_to_str(wcache_len(w))))
    print(concat("cache_dump_bytes  ", i64_to_str(bytes_len(world_dump(w)))))
    // W2.9: wmap — ключ/стойност В региона (position-independent, за разлика от
    // кеша). Същият n: set-овете включват растеж и пре-хеш, get-овете са
    // сондиране през offset-и.
    let mw = world_new()
    let mm = wmap_new(mw)
    let m0 = monotonic_us()
    let mut a: i64 = 0
    while a < n {
        wmap_set(mw, mm, a, a * 3)
        a = a + 1
    }
    let m1 = monotonic_us()
    let mut ms: i64 = 0
    let mut b: i64 = 0
    while b < n {
        ms = ms + wmap_get(mw, mm, b)
        b = b + 1
    }
    let m2 = monotonic_us()
    print(concat("wmap_set_us       ", i64_to_str(m1 - m0)))
    print(concat("wmap_get_us       ", i64_to_str(m2 - m1)))
    print(concat("wmap_checksum     ", i64_to_str(ms)))
    print(concat("wmap_len          ", i64_to_str(wmap_len(mw, mm))))
    print(concat("wmap_dump_bytes   ", i64_to_str(bytes_len(world_dump(mw)))))
    // W2.10: компакция на живо — used преди/след и цената във време.
    let cbefore = world_used(mw)
    let k0 = monotonic_us()
    world_compact(mw)
    let k1 = monotonic_us()
    print(concat("wmap_used_before  ", i64_to_str(cbefore)))
    print(concat("wmap_used_after   ", i64_to_str(world_used(mw))))
    print(concat("wmap_compact_us   ", i64_to_str(k1 - k0)))
    print(concat("wmap_vals_intact  ", i64_to_str(wmap_get(mw, mm, 199999))))
    world_free(mw)
    world_free(w)
    world_free(w2)
    return 0
}

fn main() -> i64 !Time {
    let n: i64 = 200000
    print(concat("n                 ", i64_to_str(n)))
    bench_vec(n)
    bench_world(n)
    return 0
}
