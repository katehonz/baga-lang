// models/package.baga — reg_packages + reg_versions helpers.
// Table schema lives in apps/registry/schema.baga.

import "ormbaga/orm.baga"
import "ormbaga/sql.baga"
import "fmrbaga/jsonx.baga"
import "pgbaga/pg.baga"
import "std/str/str.baga"

fn reg_select_sql() -> str {
    return "SELECT id, name, description, latest_version, source_kind, source_url, created_at::text AS created_at FROM reg_packages"
}

fn reg_find_by_name(db: OrmDb, name: str) -> OrmQuery !IO !Net {
    let sql = concat(reg_select_sql(), " WHERE name = $1")
    let vals = vec_new()
    vec_push(vals, name)
    return orm_query_params_str(db, sql, vals)?
}

fn reg_all(db: OrmDb) -> OrmQuery !IO !Net {
    return orm_query(db, concat(reg_select_sql(), " ORDER BY name"))?
}

// ILIKE match in name or description; term arrives already wrapped in %.
fn reg_search(db: OrmDb, like: str) -> OrmQuery !IO !Net {
    let sql = concat(reg_select_sql(), " WHERE (name ILIKE $1 OR description ILIKE $1) ORDER BY name")
    let vals = vec_new()
    vec_push(vals, like)
    return orm_query_params_str(db, sql, vals)?
}

fn reg_create(db: OrmDb, name: str, description: str, source_kind: str, source_url: str) -> OrmExec !IO !Net {
    let cols = vec_new()
    vec_push(cols, "name")
    vec_push(cols, "description")
    vec_push(cols, "source_kind")
    vec_push(cols, "source_url")
    let vals = vec_new()
    vec_push(vals, name)
    vec_push(vals, description)
    vec_push(vals, source_kind)
    vec_push(vals, source_url)
    return orm_insert_strs(db, "reg_packages", cols, vals)?
}

fn reg_set_latest(db: OrmDb, id: i64, version: str) -> OrmExec !IO !Net {
    let cols = vec_new()
    vec_push(cols, "latest_version")
    let vals = vec_new()
    vec_push(vals, version)
    return orm_update_by_id(db, "reg_packages", id, cols, vals)?
}

fn reg_versions_by_package(db: OrmDb, package_id: i64) -> OrmQuery !IO !Net {
    let sql = "SELECT version, rev, subdir, published_at::text AS published_at FROM reg_versions WHERE package_id = $1 ORDER BY id"
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, package_id)
    return orm_query_params(db, sql, vals, nulls)?
}

// Unique (package_id, version) — the DB rejects duplicates (insert ok=0).
fn reg_version_insert(db: OrmDb, package_id: i64, version: str, rev: str, subdir: str) -> OrmExec !IO !Net {
    let sql = "INSERT INTO reg_versions (package_id, version, rev, subdir) VALUES ($1, $2, $3, $4)"
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, package_id)
    pg_param_str(vals, nulls, version)
    pg_param_str(vals, nulls, rev)
    pg_param_str(vals, nulls, subdir)
    return orm_exec_params(db, sql, vals, nulls)?
}

fn reg_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_str(o, "name", orm_cell_by(q, row, "name"))
    o = jobj_str(o, "latest_version", orm_cell_by(q, row, "latest_version"))
    let d = orm_cell_by(q, row, "description")
    if d != "" {
        o = jobj_str(o, "description", d)
    }
    o = jobj_str(o, "source_kind", orm_cell_by(q, row, "source_kind"))
    o = jobj_str(o, "source_url", orm_cell_by(q, row, "source_url"))
    let ca = orm_cell_by(q, row, "created_at")
    if ca != "" {
        o = jobj_str(o, "created_at", ca)
    }
    return o
}

fn reg_versions_jarr(q: OrmQuery) -> JArr {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < q.nrows {
        let mut v = jobj_new()
        v = jobj_str(v, "version", orm_cell_by(q, i, "version"))
        let r = orm_cell_by(q, i, "rev")
        if r != "" {
            v = jobj_str(v, "rev", r)
        }
        let s = orm_cell_by(q, i, "subdir")
        if s != "" {
            v = jobj_str(v, "subdir", s)
        }
        arr = jarr_obj(arr, v)
        i = i + 1
    }
    return arr
}

fn reg_list_json(q: OrmQuery) -> JObj {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < q.nrows {
        arr = jarr_obj(arr, reg_to_json(q, i))
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", q.nrows)
    return o
}
