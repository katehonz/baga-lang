// schema.baga — this product's migrations (owned by the app, not the framework).
// Postgres set uses SERIAL/FK; boila set is BoilaSQL-safe (explicit PK, no SERIAL).
// start.baga picks via api_migrations_auto() + ORM_BACKEND.

import "ormbaga/migrate.baga"
import "std/os/os.baga"

fn api_migrations() -> MigrationSet {
    let mut set = migrate_set_new()
    set = migrate_add(
        set,
        20260803001,
        "create_users",
        "CREATE TABLE users (id BIGSERIAL PRIMARY KEY, email TEXT NOT NULL UNIQUE, name TEXT NOT NULL, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW())",
        "DROP TABLE IF EXISTS users"
    )
    set = migrate_add(
        set,
        20260803002,
        "create_posts",
        "CREATE TABLE posts (id BIGSERIAL PRIMARY KEY, user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE, title TEXT NOT NULL, body TEXT NOT NULL DEFAULT '', created_at TIMESTAMPTZ NOT NULL DEFAULT NOW())",
        "DROP TABLE IF EXISTS posts"
    )
    set = migrate_add(
        set,
        20260803003,
        "index_posts_user_id",
        "CREATE INDEX index_posts_on_user_id ON posts (user_id)",
        "DROP INDEX IF EXISTS index_posts_on_user_id"
    )
    return set
}

// BoilaSQL: PRIMARY KEY required; no SERIAL/DEFAULT/NOT NULL/REFERENCES.
fn api_boila_migrations() -> MigrationSet {
    let mut set = migrate_set_new()
    set = migrate_add(
        set,
        20260811001,
        "create_users",
        "CREATE TABLE IF NOT EXISTS users (id BIGINT, email TEXT, name TEXT, created_at TIMESTAMPTZ, PRIMARY KEY (id))",
        "DROP TABLE IF EXISTS users"
    )
    set = migrate_add(
        set,
        20260811002,
        "create_posts",
        "CREATE TABLE IF NOT EXISTS posts (id BIGINT, user_id BIGINT, title TEXT, body TEXT, created_at TIMESTAMPTZ, PRIMARY KEY (id))",
        "DROP TABLE IF EXISTS posts"
    )
    set = migrate_add(
        set,
        20260811003,
        "index_posts_user_id",
        "CREATE INDEX index_posts_on_user_id ON posts (user_id)",
        "DROP INDEX IF EXISTS index_posts_on_user_id ON posts"
    )
    return set
}

fn api_backend_is_boila() -> i64 !IO {
    let be = env("ORM_BACKEND")?
    if be == "boila" || be == "boiladb" || be == "boilaDB" {
        return 1
    }
    return 0
}

// Pick migration set for the configured backend.
fn api_migrations_auto() -> MigrationSet !IO {
    if api_backend_is_boila()? == 1 {
        return api_boila_migrations()
    }
    return api_migrations()
}
