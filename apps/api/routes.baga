// routes.baga — route table + fmr_dispatch for this product.
// Embeds fmr_build_app / fmr_before / fmr_dispatch for the app binary.

import "actions/system.baga"
import "actions/auth.baga"
import "actions/users.baga"
import "actions/posts.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/deps.baga"
import "fmrbaga/config.baga"
import "ormbaga/orm.baga"

// Route ids (stable; never reorder casually — OpenAPI operationIds use them)
fn RID_HEALTH() -> i64 { return 1 }
fn RID_READY() -> i64 { return 2 }
fn RID_META() -> i64 { return 3 }
fn RID_OPENAPI() -> i64 { return 4 }
fn RID_METRICS() -> i64 { return 5 }
fn RID_TOKEN() -> i64 { return 10 }
fn RID_ME() -> i64 { return 11 }
fn RID_USERS_INDEX() -> i64 { return 20 }
fn RID_USERS_CREATE() -> i64 { return 21 }
fn RID_USERS_SHOW() -> i64 { return 22 }
fn RID_USERS_UPDATE() -> i64 { return 23 }
fn RID_USERS_DELETE() -> i64 { return 24 }
fn RID_POSTS_INDEX() -> i64 { return 30 }
fn RID_POSTS_CREATE() -> i64 { return 31 }
fn RID_POSTS_SHOW() -> i64 { return 32 }
fn RID_POSTS_UPDATE() -> i64 { return 33 }
fn RID_POSTS_DELETE() -> i64 { return 34 }

fn fmr_build_app() -> FmrApp !IO {
    let cfg = fmr_config_load()?
    let mut app = fmr_app_new(cfg.title, cfg.version)
    app = fmr_app_with_config(app, cfg)
    app = fmr_route(app, "GET", "/health", RID_HEALTH())
    app = fmr_route(app, "GET", "/ready", RID_READY())
    app = fmr_route(app, "GET", "/readyz", RID_READY())
    app = fmr_route(app, "GET", "/v1/meta", RID_META())
    app = fmr_route(app, "GET", "/openapi.json", RID_OPENAPI())
    app = fmr_route(app, "GET", "/metrics", RID_METRICS())
    app = fmr_route(app, "POST", "/v1/auth/token", RID_TOKEN())
    app = fmr_route(app, "GET", "/v1/me", RID_ME())
    app = fmr_route(app, "GET", "/v1/users", RID_USERS_INDEX())
    app = fmr_route(app, "POST", "/v1/users", RID_USERS_CREATE())
    app = fmr_route(app, "GET", "/v1/users/{id}", RID_USERS_SHOW())
    app = fmr_route(app, "PATCH", "/v1/users/{id}", RID_USERS_UPDATE())
    app = fmr_route(app, "DELETE", "/v1/users/{id}", RID_USERS_DELETE())
    app = fmr_route(app, "GET", "/v1/posts", RID_POSTS_INDEX())
    app = fmr_route(app, "POST", "/v1/posts", RID_POSTS_CREATE())
    app = fmr_route(app, "GET", "/v1/posts/{id}", RID_POSTS_SHOW())
    app = fmr_route(app, "PATCH", "/v1/posts/{id}", RID_POSTS_UPDATE())
    app = fmr_route(app, "DELETE", "/v1/posts/{id}", RID_POSTS_DELETE())
    return app
}

fn fmr_before(ctx: FmrCtx) -> DepResult {
    return dep_ok(ctx)
}

// B3: apps/api has no gRPC surface yet — dual hook returns empty unimplemented.
fn fmr_grpc_handle(path: str, body: bytes, db: OrmDb) -> FmrOut !IO !Net {
    let mut r = http_response_bytes(200, bytes_new(0))
    r = http_set_header(r, "Content-Type", "application/grpc")
    r = http_set_header(r, "grpc-status", "12")
    r = http_set_header(r, "grpc-message", "UNIMPLEMENTED")
    return fmr_out(r, db)
}

fn fmr_dispatch(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let id = ctx.route_id
    if id == RID_HEALTH() { return act_health(ctx, db) }
    if id == RID_READY() { return act_ready(ctx, db)? }
    if id == RID_META() { return act_meta(ctx, db)? }
    if id == RID_OPENAPI() { return act_openapi(ctx, db)? }
    if id == RID_METRICS() { return act_metrics(ctx, db) }
    if id == RID_TOKEN() { return act_token(ctx, db) }
    if id == RID_ME() { return act_me(ctx, db) }
    if id == RID_USERS_INDEX() { return act_users_index(ctx, db)? }
    if id == RID_USERS_CREATE() { return act_users_create(ctx, db)? }
    if id == RID_USERS_SHOW() { return act_users_show(ctx, db)? }
    if id == RID_USERS_UPDATE() { return act_users_update(ctx, db)? }
    if id == RID_USERS_DELETE() { return act_users_delete(ctx, db)? }
    if id == RID_POSTS_INDEX() { return act_posts_index(ctx, db)? }
    if id == RID_POSTS_CREATE() { return act_posts_create(ctx, db)? }
    if id == RID_POSTS_SHOW() { return act_posts_show(ctx, db)? }
    if id == RID_POSTS_UPDATE() { return act_posts_update(ctx, db)? }
    if id == RID_POSTS_DELETE() { return act_posts_delete(ctx, db)? }
    return fmr_out(fmr_500("unhandled route"), db)
}
