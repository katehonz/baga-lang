// h2.baga — HTTP/2 (h2c, RFC 7540) server-side connection handler.
// Binary framing over std/net tcp_*_bytes, HPACK via hpack.baga, streams
// with multiplexing, SETTINGS/WINDOW_UPDATE/PING/GOAWAY/RST_STREAM.
//
// Link-time contract: the embedding program defines
//     fn h2_route(req: Request) -> Response
// which h2_serve calls for every completed request (no closures/function
// values in Baga, so dispatch is inverted by naming convention).
// tests/h2_test.baga and server.baga each provide their own h2_route.
//
// Honesty limits (documented, not defended): server push is off
// (ENABLE_PUSH 0), PRIORITY frames are parsed and ignored, PADDED frames
// are unpadded, response flow control is accounted but never blocks (demo
// responses are small; exceeding the peer window sends GOAWAY FLOW_CTRL),
// request bodies are pooled with append-only copies (O(n^2) under many
// DATA frames — fine at demo scale).

import "http.baga"
import "hpack.baga"
import "std/bytes/bytes.baga"

// ---------- frame constants ----------

fn H2_DATA() -> i64 { return 0 }
fn H2_HEADERS() -> i64 { return 1 }
fn H2_PRIORITY() -> i64 { return 2 }
fn H2_RST_STREAM() -> i64 { return 3 }
fn H2_SETTINGS() -> i64 { return 4 }
fn H2_PUSH_PROMISE() -> i64 { return 5 }
fn H2_PING() -> i64 { return 6 }
fn H2_GOAWAY() -> i64 { return 7 }
fn H2_WINDOW_UPDATE() -> i64 { return 8 }
fn H2_CONTINUATION() -> i64 { return 9 }

fn H2_F_END_STREAM() -> i64 { return 1 }
fn H2_F_ACK() -> i64 { return 1 }
fn H2_F_END_HEADERS() -> i64 { return 4 }
fn H2_F_PADDED() -> i64 { return 8 }
fn H2_F_PRIORITY() -> i64 { return 32 }

fn H2_ERR_NO() -> i64 { return 0 }
fn H2_ERR_PROTOCOL() -> i64 { return 1 }
fn H2_ERR_FLOW() -> i64 { return 3 }
fn H2_ERR_FRAME_SIZE() -> i64 { return 6 }

fn h2_preface() -> bytes {
    return bytes_of_str("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n")
}

// ---------- byte helpers (big-endian) ----------

fn h2_one(v: i64) -> bytes {
    let v2 = vec_new()
    vec_push(v2, v & 255)
    return bytes_from_vec(v2)
}

fn h2_be16(v: i64) -> bytes {
    let v2 = vec_new()
    vec_push(v2, (v >> 8) & 255)
    vec_push(v2, v & 255)
    return bytes_from_vec(v2)
}

fn h2_be32(v: i64) -> bytes {
    let v2 = vec_new()
    vec_push(v2, (v >> 24) & 255)
    vec_push(v2, (v >> 16) & 255)
    vec_push(v2, (v >> 8) & 255)
    vec_push(v2, v & 255)
    return bytes_from_vec(v2)
}

fn h2_be_read(b: bytes, off: i64, n: i64) -> i64 {
    let mut v: i64 = 0
    let mut i: i64 = 0
    while i < n {
        v = v * 256 + bytes_at(b, off + i)
        i = i + 1
    }
    return v
}

// ---------- frames ----------

struct H2Frame {
    typ: i64,
    flags: i64,
    sid: i64,
    payload: bytes
}

struct H2FrameRead {
    reader: HttpReader,
    frame: H2Frame,
    err: i64
}

fn h2_read_frame(r: HttpReader) -> H2FrameRead !IO !Net {
    let hd = hr_read_n(r, 9)?
    if bytes_len(hd.body) < 9 {
        return H2FrameRead { reader: hd.reader, frame: H2Frame { typ: 0, flags: 0, sid: 0, payload: hpack_empty_bytes() }, err: 1 }
    }
    let length = h2_be_read(hd.body, 0, 3)
    let typ = bytes_at(hd.body, 3)
    let flags = bytes_at(hd.body, 4)
    let sid = h2_be_read(hd.body, 5, 4) & 2147483647
    if length > 1048576 {
        return H2FrameRead { reader: hd.reader, frame: H2Frame { typ: 0, flags: 0, sid: 0, payload: hpack_empty_bytes() }, err: 1 }
    }
    let mut payload = hpack_empty_bytes()
    if length > 0 {
        let pl = hr_read_n(hd.reader, length)?
        if bytes_len(pl.body) < length {
            return H2FrameRead { reader: pl.reader, frame: H2Frame { typ: 0, flags: 0, sid: 0, payload: hpack_empty_bytes() }, err: 1 }
        }
        payload = pl.body
        return H2FrameRead { reader: pl.reader, frame: H2Frame { typ: typ, flags: flags, sid: sid, payload: payload }, err: 0 }
    }
    return H2FrameRead { reader: hd.reader, frame: H2Frame { typ: typ, flags: flags, sid: sid, payload: payload }, err: 0 }
}

fn h2_write_frame(fd: i64, typ: i64, flags: i64, sid: i64, payload: bytes) -> i64 !IO !Net {
    let n = bytes_len(payload)
    let mut hdr = hpack_empty_bytes()
    hdr = bytes_concat(hdr, h2_one((n >> 16) & 255))
    hdr = bytes_concat(hdr, h2_one((n >> 8) & 255))
    hdr = bytes_concat(hdr, h2_one(n & 255))
    hdr = bytes_concat(hdr, h2_one(typ))
    hdr = bytes_concat(hdr, h2_one(flags))
    hdr = bytes_concat(hdr, h2_be32(sid & 2147483647))
    return tcp_write_bytes(fd, bytes_concat(hdr, payload))?
}

fn h2_goaway(fd: i64, last_sid: i64, err_code: i64) -> i64 !IO !Net {
    return h2_write_frame(fd, H2_GOAWAY(), 0, 0, bytes_concat(h2_be32(last_sid), h2_be32(err_code)))?
}

// ---------- connection state ----------

struct H2Conn {
    fd: i64,
    reader: HttpReader,
    hp: HpackCtx,
    s_ids: Vec<i64>,
    s_kseg: Vec<str>,
    s_vseg: Vec<str>,
    s_body_off: Vec<i64>,
    s_body_len: Vec<i64>,
    s_state: Vec<i64>,
    body_pool: bytes,
    last_sid: i64,
    conn_window: i64,
    peer_max_frame: i64,
    closed: i64
}

fn h2_conn_new(fd: i64, reader: HttpReader) -> H2Conn {
    return H2Conn {
        fd: fd,
        reader: reader,
        hp: hpack_ctx(4096),
        s_ids: vec_new(),
        s_kseg: vec_new(),
        s_vseg: vec_new(),
        s_body_off: vec_new(),
        s_body_len: vec_new(),
        s_state: vec_new(),
        body_pool: hpack_empty_bytes(),
        last_sid: 0,
        conn_window: 65535,
        peer_max_frame: 16384,
        closed: 0
    }
}

fn h2_find(c: H2Conn, sid: i64) -> i64 {
    for i in 0..vec_len(c.s_ids) {
        if vec_get(c.s_ids, i) == sid {
            return i
        }
    }
    return 0 - 1
}

// ---------- SETTINGS ----------

fn h2_send_settings(fd: i64) -> i64 !IO !Net {
    let mut p = hpack_empty_bytes()
    // HEADER_TABLE_SIZE 4096, ENABLE_PUSH 0, MAX_CONCURRENT_STREAMS 100,
    // INITIAL_WINDOW_SIZE 65535, MAX_FRAME_SIZE 16384
    p = bytes_concat(p, bytes_concat(h2_be16(1), h2_be32(4096)))
    p = bytes_concat(p, bytes_concat(h2_be16(2), h2_be32(0)))
    p = bytes_concat(p, bytes_concat(h2_be16(3), h2_be32(100)))
    p = bytes_concat(p, bytes_concat(h2_be16(4), h2_be32(65535)))
    p = bytes_concat(p, bytes_concat(h2_be16(5), h2_be32(16384)))
    return h2_write_frame(fd, H2_SETTINGS(), 0, 0, p)?
}

fn h2_apply_settings(c: H2Conn, payload: bytes) -> H2Conn {
    let mut cur = c
    let n = bytes_len(payload)
    let mut off: i64 = 0
    while off + 6 <= n {
        let id = h2_be_read(payload, off, 2)
        let val = h2_be_read(payload, off + 2, 4)
        if id == 5 {
            if val >= 16384 {
                cur.peer_max_frame = val
            }
        }
        off = off + 6
    }
    return cur
}

// ---------- header block assembly ----------

// Strip PADDED (1 pad-length byte + trailing padding) and PRIORITY
// (5 bytes after the pad field) from a HEADERS payload.
fn h2_unpad_headers(payload: bytes, flags: i64) -> bytes {
    let mut start: i64 = 0
    let mut endc = bytes_len(payload)
    let mut pad: i64 = 0
    if (flags & H2_F_PADDED()) == H2_F_PADDED() {
        if endc < 1 {
            return hpack_empty_bytes()
        }
        pad = bytes_at(payload, 0)
        start = 1
    }
    if (flags & H2_F_PRIORITY()) == H2_F_PRIORITY() {
        start = start + 5
    }
    endc = endc - pad
    if endc <= start {
        return hpack_empty_bytes()
    }
    return bytes_slice(payload, start, endc)
}

// ---------- request completion ----------

fn h2_request_of(c: H2Conn, idx: i64) -> Request {
    let kseg = vec_get(c.s_kseg, idx)
    let vseg = vec_get(c.s_vseg, idx)
    let knames = str_split(kseg, "\n")
    let kvals = str_split(vseg, "\n")
    let ks = vec_new()
    let vs = vec_new()
    let mut method = ""
    let mut path = ""
    let mut authority = ""
    for i in 0..vec_len(knames) {
        let name = vec_get(knames, i)
        let value = vec_get(kvals, i)
        if name == ":method" {
            method = value
        } else {
            if name == ":path" {
                path = value
            } else {
                if name == ":authority" {
                    authority = value
                } else {
                    if name == ":scheme" {
                        vec_push(ks, "X-H2-Scheme")
                        vec_push(vs, value)
                    } else {
                        vec_push(ks, name)
                        vec_push(vs, value)
                    }
                }
            }
        }
    }
    if authority != "" {
        vec_push(ks, "Host")
        vec_push(vs, authority)
    }
    let off = vec_get(c.s_body_off, idx)
    let ln = vec_get(c.s_body_len, idx)
    let bb = bytes_slice(c.body_pool, off, off + ln)
    return Request { method: method, path: path, version: "HTTP/2.0", hkeys: ks, hvals: vs, body: str_of_bytes(bb), body_bytes: bb }
}

// Respond on a stream: HEADERS (+CONTINUATION) then DATA; optional trailer
// HEADERS with END_STREAM (gRPC). Binary body_bytes preferred over body str.
fn h2_respond(c: H2Conn, sid: i64, resp: Response) -> H2Conn !IO !Net {
    let mut cur = c
    let body_b = http_body_as_bytes(resp)
    let body_n = bytes_len(body_b)
    let has_trail = vec_len(resp.trail_ks) > 0
    let ks = vec_new()
    let vs = vec_new()
    vec_push(ks, ":status")
    vec_push(vs, int_to_str(resp.status))
    for i in 0..vec_len(resp.hkeys) {
        // RFC 7540 §8.1.2: field names MUST be lowercase; clients (nghttp2)
        // reject uppercase with PROTOCOL_ERROR
        vec_push(ks, to_lower(vec_get(resp.hkeys, i)))
        vec_push(vs, vec_get(resp.hvals, i))
    }
    vec_push(ks, "content-length")
    vec_push(vs, int_to_str(body_n))
    let block = hpack_encode(ks, vs)
    let maxf = cur.peer_max_frame
    let bn = bytes_len(block)
    if bn <= maxf {
        let mut fl = H2_F_END_HEADERS()
        if body_n == 0 && has_trail == false {
            fl = fl + H2_F_END_STREAM()
        }
        h2_write_frame(cur.fd, H2_HEADERS(), fl, sid, block)?
    } else {
        let mut off: i64 = 0
        let mut first = true
        while off < bn {
            let mut take = maxf
            if take > bn - off {
                take = bn - off
            }
            let frag = bytes_slice(block, off, off + take)
            let last = off + take >= bn
            if first {
                let mut fl = 0
                if last {
                    fl = H2_F_END_HEADERS()
                    if body_n == 0 && has_trail == false {
                        fl = fl + H2_F_END_STREAM()
                    }
                }
                h2_write_frame(cur.fd, H2_HEADERS(), fl, sid, frag)?
                first = false
            } else {
                let mut fl = 0
                if last {
                    fl = H2_F_END_HEADERS()
                    if body_n == 0 && has_trail == false {
                        fl = fl + H2_F_END_STREAM()
                    }
                }
                h2_write_frame(cur.fd, H2_CONTINUATION(), fl, sid, frag)?
            }
            off = off + take
        }
    }
    if body_n > 0 {
        if body_n > cur.conn_window {
            h2_goaway(cur.fd, cur.last_sid, H2_ERR_FLOW())?
            cur.closed = 1
            return cur
        }
        let mut off: i64 = 0
        while off < body_n {
            let mut take = maxf
            if take > body_n - off {
                take = body_n - off
            }
            let frag = bytes_slice(body_b, off, off + take)
            let mut fl = 0
            // END_STREAM on last DATA only when there are no trailers
            if off + take >= body_n && has_trail == false {
                fl = H2_F_END_STREAM()
            }
            h2_write_frame(cur.fd, H2_DATA(), fl, sid, frag)?
            off = off + take
        }
        cur.conn_window = cur.conn_window - body_n
    }
    // Trailers: HEADERS with END_HEADERS | END_STREAM (RFC 7540 §8.1)
    if has_trail {
        let tks = vec_new()
        let tvs = vec_new()
        for i in 0..vec_len(resp.trail_ks) {
            vec_push(tks, to_lower(vec_get(resp.trail_ks, i)))
            vec_push(tvs, vec_get(resp.trail_vs, i))
        }
        let tblock = hpack_encode(tks, tvs)
        let tfl = H2_F_END_HEADERS() + H2_F_END_STREAM()
        h2_write_frame(cur.fd, H2_HEADERS(), tfl, sid, tblock)?
    }
    return cur
}

// ---------- the connection loop ----------

fn h2_serve(fd: i64, reader: HttpReader) -> i64 !IO !Net {
    let pre = hr_read_n(reader, 24)?
    if bytes_len(pre.body) < 24 {
        tcp_close(fd)?
        return 0 - 1
    }
    if !bytes_eq_b(pre.body, h2_preface()) {
        tcp_close(fd)?
        return 0 - 1
    }
    let mut c = h2_conn_new(fd, pre.reader)
    h2_send_settings(fd)?
    let mut pend_sid: i64 = 0
    let mut pend_block = hpack_empty_bytes()
    let mut pend_end_stream: i64 = 0
    let mut pend_open: i64 = 0
    while c.closed == 0 {
        let fr = h2_read_frame(c.reader)?
        c.reader = fr.reader
        if fr.err != 0 {
            c.closed = 1
        } else {
            let f = fr.frame
            if f.typ == H2_SETTINGS() {
                if (f.flags & H2_F_ACK()) == 0 {
                    c = h2_apply_settings(c, f.payload)
                    h2_write_frame(fd, H2_SETTINGS(), H2_F_ACK(), 0, hpack_empty_bytes())?
                }
            } else {
                if f.typ == H2_HEADERS() {
                    if pend_open == 1 {
                        h2_goaway(fd, c.last_sid, H2_ERR_PROTOCOL())?
                        c.closed = 1
                    } else {
                        if f.sid % 2 == 0 || f.sid <= c.last_sid {
                            h2_goaway(fd, c.last_sid, H2_ERR_PROTOCOL())?
                            c.closed = 1
                        } else {
                            c.last_sid = f.sid
                            pend_sid = f.sid
                            pend_block = h2_unpad_headers(f.payload, f.flags)
                            if (f.flags & H2_F_END_STREAM()) == H2_F_END_STREAM() {
                                pend_end_stream = 1
                            } else {
                                pend_end_stream = 0
                            }
                            if (f.flags & H2_F_END_HEADERS()) == H2_F_END_HEADERS() {
                                let fin = h2_finish_headers(c, pend_sid, pend_block, pend_end_stream)?
                                c = fin.conn
                                if fin.err != 0 {
                                    c.closed = 1
                                }
                                pend_open = 0
                            } else {
                                pend_open = 1
                            }
                        }
                    }
                } else {
                    if f.typ == H2_CONTINUATION() {
                        if pend_open == 0 || f.sid != pend_sid {
                            h2_goaway(fd, c.last_sid, H2_ERR_PROTOCOL())?
                            c.closed = 1
                        } else {
                            pend_block = bytes_concat(pend_block, f.payload)
                            if (f.flags & H2_F_END_HEADERS()) == H2_F_END_HEADERS() {
                                let fin = h2_finish_headers(c, pend_sid, pend_block, pend_end_stream)?
                                c = fin.conn
                                if fin.err != 0 {
                                    c.closed = 1
                                }
                                pend_open = 0
                            }
                        }
                    } else {
                        if f.typ == H2_DATA() {
                            let idx = h2_find(c, f.sid)
                            if idx < 0 {
                                h2_write_frame(fd, H2_RST_STREAM(), 0, f.sid, h2_be32(H2_ERR_PROTOCOL()))?
                            } else {
                                let mut payload = f.payload
                                if (f.flags & H2_F_PADDED()) == H2_F_PADDED() {
                                    let pad = bytes_at(payload, 0)
                                    if bytes_len(payload) > 1 + pad {
                                        payload = bytes_slice(payload, 1, bytes_len(payload) - pad)
                                    } else {
                                        payload = hpack_empty_bytes()
                                    }
                                }
                                let pl = bytes_len(payload)
                                if pl > 0 {
                                    if vec_get(c.s_body_len, idx) == 0 {
                                        vec_set(c.s_body_off, idx, bytes_len(c.body_pool))
                                    }
                                    vec_set(c.s_body_len, idx, vec_get(c.s_body_len, idx) + pl)
                                    c.body_pool = bytes_concat(c.body_pool, payload)
                                    // replenish both windows so uploads keep flowing
                                    h2_write_frame(fd, H2_WINDOW_UPDATE(), 0, 0, h2_be32(pl))?
                                    h2_write_frame(fd, H2_WINDOW_UPDATE(), 0, f.sid, h2_be32(pl))?
                                }
                                if (f.flags & H2_F_END_STREAM()) == H2_F_END_STREAM() {
                                    let fin = h2_dispatch(c, idx)?
                                    c = fin.conn
                                    if fin.err != 0 {
                                        c.closed = 1
                                    }
                                }
                            }
                        } else {
                            if f.typ == H2_WINDOW_UPDATE() {
                                if f.sid == 0 {
                                    c.conn_window = c.conn_window + (h2_be_read(f.payload, 0, 4) & 2147483647)
                                }
                            } else {
                                if f.typ == H2_PING() {
                                    if (f.flags & H2_F_ACK()) == 0 {
                                        h2_write_frame(fd, H2_PING(), H2_F_ACK(), 0, f.payload)?
                                    }
                                } else {
                                    if f.typ == H2_GOAWAY() {
                                        c.closed = 1
                                    } else {
                                        if f.typ == H2_RST_STREAM() {
                                            let idx = h2_find(c, f.sid)
                                            if idx >= 0 {
                                                vec_set(c.s_state, idx, 1)
                                            }
                                        }
                                        // PRIORITY (and anything unknown at stream
                                        // level) is ignored; PUSH_PROMISE on a
                                        // server is a protocol error
                                        if f.typ == H2_PUSH_PROMISE() {
                                            h2_goaway(fd, c.last_sid, H2_ERR_PROTOCOL())?
                                            c.closed = 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    h2_goaway(fd, c.last_sid, H2_ERR_NO())?
    tcp_close(fd)?
    return 0
}

struct H2Step {
    conn: H2Conn,
    err: i64
}

// Decode a completed header block, park name/value segments per stream,
// and dispatch immediately when the request had no body.
fn h2_finish_headers(c: H2Conn, sid: i64, block: bytes, end_stream: i64) -> H2Step !IO !Net {
    let mut cur = c
    let dec = hpack_decode(cur.hp, block)
    if dec.err != 0 {
        h2_goaway(cur.fd, cur.last_sid, H2_ERR_PROTOCOL())?
        return H2Step { conn: cur, err: 1 }
    }
    cur.hp = dec.ctx
    let mut kseg = ""
    let mut vseg = ""
    for i in 0..vec_len(dec.ks) {
        if i > 0 {
            kseg = concat(kseg, "\n")
            vseg = concat(vseg, "\n")
        }
        kseg = concat(kseg, vec_get(dec.ks, i))
        vseg = concat(vseg, vec_get(dec.vs, i))
    }
    vec_push(cur.s_ids, sid)
    vec_push(cur.s_kseg, kseg)
    vec_push(cur.s_vseg, vseg)
    vec_push(cur.s_body_off, bytes_len(cur.body_pool))
    vec_push(cur.s_body_len, 0)
    vec_push(cur.s_state, 0)
    if end_stream == 1 {
        let idx = vec_len(cur.s_ids) - 1
        let fin = h2_dispatch(cur, idx)?
        return H2Step { conn: fin.conn, err: fin.err }
    }
    return H2Step { conn: cur, err: 0 }
}

fn h2_dispatch(c: H2Conn, idx: i64) -> H2Step !IO !Net {
    let mut cur = c
    if vec_get(cur.s_state, idx) == 1 {
        return H2Step { conn: cur, err: 0 }
    }
    vec_set(cur.s_state, idx, 1)
    let sid = vec_get(cur.s_ids, idx)
    let req = h2_request_of(cur, idx)
    let resp = h2_route(req)
    let done = h2_respond(cur, sid, resp)?
    cur = done
    return H2Step { conn: cur, err: cur.closed }
}
