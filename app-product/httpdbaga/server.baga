// server.baga — multi-protocol HTTP server demo built on http.baga + h2.baga.
//
// One listener, two protocols: the first bytes of each connection decide —
// "PRI" (the HTTP/2 preface) routes to the h2 frame loop, anything else to
// the HTTP/1.1 keep-alive loop. Run:
//
//   PORT=8080 ./baga app-product/httpdbaga/server.baga        (or --emit-c)
//   MODE=threads|pool|sync   (default threads)
//   POOL_N=<workers>         (pool mode, default 8)
//   BAGA_SYNC=1              (back-compat alias for MODE=sync)
//
// Modes:
//   threads — go_bg OS thread per connection (classic accept loop)
//   pool    — bounded pool: POOL_N workers pull fds off a channel; a
//             keep-alive connection holds its worker until it closes
//   sync    — one connection at a time
//
// Routes (same handler serves both protocols):
//   GET  /health -> 200 {"status":"ok"}
//   GET  /       -> 200 JSON echo of {method, path, proto}
//   GET  /hello?name=X -> 200 {"hello":"X"}
//   GET  /proto  -> 200 {"proto":"HTTP/1.1"|"HTTP/2.0"}
//   POST /echo   -> 200 JSON echo of the request body
//   *            -> 404 {"error":"not found"}

import "http.baga"
import "h2.baga"
import "../../std/os/os.baga"

// ---------- routing (shared by both protocols) ----------

fn handle(req: Request) -> Response {
    let method = http_method(req)
    let path = http_path_only(req)
    if method == "GET" && path == "/health" {
        return http_json_response(200, "{\"status\":\"ok\"}")
    }
    if method == "GET" && path == "/" {
        let mut body = "{\"method\":\""
        body = concat(body, method)
        body = concat(body, "\",\"path\":\"")
        body = concat(body, path)
        body = concat(body, "\",\"proto\":\"")
        body = concat(body, req.version)
        body = concat(body, "\"}")
        return http_json_response(200, body)
    }
    if method == "GET" && path == "/hello" {
        let mut name = http_query_param(req, "name")
        if name == "" {
            name = "bagatur"
        }
        let body = concat(concat("{\"hello\":\"", name), "\"}")
        return http_json_response(200, body)
    }
    if method == "GET" && path == "/proto" {
        let body = concat("{\"proto\":\"", concat(req.version, "\"}"))
        return http_json_response(200, body)
    }
    if method == "POST" && path == "/echo" {
        return http_json_response(200, http_body(req))
    }
    return http_json_response(404, "{\"error\":\"not found\"}")
}

// h2.baga's link-time dispatch convention.
fn h2_route(req: Request) -> Response {
    return handle(req)
}

// ---------- per-connection serving ----------

struct ConnPeek {
    reader: HttpReader,
    is_h2: i64
}

// Buffer one chunk and classify without consuming: "PRI" -> HTTP/2 prior
// knowledge; the same buffered reader is handed to whichever loop runs,
// so no byte is read twice.
fn conn_peek(fd: i64) -> ConnPeek !IO !Net {
    let chunk = tcp_read_bytes(fd, 8192)?
    let r = HttpReader { fd: fd, buf: chunk, pos: 0 }
    let mut is_h2: i64 = 0
    if bytes_len(chunk) >= 3 {
        if bytes_at(chunk, 0) == 80 && bytes_at(chunk, 1) == 82 && bytes_at(chunk, 2) == 73 {
            is_h2 = 1
        }
    }
    return ConnPeek { reader: r, is_h2: is_h2 }
}

// HTTP/1.1 keep-alive loop over a (possibly pre-filled) reader.
// close_mode=1 (pool) forces Connection: close — a bounded worker pool and
// persistent connections deadlock under load (idle keep-alive conns pin all
// workers while new conns queue in the channel).
fn h1_conn(fd: i64, r0: HttpReader, close_mode: i64) -> i64 !IO !Net {
    let mut r = r0
    let mut keep = true
    while keep {
        let out = http_read_request_r(r)?
        r = out.reader
        if out.err != 0 {
            http_respond_keepalive(fd, http_json_response(out.err, "{\"error\":\"bad request\"}"), 0)?
            keep = false
        } else {
            if http_method(out.req) == "" {
                keep = false
            } else {
                let mut ka = http_keepalive(out.req)
                if close_mode == 1 {
                    ka = 0
                }
                let resp = handle(out.req)
                http_respond_keepalive(fd, resp, ka)?
                if ka == 0 {
                    keep = false
                }
            }
        }
    }
    tcp_close(fd)?
    return 0
}

fn serve_conn(fd: i64, close_mode: i64) -> i64 !IO !Net {
    let pk = conn_peek(fd)?
    if bytes_len(pk.reader.buf) == 0 {
        tcp_close(fd)?
        return 0
    }
    if pk.is_h2 == 1 {
        return h2_serve(fd, pk.reader)?
    }
    return h1_conn(fd, pk.reader, close_mode)?
}

// go_bg / pool worker entry points (fn(i64) -> i64).
fn serve_conn_bg(fd: i64) -> i64 !IO !Net {
    return serve_conn(fd, 0)?
}

// arg = cell2(chan, close_mode)
fn pool_worker(ctx: i64) -> i64 !IO !Net !Par {
    let ch = cell2_0(ctx)
    let close_mode = cell2_1(ctx)
    let mut running = true
    while running {
        let p = chan_recv2(ch)
        if cell2_0(p) == 0 {
            running = false
        } else {
            serve_conn(cell2_1(p), close_mode)?
        }
    }
    return 0
}

// ---------- main ----------

fn main() -> i64 !Net !IO !Par {
    let mut port: i64 = 8080
    if env("PORT") != "" {
        port = parse_int(env("PORT"))
    }
    let mut mode = env("MODE")
    if env("BAGA_SYNC") == "1" {
        mode = "sync"
    }
    if mode == "" {
        mode = "threads"
    }
    let mut pool_n: i64 = 8
    if env("POOL_N") != "" {
        pool_n = parse_int(env("POOL_N"))
    }
    let listener = tcp_listen(port)?
    print(concat(concat(concat("httpdbaga listening on :", int_to_str(port)), " (mode="), concat(mode, "; HTTP/1.1 keep-alive + HTTP/2 h2c)")))
    if mode == "sync" {
        while true {
            let fd = tcp_accept(listener)?
            serve_conn(fd, 0)?
        }
    } else {
        if mode == "pool" {
            let ch = chan_new(64)
            for i in 0..pool_n {
                go_bg(pool_worker, cell2(ch, 1))
            }
            while true {
                let fd = tcp_accept(listener)?
                chan_send(ch, fd)?
            }
        } else {
            while true {
                let fd = tcp_accept(listener)?
                go_bg(serve_conn_bg, fd)
            }
        }
    }
    return 0
}
