// sql.baga — pure SQL quoting / building helpers for ormbaga.
// Modelled on ActiveRecord connection quoting + database/sql hygiene.
// Required while pgbaga speaks Simple Query only (no $1 bind yet).

import "std/str/str.baga"

// Escape a string literal for PostgreSQL: wrap in '...' and double internal quotes.
fn sql_lit(s: str) -> str {
    let mut out = "'"
    for i in 0..len(s) {
        let c = char_at(s, i)
        if c == 39 {   // '
            out = concat(out, "''")
        } else {
            out = concat(out, chr(c))
        }
    }
    return concat(out, "'")
}

// NULL literal (for optional values).
fn sql_null() -> str {
    return "NULL"
}

// Quote an identifier: "name" with internal " doubled.
// Rejects empty names (returns empty string — callers should check).
fn sql_ident(name: str) -> str {
    if len(name) == 0 {
        return ""
    }
    let mut out = "\""
    for i in 0..len(name) {
        let c = char_at(name, i)
        if c == 34 {   // "
            out = concat(out, "\"\"")
        } else {
            out = concat(out, chr(c))
        }
    }
    return concat(out, "\"")
}

// table.column
fn sql_qual(table: str, col: str) -> str {
    return concat(concat(sql_ident(table), "."), sql_ident(col))
}

// Join quoted identifiers with ", ".
fn sql_ident_list(names: Vec<str>) -> str {
    let mut out = ""
    for i in 0..vec_len(names) {
        if i > 0 {
            out = concat(out, ", ")
        }
        out = concat(out, sql_ident(vec_get(names, i)))
    }
    return out
}

// Join already-built SQL fragments with ", " (literals or expressions).
fn sql_join(parts: Vec<str>, sep: str) -> str {
    let mut out = ""
    for i in 0..vec_len(parts) {
        if i > 0 {
            out = concat(out, sep)
        }
        out = concat(out, vec_get(parts, i))
    }
    return out
}

// Build VALUES (lit1, lit2, ...) from a list of already-quoted pieces.
fn sql_values_row(lits: Vec<str>) -> str {
    return concat(concat("(", sql_join(lits, ", ")), ")")
}

// i64 as SQL integer literal (no quotes).
fn sql_i64(n: i64) -> str {
    if n == 0 {
        return "0"
    }
    let mut v = n
    let mut neg: i64 = 0
    if v < 0 {
        neg = 1
        v = 0 - v
    }
    let mut out = ""
    while v > 0 {
        let d = v % 10
        out = concat(chr(48 + d), out)
        v = v / 10
    }
    if neg == 1 {
        out = concat("-", out)
    }
    return out
}

// bool as TRUE/FALSE.
fn sql_bool(b: i64) -> str {
    if b == 0 {
        return "FALSE"
    }
    return "TRUE"
}

// SELECT * FROM "t"
fn sql_select_all(table: str) -> str {
    return concat("SELECT * FROM ", sql_ident(table))
}

// SELECT * FROM "t" WHERE "col" = lit
fn sql_select_where_eq(table: str, col: str, lit: str) -> str {
    return concat(
        concat(concat(concat(sql_select_all(table), " WHERE "), sql_ident(col)), " = "),
        lit
    )
}

// SELECT COUNT(*)::bigint AS count FROM "t"
fn sql_count(table: str) -> str {
    return concat("SELECT COUNT(*)::bigint AS count FROM ", sql_ident(table))
}

// INSERT INTO "t" ("c1","c2") VALUES (...)
fn sql_insert(table: str, cols: Vec<str>, lits: Vec<str>) -> str {
    return concat(
        concat(
            concat(
                concat(concat("INSERT INTO ", sql_ident(table)), " ("),
                sql_ident_list(cols)
            ),
            ") VALUES "
        ),
        sql_values_row(lits)
    )
}

// UPDATE "t" SET "c1"=l1, "c2"=l2 WHERE "wcol"=wlit
fn sql_update_eq(table: str, set_cols: Vec<str>, set_lits: Vec<str>, where_col: str, where_lit: str) -> str {
    let mut sets = ""
    let n = vec_len(set_cols)
    let mut i: i64 = 0
    while i < n {
        if i > 0 {
            sets = concat(sets, ", ")
        }
        sets = concat(concat(sql_ident(vec_get(set_cols, i)), " = "), vec_get(set_lits, i))
        i = i + 1
    }
    return concat(
        concat(
            concat(
                concat(concat(concat("UPDATE ", sql_ident(table)), " SET "), sets),
                " WHERE "
            ),
            sql_ident(where_col)
        ),
        concat(" = ", where_lit)
    )
}

// DELETE FROM "t" WHERE "col" = lit
fn sql_delete_eq(table: str, col: str, lit: str) -> str {
    return concat(
        concat(
            concat(concat("DELETE FROM ", sql_ident(table)), " WHERE "),
            sql_ident(col)
        ),
        concat(" = ", lit)
    )
}

// ORDER BY "col" ASC|DESC
fn sql_order(sql: str, col: str, desc: i64) -> str {
    let mut dir = " ASC"
    if desc != 0 {
        dir = " DESC"
    }
    return concat(concat(concat(sql, " ORDER BY "), sql_ident(col)), dir)
}

// LIMIT n
fn sql_limit(sql: str, n: i64) -> str {
    return concat(concat(sql, " LIMIT "), sql_i64(n))
}

// ---------- parameterized SQL (Extended Query $1..$n) ----------
// Identifiers still quoted; values are placeholders only.

// SELECT * FROM "t" WHERE "col" = $1
fn sql_select_where_eq_p(table: str, col: str) -> str {
    return concat(
        concat(concat(sql_select_all(table), " WHERE "), sql_ident(col)),
        " = $1"
    )
}

// INSERT INTO "t" ("c1","c2") VALUES ($1,$2)
fn sql_insert_p(table: str, cols: Vec<str>) -> str {
    let mut ph = ""
    for i in 0..vec_len(cols) {
        if i > 0 {
            ph = concat(ph, ", ")
        }
        ph = concat(ph, concat("$", sql_i64(i + 1)))
    }
    return concat(
        concat(
            concat(concat(concat("INSERT INTO ", sql_ident(table)), " ("), sql_ident_list(cols)),
            ") VALUES ("
        ),
        concat(ph, ")")
    )
}

// UPDATE "t" SET "c1"=$1, "c2"=$2 WHERE "wcol"=$3
fn sql_update_eq_p(table: str, set_cols: Vec<str>, where_col: str) -> str {
    let mut sets = ""
    let n = vec_len(set_cols)
    let mut i: i64 = 0
    while i < n {
        if i > 0 {
            sets = concat(sets, ", ")
        }
        sets = concat(concat(sql_ident(vec_get(set_cols, i)), " = $"), sql_i64(i + 1))
        i = i + 1
    }
    let wph = concat("$", sql_i64(n + 1))
    return concat(
        concat(
            concat(concat(concat("UPDATE ", sql_ident(table)), " SET "), sets),
            " WHERE "
        ),
        concat(concat(sql_ident(where_col), " = "), wph)
    )
}

// DELETE FROM "t" WHERE "col" = $1
fn sql_delete_eq_p(table: str, col: str) -> str {
    return concat(
        concat(concat("DELETE FROM ", sql_ident(table)), " WHERE "),
        concat(sql_ident(col), " = $1")
    )
}
