// schema.baga — sample migrations for ormbaga demos/tests only.
// Product apps define their own MigrationSet (see apps/api/schema.baga,
// apps/registry/schema.baga). Do not treat this as the universal app schema.
// Version numbers are monotonic timestamps (YYYYMMDDNNN).

import "migrate.baga"

// Sample registry (users + posts). Alias kept for tests/demo.
fn ormbaga_sample_migrations() -> MigrationSet {
    let mut set = migrate_set_new()
    set = migrate_add(
        set,
        20260803001,
        "create_users",
        "CREATE TABLE users (id BIGSERIAL PRIMARY KEY, email TEXT NOT NULL UNIQUE, name TEXT NOT NULL, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW())",
        "DROP TABLE IF EXISTS users"
    )
    set = migrate_add(
        set,
        20260803002,
        "create_posts",
        "CREATE TABLE posts (id BIGSERIAL PRIMARY KEY, user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE, title TEXT NOT NULL, body TEXT NOT NULL DEFAULT '', created_at TIMESTAMPTZ NOT NULL DEFAULT NOW())",
        "DROP TABLE IF EXISTS posts"
    )
    set = migrate_add(
        set,
        20260803003,
        "index_posts_user_id",
        "CREATE INDEX index_posts_on_user_id ON posts (user_id)",
        "DROP INDEX IF EXISTS index_posts_on_user_id"
    )
    return set
}

// Back-compat alias for demos/tests.
fn ormbaga_migrations() -> MigrationSet {
    return ormbaga_sample_migrations()
}
