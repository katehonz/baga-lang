// migrate.baga — versioned schema migrations for ormbaga.
// History table baga_schema_migrations stores every applied version (not only
// "current"). Registry is in-process parallel Vecs (no Vec<struct> in Baga).

import "../sql/sql.baga"
import "../session/orm.baga"
import "std/str/str.baga"

// Registry of migrations (sorted by version ascending when applying).
struct MigrationSet {
    versions: Vec<i64>,
    names: Vec<str>,
    ups: Vec<str>,
    downs: Vec<str>
}

fn migrate_set_new() -> MigrationSet {
    return MigrationSet {
        versions: vec_new(),
        names: vec_new(),
        ups: vec_new(),
        downs: vec_new()
    }
}

fn migrate_add(set: MigrationSet, version: i64, name: str, up_sql: str, down_sql: str) -> MigrationSet {
    vec_push(set.versions, version)
    vec_push(set.names, name)
    vec_push(set.ups, up_sql)
    vec_push(set.downs, down_sql)
    return set
}

fn migrate_len(set: MigrationSet) -> i64 {
    return vec_len(set.versions)
}

// Ensure history table exists (idempotent).
// Dual-backend DDL: bare idents, PRIMARY KEY required, no DEFAULT/NOT NULL
// so the same statement works on Postgres and boilaDB (BoilaSQL subset).
fn migrate_ensure_table(db: OrmDb) -> OrmExec !IO !Net {
    let sql = "CREATE TABLE IF NOT EXISTS baga_schema_migrations (version BIGINT, name TEXT, applied_at TIMESTAMPTZ, PRIMARY KEY (version))"
    return orm_exec(db, sql)?
}

// Record that a version was applied ($1 = version, $2 = name).
fn migrate_record(db: OrmDb, version: i64, name: str) -> OrmExec !IO !Net {
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, version)
    pg_param_str(vals, nulls, name)
    return orm_exec_params(db, "INSERT INTO baga_schema_migrations (version, name) VALUES ($1, $2)", vals, nulls)?
}

// Remove a version record (after successful down).
fn migrate_unrecord(db: OrmDb, version: i64) -> OrmExec !IO !Net {
    let vals = vec_new()
    let nulls = vec_new()
    pg_param_i64(vals, nulls, version)
    return orm_exec_params(db, "DELETE FROM baga_schema_migrations WHERE version = $1", vals, nulls)?
}

// Applied versions ascending.
fn migrate_applied(db: OrmDb) -> OrmQuery !IO !Net {
    return orm_query(db, "SELECT version FROM baga_schema_migrations ORDER BY version ASC")?
}

// Highest applied version (0 on empty history) — readiness/health checks.
// MAX alone (no COALESCE/::cast): dual Postgres + boilaDB; NULL → 0 via i64 cell.
fn migrate_current(db: OrmDb) -> OrmCount !IO !Net {
    return orm_count_sql(db, "SELECT MAX(version) AS count FROM baga_schema_migrations")?
}

// Parse a migrate_applied result into an in-memory Vec<i64> (membership
// checks then stay in-process via migrate_vec_has — no per-version COUNT).
fn migrate_versions_of(q: OrmQuery) -> Vec<i64> {
    let v = vec_new()
    let res = orm_result(q)
    let mut r: i64 = 0
    while r < orm_nrows(q) {
        vec_push(v, parse_int(pg_cell(res, r, 0)))
        r = r + 1
    }
    return v
}

// Membership check for an applied-version vector.
fn migrate_vec_has(v: Vec<i64>, ver: i64) -> i64 {
    for i in 0..vec_len(v) {
        if vec_get(v, i) == ver {
            return 1
        }
    }
    return 0
}

// First duplicate version in the set; 0 if none (versions are positive).
fn migrate_dup_version(set: MigrationSet) -> i64 {
    let n = vec_len(set.versions)
    let mut a: i64 = 0
    while a < n {
        let mut b = a + 1
        while b < n {
            if vec_get(set.versions, b) == vec_get(set.versions, a) {
                return vec_get(set.versions, a)
            }
            b = b + 1
        }
        a = a + 1
    }
    return 0
}

// Find index of version in set; -1 if missing.
fn migrate_index(set: MigrationSet, version: i64) -> i64 {
    for i in 0..vec_len(set.versions) {
        if vec_get(set.versions, i) == version {
            return i
        }
    }
    return -1
}

// Sort indices by version ascending (O(n²) swaps; migration sets are small).
fn migrate_sorted_indices(set: MigrationSet) -> Vec<i64> {
    let n = vec_len(set.versions)
    let mut idx = vec_new()
    for i in 0..n {
        vec_push(idx, i)
    }
    let mut a: i64 = 0
    while a < n {
        let mut b = a + 1
        while b < n {
            let ia = vec_get(idx, a)
            let ib = vec_get(idx, b)
            if vec_get(set.versions, ib) < vec_get(set.versions, ia) {
                let mut next = vec_new()
                let mut k: i64 = 0
                while k < n {
                    if k == a {
                        vec_push(next, ib)
                    } else {
                        if k == b {
                            vec_push(next, ia)
                        } else {
                            vec_push(next, vec_get(idx, k))
                        }
                    }
                    k = k + 1
                }
                idx = next
            }
            b = b + 1
        }
        a = a + 1
    }
    return idx
}

// B1 L3: migration batch outcome (how many versions ran this call).
struct MigOkData {
    applied: i64,
    db: OrmDb
}

struct MigErrData {
    err: str,
    db: OrmDb
}

enum MigrateResult {
    MigOk(MigOkData),
    MigErr(MigErrData)
}

fn migrate_ok(db: OrmDb, n: i64) -> MigrateResult {
    return MigOk(MigOkData { applied: n, db: db })
}

fn migrate_err(db: OrmDb, err: str) -> MigrateResult {
    return MigErr(MigErrData { err: err, db: db })
}

fn migrate_is_ok(r: MigrateResult) -> i64 {
    return match r {
        MigOk(_u1) => 1,
        MigErr(_u2) => 0,
    }
}

fn migrate_err_str(r: MigrateResult) -> str {
    return match r {
        MigOk(_u3) => "",
        MigErr(e) => e.err,
    }
}

fn migrate_applied_n(r: MigrateResult) -> i64 {
    return match r {
        MigOk(x) => x.applied,
        MigErr(_u4) => 0,
    }
}

fn migrate_db(r: MigrateResult) -> OrmDb {
    return match r {
        MigOk(x) => x.db,
        MigErr(e) => e.db,
    }
}

// Apply all pending migrations in version order. Each migration runs inside
// BEGIN … COMMIT (schema + history row); on failure ROLLBACK. Applied
// versions are fetched once and checked in memory (one round-trip, not one
// COUNT per migration).
fn migrate_up(db: OrmDb, set: MigrationSet) -> MigrateResult !IO !Net {
    let dup = migrate_dup_version(set)
    if dup != 0 {
        return migrate_err(db, concat("duplicate migration version ", sql_i64(dup)))
    }
    let ens = migrate_ensure_table(db)?
    if orm_ok(ens) == 0 {
        return migrate_err(orm_db_exec(ens), orm_err_exec(ens))
    }
    let mut d = orm_db_exec(ens)
    let aq = migrate_applied(d)?
    d = orm_db_q(aq)
    if orm_ok_q(aq) == 0 {
        return migrate_err(d, orm_err_q(aq))
    }
    let applied = migrate_versions_of(aq)
    let order = migrate_sorted_indices(set)
    let mut count: i64 = 0
    let mut i: i64 = 0
    while i < vec_len(order) {
        let mi = vec_get(order, i)
        let ver = vec_get(set.versions, mi)
        if migrate_vec_has(applied, ver) == 0 {
            let name = vec_get(set.names, mi)
            let up = vec_get(set.ups, mi)
            let b = orm_begin(d)?
            d = orm_db_exec(b)
            if orm_ok(b) == 0 {
                return migrate_err(d, orm_err_exec(b))
            }
            let ex = orm_exec(d, up)?
            d = orm_db_exec(ex)
            if orm_ok(ex) == 0 {
                let rb = orm_rollback(d)?
                return migrate_err(orm_db_exec(rb), concat(concat("up ", name), concat(": ", orm_err_exec(ex))))
            }
            let rec = migrate_record(d, ver, name)?
            d = orm_db_exec(rec)
            if orm_ok(rec) == 0 {
                let rb2 = orm_rollback(d)?
                return migrate_err(orm_db_exec(rb2), concat("record: ", orm_err_exec(rec)))
            }
            let c = orm_commit(d)?
            d = orm_db_exec(c)
            if orm_ok(c) == 0 {
                return migrate_err(d, orm_err_exec(c))
            }
            count = count + 1
        }
        i = i + 1
    }
    return migrate_ok(d, count)
}

// Roll back the last `steps` applied migrations that exist in `set` (highest version first).
fn migrate_down(db: OrmDb, set: MigrationSet, steps: i64) -> MigrateResult !IO !Net {
    let dup = migrate_dup_version(set)
    if dup != 0 {
        return migrate_err(db, concat("duplicate migration version ", sql_i64(dup)))
    }
    let ens = migrate_ensure_table(db)?
    if orm_ok(ens) == 0 {
        return migrate_err(orm_db_exec(ens), orm_err_exec(ens))
    }
    let mut d = orm_db_exec(ens)
    let q = orm_query(d, "SELECT version FROM baga_schema_migrations ORDER BY version DESC")?
    d = orm_db_q(q)
    if orm_ok_q(q) == 0 {
        return migrate_err(d, orm_err_q(q))
    }
    let mut done: i64 = 0
    let mut row: i64 = 0
    let nq = orm_nrows(q)
    let qres = orm_result(q)
    while row < nq && done < steps {
        let ver = parse_int(pg_cell(qres, row, 0))
        let mi = migrate_index(set, ver)
        if mi < 0 {
            return migrate_err(d, concat("no down SQL in set for version ", sql_i64(ver)))
        }
        let name = vec_get(set.names, mi)
        let down = vec_get(set.downs, mi)
        let b = orm_begin(d)?
        d = orm_db_exec(b)
        if orm_ok(b) == 0 {
            return migrate_err(d, orm_err_exec(b))
        }
        let ex = orm_exec(d, down)?
        d = orm_db_exec(ex)
        if orm_ok(ex) == 0 {
            let rb = orm_rollback(d)?
            return migrate_err(orm_db_exec(rb), concat(concat("down ", name), concat(": ", orm_err_exec(ex))))
        }
        let un = migrate_unrecord(d, ver)?
        d = orm_db_exec(un)
        if orm_ok(un) == 0 {
            let rb2 = orm_rollback(d)?
            return migrate_err(orm_db_exec(rb2), orm_err_exec(un))
        }
        let c = orm_commit(d)?
        d = orm_db_exec(c)
        if orm_ok(c) == 0 {
            return migrate_err(d, orm_err_exec(c))
        }
        done = done + 1
        row = row + 1
    }
    return migrate_ok(d, done)
}

// Raw history rows (version, name, applied_at) as recorded in the DB.
// For the combined set view (applied + pending) use migrate_status_text.
fn migrate_status(db: OrmDb, set: MigrationSet) -> OrmQuery !IO !Net {
    return orm_query(db, "SELECT version, name, applied_at::text FROM baga_schema_migrations ORDER BY version")?
}

// Full status report text plus the updated session — callers keep their db.
struct MigStatusData {
    text: str,
    db: OrmDb
}

// One row per migration in the set: "version name [applied|pending]".
// Applied versions come from a single history query; errors surface as
// "error: …" text with ok db still returned.
fn migrate_status_text(db: OrmDb, set: MigrationSet) -> MigStatusData !IO !Net {
    let ens = migrate_ensure_table(db)?
    if orm_ok(ens) == 0 {
        return MigStatusData { text: concat("error: ", orm_err_exec(ens)), db: orm_db_exec(ens) }
    }
    let mut d = orm_db_exec(ens)
    let aq = migrate_applied(d)?
    d = orm_db_q(aq)
    if orm_ok_q(aq) == 0 {
        return MigStatusData { text: concat("error: ", orm_err_q(aq)), db: d }
    }
    let applied = migrate_versions_of(aq)
    let order = migrate_sorted_indices(set)
    let mut out = ""
    let mut i: i64 = 0
    while i < vec_len(order) {
        let mi = vec_get(order, i)
        let ver = vec_get(set.versions, mi)
        let name = vec_get(set.names, mi)
        let mut st = "pending"
        if migrate_vec_has(applied, ver) == 1 {
            st = "applied"
        }
        out = concat(out, concat(concat(concat(concat(sql_i64(ver), " "), name), " ["), concat(st, "]\n")))
        i = i + 1
    }
    return MigStatusData { text: out, db: d }
}
