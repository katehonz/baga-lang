// demo.baga — migrate + ActiveRecord-style CRUD against baga_orm.

import "orm.baga"
import "migrate.baga"
import "schema.baga"
import "sql.baga"
import "../../std/str/str.baga"

fn main() -> i64 !Net !IO !Random {
    print("ormbaga demo (ActiveRecord + goose migrations)")
    let db0 = orm_connect_env()?
    if orm_ok_db(db0) == 0 {
        print(concat("connect failed: ", orm_err_db(db0)))
        print("hint: PGDATABASE=baga_orm PGUSER=bagatest PGPASSWORD=pas+123")
        return 1
    }
    let mut db = db0
    print("connected")

    let set = ormbaga_migrations()
    let up = migrate_up(db, set)?
    db = up.db
    if up.ok == 0 {
        print(concat("migrate_up failed: ", up.err))
        orm_close(db)?
        return 1
    }
    print(concat("migrate_up applied=", sql_i64(up.applied)))

    // status
    let st = migrate_status(db, set)?
    db = st.db
    if st.ok == 1 {
        print("schema_migrations:")
        let mut r: i64 = 0
        while r < st.nrows {
            print(concat(concat("  ", orm_cell(st, r, 0)), concat(" ", orm_cell(st, r, 1))))
            r = r + 1
        }
    }

    // User.create
    let cols = vec_new()
    vec_push(cols, "email")
    vec_push(cols, "name")
    let vals = vec_new()
    vec_push(vals, "bagatur@baga.dev")
    vec_push(vals, "Bagatur")
    let ins = orm_insert_strs(db, "users", cols, vals)?
    db = ins.db
    if ins.ok == 0 {
        // maybe already exists from prior run — update path
        print(concat("insert note: ", ins.err))
    } else {
        print(concat("insert user: ", ins.tag))
    }

    let found = orm_where_eq_str(db, "users", "email", "bagatur@baga.dev")?
    db = found.db
    if found.ok == 0 || found.nrows < 1 {
        print("user not found after insert")
        orm_close(db)?
        return 1
    }
    let uid = orm_cell_by_i64(found, 0, "id")
    print(concat(concat("find user id=", sql_i64(uid)), concat(" name=", orm_cell_by(found, 0, "name"))))

    // update name
    let ucols = vec_new()
    vec_push(ucols, "name")
    let uvals = vec_new()
    vec_push(uvals, "Bagatur the Great")
    let upd = orm_update_by_id(db, "users", uid, ucols, uvals)?
    db = upd.db
    print(concat("update: ", upd.tag))

    // Post.create
    let pcols = vec_new()
    vec_push(pcols, "user_id")
    vec_push(pcols, "title")
    vec_push(pcols, "body")
    let plits = vec_new()
    vec_push(plits, sql_i64(uid))
    vec_push(plits, sql_lit("Hello ormbaga"))
    vec_push(plits, sql_lit("ActiveRecord + goose on Baga"))
    let pins = orm_insert_lits(db, "posts", pcols, plits)?
    db = pins.db
    print(concat("insert post: ", pins.tag))

    let posts = orm_where_eq_i64(db, "posts", "user_id", uid)?
    db = posts.db
    print(concat("posts for user: ", sql_i64(posts.nrows)))
    let mut i: i64 = 0
    while i < posts.nrows {
        print(concat(concat("  - ", orm_cell_by(posts, i, "title")),
            concat(": ", orm_cell_by(posts, i, "body"))))
        i = i + 1
    }

    let cnt = orm_count(db, "users")?
    db = cnt.db
    print(concat("users.count = ", sql_i64(cnt.count)))

    orm_close(db)?
    print("done")
    return 0
}
