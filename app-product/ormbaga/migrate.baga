// migrate.baga — versioned schema migrations (goose / Flyway style).
// Tracks every applied version in baga_schema_migrations (not just "current").
// Migrations are an in-process registry (parallel Vecs — no Vec<struct> in Baga),
// same idea as Go goose with embedded SQL.

import "sql.baga"
import "orm.baga"
import "../../std/str/str.baga"

// Registry of migrations (sorted by version ascending when applying).
struct MigrationSet {
    versions: Vec<i64>,
    names: Vec<str>,
    ups: Vec<str>,
    downs: Vec<str>
}

fn migrate_set_new() -> MigrationSet {
    return MigrationSet {
        versions: vec_new(),
        names: vec_new(),
        ups: vec_new(),
        downs: vec_new()
    }
}

fn migrate_add(set: MigrationSet, version: i64, name: str, up_sql: str, down_sql: str) -> MigrationSet {
    vec_push(set.versions, version)
    vec_push(set.names, name)
    vec_push(set.ups, up_sql)
    vec_push(set.downs, down_sql)
    return set
}

fn migrate_len(set: MigrationSet) -> i64 {
    return vec_len(set.versions)
}

// Ensure history table exists (idempotent).
fn migrate_ensure_table(db: OrmDb) -> OrmExec !IO !Net {
    let sql = "CREATE TABLE IF NOT EXISTS baga_schema_migrations (
  version BIGINT PRIMARY KEY,
  name TEXT NOT NULL,
  applied_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
)"
    // strip newlines for Simple Query safety/readability — Postgres accepts them
    return orm_exec(db, sql)?
}

// Is this version already applied?
fn migrate_is_applied(db: OrmDb, version: i64) -> OrmCount !IO !Net {
    let sql = concat(
        "SELECT COUNT(*)::bigint AS count FROM baga_schema_migrations WHERE version = ",
        sql_i64(version)
    )
    return orm_count_sql(db, sql)?
}

// Record that a version was applied.
fn migrate_record(db: OrmDb, version: i64, name: str) -> OrmExec !IO !Net {
    let cols = vec_new()
    vec_push(cols, "version")
    vec_push(cols, "name")
    let lits = vec_new()
    vec_push(lits, sql_i64(version))
    vec_push(lits, sql_lit(name))
    return orm_exec(db, sql_insert("baga_schema_migrations", cols, lits))?
}

// Remove a version record (after successful down).
fn migrate_unrecord(db: OrmDb, version: i64) -> OrmExec !IO !Net {
    return orm_exec(db, sql_delete_eq("baga_schema_migrations", "version", sql_i64(version)))?
}

// Applied versions ascending.
fn migrate_applied(db: OrmDb) -> OrmQuery !IO !Net {
    return orm_query(db, "SELECT version FROM baga_schema_migrations ORDER BY version ASC")?
}

// Find index of version in set; -1 if missing.
fn migrate_index(set: MigrationSet, version: i64) -> i64 {
    for i in 0..vec_len(set.versions) {
        if vec_get(set.versions, i) == version {
            return i
        }
    }
    return -1
}

// Sort indices by version ascending (O(n²) swaps; migration sets are small).
fn migrate_sorted_indices(set: MigrationSet) -> Vec<i64> {
    let n = vec_len(set.versions)
    let mut idx = vec_new()
    for i in 0..n {
        vec_push(idx, i)
    }
    let mut a: i64 = 0
    while a < n {
        let mut b = a + 1
        while b < n {
            let ia = vec_get(idx, a)
            let ib = vec_get(idx, b)
            if vec_get(set.versions, ib) < vec_get(set.versions, ia) {
                let mut next = vec_new()
                let mut k: i64 = 0
                while k < n {
                    if k == a {
                        vec_push(next, ib)
                    } else {
                        if k == b {
                            vec_push(next, ia)
                        } else {
                            vec_push(next, vec_get(idx, k))
                        }
                    }
                    k = k + 1
                }
                idx = next
            }
            b = b + 1
        }
        a = a + 1
    }
    return idx
}

struct MigrateResult {
    ok: i64,
    err: str,
    applied: i64,    // how many migrations ran this call
    db: OrmDb
}

fn migrate_ok(db: OrmDb, n: i64) -> MigrateResult {
    return MigrateResult { ok: 1, err: "", applied: n, db: db }
}

fn migrate_err(db: OrmDb, err: str) -> MigrateResult {
    return MigrateResult { ok: 0, err: err, applied: 0, db: db }
}

// Apply all pending migrations in version order. Each migration runs inside
// BEGIN … COMMIT (schema + history row); on failure ROLLBACK.
fn migrate_up(db: OrmDb, set: MigrationSet) -> MigrateResult !IO !Net {
    let ens = migrate_ensure_table(db)?
    if ens.ok == 0 {
        return migrate_err(ens.db, ens.err)
    }
    let mut d = ens.db
    let order = migrate_sorted_indices(set)
    let mut count: i64 = 0
    let mut i: i64 = 0
    while i < vec_len(order) {
        let mi = vec_get(order, i)
        let ver = vec_get(set.versions, mi)
        let name = vec_get(set.names, mi)
        let up = vec_get(set.ups, mi)
        let chk = migrate_is_applied(d, ver)?
        d = chk.db
        if chk.ok == 0 {
            return migrate_err(d, chk.err)
        }
        if chk.count == 0 {
            let b = orm_begin(d)?
            d = b.db
            if b.ok == 0 {
                return migrate_err(d, b.err)
            }
            let ex = orm_exec(d, up)?
            d = ex.db
            if ex.ok == 0 {
                let rb = orm_rollback(d)?
                return migrate_err(rb.db, concat(concat("up ", name), concat(": ", ex.err)))
            }
            let rec = migrate_record(d, ver, name)?
            d = rec.db
            if rec.ok == 0 {
                let rb2 = orm_rollback(d)?
                return migrate_err(rb2.db, concat("record: ", rec.err))
            }
            let c = orm_commit(d)?
            d = c.db
            if c.ok == 0 {
                return migrate_err(d, c.err)
            }
            count = count + 1
        }
        i = i + 1
    }
    return migrate_ok(d, count)
}

// Roll back the last `steps` applied migrations that exist in `set` (highest version first).
fn migrate_down(db: OrmDb, set: MigrationSet, steps: i64) -> MigrateResult !IO !Net {
    let ens = migrate_ensure_table(db)?
    if ens.ok == 0 {
        return migrate_err(ens.db, ens.err)
    }
    let mut d = ens.db
    let q = orm_query(d, "SELECT version FROM baga_schema_migrations ORDER BY version DESC")?
    d = q.db
    if q.ok == 0 {
        return migrate_err(d, q.err)
    }
    let mut done: i64 = 0
    let mut row: i64 = 0
    while row < q.nrows && done < steps {
        let ver = parse_int(pg_cell(q.result, row, 0))
        let mi = migrate_index(set, ver)
        if mi < 0 {
            return migrate_err(d, concat("no down SQL in set for version ", sql_i64(ver)))
        }
        let name = vec_get(set.names, mi)
        let down = vec_get(set.downs, mi)
        let b = orm_begin(d)?
        d = b.db
        if b.ok == 0 {
            return migrate_err(d, b.err)
        }
        let ex = orm_exec(d, down)?
        d = ex.db
        if ex.ok == 0 {
            let rb = orm_rollback(d)?
            return migrate_err(rb.db, concat(concat("down ", name), concat(": ", ex.err)))
        }
        let un = migrate_unrecord(d, ver)?
        d = un.db
        if un.ok == 0 {
            let rb2 = orm_rollback(d)?
            return migrate_err(rb2.db, un.err)
        }
        let c = orm_commit(d)?
        d = c.db
        if c.ok == 0 {
            return migrate_err(d, c.err)
        }
        done = done + 1
        row = row + 1
    }
    return migrate_ok(d, done)
}

// Human-readable status: "version name [applied|pending]" lines.
fn migrate_status(db: OrmDb, set: MigrationSet) -> OrmQuery !IO !Net {
    // Return a synthetic query-like string via orm_exec? Better: build report in str.
    // Use OrmQuery with a dummy — actually return via a small helper struct.
    return orm_query(db, "SELECT version, name, applied_at::text FROM baga_schema_migrations ORDER BY version")?
}

fn migrate_status_text(db: OrmDb, set: MigrationSet) -> str !IO !Net {
    let ens = migrate_ensure_table(db)?
    if ens.ok == 0 {
        return concat("error: ", ens.err)
    }
    let mut d = ens.db
    let order = migrate_sorted_indices(set)
    let mut out = ""
    let mut i: i64 = 0
    while i < vec_len(order) {
        let mi = vec_get(order, i)
        let ver = vec_get(set.versions, mi)
        let name = vec_get(set.names, mi)
        let chk = migrate_is_applied(d, ver)?
        d = chk.db
        let mut st = "pending"
        if chk.ok == 1 {
            if chk.count > 0 {
                st = "applied"
            }
        } else {
            st = concat("error:", chk.err)
        }
        out = concat(out, concat(concat(concat(concat(sql_i64(ver), " "), name), " ["), concat(st, "]\n")))
        i = i + 1
    }
    // stash db? caller loses db update — status_text is reporting only; use migrate_status for conn
    return out
}
