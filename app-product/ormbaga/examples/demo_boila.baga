// demo_boila.baga — migrate + CRUD against boilaDB (PG wire / boilabaga).
//
//   ./baga -I . -I app-product app-product/boilaDB/tools/serve_pg.baga
//   ./baga -I . -I app-product app-product/ormbaga/examples/demo_boila.baga

import "../session/orm.baga"
import "../migrate/migrate.baga"
import "../migrate/schema.baga"
import "../sql/sql.baga"
import "std/str/str.baga"

fn main() -> i64 !Net !IO !Random {
    print("ormbaga demo (boilaDB via boilabaga)")
    let db0 = orm_connect_boila_env()?
    if orm_ok_db(db0) == 0 {
        print(concat("connect failed: ", orm_err_db(db0)))
        print("hint: start serve_pg  BOILA_PGPORT=6575")
        return 1
    }
    let mut db = db0
    print(concat("connected server_version=", db.conn.server_version))

    let set = ormbaga_boila_migrations()
    let up = migrate_up(db, set)?
    db = migrate_db(up)
    if migrate_is_ok(up) == 0 {
        print(concat("migrate_up failed: ", migrate_err_str(up)))
        orm_close(db)?
        return 1
    }
    print(concat("migrate_up applied=", sql_i64(migrate_applied_n(up))))

    let stt = migrate_status_text(db, set)?
    db = stt.db
    print(concat("status:\n", stt.text))

    // explicit id (no SERIAL on boila)
    let cols = vec_new()
    vec_push(cols, "id")
    vec_push(cols, "email")
    vec_push(cols, "name")
    let vals = vec_new()
    vec_push(vals, "1")
    vec_push(vals, "bagatur@baga.dev")
    vec_push(vals, "Bagatur")
    let ins = orm_insert_strs(db, "users", cols, vals)?
    db = orm_db_exec(ins)
    if orm_ok(ins) == 0 {
        print(concat("insert note: ", orm_err_exec(ins)))
    } else {
        print(concat("insert user: ", orm_tag(ins)))
    }

    let found = orm_where_eq_str(db, "users", "email", "bagatur@baga.dev")?
    db = orm_db_q(found)
    if orm_ok_q(found) == 0 || orm_nrows(found) < 1 {
        print("user not found after insert")
        orm_close(db)?
        return 1
    }
    let uid = orm_cell_by_i64(found, 0, "id")
    print(concat(concat("find user id=", sql_i64(uid)), concat(" name=", orm_cell_by(found, 0, "name"))))

    let ucols = vec_new()
    vec_push(ucols, "name")
    let uvals = vec_new()
    vec_push(uvals, "Bagatur the Great")
    let upd = orm_update_by_id(db, "users", uid, ucols, uvals)?
    db = orm_db_exec(upd)
    print(concat("update: ", orm_tag(upd)))

    let pcols = vec_new()
    vec_push(pcols, "id")
    vec_push(pcols, "user_id")
    vec_push(pcols, "title")
    vec_push(pcols, "body")
    let pvals = vec_new()
    vec_push(pvals, "100")
    vec_push(pvals, sql_i64(uid))
    vec_push(pvals, "Hello boila orm")
    vec_push(pvals, "ormbaga over boilabaga PG wire")
    let pins = orm_insert_strs(db, "posts", pcols, pvals)?
    db = orm_db_exec(pins)
    print(concat("insert post: ", orm_tag(pins)))

    let posts = orm_where_eq_i64(db, "posts", "user_id", uid)?
    db = orm_db_q(posts)
    print(concat("posts for user: ", sql_i64(orm_nrows(posts))))
    let mut i: i64 = 0
    while i < orm_nrows(posts) {
        print(concat(concat("  - ", orm_cell_by(posts, i, "title")),
            concat(": ", orm_cell_by(posts, i, "body"))))
        i = i + 1
    }

    let cnt = orm_count(db, "users")?
    db = orm_db_c(cnt)
    print(concat("users.count = ", sql_i64(orm_count_n(cnt))))

    let ping = orm_ping(db)?
    db = orm_db_q(ping)
    print(concat("ping ok=", sql_i64(orm_ok_q(ping))))

    orm_close(db)?
    print("done")
    return 0
}
