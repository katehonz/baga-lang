// pool.baga — OrmDb session pool (channel of free slot indices).
//
//   - N pre-opened sessions as parallel Vecs (no Vec<struct>)
//   - free slots on a buffered chan (i64 index)
//   - acquire blocks until a slot is free; release returns it
//
// HTTP servers usually prefer FMR_WORKERS=N (one DB per worker). Use this pool
// for sync servers, batch jobs, and tests that share one process.

import "../session/orm.baga"
import "pgbaga/pg.baga"
import "boilabaga/adapter.baga"
import "std/str/str.baga"

struct OrmPool {
    free_ch: i64,       // channel of free slot indices
    n: i64,
    fds: Vec<i64>,
    oks: Vec<i64>,
    pids: Vec<i64>,
    txs: Vec<i64>,
    errs: Vec<str>,
    versions: Vec<str>
}

struct OrmLease {
    db: OrmDb,
    slot: i64,
    free_ch: i64,
    // write-back vectors (shared heap with pool)
    fds: Vec<i64>,
    oks: Vec<i64>,
    pids: Vec<i64>,
    txs: Vec<i64>,
    errs: Vec<str>,
    versions: Vec<str>
}

fn orm_pool_empty() -> OrmPool {
    return OrmPool {
        free_ch: 0,
        n: 0,
        fds: vec_new(),
        oks: vec_new(),
        pids: vec_new(),
        txs: vec_new(),
        errs: vec_new(),
        versions: vec_new()
    }
}

// Create `size` connections. size clamped to [1, 64].
fn orm_pool_new(host: str, port: i64, user: str, password: str, database: str, size: i64) -> OrmPool !Net !IO !Random !Par {
    let mut n = size
    if n < 1 { n = 1 }
    if n > 64 { n = 64 }
    let ch = chan_new(n)
    let fds = vec_new()
    let oks = vec_new()
    let pids = vec_new()
    let txs = vec_new()
    let errs = vec_new()
    let versions = vec_new()
    let mut i: i64 = 0
    let mut ok_count: i64 = 0
    while i < n {
        let c = pg_connect(host, port, user, password, database)?
        vec_push(fds, c.fd)
        vec_push(oks, c.ok)
        vec_push(pids, c.pid)
        vec_push(txs, c.tx_status)
        vec_push(errs, c.err)
        vec_push(versions, c.server_version)
        if c.ok == 1 {
            chan_send(ch, i)
            ok_count = ok_count + 1
        }
        i = i + 1
    }
    let pool = OrmPool {
        free_ch: ch,
        n: n,
        fds: fds,
        oks: oks,
        pids: pids,
        txs: txs,
        errs: errs,
        versions: versions
    }
    return pool
}

fn orm_pool_from_env(size: i64) -> OrmPool !Net !IO !Random !Par {
    let host = orm_cfg("PGHOST", "127.0.0.1")?
    let port = parse_int(orm_cfg("PGPORT", "5432")?)
    let user = orm_cfg("PGUSER", "bagatest")?
    let password = orm_cfg("PGPASSWORD", "pas+123")?
    let database = orm_cfg("PGDATABASE", "baga_orm")?
    return orm_pool_new(host, port, user, password, database, size)?
}

// Pool of boilaDB sessions (PG wire defaults via boilabaga).
fn orm_pool_from_boila_env(size: i64) -> OrmPool !Net !IO !Random !Par {
    let host = boila_host()?
    let port = boila_port()?
    let user = boila_user()?
    let password = boila_password()?
    let database = boila_database()?
    return orm_pool_new(host, port, user, password, database, size)?
}

// ORM_BACKEND=boila|boiladb → boila pool; else Postgres PG* pool.
fn orm_pool_from_auto_env(size: i64) -> OrmPool !Net !IO !Random !Par {
    let be = orm_cfg("ORM_BACKEND", "pg")?
    if be == "boila" || be == "boiladb" || be == "boilaDB" {
        return orm_pool_from_boila_env(size)?
    }
    return orm_pool_from_env(size)?
}

fn orm_pool_conn_at(pool: OrmPool, slot: i64) -> PgConn {
    // Reader is rebuilt on acquire: parallel Vecs cannot hold the PgReader
    // struct, and release leaves the socket drained at ReadyForQuery, so no
    // residual bytes are lost across checkin/checkout.
    let fd = vec_get(pool.fds, slot)
    return PgConn {
        fd: fd,
        ok: vec_get(pool.oks, slot),
        err: vec_get(pool.errs, slot),
        pid: vec_get(pool.pids, slot),
        key: pg_empty(),
        tx_status: vec_get(pool.txs, slot),
        server_version: vec_get(pool.versions, slot),
        reader: pg_reader(fd)
    }
}

// Acquire a session (blocks). Returns lease; check lease.db.conn.ok.
fn orm_pool_acquire(pool: OrmPool) -> OrmLease !Par {
    let slot = chan_recv(pool.free_ch)
    let c = orm_pool_conn_at(pool, slot)
    return OrmLease {
        db: orm_from_conn(c),
        slot: slot,
        free_ch: pool.free_ch,
        fds: pool.fds,
        oks: pool.oks,
        pids: pool.pids,
        txs: pool.txs,
        errs: pool.errs,
        versions: pool.versions
    }
}

// Non-blocking acquire. ok=1 lease valid; ok=0 none free; ok=2 channel closed.
struct OrmTryLease {
    ok: i64,
    lease: OrmLease
}

fn orm_pool_try_acquire(pool: OrmPool) -> OrmTryLease !Par {
    let empty = OrmLease {
        db: orm_db_bad(""),
        slot: 0,
        free_ch: pool.free_ch,
        fds: pool.fds, oks: pool.oks, pids: pool.pids, txs: pool.txs,
        errs: pool.errs, versions: pool.versions
    }
    let t = chan_try_recv(pool.free_ch)
    let st = cell2_0(t)
    if st != 1 {
        return OrmTryLease { ok: st, lease: empty }
    }
    let slot = cell2_1(t)
    let c = orm_pool_conn_at(pool, slot)
    return OrmTryLease {
        ok: 1,
        lease: OrmLease {
            db: orm_from_conn(c),
            slot: slot,
            free_ch: pool.free_ch,
            fds: pool.fds, oks: pool.oks, pids: pool.pids, txs: pool.txs,
            errs: pool.errs, versions: pool.versions
        }
    }
}

// Write conn state back and return slot to free list.
// If still in a transaction block, ROLLBACK first.
fn orm_pool_release(lease: OrmLease) -> i64 !IO !Net !Par {
    let mut db = lease.db
    // 'T' = 84 in transaction, 'E' = 69 failed transaction
    if db.conn.tx_status == 84 || db.conn.tx_status == 69 {
        let rb = orm_rollback(db)?
        db = orm_db_exec(rb)
    }
    let c = db.conn
    vec_set(lease.fds, lease.slot, c.fd)
    vec_set(lease.oks, lease.slot, c.ok)
    vec_set(lease.pids, lease.slot, c.pid)
    vec_set(lease.txs, lease.slot, c.tx_status)
    vec_set_str(lease.errs, lease.slot, c.err)
    vec_set_str(lease.versions, lease.slot, c.server_version)
    chan_send(lease.free_ch, lease.slot)
    return 0
}

// Close all pooled connections and the free channel.
fn orm_pool_close(pool: OrmPool) -> i64 !IO !Net !Par {
    let mut i: i64 = 0
    while i < pool.n {
        let fd = vec_get(pool.fds, i)
        if fd >= 0 {
            let c = orm_pool_conn_at(pool, i)
            if c.ok == 1 {
                pg_close(c)?
            }
        }
        i = i + 1
    }
    chan_close(pool.free_ch)
    return 0
}

fn orm_pool_size(pool: OrmPool) -> i64 {
    return pool.n
}

fn orm_pool_idle(pool: OrmPool) -> i64 !Par {
    return chan_len(pool.free_ch)
}
