// proxy.baga — OAuth 2.0 client/proxy half for Baga (apps-roadmap №10).
//
// The confidential client: /login builds the authorize redirect, /callback
// exchanges the code over the std HTTP client (real server-to-server call),
// sessions live in a Map as cookie sid -> JSON record, expired access
// tokens refresh transparently. Pages are rendered by tplbaga — №7 feeds
// №10 (roadmap rule 4).

import "oauth.baga"
import "tplbaga/tpl.baga"
import "ormbaga/orm.baga"
import "std/net/http_client.baga"
import "std/net/url.baga"
import "std/json/json.baga"
import "std/str/str.baga"
import "std/time/time.baga"
import "std/random/random.baga"

// ---------- proxy store ----------
//
// Sessions: kind 0 = in-memory JSON records, kind 1 = Postgres
// (oauth_sessions). States stay in memory on both backends: they are
// per-node, one-time, seconds-lived (fine for a serial node; a future
// worker pool would move them too).

struct ProxyStore {
    kind: i64,                 // 0 = in-memory, 1 = Postgres
    sessions: Map<str, str>,   // kind 0: sid -> {"sub","scope","access","refresh","exp"(s)}
    states: Map<str, i64>      // pending authorize states -> 1
}

fn px_store_new() -> ProxyStore {
    return ProxyStore { kind: 0, sessions: map_new(), states: map_new() }
}

fn px_store_pg() -> ProxyStore {
    return ProxyStore { kind: 1, sessions: map_new(), states: map_new() }
}

struct PxSess {
    ok: i64,
    sub: str,
    scope: str,
    access: str,
    refresh: str,
    exp_s: i64
}

fn px_sess_bad() -> PxSess {
    return PxSess { ok: 0, sub: "", scope: "", access: "", refresh: "", exp_s: 0 }
}

fn px_session_put(st: ProxyStore, db: OrmDb, sid: str, t: PxTokens) -> i64 !IO !Net !Time {
    let exp = oa_now_s()? + t.expires_in
    if st.kind == 0 {
        let mut rec = "{"
        rec = concat(rec, oa_jpair("sub", t.sub))
        rec = concat(rec, concat(",", oa_jpair("scope", t.scope)))
        rec = concat(rec, concat(",", oa_jpair("access", t.access)))
        rec = concat(rec, concat(",", oa_jpair("refresh", t.refresh)))
        rec = concat(rec, concat(",", oa_jnum("exp", exp)))
        rec = concat(rec, "}")
        map_set(st.sessions, sid, rec)
        return 1
    }
    let vals: Vec<str> = vec_new()
    vec_push(vals, sid)
    vec_push(vals, t.sub)
    vec_push(vals, t.scope)
    vec_push(vals, t.access)
    vec_push(vals, t.refresh)
    vec_push(vals, int_to_str(exp))
    let ex = orm_exec_params_str(db,
        "INSERT INTO oauth_sessions (sid, sub, scope, access, refresh, expires_s)
         VALUES ($1, $2, $3, $4, $5, $6)
         ON CONFLICT (sid) DO UPDATE SET
           sub = $2, scope = $3, access = $4, refresh = $5, expires_s = $6", vals)?
    return ex.ok
}

fn px_session_get(st: ProxyStore, db: OrmDb, sid: str) -> PxSess !IO !Net {
    if st.kind == 0 {
        if map_has(st.sessions, sid) == 0 {
            return px_sess_bad()
        }
        let rec = map_get(st.sessions, sid)
        return PxSess {
            ok: 1,
            sub: oa_rec_str(rec, "sub"),
            scope: oa_rec_str(rec, "scope"),
            access: oa_rec_str(rec, "access"),
            refresh: oa_rec_str(rec, "refresh"),
            exp_s: oa_rec_num(rec, "exp")
        }
    }
    let qvals: Vec<str> = vec_new()
    vec_push(qvals, sid)
    let q = orm_query_params_str(db,
        "SELECT sub, scope, access, refresh, expires_s FROM oauth_sessions WHERE sid = $1", qvals)?
    if q.ok == 0 || q.nrows == 0 {
        return px_sess_bad()
    }
    return PxSess {
        ok: 1,
        sub: orm_cell(q, 0, 0),
        scope: orm_cell(q, 0, 1),
        access: orm_cell(q, 0, 2),
        refresh: orm_cell(q, 0, 3),
        exp_s: parse_int(orm_cell(q, 0, 4))
    }
}

fn px_session_del(st: ProxyStore, db: OrmDb, sid: str) -> i64 !IO !Net {
    if st.kind == 0 {
        map_del(st.sessions, sid)
        return 1
    }
    let vals: Vec<str> = vec_new()
    vec_push(vals, sid)
    let ex = orm_exec_params_str(db, "DELETE FROM oauth_sessions WHERE sid = $1", vals)?
    return ex.ok
}

// CSRF authorize states. kind 0: the per-node map; kind 1: oauth_states in
// the DB — which is what lets every connection run on its own thread.
fn px_state_put(st: ProxyStore, db: OrmDb, state: str) -> i64 !IO !Net {
    if st.kind == 0 {
        map_set(st.states, state, 1)
        return 1
    }
    let vals: Vec<str> = vec_new()
    vec_push(vals, state)
    let ex = orm_exec_params_str(db,
        "INSERT INTO oauth_states (state) VALUES ($1)", vals)?
    return ex.ok
}

// One-time check: 1 when the state existed (and is now consumed).
fn px_state_take(st: ProxyStore, db: OrmDb, state: str) -> i64 !IO !Net {
    if st.kind == 0 {
        if map_has(st.states, state) == 0 {
            return 0
        }
        map_del(st.states, state)
        return 1
    }
    let qvals: Vec<str> = vec_new()
    vec_push(qvals, state)
    let q = orm_query_params_str(db,
        "SELECT state FROM oauth_states WHERE state = $1", qvals)?
    if q.ok == 0 || q.nrows == 0 {
        return 0
    }
    let dvals: Vec<str> = vec_new()
    vec_push(dvals, state)
    orm_exec_params_str(q.db, "DELETE FROM oauth_states WHERE state = $1", dvals)?
    return 1
}

// ---------- cookies ----------

// Value of `name` inside a Cookie header; "" when absent.
fn px_cookie(header: str, name: str) -> str {
    let parts = str_split(header, ";")
    let want = concat(name, "=")
    let mut i: i64 = 0
    while i < vec_len(parts) {
        let t = str_trim(vec_get(parts, i))
        if str_starts_with(t, want) {
            return substr(t, len(want), len(t))
        }
        i = i + 1
    }
    return ""
}

// ---------- authorize + token calls ----------

fn px_authorize_url(cfg: OAuthCfg, state: str) -> str {
    let mut u = concat(cfg.provider_base, "/oauth/authorize?client_id=")
    u = concat(u, cfg.client_id)
    u = concat(u, concat("&redirect_uri=", url_encode(cfg.redirect_uri)))
    u = concat(u, concat("&state=", state))
    u = concat(u, "&scope=read")
    return u
}

struct PxTokens {
    ok: i64,
    access: str,
    refresh: str,
    expires_in: i64,
    sub: str,
    scope: str
}

fn px_tokens_bad() -> PxTokens {
    return PxTokens { ok: 0, access: "", refresh: "", expires_in: 0, sub: "", scope: "" }
}

// POST the form to the provider /token endpoint and parse the JSON reply.
fn px_call_token(cfg: OAuthCfg, form: str) -> PxTokens !Net !IO {
    let hdrs: Map<str, str> = map_new()
    map_set(hdrs, "Content-Type", "application/x-www-form-urlencoded")
    let url = concat(cfg.provider_base, "/oauth/token")
    let resp = http_request("POST", url, hdrs, form, 5)?
    if resp.ok == 0 || resp.status != 200 {
        return px_tokens_bad()
    }
    let d = json_parse(resp.body)
    let root = json_root(d)
    if root < 0 || json_tag(d, root) != 6 {
        return px_tokens_bad()
    }
    let an = json_get(d, root, "access_token")
    let rn = json_get(d, root, "refresh_token")
    if an < 0 || rn < 0 {
        return px_tokens_bad()
    }
    return PxTokens {
        ok: 1,
        access: json_str(d, an),
        refresh: json_str(d, rn),
        expires_in: oa_rec_num(resp.body, "expires_in"),
        sub: oa_rec_str(resp.body, "sub"),
        scope: oa_rec_str(resp.body, "scope")
    }
}

fn px_exchange_code(cfg: OAuthCfg, code: str) -> PxTokens !Net !IO {
    let mut form = "grant_type=authorization_code"
    form = concat(form, concat("&code=", code))
    form = concat(form, concat("&client_id=", cfg.client_id))
    form = concat(form, concat("&client_secret=", cfg.client_secret))
    return px_call_token(cfg, form)?
}

fn px_refresh(cfg: OAuthCfg, refresh: str) -> PxTokens !Net !IO {
    let mut form = "grant_type=refresh_token"
    form = concat(form, concat("&refresh_token=", refresh))
    form = concat(form, concat("&client_id=", cfg.client_id))
    form = concat(form, concat("&client_secret=", cfg.client_secret))
    return px_call_token(cfg, form)?
}

// ---------- pages (tplbaga, apps-roadmap №7) ----------

fn px_tpl_home() -> str {
    let mut t = "<!DOCTYPE html>\n<html>\n<head><meta charset=\"utf-8\" />"
    t = concat(t, "<title>oauthbaga</title></head>\n<body>\n<h1>oauthbaga proxy</h1>\n")
    t = concat(t, "{% if sub %}<p>Logged in as <b>{{ sub }}</b> (scope: {{ scope }}).</p>\n")
    t = concat(t, "<p><a href=\"/logout\">log out</a></p>{% else %}")
    t = concat(t, "<p>Not logged in.</p>\n<p><a href=\"/login\">log in</a></p>{% endif %}\n")
    t = concat(t, "</body>\n</html>\n")
    return t
}

fn px_render_home(sub: str, scope: str) -> str {
    let ctx: Map<str, str> = map_new()
    map_set(ctx, "sub", sub)
    map_set(ctx, "scope", scope)
    let r = tpl_render(px_tpl_home(), ctx)
    if r.ok == 0 {
        return concat("oauthbaga: template error: ", r.err)
    }
    return r.html
}
