// server.baga — HTTP wiring + serve loops for both OAuth nodes
// (apps-roadmap №10).
//
// Two serial nodes (kvbaga idiom): the provider never calls itself and the
// proxy's only outbound call is to the provider, so there is no
// self-accept deadlock.
//
// State backends: OAUTH_PG=1 + PG* env → Postgres via ormbaga (migrations
// at boot, one DB connection per HTTP connection — the fmr legacy idiom);
// otherwise in-memory maps (dev).
//
//   provider: GET /oauth/authorize · POST /oauth/token · GET /api/me
//   proxy:    GET /login · GET /callback · GET / · GET /logout

import "oauth.baga"
import "proxy.baga"
import "schema.baga"
import "httpdbaga/http.baga"
import "ormbaga/orm.baga"
import "ormbaga/migrate.baga"
import "std/net/tcp.baga"
import "std/net/url.baga"
import "std/str/str.baga"
import "std/json/json.baga"
import "std/json/json_write.baga"
import "std/json/json_strict.baga"
import "std/time/time.baga"
import "std/random/random.baga"

// ---------- boot ----------

// Idempotent: both nodes may call it (migrate table records versions).
fn oauth_boot_migrate() -> i64 !Net !IO !Random {
    let db = orm_connect_env()?
    if orm_ok_db(db) == 0 {
        print(concat("oauthbaga: pg connect failed: ", orm_err_db(db)))
        return 1
    }
    let up = migrate_up(db, oauth_migrations())?
    if migrate_is_ok(up) == 0 {
        print(concat("oauthbaga: migrate failed: ", migrate_err_str(up)))
        orm_close(migrate_db(up))?
        return 1
    }
    print(concat("oauthbaga migrate applied=", int_to_str(migrate_applied_n(up))))
    orm_close(migrate_db(up))?
    return 0
}

// kind 0 → bad handle (never touched); kind 1 → fresh env connection.
fn oauth_pg_open(kind: i64) -> OrmDb !Net !IO !Random {
    if kind == 0 {
        return orm_db_bad("")
    }
    return orm_connect_env()?
}

// Source of truth for the per-connection workers: env with the same
// defaults as demo.baga (go_bg can only carry the fd).
fn oauth_cfg_env() -> OAuthCfg !IO {
    let mut pp: i64 = 18690
    let s = env("OAUTH_PORT")?
    if s != "" && parse_int(s) > 0 {
        pp = parse_int(s)
    }
    let mut vp: i64 = 18691
    let s2 = env("OAUTH_PROVIDER_PORT")?
    if s2 != "" && parse_int(s2) > 0 {
        vp = parse_int(s2)
    }
    let mut secret = env("OAUTH_SECRET")?
    if secret == "" {
        secret = "dev-secret"
    }
    return oauth_cfg(vp, pp, secret)
}

// PG mode: each connection runs on its own thread (go_bg) and rebuilds
// everything from env — state lives in the DB, so nothing is shared
// (fmr legacy idiom; closes the worker half of gap O5).
fn oauth_provider_conn_bg(fd: i64) -> i64 !IO !Net !Time !Random {
    let cfg = oauth_cfg_env()?
    let st = oa_store_pg()
    let db = orm_connect_env()?
    if orm_ok_db(db) == 0 {
        let w = http_respond(fd, http_json_response(500, "{\"error\":\"db_unavailable\"}"))?
        tcp_close(fd)?
        return w
    }
    let req = http_read_request(fd)?
    let resp = oauth_provider_http(req, st, db, cfg)?
    let w = http_respond(fd, resp)?
    tcp_close(fd)?   // Connection: close — the client reads to EOF
    orm_close(db)?
    return w
}

fn oauth_proxy_conn_bg(fd: i64) -> i64 !IO !Net !Time !Random {
    let cfg = oauth_cfg_env()?
    let st = px_store_pg()
    let db = orm_connect_env()?
    if orm_ok_db(db) == 0 {
        let w = http_respond(fd, http_json_response(500, "{\"error\":\"db_unavailable\"}"))?
        tcp_close(fd)?
        return w
    }
    let req = http_read_request(fd)?
    let resp = oauth_proxy_http(req, st, db, cfg)?
    let w = http_respond(fd, resp)?
    tcp_close(fd)?   // Connection: close — the client reads to EOF
    orm_close(db)?
    return w
}

// ---------- O7: fixed worker pool (OAUTH_WORKERS=N, PG mode) ----------
// N go_bg workers, each holding ONE long-lived DB connection — SCRAM is
// paid once at first use, not per HTTP request. The accept loop pushes
// fds on a channel (fmrbaga FMR_WORKERS idiom). Store ops thread db by
// value, so a mid-life death is invisible to the worker's local: every
// checkout probes with SELECT 1 (1 RTT) and reconnects on failure.

fn oauth_workers_n() -> i64 !IO {
    let n = parse_int(env("OAUTH_WORKERS")?)
    if n < 0 {
        return 0
    }
    if n > 64 {
        return 64
    }
    return n
}

// Live long-lived connection: (re)connect when bad, probe + reconnect on
// a silently dropped one (PG idle timeout).
fn oauth_pool_db(db: OrmDb) -> OrmDb !Net !IO !Random {
    if orm_ok_db(db) == 0 {
        return orm_connect_env()?
    }
    let q = orm_query(db, "SELECT 1")?
    if orm_ok_q(q) == 1 {
        return orm_db_q(q)
    }
    return orm_connect_env()?
}

fn oauth_provider_pool_worker(ch: i64) -> i64 !IO !Net !Time !Random !Par {
    let cfg = oauth_cfg_env()?
    let st = oa_store_pg()
    let mut db = orm_db_bad("")
    let mut running: i64 = 1
    while running == 1 {
        let p = chan_recv2(ch)
        let st2 = cell2_0(p)
        let fd = cell2_1(p)
        if st2 == 0 || fd < 0 {
            running = 0
        } else {
            db = oauth_pool_db(db)?
            if orm_ok_db(db) == 0 {
                http_respond(fd, http_json_response(500, "{\"error\":\"db_unavailable\"}"))?
                tcp_close(fd)?
            } else {
                let req = http_read_request(fd)?
                let resp = oauth_provider_http(req, st, db, cfg)?
                http_respond(fd, resp)?
                tcp_close(fd)?   // Connection: close — the client reads to EOF
            }
        }
    }
    if orm_ok_db(db) == 1 {
        orm_close(db)?
    }
    return 0
}

fn oauth_proxy_pool_worker(ch: i64) -> i64 !IO !Net !Time !Random !Par {
    let cfg = oauth_cfg_env()?
    let st = px_store_pg()
    let mut db = orm_db_bad("")
    let mut running: i64 = 1
    while running == 1 {
        let p = chan_recv2(ch)
        let st2 = cell2_0(p)
        let fd = cell2_1(p)
        if st2 == 0 || fd < 0 {
            running = 0
        } else {
            db = oauth_pool_db(db)?
            if orm_ok_db(db) == 0 {
                http_respond(fd, http_json_response(500, "{\"error\":\"db_unavailable\"}"))?
                tcp_close(fd)?
            } else {
                let req = http_read_request(fd)?
                let resp = oauth_proxy_http(req, st, db, cfg)?
                http_respond(fd, resp)?
                tcp_close(fd)?   // Connection: close — the client reads to EOF
            }
        }
    }
    if orm_ok_db(db) == 1 {
        orm_close(db)?
    }
    return 0
}

// ---------- provider node ----------

fn oauth_provider_http(req: Request, st: OAuthStore, db: OrmDb, cfg: OAuthCfg) -> Response !Time !Random !IO !Net {
    let m = http_method(req)
    let p = http_path_only(req)
    if m == "GET" && p == "/health" {
        return http_json_response(200, "{\"status\":\"ok\"}")
    }
    if m == "GET" && p == "/oauth/authorize" {
        let cid = http_query_param(req, "client_id")
        let redir = url_decode(http_query_param(req, "redirect_uri"))
        let state = http_query_param(req, "state")
        let mut sub = http_query_param(req, "sub")
        let mut scope = http_query_param(req, "scope")
        if sub == "" { sub = "user" }
        if scope == "" { scope = "read" }
        if cid != cfg.client_id {
            return http_json_response(400, "{\"error\":\"invalid_request\",\"error_description\":\"unknown client_id\"}")
        }
        if redir != cfg.redirect_uri {
            return http_json_response(400, "{\"error\":\"invalid_request\",\"error_description\":\"redirect_uri mismatch\"}")
        }
        let code = oa_issue_code(st, db, cfg, cid, sub, scope)?
        let mut loc = concat(concat(redir, "?code="), code)
        if state != "" {
            loc = concat(loc, concat("&state=", state))
        }
        return http_set_header(http_response(302, ""), "Location", loc)
    }
    if m == "POST" && p == "/oauth/token" {
        let r = oa_token(st, db, cfg, http_body(req))?
        return http_json_response(r.status, r.json)
    }
    if m == "GET" && p == "/api/me" {
        let payload = oa_bearer_payload(cfg, http_header(req, "Authorization"))?
        if payload == "" {
            return http_json_response(401, "{\"error\":\"invalid_token\"}")
        }
        let mut j = "{"
        j = concat(j, oa_jpair("sub", oa_rec_str(payload, "sub")))
        j = concat(j, concat(",", oa_jpair("scope", oa_rec_str(payload, "scope"))))
        j = concat(j, "}")
        return http_json_response(200, j)
    }
    return http_json_response(404, "{\"error\":\"not found\"}")
}

fn oauth_provider_conn(fd: i64, st: OAuthStore, cfg: OAuthCfg) -> i64 !IO !Net !Time !Random {
    let db = oauth_pg_open(st.kind)?
    if st.kind == 1 && orm_ok_db(db) == 0 {
        return http_respond(fd, http_json_response(500, "{\"error\":\"db_unavailable\"}"))?
    }
    let req = http_read_request(fd)?
    let resp = oauth_provider_http(req, st, db, cfg)?
    let w = http_respond(fd, resp)?
    if st.kind == 1 {
        orm_close(db)?
    }
    return w
}

// ctx = cell2(provider_port, proxy_port). PG mode: go_bg per connection
// (state is in the DB, workers rebuild cfg from env); dev mode: serial
// accept over the shared in-memory store.
fn oauth_provider_serve(ctx: i64) -> i64 !Net !IO !Time !Random !Par {
    let port = cell2_0(ctx)
    let proxy_port = cell2_1(ctx)
    let listener = tcp_listen(port)?
    if listener < 0 {
        return -1
    }
    let mut secret = env("OAUTH_SECRET")?
    if secret == "" {
        secret = "dev-secret"
    }
    let mut st = oa_store_new()
    let pg_on = env("OAUTH_PG")?
    let mut pool_ch: i64 = 0
    if pg_on == "1" {
        if oauth_boot_migrate()? != 0 {
            return 1
        }
        st = oa_store_pg()
        // O7: fixed pool — N workers × one long-lived DB each
        let nw = oauth_workers_n()?
        if nw > 0 {
            pool_ch = chan_new(nw * 4)
            let mut i: i64 = 0
            while i < nw {
                go_bg(oauth_provider_pool_worker, pool_ch)
                i = i + 1
            }
            print(concat(concat("oauth provider pool: workers=", int_to_str(nw)), ", 1 DB each"))
        }
    }
    let cfg = oauth_cfg(port, proxy_port, secret)
    while true {
        let fd = tcp_accept(listener)?
        if fd >= 0 {
            if pool_ch != 0 {
                chan_send(pool_ch, fd)
            } else if st.kind == 1 {
                go_bg(oauth_provider_conn_bg, fd)
            } else {
                tcp_set_timeouts(fd, 60)?
                oauth_provider_conn(fd, st, cfg)?
                tcp_close(fd)?
            }
        }
    }
    return 0
}

// ---------- proxy node ----------

fn oauth_proxy_home_html(sub: str, scope: str) -> Response {
    return http_set_header(http_response(200, px_render_home(sub, scope)),
        "Content-Type", "text/html; charset=utf-8")
}

fn oauth_proxy_http(req: Request, st: ProxyStore, db: OrmDb, cfg: OAuthCfg) -> Response !Net !IO !Time !Random {
    let m = http_method(req)
    let p = http_path_only(req)
    if m == "GET" && p == "/health" {
        return http_json_response(200, "{\"status\":\"ok\"}")
    }
    if m == "GET" && p == "/login" {
        let state = oa_rand_hex(8)?
        if px_state_put(st, db, state)? == 0 {
            return http_json_response(500, "{\"error\":\"state_store_failed\"}")
        }
        return http_set_header(http_response(302, ""), "Location", px_authorize_url(cfg, state))
    }
    if m == "GET" && p == "/callback" {
        let state = http_query_param(req, "state")
        let code = http_query_param(req, "code")
        // one-time CSRF guard (map for kind 0, oauth_states for kind 1)
        if state == "" || px_state_take(st, db, state)? == 0 {
            return http_json_response(400, "{\"error\":\"bad_state\"}")
        }
        if code == "" {
            return http_json_response(400, "{\"error\":\"missing_code\"}")
        }
        let t = px_exchange_code(cfg, code)?
        if t.ok == 0 {
            return http_json_response(502, "{\"error\":\"token_exchange_failed\"}")
        }
        let sid = oa_rand_hex(16)?
        if px_session_put(st, db, sid, t)? == 0 {
            return http_json_response(500, "{\"error\":\"session_store_failed\"}")
        }
        let mut resp = http_response(302, "")
        resp = http_set_header(resp, "Location", "/")
        resp = http_set_header(resp, "Set-Cookie", concat(concat("sid=", sid), "; Path=/; HttpOnly"))
        return resp
    }
    if m == "GET" && p == "/logout" {
        let sid = px_cookie(http_header(req, "Cookie"), "sid")
        if sid != "" {
            px_session_del(st, db, sid)?
        }
        let mut resp = http_response(302, "")
        resp = http_set_header(resp, "Location", "/")
        resp = http_set_header(resp, "Set-Cookie", "sid=; Path=/; Max-Age=0")
        return resp
    }
    if m == "GET" && p == "/" {
        let sid = px_cookie(http_header(req, "Cookie"), "sid")
        if sid == "" {
            return oauth_proxy_home_html("", "")
        }
        let sess = px_session_get(st, db, sid)?
        if sess.ok == 0 {
            return oauth_proxy_home_html("", "")
        }
        if sess.exp_s <= oa_now_s()? {
            // transparent refresh with the stored refresh token
            let t = px_refresh(cfg, sess.refresh)?
            if t.ok == 0 {
                px_session_del(st, db, sid)?
                return oauth_proxy_home_html("", "")
            }
            px_session_put(st, db, sid, t)?
            return oauth_proxy_home_html(t.sub, t.scope)
        }
        return oauth_proxy_home_html(sess.sub, sess.scope)
    }
    return http_json_response(404, "{\"error\":\"not found\"}")
}

fn oauth_proxy_conn(fd: i64, st: ProxyStore, cfg: OAuthCfg) -> i64 !IO !Net !Time !Random {
    let db = oauth_pg_open(st.kind)?
    if st.kind == 1 && orm_ok_db(db) == 0 {
        return http_respond(fd, http_json_response(500, "{\"error\":\"db_unavailable\"}"))?
    }
    let req = http_read_request(fd)?
    let resp = oauth_proxy_http(req, st, db, cfg)?
    let w = http_respond(fd, resp)?
    if st.kind == 1 {
        orm_close(db)?
    }
    return w
}

// ctx = cell2(proxy_port, provider_port). PG mode: go_bg per connection;
// dev mode: serial accept over the shared in-memory store.
fn oauth_proxy_serve(ctx: i64) -> i64 !Net !IO !Time !Random !Par {
    let port = cell2_0(ctx)
    let provider_port = cell2_1(ctx)
    let listener = tcp_listen(port)?
    if listener < 0 {
        return -1
    }
    let mut secret = env("OAUTH_SECRET")?
    if secret == "" {
        secret = "dev-secret"
    }
    let mut st = px_store_new()
    let pg_on = env("OAUTH_PG")?
    let mut pool_ch: i64 = 0
    if pg_on == "1" {
        if oauth_boot_migrate()? != 0 {
            return 1
        }
        st = px_store_pg()
        // O7: fixed pool — N workers × one long-lived DB each
        let nw = oauth_workers_n()?
        if nw > 0 {
            pool_ch = chan_new(nw * 4)
            let mut i: i64 = 0
            while i < nw {
                go_bg(oauth_proxy_pool_worker, pool_ch)
                i = i + 1
            }
            print(concat(concat("oauth proxy pool: workers=", int_to_str(nw)), ", 1 DB each"))
        }
    }
    let cfg = oauth_cfg(provider_port, port, secret)
    while true {
        let fd = tcp_accept(listener)?
        if fd >= 0 {
            if pool_ch != 0 {
                chan_send(pool_ch, fd)
            } else if st.kind == 1 {
                go_bg(oauth_proxy_conn_bg, fd)
            } else {
                tcp_set_timeouts(fd, 60)?
                oauth_proxy_conn(fd, st, cfg)?
                tcp_close(fd)?
            }
        }
    }
    return 0
}
