// demo.baga — two OAuth nodes on loopback (apps-roadmap №10).
// Package imports (language §18.1): sandak.toml → -I parents.
//   cd app-product/oauthbaga && sandak build
//   baga -I ../.. -I .. demo.baga
// Env: OAUTH_PORT (proxy, default 18690), OAUTH_PROVIDER_PORT (default
// 18691), OAUTH_SECRET (JWT secret, default dev-secret).
// Then open http://127.0.0.1:18690/ and follow "log in".

import "server.baga"
import "std/str/str.baga"

fn demo_port(name: str, def: i64) -> i64 !IO {
    let s = env(name)?
    if s == "" {
        return def
    }
    let v = parse_int(s)
    if v <= 0 {
        return def
    }
    return v
}

fn main() -> i64 !Net !IO !Par !Time !Random {
    let proxy_port = demo_port("OAUTH_PORT", 18690)?
    let provider_port = demo_port("OAUTH_PROVIDER_PORT", 18691)?
    // migrate once here: two nodes migrating at boot would race on the
    // version insert (the serve loops still self-migrate when alone)
    let pg_on = env("OAUTH_PG")?
    if pg_on == "1" {
        if oauth_boot_migrate()? != 0 {
            return 1
        }
    }
    go_bg(oauth_provider_serve, cell2(provider_port, proxy_port))
    sleep_ms(200)
    print(concat("oauthbaga provider on http://127.0.0.1:", int_to_str(provider_port)))
    print(concat("oauthbaga proxy    on http://127.0.0.1:", int_to_str(proxy_port)))
    print("open the proxy URL and follow 'log in'")
    return oauth_proxy_serve(cell2(proxy_port, provider_port))?
}
