extern fn baga_wt_last_i64() -> i64 !IO
extern fn baga_wt_last_err() -> str !IO

// ── Status / host kind constants ─────────────────────────────────────────

fn WT_OK() -> i64 { return 0 }
fn WT_ERR() -> i64 { return 1 }
fn WT_TRAP() -> i64 { return 2 }

// Fixed host registry (gap W3 — not free Baga closures yet).
fn WT_HOST_LOG_VOID0() -> i64 { return 1 }
fn WT_HOST_I32_ID() -> i64 { return 2 }
fn WT_HOST_I32_ADD() -> i64 { return 3 }

// Value kinds for wt_result_kind (P3c).
fn WT_I32() -> i64 { return 0 }
fn WT_I64() -> i64 { return 1 }
fn WT_F32() -> i64 { return 2 }
fn WT_F64() -> i64 { return 3 }

// ── High-level helpers ───────────────────────────────────────────────────

fn wt_available() -> bool !IO {
    return baga_wt_available()? != 0
}

fn wt_engine_new() -> i64 !IO {
    return baga_wt_engine_new()?
}

fn wt_store_new(engine: i64) -> i64 !IO {
    return baga_wt_store_new(engine)?
}

fn wt_module_from_file(engine: i64, path: str) -> i64 !IO {
    return baga_wt_module_from_file(engine, path)?
}

// ── WAT → wasm (P3a) ───────────────────────────────────────────────────

// Compile WAT text to wasm bytes; buffer handle or 0 (wt_last_err).
fn wt_wat2wasm(wat: str) -> i64 !IO {
    return baga_wt_wat2wasm(wat)?
}

// Byte length of a wasm buffer; -1 on bad handle.
fn wt_buf_len(buf: i64) -> i64 !IO {
    let st = baga_wt_buf_len(buf)?
    if st != 0 {
        return -1
    }
    return baga_wt_last_i64()?
}

// Byte at index (0..255); -1 on bad handle or out of bounds.
fn wt_buf_get(buf: i64, i: i64) -> i64 !IO {
    let st = baga_wt_buf_get(buf, i)?
    if st != 0 {
        return -1
    }
    return baga_wt_last_i64()?
}

// Compile wasm bytes held in a buffer handle; module handle or 0.
fn wt_module_from_wasm(engine: i64, buf: i64) -> i64 !IO {
    return baga_wt_module_from_buf(engine, buf)?
}

// ── Module serialization (P3b) ─────────────────────────────────────────

// Serialize a compiled module to a fresh buffer handle; 0 on error.
fn wt_module_serialize(mod: i64) -> i64 !IO {
    return baga_wt_module_serialize(mod)?
}

// Serialize straight to a file path; 0 ok / 1 error (binary-safe).
fn wt_module_serialize_file(mod: i64, path: str) -> i64 !IO {
    return baga_wt_module_serialize_file(mod, path)?
}

// Rebuild a module from a serialized buffer; module handle or 0.
// Only safe on output of wt_module_serialize / wt_module_serialize_file.
fn wt_module_deserialize(engine: i64, buf: i64) -> i64 !IO {
    return baga_wt_module_deserialize(engine, buf)?
}

// Rebuild a module from a serialized file; module handle or 0.
fn wt_module_deserialize_file(engine: i64, path: str) -> i64 !IO {
    return baga_wt_module_deserialize_file(engine, path)?
}

fn wt_instance_new(store: i64, module: i64) -> i64 !IO {
    return baga_wt_instance_new(store, module)?
}

fn wt_linker_new(engine: i64) -> i64 !IO {
    return baga_wt_linker_new(engine)?
}

// Returns WT_OK / WT_ERR (not a handle).
fn wt_linker_define_host(linker: i64, module: str, name: str, host_kind: i64) -> i64 !IO {
    return baga_wt_linker_define_host(linker, module, name, host_kind)?
}

fn wt_linker_define_wasi(linker: i64) -> i64 !IO {
    return baga_wt_linker_define_wasi(linker)?
}

fn wt_store_set_wasi_inherit(store: i64) -> i64 !IO {
    return baga_wt_store_set_wasi_inherit(store)?
}

fn wt_linker_instantiate(linker: i64, store: i64, module: i64) -> i64 !IO {
    return baga_wt_linker_instantiate(linker, store, module)?
}

// ── Memory (P2) ──────────────────────────────────────────────────────────

fn wt_memory_get(store: i64, inst: i64, name: str) -> i64 !IO {
    return baga_wt_memory_get(store, inst, name)?
