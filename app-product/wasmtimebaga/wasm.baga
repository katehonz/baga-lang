fn wt_call_i32_2(store: i64, inst: i64, name: str, a: i64, b: i64) -> i64 !IO {
    let st = baga_wt_call_i32_2(store, inst, name, a, b)?
    if st != 0 {
        return -9223372036854775807
    }
    return baga_wt_last_i64()?
}

fn wt_call_i32_2_status(store: i64, inst: i64, name: str, a: i64, b: i64) -> i64 !IO {
    return baga_wt_call_i32_2(store, inst, name, a, b)?
}

fn wt_call_void_0_status(store: i64, inst: i64, name: str) -> i64 !IO {
    return baga_wt_call_void_0(store, inst, name)?
}

// ── Extended call shapes (P3c) ─────────────────────────────────────────

// Stage args for the next wt_call (up to 8). Each returns status (0 ok).
fn wt_args_clear() -> void !IO {
    baga_wt_args_clear()
}

fn wt_arg_i32(v: i64) -> i64 !IO {
    return baga_wt_args_push_i32(v)?
}

fn wt_arg_i64(v: i64) -> i64 !IO {
    return baga_wt_args_push_i64(v)?
}

fn wt_arg_f64(v: f64) -> i64 !IO {
    return baga_wt_args_push_f64(v)?
}

// Call an export with the staged args (consumed even on failure).
// Status: 0 ok / 1 error / 2 trap.
fn wt_call(store: i64, inst: i64, name: str, nresults: i64) -> i64 !IO {
    return baga_wt_call(store, inst, name, nresults)?
}

fn wt_result_count() -> i64 !IO {
    let st = baga_wt_result_count()?
    if st != 0 {
        return -1
    }
    return baga_wt_last_i64()?
}

fn wt_result_kind(i: i64) -> i64 !IO {
    let st = baga_wt_result_kind(i)?
    if st != 0 {
        return -1
    }
    return baga_wt_last_i64()?
}

fn wt_result_i64(i: i64) -> i64 !IO {
    let st = baga_wt_result_i64(i)?
    if st != 0 {
        return -1
    }
    return baga_wt_last_i64()?
}

// 0.0 and last_err on error (bad index or non-float result).
fn wt_result_f64(i: i64) -> f64 !IO {
    let st = baga_wt_result_f64(i)?
    if st != 0 {
        return 0.0
    }
    return baga_wt_last_f64()?
}

fn wt_last_f64() -> f64 !IO {
    return baga_wt_last_f64()?
}

// Load module from path, instantiate (no imports), call gcd-style export.
fn wt_run_i32_2(wasm_path: str, export_name: str, a: i64, b: i64) -> i64 !IO {
    let eng = wt_engine_new()?
    if eng == 0 {
        return -9223372036854775807
    }
    let store = wt_store_new(eng)?
    if store == 0 {
        wt_drop(eng)
        return -9223372036854775807
    }
    let mod = wt_module_from_file(eng, wasm_path)?
    if mod == 0 {
        wt_drop(store)
        wt_drop(eng)
        return -9223372036854775807
    }
    let inst = wt_instance_new(store, mod)?
    if inst == 0 {
        wt_drop(mod)
        wt_drop(store)
        wt_drop(eng)
        return -9223372036854775807
    }
    let st = wt_call_i32_2_status(store, inst, export_name, a, b)?
    let mut out = -9223372036854775807
    if st == 0 {
        out = wt_last_i64()?
    }
    wt_drop(inst)
    wt_drop(mod)
    wt_drop(store)
    wt_drop(eng)
    return out
}

// Compile WAT text at runtime (no fixture file), instantiate (no imports),
// call an i32 export taking two args. Same error sentinel as wt_run_i32_2.
fn wt_run_wat_i32_2(wat: str, export_name: str, a: i64, b: i64) -> i64 !IO {
    let eng = wt_engine_new()?
    if eng == 0 {
        return -9223372036854775807
    }
    let store = wt_store_new(eng)?
    if store == 0 {
        wt_drop(eng)
        return -9223372036854775807
    }
    let buf = wt_wat2wasm(wat)?
    if buf == 0 {
        wt_drop(store)
        wt_drop(eng)
        return -9223372036854775807
    }
    let mod = wt_module_from_wasm(eng, buf)?
    if mod == 0 {
        wt_drop(buf)
        wt_drop(store)
        wt_drop(eng)
        return -9223372036854775807
    }
    let inst = wt_instance_new(store, mod)?
    if inst == 0 {
        wt_drop(mod)
        wt_drop(buf)
        wt_drop(store)
        wt_drop(eng)
        return -9223372036854775807
    }
    let st = wt_call_i32_2_status(store, inst, export_name, a, b)?
    let mut out = -9223372036854775807
    if st == 0 {
        out = wt_last_i64()?
    }
    wt_drop(inst)
    wt_drop(mod)
    wt_drop(buf)
    wt_drop(store)
    wt_drop(eng)
    return out
}

// Hello path: define host LOG under module/name, instantiate, call void export.
// On success: host log is "hello from host" and host_call_count >= 1.
// Returns 0 ok, 1 error.
fn wt_run_hello(wasm_path: str, import_module: str, import_name: str, export_name: str) -> i64 !IO {
    wt_host_reset()
    let eng = wt_engine_new()?
    if eng == 0 {
        return 1
    }
    let store = wt_store_new(eng)?
    if store == 0 {
        wt_drop(eng)
        return 1
    }
    let mod = wt_module_from_file(eng, wasm_path)?
    if mod == 0 {
        wt_drop(store)
        wt_drop(eng)
        return 1
    }
    let linker = wt_linker_new(eng)?
    if linker == 0 {
        wt_drop(mod)
        wt_drop(store)
        wt_drop(eng)
        return 1
    }
    let def = wt_linker_define_host(linker, import_module, import_name, WT_HOST_LOG_VOID0())?
    if def != 0 {
        wt_drop(linker)
        wt_drop(mod)
        wt_drop(store)
        wt_drop(eng)
        return 1
    }
    let inst = wt_linker_instantiate(linker, store, mod)?
    if inst == 0 {
        wt_drop(linker)
        wt_drop(mod)
        wt_drop(store)
        wt_drop(eng)
        return 1
    }
    let st = wt_call_void_0_status(store, inst, export_name)?
    wt_drop(inst)
    wt_drop(linker)
    wt_drop(mod)
    wt_drop(store)
    wt_drop(eng)
    if st != 0 {
        return 1
    }
    return 0
}
