// demo.baga — wasmtimebaga демо рънър (P0 GCD + P1 Hello и останалите).
// Сценариите са в demo_scenarios.baga; фикстурите се търсят в
// fixtures/ или app-product/wasmtimebaga/fixtures/.

import "demo_scenarios.baga"
import "wasmtimebaga/wasm.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn resolve_fixture(name: str) -> str !IO {
    let mut path = concat("fixtures/", name)
    if file_exists(path)? == 0 {
        path = concat("app-product/wasmtimebaga/fixtures/", name)
    }
    return path
}


fn main() -> i64 !IO {
    if wt_available()? == false {
        eprintln("wasmtimebaga: shim not available")
        return 1
    }
    if demo_gcd()? != 0 {
        return 1
    }
    if demo_hello()? != 0 {
        return 1
    }
    if demo_add_host()? != 0 {
        return 1
    }
    if demo_memory()? != 0 {
        return 1
    }
    if demo_wasi()? != 0 {
        return 1
    }
    if demo_wat()? != 0 {
        return 1
    }
    if demo_serialize()? != 0 {
        return 1
    }
    if demo_calls()? != 0 {
        return 1
    }
    if demo_multi_mem()? != 0 {
        return 1
    }
    print("wasmtimebaga demo: ok")
    return 0
}
