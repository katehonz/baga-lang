// smoke.baga — live Wasmtime host checks (needs vendor + BAGA_* link env).
// Run via: ./run_test.sh (not default baga-test / make test).

import "wasmtimebaga/wasm.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn fail(msg: str) -> i64 !IO {
    eprintln(concat("wasmtime smoke FAIL: ", msg))
    return 1
}

fn fixture(name: str) -> str !IO {
    let mut path = concat("app-product/wasmtimebaga/fixtures/", name)
    if file_exists(path)? == 0 {
        path = concat("fixtures/", name)
    }
    return path
}

fn main() -> i64 !IO {
    if wt_available()? == false {
        return fail("shim unavailable")
    }

    // ── P0 gcd ──────────────────────────────────────────────────────────
    let path = fixture("gcd.wasm")?
    if file_exists(path)? == 0 {
        return fail(concat("missing ", path))
    }

    let g = wt_run_i32_2(path, "gcd", 6, 27)?
    if g != 3 {
        eprintln(wt_last_err()?)
        return fail(concat("gcd(6,27) got ", int_to_str(g)))
    }

    let g2 = wt_run_i32_2(path, "gcd", 48, 18)?
    if g2 != 6 {
        return fail(concat("gcd(48,18) got ", int_to_str(g2)))
    }

    // ── P1 hello (host import LOG) ──────────────────────────────────────
    let hpath = fixture("hello.wasm")?
    if file_exists(hpath)? == 0 {
        return fail(concat("missing ", hpath))
    }
    if wt_run_hello(hpath, "", "hello", "run")? != 0 {
        return fail(concat("hello: ", wt_last_err()?))
    }
    if wt_host_call_count()? < 1 {
        return fail("hello host not called")
    }
    let log = wt_host_log()?
    if len(log) < 5 {
        return fail(concat("bad host log: ", log))
    }

    // ── P1 linker + host i32 add ────────────────────────────────────────
    let apath = fixture("add_host.wasm")?
    if file_exists(apath)? == 0 {
        return fail(concat("missing ", apath))
    }
    wt_host_reset()
    let eng = wt_engine_new()?
    if eng == 0 {
        return fail(wt_last_err()?)
    }
    let store = wt_store_new(eng)?
    if store == 0 {
        return fail(wt_last_err()?)
    }
    let mod = wt_module_from_file(eng, apath)?
    if mod == 0 {
        return fail(wt_last_err()?)
    }
    let linker = wt_linker_new(eng)?
    if linker == 0 {
        return fail(wt_last_err()?)
    }
    if wt_linker_define_host(linker, "env", "add", WT_HOST_I32_ADD())? != 0 {
        return fail(wt_last_err()?)
    }
    let inst = wt_linker_instantiate(linker, store, mod)?
    if inst == 0 {
        return fail(wt_last_err()?)
    }
    if wt_call_i32_2_status(store, inst, "sum", 7, 5)? != 0 {
        return fail(wt_last_err()?)
    }
    if wt_last_i64()? != 12 {
        return fail(concat("sum got ", int_to_str(wt_last_i64()?)))
    }
    if wt_host_call_count()? < 1 {
        return fail("add host not called")
    }

    wt_drop(inst)
    wt_drop(linker)
    wt_drop(mod)
    wt_drop(store)
    wt_drop(eng)

    // ── P2 memory ───────────────────────────────────────────────────────
    let mpath = fixture("mem.wasm")?
    if file_exists(mpath)? == 0 {
        return fail(concat("missing ", mpath))
    }
    let eng2 = wt_engine_new()?
    let store2 = wt_store_new(eng2)?
    let mod2 = wt_module_from_file(eng2, mpath)?
    let inst2 = wt_instance_new(store2, mod2)?
    if inst2 == 0 {
        return fail(wt_last_err()?)
    }
    let mem = wt_memory_get(store2, inst2, "mem")?
    if mem == 0 {
        return fail(wt_last_err()?)
    }
    if wt_memory_size(store2, mem)? != 1 {
        return fail("memory pages != 1")
    }
    if wt_memory_data_size(store2, mem)? != 65536 {
        return fail("memory data_size != 65536")
    }
    if wt_memory_store8(store2, mem, 10, 7)? != 0 {
        return fail(wt_last_err()?)
    }
    if wt_memory_load8(store2, mem, 10)? != 7 {
        return fail("load8 mismatch")
    }
    if wt_call_i32_1_status(store2, inst2, "load", 10)? != 0 {
        return fail(wt_last_err()?)
    }
    if wt_last_i64()? != 7 {
        return fail("guest load mismatch")
    }
    if wt_memory_grow(store2, mem, 1)? != 1 {
        return fail("grow prev != 1")
    }
    if wt_memory_size(store2, mem)? != 2 {
        return fail("pages after grow != 2")
    }
    wt_drop(mem)
    wt_drop(inst2)
    wt_drop(mod2)
    wt_drop(store2)
    wt_drop(eng2)

    // ── P2 WASI ─────────────────────────────────────────────────────────
    let wpath = fixture("wasi_yield.wasm")?
    if file_exists(wpath)? == 0 {
        return fail(concat("missing ", wpath))
    }
    let eng3 = wt_engine_new()?
    let store3 = wt_store_new(eng3)?
    if wt_store_set_wasi_inherit(store3)? != 0 {
        return fail(wt_last_err()?)
    }
    let mod3 = wt_module_from_file(eng3, wpath)?
    let linker3 = wt_linker_new(eng3)?
    if wt_linker_define_wasi(linker3)? != 0 {
        return fail(wt_last_err()?)
    }
    let inst3 = wt_linker_instantiate(linker3, store3, mod3)?
    if inst3 == 0 {
        return fail(wt_last_err()?)
    }
    if wt_call_i32_0_status(store3, inst3, "run")? != 0 {
        return fail(wt_last_err()?)
    }
    if wt_last_i64()? != 0 {
        return fail("sched_yield errno != 0")
    }
    wt_drop(inst3)
    wt_drop(linker3)
    wt_drop(mod3)
    wt_drop(store3)
    wt_drop(eng3)

    // ── P3a WAT → wasm + module from buffer ─────────────────────────────
    let wat = "(module (func (export \"add\") (param i32 i32) (result i32) local.get 0 local.get 1 i32.add))"
    let buf = wt_wat2wasm(wat)?
    if buf == 0 {
        return fail(concat("wat2wasm: ", wt_last_err()?))
    }
    let n = wt_buf_len(buf)?
    if n < 8 {
        return fail(concat("wat2wasm len ", int_to_str(n)))
    }
    // magic "\0asm"
    if wt_buf_get(buf, 0)? != 0 {
        return fail("magic byte 0")
    }
    if wt_buf_get(buf, 1)? != 97 {
        return fail("magic byte 1")
    }
    if wt_buf_get(buf, 2)? != 115 {
        return fail("magic byte 2")
    }
    if wt_buf_get(buf, 3)? != 109 {
        return fail("magic byte 3")
    }
    // out-of-bounds read
    if wt_buf_get(buf, n)? != -1 {
        return fail("buf_get OOB should be -1")
    }
    if wt_buf_get(buf, -1)? != -1 {
        return fail("buf_get negative should be -1")
    }

    // module from buffer → instance → call
    let eng4 = wt_engine_new()?
    let store4 = wt_store_new(eng4)?
    let mod4 = wt_module_from_wasm(eng4, buf)?
    if mod4 == 0 {
        return fail(concat("module_from_wasm: ", wt_last_err()?))
    }
    let inst4 = wt_instance_new(store4, mod4)?
    if inst4 == 0 {
        return fail(concat("wat instance: ", wt_last_err()?))
    }
    if wt_call_i32_2_status(store4, inst4, "add", 7, 5)? != 0 {
        return fail(concat("wat call add: ", wt_last_err()?))
    }
    if wt_last_i64()? != 12 {
        return fail(concat("wat add got ", int_to_str(wt_last_i64()?)))
    }
    wt_drop(inst4)
    wt_drop(mod4)
    wt_drop(store4)
    wt_drop(eng4)
    wt_drop(buf)
    wt_drop(buf) // idempotent

    // bad WAT → 0 + error message
    let bad = wt_wat2wasm("(module (func broken")?
    if bad != 0 {
        return fail("bad wat should not compile")
    }
    if len(wt_last_err()?) == 0 {
        return fail("bad wat should set last_err")
    }
    // bad handle accessors
    if wt_buf_len(999)? != -1 {
        return fail("buf_len bad handle should be -1")
    }

    // high-level one-shot
    let r = wt_run_wat_i32_2(wat, "add", 30, 12)?
    if r != 42 {
        return fail(concat("run_wat got ", int_to_str(r)))
    }

    // ── P3b module serialize/deserialize ────────────────────────────────
    let spath = fixture("gcd.wasm")?
    let eng5 = wt_engine_new()?
    let smod = wt_module_from_file(eng5, spath)?
    if smod == 0 {
        return fail(concat("serialize setup: ", wt_last_err()?))
    }

    // serialize → buffer → deserialize → same behaviour
    let sbuf = wt_module_serialize(smod)?
    if sbuf == 0 {
        return fail(concat("module_serialize: ", wt_last_err()?))
    }
    if wt_buf_len(sbuf)? <= 0 {
        return fail("serialized buffer empty")
    }
    let smod2 = wt_module_deserialize(eng5, sbuf)?
    if smod2 == 0 {
        return fail(concat("module_deserialize: ", wt_last_err()?))
    }
    let sstore = wt_store_new(eng5)?
    let sinst = wt_instance_new(sstore, smod2)?
    if sinst == 0 {
        return fail(concat("deserialized instance: ", wt_last_err()?))
    }
    if wt_call_i32_2_status(sstore, sinst, "gcd", 6, 27)? != 0 {
        return fail(concat("deserialized gcd: ", wt_last_err()?))
    }
    if wt_last_i64()? != 3 {
        return fail("deserialized gcd != 3")
    }
    wt_drop(sinst)
    wt_drop(sstore)
    wt_drop(smod2)

    // deserialize must reject non-artifact bytes (here: raw wasm source)
    let wbuf = wt_wat2wasm(wat)?
    if wbuf == 0 {
        return fail(concat("negative setup wat2wasm: ", wt_last_err()?))
    }
    let badmod = wt_module_deserialize(eng5, wbuf)?
    if badmod != 0 {
        return fail("deserialize accepted non-artifact bytes")
    }
    if len(wt_last_err()?) == 0 {
        return fail("deserialize should set last_err")
    }
    wt_drop(wbuf)

    // serialize_file → deserialize_file (disk-cache round trip)
    let cache = "/tmp/wtb_smoke.serialized"
    if wt_module_serialize_file(smod, cache)? != 0 {
        return fail(concat("serialize_file: ", wt_last_err()?))
    }
    let smod3 = wt_module_deserialize_file(eng5, cache)?
    if smod3 == 0 {
        return fail(concat("deserialize_file: ", wt_last_err()?))
    }
    let sstore3 = wt_store_new(eng5)?
    let sinst3 = wt_instance_new(sstore3, smod3)?
    if sinst3 == 0 {
        return fail(concat("file instance: ", wt_last_err()?))
    }
    if wt_call_i32_2_status(sstore3, sinst3, "gcd", 48, 18)? != 0 {
        return fail(concat("file gcd: ", wt_last_err()?))
    }
    if wt_last_i64()? != 6 {
        return fail("file gcd != 6")
    }
    wt_drop(sinst3)
    wt_drop(sstore3)
    wt_drop(smod3)
    unlink(cache)?
    wt_drop(sbuf)
    wt_drop(smod)
    wt_drop(eng5)

    // ── P3c extended call shapes ────────────────────────────────────────
    let cpath = fixture("callshapes.wasm")?
    if file_exists(cpath)? == 0 {
        return fail(concat("missing ", cpath))
    }
    let eng6 = wt_engine_new()?
    let store6 = wt_store_new(eng6)?
    let mod6 = wt_module_from_file(eng6, cpath)?
    let inst6 = wt_instance_new(store6, mod6)?
    if inst6 == 0 {
        return fail(concat("callshapes instance: ", wt_last_err()?))
    }

    // divmod(7, 3) → (2, 1) — multi-value
    wt_args_clear()
    if wt_arg_i32(7)? != 0 {
        return fail(wt_last_err()?)
    }
    if wt_arg_i32(3)? != 0 {
        return fail(wt_last_err()?)
    }
    if wt_call(store6, inst6, "divmod", 2)? != 0 {
        return fail(concat("call divmod: ", wt_last_err()?))
    }
    if wt_result_count()? != 2 {
        return fail("divmod result_count != 2")
    }
    if wt_result_kind(0)? != WT_I32() {
        return fail("divmod kind[0] != i32")
    }
    if wt_result_i64(0)? != 2 {
        return fail("divmod quotient != 2")
    }
    if wt_result_i64(1)? != 1 {
        return fail("divmod remainder != 1")
    }

    // norm(3.0, 4.0) → 5.0 — f64 params + result
    wt_args_clear()
    if wt_arg_f64(3.0)? != 0 {
        return fail(wt_last_err()?)
    }
    if wt_arg_f64(4.0)? != 0 {
        return fail(wt_last_err()?)
    }
    if wt_call(store6, inst6, "norm", 1)? != 0 {
        return fail(concat("call norm: ", wt_last_err()?))
    }
    if wt_result_kind(0)? != WT_F64() {
        return fail("norm kind != f64")
    }
    if wt_result_f64(0)? != 5.0 {
        return fail("norm != 5.0")
    }
    // typed accessor mismatch: i64 view of an f64 result
    if wt_result_i64(0)? != -1 {
        return fail("result_i64 on f64 should be -1")
    }

    // add64(3000000000, 3000000000) → 6000000000 — i64 beyond i32 range
    wt_args_clear()
    if wt_arg_i64(3000000000)? != 0 {
        return fail(wt_last_err()?)
    }
    if wt_arg_i64(3000000000)? != 0 {
        return fail(wt_last_err()?)
    }
    if wt_call(store6, inst6, "add64", 1)? != 0 {
        return fail(concat("call add64: ", wt_last_err()?))
    }
    if wt_result_kind(0)? != WT_I64() {
        return fail("add64 kind != i64")
    }
    if wt_result_i64(0)? != 6000000000 {
        return fail(concat("add64 got ", int_to_str(wt_result_i64(0)?)))
    }

    // arg type mismatch: i32 args into an f64 function → error, not trap
    wt_args_clear()
    if wt_arg_i32(1)? != 0 {
        return fail(wt_last_err()?)
    }
    let mm = wt_call(store6, inst6, "norm", 1)?
    if mm == 0 {
        return fail("arg type mismatch should fail")
    }
    if len(wt_last_err()?) == 0 {
        return fail("arg type mismatch should set last_err")
    }

    // result accessors out of bounds
    if wt_result_i64(5)? != -1 {
        return fail("result_i64 OOB should be -1")
    }
    if wt_result_kind(-1)? != -1 {
        return fail("result_kind negative should be -1")
    }

    wt_drop(inst6)
    wt_drop(mod6)
    wt_drop(store6)
    wt_drop(eng6)

    // ── P3d multi-memory ────────────────────────────────────────────────
    let mpath2 = fixture("multi_mem.wasm")?
    if file_exists(mpath2)? == 0 {
        return fail(concat("missing ", mpath2))
    }
    let eng7 = wt_engine_new()?
    let store7 = wt_store_new(eng7)?
    let mod7 = wt_module_from_file(eng7, mpath2)?
    let inst7 = wt_instance_new(store7, mod7)?
    if inst7 == 0 {
        return fail(concat("multi_mem instance: ", wt_last_err()?))
    }
    let ma = wt_memory_get(store7, inst7, "mem_a")?
    if ma == 0 {
        return fail(concat("memory_get mem_a: ", wt_last_err()?))
    }
    let mb = wt_memory_get(store7, inst7, "mem_b")?
    if mb == 0 {
        return fail(concat("memory_get mem_b: ", wt_last_err()?))
    }
    if wt_memory_size(store7, ma)? != 1 {
        return fail("mem_a pages != 1")
    }
    if wt_memory_size(store7, mb)? != 2 {
        return fail("mem_b pages != 2")
    }
    if wt_memory_store8(store7, ma, 0, 11)? != 0 {
        return fail(wt_last_err()?)
    }
    if wt_memory_store8(store7, mb, 0, 22)? != 0 {
        return fail(wt_last_err()?)
    }
    if wt_memory_load8(store7, ma, 0)? != 11 {
        return fail("mem_a[0] != 11")
    }
    if wt_memory_load8(store7, mb, 0)? != 22 {
        return fail("mem_b[0] != 22")
    }
    wt_drop(mb)
    wt_drop(ma)
    wt_drop(inst7)
    wt_drop(mod7)
    wt_drop(store7)
    wt_drop(eng7)

    print("wasmtime smoke: all passed")
    return 0
}
