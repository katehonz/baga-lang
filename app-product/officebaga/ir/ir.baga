// ir/ir.baga — format-agnostic document snapshot (honest subset).
// kind: 1=word, 2=sheet. text holds plain paragraphs or TSV cells.

import "../core/detect.baga"
import "../docx/read.baga"
import "../xlsx/read.baga"
import "../odf/read.baga"
import "../opc/package.baga"
import "../convert/md.baga"
import "std/str/str.baga"

struct IrDoc {
    kind: i64,
    title: str,
    text: str,
    ok: i64,
    err: str
}

fn IR_WORD() -> i64 { return 1 }
fn IR_SHEET() -> i64 { return 2 }

fn ir_empty() -> IrDoc {
    return IrDoc { kind: 0, title: "", text: "", ok: 0, err: "" }
}

fn ir_fail(msg: str) -> IrDoc {
    return IrDoc { kind: 0, title: "", text: "", ok: 0, err: msg }
}

fn ir_from_package(pkg: OpcPackage, fmt: i64) -> IrDoc {
    if pkg.ok == 0 {
        return ir_fail(pkg.err)
    }
    if fmt == OFFICE_DOCX() {
        return IrDoc {
            kind: IR_WORD(),
            title: "",
            text: docx_plain_text(pkg),
            ok: 1,
            err: ""
        }
    }
    if fmt == OFFICE_ODT() {
        return IrDoc {
            kind: IR_WORD(),
            title: "",
            text: odt_plain_text(pkg),
            ok: 1,
            err: ""
        }
    }
    if fmt == OFFICE_XLSX() {
        return IrDoc {
            kind: IR_SHEET(),
            title: "",
            text: xlsx_plain_text(pkg),
            ok: 1,
            err: ""
        }
    }
    if fmt == OFFICE_ODS() {
        return IrDoc {
            kind: IR_SHEET(),
            title: "",
            text: ods_plain_text(pkg),
            ok: 1,
            err: ""
        }
    }
    return ir_fail("ir: unsupported format")
}

fn ir_plain_text(ir: IrDoc) -> str {
    if ir.ok == 0 {
        return ""
    }
    return ir.text
}

fn ir_to_markdown(ir: IrDoc) -> str {
    if ir.ok == 0 {
        return ""
    }
    if ir.kind == IR_SHEET() {
        return office_md_from_tsv(ir.text)
    }
    return office_md_from_paras(ir.text)
}
