// office.baga — unified Office API (docx/xlsx/odt/ods + edit; legacy ole probe).
//
// Design: docs/superpowers/specs/2026-08-06-officebaga-design.md
// Plan:   docs/superpowers/plans/2026-08-06-officebaga.md

import "opc/package.baga"
import "core/detect.baga"
import "core/io.baga"
import "docx/read.baga"
import "docx/write.baga"
import "xlsx/read.baga"
import "xlsx/write.baga"
import "odf/read.baga"
import "odf/write.baga"
import "convert/md.baga"
import "convert/from_md.baga"
import "ir/ir.baga"
import "edit/edit.baga"
import "ole/cfb.baga"
import "zipbaga/archive.baga"
import "std/str/str.baga"

struct Document {
    pkg: OpcPackage,
    format: i64,
    path: str,
    raw: bytes,
    is_ole: i64
}

struct OfficeResult {
    ok: i64,
    err: str,
    doc: Document
}

fn office_version() -> str {
    return "0.2.0"
}

fn office_empty_doc() -> Document {
    return Document {
        pkg: opc_err(""),
        format: OFFICE_UNKNOWN(),
        path: "",
        raw: bytes_new(0),
        is_ole: 0
    }
}

fn office_fail(msg: str) -> OfficeResult {
    return OfficeResult { ok: 0, err: msg, doc: office_empty_doc() }
}

fn office_ok(doc: Document) -> OfficeResult {
    return OfficeResult { ok: 1, err: "", doc: doc }
}

fn office_detect_ole(cfb: CfbFile) -> i64 {
    let names = cfb_list(cfb)
    let mut i: i64 = 0
    while i < vec_len(names) {
        let n = vec_get(names, i)
        if n == "WordDocument" {
            return OFFICE_DOC()
        }
        if n == "Workbook" || n == "Book" {
            return OFFICE_XLS()
        }
        i = i + 1
    }
    return OFFICE_UNKNOWN()
}

fn office_open_bytes(data: bytes) -> OfficeResult {
    // Legacy OLE2 first (DOC/XLS)
    if cfb_is_ole(data) {
        let cfb = cfb_open_bytes(data)
        if cfb.ok == 0 {
            return office_fail(cfb.err)
        }
        let fmt = office_detect_ole(cfb)
        if fmt == OFFICE_UNKNOWN() {
            return office_fail("office: OLE2 container without Word/Excel stream")
        }
        return office_ok(Document {
            pkg: opc_err(""),
            format: fmt,
            path: "",
            raw: data,
            is_ole: 1
        })
    }
    let pkg = opc_open_bytes(data)
    if pkg.ok == 0 {
        return office_fail(pkg.err)
    }
    let fmt = office_detect_pkg(pkg)
    if fmt == OFFICE_UNKNOWN() {
        return office_fail("office: unsupported or presentation format (pptx/odp not supported)")
    }
    return office_ok(Document {
        pkg: pkg,
        format: fmt,
        path: "",
        raw: data,
        is_ole: 0
    })
}

fn office_open(path: str) -> OfficeResult !IO {
    let data = office_read_bytes(path)?
    if bytes_len(data) == 0 {
        return office_fail(concat("office: empty or unreadable file: ", path))
    }
    let r = office_open_bytes(data)
    if r.ok == 0 {
        return r
    }
    return office_ok(Document {
        pkg: r.doc.pkg,
        format: r.doc.format,
        path: path,
        raw: r.doc.raw,
        is_ole: r.doc.is_ole
    })
}

fn office_format(d: Document) -> i64 {
    return d.format
}

fn office_format_of(d: Document) -> str {
    return office_format_name(d.format)
}

fn office_to_ir(d: Document) -> IrDoc {
    if d.is_ole == 1 {
        let t = office_plain_text(d)
        let mut kind = IR_WORD()
        if d.format == OFFICE_XLS() {
            kind = IR_SHEET()
        }
        return IrDoc { kind: kind, title: "", text: t, ok: 1, err: "" }
    }
    if d.pkg.ok == 0 {
        return ir_fail(d.pkg.err)
    }
    return ir_from_package(d.pkg, d.format)
}

fn office_plain_text(d: Document) -> str {
    if d.is_ole == 1 {
        let cfb = cfb_open_bytes(d.raw)
        if cfb.ok == 0 {
            return ""
        }
        // Prefer primary streams
        if d.format == OFFICE_DOC() {
            let w = cfb_read(cfb, "WordDocument")
            if w.ok == 1 {
                return cfb_ascii_text(w.data)
            }
        }
        if d.format == OFFICE_XLS() {
            let mut s = cfb_read(cfb, "Workbook")
            if s.ok == 0 {
                s = cfb_read(cfb, "Book")
            }
            if s.ok == 1 {
                return cfb_ascii_text(s.data)
            }
        }
        return ""
    }
    return ir_plain_text(office_to_ir(d))
}

fn office_to_markdown(d: Document) -> str {
    if d.is_ole == 1 {
        return office_md_from_paras(office_plain_text(d))
    }
    return ir_to_markdown(office_to_ir(d))
}

// --- create ---

fn office_docx_bytes(title: str, body: str) -> bytes {
    return docx_create_bytes(title, body)
}

fn office_xlsx_bytes(tsv: str) -> bytes {
    return xlsx_create_from_tsv(tsv)
}

fn office_odt_bytes(title: str, body: str) -> bytes {
    return odt_create_bytes(title, body)
}

fn office_ods_bytes(tsv: str) -> bytes {
    return ods_create_bytes(tsv)
}

fn office_md_to_docx_bytes(md: str) -> bytes {
    return md_to_docx_bytes(md)
}

fn office_write_docx(path: str, title: str, body: str) -> OfficeResult !IO {
    let data = docx_create_bytes(title, body)
    let rc = office_write_bytes(path, data)?
    if rc != 0 {
        return office_fail(concat("office: write failed: ", path))
    }
    return office_open(path)?
}

fn office_write_xlsx(path: str, tsv: str) -> OfficeResult !IO {
    let data = xlsx_create_from_tsv(tsv)
    let rc = office_write_bytes(path, data)?
    if rc != 0 {
        return office_fail(concat("office: write failed: ", path))
    }
    return office_open(path)?
}

fn office_write_odt(path: str, title: str, body: str) -> OfficeResult !IO {
    let data = odt_create_bytes(title, body)
    let rc = office_write_bytes(path, data)?
    if rc != 0 {
        return office_fail(concat("office: write failed: ", path))
    }
    return office_open(path)?
}

fn office_write_ods(path: str, tsv: str) -> OfficeResult !IO {
    let data = ods_create_bytes(tsv)
    let rc = office_write_bytes(path, data)?
    if rc != 0 {
        return office_fail(concat("office: write failed: ", path))
    }
    return office_open(path)?
}

fn office_write_md_docx(path: str, md: str) -> OfficeResult !IO {
    let data = md_to_docx_bytes(md)
    let rc = office_write_bytes(path, data)?
    if rc != 0 {
        return office_fail(concat("office: write failed: ", path))
    }
    return office_open(path)?
}

// --- edit (ZIP packages only) ---

fn office_to_bytes(d: Document) -> ZipPart {
    if d.is_ole == 1 {
        return ZipPart { ok: 1, err: "", data: d.raw }
    }
    return office_pkg_bytes(d.pkg)
}

fn office_set_part(d: Document, path: str, data: bytes) -> OfficeResult {
    if d.is_ole == 1 {
        return office_fail("office: cannot set part on OLE2 document")
    }
    let p = office_set_part_pkg(d.pkg, path, data)
    if p.ok == 0 {
        return office_fail(p.err)
    }
    let r = office_open_bytes(p.data)
    if r.ok == 0 {
        return r
    }
    return office_ok(Document {
        pkg: r.doc.pkg,
        format: r.doc.format,
        path: d.path,
        raw: p.data,
        is_ole: 0
    })
}

fn office_replace_text(d: Document, from: str, to: str) -> OfficeResult {
    if d.is_ole == 1 {
        return office_fail("office: cannot replace text in OLE2 (binary) document")
    }
    let p = office_replace_text_pkg(d.pkg, d.format, from, to)
    if p.ok == 0 {
        return office_fail(p.err)
    }
    let r = office_open_bytes(p.data)
    if r.ok == 0 {
        return r
    }
    return office_ok(Document {
        pkg: r.doc.pkg,
        format: r.doc.format,
        path: d.path,
        raw: p.data,
        is_ole: 0
    })
}

fn office_save(d: Document, path: str) -> OfficeResult !IO {
    let p = office_to_bytes(d)
    if p.ok == 0 {
        return office_fail(p.err)
    }
    let rc = office_write_bytes(path, p.data)?
    if rc != 0 {
        return office_fail(concat("office: save failed: ", path))
    }
    return office_open(path)?
}

// OLE helpers
fn office_ole_streams(d: Document) -> Vec<str> {
    if d.is_ole == 0 {
        return vec_new()
    }
    let cfb = cfb_open_bytes(d.raw)
    if cfb.ok == 0 {
        return vec_new()
    }
    return cfb_list(cfb)
}
