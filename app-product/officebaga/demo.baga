// demo.baga — Office CLI (documents only: docx/xlsx/odt/ods).
//
//   baga -I ../.. -I .. demo.baga text|md|info <file>
//   baga -I ../.. -I .. demo.baga create-docx out.docx Title Body...
//   baga -I ../.. -I .. demo.baga create-xlsx out.xlsx row1 row2...
//   baga -I ../.. -I .. demo.baga create-odt out.odt Title Body...
//   baga -I ../.. -I .. demo.baga create-ods out.ods row1 row2...
//   baga -I ../.. -I .. demo.baga md-docx out.docx notes.md

import "office.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn usage() {
    eprintln("usage: demo.baga text|md|info|streams <file>")
    eprintln("       demo.baga create-docx <out.docx> <title> <body...>")
    eprintln("       demo.baga create-xlsx <out.xlsx> <rows...>")
    eprintln("       demo.baga create-odt <out.odt> <title> <body...>")
    eprintln("       demo.baga create-ods <out.ods> <rows...>")
    eprintln("       demo.baga md-docx <out.docx> <file.md>")
    eprintln("       demo.baga replace <file> <from> <to> [out]")
}

fn join_args_from(start: i64, sep: str) -> str {
    let mut out = ""
    let mut i = start
    while i < arg_count() {
        if i > start {
            out = concat(out, sep)
        }
        out = concat(out, arg(i))
        i = i + 1
    }
    return out
}

fn main() -> i64 !IO {
    if arg_count() < 1 {
        usage()
        return 1
    }
    let cmd = arg(0)
    if cmd == "text" || cmd == "md" || cmd == "info" || cmd == "streams" {
        if arg_count() < 2 {
            usage()
            return 1
        }
        let path = arg(1)
        let r = office_open(path)?
        if r.ok == 0 {
            eprintln(r.err)
            return 1
        }
        if cmd == "info" {
            print(concat("format: ", office_format_of(r.doc)))
            print(concat("path: ", path))
            return 0
        }
        if cmd == "streams" {
            let ss = office_ole_streams(r.doc)
            let mut i: i64 = 0
            while i < vec_len(ss) {
                print(vec_get(ss, i))
                i = i + 1
            }
            return 0
        }
        if cmd == "md" {
            print(office_to_markdown(r.doc))
            return 0
        }
        print(office_plain_text(r.doc))
        return 0
    }
    if cmd == "replace" {
        if arg_count() < 4 {
            usage()
            return 1
        }
        let path = arg(1)
        let from = arg(2)
        let to = arg(3)
        let mut outp = path
        if arg_count() >= 5 {
            outp = arg(4)
        }
        let r = office_open(path)?
        if r.ok == 0 {
            eprintln(r.err)
            return 1
        }
        let e = office_replace_text(r.doc, from, to)
        if e.ok == 0 {
            eprintln(e.err)
            return 1
        }
        let s = office_save(e.doc, outp)?
        if s.ok == 0 {
            eprintln(s.err)
            return 2
        }
        print(concat("wrote ", outp))
        return 0
    }
    if cmd == "create-docx" {
        if arg_count() < 3 {
            usage()
            return 1
        }
        let r = office_write_docx(arg(1), arg(2), join_args_from(3, "\n"))?
        if r.ok == 0 {
            eprintln(r.err)
            return 2
        }
        print(concat("wrote ", arg(1)))
        return 0
    }
    if cmd == "create-xlsx" {
        if arg_count() < 3 {
            usage()
            return 1
        }
        let r = office_write_xlsx(arg(1), join_args_from(2, "\n"))?
        if r.ok == 0 {
            eprintln(r.err)
            return 2
        }
        print(concat("wrote ", arg(1)))
        return 0
    }
    if cmd == "create-odt" {
        if arg_count() < 3 {
            usage()
            return 1
        }
        let r = office_write_odt(arg(1), arg(2), join_args_from(3, "\n"))?
        if r.ok == 0 {
            eprintln(r.err)
            return 2
        }
        print(concat("wrote ", arg(1)))
        return 0
    }
    if cmd == "create-ods" {
        if arg_count() < 3 {
            usage()
            return 1
        }
        let r = office_write_ods(arg(1), join_args_from(2, "\n"))?
        if r.ok == 0 {
            eprintln(r.err)
            return 2
        }
        print(concat("wrote ", arg(1)))
        return 0
    }
    if cmd == "md-docx" {
        if arg_count() < 3 {
            usage()
            return 1
        }
        let md = read_file(arg(2))?
        let r = office_write_md_docx(arg(1), md)?
        if r.ok == 0 {
            eprintln(r.err)
            return 2
        }
        print(concat("wrote ", arg(1)))
        return 0
    }
    usage()
    return 1
}
