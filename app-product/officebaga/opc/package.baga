// package.baga — open an OPC/ODF ZIP package and fetch parts as bytes/str.

import "zipbaga/archive.baga"
import "std/str/str.baga"

struct OpcPackage {
    zip: ZipArchive,
    ok: i64,
    err: str
}

fn opc_err(msg: str) -> OpcPackage {
    return OpcPackage {
        zip: ZipArchive {
            data: bytes_new(0),
            names: vec_new(),
            methods: vec_new(),
            crcs: vec_new(),
            comp_sizes: vec_new(),
            uncomp_sizes: vec_new(),
            offsets: vec_new(),
            ok: 0,
            err: msg
        },
        ok: 0,
        err: msg
    }
}

fn opc_open_bytes(data: bytes) -> OpcPackage {
    let z = zip_open_bytes(data)
    if z.ok == 0 {
        return opc_err(z.err)
    }
    return OpcPackage { zip: z, ok: 1, err: "" }
}

fn opc_has(pkg: OpcPackage, path: str) -> bool {
    if pkg.ok == 0 {
        return false
    }
    return zip_find(pkg.zip, path) >= 0
}

fn opc_part_bytes(pkg: OpcPackage, path: str) -> ZipPart {
    if pkg.ok == 0 {
        return ZipPart { ok: 0, err: pkg.err, data: bytes_new(0) }
    }
    return zip_read(pkg.zip, path)
}

// XML parts are UTF-8 without NULs — safe for xml_parser via str_of_bytes.
fn opc_part_str(pkg: OpcPackage, path: str) -> ZipPart {
    return opc_part_bytes(pkg, path)
}

fn opc_part_text(pkg: OpcPackage, path: str) -> str {
    let p = opc_part_bytes(pkg, path)
    if p.ok == 0 {
        return ""
    }
    return str_of_bytes(p.data)
}

fn opc_count(pkg: OpcPackage) -> i64 {
    if pkg.ok == 0 {
        return 0
    }
    return zip_count(pkg.zip)
}

fn opc_entry_name(pkg: OpcPackage, i: i64) -> str {
    return zip_name(pkg.zip, i)
}
