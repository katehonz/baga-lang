// names.baga — OOXML/ODF element local-name helpers (xmlbaga has no ns stack).

import "std/str/str.baga"

// Last local part after ':'; "w:t" → "t", "text:p" → "p", "t" → "t".
fn office_local(name: str) -> str {
    let n = len(name)
    let mut i = n - 1
    while i >= 0 {
        if char_at(name, i) == 58 {
            return substr(name, i + 1, n)
        }
        if i == 0 {
            return name
        }
        i = i - 1
    }
    return name
}

fn office_is_local(name: str, local: str) -> bool {
    return office_local(name) == local
}

// Match full prefixed name or bare local (tolerant).
fn office_name_is(name: str, want: str) -> bool {
    if name == want {
        return true
    }
    return office_local(name) == office_local(want)
}
