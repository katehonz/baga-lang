// detect.baga — format sniff for Office packages (no presentations).

import "../opc/package.baga"
import "std/str/str.baga"

// Format tags
fn OFFICE_UNKNOWN() -> i64 { return 0 }
fn OFFICE_DOCX() -> i64 { return 1 }
fn OFFICE_XLSX() -> i64 { return 2 }
fn OFFICE_ODT() -> i64 { return 3 }
fn OFFICE_ODS() -> i64 { return 4 }
fn OFFICE_DOC() -> i64 { return 5 }   // legacy OLE Word
fn OFFICE_XLS() -> i64 { return 6 }   // legacy OLE Excel

fn office_format_name(fmt: i64) -> str {
    if fmt == 1 { return "docx" }
    if fmt == 2 { return "xlsx" }
    if fmt == 3 { return "odt" }
    if fmt == 4 { return "ods" }
    if fmt == 5 { return "doc" }
    if fmt == 6 { return "xls" }
    return "unknown"
}

fn office_detect_pkg(pkg: OpcPackage) -> i64 {
    if pkg.ok == 0 {
        return OFFICE_UNKNOWN()
    }
    // OOXML
    if opc_has(pkg, "word/document.xml") {
        return OFFICE_DOCX()
    }
    if opc_has(pkg, "xl/workbook.xml") {
        return OFFICE_XLSX()
    }
    // Presentations deliberately ignored (pptx / odp)
    if opc_has(pkg, "ppt/presentation.xml") {
        return OFFICE_UNKNOWN()
    }
    // ODF via mimetype part (must be first entry, stored) or content.xml heuristics
    if opc_has(pkg, "mimetype") {
        let mt = opc_part_text(pkg, "mimetype")
        if str_find(mt, "opendocument.text") >= 0 {
            return OFFICE_ODT()
        }
        if str_find(mt, "opendocument.spreadsheet") >= 0 {
            return OFFICE_ODS()
        }
        if str_find(mt, "opendocument.presentation") >= 0 {
            return OFFICE_UNKNOWN()
        }
    }
    if opc_has(pkg, "content.xml") {
        // fallback: look for spreadsheet markers in content
        let c = opc_part_text(pkg, "content.xml")
        if str_find(c, "office:spreadsheet") >= 0 || str_find(c, "table:table") >= 0 {
            return OFFICE_ODS()
        }
        return OFFICE_ODT()
    }
    return OFFICE_UNKNOWN()
}

fn office_detect_path_hint(path: str) -> i64 {
    let n = len(path)
    if n >= 5 {
        let ext = substr(path, n - 5, n)
        if ext == ".docx" || ext == ".DOCX" { return OFFICE_DOCX() }
        if ext == ".xlsx" || ext == ".XLSX" { return OFFICE_XLSX() }
    }
    if n >= 4 {
        let ext4 = substr(path, n - 4, n)
        if ext4 == ".odt" || ext4 == ".ODT" { return OFFICE_ODT() }
        if ext4 == ".ods" || ext4 == ".ODS" { return OFFICE_ODS() }
        if ext4 == ".doc" || ext4 == ".DOC" { return OFFICE_DOC() }
        if ext4 == ".xls" || ext4 == ".XLS" { return OFFICE_XLS() }
    }
    return OFFICE_UNKNOWN()
}
