// docx/write.baga — minimal valid DOCX (store ZIP) from title + body paragraphs.

import "zipbaga/archive.baga"
import "xmlbaga/xml.baga"
import "bufbaga/buf.baga"
import "std/str/str.baga"

fn docx_esc(s: str) -> str {
    return xml_escape_text(s)
}

// Split body on newlines into paragraphs; empty lines kept as empty <w:p/>.
fn docx_body_xml(title: str, body: str) -> str {
    let mut b = buf_new()
    b = buf_push(b, "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>")
    b = buf_push(b, "<w:document xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\">")
    b = buf_push(b, "<w:body>")
    if title != "" {
        b = buf_push(b, "<w:p><w:r><w:t>")
        b = buf_push(b, docx_esc(title))
        b = buf_push(b, "</w:t></w:r></w:p>")
    }
    let lines = str_split(body, "\n")
    let mut i: i64 = 0
    while i < vec_len(lines) {
        let line = vec_get(lines, i)
        b = buf_push(b, "<w:p><w:r><w:t xml:space=\"preserve\">")
        b = buf_push(b, docx_esc(line))
        b = buf_push(b, "</w:t></w:r></w:p>")
        i = i + 1
    }
    b = buf_push(b, "</w:body></w:document>")
    return buf_str(b)
}

fn docx_content_types() -> str {
    return "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?><Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\"><Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/><Default Extension=\"xml\" ContentType=\"application/xml\"/><Override PartName=\"/word/document.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml\"/></Types>"
}

fn docx_root_rels() -> str {
    return "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"word/document.xml\"/></Relationships>"
}

fn docx_doc_rels() -> str {
    return "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"></Relationships>"
}

// Returns ZIP bytes of a minimal .docx
fn docx_create_bytes(title: str, body: str) -> bytes {
    let names = vec_new()
    let parts = vec_new()
    vec_push(names, "[Content_Types].xml")
    vec_push(parts, bytes_of_str(docx_content_types()))
    vec_push(names, "_rels/.rels")
    vec_push(parts, bytes_of_str(docx_root_rels()))
    vec_push(names, "word/document.xml")
    vec_push(parts, bytes_of_str(docx_body_xml(title, body)))
    vec_push(names, "word/_rels/document.xml.rels")
    vec_push(parts, bytes_of_str(docx_doc_rels()))
    return zip_write_deflate(names, parts)
}
