// docx/read.baga — WordprocessingML plain text extract from word/document.xml.

import "xmlbaga/xml.baga"
import "bufbaga/buf.baga"
import "../core/names.baga"
import "../opc/package.baga"
import "std/str/str.baga"

fn docx_extract_xml(src: str) -> str {
    let p = xml_parser(src)
    let mut b = buf_new()
    let mut in_t: i64 = 0
    let mut para_has: i64 = 0
    let mut done: i64 = 0
    while done == 0 {
        let ev = xml_next(p)
        if ev.kind == 0 {
            done = 1
        } else {
            if ev.kind == 0 - 1 {
                done = 1
            } else {
                if ev.kind == 1 {
                    let loc = office_local(ev.name)
                    if loc == "t" {
                        in_t = 1
                    }
                    if loc == "tab" {
                        b = buf_push(b, "\t")
                        para_has = 1
                    }
                    if loc == "br" || loc == "cr" {
                        b = buf_push(b, "\n")
                        para_has = 1
                    }
                } else {
                    if ev.kind == 2 {
                        let loc = office_local(ev.name)
                        if loc == "t" {
                            in_t = 0
                        }
                        if loc == "p" {
                            b = buf_push(b, "\n")
                            para_has = 0
                        }
                    } else {
                        if ev.kind == 3 {
                            if in_t == 1 {
                                b = buf_push(b, ev.text)
                                para_has = 1
                            }
                        }
                    }
                }
            }
        }
    }
    return buf_str(b)
}

fn docx_plain_text(pkg: OpcPackage) -> str {
    if pkg.ok == 0 {
        return ""
    }
    let src = opc_part_text(pkg, "word/document.xml")
    if src == "" {
        return ""
    }
    return docx_extract_xml(src)
}
