// xlsx/read.baga — SpreadsheetML plain text (TSV-ish) extract.

import "xmlbaga/xml.baga"
import "bufbaga/buf.baga"
import "../core/names.baga"
import "../opc/package.baga"
import "std/str/str.baga"

// Collect shared string table entries (si → concatenated t text).
fn xlsx_shared_strings(src: str) -> Vec<str> {
    let out = vec_new()
    if src == "" {
        return out
    }
    let p = xml_parser(src)
    let mut cur = buf_new()
    let mut in_si: i64 = 0
    let mut in_t: i64 = 0
    let mut done: i64 = 0
    while done == 0 {
        let ev = xml_next(p)
        if ev.kind == 0 {
            done = 1
        } else {
            if ev.kind == 0 - 1 {
                done = 1
            } else {
                if ev.kind == 1 {
                    let loc = office_local(ev.name)
                    if loc == "si" {
                        in_si = 1
                        cur = buf_clear(cur)
                    }
                    if loc == "t" {
                        in_t = 1
                    }
                } else {
                    if ev.kind == 2 {
                        let loc = office_local(ev.name)
                        if loc == "t" {
                            in_t = 0
                        }
                        if loc == "si" {
                            vec_push(out, buf_str(cur))
                            in_si = 0
                        }
                    } else {
                        if ev.kind == 3 {
                            if in_si == 1 && in_t == 1 {
                                cur = buf_push(cur, ev.text)
                            }
                        }
                    }
                }
            }
        }
    }
    return out
}

fn xlsx_attr(attrs: Map<str, str>, key: str) -> str {
    if map_has(attrs, key) == 1 {
        return map_get(attrs, key)
    }
    return ""
}

// Parse one sheet XML → lines of tab-separated cell values.
fn xlsx_sheet_text(src: str, sst: Vec<str>) -> str {
    let p = xml_parser(src)
    let mut b = buf_new()
    let mut row_parts = vec_new()
    let mut cell_t = ""
    let mut in_v: i64 = 0
    let mut in_is_t: i64 = 0
    let mut vbuf = buf_new()
    let mut done: i64 = 0
    while done == 0 {
        let ev = xml_next(p)
        if ev.kind == 0 {
            done = 1
        } else {
            if ev.kind == 0 - 1 {
                done = 1
            } else {
                if ev.kind == 1 {
                    let loc = office_local(ev.name)
                    if loc == "row" {
                        row_parts = vec_new()
                    }
                    if loc == "c" {
                        cell_t = xlsx_attr(ev.attrs, "t")
                        vbuf = buf_clear(vbuf)
                        in_v = 0
                        in_is_t = 0
                    }
                    if loc == "v" {
                        in_v = 1
                        vbuf = buf_clear(vbuf)
                    }
                    if loc == "t" {
                        // inlineStr path: c/is/t
                        if cell_t == "inlineStr" {
                            in_is_t = 1
                            vbuf = buf_clear(vbuf)
                        }
                    }
                } else {
                    if ev.kind == 2 {
                        let loc = office_local(ev.name)
                        if loc == "v" {
                            in_v = 0
                            let raw = buf_str(vbuf)
                            let mut val = raw
                            if cell_t == "s" {
                                let idx = parse_int(raw)
                                if idx >= 0 && idx < vec_len(sst) {
                                    val = vec_get(sst, idx)
                                }
                            }
                            vec_push(row_parts, val)
                        }
                        if loc == "t" {
                            if in_is_t == 1 {
                                in_is_t = 0
                                vec_push(row_parts, buf_str(vbuf))
                            }
                        }
                        if loc == "c" {
                            // empty cell with no v — skip (sparse)
                            cell_t = ""
                        }
                        if loc == "row" {
                            let mut line = buf_new()
                            let mut i: i64 = 0
                            while i < vec_len(row_parts) {
                                if i > 0 {
                                    line = buf_push(line, "\t")
                                }
                                line = buf_push(line, vec_get(row_parts, i))
                                i = i + 1
                            }
                            b = buf_push(b, buf_str(line))
                            b = buf_push(b, "\n")
                        }
                    } else {
                        if ev.kind == 3 {
                            if in_v == 1 || in_is_t == 1 {
                                vbuf = buf_push(vbuf, ev.text)
                            }
                        }
                    }
                }
            }
        }
    }
    return buf_str(b)
}

// List worksheet part paths from workbook.xml.rels (or fallback sheet1).
fn xlsx_sheet_paths(pkg: OpcPackage) -> Vec<str> {
    let paths = vec_new()
    let rels = opc_part_text(pkg, "xl/_rels/workbook.xml.rels")
    if rels != "" {
        let p = xml_parser(rels)
        let mut done: i64 = 0
        while done == 0 {
            let ev = xml_next(p)
            if ev.kind == 0 || ev.kind == 0 - 1 {
                done = 1
            } else {
                if ev.kind == 1 {
                    if office_local(ev.name) == "Relationship" {
                        let typ = xlsx_attr(ev.attrs, "Type")
                        let tgt = xlsx_attr(ev.attrs, "Target")
                        if str_find(typ, "worksheet") >= 0 && tgt != "" {
                            // Target is relative to xl/
                            if str_starts_with(tgt, "/") {
                                // absolute part name without leading slash for zip
                                let t = substr(tgt, 1, len(tgt))
                                vec_push(paths, t)
                            } else {
                                if str_starts_with(tgt, "worksheets/") {
                                    vec_push(paths, concat("xl/", tgt))
                                } else {
                                    vec_push(paths, concat("xl/", tgt))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if vec_len(paths) == 0 {
        if opc_has(pkg, "xl/worksheets/sheet1.xml") {
            vec_push(paths, "xl/worksheets/sheet1.xml")
        }
    }
    return paths
}

fn xlsx_plain_text(pkg: OpcPackage) -> str {
    if pkg.ok == 0 {
        return ""
    }
    let sst = xlsx_shared_strings(opc_part_text(pkg, "xl/sharedStrings.xml"))
    let paths = xlsx_sheet_paths(pkg)
    let mut b = buf_new()
    let mut i: i64 = 0
    while i < vec_len(paths) {
        let path = vec_get(paths, i)
        let src = opc_part_text(pkg, path)
        if src != "" {
            if i > 0 {
                b = buf_push(b, "\n")
            }
            b = buf_push(b, xlsx_sheet_text(src, sst))
        }
        i = i + 1
    }
    return buf_str(b)
}
