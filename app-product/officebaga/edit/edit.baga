// edit/edit.baga — package-level edit: replace part / text, rebuild ZIP.

import "zipbaga/archive.baga"
import "std/str/str.baga"
import "../opc/package.baga"
import "../core/detect.baga"

fn office_main_part_path(fmt: i64) -> str {
    if fmt == OFFICE_DOCX() {
        return "word/document.xml"
    }
    if fmt == OFFICE_XLSX() {
        return "xl/sharedStrings.xml"
    }
    if fmt == OFFICE_ODT() || fmt == OFFICE_ODS() {
        return "content.xml"
    }
    return ""
}

// Rebuild package bytes from live ZipArchive (deflate, ODF-safe mimetype).
fn office_pkg_bytes(pkg: OpcPackage) -> ZipPart {
    if pkg.ok == 0 {
        return ZipPart { ok: 0, err: pkg.err, data: bytes_new(0) }
    }
    return zip_to_bytes(pkg.zip, 1)
}

fn office_set_part_pkg(pkg: OpcPackage, path: str, data: bytes) -> ZipPart {
    if pkg.ok == 0 {
        return ZipPart { ok: 0, err: pkg.err, data: bytes_new(0) }
    }
    return zip_set_entry(pkg.zip, path, data, 1)
}

// XML-level substring replace in the main content part (must lie in one run/node).
fn office_replace_text_pkg(pkg: OpcPackage, fmt: i64, from: str, to: str) -> ZipPart {
    if pkg.ok == 0 {
        return ZipPart { ok: 0, err: pkg.err, data: bytes_new(0) }
    }
    if from == "" {
        return ZipPart { ok: 0, err: "office: empty search string", data: bytes_new(0) }
    }
    let path = office_main_part_path(fmt)
    if path == "" {
        return ZipPart { ok: 0, err: "office: no main part for format", data: bytes_new(0) }
    }
    // XLSX without sharedStrings: fall back to sheet1
    let mut use_path = path
    if fmt == OFFICE_XLSX() {
        if opc_has(pkg, path) == false {
            use_path = "xl/worksheets/sheet1.xml"
        }
    }
    let part = opc_part_bytes(pkg, use_path)
    if part.ok == 0 {
        return part
    }
    let src = str_of_bytes(part.data)
    if str_find(src, from) < 0 {
        return ZipPart { ok: 0, err: concat("office: text not found: ", from), data: bytes_new(0) }
    }
    let updated = str_replace(src, from, to)
    return zip_set_entry(pkg.zip, use_path, bytes_of_str(updated), 1)
}
