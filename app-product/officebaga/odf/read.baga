// odf/read.baga — ODT / ODS plain text from content.xml (no presentations).

import "xmlbaga/xml.baga"
import "bufbaga/buf.baga"
import "../core/names.baga"
import "../opc/package.baga"
import "std/str/str.baga"

// ODT: collect text in text:p / text:h; paragraph breaks on close.
fn odt_extract_xml(src: str) -> str {
    let p = xml_parser(src)
    let mut b = buf_new()
    let mut in_text: i64 = 0
    let mut done: i64 = 0
    while done == 0 {
        let ev = xml_next(p)
        if ev.kind == 0 || ev.kind == 0 - 1 {
            done = 1
        } else {
            if ev.kind == 1 {
                let loc = office_local(ev.name)
                if loc == "p" || loc == "h" {
                    in_text = 1
                }
                if loc == "line-break" || loc == "tab" {
                    if loc == "tab" {
                        b = buf_push(b, "\t")
                    } else {
                        b = buf_push(b, "\n")
                    }
                }
            } else {
                if ev.kind == 2 {
                    let loc = office_local(ev.name)
                    if loc == "p" || loc == "h" {
                        b = buf_push(b, "\n")
                        in_text = 0
                    }
                } else {
                    if ev.kind == 3 {
                        if in_text == 1 {
                            b = buf_push(b, ev.text)
                        }
                    }
                }
            }
        }
    }
    return buf_str(b)
}

// ODS: table cells — tab between cells, newline between rows.
fn ods_extract_xml(src: str) -> str {
    let p = xml_parser(src)
    let mut b = buf_new()
    let mut in_cell: i64 = 0
    let mut cell_first: i64 = 1
    let mut row_has: i64 = 0
    let mut done: i64 = 0
    while done == 0 {
        let ev = xml_next(p)
        if ev.kind == 0 || ev.kind == 0 - 1 {
            done = 1
        } else {
            if ev.kind == 1 {
                let loc = office_local(ev.name)
                if loc == "table-row" {
                    cell_first = 1
                    row_has = 0
                }
                if loc == "table-cell" || loc == "covered-table-cell" {
                    in_cell = 1
                    if cell_first == 0 {
                        b = buf_push(b, "\t")
                    }
                    cell_first = 0
                    row_has = 1
                }
                if loc == "p" && in_cell == 1 {
                    // text inside cell paragraph
                }
            } else {
                if ev.kind == 2 {
                    let loc = office_local(ev.name)
                    if loc == "table-cell" || loc == "covered-table-cell" {
                        in_cell = 0
                    }
                    if loc == "table-row" {
                        if row_has == 1 {
                            b = buf_push(b, "\n")
                        }
                    }
                } else {
                    if ev.kind == 3 {
                        if in_cell == 1 {
                            b = buf_push(b, ev.text)
                        }
                    }
                }
            }
        }
    }
    return buf_str(b)
}

fn odt_plain_text(pkg: OpcPackage) -> str {
    let src = opc_part_text(pkg, "content.xml")
    if src == "" {
        return ""
    }
    return odt_extract_xml(src)
}

fn ods_plain_text(pkg: OpcPackage) -> str {
    let src = opc_part_text(pkg, "content.xml")
    if src == "" {
        return ""
    }
    return ods_extract_xml(src)
}
