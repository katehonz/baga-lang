// demo.baga — 3-node Raft: elect, put, get, print.

import "cluster.baga"
import "std/str/str.baga"

fn main() -> i64 !Par {
    print("raftbaga demo — starting 3-node cluster…")
    let c = raft_start()?
    print("cluster up (election window passed)")

    let rc = raft_put(c, 1, 42)?
    print(concat("put 1→42 rc=", int_to_str(rc)))
    let v = raft_get(c, 1)?
    print(concat("get 1 → ", int_to_str(v)))

    raft_put(c, 2, 100)?
    raft_put(c, 1, 43)?
    print(concat("get 1 after overwrite → ", int_to_str(raft_get(c, 1)?)))
    print(concat("get 2 → ", int_to_str(raft_get(c, 2)?)))
    print(concat("get missing → ", int_to_str(raft_get(c, 99)?)))

    raft_stop(c)?
    print("done")
    return 0
}
