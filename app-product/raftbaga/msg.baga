// msg.baga — Raft wire messages as nested cell2 trees (i64-only channels).

// Types
fn MT_RV() -> i64 { return 1 }
fn MT_RV_REP() -> i64 { return 2 }
fn MT_AE() -> i64 { return 3 }
fn MT_AE_REP() -> i64 { return 4 }
fn MT_PUT() -> i64 { return 5 }
fn MT_GET() -> i64 { return 6 }
fn MT_STOP() -> i64 { return 7 }

fn msg_type(m: i64) -> i64 { return cell2_0(m) }

// --- RequestVote ---
// cell2(RV, cell2(term, cell2(from, cell2(last_idx, last_term))))
fn msg_rv(term: i64, from: i64, last_idx: i64, last_term: i64) -> i64 {
    return cell2(MT_RV(), cell2(term, cell2(from, cell2(last_idx, last_term))))
}
fn rv_term(m: i64) -> i64 { return cell2_0(cell2_1(m)) }
fn rv_from(m: i64) -> i64 { return cell2_0(cell2_1(cell2_1(m))) }
fn rv_last_idx(m: i64) -> i64 { return cell2_0(cell2_1(cell2_1(cell2_1(m)))) }
fn rv_last_term(m: i64) -> i64 { return cell2_1(cell2_1(cell2_1(cell2_1(m)))) }

// --- RequestVote reply ---
// cell2(RV_REP, cell2(term, cell2(from, granted)))
fn msg_rv_rep(term: i64, from: i64, granted: i64) -> i64 {
    return cell2(MT_RV_REP(), cell2(term, cell2(from, granted)))
}
fn rvr_term(m: i64) -> i64 { return cell2_0(cell2_1(m)) }
fn rvr_from(m: i64) -> i64 { return cell2_0(cell2_1(cell2_1(m))) }
fn rvr_granted(m: i64) -> i64 { return cell2_1(cell2_1(cell2_1(m))) }

// --- AppendEntries (single entry or heartbeat) ---
// cell2(AE, cell2(term, cell2(from, cell2(prev_idx, cell2(prev_term,
//       cell2(leader_commit, cell2(entry_term, entry_cmd)))))))
// entry_term==0 && entry_cmd==0 → heartbeat (no new entry)
fn msg_ae(term: i64, from: i64, prev_idx: i64, prev_term: i64,
          leader_commit: i64, entry_term: i64, entry_cmd: i64) -> i64 {
    return cell2(MT_AE(), cell2(term, cell2(from, cell2(prev_idx,
        cell2(prev_term, cell2(leader_commit, cell2(entry_term, entry_cmd)))))))
}
fn ae_term(m: i64) -> i64 { return cell2_0(cell2_1(m)) }
fn ae_from(m: i64) -> i64 { return cell2_0(cell2_1(cell2_1(m))) }
fn ae_prev_idx(m: i64) -> i64 { return cell2_0(cell2_1(cell2_1(cell2_1(m)))) }
fn ae_prev_term(m: i64) -> i64 { return cell2_0(cell2_1(cell2_1(cell2_1(cell2_1(m))))) }
fn ae_leader_commit(m: i64) -> i64 {
    return cell2_0(cell2_1(cell2_1(cell2_1(cell2_1(cell2_1(m))))))
}
fn ae_entry_term(m: i64) -> i64 {
    return cell2_0(cell2_1(cell2_1(cell2_1(cell2_1(cell2_1(cell2_1(m)))))))
}
fn ae_entry_cmd(m: i64) -> i64 {
    return cell2_1(cell2_1(cell2_1(cell2_1(cell2_1(cell2_1(cell2_1(m)))))))
}

// --- AppendEntries reply ---
// cell2(AE_REP, cell2(term, cell2(from, cell2(success, match_idx))))
fn msg_ae_rep(term: i64, from: i64, success: i64, match_idx: i64) -> i64 {
    return cell2(MT_AE_REP(), cell2(term, cell2(from, cell2(success, match_idx))))
}
fn aer_term(m: i64) -> i64 { return cell2_0(cell2_1(m)) }
fn aer_from(m: i64) -> i64 { return cell2_0(cell2_1(cell2_1(m))) }
fn aer_success(m: i64) -> i64 { return cell2_0(cell2_1(cell2_1(cell2_1(m)))) }
fn aer_match(m: i64) -> i64 { return cell2_1(cell2_1(cell2_1(cell2_1(m)))) }

// --- Client ---
// PUT: cell2(PUT, cell2(key, cell2(val, reply_ch)))
fn msg_put(key: i64, val: i64, reply: i64) -> i64 {
    return cell2(MT_PUT(), cell2(key, cell2(val, reply)))
}
fn put_key(m: i64) -> i64 { return cell2_0(cell2_1(m)) }
fn put_val(m: i64) -> i64 { return cell2_0(cell2_1(cell2_1(m))) }
fn put_reply(m: i64) -> i64 { return cell2_1(cell2_1(cell2_1(m))) }

// GET: cell2(GET, cell2(key, reply_ch))
fn msg_get(key: i64, reply: i64) -> i64 {
    return cell2(MT_GET(), cell2(key, reply))
}
fn get_key(m: i64) -> i64 { return cell2_0(cell2_1(m)) }
fn get_reply(m: i64) -> i64 { return cell2_1(cell2_1(m)) }

fn msg_stop() -> i64 { return cell2(MT_STOP(), 0) }

// Command packing for log entries: cell2(key, val)
fn cmd_pack(key: i64, val: i64) -> i64 { return cell2(key, val) }
fn cmd_key(c: i64) -> i64 { return cell2_0(c) }
fn cmd_val(c: i64) -> i64 { return cell2_1(c) }

// Client reply: cell2(ok, value)
fn reply_ok(v: i64) -> i64 { return cell2(1, v) }
fn reply_err() -> i64 { return cell2(0, 0) }
fn reply_is_ok(r: i64) -> i64 { return cell2_0(r) }
fn reply_val(r: i64) -> i64 { return cell2_1(r) }
