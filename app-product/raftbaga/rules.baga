// rules.baga — pure Raft decision fragments (verifiable with --verify).
// These are the pieces the M0–M18 oracle can prove; the concurrent system
// is not claimed complete.

// Accept an incoming RPC term: if remote > local, adopt it (demote).
// Returns the new current term (always >= old).
spec adopt_term {
    input:
        current: i64
        remote: i64
    output: i64
    requires:
        current >= 0
        remote >= 0
    ensures:
        output >= current,
        output >= remote
}
fn adopt_term(current: i64, remote: i64) -> i64 {
    if remote > current {
        return remote
    }
    return current
}

// May we grant a vote to candidate in cand_term?
// voted_for: -1 = none, else candidate id we already voted for this term.
// Rules (Raft §5.2 simplified — log up-to-date checked separately):
//   - cand_term must equal current (caller adopts first)
//   - voted_for is -1 or already cand_id
spec can_grant_vote {
    input:
        current: i64
        voted_for: i64
        cand_term: i64
        cand_id: i64
    output: i64
    requires:
        current >= 0
        cand_term >= 0
        cand_id >= 0
        voted_for >= -1
    ensures:
        output == 0 || output == 1
}
fn can_grant_vote(current: i64, voted_for: i64, cand_term: i64, cand_id: i64) -> i64 {
    if cand_term != current {
        return 0
    }
    if voted_for == -1 {
        return 1
    }
    if voted_for == cand_id {
        return 1
    }
    return 0
}

// Log up-to-date check (Raft §5.4.1): candidate last term/index vs ours.
spec log_up_to_date {
    input:
        my_last_term: i64
        my_last_idx: i64
        cand_last_term: i64
        cand_last_idx: i64
    output: i64
    requires:
        my_last_term >= 0
        my_last_idx >= 0
        cand_last_term >= 0
        cand_last_idx >= 0
    ensures:
        output == 0 || output == 1
}
fn log_up_to_date(my_last_term: i64, my_last_idx: i64,
                  cand_last_term: i64, cand_last_idx: i64) -> i64 {
    if cand_last_term > my_last_term {
        return 1
    }
    if cand_last_term < my_last_term {
        return 0
    }
    if cand_last_idx >= my_last_idx {
        return 1
    }
    return 0
}

// Majority for cluster size n (n odd, n>=1): votes >= n/2+1
spec majority {
    input:
        n: i64
        votes: i64
    output: i64
    requires:
        n >= 1
        votes >= 0
        votes <= n
    ensures:
        output == 0 || output == 1
}
fn majority(n: i64, votes: i64) -> i64 {
    if votes >= (n / 2) + 1 {
        return 1
    }
    return 0
}

// Prev-log match for AppendEntries consistency.
spec prev_log_ok {
    input:
        log_len: i64
        prev_idx: i64
        log_term_at_prev: i64
        prev_term: i64
    output: i64
    requires:
        log_len >= 1
        prev_idx >= 0
        log_term_at_prev >= 0
        prev_term >= 0
    ensures:
        output == 0 || output == 1
}
fn prev_log_ok(log_len: i64, prev_idx: i64, log_term_at_prev: i64, prev_term: i64) -> i64 {
    if prev_idx >= log_len {
        return 0
    }
    if log_term_at_prev != prev_term {
        return 0
    }
    return 1
}
