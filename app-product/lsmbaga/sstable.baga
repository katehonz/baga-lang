// sstable.baga — sorted string table (R4: BAGASST3 bloom + R2 restart index).
//
// On-disk (new writes = v3):
//   magic 8 = "BAGASST3"
//   body (crc32c footer):
//     u32 le count
//     records sorted by key: u8 op | u32 klen | key | u32 vlen | val
//     restart index: n_restarts × u32 le offsets into body, then u32 n_restarts
//     bloom filter bytes, then u32 le bloom_bits
//   u32 le crc32c(body)
//
// Get: CRC → bloom may-contain → restart bsearch → block scan.
// v1 BAGASST1 / v2 BAGASST2 still readable.

import "codec.baga"
import "page.baga"
import "std/os/os.baga"
import "std/crypto/crc32c.baga"
import "std/str/str.baga"

// Restart every N records (LevelDB-style sparse index).
fn sst_restart_every() -> i64 {
    return 16
}

// Bloom probes (double-hashing).
fn bloom_k() -> i64 {
    return 4
}

// One logical row in an SST / merge view.
struct SstRow {
    op: i64,      // 1 put, 2 del
    key: str,
    val: bytes
}

fn sst_path(dir: str, gen: i64) -> str {
    return concat(concat(dir, ".sst."), int_to_str(gen))
}

// --- bloom filter (bits in a byte buffer) ---

// FNV-1a 32-bit over key bytes.
fn bloom_h1(key: str) -> i64 {
    let mut h: i64 = 2166136261
    let n = len(key)
    let mut i: i64 = 0
    while i < n {
        h = h ^ (char_at(key, i) & 255)
        h = (h * 16777619) & 4294967295
        i = i + 1
    }
    return h
}

// Secondary mix (so probes spread).
fn bloom_h2(key: str) -> i64 {
    let mut h: i64 = 0
    let n = len(key)
    let mut i: i64 = 0
    while i < n {
        h = (h * 33 + (char_at(key, i) & 255)) & 4294967295
        i = i + 1
    }
    if h == 0 {
        h = 1
    }
    return h
}

fn bloom_bits_for(nkeys: i64) -> i64 {
    // ~10 bits/key, min 64, rounded up to multiple of 8.
    let mut b = nkeys * 10
    if b < 64 {
        b = 64
    }
    return ((b + 7) / 8) * 8
}

fn bloom_set_bit(bits: bytes, bit: i64) {
    let bi = bit / 8
    let bo = bit % 8
    let cur = bytes_at(bits, bi)
    bytes_set(bits, bi, cur | (1 << bo))
}

fn bloom_test_bit(bits: bytes, bit: i64) -> i64 {
    let bi = bit / 8
    let bo = bit % 8
    if (bytes_at(bits, bi) & (1 << bo)) != 0 {
        return 1
    }
    return 0
}

fn bloom_add(bits: bytes, m: i64, key: str) {
    let h1 = bloom_h1(key)
    let h2 = bloom_h2(key)
    let k = bloom_k()
    let mut i: i64 = 0
    while i < k {
        let bit = (h1 + i * h2) % m
        if bit < 0 {
            bloom_set_bit(bits, 0 - bit)
        } else {
            bloom_set_bit(bits, bit)
        }
        i = i + 1
    }
}

// 1 = maybe present, 0 = definitely absent.
fn bloom_may(bits: bytes, m: i64, key: str) -> i64 {
    if m <= 0 || bytes_len(bits) == 0 {
        return 1
    }
    let h1 = bloom_h1(key)
    let h2 = bloom_h2(key)
    let k = bloom_k()
    let mut i: i64 = 0
    while i < k {
        let mut bit = (h1 + i * h2) % m
        if bit < 0 {
            bit = 0 - bit
        }
        if bloom_test_bit(bits, bit) == 0 {
            return 0
        }
        i = i + 1
    }
    return 1
}

fn bloom_build(rows: Vec<SstRow>) -> bytes {
    let m = bloom_bits_for(vec_len(rows))
    let nbytes = m / 8
    let bits = bytes_new(nbytes)
    let mut i: i64 = 0
    while i < nbytes {
        bytes_set(bits, i, 0)
        i = i + 1
    }
    let n = vec_len(rows)
    let mut j: i64 = 0
    while j < n {
        bloom_add(bits, m, vec_get(rows, j).key)
        j = j + 1
    }
    // Append bit count so readers know m.
    return push_u32_le(bits, m)
}

// Build v3 body: rows + restart footer + bloom.
fn sst_build(rows: Vec<SstRow>) -> bytes {
    let mut body = bytes_new(0)
    body = push_u32_le(body, vec_len(rows))
    let restarts: Vec<i64> = vec_new()
    let every = sst_restart_every()
    let n = vec_len(rows)
    let mut i: i64 = 0
    while i < n {
        if i % every == 0 {
            vec_push(restarts, bytes_len(body))
        }
        let r = vec_get(rows, i)
        body = bytes_push(body, r.op & 255)
        let kb = bytes_of_str(r.key)
        body = push_u32_le(body, bytes_len(kb))
        body = push_bytes(body, kb)
        body = push_u32_le(body, bytes_len(r.val))
        body = push_bytes(body, r.val)
        i = i + 1
    }
    // Restart index footer (offsets then count).
    let nr = vec_len(restarts)
    let mut j: i64 = 0
    while j < nr {
        body = push_u32_le(body, vec_get(restarts, j))
        j = j + 1
    }
    body = push_u32_le(body, nr)
    // Bloom filter + u32 bits.
    body = push_bytes(body, bloom_build(rows))
    return body
}

// Write a new SST file (BAGASST3). Returns 0 ok, -1 error.
fn sst_write(dir: str, gen: i64, rows: Vec<SstRow>) -> i64 !IO {
    let path = sst_path(dir, gen)
    let fd = open(path, 578, 420)?   // O_RDWR|O_CREAT|O_TRUNC
    if fd < 0 {
        return -1
    }
    let magic = bytes_of_str("BAGASST3")
    let body = sst_build(rows)
    let crc = crc32c_b(body)
    let mut file = magic
    file = push_bytes(file, body)
    file = push_u32_le(file, crc)
    if fd_write_bytes(fd, file) != 0 {
        close(fd)
        return -1
    }
    if fsync(fd)? != 0 {
        close(fd)
        return -1
    }
    close(fd)
    return 0
}

struct SstParse {
    ok: i64,
    rows: Vec<SstRow>
}

// Parse record stream starting at pos; stop after `count` records or at `limit`.
// Used for full table materialize (compaction / KEYS) and for block scans.
struct SstRec {
    ok: i64,
    op: i64,
    key: str,
    val: bytes,
    next: i64
}

fn sst_rec_at(body: bytes, pos: i64) -> SstRec {
    let bad = SstRec { ok: 0, op: 0, key: "", val: bytes_new(0), next: pos }
    if pos + 1 + 4 > bytes_len(body) {
        return bad
    }
    let op = bytes_at(body, pos)
    let mut p = pos + 1
    let klen = get_u32_le(body, p)
    p = p + 4
    if klen < 0 || p + klen + 4 > bytes_len(body) {
        return bad
    }
    let key = str_of_bytes(bytes_slice(body, p, p + klen))
    p = p + klen
    let vlen = get_u32_le(body, p)
    p = p + 4
    if vlen < 0 || p + vlen > bytes_len(body) {
        return bad
    }
    let val = bytes_slice(body, p, p + vlen)
    p = p + vlen
    return SstRec { ok: 1, op: op, key: key, val: val, next: p }
}

// Decode rows from body after magic+crc already stripped.
fn sst_parse_rows(body: bytes) -> SstParse {
    let empty: Vec<SstRow> = vec_new()
    if bytes_len(body) < 4 {
        return SstParse { ok: 0, rows: empty }
    }
    let count = get_u32_le(body, 0)
    let mut pos: i64 = 4
    let rows: Vec<SstRow> = vec_new()
    let mut i: i64 = 0
    let mut ok: i64 = 1
    while i < count && ok == 1 {
        let rec = sst_rec_at(body, pos)
        if rec.ok == 0 {
            ok = 0
        } else {
            vec_push(rows, SstRow { op: rec.op, key: rec.key, val: rec.val })
            pos = rec.next
            i = i + 1
        }
    }
    if ok == 0 {
        return SstParse { ok: 0, rows: empty }
    }
    return SstParse { ok: 1, rows: rows }
}

fn sst_parse(data: bytes) -> SstParse {
    let empty: Vec<SstRow> = vec_new()
    if bytes_len(data) < 8 + 4 + 4 {
        return SstParse { ok: 0, rows: empty }
    }
    let mag = str_of_bytes(bytes_slice(data, 0, 8))
    if mag != "BAGASST1" {
        if mag != "BAGASST2" {
            if mag != "BAGASST3" {
                return SstParse { ok: 0, rows: empty }
            }
        }
    }
    let body = bytes_slice(data, 8, bytes_len(data) - 4)
    let got = get_u32_le(data, bytes_len(data) - 4)
    if crc32c_b(body) != got {
        return SstParse { ok: 0, rows: empty }
    }
    // count drives rows; trailing restart/bloom ignored after count rows.
    return sst_parse_rows(body)
}

struct SstLoad {
    pc: PageCache,
    parse: SstParse
}

// Read entire SST file bytes through the page cache (warms pages; file_id = gen).
struct SstRaw {
    pc: PageCache,
    ok: i64,
    data: bytes
}

fn sst_read_raw(pc: PageCache, dir: str, gen: i64) -> SstRaw !IO {
    let path = sst_path(dir, gen)
    let fd = open(path, 0, 0)?
    if fd < 0 {
        return SstRaw { pc: pc, ok: 0, data: bytes_new(0) }
    }
    let mut cur = pc
    let mut data = bytes_new(0)
    let mut pno: i64 = 0
    let mut more: i64 = 1
    while more == 1 {
        let raw = fd_pread_bytes(fd, cur.page_size, pno * cur.page_size)?
        if bytes_len(raw) == 0 {
            more = 0
        } else {
            let g = pc_get(cur, fd, gen, pno)?
            cur = g.pc
            data = push_bytes(data, raw)
            if bytes_len(raw) < cur.page_size {
                more = 0
            } else {
                pno = pno + 1
            }
        }
    }
    close(fd)
    return SstRaw { pc: cur, ok: 1, data: data }
}

// Read entire SST through the page cache (warms pages; file_id = gen).
fn sst_load(pc: PageCache, dir: str, gen: i64) -> SstLoad !IO {
    let empty: Vec<SstRow> = vec_new()
    let raw = sst_read_raw(pc, dir, gen)?
    if raw.ok == 0 {
        return SstLoad { pc: raw.pc, parse: SstParse { ok: 0, rows: empty } }
    }
    return SstLoad { pc: raw.pc, parse: sst_parse(raw.data) }
}

struct SstLookup {
    pc: PageCache,
    found: i64,
    alive: i64,
    val: bytes
}

struct SstHit {
    found: i64,
    alive: i64,
    val: bytes
}

// Binary search in a sorted SST row vector (keys ascending).
// Returns index of key, or -1 if absent.
fn sst_bsearch(rows: Vec<SstRow>, key: str) -> i64 {
    let n = vec_len(rows)
    if n == 0 {
        return 0 - 1
    }
    // Range filter: outside [first, last] → miss without full scan.
    if str_cmp(key, vec_get(rows, 0).key) < 0 {
        return 0 - 1
    }
    if str_cmp(key, vec_get(rows, n - 1).key) > 0 {
        return 0 - 1
    }
    let mut lo: i64 = 0
    let mut hi = n - 1
    while lo <= hi {
        let mid = lo + (hi - lo) / 2
        let r = vec_get(rows, mid)
        let c = str_cmp(r.key, key)
        if c == 0 {
            return mid
        }
        if c < 0 {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return 0 - 1
}

fn sst_hit_from_row(r: SstRow) -> SstHit {
    if r.op == 2 {
        return SstHit { found: 1, alive: 0, val: bytes_new(0) }
    }
    return SstHit { found: 1, alive: 1, val: r.val }
}

// Last key in [start, end) record range (for max filter).
fn sst_last_key(body: bytes, start: i64, end: i64) -> str {
    let mut pos = start
    let mut last: str = ""
    let mut go: i64 = 1
    while go == 1 {
        if pos >= end {
            go = 0
        } else {
            let rec = sst_rec_at(body, pos)
            if rec.ok == 0 {
                go = 0
            } else {
                if rec.next > end {
                    go = 0
                } else {
                    last = rec.key
                    pos = rec.next
                }
            }
        }
    }
    return last
}

// Core: restart index bsearch + scan one block. `body` ends at restart footer
// (no trailing bloom). Used by v2 and by v3 after bloom strip.
fn sst_lookup_indexed(body: bytes, key: str) -> SstHit {
    let miss = SstHit { found: 0, alive: 0, val: bytes_new(0) }
    let blen = bytes_len(body)
    if blen < 8 {
        return miss
    }
    let count = get_u32_le(body, 0)
    if count <= 0 {
        return miss
    }
    let n_restarts = get_u32_le(body, blen - 4)
    if n_restarts <= 0 {
        return miss
    }
    let idx_base = blen - 4 - n_restarts * 4
    if idx_base < 4 {
        return miss
    }
    // Sanity: first restart at 4.
    let first_off = get_u32_le(body, idx_base)
    if first_off != 4 {
        return miss
    }
    let first_rec = sst_rec_at(body, first_off)
    if first_rec.ok == 0 {
        return miss
    }
    if str_cmp(key, first_rec.key) < 0 {
        return miss
    }
    let last_off = get_u32_le(body, idx_base + (n_restarts - 1) * 4)
    let last_key = sst_last_key(body, last_off, idx_base)
    if len(last_key) == 0 {
        return miss
    }
    if str_cmp(key, last_key) > 0 {
        return miss
    }
    // Bsearch: largest restart with restart_key <= key.
    let mut lo: i64 = 0
    let mut hi = n_restarts - 1
    let mut best: i64 = 0
    while lo <= hi {
        let mid = lo + (hi - lo) / 2
        let off = get_u32_le(body, idx_base + mid * 4)
        let rec = sst_rec_at(body, off)
        if rec.ok == 0 {
            return miss
        }
        let c = str_cmp(rec.key, key)
        if c == 0 {
            return sst_hit_from_row(SstRow { op: rec.op, key: rec.key, val: rec.val })
        }
        if c < 0 {
            best = mid
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    let start = get_u32_le(body, idx_base + best * 4)
    let mut end = idx_base
    if best + 1 < n_restarts {
        end = get_u32_le(body, idx_base + (best + 1) * 4)
    }
    let mut pos = start
    let mut go: i64 = 1
    let mut hit = miss
    while go == 1 {
        if pos >= end {
            go = 0
        } else {
            let rec = sst_rec_at(body, pos)
            if rec.ok == 0 {
                go = 0
            } else {
                if rec.next > end {
                    go = 0
                } else {
                    let c = str_cmp(rec.key, key)
                    if c == 0 {
                        hit = sst_hit_from_row(SstRow { op: rec.op, key: rec.key, val: rec.val })
                        go = 0
                    } else {
                        if c > 0 {
                            go = 0
                        } else {
                            pos = rec.next
                        }
                    }
                }
            }
        }
    }
    return hit
}

// v3: bloom then indexed lookup on the core (body without bloom trailer).
fn sst_lookup_v3(body: bytes, key: str) -> SstHit {
    let miss = SstHit { found: 0, alive: 0, val: bytes_new(0) }
    let blen = bytes_len(body)
    if blen < 12 {
        return miss
    }
    let m = get_u32_le(body, blen - 4)
    if m <= 0 {
        return miss
    }
    let nbytes = m / 8
    if nbytes <= 0 || blen < 4 + nbytes + 8 {
        return miss
    }
    let bloom_off = blen - 4 - nbytes
    let bits = bytes_slice(body, bloom_off, bloom_off + nbytes)
    if bloom_may(bits, m, key) == 0 {
        return miss
    }
    let core = bytes_slice(body, 0, bloom_off)
    return sst_lookup_indexed(core, key)
}

// Dispatch v1 / v2 / v3.
fn sst_lookup_data(data: bytes, key: str) -> SstHit {
    let miss = SstHit { found: 0, alive: 0, val: bytes_new(0) }
    if bytes_len(data) < 8 + 4 + 4 {
        return miss
    }
    let mag = str_of_bytes(bytes_slice(data, 0, 8))
    let body = bytes_slice(data, 8, bytes_len(data) - 4)
    let got = get_u32_le(data, bytes_len(data) - 4)
    if crc32c_b(body) != got {
        return miss
    }
    if mag == "BAGASST3" {
        return sst_lookup_v3(body, key)
    }
    if mag == "BAGASST2" {
        return sst_lookup_indexed(body, key)
    }
    if mag == "BAGASST1" {
        let p = sst_parse_rows(body)
        if p.ok == 0 {
            return miss
        }
        let j = sst_bsearch(p.rows, key)
        if j < 0 {
            return miss
        }
        return sst_hit_from_row(vec_get(p.rows, j))
    }
    return miss
}

// Newest-first lookup across gens.
fn sst_get(pc: PageCache, dir: str, gens: Vec<i64>, key: str) -> SstLookup !IO {
    let mut cur = pc
    let mut i = vec_len(gens) - 1
    while i >= 0 {
        let gen = vec_get(gens, i)
        let raw = sst_read_raw(cur, dir, gen)?
        cur = raw.pc
        if raw.ok == 1 {
            let h = sst_lookup_data(raw.data, key)
            if h.found == 1 {
                return SstLookup { pc: cur, found: 1, alive: h.alive, val: h.val }
            }
        }
        i = i - 1
    }
    return SstLookup { pc: cur, found: 0, alive: 0, val: bytes_new(0) }
}
