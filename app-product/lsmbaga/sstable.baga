// sstable.baga — sorted string table (R2: BAGASST2 restart index).
//
// On-disk (new writes = v2):
//   magic 8 = "BAGASST2"
//   body (crc32c footer):
//     u32 le count
//     records sorted by key: u8 op | u32 klen | key | u32 vlen | val
//     restart index: n_restarts × u32 le offsets into body, then u32 n_restarts
//     (restart every 16 records; first always at offset 4)
//   u32 le crc32c(body)
//
// v1 "BAGASST1" still readable (full parse + binary search). Get on v2 uses
// restart bsearch then linear scan of one block — no full row materialize.

import "codec.baga"
import "page.baga"
import "std/os/os.baga"
import "std/crypto/crc32c.baga"
import "std/str/str.baga"

// Restart every N records (LevelDB-style sparse index).
fn sst_restart_every() -> i64 {
    return 16
}

// One logical row in an SST / merge view.
struct SstRow {
    op: i64,      // 1 put, 2 del
    key: str,
    val: bytes
}

fn sst_path(dir: str, gen: i64) -> str {
    return concat(concat(dir, ".sst."), int_to_str(gen))
}

// Build v2 body: rows + restart footer.
fn sst_build(rows: Vec<SstRow>) -> bytes {
    let mut body = bytes_new(0)
    body = push_u32_le(body, vec_len(rows))
    let restarts: Vec<i64> = vec_new()
    let every = sst_restart_every()
    let n = vec_len(rows)
    let mut i: i64 = 0
    while i < n {
        if i % every == 0 {
            vec_push(restarts, bytes_len(body))
        }
        let r = vec_get(rows, i)
        body = bytes_push(body, r.op & 255)
        let kb = bytes_of_str(r.key)
        body = push_u32_le(body, bytes_len(kb))
        body = push_bytes(body, kb)
        body = push_u32_le(body, bytes_len(r.val))
        body = push_bytes(body, r.val)
        i = i + 1
    }
    // Restart index footer (offsets then count).
    let nr = vec_len(restarts)
    let mut j: i64 = 0
    while j < nr {
        body = push_u32_le(body, vec_get(restarts, j))
        j = j + 1
    }
    body = push_u32_le(body, nr)
    return body
}

// Write a new SST file (BAGASST2). Returns 0 ok, -1 error.
fn sst_write(dir: str, gen: i64, rows: Vec<SstRow>) -> i64 !IO {
    let path = sst_path(dir, gen)
    let fd = open(path, 578, 420)?   // O_RDWR|O_CREAT|O_TRUNC
    if fd < 0 {
        return -1
    }
    let magic = bytes_of_str("BAGASST2")
    let body = sst_build(rows)
    let crc = crc32c_b(body)
    let mut file = magic
    file = push_bytes(file, body)
    file = push_u32_le(file, crc)
    if fd_write_bytes(fd, file) != 0 {
        close(fd)
        return -1
    }
    if fsync(fd)? != 0 {
        close(fd)
        return -1
    }
    close(fd)
    return 0
}

struct SstParse {
    ok: i64,
    rows: Vec<SstRow>
}

// Parse record stream starting at pos; stop after `count` records or at `limit`.
// Used for full table materialize (compaction / KEYS) and for block scans.
struct SstRec {
    ok: i64,
    op: i64,
    key: str,
    val: bytes,
    next: i64
}

fn sst_rec_at(body: bytes, pos: i64) -> SstRec {
    let bad = SstRec { ok: 0, op: 0, key: "", val: bytes_new(0), next: pos }
    if pos + 1 + 4 > bytes_len(body) {
        return bad
    }
    let op = bytes_at(body, pos)
    let mut p = pos + 1
    let klen = get_u32_le(body, p)
    p = p + 4
    if klen < 0 || p + klen + 4 > bytes_len(body) {
        return bad
    }
    let key = str_of_bytes(bytes_slice(body, p, p + klen))
    p = p + klen
    let vlen = get_u32_le(body, p)
    p = p + 4
    if vlen < 0 || p + vlen > bytes_len(body) {
        return bad
    }
    let val = bytes_slice(body, p, p + vlen)
    p = p + vlen
    return SstRec { ok: 1, op: op, key: key, val: val, next: p }
}

// Decode rows from body after magic+crc already stripped. If data_end >= 0,
// only parse records with start < data_end (v2 index region excluded by count).
fn sst_parse_rows(body: bytes) -> SstParse {
    let empty: Vec<SstRow> = vec_new()
    if bytes_len(body) < 4 {
        return SstParse { ok: 0, rows: empty }
    }
    let count = get_u32_le(body, 0)
    let mut pos: i64 = 4
    let rows: Vec<SstRow> = vec_new()
    let mut i: i64 = 0
    let mut ok: i64 = 1
    while i < count && ok == 1 {
        let rec = sst_rec_at(body, pos)
        if rec.ok == 0 {
            ok = 0
        } else {
            vec_push(rows, SstRow { op: rec.op, key: rec.key, val: rec.val })
            pos = rec.next
            i = i + 1
        }
    }
    if ok == 0 {
        return SstParse { ok: 0, rows: empty }
    }
    return SstParse { ok: 1, rows: rows }
}

fn sst_parse(data: bytes) -> SstParse {
    let empty: Vec<SstRow> = vec_new()
    if bytes_len(data) < 8 + 4 + 4 {
        return SstParse { ok: 0, rows: empty }
    }
    let mag = str_of_bytes(bytes_slice(data, 0, 8))
    if mag != "BAGASST1" {
        if mag != "BAGASST2" {
            return SstParse { ok: 0, rows: empty }
        }
    }
    let body = bytes_slice(data, 8, bytes_len(data) - 4)
    let got = get_u32_le(data, bytes_len(data) - 4)
    if crc32c_b(body) != got {
        return SstParse { ok: 0, rows: empty }
    }
    // v1 and v2: count then records; v2 trailing restart index is ignored after count rows.
    return sst_parse_rows(body)
}

struct SstLoad {
    pc: PageCache,
    parse: SstParse
}

// Read entire SST file bytes through the page cache (warms pages; file_id = gen).
struct SstRaw {
    pc: PageCache,
    ok: i64,
    data: bytes
}

fn sst_read_raw(pc: PageCache, dir: str, gen: i64) -> SstRaw !IO {
    let path = sst_path(dir, gen)
    let fd = open(path, 0, 0)?
    if fd < 0 {
        return SstRaw { pc: pc, ok: 0, data: bytes_new(0) }
    }
    let mut cur = pc
    let mut data = bytes_new(0)
    let mut pno: i64 = 0
    let mut more: i64 = 1
    while more == 1 {
        let raw = fd_pread_bytes(fd, cur.page_size, pno * cur.page_size)?
        if bytes_len(raw) == 0 {
            more = 0
        } else {
            let g = pc_get(cur, fd, gen, pno)?
            cur = g.pc
            data = push_bytes(data, raw)
            if bytes_len(raw) < cur.page_size {
                more = 0
            } else {
                pno = pno + 1
            }
        }
    }
    close(fd)
    return SstRaw { pc: cur, ok: 1, data: data }
}

// Read entire SST through the page cache (warms pages; file_id = gen).
fn sst_load(pc: PageCache, dir: str, gen: i64) -> SstLoad !IO {
    let empty: Vec<SstRow> = vec_new()
    let raw = sst_read_raw(pc, dir, gen)?
    if raw.ok == 0 {
        return SstLoad { pc: raw.pc, parse: SstParse { ok: 0, rows: empty } }
    }
    return SstLoad { pc: raw.pc, parse: sst_parse(raw.data) }
}

struct SstLookup {
    pc: PageCache,
    found: i64,
    alive: i64,
    val: bytes
}

struct SstHit {
    found: i64,
    alive: i64,
    val: bytes
}

// Binary search in a sorted SST row vector (keys ascending).
// Returns index of key, or -1 if absent.
fn sst_bsearch(rows: Vec<SstRow>, key: str) -> i64 {
    let n = vec_len(rows)
    if n == 0 {
        return 0 - 1
    }
    // Range filter: outside [first, last] → miss without full scan.
    if str_cmp(key, vec_get(rows, 0).key) < 0 {
        return 0 - 1
    }
    if str_cmp(key, vec_get(rows, n - 1).key) > 0 {
        return 0 - 1
    }
    let mut lo: i64 = 0
    let mut hi = n - 1
    while lo <= hi {
        let mid = lo + (hi - lo) / 2
        let r = vec_get(rows, mid)
        let c = str_cmp(r.key, key)
        if c == 0 {
            return mid
        }
        if c < 0 {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return 0 - 1
}

fn sst_hit_from_row(r: SstRow) -> SstHit {
    if r.op == 2 {
        return SstHit { found: 1, alive: 0, val: bytes_new(0) }
    }
    return SstHit { found: 1, alive: 1, val: r.val }
}

// Last key in [start, end) record range (for max filter).
fn sst_last_key(body: bytes, start: i64, end: i64) -> str {
    let mut pos = start
    let mut last: str = ""
    let mut go: i64 = 1
    while go == 1 {
        if pos >= end {
            go = 0
        } else {
            let rec = sst_rec_at(body, pos)
            if rec.ok == 0 {
                go = 0
            } else {
                if rec.next > end {
                    go = 0
                } else {
                    last = rec.key
                    pos = rec.next
                }
            }
        }
    }
    return last
}

// v2: restart index bsearch + scan one block. Body is CRC-verified file body.
fn sst_lookup_v2(body: bytes, key: str) -> SstHit {
    let miss = SstHit { found: 0, alive: 0, val: bytes_new(0) }
    let blen = bytes_len(body)
    if blen < 8 {
        return miss
    }
    let count = get_u32_le(body, 0)
    if count <= 0 {
        return miss
    }
    let n_restarts = get_u32_le(body, blen - 4)
    if n_restarts <= 0 {
        return miss
    }
    let idx_base = blen - 4 - n_restarts * 4
    if idx_base < 4 {
        return miss
    }
    // Sanity: first restart at 4.
    let first_off = get_u32_le(body, idx_base)
    if first_off != 4 {
        return miss
    }
    let first_rec = sst_rec_at(body, first_off)
    if first_rec.ok == 0 {
        return miss
    }
    if str_cmp(key, first_rec.key) < 0 {
        return miss
    }
    let last_off = get_u32_le(body, idx_base + (n_restarts - 1) * 4)
    let last_key = sst_last_key(body, last_off, idx_base)
    if len(last_key) == 0 {
        return miss
    }
    if str_cmp(key, last_key) > 0 {
        return miss
    }
    // Bsearch: largest restart with restart_key <= key.
    let mut lo: i64 = 0
    let mut hi = n_restarts - 1
    let mut best: i64 = 0
    while lo <= hi {
        let mid = lo + (hi - lo) / 2
        let off = get_u32_le(body, idx_base + mid * 4)
        let rec = sst_rec_at(body, off)
        if rec.ok == 0 {
            return miss
        }
        let c = str_cmp(rec.key, key)
        if c == 0 {
            return sst_hit_from_row(SstRow { op: rec.op, key: rec.key, val: rec.val })
        }
        if c < 0 {
            best = mid
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    let start = get_u32_le(body, idx_base + best * 4)
    let mut end = idx_base
    if best + 1 < n_restarts {
        end = get_u32_le(body, idx_base + (best + 1) * 4)
    }
    let mut pos = start
    let mut go: i64 = 1
    let mut hit = miss
    while go == 1 {
        if pos >= end {
            go = 0
        } else {
            let rec = sst_rec_at(body, pos)
            if rec.ok == 0 {
                go = 0
            } else {
                if rec.next > end {
                    go = 0
                } else {
                    let c = str_cmp(rec.key, key)
                    if c == 0 {
                        hit = sst_hit_from_row(SstRow { op: rec.op, key: rec.key, val: rec.val })
                        go = 0
                    } else {
                        if c > 0 {
                            go = 0
                        } else {
                            pos = rec.next
                        }
                    }
                }
            }
        }
    }
    return hit
}

// Dispatch v1 (full parse + bsearch) or v2 (restart index).
fn sst_lookup_data(data: bytes, key: str) -> SstHit {
    let miss = SstHit { found: 0, alive: 0, val: bytes_new(0) }
    if bytes_len(data) < 8 + 4 + 4 {
        return miss
    }
    let mag = str_of_bytes(bytes_slice(data, 0, 8))
    let body = bytes_slice(data, 8, bytes_len(data) - 4)
    let got = get_u32_le(data, bytes_len(data) - 4)
    if crc32c_b(body) != got {
        return miss
    }
    if mag == "BAGASST2" {
        return sst_lookup_v2(body, key)
    }
    if mag == "BAGASST1" {
        let p = sst_parse_rows(body)
        if p.ok == 0 {
            return miss
        }
        let j = sst_bsearch(p.rows, key)
        if j < 0 {
            return miss
        }
        return sst_hit_from_row(vec_get(p.rows, j))
    }
    return miss
}

// Newest-first lookup across gens (v2 index path; v1 full parse + bsearch).
fn sst_get(pc: PageCache, dir: str, gens: Vec<i64>, key: str) -> SstLookup !IO {
    let mut cur = pc
    let mut i = vec_len(gens) - 1
    while i >= 0 {
        let gen = vec_get(gens, i)
        let raw = sst_read_raw(cur, dir, gen)?
        cur = raw.pc
        if raw.ok == 1 {
            let h = sst_lookup_data(raw.data, key)
            if h.found == 1 {
                return SstLookup { pc: cur, found: 1, alive: h.alive, val: h.val }
            }
        }
        i = i - 1
    }
    return SstLookup { pc: cur, found: 0, alive: 0, val: bytes_new(0) }
}
