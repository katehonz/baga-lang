// engine.baga — LSM: WAL + memtable + flush + L0..L3 + recovery.
// Values Map<str,bytes>. Flush → L0; promote by file-count (compact_at)
// and/or byte-size targets (target_bytes; L1=4×, L2=16×, L3=64×). R8:
// merge_pick > 0 merges oldest-N only (0 = merge all over files). Pure tombs
// kept on partial merges.

import "codec.baga"
import "page.baga"
import "wal.baga"
import "sstable.baga"
import "std/os/os.baga"
import "std/str/str.baga"

struct LsmDB {
    dir: str,
    mem: Map<str, bytes>,
    tomb: Map<str, i64>,
    mem_n: i64,
    flush_at: i64,
    compact_at: i64,
    target_bytes: i64,  // 0 = byte triggers off; L0 target size
    merge_pick: i64,    // 0 = merge all over files; >0 = oldest-N (R8)
    wal_fd: i64,
    wal_off: i64,
    gens: Vec<i64>,
    levels: Vec<i64>,   // parallel: 0=L0 … 3=L3
    next_gen: i64,
    cache: PageCache,
    sync_every: i64,
    since_sync: i64,
    ok: i64
}

fn lsm_manifest_path(dir: str) -> str {
    return concat(dir, ".manifest")
}

fn lsm_wal_path(dir: str) -> str {
    return concat(dir, ".wal")
}

fn lsm_write_manifest(dir: str, next_gen: i64, gens: Vec<i64>, levels: Vec<i64>) -> i64 !IO {
    let mut s = concat(int_to_str(next_gen), "\n")
    for i in 0..vec_len(gens) {
        let mut lv: i64 = 0
        if i < vec_len(levels) {
            lv = vec_get(levels, i)
        }
        s = concat(s, concat(int_to_str(vec_get(gens, i)), " "))
        s = concat(s, concat(int_to_str(lv), "\n"))
    }
    if write_file(lsm_manifest_path(dir), s)? != 0 {
        return -1
    }
    let fd = open(lsm_manifest_path(dir), 0, 0)?
    if fd >= 0 {
        fsync(fd)?
        close(fd)
    }
    return 0
}

fn lsm_empty_db(dir: str) -> LsmDB {
    let gens: Vec<i64> = vec_new()
    let levels: Vec<i64> = vec_new()
    return LsmDB {
        dir: dir, mem: map_new(), tomb: map_new(), mem_n: 0,
        flush_at: 32, compact_at: 3, target_bytes: 0, merge_pick: 0,
        wal_fd: -1, wal_off: 0,
        gens: gens, levels: levels, next_gen: 1, cache: pc_new(4096, 32),
        sync_every: 1, since_sync: 0, ok: 1
    }
}

fn lsm_read_manifest(dir: str) -> LsmDB !IO {
    let gens: Vec<i64> = vec_new()
    let levels: Vec<i64> = vec_new()
    let body = read_file(lsm_manifest_path(dir))?
    if body == "" {
        return lsm_empty_db(dir)
    }
    let lines = str_split(body, "\n")
    let mut next_gen: i64 = 1
    if vec_len(lines) > 0 && vec_get(lines, 0) != "" {
        next_gen = parse_int(vec_get(lines, 0))
        if next_gen < 1 {
            next_gen = 1
        }
    }
    for i in 1..vec_len(lines) {
        let ln = vec_get(lines, i)
        if ln != "" {
            // "gen level" or legacy "gen"
            let parts = str_split(ln, " ")
            let g = parse_int(vec_get(parts, 0))
            if g > 0 {
                vec_push(gens, g)
                let mut lv: i64 = 0
                if vec_len(parts) >= 2 {
                    lv = parse_int(vec_get(parts, 1))
                    if lv < 0 {
                        lv = 0
                    }
                    if lv > 3 {
                        lv = 3
                    }
                }
                vec_push(levels, lv)
            }
        }
    }
    return LsmDB {
        dir: dir, mem: map_new(), tomb: map_new(), mem_n: 0,
        flush_at: 32, compact_at: 3, target_bytes: 0, merge_pick: 0,
        wal_fd: -1, wal_off: 0,
        gens: gens, levels: levels, next_gen: next_gen, cache: pc_new(4096, 32),
        sync_every: 1, since_sync: 0, ok: 1
    }
}

fn lsm_open(dir: str, flush_at: i64, compact_at: i64) -> LsmDB !IO {
    let mut db = lsm_read_manifest(dir)?
    db.dir = dir
    if flush_at > 0 {
        db.flush_at = flush_at
    }
    if compact_at > 0 {
        db.compact_at = compact_at
    }
    let wfd = open(lsm_wal_path(dir), 66, 420)?
    if wfd < 0 {
        db.ok = 0
        return db
    }
    db.wal_fd = wfd
    let rp = wal_replay(wfd)?
    db.wal_off = rp.end_off
    for i in 0..vec_len(rp.ops) {
        let op = vec_get(rp.ops, i)
        let k = vec_get(rp.keys, i)
        let v = vec_get(rp.vals, i)
        if op == 1 {
            map_set(db.mem, k, v)
            map_del(db.tomb, k)
        } else {
            map_del(db.mem, k)
            map_set(db.tomb, k, 1)
        }
        db.mem_n = db.mem_n + 1
    }
    db.ok = 1
    return db
}

fn lsm_close(db: LsmDB) -> i64 !IO {
    if db.wal_fd >= 0 {
        fdatasync(db.wal_fd)?
        close(db.wal_fd)
    }
    return 0
}

fn lsm_maybe_sync(db: LsmDB) -> LsmDB !IO {
    db.since_sync = db.since_sync + 1
    if db.since_sync >= db.sync_every {
        fdatasync(db.wal_fd)?
        db.since_sync = 0
    }
    return db
}

fn lsm_put_b(db: LsmDB, key: str, val: bytes) -> LsmDB !IO {
    let off = wal_append(db.wal_fd, db.wal_off, 1, key, val)?
    if off < 0 {
        db.ok = 0
        return db
    }
    db.wal_off = off
    map_set(db.mem, key, val)
    map_del(db.tomb, key)
    db.mem_n = db.mem_n + 1
    db = lsm_maybe_sync(db)?
    if db.mem_n >= db.flush_at {
        db = lsm_flush(db)?
    }
    return db
}

fn lsm_put(db: LsmDB, key: str, val: str) -> LsmDB !IO {
    return lsm_put_b(db, key, bytes_of_str(val))?
}

fn lsm_del(db: LsmDB, key: str) -> LsmDB !IO {
    let off = wal_append(db.wal_fd, db.wal_off, 2, key, bytes_new(0))?
    if off < 0 {
        db.ok = 0
        return db
    }
    db.wal_off = off
    map_del(db.mem, key)
    map_set(db.tomb, key, 1)
    db.mem_n = db.mem_n + 1
    db = lsm_maybe_sync(db)?
    if db.mem_n >= db.flush_at {
        db = lsm_flush(db)?
    }
    return db
}

struct LsmGet {
    db: LsmDB,
    found: i64,
    val: bytes
}

fn lsm_get(db: LsmDB, key: str) -> LsmGet !IO {
    if map_has(db.tomb, key) == 1 {
        return LsmGet { db: db, found: 0, val: bytes_new(0) }
    }
    if map_has(db.mem, key) == 1 {
        return LsmGet { db: db, found: 1, val: map_get(db.mem, key) }
    }
    let lk = sst_get(db.cache, db.dir, db.gens, key)?
    db.cache = lk.pc
    if lk.found == 1 {
        if lk.alive == 1 {
            return LsmGet { db: db, found: 1, val: lk.val }
        }
        return LsmGet { db: db, found: 0, val: bytes_new(0) }
    }
    return LsmGet { db: db, found: 0, val: bytes_new(0) }
}

fn lsm_exists(db: LsmDB, key: str) -> LsmGet !IO {
    return lsm_get(db, key)?
}

fn lsm_count_level(levels: Vec<i64>, want: i64) -> i64 {
    let mut n: i64 = 0
    for i in 0..vec_len(levels) {
        if vec_get(levels, i) == want {
            n = n + 1
        }
    }
    return n
}

// On-disk size of one SST (0 if missing).
fn lsm_sst_bytes(dir: str, gen: i64) -> i64 !IO {
    let fd = open(sst_path(dir, gen), 0, 0)?
    if fd < 0 {
        return 0
    }
    let n = fd_size(fd)?
    close(fd)
    if n < 0 {
        return 0
    }
    return n
}

// Sum of SST sizes at a level.
fn lsm_level_bytes(db: LsmDB, want: i64) -> i64 !IO {
    let mut total: i64 = 0
    for i in 0..vec_len(db.gens) {
        if i < vec_len(db.levels) && vec_get(db.levels, i) == want {
            total = total + lsm_sst_bytes(db.dir, vec_get(db.gens, i))?
        }
    }
    return total
}

// Byte target for level: L0 = target_bytes, L1 = 4×, L2 = 16×, L3 = 64×.
// 0 means byte-size compaction is disabled for all levels.
fn lsm_level_target(db: LsmDB, level: i64) -> i64 {
    if db.target_bytes <= 0 {
        return 0
    }
    let mut t = db.target_bytes
    let mut lv: i64 = 0
    while lv < level {
        t = t * 4
        lv = lv + 1
    }
    return t
}

// 1 if this level should compact (file-count and/or byte target; need ≥2 files).
fn lsm_level_over(db: LsmDB, level: i64, nfiles: i64, nbytes: i64) -> i64 {
    if nfiles < 2 {
        return 0
    }
    if nfiles >= db.compact_at {
        return 1
    }
    let tgt = lsm_level_target(db, level)
    if tgt > 0 && nbytes >= tgt {
        return 1
    }
    return 0
}

// First `k` indices (oldest-first within level). k clamped to [0, len].
fn lsm_take_oldest(idxs: Vec<i64>, k: i64) -> Vec<i64> {
    let out: Vec<i64> = vec_new()
    let n = vec_len(idxs)
    let mut m = k
    if m > n {
        m = n
    }
    if m < 0 {
        m = 0
    }
    let mut i: i64 = 0
    while i < m {
        vec_push(out, vec_get(idxs, i))
        i = i + 1
    }
    return out
}

// R8 pick: merge_pick==0 → all idxs; else oldest max(2, merge_pick) (capped by n).
// With byte targets: grow the pick until cumulative size ≥ level target.
fn lsm_pick_merge(db: LsmDB, idxs: Vec<i64>, level: i64) -> Vec<i64> !IO {
    let n = vec_len(idxs)
    if n < 2 {
        return idxs
    }
    if db.merge_pick <= 0 {
        return idxs
    }
    let mut k = db.merge_pick
    if k < 2 {
        k = 2
    }
    if k > n {
        k = n
    }
    let tgt = lsm_level_target(db, level)
    if tgt > 0 {
        let mut sum: i64 = 0
        let mut i: i64 = 0
        let mut done: i64 = 0
        while i < n && done == 0 {
            let gen = vec_get(db.gens, vec_get(idxs, i))
            sum = sum + lsm_sst_bytes(db.dir, gen)?
            i = i + 1
            if i >= 2 && sum >= tgt {
                if i >= k {
                    k = i
                    done = 1
                }
            }
        }
        if done == 0 {
            k = n
        }
        if k > n {
            k = n
        }
        if k < 2 {
            k = 2
        }
    }
    return lsm_take_oldest(idxs, k)
}

// Merge gens at given indices (ascending order), write new SST at `out_level`.
// Pure tombs dropped only when the merge covers *all* gens (nothing older left
// to shadow). Partial merges (L0→L1 with L1 remaining) keep pure tombs.
fn lsm_merge_indices(db: LsmDB, idxs: Vec<i64>, out_level: i64) -> LsmDB !IO {
    if vec_len(idxs) < 1 {
        return db
    }
    let keep_tombs = vec_len(idxs) < vec_len(db.gens)
    let acc: Map<str, bytes> = map_new()
    let tomb: Map<str, i64> = map_new()
    let mut cur = db.cache
    for ii in 0..vec_len(idxs) {
        let gen = vec_get(db.gens, vec_get(idxs, ii))
        let ld = sst_load(cur, db.dir, gen)?
        cur = ld.pc
        if ld.parse.ok == 1 {
            for j in 0..vec_len(ld.parse.rows) {
                let r = vec_get(ld.parse.rows, j)
                if r.op == 2 {
                    map_del(acc, r.key)
                    map_set(tomb, r.key, 1)
                } else {
                    map_set(acc, r.key, r.val)
                    map_del(tomb, r.key)
                }
            }
        }
    }
    db.cache = cur
    let keys = map_keys(acc)
    let tkeys = map_keys(tomb)
    let all: Vec<str> = vec_new()
    for ki in 0..vec_len(keys) {
        vec_push(all, vec_get(keys, ki))
    }
    if keep_tombs == 1 {
        for ti in 0..vec_len(tkeys) {
            let k = vec_get(tkeys, ti)
            if map_has(acc, k) == 0 {
                vec_push(all, k)
            }
        }
    }
    sort_strs(all)
    let rows: Vec<SstRow> = vec_new()
    for ki in 0..vec_len(all) {
        let k = vec_get(all, ki)
        if map_has(tomb, k) == 1 && map_has(acc, k) == 0 {
            vec_push(rows, SstRow { op: 2, key: k, val: bytes_new(0) })
        } else {
            vec_push(rows, SstRow { op: 1, key: k, val: map_get(acc, k) })
        }
    }
    let new_gen = db.next_gen
    if vec_len(rows) > 0 {
        if sst_write(db.dir, new_gen, rows)? != 0 {
            db.ok = 0
            return db
        }
        db.next_gen = new_gen + 1
    }
    // Mark which indices were merged
    let dropm: Map<i64, i64> = map_new()
    for ii in 0..vec_len(idxs) {
        let ix = vec_get(idxs, ii)
        map_set(dropm, ix, 1)
        let g = vec_get(db.gens, ix)
        unlink(sst_path(db.dir, g))?
        unlink(bloom_path(db.dir, g))?
        db.cache = pc_invalidate_file(db.cache, g)
    }
    // Rebuild oldest-first: L3 … L0; append new file at end of its level.
    let ng: Vec<i64> = vec_new()
    let nl: Vec<i64> = vec_new()
    let mut target_lv: i64 = 3
    while target_lv >= 0 {
        for i in 0..vec_len(db.gens) {
            if map_has(dropm, i) == 0 {
                if vec_get(db.levels, i) == target_lv {
                    vec_push(ng, vec_get(db.gens, i))
                    vec_push(nl, target_lv)
                }
            }
        }
        if vec_len(rows) > 0 && out_level == target_lv {
            vec_push(ng, new_gen)
            vec_push(nl, out_level)
        }
        target_lv = target_lv - 1
    }
    db.gens = ng
    db.levels = nl
    if lsm_write_manifest(db.dir, db.next_gen, db.gens, db.levels)? != 0 {
        db.ok = 0
        return db
    }
    return db
}

// Collect indices at `level` into out vec (caller-owned).
fn lsm_indices_at(db: LsmDB, level: i64) -> Vec<i64> {
    let out: Vec<i64> = vec_new()
    for i in 0..vec_len(db.gens) {
        if i < vec_len(db.levels) && vec_get(db.levels, i) == level {
            vec_push(out, i)
        }
    }
    return out
}

// L0→L1→L2→L3 by file-count and/or byte targets; R8 oldest-N when merge_pick>0.
fn lsm_compact(db: LsmDB) -> LsmDB !IO {
    // L0 → L1
    let l0 = lsm_indices_at(db, 0)
    let b0 = lsm_level_bytes(db, 0)?
    if lsm_level_over(db, 0, vec_len(l0), b0) == 1 {
        let p0 = lsm_pick_merge(db, l0, 0)?
        db = lsm_merge_indices(db, p0, 1)?
    }
    // L1 → L2
    let l1 = lsm_indices_at(db, 1)
    let b1 = lsm_level_bytes(db, 1)?
    if lsm_level_over(db, 1, vec_len(l1), b1) == 1 {
        let p1 = lsm_pick_merge(db, l1, 1)?
        db = lsm_merge_indices(db, p1, 2)?
    } else {
        // Legacy R5: collapse a pair of L1 files when under compact_at (file path only).
        if vec_len(l1) >= 2 && vec_len(l1) < db.compact_at && db.target_bytes <= 0 {
            let p1b = lsm_take_oldest(l1, 2)
            db = lsm_merge_indices(db, p1b, 1)?
        }
    }
    // L2 → L3 (or collapse L2 when no L3 promotion needed)
    let l2 = lsm_indices_at(db, 2)
    let b2 = lsm_level_bytes(db, 2)?
    if lsm_level_over(db, 2, vec_len(l2), b2) == 1 {
        let p2 = lsm_pick_merge(db, l2, 2)?
        db = lsm_merge_indices(db, p2, 3)?
    } else {
        if vec_len(l2) >= 2 && db.target_bytes <= 0 {
            let p2b = lsm_take_oldest(l2, 2)
            db = lsm_merge_indices(db, p2b, 2)?
        }
    }
    // Collapse L3 when multi-file
    let l3 = lsm_indices_at(db, 3)
    let b3 = lsm_level_bytes(db, 3)?
    if vec_len(l3) >= 2 {
        if lsm_level_over(db, 3, vec_len(l3), b3) == 1 || db.target_bytes <= 0 {
            let p3 = lsm_pick_merge(db, l3, 3)?
            db = lsm_merge_indices(db, p3, 3)?
        }
    }
    return db
}

fn lsm_flush(db: LsmDB) -> LsmDB !IO {
    let mk = map_keys(db.mem)
    let tk = map_keys(db.tomb)
    let all: Vec<str> = vec_new()
    for i in 0..vec_len(mk) {
        vec_push(all, vec_get(mk, i))
    }
    for i in 0..vec_len(tk) {
        let k = vec_get(tk, i)
        if map_has(db.mem, k) == 0 {
            vec_push(all, k)
        }
    }
    sort_strs(all)
    let rows: Vec<SstRow> = vec_new()
    for i in 0..vec_len(all) {
        let k = vec_get(all, i)
        if map_has(db.tomb, k) == 1 && map_has(db.mem, k) == 0 {
            vec_push(rows, SstRow { op: 2, key: k, val: bytes_new(0) })
        } else {
            vec_push(rows, SstRow { op: 1, key: k, val: map_get(db.mem, k) })
        }
    }
    let gen = db.next_gen
    if vec_len(rows) > 0 {
        if sst_write(db.dir, gen, rows)? != 0 {
            db.ok = 0
            return db
        }
        vec_push(db.gens, gen)
        vec_push(db.levels, 0)   // L0
        db.next_gen = gen + 1
    }
    if lsm_write_manifest(db.dir, db.next_gen, db.gens, db.levels)? != 0 {
        db.ok = 0
        return db
    }
    close(db.wal_fd)
    unlink(lsm_wal_path(db.dir))?
    let wfd = open(lsm_wal_path(db.dir), 578, 420)?
    if wfd < 0 {
        db.ok = 0
        return db
    }
    db.wal_fd = wfd
    db.wal_off = 0
    db.mem = map_new()
    db.tomb = map_new()
    db.mem_n = 0
    db.since_sync = 0
    // L0..L3 compaction (chain while any level is over file or byte threshold)
    let mut guard: i64 = 0
    let mut more: i64 = 1
    while more == 1 && guard < 32 {
        let n0 = lsm_count_level(db.levels, 0)
        let n1 = lsm_count_level(db.levels, 1)
        let n2 = lsm_count_level(db.levels, 2)
        let n3 = lsm_count_level(db.levels, 3)
        let b0 = lsm_level_bytes(db, 0)?
        let b1 = lsm_level_bytes(db, 1)?
        let b2 = lsm_level_bytes(db, 2)?
        let b3 = lsm_level_bytes(db, 3)?
        let over0 = lsm_level_over(db, 0, n0, b0)
        let over1 = lsm_level_over(db, 1, n1, b1)
        let over2 = lsm_level_over(db, 2, n2, b2)
        let over3 = lsm_level_over(db, 3, n3, b3)
        // File-count legacy: pair collapse L1/L2/L3 when byte targets off
        let mut pair: i64 = 0
        if db.target_bytes <= 0 {
            if n1 >= 2 || n2 >= 2 || n3 >= 2 {
                pair = 1
            }
        }
        if over0 == 1 || over1 == 1 || over2 == 1 || over3 == 1 || pair == 1 {
            db = lsm_compact(db)?
            guard = guard + 1
        } else {
            more = 0
        }
    }
    return db
}

fn lsm_flush_force(db: LsmDB) -> LsmDB !IO {
    if db.mem_n == 0 {
        return db
    }
    return lsm_flush(db)?
}

struct LsmGetKeys {
    db: LsmDB,
    keys: Vec<str>
}

fn lsm_keys(db: LsmDB) -> LsmGetKeys !IO {
    let seen: Map<str, i64> = map_new()
    let mut cur = db.cache
    for i in 0..vec_len(db.gens) {
        let gen = vec_get(db.gens, i)
        let ld = sst_load(cur, db.dir, gen)?
        cur = ld.pc
        if ld.parse.ok == 1 {
            for j in 0..vec_len(ld.parse.rows) {
                let r = vec_get(ld.parse.rows, j)
                if r.op == 2 {
                    map_del(seen, r.key)
                } else {
                    map_set(seen, r.key, 1)
                }
            }
        }
    }
    db.cache = cur
    let mk = map_keys(db.mem)
    for i in 0..vec_len(mk) {
        map_set(seen, vec_get(mk, i), 1)
    }
    let tk = map_keys(db.tomb)
    for i in 0..vec_len(tk) {
        map_del(seen, vec_get(tk, i))
    }
    let out = map_keys(seen)
    sort_strs(out)
    return LsmGetKeys { db: db, keys: out }
}
