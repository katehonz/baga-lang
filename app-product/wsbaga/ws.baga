// ws.baga — WebSocket (RFC 6455) for Baga: handshake + frame codec + echo server.
//
// Layering (same probe model as kvbaga/pgbaga):
//   ws_serve / ws_handle_conn          — effectful socket loop (!Net !IO !Random)
//   ws_read_frame / ws_build_frame     — frame codec over a buffered conn
//   ws_server_handshake / ws_accept_key — HTTP upgrade (httpdbaga + std/crypto sha1)
//   client helpers                     — ws_client_connect / ws_send_* (masked frames)
//
// Honest limits (gaps.md): serial connections (K1 model), no
// permessage-deflate, no close-status interpretation (close payload echoed
// as-is). Fragmented messages ARE reassembled (ws_read_message, W2 closed).

import "httpdbaga/http.baga"
import "std/crypto/sha1.baga"
import "std/bytes/bytes.baga"
import "std/str/str.baga"
import "std/random/random.baga"
import "std/net/tcp.baga"

// ---------- constants ----------

fn ws_guid() -> str {
    return "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
}

fn WS_TEXT() -> i64 { return 1 }
fn WS_BINARY() -> i64 { return 2 }
fn WS_CLOSE() -> i64 { return 8 }
fn WS_PING() -> i64 { return 9 }
fn WS_PONG() -> i64 { return 10 }

// ---------- handshake (pure + server side) ----------

// RFC 6455 §4.2.2: base64(SHA-1(client key + GUID)).
fn ws_accept_key(client_key: str) -> str {
    return base64_encode(sha1(concat(client_key, ws_guid())))
}

fn ws_server_handshake(fd: i64) -> i64 !IO !Net {
    let req = http_read_request(fd)?
    if http_method(req) != "GET" {
        return 0
    }
    let up = to_lower(http_header(req, "upgrade"))
    if str_find(up, "websocket") < 0 {
        return 0
    }
    let key = http_header(req, "sec-websocket-key")
    if key == "" {
        return 0
    }
    let head = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: "
    let resp = concat(concat(head, ws_accept_key(key)), "\r\n\r\n")
    let w = tcp_write_bytes(fd, bytes_of_str(resp))?
    if w != 0 {
        return 0
    }
    return 1
}

// ---------- byte writers (big-endian) ----------

fn wb1(v: i64) -> bytes {
    let x = vec_new()
    vec_push(x, v & 255)
    return bytes_from_vec(x)
}

fn wb2(v: i64) -> bytes {
    let x = vec_new()
    vec_push(x, (v >> 8) & 255)
    vec_push(x, v & 255)
    return bytes_from_vec(x)
}

fn wb8(v: i64) -> bytes {
    let x = vec_new()
    let mut i: i64 = 7
    while i >= 0 {
        vec_push(x, (v >> (i * 8)) & 255)
        i = i - 1
    }
    return bytes_from_vec(x)
}

// ---------- frame codec ----------

struct WsConn {
    fd: i64,
    buf: bytes,   // residual bytes not yet consumed
    frag_op: i64, // 0 = no fragmented message in progress; else its opcode
    frag: bytes   // accumulated payload of the fragmented message (W2)
}

fn ws_conn(fd: i64) -> WsConn {
    return WsConn { fd: fd, buf: bytes_from_vec(vec_new()), frag_op: 0, frag: bytes_from_vec(vec_new()) }
}

struct WsFill {
    conn: WsConn,
    ok: i64
}

// Ensure at least n bytes in the buffer. ok=0 on EOF/error.
fn ws_fill(c: WsConn, n: i64) -> WsFill !IO !Net {
    let mut conn = c
    while bytes_len(conn.buf) < n {
        let chunk = tcp_read_bytes(conn.fd, 4096)?
        if bytes_len(chunk) == 0 {
            return WsFill { conn: conn, ok: 0 }
        }
        conn = WsConn { fd: conn.fd, buf: bytes_concat(conn.buf, chunk), frag_op: conn.frag_op, frag: conn.frag }
    }
    return WsFill { conn: conn, ok: 1 }
}

struct WsFrame {
    fin: i64,
    opcode: i64,
    payload: bytes
}

struct WsRead {
    conn: WsConn,
    frame: WsFrame,
    ok: i64,    // 1 = full frame
    bad: i64    // 1 = protocol violation (caller should close)
}

fn ws_read_bad(conn: WsConn) -> WsRead {
    return WsRead {
        conn: conn,
        frame: WsFrame { fin: 0, opcode: 0, payload: bytes_from_vec(vec_new()) },
        ok: 0,
        bad: 1
    }
}

struct WsTryParse {
    ok: i64,        // 1 = one full frame parsed
    bad: i64,       // 1 = protocol violation (close the connection)
    frame: WsFrame,
    consumed: i64
}

fn ws_try_empty() -> WsTryParse {
    return WsTryParse { ok: 0, bad: 0, frame: WsFrame { fin: 0, opcode: 0, payload: bytes_from_vec(vec_new()) }, consumed: 0 }
}

// Pure frame parse over what is in the buffer. ok=0 → need more bytes.
// Continuation frames (opcode 0) come through; servers without reassembly
// treat them as errors (see gaps.md W2).
fn ws_try_parse_frame(buf: bytes) -> WsTryParse {
    let n = bytes_len(buf)
    if n < 2 {
        return ws_try_empty()
    }
    let b0 = bytes_at(buf, 0)
    let b1 = bytes_at(buf, 1)
    let fin = (b0 >> 7) & 1
    let opcode = b0 & 15
    let masked = (b1 >> 7) & 1
    let mut plen: i64 = b1 & 127
    let mut off: i64 = 2
    if plen == 126 {
        if n < 4 {
            return ws_try_empty()
        }
        plen = (bytes_at(buf, 2) << 8) | bytes_at(buf, 3)
        off = 4
    } else {
        if plen == 127 {
            if n < 10 {
                return ws_try_empty()
            }
            plen = 0
            let mut i: i64 = 0
            while i < 8 {
                plen = plen * 256 + bytes_at(buf, 2 + i)
                i = i + 1
            }
            off = 10
        }
    }
    if plen < 0 || plen > 67108864 {   // 64 MiB sanity cap
        return WsTryParse { ok: 0, bad: 1, frame: WsFrame { fin: 0, opcode: 0, payload: bytes_from_vec(vec_new()) }, consumed: 0 }
    }
    if masked == 1 {
        if n < off + 4 + plen {
            return ws_try_empty()
        }
    } else {
        if n < off + plen {
            return ws_try_empty()
        }
    }
    let mut mask = bytes_from_vec(vec_new())
    if masked == 1 {
        mask = bytes_slice(buf, off, off + 4)
        off = off + 4
    }
    let mut payload = bytes_slice(buf, off, off + plen)
    if masked == 1 {
        let v = vec_new()
        let mut i: i64 = 0
        while i < plen {
            vec_push(v, (bytes_at(payload, i) ^ bytes_at(mask, i % 4)) & 255)
            i = i + 1
        }
        payload = bytes_from_vec(v)
    }
    return WsTryParse {
        ok: 1,
        bad: 0,
        frame: WsFrame { fin: fin, opcode: opcode, payload: payload },
        consumed: off + plen
    }
}

// Blocking reader built on the pure parser: fill until one frame lands.
fn ws_read_frame(c: WsConn) -> WsRead !IO !Net {
    let mut conn = c
    let mut t = ws_try_parse_frame(conn.buf)
    while t.ok == 0 && t.bad == 0 {
        let f = ws_fill(conn, bytes_len(conn.buf) + 1)?
        conn = f.conn
        if f.ok == 0 {
            return WsRead { conn: conn, frame: WsFrame { fin: 0, opcode: 0, payload: bytes_from_vec(vec_new()) }, ok: 0, bad: 0 }
        }
        t = ws_try_parse_frame(conn.buf)
    }
    if t.bad == 1 {
        return ws_read_bad(conn)
    }
    conn = WsConn { fd: conn.fd, buf: bytes_slice(conn.buf, t.consumed, bytes_len(conn.buf)), frag_op: conn.frag_op, frag: conn.frag }
    return WsRead { conn: conn, frame: t.frame, ok: 1, bad: 0 }
}

// Message-level reader (W2): reassembles fragmented messages.
// A data frame with FIN=0 starts accumulation; continuation frames
// (opcode 0) extend it; the final continuation returns ONE WsRead with
// the original opcode and the full payload. Control frames (close/ping/
// pong) are delivered immediately even mid-message, as the RFC requires.
// A continuation with no active message — or a new data frame before the
// current one finishes — is a protocol violation (bad=1). Accumulated
// messages stay under the same 64 MiB sanity cap as frames.
fn ws_read_message(c: WsConn) -> WsRead !IO !Net {
    let mut conn = c
    let mut done = 0
    let mut out = ws_read_bad(conn)
    while done == 0 {
        let r = ws_read_frame(conn)?
        conn = r.conn
        if r.ok == 0 || r.bad == 1 {
            return WsRead { conn: conn, frame: r.frame, ok: r.ok, bad: r.bad }
        }
        let op = r.frame.opcode
        if op == 0 {
            // continuation
            if conn.frag_op == 0 {
                return ws_read_bad(conn)   // no active message
            }
            conn = WsConn { fd: conn.fd, buf: conn.buf, frag_op: conn.frag_op,
                            frag: bytes_concat(conn.frag, r.frame.payload) }
            if bytes_len(conn.frag) > 67108864 {
                return ws_read_bad(conn)
            }
            if r.frame.fin == 1 {
                let msg = WsFrame { fin: 1, opcode: conn.frag_op, payload: conn.frag }
                conn = WsConn { fd: conn.fd, buf: conn.buf, frag_op: 0, frag: bytes_from_vec(vec_new()) }
                return WsRead { conn: conn, frame: msg, ok: 1, bad: 0 }
            }
        } else {
            if op == WS_TEXT() || op == WS_BINARY() {
                if conn.frag_op != 0 {
                    return ws_read_bad(conn)   // new message before finishing the current
                }
                if r.frame.fin == 1 {
                    return WsRead { conn: conn, frame: r.frame, ok: 1, bad: 0 }
                }
                conn = WsConn { fd: conn.fd, buf: conn.buf, frag_op: op, frag: r.frame.payload }
            } else {
                // control frame — delivered immediately
                return WsRead { conn: conn, frame: r.frame, ok: 1, bad: 0 }
            }
        }
    }
    return out
}

// ---------- incremental handshake parse (pure, for event loops) ----------

struct WsHandshakeParse {
    ok: i64,        // 1 = upgrade request complete, response ready
    bad: i64,       // 1 = not a valid upgrade request (close the connection)
    response: str,  // the 101 text to send
    consumed: i64   // header section length incl. \r\n\r\n
}

fn ws_parse_handshake_buf(buf: bytes) -> WsHandshakeParse {
    let no = WsHandshakeParse { ok: 0, bad: 0, response: "", consumed: 0 }
    let sep = ws_find_sub(buf, bytes_of_str("\r\n\r\n"))
    if sep < 0 {
        if bytes_len(buf) > 8192 {
            return WsHandshakeParse { ok: 0, bad: 1, response: "", consumed: 0 }
        }
        return no
    }
    let head = str_of_bytes(bytes_slice(buf, 0, sep))
    // str_split cuts on the FIRST delimiter char only — normalize CRLF → LF
    let lines = str_split(str_replace(head, "\r\n", "\n"), "\n")
    if vec_len(lines) == 0 {
        return WsHandshakeParse { ok: 0, bad: 1, response: "", consumed: 0 }
    }
    if !str_starts_with(vec_get(lines, 0), "GET ") {
        return WsHandshakeParse { ok: 0, bad: 1, response: "", consumed: 0 }
    }
    let mut key = ""
    let mut upgrade_ok: i64 = 0
    let mut i: i64 = 1
    while i < vec_len(lines) {
        let line = vec_get(lines, i)
        let low = to_lower(line)
        if str_starts_with(low, "upgrade:") && str_find(low, "websocket") >= 0 {
            upgrade_ok = 1
        }
        if str_starts_with(low, "sec-websocket-key:") {
            key = str_trim(substr(line, 18, len(line)))
        }
        i = i + 1
    }
    if upgrade_ok == 0 || key == "" {
        return WsHandshakeParse { ok: 0, bad: 1, response: "", consumed: 0 }
    }
    let head_txt = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: "
    return WsHandshakeParse {
        ok: 1,
        bad: 0,
        response: concat(concat(head_txt, ws_accept_key(key)), "\r\n\r\n"),
        consumed: sep + 4
    }
}

// XOR mask/unmask (same operation both ways).
fn ws_apply_mask(payload: bytes, mask: bytes) -> bytes {
    let v = vec_new()
    let n = bytes_len(payload)
    let mut i: i64 = 0
    while i < n {
        vec_push(v, (bytes_at(payload, i) ^ bytes_at(mask, i % 4)) & 255)
        i = i + 1
    }
    return bytes_from_vec(v)
}

// Build one frame. mask_key: 0 = unmasked (server); else the 32-bit key
// (client frames MUST be masked per RFC 6455).
fn ws_build_frame(fin: i64, opcode: i64, payload: bytes, mask_key: i64) -> bytes {
    let n = bytes_len(payload)
    let mut maskbit: i64 = 0
    if mask_key != 0 {
        maskbit = 128
    }
    let b0 = (fin << 7) | opcode
    let mut out = wb1(b0)
    if n < 126 {
        out = bytes_concat(out, wb1(n | maskbit))
    } else {
        if n < 65536 {
            out = bytes_concat(out, wb1(126 | maskbit))
            out = bytes_concat(out, wb2(n))
        } else {
            out = bytes_concat(out, wb1(127 | maskbit))
            out = bytes_concat(out, wb8(n))
        }
    }
    if mask_key != 0 {
        let mv = vec_new()
        vec_push(mv, (mask_key >> 24) & 255)
        vec_push(mv, (mask_key >> 16) & 255)
        vec_push(mv, (mask_key >> 8) & 255)
        vec_push(mv, mask_key & 255)
        let mask = bytes_from_vec(mv)
        out = bytes_concat(out, mask)
        out = bytes_concat(out, ws_apply_mask(payload, mask))
    } else {
        out = bytes_concat(out, payload)
    }
    return out
}

// ---------- echo server ----------

fn ws_handle_conn(fd: i64) -> i64 !IO !Net !Random {
    let hs = ws_server_handshake(fd)?
    if hs == 0 {
        tcp_close(fd)?
        return 0
    }
    let mut conn = ws_conn(fd)
    let mut running: i64 = 1
    while running == 1 {
        let r = ws_read_message(conn)?
        conn = r.conn
        if r.ok == 0 {
            running = 0
        } else {
            if r.bad == 1 {
                running = 0   // protocol violation
            } else {
                let op = r.frame.opcode
                if op == WS_CLOSE() {
                    let resp = ws_build_frame(1, WS_CLOSE(), r.frame.payload, 0)
                    tcp_write_bytes(fd, resp)?
                    running = 0
                } else {
                    if op == WS_PING() {
                        let resp = ws_build_frame(1, WS_PONG(), r.frame.payload, 0)
                        tcp_write_bytes(fd, resp)?
                    } else {
                        if op == WS_TEXT() || op == WS_BINARY() {
                            let resp = ws_build_frame(1, op, r.frame.payload, 0)
                            tcp_write_bytes(fd, resp)?
                        }
                        // PONG: ignore
                    }
                }
            }
        }
    }
    tcp_close(fd)?
    return 0
}

// Serial accept loop (same honest model as kvbaga; event loop is the P1).
fn ws_serve(port: i64) -> i64 !Net !IO !Random !Par {
    let listener = tcp_listen(port)?
    if listener < 0 {
        return -1
    }
    while true {
        let fd = tcp_accept(listener)?
        if fd >= 0 {
            ws_handle_conn(fd)?
        }
    }
    return 0
}

// ---------- client (tests / demo) ----------

struct WsDial {
    ok: i64,
    conn: WsConn
}

// Connect + upgrade. Verifies the server's Sec-WebSocket-Accept.
fn ws_client_connect(host: str, port: i64, timeout_s: i64) -> WsDial !Net !IO !Random {
    let bad = WsDial { ok: 0, conn: ws_conn(-1) }
    let fd = tcp_connect_to(host, port, timeout_s)?
    if fd < 0 {
        return bad
    }
    let key = base64_encode(random_bytes(16)?)
    let mut req = concat(concat("GET /ws HTTP/1.1\r\nHost: ", host), concat(":", int_to_str(port)))
    req = concat(req, "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: ")
    req = concat(req, key)
    req = concat(req, "\r\nSec-WebSocket-Version: 13\r\n\r\n")
    let w = tcp_write_bytes(fd, bytes_of_str(req))?
    if w != 0 {
        tcp_close(fd)?
        return bad
    }
    // read until the header/body separator
    let mut buf = bytes_from_vec(vec_new())
    let mut split: i64 = -1
    let mut tries: i64 = 0
    while split < 0 && tries < 256 {
        let chunk = tcp_read_bytes(fd, 4096)?
        if bytes_len(chunk) == 0 {
            tcp_close(fd)?
            return bad
        }
        buf = bytes_concat(buf, chunk)
        let sep = bytes_of_str("\r\n\r\n")
        split = ws_find_sub(buf, sep)
        tries = tries + 1
    }
    if split < 0 {
        tcp_close(fd)?
        return bad
    }
    let head = str_of_bytes(bytes_slice(buf, 0, split))
    if str_find(head, "101") < 0 {
        tcp_close(fd)?
        return bad
    }
    let expect = ws_accept_key(key)
    if str_find(to_lower(head), to_lower(expect)) < 0 {
        tcp_close(fd)?
        return bad
    }
    let leftover = bytes_slice(buf, split + 4, bytes_len(buf))
    return WsDial { ok: 1, conn: WsConn { fd: fd, buf: leftover, frag_op: 0, frag: bytes_from_vec(vec_new()) } }
}

// Index of needle in hay; -1 if absent.
fn ws_find_sub(hay: bytes, needle: bytes) -> i64 {
    let hn = bytes_len(hay)
    let nn = bytes_len(needle)
    if nn == 0 || hn < nn {
        return -1
    }
    let mut i: i64 = 0
    while i + nn <= hn {
        let mut j: i64 = 0
        let mut hit: i64 = 1
        while j < nn {
            if bytes_at(hay, i + j) != bytes_at(needle, j) {
                hit = 0
                j = nn
            } else {
                j = j + 1
            }
        }
        if hit == 1 {
            return i
        }
        i = i + 1
    }
    return -1
}

// Masked client send (RFC requires client masking).
fn ws_send_frame(fd: i64, opcode: i64, payload: bytes) -> i64 !Net !IO !Random {
    let mv = random_bytes(4)?
    let mask_key = (vec_get(mv, 0) << 24) | (vec_get(mv, 1) << 16) | (vec_get(mv, 2) << 8) | vec_get(mv, 3)
    if mask_key == 0 {
        // never send an all-zero key (RFC §5.3); flip a bit
        return tcp_write_bytes(fd, ws_build_frame(1, opcode, payload, 1))?
    }
    return tcp_write_bytes(fd, ws_build_frame(1, opcode, payload, mask_key))?
}

fn ws_send_text(fd: i64, s: str) -> i64 !Net !IO !Random {
    return ws_send_frame(fd, WS_TEXT(), bytes_of_str(s))?
}

fn ws_send_binary(fd: i64, b: bytes) -> i64 !Net !IO !Random {
    return ws_send_frame(fd, WS_BINARY(), b)?
}

fn ws_send_ping(fd: i64, payload: bytes) -> i64 !Net !IO !Random {
    return ws_send_frame(fd, WS_PING(), payload)?
}

fn ws_send_close(fd: i64) -> i64 !Net !IO !Random {
    return ws_send_frame(fd, WS_CLOSE(), bytes_from_vec(vec_new()))?
}
