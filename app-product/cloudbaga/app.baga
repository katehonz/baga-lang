// app.baga — cloudbaga service logic (importable without main).

import "httpdbaga/http.baga"
import "metbaga/met.baga"
import "logbaga/log.baga"
import "otelbaga/otel.baga"
import "pbbaga/grpc_unary.baga"
import "std/net/tcp.baga"
import "std/net/poll.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn SIGTERM() -> i64 { return 15 }
fn SIGINT() -> i64 { return 2 }

struct CloudState {
    metrics: Metrics,
    h_req: i64,
    h_up: i64,
    ready: i64
}

fn cloud_new() -> CloudState {
    let m = met_new()
    let h_req = met_counter(m, "http_requests_total", "Total HTTP requests handled")
    let h_up = met_gauge(m, "process_up", "1 if process is up")
    met_set(m, h_up, 1)
    return CloudState { metrics: m, h_req: h_req, h_up: h_up, ready: 1 }
}

fn cloud_handle(st: CloudState, req: Request) -> Response !Random !Time {
    met_inc(st.metrics, st.h_req)
    let method = http_method(req)
    let path = http_path_only(req)
    let tr = otel_from_header(http_header(req, otel_header_name()))?
    log_info_trace(concat(concat(method, " "), path), tr.trace_id, tr.span_id)?

    // gRPC unary Hello
    if method == "POST" && grpc_is_method_path(path) == 1 {
        let mut r = grpc_hello_response(http_body_bytes(req))
        r = http_set_header(r, otel_header_name(), otel_format(tr))
        return r
    }

    if method == "GET" && path == "/healthz" {
        return http_json_response(200, "{\"status\":\"ok\"}")
    }
    if method == "GET" && path == "/readyz" {
        if st.ready == 1 {
            return http_json_response(200, "{\"ready\":true}")
        }
        return http_json_response(503, "{\"ready\":false}")
    }
    if method == "GET" && path == "/metrics" {
        let body = met_render(st.metrics)
        let resp = http_response(200, body)
        return http_set_header(resp, "Content-Type", "text/plain; version=0.0.4")
    }
    if method == "GET" && (path == "/" || path == "/hello") {
        let mut body = "{\"service\":\"cloudbaga\",\"msg\":\"Здравей, облак\""
        body = concat(body, concat(concat(",\"trace_id\":\"", tr.trace_id), "\"}"))
        let mut r = http_json_response(200, body)
        r = http_set_header(r, otel_header_name(), otel_format(tr))
        return r
    }
    return http_json_response(404, "{\"error\":\"not found\"}")
}

fn cloud_serve_one(st: CloudState, fd: i64) -> i64 !IO !Net !Random !Time {
    let out = http_read_request(fd)?
    if http_method(out) == "" {
        tcp_close(fd)?
        return 0
    }
    let resp = cloud_handle(st, out)?
    http_respond(fd, resp)?
    tcp_close(fd)?
    return 0
}

fn cloud_run(port: i64) -> i64 !Net !IO !Par !Time !Random {
    signal_watch(SIGTERM())
    signal_watch(SIGINT())

    let st = cloud_new()
    let listener = tcp_listen(port)?
    if listener < 0 {
        log_error("listen failed")?
        return 1
    }
    log_info(concat("cloudbaga listening on :", int_to_str(port)))?

    let pollfds: Vec<i64> = vec_new()
    vec_push(pollfds, listener)

    let mut running: i64 = 1
    while running == 1 {
        if signal_check() != 0 {
            let sig = signal_clear()
            log_warn(concat("shutdown signal ", int_to_str(sig)))?
            st.ready = 0
            met_set(st.metrics, st.h_up, 0)
            running = 0
        } else {
            let pr = poll_wait(pollfds, 200)?
            if pr.ok < 0 {
                log_error("poll failed")?
                running = 0
            } else {
                if poll_has(pr.ready, listener) == 1 {
                    let fd = tcp_accept(listener)?
                    if fd >= 0 {
                        cloud_serve_one(st, fd)?
                    }
                }
            }
        }
    }
    tcp_close(listener)?
    log_info("cloudbaga stopped")?
    return 0
}
