// deps.baga — FastAPI-style dependencies (Bearer JWT, Content-Type).

import "ctx.baga"
import "route.baga"
import "respond.baga"
import "jsonx.baga"
import "jwtbaga/jwt.baga"
import "httpdbaga/http.baga"
import "std/str/str.baga"

// Result of a dependency: either continue with updated ctx, or short-circuit.
struct DepResult {
    ok: i64,
    ctx: FmrCtx,
    resp: Response
}

fn dep_ok(ctx: FmrCtx) -> DepResult {
    return DepResult { ok: 1, ctx: ctx, resp: fmr_json(200, "{}") }
}

fn dep_fail(ctx: FmrCtx, resp: Response) -> DepResult {
    return DepResult { ok: 0, ctx: ctx, resp: resp }
}

// "Bearer <token>" → token; else "".
fn fmr_bearer(ctx: FmrCtx) -> str {
    let auth = fmr_header(ctx, "Authorization")
    if str_starts_with(auth, "Bearer ") {
        return substr(auth, 7, len(auth))
    }
    if str_starts_with(auth, "bearer ") {
        return substr(auth, 7, len(auth))
    }
    return ""
}

// Requires valid HS256 JWT; sets ctx.user_sub from claim "sub".
fn deps_bearer(ctx: FmrCtx) -> DepResult {
    let token = fmr_bearer(ctx)
    if token == "" {
        return dep_fail(ctx, fmr_401("Not authenticated"))
    }
    let payload = jwt_decode(ctx.jwt_secret, token)
    if payload == "" {
        return dep_fail(ctx, fmr_401("Invalid or expired token"))
    }
    let sub = jwt_claim_str(token, "sub")
    if sub == "" {
        return dep_fail(ctx, fmr_401("Token missing sub"))
    }
    return dep_ok(fmr_set_user(ctx, sub))
}

// Optional bearer: if present must be valid; if absent continues unauthenticated.
fn deps_bearer_optional(ctx: FmrCtx) -> DepResult {
    let token = fmr_bearer(ctx)
    if token == "" {
        return dep_ok(ctx)
    }
    return deps_bearer(ctx)
}

// Require application/json (or +json) Content-Type for body routes.
fn deps_json_content_type(ctx: FmrCtx) -> DepResult {
    let ct = to_lower(fmr_header(ctx, "Content-Type"))
    if ct == "" {
        return dep_fail(ctx, fmr_400("Content-Type required"))
    }
    if str_find(ct, "application/json") < 0 {
        if str_find(ct, "+json") < 0 {
            return dep_fail(ctx, fmr_400("Content-Type must be application/json"))
        }
    }
    return dep_ok(ctx)
}

// Issue access token for subject (auth helper used by handlers).
fn fmr_issue_token(secret: str, sub: str, extra_json_fields: str) -> str {
    // payload: {"sub":"..."} or {"sub":"...", ...extra without braces}
    let mut payload = concat("{\"sub\":", json_escape(sub))
    if extra_json_fields != "" {
        payload = concat(payload, ",")
        payload = concat(payload, extra_json_fields)
    }
    payload = concat(payload, "}")
    return jwt_encode(secret, payload)
}
