// openapi_schema.baga — schema builders (типове/компоненти/операции).
// openapi.baga — извличане на OpenAPI doc от Router: op_id/summary/params/
// body/ok schema от route-овете, paths, catalog router, tags, финален doc.

import "openapi_schema.baga"
import "../json/jsonx.baga"
import "../core/route.baga"

fn oas_op_id_for(method: str, pattern: str) -> str {
    let mut out = oas_lower_method(method)
    let segs = route_segments(pattern)
    for i in 0..vec_len(segs) {
        out = concat(out, "_")
        let s = vec_get(segs, i)
        if route_is_param(s) == 1 {
            out = concat(out, route_param_name(s))
        } else {
            out = concat(out, s)
        }
    }
    if out == oas_lower_method(method) {
        out = concat(out, "_root")
    }
    return out
}

fn oas_summary_for(method: str, pattern: str) -> str {
    return concat(concat(method, " "), pattern)
}

// Path + query parameters for a route.
fn oas_params_from_route(method: str, pattern: str) -> JArr {
    let mut params = jarr_new()
    let segs = route_segments(pattern)
    for i in 0..vec_len(segs) {
        let s = vec_get(segs, i)
        if route_is_param(s) == 1 {
            let name = route_param_name(s)
            let mut p = jobj_new()
            p = jobj_str(p, "name", name)
            p = jobj_str(p, "in", "path")
            p = jobj_bool(p, "required", 1)
            p = jobj_str(p, "description", concat(name, " path parameter"))
            if name == "id" {
                p = jobj_obj(p, "schema", oas_int_schema())
            } else {
                p = jobj_obj(p, "schema", oas_str_schema())
            }
            params = jarr_obj(params, p)
        }
    }
    // Query extras for known list GETs
    if method == "GET" {
        if pattern == "/v1/posts" {
            let mut lim = jobj_new()
            lim = jobj_str(lim, "name", "limit")
            lim = jobj_str(lim, "in", "query")
            lim = jobj_bool(lim, "required", 0)
            lim = jobj_obj(lim, "schema", oas_int_schema())
            params = jarr_obj(params, lim)
            let mut off = jobj_new()
            off = jobj_str(off, "name", "offset")
            off = jobj_str(off, "in", "query")
            off = jobj_bool(off, "required", 0)
            off = jobj_obj(off, "schema", oas_int_schema())
            params = jarr_obj(params, off)
            let mut uidq = jobj_new()
            uidq = jobj_str(uidq, "name", "user_id")
            uidq = jobj_str(uidq, "in", "query")
            uidq = jobj_bool(uidq, "required", 0)
            uidq = jobj_obj(uidq, "schema", oas_int_schema())
            params = jarr_obj(params, uidq)
        }
    }
    if pattern == "/v1/auth/token" {
        if method == "POST" {
            let mut qparam = jobj_new()
            qparam = jobj_str(qparam, "name", "sub")
            qparam = jobj_str(qparam, "in", "query")
            qparam = jobj_bool(qparam, "required", 0)
            qparam = jobj_str(qparam, "description", "Subject (alternative to JSON body)")
            qparam = jobj_obj(qparam, "schema", oas_str_schema())
            params = jarr_obj(params, qparam)
        }
    }
    return params
}

// Request body schema name; "" = none.
fn oas_body_schema(method: str, pattern: str) -> str {
    if method == "POST" {
        if pattern == "/v1/users" {
            return "UserCreate"
        }
        if pattern == "/v1/posts" {
            return "PostCreate"
        }
        if pattern == "/v1/auth/token" {
            return "TokenRequest"
        }
    }
    if method == "PATCH" {
        if pattern == "/v1/users/{id}" {
            return "UserPatch"
        }
        if pattern == "/v1/posts/{id}" {
            return "PostCreate"
        }
    }
    return ""
}

// Primary success response schema; "" = empty body (204-style).
fn oas_ok_schema(method: str, pattern: str) -> str {
    if method == "DELETE" {
        return ""
    }
    if pattern == "/health" {
        return "Status"
    }
    if pattern == "/ready" {
        return "Ready"
    }
    if pattern == "/openapi.json" {
        return ""
    }
    if pattern == "/metrics" {
        return ""
    }
    if pattern == "/v1/meta" {
        return "Status"
    }
    if pattern == "/v1/auth/token" {
        return "TokenResponse"
    }
    if pattern == "/v1/me" {
        return "Me"
    }
    if pattern == "/v1/users" {
        if method == "GET" {
            return "UserList"
        }
        if method == "POST" {
            return "User"
        }
    }
    if pattern == "/v1/users/{id}" {
        return "User"
    }
    if pattern == "/v1/posts" {
        if method == "GET" {
            return "PostList"
        }
        if method == "POST" {
            return "Post"
        }
    }
    if pattern == "/v1/posts/{id}" {
        return "Post"
    }
    return "Status"
}

fn oas_success_code(method: str, pattern: str) -> str {
    if method == "POST" {
        if pattern == "/v1/users" {
            return "201"
        }
        if pattern == "/v1/posts" {
            return "201"
        }
    }
    if method == "DELETE" {
        return "204"
    }
    return "200"
}

// Build one operation for a registered route (method + pattern + id).
fn oas_op_from_route(method: str, pattern: str, id: i64) -> JObj {
    let tag = oas_tag_for(pattern)
    let mut op = oas_op(oas_op_id_for(method, pattern), oas_summary_for(method, pattern), tag)
    op = jobj_i64(op, "x-baga-route-id", id)
    if oas_is_public(pattern, method) == 0 {
        op = oas_add_bearer(op)
    }
    let params = oas_params_from_route(method, pattern)
    if vec_len(params.items) > 0 {
        op = jobj_raw(op, "parameters", jarr_encode(params))
    }
    let body = oas_body_schema(method, pattern)
    if body != "" {
        let mut reqd: i64 = 1
        if pattern == "/v1/auth/token" {
            reqd = 0
        }
        op = oas_add_json_body(op, body, reqd)
    }
    let code = oas_success_code(method, pattern)
    let ok_schema = oas_ok_schema(method, pattern)
    let mut resp = jobj_new()
    if ok_schema == "" {
        resp = jobj_obj(resp, code, oas_response_empty("OK"))
    } else {
        resp = jobj_obj(resp, code, oas_response_ref("OK", ok_schema))
    }
    if oas_is_public(pattern, method) == 0 {
        resp = jobj_obj(resp, "401", oas_response_ref("Unauthorized", "Error"))
    }
    if pattern == "/ready" {
        resp = jobj_obj(resp, "503", oas_response_ref("Unavailable", "Error"))
    }
    if body != "" {
        resp = jobj_obj(resp, "422", oas_response_ref("Validation Error", "HTTPValidationError"))
    }
    if method != "POST" {
        if str_find(pattern, "{id}") >= 0 {
            resp = jobj_obj(resp, "404", oas_response_ref("Not found", "Error"))
        }
    }
    op = jobj_obj(op, "responses", resp)
    return op
}

fn oas_pattern_seen(seen: Vec<str>, pattern: str) -> i64 {
    for i in 0..vec_len(seen) {
        if vec_get(seen, i) == pattern {
            return 1
        }
    }
    return 0
}

// Paths object: only routes present in `r` (source of truth = route table).
fn oas_paths_from_router(r: Router) -> JObj {
    let seen: Vec<str> = vec_new()
    for i in 0..vec_len(r.patterns) {
        let p = vec_get(r.patterns, i)
        if oas_pattern_seen(seen, p) == 0 {
            vec_push(seen, p)
        }
    }
    let mut paths = jobj_new()
    for si in 0..vec_len(seen) {
        let pattern = vec_get(seen, si)
        let mut item = jobj_new()
        for i in 0..vec_len(r.patterns) {
            if vec_get(r.patterns, i) == pattern {
                let method = vec_get(r.methods, i)
                let id = vec_get(r.ids, i)
                let op = oas_op_from_route(method, pattern, id)
                item = jobj_obj(item, oas_lower_method(method), op)
            }
        }
        paths = jobj_obj(paths, pattern, item)
    }
    return paths
}

// Catalog router: same surface as apps/api (for pure unit tests without FmrApp).
fn oas_catalog_router() -> Router {
    let mut r = router_new()
    r = router_add(r, "GET", "/health", 1)
    r = router_add(r, "GET", "/ready", 2)
    r = router_add(r, "GET", "/metrics", 5)
    r = router_add(r, "GET", "/v1/meta", 3)
    r = router_add(r, "GET", "/openapi.json", 4)
    r = router_add(r, "POST", "/v1/auth/token", 10)
    r = router_add(r, "GET", "/v1/me", 11)
    r = router_add(r, "GET", "/v1/users", 20)
    r = router_add(r, "POST", "/v1/users", 21)
    r = router_add(r, "GET", "/v1/users/{id}", 22)
    r = router_add(r, "PATCH", "/v1/users/{id}", 23)
    r = router_add(r, "DELETE", "/v1/users/{id}", 24)
    r = router_add(r, "GET", "/v1/posts", 30)
    r = router_add(r, "POST", "/v1/posts", 31)
    r = router_add(r, "GET", "/v1/posts/{id}", 32)
    r = router_add(r, "PATCH", "/v1/posts/{id}", 33)
    r = router_add(r, "DELETE", "/v1/posts/{id}", 34)
    return r
}

fn oas_tags() -> str {
    let mut tags = jarr_new()
    let mut t1 = jobj_new()
    t1 = jobj_str(t1, "name", "system")
    t1 = jobj_str(t1, "description", "Health and metadata")
    tags = jarr_obj(tags, t1)
    let mut t2 = jobj_new()
    t2 = jobj_str(t2, "name", "auth")
    t2 = jobj_str(t2, "description", "JWT issue and identity")
    tags = jarr_obj(tags, t2)
    let mut t3 = jobj_new()
    t3 = jobj_str(t3, "name", "users")
    t3 = jobj_str(t3, "description", "User CRUD (Bearer required)")
    tags = jarr_obj(tags, t3)
    let mut t4 = jobj_new()
    t4 = jobj_str(t4, "name", "posts")
    t4 = jobj_str(t4, "description", "Post CRUD (Bearer required)")
    tags = jarr_obj(tags, t4)
    return jarr_encode(tags)
}

// Full OpenAPI 3.0.3 from a live route table (B2.4).
fn fmr_openapi_from_router(r: Router, title: str, version: str) -> JObj {
    let mut info = jobj_new()
    info = jobj_str(info, "title", title)
    info = jobj_str(info, "version", version)
    info = jobj_str(info, "description", "fmrbaga API — paths emitted from the route table; JWT Bearer where required.")

    let mut root = jobj_new()
    root = jobj_str(root, "openapi", "3.0.3")
    root = jobj_obj(root, "info", info)
    root = jobj_raw(root, "tags", oas_tags())
    root = jobj_obj(root, "paths", oas_paths_from_router(r))
    root = jobj_obj(root, "components", oas_components())
    return root
}

// Pure helper for tests: catalog router (= apps/api surface).
fn fmr_openapi_doc(title: str, version: str) -> JObj {
    return fmr_openapi_from_router(oas_catalog_router(), title, version)
}
