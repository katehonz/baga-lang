// app.baga — FmrApp конфигурация + handle-ът (per-request). Serve/conn/
// worker/stats частта е в core/serve.baga (импортира тук, няма цикъл).

// app.baga — FmrApp: route table, request pipeline, HTTP/1.1 server.
// Embedding program must define:
//   fn fmr_build_app() -> FmrApp !IO
//   fn fmr_before(ctx: FmrCtx) -> DepResult
//   fn fmr_dispatch(ctx: FmrCtx, db: OrmDb) -> FmrOut

import "route.baga"
import "ctx.baga"
import "respond.baga"
import "deps.baga"
import "middleware.baga"
import "../json/jsonx.baga"
import "config.baga"
import "httpdbaga/http.baga"
import "ormbaga/orm.baga"
import "logbaga/log.baga"
import "std/net/tcp.baga"
import "std/net/poll.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/random/random.baga"
import "std/bytes/bytes.baga"

fn FMR_SIGTERM() -> i64 { return 15 }
fn FMR_SIGINT() -> i64 { return 2 }

// 1 if SIGTERM/SIGINT is pending (draining / not ready).
fn fmr_shutting_down() -> i64 {
    if signal_check() != 0 {
        return 1
    }
    return 0
}

// Handler return: response + possibly updated DB session.
struct FmrOut {
    resp: Response,
    db: OrmDb
}

fn fmr_out(resp: Response, db: OrmDb) -> FmrOut {
    return FmrOut { resp: resp, db: db }
}

// Optional L5 handler table (G1). Keyed by route id. Missing id → fmr_dispatch.
struct FmrHandlers {
    ids: Vec<i64>,
    fns: Vec<fn(FmrCtx, OrmDb) -> FmrOut !IO !Net>
}

fn fmr_handlers_new() -> FmrHandlers {
    return FmrHandlers { ids: vec_new(), fns: vec_new() }
}

fn fmr_handlers_add(h: FmrHandlers, id: i64, f: fn(FmrCtx, OrmDb) -> FmrOut !IO !Net) -> FmrHandlers {
    let mut i: i64 = 0
    while i < vec_len(h.ids) {
        if vec_get(h.ids, i) == id {
            vec_set(h.fns, i, f)
            return h
        }
        i = i + 1
    }
    vec_push(h.ids, id)
    vec_push(h.fns, f)
    return h
}

fn fmr_handlers_find(h: FmrHandlers, id: i64) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(h.ids) {
        if vec_get(h.ids, i) == id {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

struct FmrApp {
    router: Router,
    jwt_secret: str,
    title: str,
    version: str,
    pg_host: str,
    pg_port: i64,
    pg_user: str,
    pg_password: str,
    pg_database: str,
    cors_origin: str,    // "" off; "*" or concrete origin
    log_requests: i64,   // 1 = log method path status
    handlers: FmrHandlers
}

fn fmr_app_new(title: str, version: str) -> FmrApp {
    return FmrApp {
        router: router_new(),
        jwt_secret: "baga-secret",
        title: title,
        version: version,
        pg_host: "127.0.0.1",
        pg_port: 5432,
        pg_user: "bagatest",
        pg_password: "pas+123",
        pg_database: "baga_orm",
        cors_origin: "",
        log_requests: 0,
        handlers: fmr_handlers_new()
    }
}

// Copy all fields, swapping only those passed via helpers.
fn fmr_app_copy(app: FmrApp, router: Router, jwt_secret: str, title: str, version: str,
    pg_host: str, pg_port: i64, pg_user: str, pg_password: str, pg_database: str,
    cors_origin: str, log_requests: i64) -> FmrApp {
    return FmrApp {
        router: router,
        jwt_secret: jwt_secret,
        title: title,
        version: version,
        pg_host: pg_host,
        pg_port: pg_port,
        pg_user: pg_user,
        pg_password: pg_password,
        pg_database: pg_database,
        cors_origin: cors_origin,
        log_requests: log_requests,
        handlers: app.handlers
    }
}

fn fmr_app_jwt(app: FmrApp, secret: str) -> FmrApp {
    return fmr_app_copy(app, app.router, secret, app.title, app.version,
        app.pg_host, app.pg_port, app.pg_user, app.pg_password, app.pg_database,
        app.cors_origin, app.log_requests)
}

fn fmr_app_db(app: FmrApp, host: str, port: i64, user: str, password: str, database: str) -> FmrApp {
    return fmr_app_copy(app, app.router, app.jwt_secret, app.title, app.version,
        host, port, user, password, database, app.cors_origin, app.log_requests)
}

fn fmr_app_cors(app: FmrApp, origin: str) -> FmrApp {
    return fmr_app_copy(app, app.router, app.jwt_secret, app.title, app.version,
        app.pg_host, app.pg_port, app.pg_user, app.pg_password, app.pg_database,
        origin, app.log_requests)
}

fn fmr_app_log(app: FmrApp, on: i64) -> FmrApp {
    return fmr_app_copy(app, app.router, app.jwt_secret, app.title, app.version,
        app.pg_host, app.pg_port, app.pg_user, app.pg_password, app.pg_database,
        app.cors_origin, on)
}

fn fmr_route(app: FmrApp, method: str, pattern: str, id: i64) -> FmrApp {
    return fmr_app_copy(app, router_add(app.router, method, pattern, id),
        app.jwt_secret, app.title, app.version,
        app.pg_host, app.pg_port, app.pg_user, app.pg_password, app.pg_database,
        app.cors_origin, app.log_requests)
}

// G1: register a handler next to the route id. fmr_handle calls it
// instead of fmr_dispatch when the id is in the table.
fn fmr_route_fn(app: FmrApp, method: str, pattern: str, id: i64,
                h: fn(FmrCtx, OrmDb) -> FmrOut !IO !Net) -> FmrApp {
    let mut a = fmr_route(app, method, pattern, id)
    a.handlers = fmr_handlers_add(a.handlers, id, h)
    return a
}

// Apply FmrConfig (from config.baga) onto app shell.
fn fmr_app_with_config(app: FmrApp, cfg: FmrConfig) -> FmrApp {
    let mut a = fmr_app_jwt(app, cfg.jwt_secret)
    a = fmr_app_db(a, cfg.pg_host, cfg.pg_port, cfg.pg_user, cfg.pg_password, cfg.pg_database)
    a = fmr_app_cors(a, cfg.cors_origin)
    a = fmr_app_log(a, cfg.log_requests)
    return fmr_app_copy(a, a.router, a.jwt_secret, cfg.title, cfg.version,
        a.pg_host, a.pg_port, a.pg_user, a.pg_password, a.pg_database,
        a.cors_origin, a.log_requests)
}

fn fmr_dispatch(ctx: FmrCtx, db: OrmDb) -> FmrOut
fn fmr_before(ctx: FmrCtx) -> DepResult
fn fmr_build_app() -> FmrApp !IO
// Optional dual-protocol hook (B3): gRPC method path + binary body → FmrOut.
// Effects match fmr_dispatch (implemented by the app; forward decl is pure).
fn fmr_grpc_handle(path: str, body: bytes, db: OrmDb) -> FmrOut

// POST + Content-Type application/grpc* + /Service/Method path shape.
fn fmr_is_grpc_request(req: Request) -> i64 {
    if http_method(req) != "POST" {
        return 0
    }
    let ct = http_header(req, "Content-Type")
    if str_find(ct, "application/grpc") < 0 {
        return 0
    }
    let path = http_path_only(req)
    if len(path) < 3 || char_at(path, 0) != 47 {
        return 0
    }
    // At least /pkg.Svc/Method (two segments).
    let mut segs: i64 = 0
    let mut i: i64 = 0
    while i < len(path) {
        if char_at(path, i) == 47 {
            segs = segs + 1
        }
        i = i + 1
    }
    if segs >= 2 {
        return 1
    }
    return 0
}

fn fmr_maybe_cors(app: FmrApp, resp: Response) -> Response {
    if app.cors_origin == "" {
        return resp
    }
    return fmr_cors(resp, app.cors_origin)
}

// Prefer client X-Request-Id; else 16 hex chars from random.
fn fmr_make_request_id(req: Request) -> str !Random {
    let h = http_header(req, "X-Request-Id")
    if h != "" {
        return h
    }
    let raw = random_bytes(8)?
    return bytes_to_hex(raw)
}

fn fmr_with_request_id(resp: Response, rid: str) -> Response {
    if rid == "" {
        return resp
    }
    return http_set_header(resp, "X-Request-Id", rid)
}

// Apply CORS + middleware response headers (request-id, traceparent).
fn fmr_finish_ctx(app: FmrApp, resp: Response, ctx: FmrCtx) -> Response {
    return fmr_maybe_cors(app, fmr_mw_response_headers(resp, ctx))
}

// Legacy helper when only rid is known (404 before ctx is fully filled).
fn fmr_finish(app: FmrApp, resp: Response, rid: str) -> Response {
    return fmr_maybe_cors(app, fmr_with_request_id(resp, rid))
}

// Pipeline (B2.1 + B3): request-id → [gRPC dual | JSON routes] → log → headers.
fn fmr_handle(app: FmrApp, req: Request, db: OrmDb) -> FmrOut !Random !Time !IO !Net {
    let method = http_method(req)
    let path = http_path_only(req)
    let rid = fmr_make_request_id(req)?

    if method == "OPTIONS" {
        let origin = app.cors_origin
        let mut r = fmr_no_content()
        if origin == "" {
            r = fmr_cors(r, "*")
        } else {
            r = fmr_cors(r, origin)
        }
        return fmr_out(fmr_with_request_id(r, rid), db)
    }

    // B3 dual protocol: same port, application/grpc + /Service/Method
    if fmr_is_grpc_request(req) == 1 {
        let gout = fmr_grpc_handle(path, http_body_bytes(req), db)
        if app.log_requests == 1 {
            let empty_n: Vec<str> = vec_new()
            let empty_v: Vec<str> = vec_new()
            let mut fake = fmr_ctx_new(req, RouteMatch {
                ok: 1, id: 0, pnames: empty_n, pvals: empty_v
            }, app.jwt_secret)
            fake = fmr_ctx_set_req_id(fake, rid)
            fmr_mw_log(fake, method, path, gout.resp.status)?
        }
        return fmr_out(fmr_with_request_id(gout.resp, rid), gout.db)
    }

    let m = router_match(app.router, method, path)
    if m.ok == 0 {
        if router_path_exists(app.router, path) == 1 {
            return fmr_out(fmr_finish(app, fmr_405("Method not allowed"), rid), db)
        }
        return fmr_out(fmr_finish(app, fmr_404("Not found"), rid), db)
    }

    let ctx0 = fmr_mw_ids(fmr_ctx_new(req, m, app.jwt_secret), rid)?
    let before = fmr_before(ctx0)
    if before.ok == 0 {
        // Prefer ids from ctx0 (middleware); before.ctx may be a short-circuit copy.
        return fmr_out(fmr_finish_ctx(app, before.resp, ctx0), db)
    }
    let hi = fmr_handlers_find(app.handlers, m.id)
    let mut out = fmr_out(fmr_500("unhandled route id"), db)
    if hi >= 0 {
        let h = vec_get(app.handlers.fns, hi)
        out = h(before.ctx, db)?
    } else {
        out = fmr_dispatch(before.ctx, db)
    }
    if app.log_requests == 1 {
        fmr_mw_log(before.ctx, method, path, out.resp.status)?
    }
    return fmr_out(fmr_finish_ctx(app, out.resp, before.ctx), out.db)
}

// Result of serving one TCP connection (updated DB session for reuse).
