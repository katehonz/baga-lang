// config.baga — env-driven config for fmrbaga (one load site).
// Pure of network; only !IO for env.

import "std/os/os.baga"
import "std/str/str.baga"

struct FmrConfig {
    port: i64,
    workers: i64,          // default 4 pool; 0 = go_bg per conn; sync forces serial
    sync: i64,             // 1 = serial accept+handle (wins over workers)
    jwt_secret: str,
    cors_origin: str,      // "" = no CORS headers; "*" or origin
    log_requests: i64,     // 1 = eprintln each request
    pg_host: str,
    pg_port: i64,
    pg_user: str,
    pg_password: str,
    pg_database: str,
    title: str,
    version: str
}

fn fmr_cfg_or(name: str, def: str) -> str !IO {
    let v = env(name)?
    if v == "" {
        return def
    }
    return v
}

fn fmr_cfg_flag(name: str) -> i64 !IO {
    let v = env(name)?
    if v == "1" || v == "true" || v == "yes" {
        return 1
    }
    return 0
}

// True when ORM_BACKEND targets boilaDB (PG wire via boilabaga).
fn fmr_backend_is_boila() -> i64 !IO {
    let be = fmr_cfg_or("ORM_BACKEND", "pg")?
    if be == "boila" || be == "boiladb" || be == "boilaDB" {
        return 1
    }
    return 0
}

// Load config from environment. Defaults match local bagatest/baga_orm.
// With ORM_BACKEND=boila, DSN defaults follow boilabaga (host/port/user/db).
fn fmr_config_load() -> FmrConfig !IO {
    // Empty FMR_WORKERS → 4 (fixed pool). Explicit 0 → go_bg per connection.
    let raw_w = env("FMR_WORKERS")?
    let mut workers: i64 = 4
    if raw_w != "" {
        workers = parse_int(raw_w)
    }
    if workers < 0 { workers = 0 }
    if workers > 64 { workers = 64 }
    let mut sync = fmr_cfg_flag("FMR_SYNC")?
    if fmr_cfg_flag("BAGA_SYNC")? == 1 {
        sync = 1
    }
    if sync == 1 {
        workers = 0
    }
    let mut secret = fmr_cfg_or("FMR_JWT_SECRET", "baga-secret")?
    let j2 = env("JWT_SECRET")?
    if j2 != "" {
        secret = j2
    }
    let mut host = fmr_cfg_or("PGHOST", "127.0.0.1")?
    let mut port = parse_int(fmr_cfg_or("PGPORT", "5432")?)
    let mut user = fmr_cfg_or("PGUSER", "bagatest")?
    let mut password = fmr_cfg_or("PGPASSWORD", "pas+123")?
    let mut database = fmr_cfg_or("PGDATABASE", "baga_orm")?
    if fmr_backend_is_boila()? == 1 {
        // BOILA_* preferred; never inherit PGPORT=5432 as boila listen port.
        let bh = env("BOILA_PGHOST")?
        if bh != "" {
            host = bh
        } else {
            host = fmr_cfg_or("PGHOST", "127.0.0.1")?
        }
        let bp = env("BOILA_PGPORT")?
        if bp != "" {
            port = parse_int(bp)
        } else {
            port = 6575
        }
        let bu = env("BOILA_PGUSER")?
        if bu != "" {
            user = bu
        } else {
            user = fmr_cfg_or("PGUSER", "boila")?
        }
        let tok = env("BOILA_TOKEN")?
        if tok != "" {
            password = tok
        } else {
            let bpw = env("BOILA_PGPASSWORD")?
            if bpw != "" {
                password = bpw
            } else {
                password = fmr_cfg_or("PGPASSWORD", "")?
            }
        }
        let bd = env("BOILA_PGDATABASE")?
        if bd != "" {
            database = bd
        } else {
            database = fmr_cfg_or("PGDATABASE", "boila")?
        }
    }
    return FmrConfig {
        port: parse_int(fmr_cfg_or("PORT", "8080")?),
        workers: workers,
        sync: sync,
        jwt_secret: secret,
        cors_origin: fmr_cfg_or("FMR_CORS", "")?,
        log_requests: fmr_cfg_flag("FMR_LOG")?,
        pg_host: host,
        pg_port: port,
        pg_user: user,
        pg_password: password,
        pg_database: database,
        title: fmr_cfg_or("FMR_TITLE", "fmrbaga-api")?,
        version: fmr_cfg_or("FMR_VERSION", "1.0.0")?
    }
}

