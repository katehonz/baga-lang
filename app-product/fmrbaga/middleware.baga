// middleware.baga — ordered request pipeline hooks (B2.1).
// Order in fmr_handle: request-id → otel traceparent → fmr_before → dispatch
// → structured log → response headers (X-Request-Id, traceparent, CORS).

import "ctx.baga"
import "respond.baga"
import "httpdbaga/http.baga"
import "otelbaga/otel.baga"
import "logbaga/log.baga"
import "std/str/str.baga"

// Attach request id + W3C trace context to FmrCtx (child span if client sent
// traceparent; else new root).
fn fmr_mw_ids(ctx: FmrCtx, rid: str) -> FmrCtx !Random {
    let mut c = fmr_ctx_set_req_id(ctx, rid)
    let raw = fmr_header(c, otel_header_name())
    let tc = otel_from_header(raw)?
    if tc.ok == 1 {
        c = fmr_ctx_set_trace(c, tc.trace_id, tc.span_id)
    }
    return c
}

// Response headers for correlation (after handler).
fn fmr_mw_response_headers(resp: Response, ctx: FmrCtx) -> Response {
    let mut r = resp
    if ctx.req_id != "" {
        r = http_set_header(r, "X-Request-Id", ctx.req_id)
    }
    if ctx.trace_id != "" && ctx.span_id != "" {
        let tp = concat(concat(concat(concat("00-", ctx.trace_id), "-"), ctx.span_id), "-01")
        r = http_set_header(r, "traceparent", tp)
    }
    return r
}

// JSON request log line (logbaga) when enabled.
fn fmr_mw_log(ctx: FmrCtx, method: str, path: str, status: i64) -> i64 !Time {
    let msg = concat(
        concat(concat(method, " "), path),
        concat(" → ", int_to_str(status))
    )
    return log_emit_trace("info", msg, ctx.req_id, ctx.trace_id, ctx.span_id)?
}
