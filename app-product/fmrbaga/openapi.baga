// openapi.baga — OpenAPI 3 document for fmrbaga (schemas + security).
// B2.4: paths are emitted from the live Router (route table), not a second
// hand-maintained list. Components/schemas stay curated; per-op detail uses
// path heuristics + path params from `{name}` segments.

import "jsonx.baga"
import "route.baga"
import "std/str/str.baga"

// ---------- schema primitives ----------

fn oas_type(t: str) -> JObj {
    let mut o = jobj_new()
    o = jobj_str(o, "type", t)
    return o
}

fn oas_str_schema() -> JObj {
    return oas_type("string")
}

fn oas_int_schema() -> JObj {
    let mut o = oas_type("integer")
    o = jobj_str(o, "format", "int64")
    return o
}

fn oas_obj_schema(props: JObj, required: JArr) -> JObj {
    let mut o = oas_type("object")
    o = jobj_obj(o, "properties", props)
    if vec_len(required.items) > 0 {
        o = jobj_raw(o, "required", jarr_encode(required))
    }
    return o
}

fn oas_arr_schema(items: JObj) -> JObj {
    let mut o = oas_type("array")
    o = jobj_obj(o, "items", items)
    return o
}

fn oas_ref(name: str) -> JObj {
    let mut o = jobj_new()
    o = jobj_str(o, "$ref", concat("#/components/schemas/", name))
    return o
}

fn oas_prop_str(props: JObj, name: str, desc: str) -> JObj {
    let mut s = oas_str_schema()
    if desc != "" {
        s = jobj_str(s, "description", desc)
    }
    return jobj_obj(props, name, s)
}

fn oas_prop_int(props: JObj, name: str, desc: str) -> JObj {
    let mut s = oas_int_schema()
    if desc != "" {
        s = jobj_str(s, "description", desc)
    }
    return jobj_obj(props, name, s)
}

// application/json content wrapper around a schema object
fn oas_json_content(schema: JObj) -> JObj {
    let mut app = jobj_new()
    app = jobj_obj(app, "schema", schema)
    let mut content = jobj_new()
    content = jobj_obj(content, "application/json", app)
    return content
}

fn oas_response(desc: str, schema: JObj) -> JObj {
    let mut r = jobj_new()
    r = jobj_str(r, "description", desc)
    r = jobj_obj(r, "content", oas_json_content(schema))
    return r
}

fn oas_response_ref(desc: str, schema_name: str) -> JObj {
    return oas_response(desc, oas_ref(schema_name))
}

fn oas_response_empty(desc: str) -> JObj {
    let mut r = jobj_new()
    r = jobj_str(r, "description", desc)
    return r
}

// security requirement: [{ "bearerAuth": [] }]
fn oas_bearer_security() -> str {
    let mut empty = jarr_new()
    let mut one = jobj_new()
    one = jobj_raw(one, "bearerAuth", jarr_encode(empty))
    let mut arr = jarr_new()
    arr = jarr_obj(arr, one)
    return jarr_encode(arr)
}

fn oas_path_id_param() -> JObj {
    let mut p = jobj_new()
    p = jobj_str(p, "name", "id")
    p = jobj_str(p, "in", "path")
    p = jobj_bool(p, "required", 1)
    p = jobj_str(p, "description", "User id")
    p = jobj_obj(p, "schema", oas_int_schema())
    return p
}

// ---------- components ----------

fn oas_components() -> JObj {
    // schemas
    let mut user_props = jobj_new()
    user_props = oas_prop_int(user_props, "id", "Primary key")
    user_props = oas_prop_str(user_props, "email", "Unique email")
    user_props = oas_prop_str(user_props, "name", "Display name")
    user_props = oas_prop_str(user_props, "created_at", "ISO-ish timestamp from Postgres")
    let mut user_req = jarr_new()
    user_req = jarr_str(user_req, "id")
    user_req = jarr_str(user_req, "email")
    user_req = jarr_str(user_req, "name")
    let user = oas_obj_schema(user_props, user_req)

    let mut user_in_props = jobj_new()
    user_in_props = oas_prop_str(user_in_props, "email", "")
    user_in_props = oas_prop_str(user_in_props, "name", "")
    let mut user_in_req = jarr_new()
    user_in_req = jarr_str(user_in_req, "email")
    user_in_req = jarr_str(user_in_req, "name")
    let user_create = oas_obj_schema(user_in_props, user_in_req)

    let mut user_patch_props = jobj_new()
    user_patch_props = oas_prop_str(user_patch_props, "name", "")
    let mut user_patch_req = jarr_new()
    user_patch_req = jarr_str(user_patch_req, "name")
    let user_patch = oas_obj_schema(user_patch_props, user_patch_req)

    let mut user_list_props = jobj_new()
    user_list_props = jobj_obj(user_list_props, "items", oas_arr_schema(oas_ref("User")))
    user_list_props = oas_prop_int(user_list_props, "count", "")
    let user_list = oas_obj_schema(user_list_props, jarr_new())

    let mut token_in_props = jobj_new()
    token_in_props = oas_prop_str(token_in_props, "sub", "Subject claim for JWT")
    let mut token_in_req = jarr_new()
    token_in_req = jarr_str(token_in_req, "sub")
    let token_in = oas_obj_schema(token_in_props, token_in_req)

    let mut token_out_props = jobj_new()
    token_out_props = oas_prop_str(token_out_props, "access_token", "HS256 JWT")
    token_out_props = oas_prop_str(token_out_props, "token_type", "Always bearer")
    token_out_props = oas_prop_str(token_out_props, "sub", "")
    let token_out = oas_obj_schema(token_out_props, jarr_new())

    let mut me_props = jobj_new()
    me_props = oas_prop_str(me_props, "sub", "Authenticated subject")
    let me = oas_obj_schema(me_props, jarr_new())

    let mut status_props = jobj_new()
    status_props = oas_prop_str(status_props, "status", "")
    let status_ok = oas_obj_schema(status_props, jarr_new())

    let mut ready_props = jobj_new()
    ready_props = oas_prop_str(ready_props, "status", "")
    ready_props = oas_prop_str(ready_props, "database", "up when DB ping succeeds")
    let ready = oas_obj_schema(ready_props, jarr_new())

    let mut detail_props = jobj_new()
    detail_props = oas_prop_str(detail_props, "detail", "Error message or FastAPI-style list")
    let error = oas_obj_schema(detail_props, jarr_new())

    let mut validation_item_props = jobj_new()
    let mut loc_schema = oas_arr_schema(oas_str_schema())
    validation_item_props = jobj_obj(validation_item_props, "loc", loc_schema)
    validation_item_props = oas_prop_str(validation_item_props, "msg", "")
    validation_item_props = oas_prop_str(validation_item_props, "type", "")
    let validation_item = oas_obj_schema(validation_item_props, jarr_new())
    let mut validation_props = jobj_new()
    validation_props = jobj_obj(validation_props, "detail", oas_arr_schema(validation_item))
    let validation_error = oas_obj_schema(validation_props, jarr_new())

    let mut schemas = jobj_new()
    schemas = jobj_obj(schemas, "User", user)
    schemas = jobj_obj(schemas, "UserCreate", user_create)
    schemas = jobj_obj(schemas, "UserPatch", user_patch)
    schemas = jobj_obj(schemas, "UserList", user_list)
    schemas = jobj_obj(schemas, "TokenRequest", token_in)
    schemas = jobj_obj(schemas, "TokenResponse", token_out)
    schemas = jobj_obj(schemas, "Me", me)
    schemas = jobj_obj(schemas, "Status", status_ok)
    schemas = jobj_obj(schemas, "Ready", ready)
    schemas = jobj_obj(schemas, "Error", error)
    schemas = jobj_obj(schemas, "HTTPValidationError", validation_error)

    let mut post_props = jobj_new()
    post_props = oas_prop_int(post_props, "id", "")
    post_props = oas_prop_int(post_props, "user_id", "Author")
    post_props = oas_prop_str(post_props, "title", "")
    post_props = oas_prop_str(post_props, "body", "")
    post_props = oas_prop_str(post_props, "created_at", "")
    let post = oas_obj_schema(post_props, jarr_new())
    let mut post_in_props = jobj_new()
    post_in_props = oas_prop_int(post_in_props, "user_id", "")
    post_in_props = oas_prop_str(post_in_props, "title", "")
    post_in_props = oas_prop_str(post_in_props, "body", "")
    let mut post_in_req = jarr_new()
    post_in_req = jarr_str(post_in_req, "user_id")
    post_in_req = jarr_str(post_in_req, "title")
    let post_create = oas_obj_schema(post_in_props, post_in_req)
    let mut post_list_props = jobj_new()
    post_list_props = jobj_obj(post_list_props, "items", oas_arr_schema(oas_ref("Post")))
    post_list_props = oas_prop_int(post_list_props, "count", "")
    post_list_props = oas_prop_int(post_list_props, "limit", "")
    post_list_props = oas_prop_int(post_list_props, "offset", "")
    let post_list = oas_obj_schema(post_list_props, jarr_new())
    schemas = jobj_obj(schemas, "Post", post)
    schemas = jobj_obj(schemas, "PostCreate", post_create)
    schemas = jobj_obj(schemas, "PostList", post_list)

    // securitySchemes
    let mut bearer = jobj_new()
    bearer = jobj_str(bearer, "type", "http")
    bearer = jobj_str(bearer, "scheme", "bearer")
    bearer = jobj_str(bearer, "bearerFormat", "JWT")
    bearer = jobj_str(bearer, "description", "HS256 access token from POST /v1/auth/token")
    let mut schemes = jobj_new()
    schemes = jobj_obj(schemes, "bearerAuth", bearer)

    let mut c = jobj_new()
    c = jobj_obj(c, "schemas", schemas)
    c = jobj_obj(c, "securitySchemes", schemes)
    return c
}

// ---------- operations ----------

fn oas_op(op_id: str, summary: str, tag: str) -> JObj {
    let mut op = jobj_new()
    op = jobj_str(op, "operationId", op_id)
    op = jobj_str(op, "summary", summary)
    let mut tags = jarr_new()
    tags = jarr_str(tags, tag)
    op = jobj_raw(op, "tags", jarr_encode(tags))
    return op
}

fn oas_add_bearer(op: JObj) -> JObj {
    return jobj_raw(op, "security", oas_bearer_security())
}

fn oas_add_json_body(op: JObj, schema_name: str, required: i64) -> JObj {
    let mut body = jobj_new()
    body = jobj_bool(body, "required", required)
    body = jobj_obj(body, "content", oas_json_content(oas_ref(schema_name)))
    return jobj_obj(op, "requestBody", body)
}

fn oas_add_resp(op: JObj, code: str, desc: str, schema_name: str) -> JObj {
    // merge into responses if present
    // we rebuild responses each time — callers chain carefully
    return op
}

// Build full responses map for common patterns.
fn oas_responses_ok(schema_name: str) -> JObj {
    let mut r = jobj_new()
    r = jobj_obj(r, "200", oas_response_ref("OK", schema_name))
    r = jobj_obj(r, "401", oas_response_ref("Unauthorized", "Error"))
    r = jobj_obj(r, "422", oas_response_ref("Validation Error", "HTTPValidationError"))
    r = jobj_obj(r, "500", oas_response_ref("Server Error", "Error"))
    return r
}

fn oas_responses_public(schema_name: str) -> JObj {
    let mut r = jobj_new()
    r = jobj_obj(r, "200", oas_response_ref("OK", schema_name))
    r = jobj_obj(r, "503", oas_response_ref("Unavailable", "Error"))
    return r
}

// ---------- B2.4: emit paths from Router ----------

fn oas_lower_method(m: str) -> str {
    let mut out = ""
    for i in 0..len(m) {
        let mut c = char_at(m, i)
        if c >= 65 && c <= 90 {
            c = c + 32
        }
        out = concat(out, chr(c))
    }
    return out
}

// Public routes (no Bearer).
fn oas_is_public(pattern: str, method: str) -> i64 {
    if pattern == "/health" {
        return 1
    }
    if pattern == "/ready" {
        return 1
    }
    if pattern == "/v1/meta" {
        return 1
    }
    if pattern == "/openapi.json" {
        return 1
    }
    if pattern == "/v1/auth/token" {
        return 1
    }
    return 0
}

fn oas_tag_for(pattern: str) -> str {
    if str_starts_with(pattern, "/v1/users") {
        return "users"
    }
    if str_starts_with(pattern, "/v1/posts") {
        return "posts"
    }
    if str_starts_with(pattern, "/v1/auth") {
        return "auth"
    }
    if pattern == "/v1/me" {
        return "auth"
    }
    return "system"
}

// operationId: get_v1_users_id style from method + pattern.
fn oas_op_id_for(method: str, pattern: str) -> str {
    let mut out = oas_lower_method(method)
    let segs = route_segments(pattern)
    for i in 0..vec_len(segs) {
        out = concat(out, "_")
        let s = vec_get(segs, i)
        if route_is_param(s) == 1 {
            out = concat(out, route_param_name(s))
        } else {
            out = concat(out, s)
        }
    }
    if out == oas_lower_method(method) {
        out = concat(out, "_root")
    }
    return out
}

fn oas_summary_for(method: str, pattern: str) -> str {
    return concat(concat(method, " "), pattern)
}

// Path + query parameters for a route.
fn oas_params_from_route(method: str, pattern: str) -> JArr {
    let mut params = jarr_new()
    let segs = route_segments(pattern)
    for i in 0..vec_len(segs) {
        let s = vec_get(segs, i)
        if route_is_param(s) == 1 {
            let name = route_param_name(s)
            let mut p = jobj_new()
            p = jobj_str(p, "name", name)
            p = jobj_str(p, "in", "path")
            p = jobj_bool(p, "required", 1)
            p = jobj_str(p, "description", concat(name, " path parameter"))
            if name == "id" {
                p = jobj_obj(p, "schema", oas_int_schema())
            } else {
                p = jobj_obj(p, "schema", oas_str_schema())
            }
            params = jarr_obj(params, p)
        }
    }
    // Query extras for known list GETs
    if method == "GET" {
        if pattern == "/v1/posts" {
            let mut lim = jobj_new()
            lim = jobj_str(lim, "name", "limit")
            lim = jobj_str(lim, "in", "query")
            lim = jobj_bool(lim, "required", 0)
            lim = jobj_obj(lim, "schema", oas_int_schema())
            params = jarr_obj(params, lim)
            let mut off = jobj_new()
            off = jobj_str(off, "name", "offset")
            off = jobj_str(off, "in", "query")
            off = jobj_bool(off, "required", 0)
            off = jobj_obj(off, "schema", oas_int_schema())
            params = jarr_obj(params, off)
            let mut uidq = jobj_new()
            uidq = jobj_str(uidq, "name", "user_id")
            uidq = jobj_str(uidq, "in", "query")
            uidq = jobj_bool(uidq, "required", 0)
            uidq = jobj_obj(uidq, "schema", oas_int_schema())
            params = jarr_obj(params, uidq)
        }
    }
    if pattern == "/v1/auth/token" {
        if method == "POST" {
            let mut qparam = jobj_new()
            qparam = jobj_str(qparam, "name", "sub")
            qparam = jobj_str(qparam, "in", "query")
            qparam = jobj_bool(qparam, "required", 0)
            qparam = jobj_str(qparam, "description", "Subject (alternative to JSON body)")
            qparam = jobj_obj(qparam, "schema", oas_str_schema())
            params = jarr_obj(params, qparam)
        }
    }
    return params
}

// Request body schema name; "" = none.
fn oas_body_schema(method: str, pattern: str) -> str {
    if method == "POST" {
        if pattern == "/v1/users" {
            return "UserCreate"
        }
        if pattern == "/v1/posts" {
            return "PostCreate"
        }
        if pattern == "/v1/auth/token" {
            return "TokenRequest"
        }
    }
    if method == "PATCH" {
        if pattern == "/v1/users/{id}" {
            return "UserPatch"
        }
        if pattern == "/v1/posts/{id}" {
            return "PostCreate"
        }
    }
    return ""
}

// Primary success response schema; "" = empty body (204-style).
fn oas_ok_schema(method: str, pattern: str) -> str {
    if method == "DELETE" {
        return ""
    }
    if pattern == "/health" {
        return "Status"
    }
    if pattern == "/ready" {
        return "Ready"
    }
    if pattern == "/openapi.json" {
        return ""
    }
    if pattern == "/v1/meta" {
        return "Status"
    }
    if pattern == "/v1/auth/token" {
        return "TokenResponse"
    }
    if pattern == "/v1/me" {
        return "Me"
    }
    if pattern == "/v1/users" {
        if method == "GET" {
            return "UserList"
        }
        if method == "POST" {
            return "User"
        }
    }
    if pattern == "/v1/users/{id}" {
        return "User"
    }
    if pattern == "/v1/posts" {
        if method == "GET" {
            return "PostList"
        }
        if method == "POST" {
            return "Post"
        }
    }
    if pattern == "/v1/posts/{id}" {
        return "Post"
    }
    return "Status"
}

fn oas_success_code(method: str, pattern: str) -> str {
    if method == "POST" {
        if pattern == "/v1/users" {
            return "201"
        }
        if pattern == "/v1/posts" {
            return "201"
        }
    }
    if method == "DELETE" {
        return "204"
    }
    return "200"
}

// Build one operation for a registered route (method + pattern + id).
fn oas_op_from_route(method: str, pattern: str, id: i64) -> JObj {
    let tag = oas_tag_for(pattern)
    let mut op = oas_op(oas_op_id_for(method, pattern), oas_summary_for(method, pattern), tag)
    op = jobj_i64(op, "x-baga-route-id", id)
    if oas_is_public(pattern, method) == 0 {
        op = oas_add_bearer(op)
    }
    let params = oas_params_from_route(method, pattern)
    if vec_len(params.items) > 0 {
        op = jobj_raw(op, "parameters", jarr_encode(params))
    }
    let body = oas_body_schema(method, pattern)
    if body != "" {
        let mut reqd: i64 = 1
        if pattern == "/v1/auth/token" {
            reqd = 0
        }
        op = oas_add_json_body(op, body, reqd)
    }
    let code = oas_success_code(method, pattern)
    let ok_schema = oas_ok_schema(method, pattern)
    let mut resp = jobj_new()
    if ok_schema == "" {
        resp = jobj_obj(resp, code, oas_response_empty("OK"))
    } else {
        resp = jobj_obj(resp, code, oas_response_ref("OK", ok_schema))
    }
    if oas_is_public(pattern, method) == 0 {
        resp = jobj_obj(resp, "401", oas_response_ref("Unauthorized", "Error"))
    }
    if pattern == "/ready" {
        resp = jobj_obj(resp, "503", oas_response_ref("Unavailable", "Error"))
    }
    if body != "" {
        resp = jobj_obj(resp, "422", oas_response_ref("Validation Error", "HTTPValidationError"))
    }
    if method != "POST" {
        if str_find(pattern, "{id}") >= 0 {
            resp = jobj_obj(resp, "404", oas_response_ref("Not found", "Error"))
        }
    }
    op = jobj_obj(op, "responses", resp)
    return op
}

fn oas_pattern_seen(seen: Vec<str>, pattern: str) -> i64 {
    for i in 0..vec_len(seen) {
        if vec_get(seen, i) == pattern {
            return 1
        }
    }
    return 0
}

// Paths object: only routes present in `r` (source of truth = route table).
fn oas_paths_from_router(r: Router) -> JObj {
    let seen: Vec<str> = vec_new()
    for i in 0..vec_len(r.patterns) {
        let p = vec_get(r.patterns, i)
        if oas_pattern_seen(seen, p) == 0 {
            vec_push(seen, p)
        }
    }
    let mut paths = jobj_new()
    for si in 0..vec_len(seen) {
        let pattern = vec_get(seen, si)
        let mut item = jobj_new()
        for i in 0..vec_len(r.patterns) {
            if vec_get(r.patterns, i) == pattern {
                let method = vec_get(r.methods, i)
                let id = vec_get(r.ids, i)
                let op = oas_op_from_route(method, pattern, id)
                item = jobj_obj(item, oas_lower_method(method), op)
            }
        }
        paths = jobj_obj(paths, pattern, item)
    }
    return paths
}

// Catalog router: same surface as apps/api (for pure unit tests without FmrApp).
fn oas_catalog_router() -> Router {
    let mut r = router_new()
    r = router_add(r, "GET", "/health", 1)
    r = router_add(r, "GET", "/ready", 2)
    r = router_add(r, "GET", "/v1/meta", 3)
    r = router_add(r, "GET", "/openapi.json", 4)
    r = router_add(r, "POST", "/v1/auth/token", 10)
    r = router_add(r, "GET", "/v1/me", 11)
    r = router_add(r, "GET", "/v1/users", 20)
    r = router_add(r, "POST", "/v1/users", 21)
    r = router_add(r, "GET", "/v1/users/{id}", 22)
    r = router_add(r, "PATCH", "/v1/users/{id}", 23)
    r = router_add(r, "DELETE", "/v1/users/{id}", 24)
    r = router_add(r, "GET", "/v1/posts", 30)
    r = router_add(r, "POST", "/v1/posts", 31)
    r = router_add(r, "GET", "/v1/posts/{id}", 32)
    r = router_add(r, "PATCH", "/v1/posts/{id}", 33)
    r = router_add(r, "DELETE", "/v1/posts/{id}", 34)
    return r
}

fn oas_tags() -> str {
    let mut tags = jarr_new()
    let mut t1 = jobj_new()
    t1 = jobj_str(t1, "name", "system")
    t1 = jobj_str(t1, "description", "Health and metadata")
    tags = jarr_obj(tags, t1)
    let mut t2 = jobj_new()
    t2 = jobj_str(t2, "name", "auth")
    t2 = jobj_str(t2, "description", "JWT issue and identity")
    tags = jarr_obj(tags, t2)
    let mut t3 = jobj_new()
    t3 = jobj_str(t3, "name", "users")
    t3 = jobj_str(t3, "description", "User CRUD (Bearer required)")
    tags = jarr_obj(tags, t3)
    let mut t4 = jobj_new()
    t4 = jobj_str(t4, "name", "posts")
    t4 = jobj_str(t4, "description", "Post CRUD (Bearer required)")
    tags = jarr_obj(tags, t4)
    return jarr_encode(tags)
}

// Full OpenAPI 3.0.3 from a live route table (B2.4).
fn fmr_openapi_from_router(r: Router, title: str, version: str) -> JObj {
    let mut info = jobj_new()
    info = jobj_str(info, "title", title)
    info = jobj_str(info, "version", version)
    info = jobj_str(info, "description", "fmrbaga API — paths emitted from the route table; JWT Bearer where required.")

    let mut root = jobj_new()
    root = jobj_str(root, "openapi", "3.0.3")
    root = jobj_obj(root, "info", info)
    root = jobj_raw(root, "tags", oas_tags())
    root = jobj_obj(root, "paths", oas_paths_from_router(r))
    root = jobj_obj(root, "components", oas_components())
    return root
}

// Pure helper for tests: catalog router (= apps/api surface).
fn fmr_openapi_doc(title: str, version: str) -> JObj {
    return fmr_openapi_from_router(oas_catalog_router(), title, version)
}
