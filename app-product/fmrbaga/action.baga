// action.baga — Lucky-style action helpers (thin, readable handlers).
// Crystal/Lucky maps routes to Action classes; Baga uses functions + these helpers.

import "respond.baga"
import "deps.baga"
import "ctx.baga"
import "jsonx.baga"
import "app.baga"
import "../ormbaga/orm.baga"
import "../httpdbaga/http.baga"
import "../../std/str/str.baga"

// ---------- JSON results ----------

fn act_json(db: OrmDb, status: i64, body: str) -> FmrOut {
    return fmr_out(fmr_json(status, body), db)
}

fn act_ok(db: OrmDb, o: JObj) -> FmrOut {
    return fmr_out(fmr_ok_obj(o), db)
}

fn act_created(db: OrmDb, o: JObj) -> FmrOut {
    return fmr_out(fmr_created_obj(o), db)
}

fn act_no_content(db: OrmDb) -> FmrOut {
    return fmr_out(fmr_no_content(), db)
}

fn act_err(db: OrmDb, status: i64, detail: str) -> FmrOut {
    return fmr_out(fmr_error(status, detail), db)
}

fn act_401(db: OrmDb, detail: str) -> FmrOut { return act_err(db, 401, detail) }
fn act_404(db: OrmDb, detail: str) -> FmrOut { return act_err(db, 404, detail) }
fn act_422_field(db: OrmDb, field: str, f: JField) -> FmrOut {
    return fmr_out(fmr_422_jfield(field, f), db)
}

// ---------- auth pipe (Lucky "pipe" / require signed in) ----------

// If ok: use out.ctx (user_sub set). If not: return out.resp via act_from_dep.
struct ActAuth {
    ok: i64,
    ctx: FmrCtx,
    out: FmrOut
}

fn act_require_auth(ctx: FmrCtx, db: OrmDb) -> ActAuth {
    let d = deps_bearer(ctx)
    if d.ok == 0 {
        return ActAuth {
            ok: 0,
            ctx: ctx,
            out: fmr_out(d.resp, db)
        }
    }
    return ActAuth {
        ok: 1,
        ctx: d.ctx,
        out: fmr_out(fmr_json(200, "{}"), db)
    }
}

// ---------- request logging (FMR_LOG=1) ----------

fn act_log_line(ctx: FmrCtx, status: i64) {
    // always available; callers gate on config
    let line = concat(
        concat(concat(fmr_method(ctx), " "), fmr_path(ctx)),
        concat(" → ", int_to_str(status))
    )
    eprintln(line)
}

// ---------- model row → JSON (Lucky serializer vibe) ----------

fn act_msg(db: OrmDb, msg: str) -> FmrOut {
    let mut o = jobj_new()
    o = jobj_str(o, "message", msg)
    return act_ok(db, o)
}

// ---------- path / query helpers ----------

// Require positive integer path param; ok=0 → out is 400.
struct ActId {
    ok: i64,
    id: i64,
    out: FmrOut
}

fn act_require_id(ctx: FmrCtx, db: OrmDb, name: str) -> ActId {
    let id = fmr_param_i64(ctx, name)
    if id <= 0 {
        return ActId {
            ok: 0,
            id: 0,
            out: act_err(db, 400, concat("invalid ", name))
        }
    }
    return ActId {
        ok: 1,
        id: id,
        out: fmr_out(fmr_json(200, "{}"), db)
    }
}

// Pagination from query: ?limit=&offset=  (clamped).
struct ActPage {
    limit: i64,
    offset: i64
}

fn act_page(ctx: FmrCtx, default_limit: i64, max_limit: i64) -> ActPage {
    let mut lim = default_limit
    let mut off: i64 = 0
    let ls = fmr_query(ctx, "limit")
    if ls != "" {
        lim = parse_int(ls)
    }
    let os = fmr_query(ctx, "offset")
    if os != "" {
        off = parse_int(os)
    }
    if lim < 1 {
        lim = default_limit
    }
    if lim > max_limit {
        lim = max_limit
    }
    if off < 0 {
        off = 0
    }
    return ActPage { limit: lim, offset: off }
}

// Wrap list payload with pagination meta.
fn act_page_wrap(items_json: str, count: i64, page: ActPage) -> JObj {
    let mut o = jobj_new()
    o = jobj_raw(o, "items", items_json)
    o = jobj_i64(o, "count", count)
    o = jobj_i64(o, "limit", page.limit)
    o = jobj_i64(o, "offset", page.offset)
    return o
}

// SQL fragment: LIMIT $n OFFSET $n+1 style placeholders — callers pass bound vals.
fn act_sql_limit_offset(base_sql: str) -> str {
    return concat(base_sql, " LIMIT $1 OFFSET $2")
}
