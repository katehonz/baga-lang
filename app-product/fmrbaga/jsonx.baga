// jsonx.baga — FastAPI-grade JSON helpers on std/json.
// Builders (jobj/jarr) + request body validation (jreq/jopt) + 422 detail.
// Pure. No effects.

import "std/json/json.baga"
import "std/str/str.baga"

// ---------- object builder (values pre-encoded as JSON text) ----------

struct JObj {
    keys: Vec<str>,
    vals: Vec<str>
}

fn jobj_new() -> JObj {
    return JObj { keys: vec_new(), vals: vec_new() }
}

fn jobj_raw(o: JObj, key: str, json_val: str) -> JObj {
    vec_push(o.keys, key)
    vec_push(o.vals, json_val)
    return o
}

fn jobj_str(o: JObj, key: str, val: str) -> JObj {
    return jobj_raw(o, key, json_escape(val))
}

fn jobj_i64(o: JObj, key: str, val: i64) -> JObj {
    return jobj_raw(o, key, int_to_str(val))
}

fn jobj_bool(o: JObj, key: str, val: i64) -> JObj {
    if val == 0 {
        return jobj_raw(o, key, "false")
    }
    return jobj_raw(o, key, "true")
}

fn jobj_null(o: JObj, key: str) -> JObj {
    return jobj_raw(o, key, "null")
}

fn jobj_obj(o: JObj, key: str, child: JObj) -> JObj {
    return jobj_raw(o, key, jobj_encode(child))
}

fn jobj_arr(o: JObj, key: str, child: JArr) -> JObj {
    return jobj_raw(o, key, jarr_encode(child))
}

fn jobj_encode(o: JObj) -> str {
    let mut out = "{"
    let n = vec_len(o.keys)
    for i in 0..n {
        if i > 0 {
            out = concat(out, ",")
        }
        out = concat(out, json_escape(vec_get(o.keys, i)))
        out = concat(out, ":")
        out = concat(out, vec_get(o.vals, i))
    }
    return concat(out, "}")
}

// ---------- array builder ----------

struct JArr {
    items: Vec<str>
}

fn jarr_new() -> JArr {
    return JArr { items: vec_new() }
}

fn jarr_raw(a: JArr, json_val: str) -> JArr {
    vec_push(a.items, json_val)
    return a
}

fn jarr_str(a: JArr, val: str) -> JArr {
    return jarr_raw(a, json_escape(val))
}

fn jarr_i64(a: JArr, val: i64) -> JArr {
    return jarr_raw(a, int_to_str(val))
}

fn jarr_bool(a: JArr, val: i64) -> JArr {
    if val == 0 {
        return jarr_raw(a, "false")
    }
    return jarr_raw(a, "true")
}

fn jarr_null(a: JArr) -> JArr {
    return jarr_raw(a, "null")
}

fn jarr_obj(a: JArr, child: JObj) -> JArr {
    return jarr_raw(a, jobj_encode(child))
}

fn jarr_encode(a: JArr) -> str {
    let mut out = "["
    let n = vec_len(a.items)
    for i in 0..n {
        if i > 0 {
            out = concat(out, ",")
        }
        out = concat(out, vec_get(a.items, i))
    }
    return concat(out, "]")
}

// ---------- validation result ----------

struct JField {
    ok: i64,       // 1 = present and type-ok
    err: str,      // human message
    err_type: str, // FastAPI-ish type string
    val: str,      // string form (numbers as text, bools "true"/"false")
    num: i64,      // integer extract when applicable
    present: i64   // 1 if key exists (even if wrong type)
}

fn jfield_ok_str(v: str) -> JField {
    return JField { ok: 1, err: "", err_type: "", val: v, num: 0, present: 1 }
}

fn jfield_ok_i64(n: i64, raw: str) -> JField {
    return JField { ok: 1, err: "", err_type: "", val: raw, num: n, present: 1 }
}

fn jfield_missing(field: str) -> JField {
    return JField {
        ok: 0,
        err: concat(field, " field required"),
        err_type: "value_error.missing",
        val: "",
        num: 0,
        present: 0
    }
}

fn jfield_type(field: str, want: str) -> JField {
    return JField {
        ok: 0,
        err: concat(concat(field, " must be "), want),
        err_type: "type_error",
        val: "",
        num: 0,
        present: 1
    }
}

// FastAPI-like validation error body (single field).
fn j422_field(loc0: str, loc1: str, msg: str, typ: str) -> str {
    let mut loc = jarr_new()
    loc = jarr_str(loc, loc0)
    loc = jarr_str(loc, loc1)
    let mut item = jobj_new()
    item = jobj_raw(item, "loc", jarr_encode(loc))
    item = jobj_str(item, "msg", msg)
    item = jobj_str(item, "type", typ)
    let mut detail = jarr_new()
    detail = jarr_obj(detail, item)
    let mut body = jobj_new()
    body = jobj_raw(body, "detail", jarr_encode(detail))
    return jobj_encode(body)
}

fn j422_msg(msg: str) -> str {
    let mut body = jobj_new()
    body = jobj_str(body, "detail", msg)
    return jobj_encode(body)
}

// Simple detail string envelope: {"detail":"..."}.
fn jdetail(msg: str) -> str {
    return j422_msg(msg)
}

// ---------- body / document accessors ----------

struct JBody {
    ok: i64,
    err: str,
    doc: JsonDoc,
    root: i64
}

fn jbody_empty_doc() -> JsonDoc {
    // parse "null" as a safe empty doc
    return json_parse("null")
}

fn jbody_parse_str(s: str) -> JBody {
    if len(str_trim(s)) == 0 {
        return JBody { ok: 0, err: "empty body", doc: jbody_empty_doc(), root: 0 }
    }
    // json_parse is lenient (recovers shape); request bodies must be
    // well-formed — reject with the strict RFC 8259 check first (G13).
    if json_strict_valid(s) == 0 {
        return JBody { ok: 0, err: "invalid JSON", doc: jbody_empty_doc(), root: 0 }
    }
    let d = json_parse(s)
    let r = json_root(d)
    if json_tag(d, r) < 0 {
        return JBody { ok: 0, err: "invalid JSON", doc: d, root: r }
    }
    return JBody { ok: 1, err: "", doc: d, root: r }
}

fn jbody_require_object(b: JBody) -> JBody {
    if b.ok == 0 {
        return b
    }
    if json_tag(b.doc, b.root) != 6 {
        return JBody { ok: 0, err: "JSON body must be an object", doc: b.doc, root: b.root }
    }
    return b
}

// Required string field on object node.
fn jreq_str(d: JsonDoc, obj: i64, key: str) -> JField {
    let n = json_get(d, obj, key)
    if n < 0 {
        return jfield_missing(key)
    }
    if json_tag(d, n) != 4 {
        return jfield_type(key, "string")
    }
    return jfield_ok_str(json_str(d, n))
}

// Required integer (JSON number without fraction preferred; truncates f64).
fn jreq_i64(d: JsonDoc, obj: i64, key: str) -> JField {
    let n = json_get(d, obj, key)
    if n < 0 {
        return jfield_missing(key)
    }
    if json_tag(d, n) != 3 {
        return jfield_type(key, "integer")
    }
    let raw = json_str(d, n)
    // reject obvious floats for strict int API fields
    if str_find(raw, ".") >= 0 || str_find(raw, "e") >= 0 || str_find(raw, "E") >= 0 {
        return jfield_type(key, "integer")
    }
    return jfield_ok_i64(parse_int(raw), raw)
}

fn jreq_bool(d: JsonDoc, obj: i64, key: str) -> JField {
    let n = json_get(d, obj, key)
    if n < 0 {
        return jfield_missing(key)
    }
    let t = json_tag(d, n)
    if t == 1 {
        return JField { ok: 1, err: "", err_type: "", val: "false", num: 0, present: 1 }
    }
    if t == 2 {
        return JField { ok: 1, err: "", err_type: "", val: "true", num: 1, present: 1 }
    }
    return jfield_type(key, "boolean")
}

// Optional string; if missing → default; if wrong type → error.
fn jopt_str(d: JsonDoc, obj: i64, key: str, default_val: str) -> JField {
    let n = json_get(d, obj, key)
    if n < 0 {
        return JField {
            ok: 1, err: "", err_type: "", val: default_val, num: 0, present: 0
        }
    }
    if json_tag(d, n) == 0 {
        return JField { ok: 1, err: "", err_type: "", val: default_val, num: 0, present: 1 }
    }
    if json_tag(d, n) != 4 {
        return jfield_type(key, "string")
    }
    return jfield_ok_str(json_str(d, n))
}

fn jhas(d: JsonDoc, obj: i64, key: str) -> i64 {
    if json_get(d, obj, key) < 0 {
        return 0
    }
    return 1
}
