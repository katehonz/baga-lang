// demo.baga — self-check of testbaga asserts (apps-roadmap №8).
//   cd app-product/testbaga && sandak build
//   baga -I ../.. -I .. demo.baga

import "assert.baga"
import "std/str/str.baga"

fn main() -> i64 {
    // fail-fast style
    assert_true("truth", true)
    assert_eq("one_plus_one", 1 + 1, 2)
    assert_eq("hello", concat("hel", "lo"), "hello")
    assert_ne_str("not_empty", "x", "")

    // suite style (would continue after failures if we injected any)
    let mut s = suite_new("demo")
    s = suite_true(s, "suite_truth", 1 < 2)
    s = suite_eq_i64(s, "suite_sum", 3 + 4, 7)
    s = suite_eq_str(s, "suite_join", str_join(str_split("a,b", ","), "-"), "a-b")
    return suite_finish(s)
}
