// store.baga — the KV store: Map<str,str> values + Map<str,i64> expiry
// deadlines (monotonic ms). Lazy expiration on access (Redis-style).
// KvStore holds map pointers — passing it around shares the same store.

import "std/str/str.baga"
import "std/time/time.baga"

struct KvStore {
    vals: Map<str, str>,
    expires: Map<str, i64>    // deadline in monotonic ms; absent = no TTL
}

fn kv_new() -> KvStore {
    return KvStore { vals: map_new(), expires: map_new() }
}

fn kv_now() -> i64 !Time {
    return monotonic_ms()?
}

// 1 when the key exists and is not past its deadline; drops it if expired.
fn kv_alive(st: KvStore, key: str, now: i64) -> i64 {
    if map_has(st.vals, key) == 0 {
        return 0
    }
    if map_has(st.expires, key) == 1 {
        if map_get(st.expires, key) <= now {
            map_del(st.vals, key)
            map_del(st.expires, key)
            return 0
        }
    }
    return 1
}

// SET semantics: clears any existing TTL.
fn kv_set(st: KvStore, key: str, val: str) {
    map_set(st.vals, key, val)
    map_del(st.expires, key)
}

// SET with a deadline (monotonic ms).
fn kv_set_ex(st: KvStore, key: str, val: str, deadline: i64) {
    map_set(st.vals, key, val)
    map_set(st.expires, key, deadline)
}

// Write the value, keep the TTL (INCR semantics).
fn kv_put(st: KvStore, key: str, val: str) {
    map_set(st.vals, key, val)
}

// True integer text (optional leading '-'); parse_int alone is too lenient.
fn kv_is_int(s: str) -> i64 {
    if len(s) == 0 {
        return 0
    }
    let mut i: i64 = 0
    if char_at(s, 0) == 45 {   // '-'
        if len(s) == 1 {
            return 0
        }
        i = 1
    }
    while i < len(s) {
        let c = char_at(s, i)
        if c < 48 || c > 57 {
            return 0
        }
        i = i + 1
    }
    return 1
}

// Live keys (expired dropped on the way).
fn kv_keys(st: KvStore, now: i64) -> Vec<str> {
    let ks = map_keys(st.vals)
    let out = vec_new()
    for i in 0..vec_len(ks) {
        let k = vec_get(ks, i)
        if kv_alive(st, k, now) == 1 {
            vec_push(out, k)
        }
    }
    return out
}
