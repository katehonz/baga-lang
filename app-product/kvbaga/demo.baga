// demo.baga — boot kvbaga in a background worker, then drive it as a RESP
// client. Env: KVPORT (default 16379).

import "server.baga"
import "resp.baga"
import "std/net/tcp.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn cfg(name: str, def: str) -> str !IO {
    let v = env(name)?
    if v == "" {
        return def
    }
    return v
}

fn args1(a: str) -> Vec<str> {
    let v = vec_new()
    vec_push(v, a)
    return v
}

fn args2(a: str, b: str) -> Vec<str> {
    let v = vec_new()
    vec_push(v, a)
    vec_push(v, b)
    return v
}

fn args3(a: str, b: str, c: str) -> Vec<str> {
    let v = vec_new()
    vec_push(v, a)
    vec_push(v, b)
    vec_push(v, c)
    return v
}

fn args5(a: str, b: str, c: str, d: str, e: str) -> Vec<str> {
    let v = vec_new()
    vec_push(v, a)
    vec_push(v, b)
    vec_push(v, c)
    vec_push(v, d)
    vec_push(v, e)
    return v
}

// Human-readable reply: +simple / -error / :int / bulk / (nil) / *array
fn show(fd: i64, a: Vec<str>) -> str !Net !IO {
    let r = resp_round_trip(fd, a)?
    if r.ok == 0 {
        return "(io error)"
    }
    if r.typ == 1 {
        return concat("+", r.text)
    }
    if r.typ == 2 {
        return concat("-", r.text)
    }
    if r.typ == 3 {
        return concat(":", int_to_str(r.num))
    }
    if r.typ == 4 {
        if r.num < 0 {
            return "(nil)"
        }
        return r.text
    }
    let mut out = concat(concat("*", int_to_str(r.num)), ":")
    for i in 0..vec_len(r.items) {
        out = concat(concat(out, " "), vec_get(r.items, i))
    }
    return out
}

fn run(fd: i64, label: str, a: Vec<str>) -> i64 !Net !IO {
    let s = show(fd, a)?
    print(concat(concat(label, " → "), s))
    return 0
}

fn main() -> i64 !Net !IO !Par !Time {
    let port = parse_int(cfg("KVPORT", "16379")?)
    go_bg(kv_serve, port)
    sleep_ms(200)
    let fd = tcp_connect_to("localhost", port, 5)?
    if fd < 0 {
        print("connect failed")
        return 1
    }
    tcp_set_timeouts(fd, 5)?
    print(concat("kvbaga demo → localhost:", int_to_str(port)))

    run(fd, "PING", args1("PING"))?
    run(fd, "SET user:1 Здравей", args3("SET", "user:1", "Здравей"))?
    run(fd, "GET user:1", args2("GET", "user:1"))?
    run(fd, "GET missing", args2("GET", "missing"))?
    run(fd, "SET counter 41", args3("SET", "counter", "41"))?
    run(fd, "INCR counter", args2("INCR", "counter"))?
    run(fd, "INCR counter", args2("INCR", "counter"))?
    run(fd, "SET tmp x EX 1", args5("SET", "tmp", "x", "EX", "1"))?
    run(fd, "TTL tmp", args2("TTL", "tmp"))?
    run(fd, "KEYS", args1("KEYS"))?
    run(fd, "DBSIZE", args1("DBSIZE"))?
    run(fd, "DEL tmp", args2("DEL", "tmp"))?
    run(fd, "EXISTS tmp", args2("EXISTS", "tmp"))?
    run(fd, "WHAT", args1("WHAT"))?

    tcp_close(fd)?
    print("done")
    return 0
}
