// server.baga — kvbaga: a Redis-compatible KV server on the RESP2 protocol,
// backed by Map<str,str> (the new language map type).
//
// Commands: PING SET (EX) GET DEL EXISTS INCR KEYS EXPIRE TTL DBSIZE QUIT
// Concurrency: one store, connections served serially (Redis-1.x style) —
// go() cannot carry the store pointer across threads (see gaps.md).

import "resp.baga"
import "store.baga"
import "std/net/tcp.baga"
import "std/str/str.baga"
import "std/time/time.baga"
import "std/bytes/bytes.baga"

// ASCII upper-case (commands are case-insensitive, like Redis).
fn kv_upper(s: str) -> str {
    let mut out = ""
    for i in 0..len(s) {
        let mut c = char_at(s, i)
        if c >= 97 && c <= 122 {
            c = c - 32
        }
        out = concat(out, chr(c))
    }
    return out
}

fn kv_wrongnum(cmd: str) -> bytes {
    return resp_error(concat(concat("ERR wrong number of arguments for '", cmd), "'"))
}

// Execute one parsed command against the store; returns the RESP reply.
fn kv_exec(st: KvStore, args: Vec<str>) -> bytes !Time {
    let cmd = kv_upper(vec_get(args, 0))
    let n = vec_len(args)

    if cmd == "PING" {
        return resp_simple("PONG")
    }
    if cmd == "QUIT" {
        return resp_simple("OK")
    }
    if cmd == "SET" {
        if n < 3 {
            return kv_wrongnum("set")
        }
        if n >= 5 && kv_upper(vec_get(args, 3)) == "EX" {
            let secs = parse_int(vec_get(args, 4))
            if secs <= 0 {
                return resp_error("ERR invalid expire time in 'set'")
            }
            kv_set_ex(st, vec_get(args, 1), vec_get(args, 2), kv_now()? + secs * 1000)
        } else {
            kv_set(st, vec_get(args, 1), vec_get(args, 2))
        }
        return resp_simple("OK")
    }
    if cmd == "GET" {
        if n != 2 {
            return kv_wrongnum("get")
        }
        let k = vec_get(args, 1)
        if kv_alive(st, k, kv_now()?) == 0 {
            return resp_null_bulk()
        }
        return resp_bulk(map_get(st.vals, k))
    }
    if cmd == "DEL" {
        if n != 2 {
            return kv_wrongnum("del")
        }
        let k = vec_get(args, 1)
        if kv_alive(st, k, kv_now()?) == 0 {
            return resp_int(0)
        }
        map_del(st.vals, k)
        map_del(st.expires, k)
        return resp_int(1)
    }
    if cmd == "EXISTS" {
        if n != 2 {
            return kv_wrongnum("exists")
        }
        return resp_int(kv_alive(st, vec_get(args, 1), kv_now()?))
    }
    if cmd == "INCR" {
        if n != 2 {
            return kv_wrongnum("incr")
        }
        let k = vec_get(args, 1)
        let now = kv_now()?
        let mut base: i64 = 0
        if kv_alive(st, k, now) == 1 {
            let cur = map_get(st.vals, k)
            if kv_is_int(cur) == 0 {
                return resp_error("ERR value is not an integer or out of range")
            }
            base = parse_int(cur)
        }
        kv_put(st, k, int_to_str(base + 1))   // keep the TTL, like Redis
        return resp_int(base + 1)
    }
    if cmd == "KEYS" {
        if n != 1 {
            return kv_wrongnum("keys")
        }
        let alive = kv_keys(st, kv_now()?)
        let mut r = resp_array(vec_len(alive))
        for i in 0..vec_len(alive) {
            r = bytes_concat(r, resp_bulk(vec_get(alive, i)))
        }
        return r
    }
    if cmd == "EXPIRE" {
        if n != 3 {
            return kv_wrongnum("expire")
        }
        let k = vec_get(args, 1)
        if kv_alive(st, k, kv_now()?) == 0 {
            return resp_int(0)
        }
        let secs = parse_int(vec_get(args, 2))
        if secs <= 0 {
            map_del(st.vals, k)
            map_del(st.expires, k)
            return resp_int(1)   // Redis deletes on non-positive EXPIRE
        }
        map_set(st.expires, k, kv_now()? + secs * 1000)
        return resp_int(1)
    }
    if cmd == "TTL" {
        if n != 2 {
            return kv_wrongnum("ttl")
        }
        let k = vec_get(args, 1)
        if kv_alive(st, k, kv_now()?) == 0 {
            return resp_int(-2)
        }
        if map_has(st.expires, k) == 0 {
            return resp_int(-1)
        }
        let rem = map_get(st.expires, k) - kv_now()?
        return resp_int((rem + 999) / 1000)
    }
    if cmd == "DBSIZE" {
        if n != 1 {
            return kv_wrongnum("dbsize")
        }
        return resp_int(vec_len(kv_keys(st, kv_now()?)))
    }
    return resp_error(concat(concat("ERR unknown command '", vec_get(args, 0)), "'"))
}

// One connection: buffer bytes, execute every complete command, reply inline.
fn kv_serve_conn(fd: i64, st: KvStore) -> i64 !IO !Net !Time {
    let mut buf = bytes_from_vec(vec_new())
    let mut running: i64 = 1
    while running == 1 {
        let chunk = tcp_read_bytes(fd, 4096)?
        if bytes_len(chunk) == 0 {
            running = 0
        } else {
            buf = bytes_concat(buf, chunk)
            let mut again: i64 = 1
            while again == 1 {
                let p = resp_parse_command(buf)
                if p.ok == 0 {
                    again = 0
                } else {
                    buf = bytes_slice(buf, p.consumed, bytes_len(buf))
                    let quit = n_upper_is_quit(p.args)
                    let reply = kv_exec(st, p.args)?
                    let w = tcp_write_bytes(fd, reply)?
                    if w != 0 || quit == 1 {
                        running = 0
                        again = 0
                    }
                }
            }
        }
    }
    return 0
}

fn n_upper_is_quit(args: Vec<str>) -> i64 {
    if vec_len(args) == 0 {
        return 0
    }
    if kv_upper(vec_get(args, 0)) == "QUIT" {
        return 1
    }
    return 0
}

// Serial accept loop with one shared store. timeout_s bounds connect/reads
// (0 = block forever). Designed for go_bg(kv_serve, port).
fn kv_serve_to(port: i64, timeout_s: i64) -> i64 !Net !IO !Time !Par {
    let listener = tcp_listen(port)?
    if listener < 0 {
        return -1
    }
    let st = kv_new()
    while true {
        let fd = tcp_accept(listener)?
        if fd >= 0 {
            if timeout_s > 0 {
                tcp_set_timeouts(fd, timeout_s)?
            }
            kv_serve_conn(fd, st)?
            tcp_close(fd)?
        }
    }
    return 0
}

// Default: drop idle/malicious connections after 60 s.
fn kv_serve(port: i64) -> i64 !Net !IO !Time !Par {
    return kv_serve_to(port, 60)?
}
