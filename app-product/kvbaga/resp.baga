// resp.baga — RESP2 (REdis Serialization Protocol) for kvbaga. Pure framing:
// parse one command from a byte buffer, build replies, encode client commands.
//
// R65: binary-safe bulk args via RespParseB / resp_parse_command_b (Vec<bytes>).
// Legacy RespParse / resp_parse_command still returns Vec<str> (NUL-unsafe for
// values — kept for kvbaga + existing tests; rocksbaga uses the _b path).

import "std/bytes/bytes.baga"
import "std/str/str.baga"
import "std/net/tcp.baga"

// ---------- parsing (server side) ----------

struct RespParse {
    ok: i64,          // 1 = one full command parsed
    args: Vec<str>,
    consumed: i64     // bytes to drop from the buffer
}

// R65: same framing, payloads stay as bytes (binary-safe bulk strings).
struct RespParseB {
    ok: i64,
    args: Vec<bytes>,
    consumed: i64
}

// Index of the CR of the first CRLF at/after pos; -1 when absent.
fn resp_find_crlf(buf: bytes, pos: i64) -> i64 {
    let n = bytes_len(buf)
    let mut i = pos
    while i + 1 < n {
        if bytes_at(buf, i) == 13 && bytes_at(buf, i + 1) == 10 {
            return i
        }
        i = i + 1
    }
    return -1
}

// Parse decimal integer in buf[start, end) without allocating a string (R29).
// Returns -1 on empty/non-digit (except empty → treat as error).
fn resp_parse_dec(buf: bytes, start: i64, end: i64) -> i64 {
    if start >= end {
        return 0 - 1
    }
    let mut n: i64 = 0
    let mut i = start
    while i < end {
        let c = bytes_at(buf, i) & 255
        if c < 48 || c > 57 {
            return 0 - 1
        }
        n = n * 10 + (c - 48)
        i = i + 1
    }
    return n
}

// R65: binary-safe parse — arg payloads stay bytes (embedded NUL ok).
// ok=0 means "need more data" (or garbage — the connection is dropped then).
// R29: headers (*N / $len) parsed as digits on the wire — no str for framing.
fn resp_parse_command_b(buf: bytes) -> RespParseB {
    let none: Vec<bytes> = vec_new()
    let blen0 = bytes_len(buf)
    if blen0 < 4 {
        return RespParseB { ok: 0, args: none, consumed: 0 }
    }
    if (bytes_at(buf, 0) & 255) != 42 {   // '*'
        return RespParseB { ok: 0, args: none, consumed: 0 }
    }
    let eol = resp_find_crlf(buf, 0)
    if eol < 1 {
        return RespParseB { ok: 0, args: none, consumed: 0 }
    }
    let n = resp_parse_dec(buf, 1, eol)
    if n <= 0 || n > 64 {
        return RespParseB { ok: 0, args: none, consumed: 0 }
    }
    let args: Vec<bytes> = vec_new()
    let mut pos = eol + 2
    let mut i: i64 = 0
    while i < n {
        if pos >= blen0 {
            return RespParseB { ok: 0, args: none, consumed: 0 }
        }
        if (bytes_at(buf, pos) & 255) != 36 {   // '$'
            return RespParseB { ok: 0, args: none, consumed: 0 }
        }
        let le = resp_find_crlf(buf, pos)
        if le < pos + 1 {
            return RespParseB { ok: 0, args: none, consumed: 0 }
        }
        let alen = resp_parse_dec(buf, pos + 1, le)
        if alen < 0 || alen > 536870912 {
            return RespParseB { ok: 0, args: none, consumed: 0 }
        }
        let start = le + 2
        if blen0 < start + alen + 2 {
            return RespParseB { ok: 0, args: none, consumed: 0 }
        }
        vec_push(args, bytes_slice(buf, start, start + alen))
        pos = start + alen + 2
        i = i + 1
    }
    return RespParseB { ok: 1, args: args, consumed: pos }
}

// Legacy: *N + bulk frames → Vec<str>. Identical wire framing to _b; payloads
// go through str_of_bytes (NUL-unsafe). Prefer resp_parse_command_b for
// binary values. Implemented via _b so framing stays one code path.
fn resp_parse_command(buf: bytes) -> RespParse {
    let none: Vec<str> = vec_new()
    let pb = resp_parse_command_b(buf)
    if pb.ok == 0 {
        return RespParse { ok: 0, args: none, consumed: 0 }
    }
    let args: Vec<str> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(pb.args) {
        vec_push(args, str_of_bytes(vec_get(pb.args, i)))
        i = i + 1
    }
    return RespParse { ok: 1, args: args, consumed: pb.consumed }
}

// ---------- reply builders (server side) ----------

fn resp_simple(s: str) -> bytes {
    return bytes_of_str(concat(concat("+", s), "\r\n"))
}

// Hot-path constants (R29) — one string build each call still, but no concat chain
// for the common fixed replies used by PING/SET.
fn resp_pong() -> bytes {
    return bytes_of_str("+PONG\r\n")
}

fn resp_ok() -> bytes {
    return bytes_of_str("+OK\r\n")
}

fn resp_error(msg: str) -> bytes {
    return bytes_of_str(concat(concat("-", msg), "\r\n"))
}

fn resp_int(n: i64) -> bytes {
    return bytes_of_str(concat(concat(":", int_to_str(n)), "\r\n"))
}

fn resp_bulk(s: str) -> bytes {
    let head = concat(concat(concat("$", int_to_str(len(s))), "\r\n"), s)
    return bytes_of_str(concat(head, "\r\n"))
}

// Binary-safe bulk ($N\\r\\n + raw bytes + \\r\\n). Prefer for Map/bytes stores.
// R30: single prealloc + copy (no double concat of head|body|tail).
fn resp_bulk_b(b: bytes) -> bytes {
    let n = bytes_len(b)
    let num = int_to_str(n)
    // "$" + digits + "\r\n" + body + "\r\n"
    let hlen = 1 + len(num) + 2
    let total = hlen + n + 2
    let out = bytes_new(total)
    bytes_set(out, 0, 36)  // '$'
    let mut i: i64 = 0
    while i < len(num) {
        bytes_set(out, 1 + i, char_at(num, i))
        i = i + 1
    }
    bytes_set(out, 1 + len(num), 13)
    bytes_set(out, 1 + len(num) + 1, 10)
    i = 0
    while i < n {
        bytes_set(out, hlen + i, bytes_at(b, i))
        i = i + 1
    }
    bytes_set(out, hlen + n, 13)
    bytes_set(out, hlen + n + 1, 10)
    return out
}

fn resp_null_bulk() -> bytes {
    return bytes_of_str("$-1\r\n")
}

fn resp_array(n: i64) -> bytes {
    return bytes_of_str(concat(concat("*", int_to_str(n)), "\r\n"))
}

// ---------- client side ----------

// R65: encode command with binary-safe bulk args.
fn resp_encode_command_b(args: Vec<bytes>) -> bytes {
    let n = vec_len(args)
    let mut out = bytes_of_str(concat(concat("*", int_to_str(n)), "\r\n"))
    let mut i: i64 = 0
    while i < n {
        let a = vec_get(args, i)
        let head = bytes_of_str(concat(concat("$", int_to_str(bytes_len(a))), "\r\n"))
        let crlf = bytes_of_str("\r\n")
        out = bytes_concat(out, head)
        out = bytes_concat(out, a)
        out = bytes_concat(out, crlf)
        i = i + 1
    }
    return out
}

// Encode one command: *N + N bulk frames (text args; NUL-unsafe).
fn resp_encode_command(args: Vec<str>) -> bytes {
    let bs: Vec<bytes> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(args) {
        vec_push(bs, bytes_of_str(vec_get(args, i)))
        i = i + 1
    }
    return resp_encode_command_b(bs)
}

struct RespReply {
    ok: i64,          // 1 = one full reply parsed
    typ: i64,         // 1 simple, 2 error, 3 int, 4 bulk, 5 array
    text: str,        // simple/error text; bulk payload
    num: i64,         // int value; bulk len; array count (-1 null)
    items: Vec<str>,  // array elements (first level, as text)
    consumed: i64
}

// Parse one reply. Nested arrays are flattened to text items (tests/demo need
// only arrays of bulk/simple/int — good enough for KEYS).
fn resp_parse_reply(buf: bytes) -> RespReply {
    let noitems = vec_new()
    let eol = resp_find_crlf(buf, 0)
    if eol < 0 {
        return RespReply { ok: 0, typ: 0, text: "", num: 0, items: noitems, consumed: 0 }
    }
    let t = bytes_at(buf, 0)
    let line = str_of_bytes(bytes_slice(buf, 1, eol))
    if t == 43 {   // '+'
        return RespReply { ok: 1, typ: 1, text: line, num: 0, items: vec_new(), consumed: eol + 2 }
    }
    if t == 45 {   // '-'
        return RespReply { ok: 1, typ: 2, text: line, num: 0, items: vec_new(), consumed: eol + 2 }
    }
    if t == 58 {   // ':'
        return RespReply { ok: 1, typ: 3, text: "", num: parse_int(line), items: vec_new(), consumed: eol + 2 }
    }
    if t == 36 {   // '$'
        let blen = parse_int(line)
        if blen < 0 {
            return RespReply { ok: 1, typ: 4, text: "", num: -1, items: vec_new(), consumed: eol + 2 }
        }
        let start = eol + 2
        if bytes_len(buf) < start + blen + 2 {
            return RespReply { ok: 0, typ: 0, text: "", num: 0, items: vec_new(), consumed: 0 }
        }
        let payload = str_of_bytes(bytes_slice(buf, start, start + blen))
        return RespReply { ok: 1, typ: 4, text: payload, num: blen, items: vec_new(), consumed: start + blen + 2 }
    }
    if t == 42 {   // '*'
        let n = parse_int(line)
        let items = vec_new()
        if n < 0 {
            return RespReply { ok: 1, typ: 5, text: "", num: -1, items: items, consumed: eol + 2 }
        }
        let mut pos = eol + 2
        let mut i: i64 = 0
        while i < n {
            let sub = resp_parse_reply(bytes_slice(buf, pos, bytes_len(buf)))
            if sub.ok == 0 {
                return RespReply { ok: 0, typ: 0, text: "", num: 0, items: vec_new(), consumed: 0 }
            }
            if sub.typ == 4 || sub.typ == 1 {
                vec_push(items, sub.text)
            } else {
                vec_push(items, int_to_str(sub.num))
            }
            pos = pos + sub.consumed
            i = i + 1
        }
        return RespReply { ok: 1, typ: 5, text: "", num: n, items: items, consumed: pos }
    }
    return RespReply { ok: 1, typ: 2, text: "unknown reply type", num: 0, items: vec_new(), consumed: eol + 2 }
}

// Round-trip one command over fd: write, then read until one full reply.
// ok=0 on I/O failure or timeout.
fn resp_round_trip_raw(fd: i64, cmd: bytes) -> RespReply !Net !IO {
    let w = tcp_write_bytes(fd, cmd)?
    if w != 0 {
        return RespReply { ok: 0, typ: 0, text: "", num: 0, items: vec_new(), consumed: 0 }
    }
    let mut buf = bytes_from_vec(vec_new())
    let mut tries: i64 = 0
    while tries < 1024 {
        let chunk = tcp_read_bytes(fd, 4096)?
        if bytes_len(chunk) == 0 {
            return RespReply { ok: 0, typ: 0, text: "", num: 0, items: vec_new(), consumed: 0 }
        }
        buf = bytes_concat(buf, chunk)
        let r = resp_parse_reply(buf)
        if r.ok == 1 {
            return r
        }
        tries = tries + 1
    }
    return RespReply { ok: 0, typ: 0, text: "", num: 0, items: vec_new(), consumed: 0 }
}

// R65: binary-safe client round-trip.
fn resp_round_trip_b(fd: i64, args: Vec<bytes>) -> RespReply !Net !IO {
    return resp_round_trip_raw(fd, resp_encode_command_b(args))?
}

fn resp_round_trip(fd: i64, args: Vec<str>) -> RespReply !Net !IO {
    return resp_round_trip_raw(fd, resp_encode_command(args))?
}

// Parse bulk reply payload as raw bytes (for binary GET checks).
// Returns ok=0 if not a full bulk reply; found=0 for null bulk ($-1).
struct RespBulkB {
    ok: i64,
    found: i64,
    val: bytes,
    consumed: i64
}

fn resp_parse_bulk_b(buf: bytes) -> RespBulkB {
    let empty = bytes_new(0)
    let eol = resp_find_crlf(buf, 0)
    if eol < 0 || (bytes_at(buf, 0) & 255) != 36 {
        return RespBulkB { ok: 0, found: 0, val: empty, consumed: 0 }
    }
    let blen = resp_parse_dec(buf, 1, eol)
    if blen < 0 {
        // null bulk $-1
        return RespBulkB { ok: 1, found: 0, val: empty, consumed: eol + 2 }
    }
    let start = eol + 2
    if bytes_len(buf) < start + blen + 2 {
        return RespBulkB { ok: 0, found: 0, val: empty, consumed: 0 }
    }
    return RespBulkB {
        ok: 1,
        found: 1,
        val: bytes_slice(buf, start, start + blen),
        consumed: start + blen + 2
    }
}
