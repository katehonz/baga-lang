// buf.baga — string builder (avoids quadratic nested concat in loops).
// Parts are joined once at the end. Universal for MD/HTML/templates/logs.

import "std/str/str.baga"

struct StrBuf {
    parts: Vec<str>
}

fn buf_new() -> StrBuf {
    return StrBuf { parts: vec_new() }
}

fn buf_push(b: StrBuf, s: str) -> StrBuf {
    vec_push(b.parts, s)
    return b
}

fn buf_push_i64(b: StrBuf, n: i64) -> StrBuf {
    vec_push(b.parts, int_to_str(n))
    return b
}

fn buf_len_parts(b: StrBuf) -> i64 {
    return vec_len(b.parts)
}

// Approximate character length of the joined result.
fn buf_len(b: StrBuf) -> i64 {
    let mut n: i64 = 0
    for i in 0..vec_len(b.parts) {
        n = n + len(vec_get(b.parts, i))
    }
    return n
}

fn buf_str(b: StrBuf) -> str {
    return str_join(b.parts, "")
}

fn buf_str_sep(b: StrBuf, sep: str) -> str {
    return str_join(b.parts, sep)
}

// Reset by replacing parts (return-updated).
fn buf_clear(b: StrBuf) -> StrBuf {
    return StrBuf { parts: vec_new() }
}
