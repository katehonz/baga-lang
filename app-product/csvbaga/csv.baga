// csv.baga — RFC 4180-ish CSV parse/stringify (comma, quotes, CRLF/LF).
// Table is row-major cells with fixed column count (short rows padded).

import "std/str/str.baga"
import "bufbaga/buf.baga"
import "std/os/os.baga"

struct CsvTable {
    cols: i64,
    cells: Vec<str>,
    ok: i64,
    err: str
}

fn csv_fail(msg: str) -> CsvTable {
    return CsvTable { cols: 0, cells: vec_new(), ok: 0, err: msg }
}

fn csv_ok(cols: i64, cells: Vec<str>) -> CsvTable {
    return CsvTable { cols: cols, cells: cells, ok: 1, err: "" }
}

fn csv_nrows(t: CsvTable) -> i64 {
    if t.cols <= 0 {
        return 0
    }
    return vec_len(t.cells) / t.cols
}

fn csv_get(t: CsvTable, row: i64, col: i64) -> str {
    if t.ok == 0 || t.cols <= 0 {
        return ""
    }
    if row < 0 || col < 0 || col >= t.cols {
        return ""
    }
    let i = row * t.cols + col
    if i >= vec_len(t.cells) {
        return ""
    }
    return vec_get(t.cells, i)
}

fn csv_version() -> str {
    return "0.1.0"
}

// Parse one field; returns [next_pos, field_text] via CsvField.
struct CsvField {
    pos: i64,
    text: str,
    ok: i64,
    err: str
}

fn csv_parse_field(src: str, start: i64) -> CsvField {
    let n = len(src)
    let mut i = start
    if i >= n {
        return CsvField { pos: i, text: "", ok: 1, err: "" }
    }
    // quoted field
    if char_at(src, i) == 34 {
        i = i + 1
        let mut b = buf_new()
        let mut running = 1
        while running == 1 {
            if i >= n {
                return CsvField { pos: i, text: "", ok: 0, err: "csv: unclosed quote" }
            }
            let c = char_at(src, i)
            if c == 34 {
                if i + 1 < n && char_at(src, i + 1) == 34 {
                    b = buf_push(b, "\"")
                    i = i + 2
                } else {
                    i = i + 1
                    running = 0
                }
            } else {
                b = buf_push(b, chr(c))
                i = i + 1
            }
        }
        return CsvField { pos: i, text: buf_str(b), ok: 1, err: "" }
    }
    // bare field until comma or line end
    let mut j = i
    while j < n {
        let c = char_at(src, j)
        if c == 44 || c == 10 || c == 13 {
            break
        }
        j = j + 1
    }
    return CsvField { pos: j, text: substr(src, i, j), ok: 1, err: "" }
}

fn csv_parse(src: str) -> CsvTable {
    let n = len(src)
    if n == 0 {
        return csv_ok(0, vec_new())
    }
    // strip UTF-8 BOM
    let mut s = src
    if n >= 3 && char_at(src, 0) == 239 && char_at(src, 1) == 187 && char_at(src, 2) == 191 {
        s = substr(src, 3, n)
    }
    // Flat: fields + row lengths (no nested Vec — language limit).
    let raw = vec_new()
    let row_lens = vec_new()
    let mut max_cols: i64 = 0
    let mut i: i64 = 0
    let sn = len(s)
    while i < sn {
        // trailing newline only → stop (no empty row)
        if i < sn {
            let c0 = char_at(s, i)
            if (c0 == 10 || c0 == 13) && vec_len(row_lens) > 0 {
                // consume trailing newlines at end
                if i + 1 >= sn || (c0 == 13 && i + 1 < sn && char_at(s, i + 1) == 10 && i + 2 >= sn) || (c0 == 10 && i + 1 >= sn) {
                    break
                }
            }
        }
        let mut ncol: i64 = 0
        let mut row_done = 0
        let row_start = vec_len(raw)
        while row_done == 0 {
            let f = csv_parse_field(s, i)
            if f.ok == 0 {
                return csv_fail(f.err)
            }
            vec_push(raw, f.text)
            ncol = ncol + 1
            i = f.pos
            if i >= sn {
                row_done = 1
            } else {
                let c = char_at(s, i)
                if c == 44 {
                    i = i + 1
                } else {
                    if c == 13 {
                        i = i + 1
                        if i < sn && char_at(s, i) == 10 {
                            i = i + 1
                        }
                        row_done = 1
                    } else {
                        if c == 10 {
                            i = i + 1
                            row_done = 1
                        } else {
                            return csv_fail(concat("csv: unexpected char at ", int_to_str(i)))
                        }
                    }
                }
            }
        }
        // empty line at EOF: single empty field and nothing else
        if ncol == 1 && vec_get(raw, row_start) == "" && i >= sn && vec_len(row_lens) > 0 {
            // drop: do not record row (field already on raw — overwrite by not advancing row_lens;
            // exclude from used by not adding row_lens and ignoring last field via row_start)
            // leave raw with extra field; pad loop only uses sum(row_lens)
        } else {
            vec_push(row_lens, ncol)
            if ncol > max_cols {
                max_cols = ncol
            }
        }
    }
    let cells = vec_new()
    let mut used: i64 = 0
    let mut r: i64 = 0
    while r < vec_len(row_lens) {
        let ncol = vec_get(row_lens, r)
        let mut c: i64 = 0
        while c < max_cols {
            if c < ncol {
                vec_push(cells, vec_get(raw, used + c))
            } else {
                vec_push(cells, "")
            }
            c = c + 1
        }
        used = used + ncol
        r = r + 1
    }
    return csv_ok(max_cols, cells)
}

// Does cell need quoting?
fn csv_needs_quote(s: str) -> bool {
    let mut i: i64 = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c == 44 || c == 34 || c == 10 || c == 13 {
            return true
        }
        i = i + 1
    }
    return false
}

fn csv_escape_field(s: str) -> str {
    if csv_needs_quote(s) == false {
        return s
    }
    let mut b = buf_new()
    b = buf_push(b, "\"")
    let mut i: i64 = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c == 34 {
            b = buf_push(b, "\"\"")
        } else {
            b = buf_push(b, chr(c))
        }
        i = i + 1
    }
    b = buf_push(b, "\"")
    return buf_str(b)
}

fn csv_stringify(t: CsvTable) -> str {
    if t.ok == 0 || t.cols <= 0 {
        return ""
    }
    let nr = csv_nrows(t)
    let mut b = buf_new()
    let mut r: i64 = 0
    while r < nr {
        let mut c: i64 = 0
        while c < t.cols {
            if c > 0 {
                b = buf_push(b, ",")
            }
            b = buf_push(b, csv_escape_field(csv_get(t, r, c)))
            c = c + 1
        }
        b = buf_push(b, "\r\n")
        r = r + 1
    }
    return buf_str(b)
}

// Build table from TSV (rows \\n, cells \\t) — bridge to office xlsx helpers.
fn csv_from_tsv(tsv: str) -> CsvTable {
    let lines = str_split(tsv, "\n")
    let mut n = vec_len(lines)
    if n > 0 {
        if vec_get(lines, n - 1) == "" {
            n = n - 1
        }
    }
    if n == 0 {
        return csv_ok(0, vec_new())
    }
    let mut max_cols: i64 = 0
    let mut r: i64 = 0
    while r < n {
        let cells = str_split(vec_get(lines, r), "\t")
        if vec_len(cells) > max_cols {
            max_cols = vec_len(cells)
        }
        r = r + 1
    }
    let out = vec_new()
    r = 0
    while r < n {
        let cells = str_split(vec_get(lines, r), "\t")
        let mut c: i64 = 0
        while c < max_cols {
            if c < vec_len(cells) {
                vec_push(out, vec_get(cells, c))
            } else {
                vec_push(out, "")
            }
            c = c + 1
        }
        r = r + 1
    }
    return csv_ok(max_cols, out)
}

fn csv_to_tsv(t: CsvTable) -> str {
    if t.ok == 0 || t.cols <= 0 {
        return ""
    }
    let nr = csv_nrows(t)
    let mut b = buf_new()
    let mut r: i64 = 0
    while r < nr {
        let mut c: i64 = 0
        while c < t.cols {
            if c > 0 {
                b = buf_push(b, "\t")
            }
            b = buf_push(b, csv_get(t, r, c))
            c = c + 1
        }
        if r + 1 < nr {
            b = buf_push(b, "\n")
        }
        r = r + 1
    }
    return buf_str(b)
}

// Row lines for xlsx_create_bytes (tab-separated).
fn csv_to_row_lines(t: CsvTable) -> Vec<str> {
    let lines = vec_new()
    if t.ok == 0 || t.cols <= 0 {
        return lines
    }
    let nr = csv_nrows(t)
    let mut r: i64 = 0
    while r < nr {
        let mut b = buf_new()
        let mut c: i64 = 0
        while c < t.cols {
            if c > 0 {
                b = buf_push(b, "\t")
            }
            b = buf_push(b, csv_get(t, r, c))
            c = c + 1
        }
        vec_push(lines, buf_str(b))
        r = r + 1
    }
    return lines
}

fn csv_read_path(path: str) -> CsvTable !IO {
    let b = read_file_bytes(path)?
    if bytes_len(b) == 0 {
        // empty or missing
        return csv_fail(concat("csv: empty or unreadable: ", path))
    }
    return csv_parse(str_of_bytes(b))
}

fn csv_write_path(path: str, t: CsvTable) -> i64 !IO {
    if t.ok == 0 {
        return -1
    }
    let s = csv_stringify(t)
    return write_file_bytes(path, bytes_of_str(s))?
}
