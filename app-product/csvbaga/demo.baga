// demo.baga — CSV CLI
//   baga … demo.baga rows file.csv
//   baga … demo.baga write out.csv <row…>   cells tab-separated per row arg

import "csv.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn main() -> i64 !IO {
    if arg_count() < 1 {
        eprintln("usage: demo.baga rows <file.csv>")
        eprintln("       demo.baga write <out.csv> <row1> <row2>…")
        return 1
    }
    let cmd = arg(0)
    if cmd == "rows" {
        if arg_count() < 2 {
            eprintln("usage: demo.baga rows <file.csv>")
            return 1
        }
        let t = csv_read_path(arg(1))?
        if t.ok == 0 {
            eprintln(t.err)
            return 1
        }
        print(concat(concat("cols=", int_to_str(t.cols)), concat(" rows=", int_to_str(csv_nrows(t)))))
        let mut r: i64 = 0
        while r < csv_nrows(t) {
            let mut line = ""
            let mut c: i64 = 0
            while c < t.cols {
                if c > 0 {
                    line = concat(line, " | ")
                }
                line = concat(line, csv_get(t, r, c))
                c = c + 1
            }
            print(line)
            r = r + 1
        }
        return 0
    }
    if cmd == "write" {
        if arg_count() < 3 {
            eprintln("usage: demo.baga write <out.csv> <row…>")
            return 1
        }
        let mut tsv = ""
        let mut i: i64 = 2
        while i < arg_count() {
            if i > 2 {
                tsv = concat(tsv, "\n")
            }
            tsv = concat(tsv, arg(i))
            i = i + 1
        }
        let t = csv_from_tsv(tsv)
        let rc = csv_write_path(arg(1), t)?
        if rc != 0 {
            eprintln("write failed")
            return 2
        }
        print(concat("wrote ", arg(1)))
        return 0
    }
    eprintln("unknown command")
    return 1
}
