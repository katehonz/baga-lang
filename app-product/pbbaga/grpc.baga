// grpc.baga — gRPC length-prefixed message framing (C5).
// Format: [1 byte compressed=0][4 byte BE length][protobuf payload]
// Transport (H2 + trailers) is left to the host; this is the message layer.
// B1: decode outcomes are L3 sum types (no ok:i64 stand-ins).

import "pb.baga"
import "std/str/str.baga"

// ---------- frame decode (L3) ----------

struct GrpcFrame {
    compressed: i64,
    payload: bytes
}

// Unique variant names (A1: other packages may use Ok/Err too).
enum GrpcMsg {
    GFrame(GrpcFrame),
    GBad
}

fn grpc_encode(msg: bytes) -> bytes {
    let n = bytes_len(msg)
    let mut f = bytes_new(0)
    f = bytes_push(f, 0)   // not compressed
    f = bytes_push(f, (n >> 24) & 255)
    f = bytes_push(f, (n >> 16) & 255)
    f = bytes_push(f, (n >> 8) & 255)
    f = bytes_push(f, n & 255)
    return bytes_concat(f, msg)
}

fn grpc_decode(frame: bytes) -> GrpcMsg {
    if bytes_len(frame) < 5 {
        return GBad
    }
    let comp = bytes_at(frame, 0)
    let n = ((bytes_at(frame, 1) & 255) << 24)
        | ((bytes_at(frame, 2) & 255) << 16)
        | ((bytes_at(frame, 3) & 255) << 8)
        | (bytes_at(frame, 4) & 255)
    if n < 0 || 5 + n > bytes_len(frame) {
        return GBad
    }
    return GFrame(GrpcFrame {
        compressed: comp,
        payload: bytes_slice(frame, 5, 5 + n)
    })
}

// ---------- server/client streaming: concatenate length-prefixed messages ----------

// Append one message frame onto an existing stream buffer.
fn grpc_stream_append(stream: bytes, msg: bytes) -> bytes {
    return bytes_concat(stream, grpc_encode(msg))
}

// One complete frame starting at `pos`, or StreamEnd (EOF / incomplete).
struct GrpcStreamFrame {
    compressed: i64,
    payload: bytes,
    next: i64        // byte offset after this frame
}

enum GrpcStreamRead {
    StreamOk(GrpcStreamFrame),
    StreamEnd
}

fn grpc_stream_next(stream: bytes, pos: i64) -> GrpcStreamRead {
    if pos < 0 || pos + 5 > bytes_len(stream) {
        return StreamEnd
    }
    let comp = bytes_at(stream, pos)
    let n = ((bytes_at(stream, pos + 1) & 255) << 24)
        | ((bytes_at(stream, pos + 2) & 255) << 16)
        | ((bytes_at(stream, pos + 3) & 255) << 8)
        | (bytes_at(stream, pos + 4) & 255)
    if n < 0 || pos + 5 + n > bytes_len(stream) {
        return StreamEnd
    }
    return StreamOk(GrpcStreamFrame {
        compressed: comp,
        payload: bytes_slice(stream, pos + 5, pos + 5 + n),
        next: pos + 5 + n
    })
}

fn grpc_stream_ended(r: GrpcStreamRead) -> i64 {
    return match r {
        StreamEnd => 1,
        StreamOk(f) => 0,
    }
}

fn grpc_stream_pos(r: GrpcStreamRead) -> i64 {
    return match r {
        StreamEnd => 0,
        StreamOk(f) => f.next,
    }
}

// Count complete frames in a stream buffer.
fn grpc_stream_count(stream: bytes) -> i64 {
    let mut pos: i64 = 0
    let mut n: i64 = 0
    let mut more: i64 = 1
    while more == 1 {
        let r = grpc_stream_next(stream, pos)
        if grpc_stream_ended(r) == 1 {
            more = 0
        } else {
            n = n + 1
            pos = grpc_stream_pos(r)
        }
    }
    return n
}

// Server-streaming Hello: emit N HelloReply messages for one request.
fn hello_stream_replies(name: str, count: i64) -> bytes {
    let mut stream = bytes_new(0)
    let mut i: i64 = 0
    let mut c = count
    if c < 1 {
        c = 1
    }
    if c > 64 {
        c = 64
    }
    while i < c {
        let msg = concat(concat(concat(concat("Здравей, ", name), " #"), int_to_str(i + 1)), "")
        let rep = hello_reply_encode(msg)
        stream = grpc_stream_append(stream, rep)
        i = i + 1
    }
    return stream
}

fn hello_req_name(hr: HelloReq) -> str {
    return match hr {
        HelloOk(b) => b.name,
        HelloBad => "?",
    }
}

fn hello_req_n(hr: HelloReq) -> i64 {
    return match hr {
        HelloOk(b) => b.n,
        HelloBad => 0,
    }
}

fn grpc_stream_payload(r: GrpcStreamRead) -> bytes {
    return match r {
        StreamOk(f) => f.payload,
        StreamEnd => bytes_new(0),
    }
}

// Bidirectional streaming (message layer): for each HelloRequest frame in
// `inbound`, append one HelloReply. Transport is still a single request/
// response body pair (or half-close H2 stream) — this is the frame algebra.
fn hello_bidi(inbound: bytes) -> bytes {
    let mut out = bytes_new(0)
    let mut pos: i64 = 0
    let mut more: i64 = 1
    let mut i: i64 = 0
    while more == 1 {
        let r = grpc_stream_next(inbound, pos)
        if grpc_stream_ended(r) == 1 {
            more = 0
        } else {
            let hr = hello_request_decode(grpc_stream_payload(r))
            let name = hello_req_name(hr)
            let n = hello_req_n(hr)
            let msg = concat(concat(concat(concat(concat("echo ", name), " n="), int_to_str(n)), " #"), int_to_str(i + 1))
            out = grpc_stream_append(out, hello_reply_encode(msg))
            pos = grpc_stream_pos(r)
            i = i + 1
            if i > 64 {
                more = 0
            }
        }
    }
    return out
}

// Build a client bidi upload: N HelloRequest frames.
fn hello_bidi_requests(base_name: str, count: i64) -> bytes {
    let mut stream = bytes_new(0)
    let mut i: i64 = 0
    let mut c = count
    if c < 1 { c = 1 }
    if c > 64 { c = 64 }
    while i < c {
        let name = concat(concat(base_name, "-"), int_to_str(i))
        stream = grpc_stream_append(stream, hello_request_encode(name, i + 1))
        i = i + 1
    }
    return stream
}

// Trailer helpers (HTTP/2 trailers or response headers in probes).
fn grpc_status_ok() -> str {
    return "0"
}

fn grpc_status_line(code: i64, msg: str) -> str {
    // "grpc-status: N\r\ngrpc-message: …\r\n"
    let mut s = concat(concat("grpc-status: ", int_to_str(code)), "\r\n")
    if msg != "" {
        s = concat(s, concat(concat("grpc-message: ", msg), "\r\n"))
    }
    return s
}

// Content-Type for unary gRPC.
fn grpc_content_type() -> str {
    return "application/grpc"
}

// ---------- example message: HelloRequest / HelloReply ----------
// message HelloRequest { string name = 1; int64 n = 2; }
// message HelloReply   { string message = 1; }

fn hello_request_encode(name: str, n: i64) -> bytes {
    let mut b = bytes_new(0)
    b = pb_field_string(b, 1, name)
    b = pb_field_varint(b, 2, n)
    return b
}

struct HelloBody {
    name: str,
    n: i64
}

enum HelloReq {
    HelloOk(HelloBody),
    HelloBad
}

fn hello_request_decode(data: bytes) -> HelloReq {
    let mut name = ""
    let mut n: i64 = 0
    let mut r = pb_reader(data)
    let mut more: i64 = 1
    while more == 1 {
        let t = pb_next(r)
        if t.ok == 0 {
            more = 0
        } else {
            r = PbReader { data: r.data, pos: t.pos, ok: 1 }
            if t.field == 1 && t.wire == PB_LEN() {
                let s = pb_take_string(r)
                if s.ok == 0 {
                    return HelloBad
                }
                name = s.s
                r = PbReader { data: r.data, pos: s.pos, ok: 1 }
            } else {
                if t.field == 2 && t.wire == PB_VARINT() {
                    let v = pb_get_uvarint(r.data, r.pos)
                    if v.ok == 0 {
                        return HelloBad
                    }
                    n = v.val
                    r = PbReader { data: r.data, pos: v.pos, ok: 1 }
                } else {
                    r = pb_skip(r, t.wire)
                    if r.ok == 0 {
                        return HelloBad
                    }
                }
            }
        }
    }
    return HelloOk(HelloBody { name: name, n: n })
}

fn hello_reply_encode(message: str) -> bytes {
    let mut b = bytes_new(0)
    b = pb_field_string(b, 1, message)
    return b
}

// ReplyOk payload is the message string.
enum HelloRep {
    ReplyOk(str),
    ReplyBad
}

fn hello_reply_decode(data: bytes) -> HelloRep {
    let mut message = ""
    let mut r = pb_reader(data)
    let mut more: i64 = 1
    while more == 1 {
        let t = pb_next(r)
        if t.ok == 0 {
            more = 0
        } else {
            r = PbReader { data: r.data, pos: t.pos, ok: 1 }
            if t.field == 1 && t.wire == PB_LEN() {
                let s = pb_take_string(r)
                if s.ok == 0 {
                    return ReplyBad
                }
                message = s.s
                r = PbReader { data: r.data, pos: s.pos, ok: 1 }
            } else {
                r = pb_skip(r, t.wire)
                if r.ok == 0 {
                    return ReplyBad
                }
            }
        }
    }
    return ReplyOk(message)
}

// Unary "RPC" pure: Hello(name,n) → "Здравей, {name}×{n}"
fn hello_rpc(name: str, n: i64) -> str {
    let req = hello_request_encode(name, n)
    let frame = grpc_encode(req)
    let g = grpc_decode(frame)
    return match g {
        GBad => "",
        GFrame(fr) => match hello_request_decode(fr.payload) {
            HelloBad => "",
            HelloOk(body) => concat(concat(concat("Здравей, ", body.name), "×"), int_to_str(body.n)),
        },
    }
}
