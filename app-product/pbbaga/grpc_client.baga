// grpc_client.baga — unary gRPC client over HTTP/1.1 (binary body).
// Production shape vs Go grpc.Dial + Invoke: status/metadata/timeout wired,
// outcome is an L3 sum type (CallOk / CallErr), not ok:i64 stand-in.

import "grpc.baga"
import "statusbaga/status.baga"
import "mdtbaga/mdt.baga"
import "std/net/tcp.baga"
import "std/str/str.baga"

// Successful unary response (payload already unframed).
struct GrpcCallOk {
    payload: bytes,
    status_code: i64,
    message: str,
    headers: Metadata
}

// L3 sum Result — unique variant names (global uniqueness rule).
enum GrpcCall {
    CallOk(GrpcCallOk),
    CallErr(Status)
}

// Last call outcome stored on a handle (sum enum as struct field).
struct GrpcClient {
    host: str,
    port: i64,
    timeout_s: i64,
    last: GrpcCall
}

fn grpc_client(host: str, port: i64, timeout_s: i64) -> GrpcClient {
    return GrpcClient {
        host: host,
        port: port,
        timeout_s: timeout_s,
        last: CallErr(status_error(GRPC_UNAVAILABLE(), "not called"))
    }
}

// Case-insensitive header line scan: "Name: value\r\n" → value or "".
fn grpc_hdr_get(head: str, name: str) -> str {
    let want = concat(name, ":")
    let mut i: i64 = 0
    let n = len(head)
    let wn = len(want)
    while i < n {
        // start of line
        let mut j = i
        while j < n && char_at(head, j) != 13 {
            j = j + 1
        }
        let line = substr(head, i, j)
        if len(line) >= wn {
            let mut same: i64 = 1
            let mut k: i64 = 0
            while k < wn && same == 1 {
                let a = char_at(line, k)
                let b = char_at(want, k)
                // fold A-Z
                let mut aa = a
                if aa >= 65 && aa <= 90 { aa = aa + 32 }
                let mut bb = b
                if bb >= 65 && bb <= 90 { bb = bb + 32 }
                if aa != bb { same = 0 }
                k = k + 1
            }
            if same == 1 {
                let mut p = wn
                while p < len(line) && char_at(line, p) == 32 {
                    p = p + 1
                }
                return substr(line, p, len(line))
            }
        }
        if j + 1 < n && char_at(head, j) == 13 && char_at(head, j + 1) == 10 {
            i = j + 2
        } else {
            i = j + 1
        }
    }
    return ""
}

// Unary call: POST method_path with application/grpc body = length-prefixed frame.
// Outbound MD (non-reserved) + optional grpc-timeout become request headers.
// H1 places grpc-status on response headers (same as our grpc_write_response).
fn grpc_call_unary(
    host: str,
    port: i64,
    method_path: str,
    req_frame: bytes,
    timeout_s: i64,
    md: Metadata,
    timeout_ms: i64
) -> GrpcCall !Net !IO {
    let empty = bytes_new(0)
    let fd = tcp_connect_to(host, port, timeout_s)?
    if fd < 0 {
        return CallErr(status_error(GRPC_UNAVAILABLE(), "connect failed"))
    }
    tcp_set_timeouts(fd, timeout_s)?

    let mut hdr = concat(concat("POST ", method_path), " HTTP/1.1\r\n")
    hdr = concat(hdr, concat(concat("Host: ", host), "\r\n"))
    hdr = concat(hdr, "Content-Type: application/grpc\r\n")
    hdr = concat(hdr, "Te: trailers\r\n")
    if timeout_ms > 0 {
        hdr = concat(hdr, concat(concat("grpc-timeout: ", grpc_timeout_encode_ms(timeout_ms)), "\r\n"))
    }
    for i in 0..mdt_len(md) {
        let k = mdt_key_at(md, i)
        if mdt_is_reserved(k) == 0 {
            hdr = concat(hdr, concat(concat(concat(k, ": "), mdt_val_at(md, i)), "\r\n"))
        }
    }
    hdr = concat(hdr, concat(concat("Content-Length: ", int_to_str(bytes_len(req_frame))), "\r\n"))
    hdr = concat(hdr, "Connection: close\r\n\r\n")

    if tcp_write(fd, hdr)? != 0 {
        tcp_close(fd)?
        return CallErr(status_error(GRPC_UNAVAILABLE(), "write headers failed"))
    }
    if bytes_len(req_frame) > 0 {
        if tcp_write_bytes(fd, req_frame)? != 0 {
            tcp_close(fd)?
            return CallErr(status_error(GRPC_UNAVAILABLE(), "write body failed"))
        }
    }

    let mut raw = bytes_new(0)
    let mut rounds: i64 = 0
    while rounds < 64 {
        let chunk = tcp_read_bytes(fd, 4096)?
        if bytes_len(chunk) == 0 {
            rounds = 64
        } else {
            raw = bytes_concat(raw, chunk)
            rounds = rounds + 1
        }
    }
    tcp_close(fd)?

    // split headers / body
    let mut sep: i64 = 0 - 1
    let mut i: i64 = 0
    while i + 3 < bytes_len(raw) {
        if bytes_at(raw, i) == 13 && bytes_at(raw, i + 1) == 10 &&
           bytes_at(raw, i + 2) == 13 && bytes_at(raw, i + 3) == 10 {
            sep = i
            i = bytes_len(raw)
        } else {
            i = i + 1
        }
    }
    if sep < 0 {
        return CallErr(status_error(GRPC_INTERNAL(), "no header separator"))
    }
    let head = str_of_bytes(bytes_slice(raw, 0, sep))
    let body = bytes_slice(raw, sep + 4, bytes_len(raw))

    // HTTP status line
    if str_find(head, "200") < 0 && str_find(head, "HTTP/1.1 200") < 0 {
        // still may carry grpc-status (some proxies)
        let _z = 0
    }

    let gs = grpc_hdr_get(head, "grpc-status")
    let gm = grpc_hdr_get(head, "grpc-message")
    let mut code: i64 = 0
    if gs != "" {
        code = parse_int(gs)
    } else {
        // no trailer → treat as OK if body decodes; else Unknown
        code = GRPC_OK()
    }

    let mut out_md = mdt_new()
    // surface a few useful headers
    let rid = grpc_hdr_get(head, "x-request-id")
    if rid != "" {
        out_md = mdt_append(out_md, "x-request-id", rid)
    }

    if code != GRPC_OK() {
        let mut msg = gm
        if msg == "" {
            msg = status_code_name(code)
        }
        return CallErr(status_error(code, msg))
    }

    let g = grpc_decode(body)
    if g.ok == 0 {
        // empty body with status 0 is legal for some methods; still fail Hello-style
        if bytes_len(body) == 0 {
            return CallOk(GrpcCallOk {
                payload: empty,
                status_code: code,
                message: gm,
                headers: out_md
            })
        }
        return CallErr(status_error(GRPC_INTERNAL(), "bad response frame"))
    }

    return CallOk(GrpcCallOk {
        payload: g.payload,
        status_code: code,
        message: gm,
        headers: out_md
    })
}

// Client handle: perform call and store last outcome on the struct field.
fn grpc_client_call(
    c: GrpcClient,
    method_path: str,
    req_frame: bytes,
    md: Metadata,
    timeout_ms: i64
) -> GrpcClient !Net !IO {
    let r = grpc_call_unary(c.host, c.port, method_path, req_frame, c.timeout_s, md, timeout_ms)?
    return GrpcClient {
        host: c.host,
        port: c.port,
        timeout_s: c.timeout_s,
        last: r
    }
}

fn grpc_client_last_ok(c: GrpcClient) -> i64 {
    return match c.last {
        CallOk(o) => 1,
        CallErr(s) => 0,
    }
}

fn grpc_client_last_payload(c: GrpcClient) -> bytes {
    return match c.last {
        CallOk(o) => o.payload,
        CallErr(s) => bytes_new(0),
    }
}

fn grpc_client_last_status(c: GrpcClient) -> Status {
    return match c.last {
        CallOk(o) => status_ok(),
        CallErr(s) => s,
    }
}
