// demo.baga — protobuf + gRPC unary / stream / bidi frames.

import "grpc.baga"
import "std/str/str.baga"

fn main() {
    let req = hello_request_encode("багатуре", 3)
    print(concat("HelloRequest hex: ", hex_encode(req)))
    let frame = grpc_encode(req)
    print(concat("gRPC frame hex:  ", hex_encode(frame)))
    let g = grpc_decode(frame)
    let hr = hello_request_decode(g.payload)
    print(concat(concat("decoded name=", hr.name), concat(" n=", int_to_str(hr.n))))
    let reply = hello_rpc("багатуре", 3)
    print(concat("rpc → ", reply))
    let rb = hello_reply_encode(reply)
    print(concat("HelloReply hex:  ", hex_encode(rb)))

    let ss = hello_stream_replies("stream", 3)
    print(concat("server-stream frames=", int_to_str(grpc_stream_count(ss))))

    let up = hello_bidi_requests("bidi", 2)
    let down = hello_bidi(up)
    print(concat("bidi up/down frames=", concat(int_to_str(grpc_stream_count(up)), concat("/", int_to_str(grpc_stream_count(down))))))
    let r0 = grpc_stream_next(down, 0)
    let h0 = hello_reply_decode(r0.payload)
    print(concat("bidi[0] → ", h0.message))
}
