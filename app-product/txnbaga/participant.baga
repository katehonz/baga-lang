// participant.baga — 2PC participant with local MVCC store + prepare locks.

import "msg.baga"
import "mvcc.baga"
import "rules.baga"
import "std/str/str.baga"

// Prepared write set for one tx: up to 2 keys (k2 < 0 → single key).
struct Prep {
    active: i64,
    tx: i64,
    k1: i64,
    v1: i64,
    k2: i64,
    v2: i64
}

// ctx = cell2(id, inbox)
fn tpc_participant(ctx: i64) -> i64 !Par {
    let id = cell2_0(ctx)
    let inbox = cell2_1(ctx)
    let store = mvcc_new()
    // locks: key → tx holding prepare lock (-1 free encoded as missing)
    let locks: Map<i64, i64> = map_new()
    let mut prep = Prep {
        active: 0, tx: -1, k1: 0, v1: 0, k2: -1, v2: 0
    }

    let mut running: i64 = 1
    while running == 1 {
        let r = chan_recv_timeout(inbox, 500)
        let st = cell2_0(r)
        if st == 2 {
            running = 0
        } else {
            if st == 1 {
                let m = cell2_1(r)
                let mt = msg_type(m)

                if mt == MT_STOP() {
                    running = 0
                }

                if mt == MT_GET() {
                    let key = get_key(m)
                    let rts = get_ts(m)
                    let rep = get_reply(m)
                    let g = mvcc_get(store, key, rts)
                    chan_send(rep, msg_get_rep(g.found, g.val, g.ts))
                }

                if mt == MT_PREPARE() {
                    let tx = prep_tx(m)
                    let rep = prep_reply(m)
                    let k1 = prep_k1(m)
                    let v1 = prep_v1(m)
                    let k2 = prep_k2(m)
                    let v2 = prep_v2(m)
                    let mut yes: i64 = 1

                    // already prepared for another tx?
                    if prep.active == 1 && prep.tx != tx {
                        yes = 0
                    }

                    // lock checks
                    if yes == 1 {
                        if map_has(locks, k1) == 1 {
                            if lock_conflict(map_get(locks, k1), tx) == 1 {
                                yes = 0
                            }
                        }
                    }
                    if yes == 1 && k2 >= 0 {
                        if map_has(locks, k2) == 1 {
                            if lock_conflict(map_get(locks, k2), tx) == 1 {
                                yes = 0
                            }
                        }
                    }

                    if yes == 1 {
                        map_set(locks, k1, tx)
                        if k2 >= 0 {
                            map_set(locks, k2, tx)
                        }
                        prep = Prep {
                            active: 1, tx: tx, k1: k1, v1: v1, k2: k2, v2: v2
                        }
                    }
                    chan_send(rep, msg_vote(yes, tx, id))
                }

                if mt == MT_COMMIT() {
                    let tx = ca_tx(m)
                    let cts = ca_ts(m)
                    let rep = ca_reply(m)
                    if prep.active == 1 && prep.tx == tx {
                        mvcc_put_version(store, prep.k1, prep.v1, cts)
                        if prep.k2 >= 0 {
                            mvcc_put_version(store, prep.k2, prep.v2, cts)
                        }
                        map_del(locks, prep.k1)
                        if prep.k2 >= 0 {
                            map_del(locks, prep.k2)
                        }
                        prep = Prep {
                            active: 0, tx: -1, k1: 0, v1: 0, k2: -1, v2: 0
                        }
                        // keep store clock ahead
                        if cts >= store.next_ts {
                            store.next_ts = cts + 1
                        }
                    }
                    chan_send(rep, msg_ack(tx, id))
                }

                if mt == MT_ABORT() {
                    let tx = ca_tx(m)
                    let rep = ca_reply(m)
                    if prep.active == 1 && prep.tx == tx {
                        map_del(locks, prep.k1)
                        if prep.k2 >= 0 {
                            map_del(locks, prep.k2)
                        }
                        prep = Prep {
                            active: 0, tx: -1, k1: 0, v1: 0, k2: -1, v2: 0
                        }
                    }
                    chan_send(rep, msg_ack(tx, id))
                }
            }
        }
    }
    return 0
}
