// participant.baga — 2PC participant with local MVCC store + prepare locks.
// B4.3: multiple concurrent PREPARE allowed when write-sets do not lock-conflict.

import "msg.baga"
import "mvcc.baga"
import "rules.baga"
import "std/str/str.baga"

// Prepared write set for one tx: up to 2 keys (k2 < 0 → single key).
struct Prep {
    active: i64,
    tx: i64,
    k1: i64,
    v1: i64,
    k2: i64,
    v2: i64
}

// ctx = cell2(id, inbox)
fn tpc_participant(ctx: i64) -> i64 !Par {
    let id = cell2_0(ctx)
    let inbox = cell2_1(ctx)
    let store = mvcc_new()
    // locks: key → tx holding prepare lock
    let locks: Map<i64, i64> = map_new()
    // active prepares by tx id (multiple concurrent non-conflicting)
    let preps: Map<i64, Prep> = map_new()

    let mut running: i64 = 1
    while running == 1 {
        let r = chan_recv_timeout(inbox, 500)
        let st = cell2_0(r)
        if st == 2 {
            running = 0
        } else {
            if st == 1 {
                let m = cell2_1(r)
                let mt = msg_type(m)

                if mt == MT_STOP() {
                    running = 0
                }

                if mt == MT_GET() {
                    let key = get_key(m)
                    let rts = get_ts(m)
                    let rep = get_reply(m)
                    let g = mvcc_get(store, key, rts)
                    chan_send(rep, msg_get_rep(g.found, g.val, g.ts))
                }

                if mt == MT_PREPARE() {
                    let tx = prep_tx(m)
                    let rep = prep_reply(m)
                    let k1 = prep_k1(m)
                    let v1 = prep_v1(m)
                    let k2 = prep_k2(m)
                    let v2 = prep_v2(m)
                    let mut yes: i64 = 1

                    // already prepared this tx? idempotent yes
                    if map_has(preps, tx) == 1 {
                        yes = 1
                    } else {
                        // lock checks
                        if map_has(locks, k1) == 1 {
                            if lock_conflict(map_get(locks, k1), tx) == 1 {
                                yes = 0
                            }
                        }
                        if yes == 1 && k2 >= 0 {
                            if map_has(locks, k2) == 1 {
                                if lock_conflict(map_get(locks, k2), tx) == 1 {
                                    yes = 0
                                }
                            }
                        }

                        if yes == 1 {
                            map_set(locks, k1, tx)
                            if k2 >= 0 {
                                map_set(locks, k2, tx)
                            }
                            map_set(preps, tx, Prep {
                                active: 1, tx: tx, k1: k1, v1: v1, k2: k2, v2: v2
                            })
                        }
                    }
                    chan_send(rep, msg_vote(yes, tx, id))
                }

                if mt == MT_COMMIT() {
                    let tx = ca_tx(m)
                    let cts = ca_ts(m)
                    let rep = ca_reply(m)
                    if map_has(preps, tx) == 1 {
                        let p = map_get(preps, tx)
                        mvcc_put_version(store, p.k1, p.v1, cts)
                        if p.k2 >= 0 {
                            mvcc_put_version(store, p.k2, p.v2, cts)
                        }
                        map_del(locks, p.k1)
                        if p.k2 >= 0 {
                            map_del(locks, p.k2)
                        }
                        map_del(preps, tx)
                        if cts >= store.next_ts {
                            store.next_ts = cts + 1
                        }
                    }
                    chan_send(rep, msg_ack(tx, id))
                }

                if mt == MT_ABORT() {
                    let tx = ca_tx(m)
                    let rep = ca_reply(m)
                    if map_has(preps, tx) == 1 {
                        let p = map_get(preps, tx)
                        map_del(locks, p.k1)
                        if p.k2 >= 0 {
                            map_del(locks, p.k2)
                        }
                        map_del(preps, tx)
                    }
                    chan_send(rep, msg_ack(tx, id))
                }
            }
        }
    }
    return 0
}
