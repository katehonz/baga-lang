// query.baga — URL query / form parsing and building. Pure.
// Uses application/x-www-form-urlencoded space-as-plus on decode.

import "std/str/str.baga"
import "std/net/url.baga"

struct Query {
    keys: Vec<str>,
    vals: Vec<str>
}

fn query_new() -> Query {
    return Query { keys: vec_new(), vals: vec_new() }
}

fn query_set(q: Query, k: str, v: str) -> Query {
    let mut i: i64 = 0
    while i < vec_len(q.keys) {
        if vec_get(q.keys, i) == k {
            vec_set(q.vals, i, v)
            return q
        }
        i = i + 1
    }
    vec_push(q.keys, k)
    vec_push(q.vals, v)
    return q
}

fn query_get(q: Query, k: str) -> str {
    for i in 0..vec_len(q.keys) {
        if vec_get(q.keys, i) == k {
            return vec_get(q.vals, i)
        }
    }
    return ""
}

fn query_has(q: Query, k: str) -> i64 {
    for i in 0..vec_len(q.keys) {
        if vec_get(q.keys, i) == k {
            return 1
        }
    }
    return 0
}

// Missing key is !NotFound(k) (M20) — not the empty-string sentinel.
fn query_require(q: Query, k: str) -> str !NotFound(str) {
    if query_has(q, k) == 0 {
        raise !NotFound(k)
    }
    return query_get(q, k)
}

fn query_i64(q: Query, k: str, def: i64) -> i64 {
    if query_has(q, k) == 0 {
        return def
    }
    return parse_int(query_get(q, k))
}

// Decode form space: '+' → ' ' then percent-decode.
fn query_decode_val(s: str) -> str {
    let mut t = ""
    for i in 0..len(s) {
        let c = char_at(s, i)
        if c == 43 {
            t = concat(t, " ")
        } else {
            t = concat(t, substr(s, i, i + 1))
        }
    }
    return url_decode(t)
}

// Parse "a=1&b=hello%20x" (leading '?' stripped if present).
fn query_parse(raw: str) -> Query {
    let mut s = raw
    if len(s) > 0 && char_at(s, 0) == 63 {
        s = substr(s, 1, len(s))
    }
    let mut q = query_new()
    if s == "" {
        return q
    }
    let parts = str_split(s, "&")
    for i in 0..vec_len(parts) {
        let p = vec_get(parts, i)
        if p == "" {
            // skip
            let _z = 0
        } else {
            let eq = str_find(p, "=")
            if eq < 0 {
                q = query_set(q, query_decode_val(p), "")
            } else {
                let k = query_decode_val(substr(p, 0, eq))
                let v = query_decode_val(substr(p, eq + 1, len(p)))
                q = query_set(q, k, v)
            }
        }
    }
    return q
}

// Encode as application/x-www-form-urlencoded (space → %20 via url_encode).
fn query_encode(q: Query) -> str {
    let mut out = ""
    for i in 0..vec_len(q.keys) {
        if i > 0 {
            out = concat(out, "&")
        }
        out = concat(out, url_encode(vec_get(q.keys, i)))
        out = concat(out, "=")
        out = concat(out, url_encode(vec_get(q.vals, i)))
    }
    return out
}

// Extract query from a full path ("/x?a=1" → parse "a=1").
fn query_from_path(path: str) -> Query {
    let q = str_find(path, "?")
    if q < 0 {
        return query_new()
    }
    return query_parse(substr(path, q + 1, len(path)))
}
