// server.baga — demo JWT auth server. First consumer of httpdbaga/http.baga.
// Run:  ./baga app-product/jwtbaga/server.baga            (listens on :8080)
//       PORT=9000 JWT_SECRET=s3cret ./baga app-product/jwtbaga/server.baga
// Concurrent by default: go_bg per connection (set BAGA_SYNC=1 for single-threaded).
//
// Routes:
//   GET /token?sub=NAME          -> 200 {"token":"<jwt>"}  (payload {"sub":NAME})
//   GET /verify    (Bearer tok)  -> 200 {"valid":true,"sub":"..."} | 401 {"valid":false}
//   GET /protected (Bearer tok)  -> 200 {"secret":"...","sub":"..."} | 401

import "httpdbaga/http.baga"
import "jwt.baga"
import "std/os/os.baga"
import "std/str/str.baga"

// "Bearer abc" -> "abc"; "" when the header is not a Bearer token.
fn bearer(auth: str) -> str {
    if str_starts_with(auth, "Bearer ") {
        return substr(auth, 7, len(auth))
    }
    return ""
}

fn resolve_secret() -> str !IO {
    if env("JWT_SECRET") != "" {
        return env("JWT_SECRET")?
    }
    return "baga-secret"
}

fn handle(fd: i64, secret: str) -> i64 !IO !Net {
    let req = http_read_request(fd)?
    let method = http_method(req)

    if method == "GET" && str_starts_with(http_path_only(req), "/token") {
        let sub = http_query_param(req, "sub")
        let payload = concat(concat("{\"sub\":", json_escape(sub)), "}")
        let token = jwt_encode(secret, payload)
        let body = concat(concat("{\"token\":\"", token), "\"}")
        return http_respond(fd, http_json_response(200, body))?
    }

    if method == "GET" && http_path_only(req) == "/verify" {
        let token = bearer(http_header(req, "Authorization"))
        // HS256 + header.alg check (rejects alg:none)
        if token != "" && jwt_verify_hs256(secret, token) == 1 {
            let sub = jwt_claim_str(token, "sub")
            let body = concat(concat("{\"valid\":true,\"sub\":\"", sub), "\"}")
            return http_respond(fd, http_json_response(200, body))?
        }
        return http_respond(fd, http_json_response(401, "{\"valid\":false}"))?
    }

    if method == "GET" && http_path_only(req) == "/protected" {
        let token = bearer(http_header(req, "Authorization"))
        if token != "" && jwt_verify_hs256(secret, token) == 1 {
            let sub = jwt_claim_str(token, "sub")
            let body = concat(concat("{\"secret\":\"the cake is a lie\",\"sub\":\"", sub), "\"}")
            return http_respond(fd, http_json_response(200, body))?
        }
        return http_respond(fd, http_json_response(401, "{\"error\":\"unauthorized\"}"))?
    }

    return http_respond(fd, http_json_response(404, "{\"error\":\"not found\"}"))?
}

// go_bg worker: secret re-read from env (or default) so the handle stays fn(i64).
fn handle_conn(fd: i64) -> i64 !IO !Net {
    let secret = resolve_secret()?
    handle(fd, secret)?
    tcp_close(fd)?
    return 0
}

fn main() -> i64 !Net !IO !Par {
    let mut port: i64 = 8080
    if env("PORT") != "" {
        port = parse_int(env("PORT"))
    }
    // warm default / validate env once
    let _secret = resolve_secret()?
    let sync = env("BAGA_SYNC")
    let listener = tcp_listen(port)?
    if sync == "1" {
        print(concat("jwtbaga listening on :", concat(int_to_str(port), " (sync)")))
    } else {
        print(concat("jwtbaga listening on :", concat(int_to_str(port), " (go_bg per connection)")))
    }
    while true {
        let fd = tcp_accept(listener)?
        if sync == "1" {
            handle(fd, _secret)?
            tcp_close(fd)?
        } else {
            go_bg(handle_conn, fd)
        }
    }
    return 0
}
