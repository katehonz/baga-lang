// jwt.baga — JWT (RFC 7519) HS256 signer + verifier. Pure Baga.
// Built on std/ crypto (hmac_sha256_b, ct_eq_b), bytes (base64url), json, str.
//
// HS256 only. alg:none is never produced and never accepted. Signatures are
// arbitrary 32-byte values that may contain 0x00 — handled as native `bytes`,
// compared with ct_eq_b, never coerced to str.

import "std/crypto/hmac.baga"
import "std/crypto/ct.baga"
import "std/bytes/bytes.baga"
import "std/json/json.baga"
import "std/str/str.baga"

// ---------- low-level sign / verify ----------

// base64url(HMAC-SHA256(key, msg)).
fn jwt_sign(key: str, msg: str) -> str {
    return base64url_encode_b(hmac_sha256_b(bytes_of_str(key), bytes_of_str(msg)))
}

// Constant-time: decode signature to bytes and compare against a fresh MAC.
fn jwt_verify(key: str, msg: str, sig_b64url: str) -> bool {
    let expected = hmac_sha256_b(bytes_of_str(key), bytes_of_str(msg))
    let got = base64url_decode_b(sig_b64url)
    return ct_eq_b(expected, got)
}

// ---------- token encode / decode ----------

// header.payload.signature over a caller-supplied JSON payload string.
fn jwt_encode(key: str, payload_json: str) -> str {
    let h = base64url_encode_b(bytes_of_str("{\"alg\":\"HS256\",\"typ\":\"JWT\"}"))
    let p = base64url_encode_b(bytes_of_str(payload_json))
    let signing = concat(concat(h, "."), p)
    let sig = jwt_sign(key, signing)
    return concat(concat(signing, "."), sig)
}

// The payload JSON on a valid token; "" on any failure (bad shape, bad sig).
fn jwt_decode(key: str, token: str) -> str {
    let parts = str_split(token, ".")
    if vec_len(parts) != 3 {
        return ""
    }
    let signing = concat(concat(vec_get(parts, 0), "."), vec_get(parts, 1))
    if !jwt_verify(key, signing, vec_get(parts, 2)) {
        return ""
    }
    // Payload is JSON text — no embedded NUL, so str_of_bytes is safe.
    return str_of_bytes(base64url_decode_b(vec_get(parts, 1)))
}

// Raw JSON text of a claim (string claims keep their quotes, numbers are bare);
// "" when absent or the payload does not parse. Does NOT check the signature —
// it is a read helper; verify with jwt_decode/jwt_verify first.
fn jwt_claim(token: str, name: str) -> str {
    let parts = str_split(token, ".")
    if vec_len(parts) != 3 {
        return ""
    }
    let payload = str_of_bytes(base64url_decode_b(vec_get(parts, 1)))
    let d = json_parse(payload)
    let node = json_get(d, json_root(d), name)
    if node < 0 {
        return ""
    }
    return json_serialize(d, node)
}

// G9: string claim without JSON quotes; "" if missing or not a string.
fn jwt_claim_str(token: str, name: str) -> str {
    let raw = jwt_claim(token, name)
    if len(raw) >= 2 {
        if char_at(raw, 0) == 34 {
            if char_at(raw, len(raw) - 1) == 34 {
                return substr(raw, 1, len(raw) - 1)
            }
        }
    }
    return ""
}

// G9: integer claim; 0 if missing or not an integer (use jwt_claim for raw).
fn jwt_claim_int(token: str, name: str) -> i64 {
    let raw = jwt_claim(token, name)
    if raw == "" {
        return 0
    }
    // reject quoted strings
    if char_at(raw, 0) == 34 {
        return 0
    }
    return parse_int(raw)
}
