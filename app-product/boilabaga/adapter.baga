// adapter.baga — client adapter to boilaDB over PostgreSQL wire (pgbaga).
// boilaDB speaks PG frontend/backend v3 on BOILA_PGPORT (default 6575).
// Trust auth when no users/token; cleartext when BOILA_TOKEN or ACL users.
//
//   import "boilabaga/adapter.baga"
//   let c = boila_connect_env()?
//   // then: orm_from_conn(c)  (ormbaga)  or raw pg_query(c, …)

import "pgbaga/pg.baga"
import "std/os/os.baga"
import "std/str/str.baga"

// ---------- env ----------

fn boila_cfg(name: str, def: str) -> str !IO {
    let v = env(name)?
    if v == "" {
        return def
    }
    return v
}

// Defaults match tools/serve_pg.baga + open trust (empty password).
// Prefer BOILA_*; host alone may fall back to PGHOST. Never inherit
// PGPORT / PGDATABASE / PGUSER / PGPASSWORD — those are real Postgres and
// would break dual-backend shells (fmr-run exports both).
fn boila_host() -> str !IO {
    let h = boila_cfg("BOILA_PGHOST", "")?
    if h != "" {
        return h
    }
    return boila_cfg("PGHOST", "127.0.0.1")?
}

fn boila_port() -> i64 !IO {
    let p = boila_cfg("BOILA_PGPORT", "")?
    if p != "" {
        return parse_int(p)
    }
    return 6575
}

fn boila_user() -> str !IO {
    return boila_cfg("BOILA_PGUSER", "boila")?
}

fn boila_password() -> str !IO {
    // Token takes precedence (same secret wire password as serve_pg auth).
    let t = boila_cfg("BOILA_TOKEN", "")?
    if t != "" {
        return t
    }
    return boila_cfg("BOILA_PGPASSWORD", "")?
}

fn boila_database() -> str !IO {
    // Startup database name (boila multi-db; default db is "boila").
    return boila_cfg("BOILA_PGDATABASE", "boila")?
}

// ---------- connect ----------

fn boila_connect(host: str, port: i64, user: str, password: str, database: str) -> PgConn !Net !IO !Random {
    return pg_connect(host, port, user, password, database)?
}

fn boila_connect_to(host: str, port: i64, user: str, password: str, database: str, timeout_s: i64) -> PgConn !Net !IO !Random {
    return pg_connect_to(host, port, user, password, database, timeout_s)?
}

// Env-driven connect. Defaults: 127.0.0.1:6575 user=boila db=boila password="".
fn boila_connect_env() -> PgConn !Net !IO !Random {
    let host = boila_host()?
    let port = boila_port()?
    let user = boila_user()?
    let password = boila_password()?
    let database = boila_database()?
    return boila_connect(host, port, user, password, database)?
}

fn boila_connect_env_to(timeout_s: i64) -> PgConn !Net !IO !Random {
    let host = boila_host()?
    let port = boila_port()?
    let user = boila_user()?
    let password = boila_password()?
    let database = boila_database()?
    return boila_connect_to(host, port, user, password, database, timeout_s)?
}

fn boila_close(c: PgConn) -> i64 !IO !Net {
    return pg_close(c)?
}

fn boila_ok(c: PgConn) -> i64 {
    return c.ok
}

fn boila_err(c: PgConn) -> str {
    return c.err
}

// Ping via SELECT 1 (same as pg_ping).
fn boila_ping(c: PgConn) -> PgResult !IO !Net {
    return pg_ping(c)?
}
