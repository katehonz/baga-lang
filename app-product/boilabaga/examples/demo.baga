// demo.baga — ping boilaDB over PG wire via the adapter.

import "../adapter.baga"
import "pgbaga/pg.baga"
import "std/str/str.baga"

fn main() -> i64 !Net !IO !Random {
    print("boilabaga demo (PG wire → boilaDB)")
    let c0 = boila_connect_env()?
    if boila_ok(c0) == 0 {
        print(concat("connect failed: ", boila_err(c0)))
        print("hint: start serve_pg  ./baga -I . -I app-product app-product/boilaDB/tools/serve_pg.baga")
        print("      BOILA_PGPORT=6575 (default)")
        return 1
    }
    let mut c = c0
    print(concat("connected server_version=", c.server_version))

    let p = boila_ping(c)?
    c = pg_conn_of(p)
    if pg_ok(p) == 0 {
        print(concat("ping failed: ", pg_err(p)))
        boila_close(c)?
        return 1
    }
    print(concat("ping ok tag=", pg_tag(p)))

    let r = pg_query(c, "SELECT 1 AS n")?
    c = pg_conn_of(r)
    if pg_ok(r) == 0 {
        print(concat("select failed: ", pg_err(r)))
        boila_close(c)?
        return 1
    }
    print(concat("select n=", int_to_str(pg_cell_i64(r, 0, 0))))

    boila_close(c)?
    print("done")
    return 0
}
