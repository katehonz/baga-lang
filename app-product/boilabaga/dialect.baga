// dialect.baga — BoilaSQL helpers for SQL that must run on boilaDB.
// boila has no double-quoted identifiers, no SERIAL/DEFAULT/NOT NULL/FK.
// Safe bare idents work on both boila and Postgres (lowercase fold).

import "std/str/str.baga"

// True if name is a safe bare SQL identifier ([A-Za-z_][A-Za-z0-9_]*).
fn boila_ident_ok(name: str) -> i64 {
    let n = len(name)
    if n == 0 {
        return 0
    }
    let mut i: i64 = 0
    while i < n {
        let c = char_at(name, i)
        let letter = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
        let digit = c >= 48 && c <= 57
        if i == 0 {
            if letter == false {
                return 0
            }
        } else {
            if letter == false && digit == false {
                return 0
            }
        }
        i = i + 1
    }
    return 1
}

// Bare identifier (boila requires this; PG accepts for non-reserved names).
fn boila_ident(name: str) -> str {
    if boila_ident_ok(name) == 0 {
        return ""
    }
    return name
}

// Join bare idents with ", ".
fn boila_ident_list(names: Vec<str>) -> str {
    let mut out = ""
    for i in 0..vec_len(names) {
        if i > 0 {
            out = concat(out, ", ")
        }
        out = concat(out, boila_ident(vec_get(names, i)))
    }
    return out
}

// CREATE TABLE … PRIMARY KEY (pk) — boila-shaped (no SERIAL/DEFAULT/NOT NULL).
fn boila_ddl_create_table(table: str, cols: Vec<str>, types: Vec<str>, pk: str) -> str {
    let mut body = ""
    let n = vec_len(cols)
    let mut i: i64 = 0
    while i < n {
        if i > 0 {
            body = concat(body, ", ")
        }
        body = concat(concat(concat(boila_ident(vec_get(cols, i)), " "), vec_get(types, i)), "")
        i = i + 1
    }
    body = concat(concat(concat(body, ", PRIMARY KEY ("), boila_ident(pk)), ")")
    return concat(
        concat(concat("CREATE TABLE IF NOT EXISTS ", boila_ident(table)), " ("),
        concat(body, ")")
    )
}

// CREATE INDEX name ON table (col)
fn boila_ddl_create_index(name: str, table: str, col: str) -> str {
    return concat(
        concat(concat(concat("CREATE INDEX ", boila_ident(name)), " ON "), boila_ident(table)),
        concat(concat(" (", boila_ident(col)), ")")
    )
}

// CREATE UNIQUE INDEX name ON table (col)
fn boila_ddl_create_unique_index(name: str, table: str, col: str) -> str {
    return concat(
        concat(concat(concat("CREATE UNIQUE INDEX ", boila_ident(name)), " ON "), boila_ident(table)),
        concat(concat(" (", boila_ident(col)), ")")
    )
}

// DROP INDEX name ON table (boila requires ON table)
fn boila_ddl_drop_index(name: str, table: str) -> str {
    return concat(
        concat(concat("DROP INDEX IF EXISTS ", boila_ident(name)), " ON "),
        boila_ident(table)
    )
}

fn boila_ddl_drop_table(table: str) -> str {
    return concat("DROP TABLE IF EXISTS ", boila_ident(table))
}

// History table DDL shared shape: works on boila + Postgres.
fn boila_ddl_migrations_table() -> str {
    return "CREATE TABLE IF NOT EXISTS baga_schema_migrations (version BIGINT, name TEXT, applied_at TIMESTAMPTZ, PRIMARY KEY (version))"
}
