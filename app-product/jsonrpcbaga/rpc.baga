// rpc.baga — JSON-RPC 2.0 subset over HTTP (apps-roadmap №6).
//
// Spec subset: single object or batch array; notifications (no id → no
// response); standard error codes; methods registered by name via switch
// (no function values / L5).
//
// Outcomes are L3 sums (B1) — no ok:i64 stand-in.

import "httpdbaga/http.baga"
import "std/json/json.baga"
import "std/json/json_write.baga"
import "std/json/json_strict.baga"
import "std/str/str.baga"
import "std/net/tcp.baga"

// ---------- result type (B1 L3) ----------

struct JrpcOkData {
    result_json: str,   // raw JSON value (number, string, object, …)
    id_json: str
}

struct JrpcErrData {
    err_code: i64,
    err_msg: str,
    id_json: str
}

enum RpcResult {
    JrpcOk(JrpcOkData),
    JrpcErr(JrpcErrData),
    JrpcSkip
}

fn rpc_ok(id_json: str, result_json: str) -> RpcResult {
    return JrpcOk(JrpcOkData {
        result_json: result_json,
        id_json: id_json
    })
}

fn rpc_err(id_json: str, code: i64, msg: str) -> RpcResult {
    return JrpcErr(JrpcErrData {
        err_code: code,
        err_msg: msg,
        id_json: id_json
    })
}

fn rpc_skip() -> RpcResult {
    return JrpcSkip
}

fn rpc_is_ok(r: RpcResult) -> i64 {
    return match r {
        JrpcOk(x) => 1,
        JrpcErr(e) => 0,
        JrpcSkip => 0,
    }
}

fn rpc_is_skip(r: RpcResult) -> i64 {
    return match r {
        JrpcOk(x) => 0,
        JrpcErr(e) => 0,
        JrpcSkip => 1,
    }
}

// ---------- JSON builders ----------

fn rpc_id_field(id_json: str) -> str {
    if id_json == "" {
        return "\"id\":null"
    }
    return concat("\"id\":", id_json)
}

fn rpc_encode_ok(x: JrpcOkData) -> str {
    let mut s = "{\"jsonrpc\":\"2.0\",\"result\":"
    s = concat(s, x.result_json)
    s = concat(s, ",")
    s = concat(s, rpc_id_field(x.id_json))
    s = concat(s, "}")
    return s
}

fn rpc_encode_err(e: JrpcErrData) -> str {
    let mut s = "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":"
    s = concat(s, int_to_str(e.err_code))
    s = concat(s, ",\"message\":")
    s = concat(s, json_escape(e.err_msg))
    s = concat(s, "},")
    s = concat(s, rpc_id_field(e.id_json))
    s = concat(s, "}")
    return s
}

fn rpc_encode(r: RpcResult) -> str {
    return match r {
        JrpcSkip => "",
        JrpcOk(x) => rpc_encode_ok(x),
        JrpcErr(e) => rpc_encode_err(e),
    }
}

// Serialize a JSON node to raw text (reuse std serializer).
fn rpc_node_json(d: JsonDoc, n: i64) -> str {
    if n < 0 {
        return "null"
    }
    return json_serialize(d, n)
}

// Extract id as raw JSON text; empty string means "id absent" (notification).
fn rpc_extract_id(d: JsonDoc, root: i64) -> str {
    let n = json_get(d, root, "id")
    if n < 0 {
        return ""
    }
    return rpc_node_json(d, n)
}

fn rpc_num_i64(d: JsonDoc, n: i64) -> i64 {
    if n < 0 {
        return 0
    }
    if json_tag(d, n) != 3 {
        return 0
    }
    return parse_int(json_str(d, n))
}

// ---------- built-in methods ----------

// ping → "pong"
// add  → sum of two numbers (array [a,b] or object {a,b} / {x,y})
// echo → returns params as result (or null)
// fail → application error -32000
fn rpc_dispatch(method: str, d: JsonDoc, params: i64, id_json: str) -> RpcResult {
    if method == "ping" {
        return rpc_ok(id_json, "\"pong\"")
    }
    if method == "echo" {
        if params < 0 {
            return rpc_ok(id_json, "null")
        }
        return rpc_ok(id_json, rpc_node_json(d, params))
    }
    if method == "fail" {
        return rpc_err(id_json, 0 - 32000, "intentional failure")
    }
    if method == "add" {
        if params < 0 {
            return rpc_err(id_json, 0 - 32602, "Invalid params")
        }
        let tag = json_tag(d, params)
        let mut a: i64 = 0
        let mut b: i64 = 0
        if tag == 5 {
            if json_count(d, params) < 2 {
                return rpc_err(id_json, 0 - 32602, "Invalid params")
            }
            let n0 = json_at(d, params, 0)
            let n1 = json_at(d, params, 1)
            if json_tag(d, n0) != 3 || json_tag(d, n1) != 3 {
                return rpc_err(id_json, 0 - 32602, "Invalid params")
            }
            a = rpc_num_i64(d, n0)
            b = rpc_num_i64(d, n1)
        } else {
            if tag == 6 {
                let mut na = json_get(d, params, "a")
                let mut nb = json_get(d, params, "b")
                if na < 0 {
                    na = json_get(d, params, "x")
                }
                if nb < 0 {
                    nb = json_get(d, params, "y")
                }
                if na < 0 || nb < 0 || json_tag(d, na) != 3 || json_tag(d, nb) != 3 {
                    return rpc_err(id_json, 0 - 32602, "Invalid params")
                }
                a = rpc_num_i64(d, na)
                b = rpc_num_i64(d, nb)
            } else {
                return rpc_err(id_json, 0 - 32602, "Invalid params")
            }
        }
        return rpc_ok(id_json, int_to_str(a + b))
    }
    return rpc_err(id_json, 0 - 32601, "Method not found")
}

// User-supplied dispatch (L5). Same shape as rpc_dispatch.
fn rpc_call(dispatch: fn(str, JsonDoc, i64, str) -> RpcResult,
            method: str, d: JsonDoc, params: i64, id_json: str) -> RpcResult {
    return dispatch(method, d, params, id_json)
}

// ---------- single request object ----------

fn rpc_handle_object(d: JsonDoc, root: i64) -> RpcResult {
    return rpc_handle_object_fn(d, root, rpc_dispatch)
}

fn rpc_handle_object_fn(d: JsonDoc, root: i64,
                        dispatch: fn(str, JsonDoc, i64, str) -> RpcResult) -> RpcResult {
    if json_tag(d, root) != 6 {
        return rpc_err("null", 0 - 32600, "Invalid Request")
    }
    // jsonrpc must be "2.0" when present
    let jv = json_get(d, root, "jsonrpc")
    if jv >= 0 {
        if json_tag(d, jv) != 4 || json_str(d, jv) != "2.0" {
            return rpc_err(rpc_extract_id(d, root), 0 - 32600, "Invalid Request")
        }
    }
    let mn = json_get(d, root, "method")
    if mn < 0 || json_tag(d, mn) != 4 {
        return rpc_err(rpc_extract_id(d, root), 0 - 32600, "Invalid Request")
    }
    let method = json_str(d, mn)
    let id_json = rpc_extract_id(d, root)
    let params = json_get(d, root, "params")
    let r = dispatch(method, d, params, id_json)
    // notifications: no id → no response body (errors also suppressed per 2.0)
    if id_json == "" {
        return rpc_skip()
    }
    return r
}

// ---------- body (single or batch) ----------

fn rpc_handle_body(body: str) -> str {
    return rpc_handle_body_fn(body, rpc_dispatch)
}

fn rpc_handle_body_fn(body: str, dispatch: fn(str, JsonDoc, i64, str) -> RpcResult) -> str {
    if json_strict_valid(body) == 0 {
        return rpc_encode(rpc_err("null", 0 - 32700, "Parse error"))
    }
    let d = json_parse(body)
    let root = json_root(d)
    if json_tag(d, root) < 0 {
        return rpc_encode(rpc_err("null", 0 - 32700, "Parse error"))
    }
    let tag = json_tag(d, root)
    if tag == 6 {
        return rpc_encode(rpc_handle_object_fn(d, root, dispatch))
    }
    if tag == 5 {
        let n = json_count(d, root)
        if n == 0 {
            return rpc_encode(rpc_err("null", 0 - 32600, "Invalid Request"))
        }
        let mut out = "["
        let mut first: i64 = 1
        let mut i: i64 = 0
        while i < n {
            let elem = json_at(d, root, i)
            let r = rpc_handle_object_fn(d, elem, dispatch)
            let enc = rpc_encode(r)
            if enc != "" {
                if first == 0 {
                    out = concat(out, ",")
                }
                out = concat(out, enc)
                first = 0
            }
            i = i + 1
        }
        // all notifications → empty batch response is nothing (spec: no response)
        if first == 1 {
            return ""
        }
        out = concat(out, "]")
        return out
    }
    return rpc_encode(rpc_err("null", 0 - 32600, "Invalid Request"))
}

// ---------- HTTP ----------

fn rpc_http(req: Request) -> Response {
    let method = http_method(req)
    let path = http_path_only(req)
    if method == "GET" && path == "/health" {
        return http_json_response(200, "{\"status\":\"ok\"}")
    }
    if method == "POST" && (path == "/rpc" || path == "/") {
        let body = http_body(req)
        let out = rpc_handle_body(body)
        if out == "" {
            // notification / empty batch — 204-ish via empty 200 body
            return http_response(204, "")
        }
        return http_json_response(200, out)
    }
    return http_json_response(404, "{\"error\":\"not found\"}")
}

fn rpc_serve_conn(fd: i64) -> i64 !IO !Net {
    let req = http_read_request(fd)?
    let resp = rpc_http(req)
    return http_respond(fd, resp)?
}

// Accept loop for go_bg(rpc_serve, port).
fn rpc_serve(port: i64) -> i64 !Net !IO !Par {
    let listener = tcp_listen(port)?
    if listener < 0 {
        return -1
    }
    while true {
        let fd = tcp_accept(listener)?
        if fd >= 0 {
            go_bg(rpc_serve_conn, fd)
        }
    }
    return 0
}
