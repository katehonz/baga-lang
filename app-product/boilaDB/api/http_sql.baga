// http_sql.baga — POST /sql?db=<име>: сървърно ниво (P2 multi-database).
// Тяло = суров SQL текст; db параметърът избира базата (default "boila").
//
// Отговор:
//   {"ok":true,"kind":"select","cols":[...],"rows":[[...]]}
//   {"ok":true,"kind":"create","id":N}                    (таблица)
//   {"ok":true,"kind":"create_database","db":"..."}
//   {"ok":true,"kind":"drop_database","db":"..."}
//   {"ok":true,"kind":"use","db":"..."}
//   {"ok":false,"error":"...","sqlstate":"..."}

import "httpdbaga/http.baga"
import "../sql/exec_server.baga"
import "../sql/exec_scan.baga"
import "../txn/mvcc.baga"
import "../core/row.baga"
import "../core/value.baga"
import "std/json/json.baga"
import "std/str/str.baga"

struct BoilaHttpSql {
    srv: BoilaServer,
    txn: BoilaTxn,
    resp: Response
}

fn boila_cols_json(cols: Vec<str>) -> str {
    let mut out = "["
    let mut i: i64 = 0
    while i < vec_len(cols) {
        if i > 0 {
            out = concat(out, ",")
        }
        out = concat(out, json_escape(vec_get(cols, i)))
        i = i + 1
    }
    return concat(out, "]")
}

fn boila_rows_json(rows: Vec<Vec<BoilaVal>>) -> str {
    let mut out = "["
    let mut i: i64 = 0
    while i < vec_len(rows) {
        if i > 0 {
            out = concat(out, ",")
        }
        out = concat(out, boila_row_json(vec_get(rows, i)))
        i = i + 1
    }
    return concat(out, "]")
}

fn boila_http_sql(srv: BoilaServer, req: Request) -> BoilaHttpSql !IO !Time {
    let r = boila_http_sql_tx(srv, srv.session_txn, req)?
    r.srv.session_txn = r.txn
    return r
}

// Encode BoilaSrvOut → JSON response (no re-exec).
fn boila_http_encode(out: BoilaSrvOut) -> BoilaHttpSql {
    let mut body = ""
    if out.ok == 0 {
        body = "{\"ok\":false,\"error\":"
        body = concat(body, json_escape(out.err))
        body = concat(body, ",\"sqlstate\":\"")
        body = concat(body, out.state)
        body = concat(body, "\"}")
        return BoilaHttpSql { srv: out.srv, txn: out.txn, resp: http_json_response(200, body) }
    }
    if out.kind == 1 {
        body = "{\"ok\":true,\"kind\":\"select\",\"cols\":"
        body = concat(body, boila_cols_json(out.res.cols))
        body = concat(body, ",\"rows\":")
        body = concat(body, boila_rows_json(out.res.rows))
        body = concat(body, "}")
        return BoilaHttpSql { srv: out.srv, txn: out.txn, resp: http_json_response(200, body) }
    }
    if out.kind == 2 || out.kind == 9 || out.kind == 14 || out.kind == 15 || out.kind == 17 || out.kind == 18 {
        let mut k = "create"
        if out.kind == 9 { k = "create_index" }
        if out.kind == 14 { k = "create_fts" }
        if out.kind == 15 { k = "create_hnsw" }
        if out.kind == 17 { k = "create_graph" }
        if out.kind == 18 { k = "drop_table" }
        body = "{\"ok\":true,\"kind\":\""
        body = concat(body, k)
        body = concat(body, "\",\"id\":")
        body = concat(body, int_to_str(out.id))
        body = concat(body, "}")
        return BoilaHttpSql { srv: out.srv, txn: out.txn, resp: http_json_response(200, body) }
    }
    if out.kind >= 6 && out.kind <= 8 {
        let mut kname = "insert"
        if out.kind == 7 { kname = "update" }
        if out.kind == 8 { kname = "delete" }
        body = "{\"ok\":true,\"kind\":\""
        body = concat(body, kname)
        body = concat(body, "\",\"affected\":")
        body = concat(body, int_to_str(out.id))
        body = concat(body, ",\"rows\":")
        body = concat(body, boila_rows_json(out.res.rows))
        body = concat(body, "}")
        return BoilaHttpSql { srv: out.srv, txn: out.txn, resp: http_json_response(200, body) }
    }
    if out.kind >= 10 && out.kind <= 12 {
        let mut kname = "begin"
        if out.kind == 11 { kname = "commit" }
        if out.kind == 12 { kname = "rollback" }
        body = "{\"ok\":true,\"kind\":\""
        body = concat(body, kname)
        body = concat(body, "\",\"lsn\":")
        body = concat(body, int_to_str(out.id))
        body = concat(body, "}")
        return BoilaHttpSql { srv: out.srv, txn: out.txn, resp: http_json_response(200, body) }
    }
    if out.kind == 3 {
        body = "{\"ok\":true,\"kind\":\"create_database\",\"db\":"
        body = concat(body, json_escape(out.db))
        body = concat(body, "}")
        return BoilaHttpSql { srv: out.srv, txn: out.txn, resp: http_json_response(200, body) }
    }
    if out.kind == 4 {
        body = "{\"ok\":true,\"kind\":\"drop_database\",\"db\":"
        body = concat(body, json_escape(out.db))
        body = concat(body, "}")
        return BoilaHttpSql { srv: out.srv, txn: out.txn, resp: http_json_response(200, body) }
    }
    body = "{\"ok\":true,\"kind\":\"use\",\"db\":"
    body = concat(body, json_escape(out.db))
    body = concat(body, "}")
    return BoilaHttpSql { srv: out.srv, txn: out.txn, resp: http_json_response(200, body) }
}

fn boila_http_sql_tx(srv: BoilaServer, txn: BoilaTxn, req: Request) -> BoilaHttpSql !IO !Time {
    let mut db = http_query_param(req, "db")
    if db == "" {
        db = "boila"
    }
    let out = boila_server_exec_tx(srv, txn, db, http_body(req))?
    return boila_http_encode(out)
}
