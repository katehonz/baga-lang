// http_sql.baga — POST /sql[?db=]: сървърно ниво (P2 multi-database).
// Тяло = суров SQL. H3: per-conn session db (default "boila");
// ?db= overrides for the request and updates session on ok;
// USE updates session (like PG sess.db). Keepalive reuses session.
//
// Отговор:
//   {"ok":true,"kind":"select","cols":[...],"rows":[[...]]}
//   {"ok":true,"kind":"create","id":N}                    (таблица)
//   {"ok":true,"kind":"create_database","db":"..."}
//   {"ok":true,"kind":"drop_database","db":"..."}
//   {"ok":true,"kind":"use","db":"..."}
//   {"ok":false,"error":"...","sqlstate":"..."}

import "httpdbaga/http.baga"
import "../server/exec_server.baga"
import "../sql/exec_scan.baga"
import "../sql/plan_cache.baga"
import "../server/databases.baga"
import "../storage/shards.baga"
import "../txn/mvcc.baga"
import "../core/row.baga"
import "../core/value.baga"
import "std/json/json.baga"
import "std/json/json_write.baga"
import "std/json/json_strict.baga"
import "std/str/str.baga"
import "std/os/os.baga"
import "std/crypto/ct.baga"
import "std/crypto/hmac.baga"
import "http_auth.baga"
import "../sql/exec_acl.baga"

struct BoilaHttpSql {
    srv: BoilaServer,
    txn: BoilaTxn,
    resp: Response,
    db: str,
    guc: Map<str, str>
}

fn boila_http_pack(srv: BoilaServer, txn: BoilaTxn, resp: Response, db: str, guc: Map<str, str>) -> BoilaHttpSql {
    return BoilaHttpSql { srv: srv, txn: txn, resp: resp, db: db, guc: guc }
}

fn boila_http_auth_fail(txn: BoilaTxn, sess_db: str) -> BoilaHttpSql {
    return boila_http_auth_fail_guc(txn, sess_db, map_new())
}

fn boila_http_auth_fail_guc(txn: BoilaTxn, sess_db: str, guc: Map<str, str>) -> BoilaHttpSql {
    let body = "{\"ok\":false,\"error\":\"unauthorized\",\"sqlstate\":\"28P01\"}"
    let names: Vec<str> = vec_new()
    let stores: Vec<BoilaStore> = vec_new()
    let srv = BoilaServer {
        meta: boila_store_empty(), root: "", names: names, stores: stores,
        flush_at: 0, compact_at: 0, dflt_shards: 1, max_db: 1,
        session_txn: boila_txn_new(), pc: boila_pc_new(), guc: map_new(), mt: 0, ok: 0
    }
    let mut resp = http_json_response(401, body)
    resp = http_set_header(resp, "WWW-Authenticate", "Basic realm=\"boilaDB\", Bearer")
    return boila_http_pack(srv, txn, resp, sess_db, guc)
}

// H3c: HMAC-SHA256 prefix (16 hex) of db name under BOILA_TOKEN.
fn boila_http_db_sig(db: str) -> str !IO {
    let token = env("BOILA_TOKEN")
    if token == "" {
        return ""
    }
    let h = hmac_sha256_hex(token, concat("boila_db:", db))
    if len(h) > 16 {
        return substr(h, 0, 16)
    }
    return h
}

fn boila_http_db_cookie_val(db: str) -> str !IO {
    let sig = boila_http_db_sig(db)?
    if sig == "" {
        return db
    }
    return concat(concat(db, "."), sig)
}

// Parse cookie value; verify sig when BOILA_TOKEN set.
fn boila_http_cookie_db(req: Request) -> str !IO {
    let c = http_header(req, "cookie")
    let p = str_find(c, "boila_db=")
    if p < 0 {
        return ""
    }
    let start = p + 9
    let mut end = start
    while end < len(c) && char_at(c, end) != 59 {
        end = end + 1
    }
    if end <= start {
        return ""
    }
    return boila_http_verify_db_val(substr(c, start, end))?
}

// Verify plain-or-signed db name (name or name.sig). Empty → reject when token set.
fn boila_http_verify_db_val(raw: str) -> str !IO {
    if raw == "" {
        return ""
    }
    let token = env("BOILA_TOKEN")
    let mut dot: i64 = 0 - 1
    let mut i = 0
    while i < len(raw) {
        if char_at(raw, i) == 46 {
            dot = i
        }
        i = i + 1
    }
    if token == "" {
        if dot > 0 {
            return substr(raw, 0, dot)
        }
        return raw
    }
    if dot <= 0 {
        return ""
    }
    let name = substr(raw, 0, dot)
    let sig = substr(raw, dot + 1, len(raw))
    let want = boila_http_db_sig(name)?
    if want != "" && ct_eq(sig, want) {
        return name
    }
    return ""
}

// H3: ?db= > X-Boila-Db > Cookie > conn sess > "boila"
// With BOILA_TOKEN, values use name.sig. BOILA_CSRF=1 → header must
// match cookie when both present (double-submit).
fn boila_http_pick_db(sess_db: str, req: Request) -> str !IO {
    let q = boila_http_verify_db_val(http_query_param(req, "db"))?
    if q != "" {
        return q
    }
    let h = boila_http_verify_db_val(http_header(req, "x-boila-db"))?
    let ck = boila_http_cookie_db(req)?
    let csrf = env("BOILA_CSRF")
    if csrf == "1" || csrf == "true" {
        // double-submit: both required and equal; mismatch → default (no sess)
        if h != "" || ck != "" {
            if h != "" && ck != "" && h == ck {
                return h
            }
            return "boila"
        }
    } else {
        if h != "" {
            return h
        }
        if ck != "" {
            return ck
        }
    }
    if sess_db != "" {
        return sess_db
    }
    return "boila"
}

// After request: USE (kind 5) → out.db; else keep used_db (pick result).
// CREATE/DROP DATABASE put the target name in out.db — do not switch.
fn boila_http_next_db(sess_db: str, used_db: str, out: BoilaSrvOut) -> str {
    if out.ok == 1 && out.kind == 5 && out.db != "" {
        return out.db
    }
    if out.ok == 1 && used_db != "" {
        return used_db
    }
    if sess_db != "" {
        return sess_db
    }
    return "boila"
}

fn boila_cols_json(cols: Vec<str>) -> str {
    let mut out = "["
    let mut i: i64 = 0
    while i < vec_len(cols) {
        if i > 0 {
            out = concat(out, ",")
        }
        out = concat(out, json_escape(vec_get(cols, i)))
        i = i + 1
    }
    return concat(out, "]")
}

fn boila_rows_json(rows: Vec<Vec<BoilaVal>>) -> str {
    let mut out = "["
    let mut i: i64 = 0
    while i < vec_len(rows) {
        if i > 0 {
            out = concat(out, ",")
        }
        out = concat(out, boila_row_json(vec_get(rows, i)))
        i = i + 1
    }
    return concat(out, "]")
}

fn boila_http_sql(srv: BoilaServer, req: Request) -> BoilaHttpSql !IO !Time !Par {
    let r = boila_http_sql_tx(srv, srv.session_txn, "boila", req)?
    r.srv.session_txn = r.txn
    return r
}

// Encode BoilaSrvOut → JSON. guc = session map to echo back.
fn boila_http_encode(out: BoilaSrvOut, sess_db: str, used_db: str, guc: Map<str, str>) -> BoilaHttpSql !IO {
    let ndb = boila_http_next_db(sess_db, used_db, out)
    let mut body = ""
    if out.ok == 0 {
        body = "{\"ok\":false,\"error\":"
        body = concat(body, json_escape(out.err))
        body = concat(body, ",\"sqlstate\":\"")
        body = concat(body, out.state)
        body = concat(body, "\"}")
        return boila_http_pack(out.srv, out.txn, http_json_response(200, body), ndb, guc)
    }
    if out.kind == 1 {
        body = "{\"ok\":true,\"kind\":\"select\",\"cols\":"
        body = concat(body, boila_cols_json(out.res.cols))
        body = concat(body, ",\"rows\":")
        body = concat(body, boila_rows_json(out.res.rows))
        body = concat(body, "}")
        return boila_http_pack(out.srv, out.txn, http_json_response(200, body), ndb, guc)
    }
    if out.kind == 2 || out.kind == 9 || out.kind == 14 || out.kind == 15 || out.kind == 17 || out.kind == 18 || out.kind == 22 || out.kind == 23 || out.kind == 24 || out.kind == 25 || out.kind == 26 || out.kind == 27 || out.kind == 28 || out.kind == 29 || out.kind == 30 {
        let mut k = "create"
        if out.kind == 9 { k = "create_index" }
        if out.kind == 14 { k = "create_fts" }
        if out.kind == 15 { k = "create_hnsw" }
        if out.kind == 17 { k = "create_graph" }
        if out.kind == 18 { k = "drop_table" }
        if out.kind == 22 { k = "alter_table" }
        if out.kind == 23 { k = "drop_index" }
        if out.kind == 24 { k = "drop_graph" }
        if out.kind == 25 { k = "truncate" }
        if out.kind == 26 { k = "create_user" }
        if out.kind == 27 { k = "drop_user" }
        if out.kind == 28 { k = "alter_user" }
        if out.kind == 29 { k = "grant" }
        if out.kind == 30 { k = "revoke" }
        body = "{\"ok\":true,\"kind\":\""
        body = concat(body, k)
        body = concat(body, "\",\"id\":")
        body = concat(body, int_to_str(out.id))
        body = concat(body, "}")
        return boila_http_pack(out.srv, out.txn, http_json_response(200, body), ndb, guc)
    }
    if out.kind >= 6 && out.kind <= 8 {
        let mut kname = "insert"
        if out.kind == 7 { kname = "update" }
        if out.kind == 8 { kname = "delete" }
        body = "{\"ok\":true,\"kind\":\""
        body = concat(body, kname)
        body = concat(body, "\",\"affected\":")
        body = concat(body, int_to_str(out.id))
        body = concat(body, ",\"rows\":")
        body = concat(body, boila_rows_json(out.res.rows))
        body = concat(body, "}")
        return boila_http_pack(out.srv, out.txn, http_json_response(200, body), ndb, guc)
    }
    if out.kind >= 10 && out.kind <= 12 {
        let mut kname = "begin"
        if out.kind == 11 { kname = "commit" }
        if out.kind == 12 { kname = "rollback" }
        body = "{\"ok\":true,\"kind\":\""
        body = concat(body, kname)
        body = concat(body, "\",\"lsn\":")
        body = concat(body, int_to_str(out.id))
        body = concat(body, "}")
        return boila_http_pack(out.srv, out.txn, http_json_response(200, body), ndb, guc)
    }
    if out.kind == 19 {
        return boila_http_pack(out.srv, out.txn, http_json_response(200, "{\"ok\":true,\"kind\":\"set\"}"), ndb, guc)
    }
    if out.kind == 20 {
        return boila_http_pack(out.srv, out.txn, http_json_response(200, "{\"ok\":true,\"kind\":\"reset\"}"), ndb, guc)
    }
    if out.kind == 21 {
        return boila_http_pack(out.srv, out.txn, http_json_response(200, "{\"ok\":true,\"kind\":\"discard\"}"), ndb, guc)
    }
    if out.kind == 3 {
        body = "{\"ok\":true,\"kind\":\"create_database\",\"db\":"
        body = concat(body, json_escape(out.db))
        body = concat(body, "}")
        return boila_http_pack(out.srv, out.txn, http_json_response(200, body), ndb, guc)
    }
    if out.kind == 4 {
        body = "{\"ok\":true,\"kind\":\"drop_database\",\"db\":"
        body = concat(body, json_escape(out.db))
        body = concat(body, "}")
        return boila_http_pack(out.srv, out.txn, http_json_response(200, body), ndb, guc)
    }
    body = "{\"ok\":true,\"kind\":\"use\",\"db\":"
    body = concat(body, json_escape(out.db))
    body = concat(body, "}")
    let mut resp = http_json_response(200, body)
    if out.ok == 1 && out.kind == 5 && out.db != "" {
        let cv = boila_http_db_cookie_val(out.db)?
        resp = http_set_header(resp, "Set-Cookie", concat(concat("boila_db=", cv), "; Path=/; HttpOnly"))
    }
    return boila_http_pack(out.srv, out.txn, resp, ndb, guc)
}

// Compat wrapper — guc from srv after ST exec.
fn boila_http_encode_st(out: BoilaSrvOut, sess_db: str, used_db: str) -> BoilaHttpSql !IO {
    return boila_http_encode(out, sess_db, used_db, out.srv.guc)?
}

fn boila_http_sql_tx(srv: BoilaServer, txn: BoilaTxn, sess_db: str, req: Request) -> BoilaHttpSql !IO !Time !Par {
    return boila_http_sql_tx_guc(srv, txn, sess_db, srv.guc, req)?
}

fn boila_http_sql_tx_guc(srv: BoilaServer, txn: BoilaTxn, sess_db: str, guc: Map<str, str>, req: Request) -> BoilaHttpSql !IO !Time !Par {
    let au = boila_http_auth(srv, guc, req)?
    srv = au.srv
    guc = au.guc
    if au.ok == 0 {
        return boila_http_auth_fail_guc(txn, sess_db, guc)
    }
    srv.guc = guc
    let db = boila_http_pick_db(sess_db, req)?
    let out = boila_server_exec_tx(srv, txn, db, http_body(req))?
    return boila_http_encode(out, sess_db, db, out.srv.guc)?
}
