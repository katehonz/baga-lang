// serve_mt.baga — go_bg pack: multi-DB + per-shard hop-less + live conn.
//
// pack = cell2(gmu, cell2(srv_mh, cell2(dmu_mh, cell2(live_mh, pcs_mh))))
//
// Locking:
//   CREATE/DROP DATABASE, USE → gmu (registry).
//   Schema DDL → dmu(db) whole SQL + brief gmu.
//   Data SQL → brief gmu checkout; per-shard storage locks; shared
//     per-db plan cache without pcmu (warmup makes puts rare; baga
//     mutex owner-flag races under rapid lock/unlock fan-out).
// No !Par on BoilaStore struct.

import "../storage/databases.baga"
import "../sql/exec_server.baga"
import "../sql/exec_sql.baga"
import "../sql/exec_select.baga"
import "../sql/exec_scan.baga"
import "../sql/plan_cache.baga"
import "../sql/ast.baga"
import "../catalog/schema.baga"
import "../txn/mvcc.baga"
import "../ts/retention.baga"
import "std/str/str.baga"
import "std/os/os.baga"

fn boila_mt_pack(gmu: i64, srv_mh: i64, dmu_mh: i64, live_mh: i64, pcs_mh: i64) -> i64 {
    return cell2(gmu, cell2(srv_mh, cell2(dmu_mh, cell2(live_mh, pcs_mh))))
}

fn boila_mt_gmu(pack: i64) -> i64 { return cell2_0(pack) }
fn boila_mt_srv_h(pack: i64) -> i64 { return cell2_0(cell2_1(pack)) }
fn boila_mt_dmu_h(pack: i64) -> i64 { return cell2_0(cell2_1(cell2_1(pack))) }
fn boila_mt_live_h(pack: i64) -> i64 { return cell2_0(cell2_1(cell2_1(cell2_1(pack)))) }
fn boila_mt_pcs_h(pack: i64) -> i64 { return cell2_1(cell2_1(cell2_1(cell2_1(pack)))) }

fn boila_mt_seed_srv() -> BoilaServer {
    let names: Vec<str> = vec_new()
    let stores: Vec<BoilaStore> = vec_new()
    return BoilaServer {
        meta: boila_store_empty(), root: "", names: names, stores: stores,
        flush_at: 0, compact_at: 0, dflt_shards: 1, max_db: 1,
        session_txn: boila_txn_new(), pc: boila_pc_new(), mt: 0, ok: 0
    }
}

fn boila_mt_new(srv: BoilaServer, max_conn: i64) -> i64 !Par {
    let sm: Map<i64, BoilaServer> = map_new()
    map_set(sm, 0, srv)
    let dm: Map<str, i64> = map_new()
    let live: Map<i64, i64> = map_new()
    map_set(live, 0, 0)
    let mut mc = max_conn
    if mc < 1 {
        mc = 1
    }
    map_set(live, 1, mc)
    let pcs: Map<str, BoilaPlanCache> = map_new()
    return boila_mt_pack(mutex_new(), map_h(sm), map_h(dm), map_h(live), map_h(pcs))
}

fn boila_mt_try_conn(pack: i64) -> i64 !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let live: Map<i64, i64> = h_map(boila_mt_live_h(pack))
    let n = map_get(live, 0)
    let maxc = map_get(live, 1)
    let mut ok: i64 = 0
    if n < maxc {
        map_set(live, 0, n + 1)
        ok = 1
    }
    mutex_unlock(gmu)
    return ok
}

fn boila_mt_end_conn(pack: i64) -> i64 !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let live: Map<i64, i64> = h_map(boila_mt_live_h(pack))
    let n = map_get(live, 0)
    if n > 0 {
        map_set(live, 0, n - 1)
    }
    mutex_unlock(gmu)
    return 0
}

fn boila_mt_live(pack: i64) -> i64 !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let live: Map<i64, i64> = h_map(boila_mt_live_h(pack))
    let n = map_get(live, 0)
    mutex_unlock(gmu)
    return n
}

// 1=db DDL, 2=USE, 3=schema DDL, 0=data (SELECT/DML/txn).
fn boila_mt_kw2(sql: str) -> i64 {
    let n = len(sql)
    let mut i: i64 = 0
    let mut w1 = ""
    let mut w2 = ""
    let mut wi: i64 = 0
    let mut cur = ""
    while i <= n {
        let mut cl: i64 = 32
        if i < n {
            cl = char_at(sql, i)
            if cl >= 65 && cl <= 90 {
                cl = cl + 32
            }
        }
        if cl >= 97 && cl <= 122 {
            cur = concat(cur, chr(cl))
        } else {
            if cur != "" {
                if wi == 0 {
                    w1 = cur
                }
                if wi == 1 {
                    w2 = cur
                }
                wi = wi + 1
                cur = ""
                if wi >= 2 {
                    i = n
                }
            }
        }
        i = i + 1
    }
    if w1 == "use" {
        return 2
    }
    if w1 == "create" || w1 == "drop" {
        if w2 == "database" {
            return 1
        }
        return 3
    }
    return 0
}

fn boila_mt_db_mu(pack: i64, db: str) -> i64 !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let dm: Map<str, i64> = h_map(boila_mt_dmu_h(pack))
    let mut mu: i64 = 0
    if map_has(dm, db) == 1 {
        mu = map_get(dm, db)
    } else {
        mu = mutex_new()
        map_set(dm, db, mu)
    }
    mutex_unlock(gmu)
    return mu
}

fn boila_mt_db_ok(pack: i64, db: str) -> i64 !IO !Time !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let m: Map<i64, BoilaServer> = h_map(boila_mt_srv_h(pack))
    let r = boila_srv_db(map_get(m, 0), db)?
    map_set(m, 0, r.srv)
    let ok = r.ok
    mutex_unlock(gmu)
    return ok
}

// Registry-only path (DDL db / USE): whole server_exec under gmu.
fn boila_mt_exec_reg(pack: i64, txn: BoilaTxn, db: str, sql: str) -> BoilaSrvOut !IO !Time !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let m: Map<i64, BoilaServer> = h_map(boila_mt_srv_h(pack))
    let out = boila_server_exec_tx(map_get(m, 0), txn, db, sql)?
    map_set(m, 0, out.srv)
    mutex_unlock(gmu)
    return out
}

// Checkout store under gmu; caller holds dmu if schema_ddl==1.
fn boila_mt_checkout(pack: i64, db: str) -> BoilaSrvDb !IO !Time !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let m: Map<i64, BoilaServer> = h_map(boila_mt_srv_h(pack))
    let g = boila_srv_db(map_get(m, 0), db)?
    map_set(m, 0, g.srv)
    mutex_unlock(gmu)
    return g
}

fn boila_mt_checkin(pack: i64, db: str, store: BoilaStore) -> i64 !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let m: Map<i64, BoilaServer> = h_map(boila_mt_srv_h(pack))
    let mut srv = map_get(m, 0)
    srv = boila_srv_store_putback(srv, db, store)
    map_set(m, 0, srv)
    mutex_unlock(gmu)
    return 0
}

// Per-db plan cache: ensure entry exists under gmu, return pc (+ mu handle).
fn boila_mt_pc_take(pack: i64, db: str) -> BoilaPlanCache !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let pcs: Map<str, BoilaPlanCache> = h_map(boila_mt_pcs_h(pack))
    let mut pc = boila_pc_new()
    if map_has(pcs, db) == 1 {
        pc = map_get(pcs, db)
    } else {
        map_set(pcs, db, pc)
    }
    mutex_unlock(gmu)
    return pc
}

// Keep newer generation (DDL invalidate must not be clobbered by stale put).
fn boila_mt_pc_putback(pack: i64, db: str, pc: BoilaPlanCache) -> i64 !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let pcs: Map<str, BoilaPlanCache> = h_map(boila_mt_pcs_h(pack))
    if map_has(pcs, db) == 1 {
        let cur = map_get(pcs, db)
        if pc.gen >= cur.gen {
            map_set(pcs, db, pc)
        }
    } else {
        map_set(pcs, db, pc)
    }
    mutex_unlock(gmu)
    return 0
}

// W2: bound SELECT AST path (no re-parse).
fn boila_mt_exec_sel(pack: i64, txn: BoilaTxn, db: str, sel: BoilaSel) -> BoilaSrvOut !IO !Time !Par {
    let g = boila_mt_checkout(pack, db)?
    if g.ok == 0 {
        return boila_srv_out_fail(boila_mt_seed_srv(), txn, g.err, g.state)
    }
    let ct = boila_cat_by_name(g.store, sel.table)?
    let mut s = ct.s
    if ct.ok == 0 {
        boila_mt_checkin(pack, db, s)?
        return boila_srv_out_fail(boila_mt_seed_srv(), txn, ct.err, ct.state)
    }
    let ex = boila_exec_select(s, txn, ct.table, sel)?
    boila_mt_checkin(pack, db, ex.s)?
    return BoilaSrvOut {
        srv: boila_mt_seed_srv(), txn: ex.txn, ok: ex.ok, err: ex.err,
        state: ex.state, kind: 1, res: ex.res, id: 0, db: db
    }
}

fn boila_mt_exec(pack: i64, txn: BoilaTxn, db: str, sql: str) -> BoilaSrvOut !IO !Time !Par {
    let k = boila_mt_kw2(sql)
    if k == 1 || k == 2 {
        return boila_mt_exec_reg(pack, txn, db, sql)?
    }

    // dmu: whole schema DDL; data path only for brief pc get/put (pc_mu).
    let dmu = boila_mt_db_mu(pack, db)?
    if k == 3 {
        mutex_lock(dmu)
    }

    let g = boila_mt_checkout(pack, db)?
    if g.ok == 0 {
        if k == 3 {
            mutex_unlock(dmu)
        }
        return boila_srv_out_fail(boila_mt_seed_srv(), txn, g.err, g.state)
    }

    let pc = boila_mt_pc_take(pack, db)?
    // pc_mu=0: Map ops are brief; after plan-cache warmup puts are rare.
    // Holding a mutex across only get/put still hit baga double-lock detector
    // under fan-out (owner flag race with rapid lock/unlock). Residual: rare
    // concurrent pc miss put is benign (duplicate plan). Schema dmu serializes DDL.
    let out = boila_exec_sql_mu(g.store, txn, db, sql, pc, 0)?
    boila_mt_checkin(pack, db, out.s)?
    boila_mt_pc_putback(pack, db, out.pc)?

    if k == 3 {
        mutex_unlock(dmu)
    }

    return BoilaSrvOut {
        srv: boila_mt_seed_srv(), txn: out.txn, ok: out.ok, err: out.err,
        state: out.state, kind: out.kind, res: out.res, id: out.id, db: db
    }
}

fn boila_mt_open_count(pack: i64) -> i64 !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let m: Map<i64, BoilaServer> = h_map(boila_mt_srv_h(pack))
    let n = vec_len(map_get(m, 0).names)
    mutex_unlock(gmu)
    return n
}

fn boila_mt_max_db(pack: i64) -> i64 !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let m: Map<i64, BoilaServer> = h_map(boila_mt_srv_h(pack))
    let n = map_get(m, 0).max_db
    mutex_unlock(gmu)
    return n
}

// S6: flush all open DBs (rocksbaga lazy TTL drops on flush).
fn boila_mt_sweep_once(pack: i64) -> i64 !IO !Time !Par {
    let gmu = boila_mt_gmu(pack)
    mutex_lock(gmu)
    let m: Map<i64, BoilaServer> = h_map(boila_mt_srv_h(pack))
    let srv = map_get(m, 0)
    let names: Vec<str> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(srv.names) {
        vec_push(names, vec_get(srv.names, i))
        i = i + 1
    }
    mutex_unlock(gmu)
    i = 0
    while i < vec_len(names) {
        let db = vec_get(names, i)
        let g = boila_mt_checkout(pack, db)?
        if g.ok == 1 {
            let s2 = boila_ts_sweep(g.store)?
            boila_mt_checkin(pack, db, s2)?
        }
        i = i + 1
    }
    return 0
}

fn boila_sweep_ms() -> i64 !IO {
    let e = env("BOILA_SWEEP_MS")
    if e == "" {
        return 5000
    }
    let n = parse_int(e)
    if n < 0 {
        return 5000
    }
    return n
}

// Background loop: sleep BOILA_SWEEP_MS (0 = exit / disabled).
fn boila_ttl_sweeper(pack: i64) -> i64 !IO !Time !Par {
    while true {
        let ms = boila_sweep_ms()?
        if ms <= 0 {
            return 0
        }
        sleep_ms(ms)?
        boila_mt_sweep_once(pack)?
    }
    return 0
}

fn boila_mt_start_sweeper(pack: i64) -> i64 !IO !Time !Par {
    let ms = boila_sweep_ms()?
    if ms <= 0 {
        return 0
    }
    go_bg(boila_ttl_sweeper, pack)
    return 1
}
