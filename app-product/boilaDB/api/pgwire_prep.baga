import "std/bytes/bytes.baga"
import "std/net/tcp.baga"

// kind: 0 text, 1 SELECT, 2 INSERT, 3 UPDATE, 4 DELETE
struct BoilaPgStmt {
    sql: str,
    kind: i64,
    sel: BoilaSel,
    ins: BoilaIns,
    upd: BoilaUpd,
    del: BoilaDel
}

struct BoilaPgPortal {
    sql: str,
    src: str,   // името на stmt-а, от който е bound (MEM-4 reclaim гард)
    vals: Vec<str>,
    nulls: Vec<i64>,
    kind: i64,
    sel: BoilaSel,
    ins: BoilaIns,
    upd: BoilaUpd,
    del: BoilaDel
}

fn boila_pg_stmt_text(sql: str) -> BoilaPgStmt {
    return BoilaPgStmt {
        sql: sql, kind: 0, sel: boila_sel_empty(),
        ins: boila_ins_empty(), upd: boila_upd_empty(), del: boila_del_empty()
    }
}

// MEM-4: пълен free на AST vec полета — само за ОБЕКТИ, които ги притежават
// (stmt от parse; използва се от stmt_free през orphaned гарда).
fn boila_pg_sel_free_all(sel: BoilaSel) {
    let mut i: i64 = 0
    while i < vec_len(sel.items) {
        let it = vec_get(sel.items, i)
        let sc = it.sfn_cols
        drop(sc)
        let sv = it.sfn_vals
        drop(sv)
        let xt = it.xtoks
        drop(xt)
        i = i + 1
    }
    let items = sel.items
    drop(items)
    let oc = sel.ord_cols
    drop(oc)
    let od = sel.ord_desc
    drop(od)
    let gc = sel.group_cols
    drop(gc)
    let gx = sel.group_xtoks
    drop(gx)
    let mut h: i64 = 0
    while h < vec_len(sel.hav_preds) {
        let hp = vec_get(sel.hav_preds, h)
        let hxt = hp.xtoks
        drop(hxt)
        h = h + 1
    }
    let hpreds = sel.hav_preds
    drop(hpreds)
    let hnodes = sel.hav_nodes
    drop(hnodes)
    let jl = sel.join_lcols
    drop(jl)
    let jr = sel.join_rcols
    drop(jr)
    let ft = sel.fts_terms
    drop(ft)
    let fg = sel.fts_gaps
    drop(fg)
    let kp = sel.knn_pay
    drop(kp)
    let iv = sel.in_vals
    drop(iv)
    let xw = sel.xw_toks
    drop(xw)
}

fn boila_pg_ins_free_all(ins: BoilaIns) {
    let cols = ins.cols
    drop(cols)
    let rows = ins.rows
    drop(rows)
    let occ = ins.oc_cols
    drop(occ)
    let ocv = ins.oc_vals
    drop(ocv)
    let ocx = ins.oc_xtoks
    drop(ocx)
    let rc = ins.ret_cols
    drop(rc)
}

fn boila_pg_upd_free_all(upd: BoilaUpd) {
    let setc = upd.set_cols
    drop(setc)
    let setv = upd.set_vals
    drop(setv)
    let setx = upd.set_xtoks
    drop(setx)
    let xw = upd.xw_toks
    drop(xw)
    let rc = upd.ret_cols
    drop(rc)
}

fn boila_pg_del_free_all(del: BoilaDel) {
    let xw = del.xw_toks
    drop(xw)
    let rc = del.ret_cols
    drop(rc)
}

// Частичен free на PORTAL AST: само полетата, които boila_pg_bind_*
// пресъздават fresh при Bind. Останалите vec полета са shallow копия,
// СПОДЕЛЕНИ с кеширания prepared stmt — не се пипат.
fn boila_pg_sel_free_bound(sel: BoilaSel) {
    let mut i: i64 = 0
    while i < vec_len(sel.items) {
        let it = vec_get(sel.items, i)
        if vec_len(it.xtoks) > 0 {
            let xt = it.xtoks
            drop(xt)
        }
        if it.sfn != "" {
            let sv = it.sfn_vals
            drop(sv)
        }
        i = i + 1
    }
    let items = sel.items
    drop(items)
    let iv = sel.in_vals
    drop(iv)
    if sel.has_xw == 1 {
        let xw = sel.xw_toks
        drop(xw)
    }
}

fn boila_pg_ins_free_bound(ins: BoilaIns) {
    let rows = ins.rows
    drop(rows)
    let ocv = ins.oc_vals
    drop(ocv)
    let ocx = ins.oc_xtoks
    drop(ocx)
}

fn boila_pg_upd_free_bound(upd: BoilaUpd) {
    let setv = upd.set_vals
    drop(setv)
    let setx = upd.set_xtoks
    drop(setx)
    let xw = upd.xw_toks
    drop(xw)
}

fn boila_pg_del_free_bound(del: BoilaDel) {
    let xw = del.xw_toks
    drop(xw)
}

// MEM-4: reclaim на persist паметта на заместван/затварян portal. Free-ва
// vals/nulls + САМО използвания kind (bind_* го пресъздава fresh); другите
// три AST-та са споделените session празни — НЕ се пипат. kind == -1 =
// вече reclaim-нат (Sync kill) — no-op против double free. Vec<Vec<…>> drop
// е рекурсивен (mode 3): box-овете на вътрешните остават (документиран drip).
fn boila_pg_portal_free(p: BoilaPgPortal) {
    if rc_on() {
        return
    }
    if p.kind == 0 - 1 {
        return
    }
    let vals = p.vals
    drop(vals)
    let nulls = p.nulls
    drop(nulls)
    if p.kind == 1 {
        boila_pg_sel_free_bound(p.sel)
    }
    if p.kind == 2 {
        boila_pg_ins_free_bound(p.ins)
    }
    if p.kind == 3 {
        boila_pg_upd_free_bound(p.upd)
    }
    if p.kind == 4 {
        boila_pg_del_free_bound(p.del)
    }
}

fn boila_pg_parse_stmt(stmts: Map<str, BoilaPgStmt>, portals: Map<str, BoilaPgPortal>, body: bytes) -> i64 {
    let nm = pgw_cstr_read(body, 0)
    let q = pgw_cstr_read(body, nm.pos)
    if map_has(stmts, nm.s) == 1 {
        let old = map_get(stmts, nm.s)
        // MEM-4: същият SQL под същото име → пазим кешираното AST и НЕ
        // parse-ваме наново (0 алокации на Parse — драйверите с extended
        // протокол пращат един и същ unnamed stmt в цикъл).
        if old.sql == q.s {
            return 0
        }
        // Подмяна с нов SQL: reclaim на старото AST, но САМО ако никой жив
        // portal не е bound от него (portal-ите споделят нerebuild-натите
        // vec полета със stmt-а — shallow copy в bind_*).
        if boila_pg_stmt_orphaned(portals, nm.s) == 1 {
            boila_pg_stmt_free(old)
        }
    }
    map_set(stmts, nm.s, boila_pg_try_sel(q.s))
    return 0
}

// 1 ако никой portal не е bound от stmt `name` (безопасно за stmt_free).
// kind == -1 (reclaim-нат на Sync) не брои — мъртвият запис е inert.
fn boila_pg_stmt_orphaned(portals: Map<str, BoilaPgPortal>, name: str) -> i64 {
    let ks = map_keys(portals)
    let mut i: i64 = 0
    while i < vec_len(ks) {
        let p = map_get(portals, vec_get(ks, i))
        if p.kind != 0 - 1 {
            if p.src == name {
                return 0
            }
        }
        i = i + 1
    }
    return 1
}

// MEM-4: пълен reclaim на prepared stmt AST (за разлика от portal-а, stmt-ът
// притежава всичките си vec полета — parse ги гради fresh). Вика се само
// през orphaned гарда. Drip: str payload-и и вложени Vec<Token> box-ове не
// се free-ват (drop е по дълбочина 1; str е immortal в рантайма).
fn boila_pg_stmt_free(st: BoilaPgStmt) {
    if rc_on() {
        return
    }
    boila_pg_sel_free_all(st.sel)
    boila_pg_ins_free_all(st.ins)
    boila_pg_upd_free_all(st.upd)
    boila_pg_del_free_all(st.del)
}

fn boila_pg_bind_portal(stmts: Map<str, BoilaPgStmt>, portals: Map<str, BoilaPgPortal>, body: bytes, e_sel: BoilaSel, e_ins: BoilaIns, e_upd: BoilaUpd, e_del: BoilaDel) -> i64 {
    let pn = pgw_cstr_read(body, 0)
    let sn = pgw_cstr_read(body, pn.pos)
    let mut p = sn.pos
    let nf = pgw_be_read(body, p, 2)
    p = p + 2
    if nf == 1 { p = p + 2 } else { p = p + 2 * nf }
    let np = pgw_be_read(body, p, 2)
    p = p + 2
    let vals: Vec<str> = vec_new()
    let nulls: Vec<i64> = vec_new()
    let mut i: i64 = 0
    while i < np {
        let ln = pgw_be_read(body, p, 4)
        p = p + 4
        if ln >= 2147483648 {
            vec_push(vals, ""); vec_push(nulls, 1)
        } else {
            vec_push(vals, str_of_bytes(bytes_slice(body, p, p + ln)))
            vec_push(nulls, 0)
            p = p + ln
        }
        i = i + 1
    }
    // MEM-4: без --rc неизползваните kind-ове споделят session празни
    // AST-та; portal_free ги пропуска. Зад --rc споделянето е двоен
    // release (RC пуска и portal-а, и e_*) — уникални празни AST-та.
    let mut portal = BoilaPgPortal {
        sql: "", src: "", vals: vals, nulls: nulls, kind: 0,
        sel: e_sel, ins: e_ins, upd: e_upd, del: e_del
    }
    if rc_on() {
        portal.sel = boila_sel_empty()
        portal.ins = boila_ins_empty()
        portal.upd = boila_upd_empty()
        portal.del = boila_del_empty()
    }
    if map_has(stmts, sn.s) == 1 {
        let st = map_get(stmts, sn.s)
        portal.sql = st.sql
        portal.src = sn.s
        portal.vals = vals
        portal.nulls = nulls
        portal.kind = st.kind
        if st.kind == 1 { portal.sel = boila_pg_bind_sel(st.sel, vals, nulls) }
        if st.kind == 2 { portal.ins = boila_pg_bind_ins(st.ins, vals, nulls) }
        if st.kind == 3 { portal.upd = boila_pg_bind_upd(st.upd, vals, nulls) }
        if st.kind == 4 { portal.del = boila_pg_bind_del(st.del, vals, nulls) }
    }
    // MEM-4: подмяната на съществуващ portal (типично unnamed при extended
    // протокол) reclaim-ва стария преди overwrite — иначе persist регионът
    // расте с по един portal на Bind (gaps Q2 residual).
    if map_has(portals, pn.s) == 1 {
        boila_pg_portal_free(map_get(portals, pn.s))
    }
    map_set(portals, pn.s, portal)
    return 0
}

// Parse-time: SELECT/INSERT/UPDATE/DELETE AST; else text-only.
fn boila_pg_try_sel(sql: str) -> BoilaPgStmt {
    let lx = boila_lex(sql)
    if lx.err != "" {
        return boila_pg_stmt_text(sql)
    }
    if vec_len(lx.toks) < 1 {
        return boila_pg_stmt_text(sql)
    }
    let t0 = vec_get(lx.toks, 0)
    if tok_kw(t0, "select") == 1 {
        let ps = boila_parse_select(lx)
        if ps.ok == 0 { return boila_pg_stmt_text(sql) }
        return BoilaPgStmt {
            sql: sql, kind: 1, sel: ps.sel,
            ins: boila_ins_empty(), upd: boila_upd_empty(), del: boila_del_empty()
        }
    }
    if tok_kw(t0, "insert") == 1 {
        let pi = boila_parse_insert(lx)
        if pi.ok == 0 { return boila_pg_stmt_text(sql) }
        return BoilaPgStmt {
            sql: sql, kind: 2, sel: boila_sel_empty(),
            ins: pi.ins, upd: boila_upd_empty(), del: boila_del_empty()
        }
    }
    if tok_kw(t0, "update") == 1 {
        let pu = boila_parse_update(lx)
        if pu.ok == 0 { return boila_pg_stmt_text(sql) }
        return BoilaPgStmt {
            sql: sql, kind: 3, sel: boila_sel_empty(),
            ins: boila_ins_empty(), upd: pu.upd, del: boila_del_empty()
        }
    }
    if tok_kw(t0, "delete") == 1 {
        let pd = boila_parse_delete(lx)
        if pd.ok == 0 { return boila_pg_stmt_text(sql) }
        return BoilaPgStmt {
            sql: sql, kind: 4, sel: boila_sel_empty(),
            ins: boila_ins_empty(), upd: boila_upd_empty(), del: pd.del
        }
    }
    return boila_pg_stmt_text(sql)
}

// Run bound SELECT on a store (catalog resolve each Execute).
fn boila_pg_exec_sel(s: BoilaStore, txn: BoilaTxn, sel: BoilaSel) -> BoilaExec !IO !Time !Par {
    let ct = boila_cat_by_name_txn(s, txn, sel.table)?
    s = ct.s
    if ct.ok == 0 {
        return boila_exec_fail(s, txn, ct.err, ct.state)
    }
    return boila_exec_select(s, txn, ct.table, sel)?
}

// W5: column names+tags from SELECT + table (no JOIN / agg → empty ok=0).
struct BoilaPgMeta {
    ok: i64,
    cols: Vec<str>,
    tags: Vec<i64>,
    nparams: i64,
    s: BoilaStore
}

fn boila_pg_sel_meta(s: BoilaStore, sel: BoilaSel) -> BoilaPgMeta !IO !Time !Par {
    let cols: Vec<str> = vec_new()
    let tags: Vec<i64> = vec_new()
    let np = boila_pg_nparams(sel)
    if sel.has_join == 1 || sel.has_group == 1 {
        return BoilaPgMeta { ok: 0, cols: cols, tags: tags, nparams: np, s: s }
    }
    // Describe uses committed catalog (no session txn on this path)
    let ct = boila_cat_by_name(s, sel.table)?
    s = ct.s
    if ct.ok == 0 {
        return BoilaPgMeta { ok: 0, cols: cols, tags: tags, nparams: np, s: s }
    }
    let t = ct.table
    if sel.star == 1 {
        let mut i: i64 = 0
        while i < vec_len(t.cols) {
            let cd = vec_get(t.cols, i)
            vec_push(cols, cd.name)
            vec_push(tags, cd.typ)
            i = i + 1
        }
        return BoilaPgMeta { ok: 1, cols: cols, tags: tags, nparams: np, s: s }
    }
    let mut k: i64 = 0
    while k < vec_len(sel.items) {
        let it = vec_get(sel.items, k)
        if vec_len(it.xtoks) > 0 {
            // Q-expr: probe for errors + static type (NoData on fail)
            let pr = boila_expr_probe(t.cols, it.xtoks)?
            if pr.ok == 0 || pr.series == 1 || pr.pos < vec_len(it.xtoks) {
                return BoilaPgMeta { ok: 0, cols: cols, tags: tags, nparams: np, s: s }
            }
            let mut ty = pr.tag
            if ty == boila_v_null() {
                ty = boila_expr_type_guess(it.xtoks)
            }
            vec_push(cols, boila_sel_item_out_name(it))
            vec_push(tags, ty)
        } else {
            if it.sfn != "" {
                // Q-sfn: name + static type from the first argument
                let mut t0: i64 = boila_v_str()
                if vec_len(it.sfn_cols) > 0 {
                    let cn = vec_get(it.sfn_cols, 0)
                    if cn != "" {
                        let cix0 = boila_col_idx(t, cn)
                        if cix0 < 0 {
                            return BoilaPgMeta { ok: 0, cols: cols, tags: tags, nparams: np, s: s }
                        }
                        t0 = vec_get(t.cols, cix0).typ
                    } else {
                        t0 = vec_get(it.sfn_vals, 0).tag
                    }
                }
                vec_push(cols, boila_sel_item_out_name(it))
                vec_push(tags, boila_sfn_out_type(it.sfn, t0))
            } else {
                if it.agg > 0 {
                    vec_push(cols, it.col)
                    vec_push(tags, boila_v_i64())
                } else {
                    let cix = boila_col_idx(t, it.col)
                    if cix < 0 {
                        return BoilaPgMeta { ok: 0, cols: cols, tags: tags, nparams: np, s: s }
                    }
                    let cd = vec_get(t.cols, cix)
                    vec_push(cols, cd.name)
                    vec_push(tags, cd.typ)
                }
            }
        }
        k = k + 1
    }
    return BoilaPgMeta { ok: 1, cols: cols, tags: tags, nparams: np, s: s }
}

fn boila_pg_desc_buf(m: BoilaPgMeta, is_stmt: i64) -> bytes {
    if m.ok == 0 {
        if is_stmt == 1 {
            return bytes_concat(pgw_param_desc(m.nparams), pgw_no_data())
        }
        return pgw_no_data()
    }
    let mut buf = bytes_new(0)
    if is_stmt == 1 {
        buf = pgw_param_desc(m.nparams)
    }
    buf = bytes_concat(buf, pgw_row_desc_typed(m.cols, m.tags))
    return buf
}

// Resolve Describe body → (kind==1 sel, is_stmt).
struct BoilaPgDescReq {
    is_stmt: i64,
    has_sel: i64,
    sel: BoilaSel
}

fn boila_pg_desc_req(stmts: Map<str, BoilaPgStmt>, portals: Map<str, BoilaPgPortal>, body: bytes) -> BoilaPgDescReq {
    let kind = bytes_at(body, 0) & 255
    let nm = pgw_cstr_read(body, 1)
    let mut is_stmt: i64 = 0
    if kind == 83 { is_stmt = 1 }
    let mut has: i64 = 0
    let mut sel = boila_sel_empty()
    if is_stmt == 1 {
        if map_has(stmts, nm.s) == 1 {
            let st = map_get(stmts, nm.s)
            if st.kind == 1 { has = 1; sel = st.sel }
        }
    } else {
        if map_has(portals, nm.s) == 1 {
            let p = map_get(portals, nm.s)
            if p.kind == 1 { has = 1; sel = p.sel }
        }
    }
    return BoilaPgDescReq { is_stmt: is_stmt, has_sel: has, sel: sel }
}

fn boila_pg_describe_on(s: BoilaStore, req: BoilaPgDescReq) -> BoilaPgMeta !IO !Time !Par {
    if req.has_sel == 0 {
        let cols: Vec<str> = vec_new()
        let tags: Vec<i64> = vec_new()
        return BoilaPgMeta { ok: 0, cols: cols, tags: tags, nparams: 0, s: s }
    }
    return boila_pg_sel_meta(s, req.sel)?
}

struct BoilaPgDescBuf {
    srv: BoilaServer,
    buf: bytes
}

// W5: full Describe response (pack=0 by-value srv; pack!=0 mt checkout).
fn boila_pg_describe_buf(pack: i64, srv: BoilaServer, db: str, stmts: Map<str, BoilaPgStmt>, portals: Map<str, BoilaPgPortal>, body: bytes) -> BoilaPgDescBuf !IO !Time !Par {
    let req = boila_pg_desc_req(stmts, portals, body)
    let mut buf = pgw_no_data()
    let mut srv2 = srv
    if req.has_sel == 1 {
        if pack == 0 {
            let g = boila_srv_db(srv2, db)?
            if g.ok == 1 {
                let m = boila_pg_describe_on(g.store, req)?
                srv2 = boila_srv_store_putback(g.srv, db, m.s)
                buf = boila_pg_desc_buf(m, req.is_stmt)
            }
        } else {
            let g = boila_mt_checkout(pack, db)?
            if g.ok == 1 {
                let m = boila_pg_describe_on(g.store, req)?
                boila_mt_checkin(pack, db, m.s)?
                buf = boila_pg_desc_buf(m, req.is_stmt)
            }
        }
    } else {
        if req.is_stmt == 1 {
            buf = bytes_concat(pgw_param_desc(0), pgw_no_data())
        }
    }
    return BoilaPgDescBuf { srv: srv2, buf: buf }
}
