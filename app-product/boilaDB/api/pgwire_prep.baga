// pgwire_prep.baga — W2 prepared AST + W5 Describe metadata.

import "pgwire_enc.baga"
import "pgwire_msg.baga"
import "../sql/lexer.baga"
import "../sql/token.baga"
import "../sql/parse_select.baga"
import "../sql/parse_insert.baga"
import "../sql/parse_dml.baga"
import "../sql/plan_cache.baga"
import "../sql/ast.baga"
import "../sql/exec_select.baga"
import "../sql/exec_scan.baga"
import "../catalog/schema.baga"
import "pgwire_dml.baga"
import "../storage/shards.baga"
import "../storage/databases.baga"
import "../txn/mvcc.baga"
import "../core/value.baga"
import "serve_mt.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"
import "std/net/tcp.baga"

// kind: 0 text, 1 SELECT, 2 INSERT, 3 UPDATE, 4 DELETE
struct BoilaPgStmt {
    sql: str,
    kind: i64,
    sel: BoilaSel,
    ins: BoilaIns,
    upd: BoilaUpd,
    del: BoilaDel
}

struct BoilaPgPortal {
    sql: str,
    vals: Vec<str>,
    nulls: Vec<i64>,
    kind: i64,
    sel: BoilaSel,
    ins: BoilaIns,
    upd: BoilaUpd,
    del: BoilaDel
}

fn boila_pg_stmt_text(sql: str) -> BoilaPgStmt {
    return BoilaPgStmt {
        sql: sql, kind: 0, sel: boila_sel_empty(),
        ins: boila_ins_empty(), upd: boila_upd_empty(), del: boila_del_empty()
    }
}

fn boila_pg_portal_empty() -> BoilaPgPortal {
    let vals: Vec<str> = vec_new()
    let nulls: Vec<i64> = vec_new()
    return BoilaPgPortal {
        sql: "", vals: vals, nulls: nulls, kind: 0,
        sel: boila_sel_empty(), ins: boila_ins_empty(),
        upd: boila_upd_empty(), del: boila_del_empty()
    }
}

fn boila_pg_bind_sel(sel: BoilaSel, vals: Vec<str>, nulls: Vec<i64>) -> BoilaSel {
    let mut s = sel
    if s.eq_param > 0 { s.pk_eq = boila_pg_pick(vals, nulls, s.eq_param) }
    if s.lo_param > 0 { s.pk_lo = boila_pg_pick(vals, nulls, s.lo_param) }
    if s.hi_param > 0 { s.pk_hi = boila_pg_pick(vals, nulls, s.hi_param) }
    if s.ne_param > 0 { s.pk_ne = boila_pg_pick(vals, nulls, s.ne_param) }
    if s.lim_param > 0 {
        let v = boila_pg_pick(vals, nulls, s.lim_param)
        if v.tag == boila_v_i64() { s.limit = v.i }
    }
    return s
}

fn boila_pg_parse_stmt(stmts: Map<str, BoilaPgStmt>, body: bytes) -> Map<str, BoilaPgStmt> {
    let nm = pgw_cstr_read(body, 0)
    let q = pgw_cstr_read(body, nm.pos)
    map_set(stmts, nm.s, boila_pg_try_sel(q.s))
    return stmts
}

fn boila_pg_bind_portal(stmts: Map<str, BoilaPgStmt>, portals: Map<str, BoilaPgPortal>, body: bytes) -> Map<str, BoilaPgPortal> {
    let pn = pgw_cstr_read(body, 0)
    let sn = pgw_cstr_read(body, pn.pos)
    let mut p = sn.pos
    let nf = pgw_be_read(body, p, 2)
    p = p + 2
    if nf == 1 { p = p + 2 } else { p = p + 2 * nf }
    let np = pgw_be_read(body, p, 2)
    p = p + 2
    let vals: Vec<str> = vec_new()
    let nulls: Vec<i64> = vec_new()
    let mut i: i64 = 0
    while i < np {
        let ln = pgw_be_read(body, p, 4)
        p = p + 4
        if ln >= 2147483648 {
            vec_push(vals, ""); vec_push(nulls, 1)
        } else {
            vec_push(vals, str_of_bytes(bytes_slice(body, p, p + ln)))
            vec_push(nulls, 0)
            p = p + ln
        }
        i = i + 1
    }
    let mut portal = boila_pg_portal_empty()
    if map_has(stmts, sn.s) == 1 {
        let st = map_get(stmts, sn.s)
        portal.sql = st.sql
        portal.vals = vals
        portal.nulls = nulls
        portal.kind = st.kind
        if st.kind == 1 { portal.sel = boila_pg_bind_sel(st.sel, vals, nulls) }
        if st.kind == 2 { portal.ins = boila_pg_bind_ins(st.ins, vals, nulls) }
        if st.kind == 3 { portal.upd = boila_pg_bind_upd(st.upd, vals, nulls) }
        if st.kind == 4 { portal.del = boila_pg_bind_del(st.del, vals, nulls) }
    }
    map_set(portals, pn.s, portal)
    return portals
}

// Parse-time: SELECT/INSERT/UPDATE/DELETE AST; else text-only.
fn boila_pg_try_sel(sql: str) -> BoilaPgStmt {
    let lx = boila_lex(sql)
    if lx.err != "" {
        return boila_pg_stmt_text(sql)
    }
    if vec_len(lx.toks) < 1 {
        return boila_pg_stmt_text(sql)
    }
    let t0 = vec_get(lx.toks, 0)
    if tok_kw(t0, "select") == 1 {
        let ps = boila_parse_select(lx)
        if ps.ok == 0 { return boila_pg_stmt_text(sql) }
        return BoilaPgStmt {
            sql: sql, kind: 1, sel: ps.sel,
            ins: boila_ins_empty(), upd: boila_upd_empty(), del: boila_del_empty()
        }
    }
    if tok_kw(t0, "insert") == 1 {
        let pi = boila_parse_insert(lx)
        if pi.ok == 0 { return boila_pg_stmt_text(sql) }
        return BoilaPgStmt {
            sql: sql, kind: 2, sel: boila_sel_empty(),
            ins: pi.ins, upd: boila_upd_empty(), del: boila_del_empty()
        }
    }
    if tok_kw(t0, "update") == 1 {
        let pu = boila_parse_update(lx)
        if pu.ok == 0 { return boila_pg_stmt_text(sql) }
        return BoilaPgStmt {
            sql: sql, kind: 3, sel: boila_sel_empty(),
            ins: boila_ins_empty(), upd: pu.upd, del: boila_del_empty()
        }
    }
    if tok_kw(t0, "delete") == 1 {
        let pd = boila_parse_delete(lx)
        if pd.ok == 0 { return boila_pg_stmt_text(sql) }
        return BoilaPgStmt {
            sql: sql, kind: 4, sel: boila_sel_empty(),
            ins: boila_ins_empty(), upd: boila_upd_empty(), del: pd.del
        }
    }
    return boila_pg_stmt_text(sql)
}

// Run bound SELECT on a store (catalog resolve each Execute).
fn boila_pg_exec_sel(s: BoilaStore, txn: BoilaTxn, sel: BoilaSel) -> BoilaExec !IO !Time !Par {
    let ct = boila_cat_by_name_txn(s, txn, sel.table)?
    s = ct.s
    if ct.ok == 0 {
        return boila_exec_fail(s, txn, ct.err, ct.state)
    }
    return boila_exec_select(s, txn, ct.table, sel)?
}

// Max $N index referenced by sel (0 = none).
fn boila_pg_nparams(sel: BoilaSel) -> i64 {
    let mut n: i64 = 0
    if sel.eq_param > n { n = sel.eq_param }
    if sel.lo_param > n { n = sel.lo_param }
    if sel.hi_param > n { n = sel.hi_param }
    if sel.ne_param > n { n = sel.ne_param }
    if sel.lim_param > n { n = sel.lim_param }
    return n
}

// W5: column names+tags from SELECT + table (no JOIN / agg → empty ok=0).
struct BoilaPgMeta {
    ok: i64,
    cols: Vec<str>,
    tags: Vec<i64>,
    nparams: i64,
    s: BoilaStore
}

fn boila_pg_sel_meta(s: BoilaStore, sel: BoilaSel) -> BoilaPgMeta !IO !Time !Par {
    let cols: Vec<str> = vec_new()
    let tags: Vec<i64> = vec_new()
    let np = boila_pg_nparams(sel)
    if sel.has_join == 1 || sel.has_group == 1 {
        return BoilaPgMeta { ok: 0, cols: cols, tags: tags, nparams: np, s: s }
    }
    // Describe uses committed catalog (no session txn on this path)
    let ct = boila_cat_by_name(s, sel.table)?
    s = ct.s
    if ct.ok == 0 {
        return BoilaPgMeta { ok: 0, cols: cols, tags: tags, nparams: np, s: s }
    }
    let t = ct.table
    if sel.star == 1 {
        let mut i: i64 = 0
        while i < vec_len(t.cols) {
            let cd = vec_get(t.cols, i)
            vec_push(cols, cd.name)
            vec_push(tags, cd.typ)
            i = i + 1
        }
        return BoilaPgMeta { ok: 1, cols: cols, tags: tags, nparams: np, s: s }
    }
    let mut k: i64 = 0
    while k < vec_len(sel.items) {
        let it = vec_get(sel.items, k)
        if it.agg > 0 {
            vec_push(cols, it.col)
            vec_push(tags, boila_v_i64())
        } else {
            let cix = boila_col_idx(t, it.col)
            if cix < 0 {
                return BoilaPgMeta { ok: 0, cols: cols, tags: tags, nparams: np, s: s }
            }
            let cd = vec_get(t.cols, cix)
            vec_push(cols, cd.name)
            vec_push(tags, cd.typ)
        }
        k = k + 1
    }
    return BoilaPgMeta { ok: 1, cols: cols, tags: tags, nparams: np, s: s }
}

fn boila_pg_desc_buf(m: BoilaPgMeta, is_stmt: i64) -> bytes {
    if m.ok == 0 {
        if is_stmt == 1 {
            return bytes_concat(pgw_param_desc(m.nparams), pgw_no_data())
        }
        return pgw_no_data()
    }
    let mut buf = bytes_new(0)
    if is_stmt == 1 {
        buf = pgw_param_desc(m.nparams)
    }
    buf = bytes_concat(buf, pgw_row_desc_typed(m.cols, m.tags))
    return buf
}

// Resolve Describe body → (kind==1 sel, is_stmt).
struct BoilaPgDescReq {
    is_stmt: i64,
    has_sel: i64,
    sel: BoilaSel
}

fn boila_pg_desc_req(stmts: Map<str, BoilaPgStmt>, portals: Map<str, BoilaPgPortal>, body: bytes) -> BoilaPgDescReq {
    let kind = bytes_at(body, 0) & 255
    let nm = pgw_cstr_read(body, 1)
    let mut is_stmt: i64 = 0
    if kind == 83 { is_stmt = 1 }
    let mut has: i64 = 0
    let mut sel = boila_sel_empty()
    if is_stmt == 1 {
        if map_has(stmts, nm.s) == 1 {
            let st = map_get(stmts, nm.s)
            if st.kind == 1 { has = 1; sel = st.sel }
        }
    } else {
        if map_has(portals, nm.s) == 1 {
            let p = map_get(portals, nm.s)
            if p.kind == 1 { has = 1; sel = p.sel }
        }
    }
    return BoilaPgDescReq { is_stmt: is_stmt, has_sel: has, sel: sel }
}

fn boila_pg_describe_on(s: BoilaStore, req: BoilaPgDescReq) -> BoilaPgMeta !IO !Time !Par {
    if req.has_sel == 0 {
        let cols: Vec<str> = vec_new()
        let tags: Vec<i64> = vec_new()
        return BoilaPgMeta { ok: 0, cols: cols, tags: tags, nparams: 0, s: s }
    }
    return boila_pg_sel_meta(s, req.sel)?
}

struct BoilaPgDescBuf {
    srv: BoilaServer,
    buf: bytes
}

// W5: full Describe response (pack=0 by-value srv; pack!=0 mt checkout).
fn boila_pg_describe_buf(pack: i64, srv: BoilaServer, db: str, stmts: Map<str, BoilaPgStmt>, portals: Map<str, BoilaPgPortal>, body: bytes) -> BoilaPgDescBuf !IO !Time !Par {
    let req = boila_pg_desc_req(stmts, portals, body)
    let mut buf = pgw_no_data()
    let mut srv2 = srv
    if req.has_sel == 1 {
        if pack == 0 {
            let g = boila_srv_db(srv2, db)?
            if g.ok == 1 {
                let m = boila_pg_describe_on(g.store, req)?
                srv2 = boila_srv_store_putback(g.srv, db, m.s)
                buf = boila_pg_desc_buf(m, req.is_stmt)
            }
        } else {
            let g = boila_mt_checkout(pack, db)?
            if g.ok == 1 {
                let m = boila_pg_describe_on(g.store, req)?
                boila_mt_checkin(pack, db, m.s)?
                buf = boila_pg_desc_buf(m, req.is_stmt)
            }
        }
    } else {
        if req.is_stmt == 1 {
            buf = bytes_concat(pgw_param_desc(0), pgw_no_data())
        }
    }
    return BoilaPgDescBuf { srv: srv2, buf: buf }
}
