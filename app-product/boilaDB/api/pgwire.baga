// pgwire.baga — PG wire v3 (P6): startup/auth, simple+extended, $N prep.
import "pgwire_msg.baga"
import "pgwire_enc.baga"
import "pgwire_prep.baga"
import "pgwire_dml.baga"
import "../server/databases.baga"
import "../server/exec_server.baga"
import "../sql/exec_scan.baga"
import "../sql/ast.baga"
import "pgwire_guc.baga"
import "pgwire_auth.baga"
import "../txn/mvcc.baga"
import "serve_mt.baga"
import "../core/value.baga"
import "std/net/tcp.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"
import "std/crypto/ct.baga"

struct BoilaPgSess {
    stmts: Map<str, BoilaPgStmt>,
    portals: Map<str, BoilaPgPortal>,
    db: str,
    txn: BoilaTxn,
    guc: Map<str, str>,
    // MEM-4: споделени празни AST-та за неизползваните kind-ове във всеки
    // portal (иначе boila_pg_portal_empty пускаше ~45 vec-а на Bind, които
    // после се free-ваха — чист churn в persist региона). Само за четене;
    // никога не се drop-ват (portal_free пипа само използвания kind).
    e_sel: BoilaSel,
    e_ins: BoilaIns,
    e_upd: BoilaUpd,
    e_del: BoilaDel
}
fn boila_pg_sess_new(db: str) -> BoilaPgSess {
    let sm: Map<str, BoilaPgStmt> = map_new()
    let pm: Map<str, BoilaPgPortal> = map_new()
    let guc: Map<str, str> = map_new()
    return BoilaPgSess { stmts: sm, portals: pm, db: db, txn: boila_txn_new(), guc: guc,
        e_sel: boila_sel_empty(), e_ins: boila_ins_empty(),
        e_upd: boila_upd_empty(), e_del: boila_del_empty() }
}
struct BoilaPgOut {
    srv: BoilaServer,
    sess: BoilaPgSess,
    ok: i64,
    sql_err: i64,
    err: str
}
fn pgw_write(fd: i64, b: bytes) -> i64 !Net !IO !Par { return tcp_write_bytes(fd, b)? }
fn pgw_send_startup_tail(fd: i64, tx: i64) -> i64 !Net !IO !Par {
    let mut out = pgw_param_status("server_version", "16.0 (boilaDB 0.1.0)")
    out = bytes_concat(out, pgw_param_status("server_encoding", "UTF8"))
    out = bytes_concat(out, pgw_param_status("client_encoding", "UTF8"))
    out = bytes_concat(out, pgw_param_status("DateStyle", "ISO, MDY"))
    out = bytes_concat(out, pgw_param_status("TimeZone", "UTC"))
    out = bytes_concat(out, pgw_param_status("IntervalStyle", "postgres"))
    out = bytes_concat(out, pgw_param_status("integer_datetimes", "on"))
    out = bytes_concat(out, pgw_param_status("standard_conforming_strings", "on"))
    out = bytes_concat(out, pgw_param_status("application_name", ""))
    let mut bk = pgw_be32(1)
    bk = bytes_concat(bk, pgw_be32(0))
    out = bytes_concat(out, pgw_msg(75, bk))
    out = bytes_concat(out, pgw_ready(tx))
    return pgw_write(fd, out)
}
fn pgw_tx_status(sess: BoilaPgSess) -> i64 {
    if sess.txn.active == 1 { return 84 }
    return 73
}
fn pgw_exec_locked(pack: i64, srv: BoilaServer, txn: BoilaTxn, db: str, sql: str, guc: Map<str, str>) -> BoilaSrvOut !IO !Time !Par {
    if pack == 0 {
        srv.guc = guc
        let out = boila_server_exec_tx(srv, txn, db, sql)?
        // keep session guc keys (user/super) if exec replaced guc map
        return out
    }
    return boila_mt_exec_guc(pack, txn, db, sql, guc)?
}
fn pgw_exec_sel_locked(pack: i64, srv: BoilaServer, txn: BoilaTxn, db: str, sel: BoilaSel) -> BoilaSrvOut !IO !Time !Par {
    if pack == 0 { return boila_server_exec_sel(srv, txn, db, sel)? }
    return boila_mt_exec_sel(pack, txn, db, sel)?
}
fn pgw_write_out(fd: i64, srv: BoilaServer, sess: BoilaPgSess, out: BoilaSrvOut, send_ready: i64) -> BoilaPgOut !IO !Net !Time !Par {
    let mut srv2 = out.srv
    let mut sess2 = sess
    sess2.txn = out.txn
    if out.ok == 0 {
        let mut buf = pgw_error(out.state, out.err)
        if send_ready == 1 { buf = bytes_concat(buf, pgw_ready(pgw_tx_status(sess2))) }
        let w = pgw_write(fd, buf)?
        if w != 0 { return BoilaPgOut { srv: srv2, sess: sess2, ok: 0, sql_err: 1, err: "write error" } }
        return BoilaPgOut { srv: srv2, sess: sess2, ok: 1, sql_err: 1, err: "" }
    }
    let mut buf = bytes_new(0)
    if out.kind == 1 || vec_len(out.res.rows) > 0 {
        buf = bytes_concat(buf, pgw_row_desc_typed(out.res.cols, out.res.tags))
        let mut i: i64 = 0
        while i < vec_len(out.res.rows) {
            buf = bytes_concat(buf, pgw_data_row(vec_get(out.res.rows, i)))
            i = i + 1
        }
    }
    buf = bytes_concat(buf, pgw_command_complete(pgw_tag(out.kind, out.id, vec_len(out.res.rows))))
    if send_ready == 1 { buf = bytes_concat(buf, pgw_ready(pgw_tx_status(sess2))) }
    let w = pgw_write(fd, buf)?
    if w != 0 { return BoilaPgOut { srv: srv2, sess: sess2, ok: 0, sql_err: 0, err: "write error" } }
    return BoilaPgOut { srv: srv2, sess: sess2, ok: 1, sql_err: 0, err: "" }
}
fn pgw_note_pg(pack: i64) -> i64 !Par {
    if pack != 0 { boila_mt_stat_inc(pack, boila_st_pg())? }
    return 0
}
// W7b: per-conn GUC; DISCARD ALL drops prep state.
fn pgw_run_sql(fd: i64, pack: i64, srv: BoilaServer, sess: BoilaPgSess, sql: str, send_ready: i64) -> BoilaPgOut !IO !Net !Time !Par {
    pgw_note_pg(pack)?
    let gh = pgw_try_sess_guc(srv, sess.txn, sess.db, sess.guc, sql)
    if gh.hit == 1 {
        sess.guc = gh.sess_guc
        if gh.clear_prep == 1 {
            // MEM-4: заместващите session maps трябва да преживеят rewind
            mem_persist_begin()
            sess.stmts = map_new()
            sess.portals = map_new()
            mem_persist_end()
        }
        return pgw_write_out(fd, srv, sess, gh.out, send_ready)?
    }
    let out = pgw_exec_locked(pack, srv, sess.txn, sess.db, sql, sess.guc)?
    // session guc (incl. boila.user) follows server after exec
    if pack == 0 { sess.guc = out.srv.guc }
    return pgw_write_out(fd, out.srv, sess, out, send_ready)?
}

fn pgw_run_sel(fd: i64, pack: i64, srv: BoilaServer, sess: BoilaPgSess, sel: BoilaSel, send_ready: i64) -> BoilaPgOut !IO !Net !Time !Par {
    pgw_note_pg(pack)?
    let out = pgw_exec_sel_locked(pack, srv, sess.txn, sess.db, sel)?
    return pgw_write_out(fd, srv, sess, out, send_ready)?
}

fn pgw_run_ins(fd: i64, pack: i64, srv: BoilaServer, sess: BoilaPgSess, ins: BoilaIns, send_ready: i64) -> BoilaPgOut !IO !Net !Time !Par {
    pgw_note_pg(pack)?
    if pack == 0 {
        return pgw_write_out(fd, srv, sess, boila_server_exec_ins(srv, sess.txn, sess.db, ins)?, send_ready)?
    }
    return pgw_write_out(fd, srv, sess, boila_mt_exec_ins(pack, sess.txn, sess.db, ins)?, send_ready)?
}

fn pgw_run_upd(fd: i64, pack: i64, srv: BoilaServer, sess: BoilaPgSess, upd: BoilaUpd, send_ready: i64) -> BoilaPgOut !IO !Net !Time !Par {
    pgw_note_pg(pack)?
    if pack == 0 {
        return pgw_write_out(fd, srv, sess, boila_server_exec_upd(srv, sess.txn, sess.db, upd)?, send_ready)?
    }
    return pgw_write_out(fd, srv, sess, boila_mt_exec_upd(pack, sess.txn, sess.db, upd)?, send_ready)?
}

fn pgw_run_del(fd: i64, pack: i64, srv: BoilaServer, sess: BoilaPgSess, del: BoilaDel, send_ready: i64) -> BoilaPgOut !IO !Net !Time !Par {
    pgw_note_pg(pack)?
    if pack == 0 {
        return pgw_write_out(fd, srv, sess, boila_server_exec_del(srv, sess.txn, sess.db, del)?, send_ready)?
    }
    return pgw_write_out(fd, srv, sess, boila_mt_exec_del(pack, sess.txn, sess.db, del)?, send_ready)?
}

// Execute dispatch. Не връщай през `let mut ro = BoilaPgOut { srv, sess }`
// в caller-а: свежият литерал се регистрира зад --rc и pop release-ва
// споделения srv от mt_exec (pack != 0) → rc underflow на PlanCache.
// fn резултатът не се регистрира (leak-safe), като Simple Query.
fn pgw_exec_portal(fd: i64, pack: i64, srv: BoilaServer, sess: BoilaPgSess, name: str) -> BoilaPgOut !IO !Net !Time !Par {
    if map_has(sess.portals, name) == 0 {
        return pgw_run_sql(fd, pack, srv, sess, "", 0)?
    }
    let portal = map_get(sess.portals, name)
    if portal.kind == 0 - 1 {
        return pgw_run_sql(fd, pack, srv, sess, "", 0)?
    }
    if portal.kind == 1 {
        return pgw_run_sel(fd, pack, srv, sess, portal.sel, 0)?
    }
    if portal.kind == 2 {
        return pgw_run_ins(fd, pack, srv, sess, portal.ins, 0)?
    }
    if portal.kind == 3 {
        return pgw_run_upd(fd, pack, srv, sess, portal.upd, 0)?
    }
    if portal.kind == 4 {
        return pgw_run_del(fd, pack, srv, sess, portal.del, 0)?
    }
    let full = pgw_subst_params(portal.sql, portal.vals, portal.nulls)
    return pgw_run_sql(fd, pack, srv, sess, full, 0)?
}

fn pgw_do_parse(body: bytes, sess: BoilaPgSess) -> BoilaPgSess {
    let mut s2 = sess
    // MEM-4: prepared stmt AST + име живеят в сесията след rewind-а на
    // заявката → persist регион. map_set мутира на място; assign на
    // същата карта зад --rc release-ва живия stmts map.
    mem_persist_begin()
    boila_pg_parse_stmt(s2.stmts, s2.portals, body)
    mem_persist_end()
    return s2
}

fn pgw_do_bind(body: bytes, sess: BoilaPgSess) -> BoilaPgSess {
    let mut s2 = sess
    // MEM-4: portal-ът може да се Execute-не в по-късен batch → persist.
    // map_set мутира на място — не присвоявай същата карта (RC release).
    mem_persist_begin()
    boila_pg_bind_portal(s2.stmts, s2.portals, body, s2.e_sel, s2.e_ins, s2.e_upd, s2.e_del)
    mem_persist_end()
    return s2
}
