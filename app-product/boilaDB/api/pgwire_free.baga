// pgwire_free.baga — MEM-4 reclaim за prepared AST: пълен free на stmt
// (parse rebuild-ва всичко), частичен на portal (само bound полета),
// orphaned гард. Вика се от pgwire_prep (parse/bind) и от serve loop-а
// (Sync kill / Close). Зад --rc повечето пътеки са no-op.

import "pgwire_types.baga"
import "../sql/ast.baga"

// MEM-4: пълен free на AST vec полета — само за ОБЕКТИ, които ги притежават
// (stmt от parse; използва се от stmt_free през orphaned гарда).
fn boila_pg_sel_free_all(sel: BoilaSel) {
    let mut i: i64 = 0
    while i < vec_len(sel.items) {
        let it = vec_get(sel.items, i)
        let sc = it.sfn_cols
        drop(sc)
        let sv = it.sfn_vals
        drop(sv)
        let xt = it.xtoks
        drop(xt)
        i = i + 1
    }
    let items = sel.items
    drop(items)
    let oc = sel.ord_cols
    drop(oc)
    let od = sel.ord_desc
    drop(od)
    let gc = sel.group_cols
    drop(gc)
    let gx = sel.group_xtoks
    drop(gx)
    let mut h: i64 = 0
    while h < vec_len(sel.hav_preds) {
        let hp = vec_get(sel.hav_preds, h)
        let hxt = hp.xtoks
        drop(hxt)
        h = h + 1
    }
    let hpreds = sel.hav_preds
    drop(hpreds)
    let hnodes = sel.hav_nodes
    drop(hnodes)
    let jl = sel.join_lcols
    drop(jl)
    let jr = sel.join_rcols
    drop(jr)
    let ft = sel.fts_terms
    drop(ft)
    let fg = sel.fts_gaps
    drop(fg)
    let kp = sel.knn_pay
    drop(kp)
    let iv = sel.in_vals
    drop(iv)
    let xw = sel.xw_toks
    drop(xw)
}

fn boila_pg_ins_free_all(ins: BoilaIns) {
    let cols = ins.cols
    drop(cols)
    let rows = ins.rows
    drop(rows)
    let occ = ins.oc_cols
    drop(occ)
    let ocv = ins.oc_vals
    drop(ocv)
    let ocx = ins.oc_xtoks
    drop(ocx)
    let rc = ins.ret_cols
    drop(rc)
}

fn boila_pg_upd_free_all(upd: BoilaUpd) {
    let setc = upd.set_cols
    drop(setc)
    let setv = upd.set_vals
    drop(setv)
    let setx = upd.set_xtoks
    drop(setx)
    let xw = upd.xw_toks
    drop(xw)
    let rc = upd.ret_cols
    drop(rc)
}

fn boila_pg_del_free_all(del: BoilaDel) {
    let xw = del.xw_toks
    drop(xw)
    let rc = del.ret_cols
    drop(rc)
}

// Частичен free на PORTAL AST: само полетата, които boila_pg_bind_*
// пресъздават fresh при Bind. Останалите vec полета са shallow копия,
// СПОДЕЛЕНИ с кеширания prepared stmt — не се пипат.
fn boila_pg_sel_free_bound(sel: BoilaSel) {
    let mut i: i64 = 0
    while i < vec_len(sel.items) {
        let it = vec_get(sel.items, i)
        if vec_len(it.xtoks) > 0 {
            let xt = it.xtoks
            drop(xt)
        }
        if it.sfn != "" {
            let sv = it.sfn_vals
            drop(sv)
        }
        i = i + 1
    }
    let items = sel.items
    drop(items)
    let iv = sel.in_vals
    drop(iv)
    if sel.has_xw == 1 {
        let xw = sel.xw_toks
        drop(xw)
    }
}

fn boila_pg_ins_free_bound(ins: BoilaIns) {
    let rows = ins.rows
    drop(rows)
    let ocv = ins.oc_vals
    drop(ocv)
    let ocx = ins.oc_xtoks
    drop(ocx)
}

fn boila_pg_upd_free_bound(upd: BoilaUpd) {
    let setv = upd.set_vals
    drop(setv)
    let setx = upd.set_xtoks
    drop(setx)
    let xw = upd.xw_toks
    drop(xw)
}

fn boila_pg_del_free_bound(del: BoilaDel) {
    let xw = del.xw_toks
    drop(xw)
}

// MEM-4: reclaim на persist паметта на заместван/затварян portal. Free-ва
// vals/nulls + САМО използвания kind (bind_* го пресъздава fresh); другите
// три AST-та са споделените session празни — НЕ се пипат. kind == -1 =
// вече reclaim-нат (Sync kill) — no-op против double free. Vec<Vec<…>> drop
// е рекурсивен (mode 3): box-овете на вътрешните остават (документиран drip).
fn boila_pg_portal_free(p: BoilaPgPortal) {
    if rc_on() {
        return
    }
    if p.kind == 0 - 1 {
        return
    }
    let vals = p.vals
    drop(vals)
    let nulls = p.nulls
    drop(nulls)
    if p.kind == 1 {
        boila_pg_sel_free_bound(p.sel)
    }
    if p.kind == 2 {
        boila_pg_ins_free_bound(p.ins)
    }
    if p.kind == 3 {
        boila_pg_upd_free_bound(p.upd)
    }
    if p.kind == 4 {
        boila_pg_del_free_bound(p.del)
    }
}

// 1 ако никой portal не е bound от stmt `name` (безопасно за stmt_free).
// kind == -1 (reclaim-нат на Sync) не брои — мъртвият запис е inert.
fn boila_pg_stmt_orphaned(portals: Map<str, BoilaPgPortal>, name: str) -> i64 {
    let ks = map_keys(portals)
    let mut i: i64 = 0
    while i < vec_len(ks) {
        let p = map_get(portals, vec_get(ks, i))
        if p.kind != 0 - 1 {
            if p.src == name {
                return 0
            }
        }
        i = i + 1
    }
    return 1
}

// MEM-4: пълен reclaim на prepared stmt AST (за разлика от portal-а, stmt-ът
// притежава всичките си vec полета — parse ги гради fresh). Вика се само
// през orphaned гарда. Drip: str payload-и и вложени Vec<Token> box-ове не
// се free-ват (drop е по дълбочина 1; str е immortal в рантайма).
fn boila_pg_stmt_free(st: BoilaPgStmt) {
    if rc_on() {
        return
    }
    boila_pg_sel_free_all(st.sel)
    boila_pg_ins_free_all(st.ins)
    boila_pg_upd_free_all(st.upd)
    boila_pg_del_free_all(st.del)
}
