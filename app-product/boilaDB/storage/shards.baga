// shards.baga — N shard-а × rocksbaga.
//
// mt=0 (dbs_h==0): LsmCluster by-value — tests / single-thread.
// mt=1: Map<sid,LsmDB> + per-shard mutex (serve) — hop-less parallel
// ops on different shards; multi-shard ops lock 0..n-1 in order.
//
// No !Par on BoilaStore struct (typechecker OOM). !Par only on fns that
// lock. rocksbaga R55 model.

import "rocksbaga/db/shard.baga"
import "rocksbaga/db/engine.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "std/bytes/bytes.baga"

extern fn fdatasync(fd: i64) -> i64 !IO

struct BoilaStore {
    c: LsmCluster,
    dbs_h: i64,
    mus_h: i64,
    n: i64,
    ok: i64
}

struct BoilaGet {
    s: BoilaStore,
    found: i64,
    val: bytes
}

struct BoilaScan {
    s: BoilaStore,
    next: i64,
    keys: Vec<bytes>
}

fn boila_open(dir: str, nshards: i64, flush_at: i64, compact_at: i64) -> BoilaStore !IO !Par {
    let c = lsm_cluster_open(dir, nshards, flush_at, compact_at)?
    return BoilaStore { c: c, dbs_h: 0, mus_h: 0, n: c.n, ok: c.ok }
}

// Serve path: shards in shared Map + one mutex each (pre-insert all keys).
fn boila_open_mt(dir: str, nshards: i64, flush_at: i64, compact_at: i64) -> BoilaStore !IO !Par {
    let c = lsm_cluster_open(dir, nshards, flush_at, compact_at)?
    let dbs: Map<i64, LsmDB> = map_new()
    let mus: Map<i64, i64> = map_new()
    let mut i: i64 = 0
    while i < c.n {
        map_set(dbs, i, vec_get(c.shards, i))
        map_set(mus, i, mutex_new())
        i = i + 1
    }
    return BoilaStore { c: c, dbs_h: map_h(dbs), mus_h: map_h(mus), n: c.n, ok: c.ok }
}

fn boila_close(s: BoilaStore) -> i64 !IO !Par {
    if s.dbs_h == 0 {
        return lsm_cluster_close(s.c)?
    }
    let dbs: Map<i64, LsmDB> = h_map(s.dbs_h)
    let mut i: i64 = 0
    while i < s.n {
        lsm_close(map_get(dbs, i))?
        i = i + 1
    }
    return 0
}

fn boila_shards(s: BoilaStore) -> i64 {
    return s.n
}

fn boila_is_mt(s: BoilaStore) -> i64 {
    if s.dbs_h != 0 {
        return 1
    }
    return 0
}

fn boila_shard_lock(s: BoilaStore, ix: i64) -> i64 !Par {
    let mus: Map<i64, i64> = h_map(s.mus_h)
    let mu = map_get(mus, ix)
    mutex_lock(mu)
    return mu
}

fn boila_all_lock(s: BoilaStore) -> i64 !Par {
    let mut i: i64 = 0
    while i < s.n {
        boila_shard_lock(s, i)?
        i = i + 1
    }
    return 0
}

fn boila_all_unlock(s: BoilaStore) -> i64 !Par {
    let mut i = s.n - 1
    while i >= 0 {
        let mus: Map<i64, i64> = h_map(s.mus_h)
        mutex_unlock(map_get(mus, i))
        i = i - 1
    }
    return 0
}

fn boila_put(s: BoilaStore, cf: i64, table_id: i64, pk: bytes, val: bytes) -> BoilaStore !IO !Time !Par {
    let key = boila_key_row(cf, table_id, pk)
    if s.dbs_h == 0 {
        let c = lsm_cluster_put_kb(s.c, key, val)?
        return BoilaStore { c: c, dbs_h: 0, mus_h: 0, n: c.n, ok: c.ok }
    }
    let ix = lsm_shard_ix_b(s.n, key)
    let mu = boila_shard_lock(s, ix)?
    let dbs: Map<i64, LsmDB> = h_map(s.dbs_h)
    let mut db = map_get(dbs, ix)
    db = lsm_put_kb(db, key, val)?
    map_set(dbs, ix, db)
    let ok = db.ok
    mutex_unlock(mu)
    return BoilaStore { c: s.c, dbs_h: s.dbs_h, mus_h: s.mus_h, n: s.n, ok: ok }
}

// put with optional TTL (ttl_sec<=0 → plain put). Caller resolves TTL
// (kimi-deps D3 — txn commit must not import ts/).
fn boila_put_ex(s: BoilaStore, cf: i64, table_id: i64, pk: bytes, val: bytes, ttl_sec: i64) -> BoilaStore !IO !Time !Par {
    if ttl_sec <= 0 {
        return boila_put(s, cf, table_id, pk, val)?
    }
    let key = boila_key_row(cf, table_id, pk)
    if s.dbs_h == 0 {
        let c = lsm_cluster_put_ex_kb(s.c, key, val, ttl_sec)?
        return BoilaStore { c: c, dbs_h: 0, mus_h: 0, n: c.n, ok: c.ok }
    }
    let ix = lsm_shard_ix_b(s.n, key)
    let mu = boila_shard_lock(s, ix)?
    let dbs: Map<i64, LsmDB> = h_map(s.dbs_h)
    let mut db = map_get(dbs, ix)
    db = lsm_put_ex_kb(db, key, val, ttl_sec)?
    map_set(dbs, ix, db)
    let ok = db.ok
    mutex_unlock(mu)
    return BoilaStore { c: s.c, dbs_h: s.dbs_h, mus_h: s.mus_h, n: s.n, ok: ok }
}

fn boila_get(s: BoilaStore, cf: i64, table_id: i64, pk: bytes) -> BoilaGet !IO !Time !Par {
    let key = boila_key_row(cf, table_id, pk)
    if s.dbs_h == 0 {
        let g = lsm_cluster_get_kb(s.c, key)?
        return BoilaGet {
            s: BoilaStore { c: g.c, dbs_h: 0, mus_h: 0, n: g.c.n, ok: g.c.ok },
            found: g.found, val: g.val
        }
    }
    let ix = lsm_shard_ix_b(s.n, key)
    let mu = boila_shard_lock(s, ix)?
    let dbs: Map<i64, LsmDB> = h_map(s.dbs_h)
    let g = lsm_get_kb(map_get(dbs, ix), key)?
    map_set(dbs, ix, g.db)
    mutex_unlock(mu)
    return BoilaGet { s: s, found: g.found, val: g.val }
}

fn boila_del(s: BoilaStore, cf: i64, table_id: i64, pk: bytes) -> BoilaStore !IO !Time !Par {
    let key = boila_key_row(cf, table_id, pk)
    if s.dbs_h == 0 {
        let c = lsm_cluster_del_kb(s.c, key)?
        return BoilaStore { c: c, dbs_h: 0, mus_h: 0, n: c.n, ok: c.ok }
    }
    let ix = lsm_shard_ix_b(s.n, key)
    let mu = boila_shard_lock(s, ix)?
    let dbs: Map<i64, LsmDB> = h_map(s.dbs_h)
    let mut db = map_get(dbs, ix)
    db = lsm_del_kb(db, key)?
    map_set(dbs, ix, db)
    let ok = db.ok
    mutex_unlock(mu)
    return BoilaStore { c: s.c, dbs_h: s.dbs_h, mus_h: s.mus_h, n: s.n, ok: ok }
}

// K2/K2b: true byte-prefix scan (no glob). pref = full key prefix
// (cf|table, or cf|table|ix|val for secondary exact lookup).
fn boila_scan_pref(s: BoilaStore, pref: bytes, cursor: i64, count: i64) -> BoilaScan !IO !Time !Par {
    if s.dbs_h == 0 {
        let r = lsm_cluster_scan_prefix_kb(s.c, cursor, count, pref)?
        return BoilaScan {
            s: BoilaStore { c: r.c, dbs_h: 0, mus_h: 0, n: r.c.n, ok: r.c.ok },
            next: r.next, keys: r.keys
        }
    }
    // Per-shard lock (no all_lock): collect matches, paginate by cursor index.
    let dbs: Map<i64, LsmDB> = h_map(s.dbs_h)
    let all: Vec<bytes> = vec_new()
    let mut si: i64 = 0
    let mut ok: i64 = 1
    while si < s.n {
        let mu = boila_shard_lock(s, si)?
        let mut db = map_get(dbs, si)
        let mut sc = 0
        let mut done = false
        while done == false {
            let r = lsm_scan_prefix_kb(db, sc, 256, pref)?
            db = r.db
            let mut j: i64 = 0
            while j < vec_len(r.keys) {
                vec_push(all, vec_get(r.keys, j))
                j = j + 1
            }
            sc = r.next
            if sc == 0 {
                done = true
            }
        }
        ok = db.ok
        map_set(dbs, si, db)
        mutex_unlock(mu)
        si = si + 1
    }
    let keys: Vec<bytes> = vec_new()
    let mut i = cursor
    let mut nout: i64 = 0
    while i < vec_len(all) && nout < count {
        vec_push(keys, vec_get(all, i))
        i = i + 1
        nout = nout + 1
    }
    let mut next: i64 = 0
    if i < vec_len(all) {
        next = i
    }
    return BoilaScan {
        s: BoilaStore { c: s.c, dbs_h: s.dbs_h, mus_h: s.mus_h, n: s.n, ok: ok },
        next: next, keys: keys
    }
}

fn boila_scan(s: BoilaStore, cf: i64, table_id: i64, cursor: i64, count: i64) -> BoilaScan !IO !Time !Par {
    return boila_scan_pref(s, boila_key_prefix(cf, table_id), cursor, count)?
}

fn boila_flush(s: BoilaStore) -> BoilaStore !IO !Time !Par {
    if s.dbs_h == 0 {
        let c = lsm_cluster_flush_force(s.c)?
        return BoilaStore { c: c, dbs_h: 0, mus_h: 0, n: c.n, ok: c.ok }
    }
    boila_all_lock(s)?
    let dbs: Map<i64, LsmDB> = h_map(s.dbs_h)
    let mut ok: i64 = 1
    let mut i: i64 = 0
    while i < s.n {
        let mut db = map_get(dbs, i)
        db = lsm_flush_force(db)?
        map_set(dbs, i, db)
        ok = db.ok
        i = i + 1
    }
    boila_all_unlock(s)?
    return BoilaStore { c: s.c, dbs_h: s.dbs_h, mus_h: s.mus_h, n: s.n, ok: ok }
}

fn boila_stmt_begin(s: BoilaStore) -> BoilaStore !Par {
    if s.dbs_h == 0 {
        let c = lsm_cluster_apply_sync(s.c, 1000000000)
        return BoilaStore { c: c, dbs_h: 0, mus_h: 0, n: c.n, ok: s.ok }
    }
    boila_all_lock(s)?
    let dbs: Map<i64, LsmDB> = h_map(s.dbs_h)
    let mut i: i64 = 0
    while i < s.n {
        let mut db = map_get(dbs, i)
        db.sync_every = 1000000000
        map_set(dbs, i, db)
        i = i + 1
    }
    boila_all_unlock(s)?
    return s
}

fn boila_stmt_commit(s: BoilaStore) -> BoilaStore !IO !Par {
    if s.dbs_h == 0 {
        let mut c = s.c
        let mut i: i64 = 0
        while i < c.n {
            let mut db = vec_get(c.shards, i)
            db = lsm_wal_flush_buf(db)?
            if db.wal_fd >= 0 {
                fdatasync(db.wal_fd)?
            }
            vec_set(c.shards, i, db)
            i = i + 1
        }
        c = lsm_cluster_apply_sync(c, 1)
        return BoilaStore { c: c, dbs_h: 0, mus_h: 0, n: c.n, ok: s.ok }
    }
    boila_all_lock(s)?
    let dbs: Map<i64, LsmDB> = h_map(s.dbs_h)
    let mut i: i64 = 0
    while i < s.n {
        let mut db = map_get(dbs, i)
        db = lsm_wal_flush_buf(db)?
        if db.wal_fd >= 0 {
            fdatasync(db.wal_fd)?
        }
        db.sync_every = 1
        map_set(dbs, i, db)
        i = i + 1
    }
    boila_all_unlock(s)?
    return s
}
