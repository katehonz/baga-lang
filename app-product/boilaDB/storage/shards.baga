// shards.baga — storage фасадата на boilaDB: N shard-а × rocksbaga.
//
// Тънка обвивка над lsm_cluster_* (hash-partition, per-shard WAL/SST/
// MANIFEST, knobs). Единственото място извън codec.baga, което познава
// физическия layout. Struct-по-стойност: подава се `s = boila_*(s, ...)?`.
//
// Конкурентност (P2+): един shard се притежава от една write lane;
// P0 е еднонишков — фасадата не променя това, само го документира.

import "rocksbaga/db/shard.baga"
import "rocksbaga/db/engine.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "std/bytes/bytes.baga"

// libc fsync примитивът (gaps S4 моделът — extern FFI).
extern fn fdatasync(fd: i64) -> i64 !IO

struct BoilaStore {
    c: LsmCluster,
    ok: i64
}

struct BoilaGet {
    s: BoilaStore,
    found: i64,
    val: bytes
}

struct BoilaScan {
    s: BoilaStore,
    next: i64,
    keys: Vec<bytes>
}

fn boila_open(dir: str, nshards: i64, flush_at: i64, compact_at: i64) -> BoilaStore !IO {
    let c = lsm_cluster_open(dir, nshards, flush_at, compact_at)?
    return BoilaStore { c: c, ok: c.ok }
}

fn boila_close(s: BoilaStore) -> i64 !IO {
    return lsm_cluster_close(s.c)?
}

fn boila_shards(s: BoilaStore) -> i64 {
    return s.c.n
}

fn boila_put(s: BoilaStore, cf: i64, table_id: i64, pk: bytes, val: bytes) -> BoilaStore !IO !Time {
    let key = boila_key_row(cf, table_id, pk)
    let c = lsm_cluster_put_kb(s.c, key, val)?
    return BoilaStore { c: c, ok: c.ok }
}

fn boila_get(s: BoilaStore, cf: i64, table_id: i64, pk: bytes) -> BoilaGet !IO !Time {
    let key = boila_key_row(cf, table_id, pk)
    let g = lsm_cluster_get_kb(s.c, key)?
    return BoilaGet { s: BoilaStore { c: g.c, ok: g.c.ok }, found: g.found, val: g.val }
}

fn boila_del(s: BoilaStore, cf: i64, table_id: i64, pk: bytes) -> BoilaStore !IO !Time {
    let key = boila_key_row(cf, table_id, pk)
    let c = lsm_cluster_del_kb(s.c, key)?
    return BoilaStore { c: c, ok: c.ok }
}

// Prefix scan по (cf, table) — glob MATCH, cursor пагинация като SCAN.
fn boila_scan(s: BoilaStore, cf: i64, table_id: i64, cursor: i64, count: i64) -> BoilaScan !IO !Time {
    let pat = boila_glob_prefix(boila_key_prefix(cf, table_id))
    let r = lsm_cluster_scan_kb(s.c, cursor, count, pat)?
    return BoilaScan { s: BoilaStore { c: r.c, ok: r.c.ok }, next: r.next, keys: r.keys }
}

fn boila_flush(s: BoilaStore) -> BoilaStore !IO !Time {
    let c = lsm_cluster_flush_force(s.c)?
    return BoilaStore { c: c, ok: c.ok }
}

// --- Group commit (P3): statement-ниво батчиране на fsync ---
// begin: вдига sync_every, така че puts в заявката не fsync-ват поединично;
// commit: flush на WAL буферите + един fdatasync на shard, после връща
// sync_every=1. Една N-редова заявка = един fsync (амортизация N×).

fn boila_stmt_begin(s: BoilaStore) -> BoilaStore {
    let c = lsm_cluster_apply_sync(s.c, 1000000000)
    return BoilaStore { c: c, ok: s.ok }
}

fn boila_stmt_commit(s: BoilaStore) -> BoilaStore !IO {
    let mut c = s.c
    let mut i: i64 = 0
    while i < c.n {
        let mut db = vec_get(c.shards, i)
        db = lsm_wal_flush_buf(db)?
        if db.wal_fd >= 0 {
            fdatasync(db.wal_fd)?
        }
        vec_set(c.shards, i, db)
        i = i + 1
    }
    c = lsm_cluster_apply_sync(c, 1)
    return BoilaStore { c: c, ok: s.ok }
}
