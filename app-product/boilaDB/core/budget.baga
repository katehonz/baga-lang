// budget.baga — query budget (P11): max_scan, max_rows, wall deadline.
// Deadline is checked cooperatively in scan/fetch loops (every 64 steps).
// Env: BOILA_BUDGET_MS (default 5000). 0 → already-expired (tests).

import "std/os/os.baga"
import "std/str/str.baga"
import "std/time/time.baga"

struct BoilaBudget {
    start_ms: i64,
    deadline_ms: i64,
    max_scan: i64,
    max_rows: i64
}

fn boila_budget_max_scan() -> i64 {
    return 100000
}

fn boila_budget_max_rows() -> i64 {
    return 100000
}

fn boila_budget_max_ms() -> i64 {
    return 5000
}

// SQLSTATE 54000 program_limit_exceeded (scan/rows)
fn boila_budget_state() -> str {
    return "54000"
}

// SQLSTATE 57014 query_canceled (wall deadline)
fn boila_budget_state_timeout() -> str {
    return "57014"
}

fn boila_budget_err_scan(n: i64) -> str {
    return concat("query budget: max_scan ", concat(int_to_str(boila_budget_max_scan()), concat(" превишен (scanned ", concat(int_to_str(n), ")"))))
}

fn boila_budget_err_rows(n: i64) -> str {
    return concat("query budget: max_rows ", concat(int_to_str(boila_budget_max_rows()), concat(" превишен (rows ", concat(int_to_str(n), ")"))))
}

fn boila_budget_err_deadline(elapsed_ms: i64) -> str {
    return concat("query budget: deadline превишен (elapsed_ms=", concat(int_to_str(elapsed_ms), ")"))
}

fn boila_budget_begin_ex(max_ms: i64) -> BoilaBudget !Time {
    let now = time_now_ms()?
    let mut dl = now + max_ms
    if max_ms <= 0 {
        dl = now
    }
    return BoilaBudget {
        start_ms: now,
        deadline_ms: dl,
        max_scan: boila_budget_max_scan(),
        max_rows: boila_budget_max_rows()
    }
}

fn boila_budget_begin() -> BoilaBudget !Time !IO {
    let mut ms = boila_budget_max_ms()
    let e = env("BOILA_BUDGET_MS")
    if e != "" {
        let n = parse_int(e)
        if n >= 0 {
            ms = n
        }
    }
    return boila_budget_begin_ex(ms)?
}

// 1 = ok continue; 0 = deadline hit. Checks every 64 steps (and step 0).
fn boila_budget_tick(b: BoilaBudget, step: i64) -> i64 !Time {
    if (step & 63) != 0 && step != 0 {
        return 1
    }
    let now = time_now_ms()?
    if now >= b.deadline_ms {
        return 0
    }
    return 1
}

fn boila_budget_elapsed(b: BoilaBudget) -> i64 !Time {
    let now = time_now_ms()?
    return now - b.start_ms
}

// "" = ok; else error message (caller maps state).
fn boila_budget_gate(b: BoilaBudget, step: i64, nscan: i64, nrows: i64) -> str !Time {
    if boila_budget_tick(b, step)? == 0 {
        return boila_budget_err_deadline(boila_budget_elapsed(b)?)
    }
    if nscan > b.max_scan {
        return boila_budget_err_scan(nscan)
    }
    if nrows > b.max_rows {
        return boila_budget_err_rows(nrows)
    }
    return ""
}

fn boila_budget_gate_state(msg: str) -> str {
    if str_find(msg, "deadline") >= 0 {
        return boila_budget_state_timeout()
    }
    return boila_budget_state()
}
