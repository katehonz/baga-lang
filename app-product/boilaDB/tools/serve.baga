// serve.baga — HTTP входна точка (poll multi-conn).
//
// GET  /health  GET /metrics  POST /sql?db=
// Env: BOILA_PATH, BOILA_PORT (6570), BOILA_SHARDS, BOILA_FLUSH_AT,
//      BOILA_COMPACT_AT, BOILA_MAX_DB, BOILA_MAX_CONN (default 256).
//
// poll(2) multi-conn: много keep-alive клиенти едновременно; SQL exec
// е сериен (един BoilaServer). По-силно от serial-accept (gaps H2).

import "httpdbaga/http.baga"
import "metbaga/met.baga"
import "../api/http_sql.baga"
import "../api/serve_poll.baga"
import "../storage/databases.baga"
import "std/net/tcp.baga"
import "std/net/poll.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn boila_env_or(name: str, dflt: str) -> str !IO {
    let v = env(name)
    if v == "" {
        return dflt
    }
    return v
}

struct BoilaRouteOut {
    srv: BoilaServer,
    resp: Response
}

fn boila_route(srv: BoilaServer, req: Request) -> BoilaRouteOut !IO !Time {
    let method = http_method(req)
    let path = http_path_only(req)
    if method == "GET" && path == "/health" {
        let mut body = "{\"status\":\"ok\",\"open_databases\":"
        body = concat(body, int_to_str(vec_len(srv.names)))
        body = concat(body, ",\"max_db\":")
        body = concat(body, int_to_str(srv.max_db))
        body = concat(body, ",\"mode\":\"poll\"}")
        return BoilaRouteOut { srv: srv, resp: http_json_response(200, body) }
    }
    if method == "GET" && path == "/metrics" {
        let m = met_new()
        let up = met_gauge(m, "boila_up", "boilaDB process alive")
        met_set(m, up, 1)
        let od = met_gauge(m, "boila_databases_open", "open databases")
        met_set(m, od, vec_len(srv.names))
        let resp = http_response(200, met_render(m))
        return BoilaRouteOut { srv: srv, resp: http_set_header(resp, "Content-Type", "text/plain; version=0.0.4") }
    }
    if method == "POST" && path == "/sql" {
        let r = boila_http_sql(srv, req)?
        return BoilaRouteOut { srv: r.srv, resp: r.resp }
    }
    return BoilaRouteOut { srv: srv, resp: http_json_response(404, "{\"error\":\"not found\"}") }
}

// One readable client: read one HTTP request (or EOF).
struct BoilaHttpTick {
    srv: BoilaServer,
    st: BoilaPollFds,
    readers: Map<i64, HttpReader>,
    drop_fd: i64
}

fn boila_http_on_readable(srv: BoilaServer, st: BoilaPollFds, readers: Map<i64, HttpReader>, fd: i64) -> BoilaHttpTick !IO !Net !Time {
    let mut r = http_reader(fd)
    if map_has(readers, fd) == 1 {
        r = map_get(readers, fd)
    }
    let out = http_read_request_r(r)?
    r = out.reader
    if out.err != 0 {
        http_respond_keepalive(fd, http_json_response(out.err, "{\"error\":\"bad request\"}"), 0)?
        map_del(readers, fd)
        return BoilaHttpTick { srv: srv, st: st, readers: readers, drop_fd: fd }
    }
    if http_method(out.req) == "" {
        map_del(readers, fd)
        return BoilaHttpTick { srv: srv, st: st, readers: readers, drop_fd: fd }
    }
    let ka = http_keepalive(out.req)
    let rt = boila_route(srv, out.req)?
    srv = rt.srv
    http_respond_keepalive(fd, rt.resp, ka)?
    if ka == 0 {
        map_del(readers, fd)
        return BoilaHttpTick { srv: srv, st: st, readers: readers, drop_fd: fd }
    }
    map_set(readers, fd, r)
    return BoilaHttpTick { srv: srv, st: st, readers: readers, drop_fd: 0 - 1 }
}

fn main() -> i64 !Net !IO !Time {
    let root = boila_env_or("BOILA_PATH", "/tmp/baga_boila")
    let port = parse_int(boila_env_or("BOILA_PORT", "6570"))
    let nshards = parse_int(boila_env_or("BOILA_SHARDS", "4"))
    let flush_at = parse_int(boila_env_or("BOILA_FLUSH_AT", "256"))
    let compact_at = parse_int(boila_env_or("BOILA_COMPACT_AT", "4"))
    let max_db = parse_int(boila_env_or("BOILA_MAX_DB", "64"))
    let max_conn = parse_int(boila_env_or("BOILA_MAX_CONN", "256"))

    let mut srv = boila_server_open(root, nshards, flush_at, compact_at, max_db)?
    if srv.ok == 0 {
        print(concat("boiladb: неуспешно отваряне на root ", root))
        return 1
    }
    let mut line = "boiladb listening on :"
    line = concat(line, int_to_str(port))
    line = concat(line, " (root=")
    line = concat(line, root)
    line = concat(line, ", max_conn=")
    line = concat(line, int_to_str(max_conn))
    line = concat(line, ", poll multi-conn)")
    print(line)

    let listener = tcp_listen(port)?
    let mut st = boila_poll_new()
    let mut readers: Map<i64, HttpReader> = map_new()
    while true {
        let pset = boila_poll_set(listener, st)
        let pr = poll_wait(pset, 500)?
        if pr.ok < 0 {
            return 1
        }
        if poll_has(pr.ready, listener) == 1 {
            let fd = tcp_accept(listener)?
            if fd >= 0 {
                if vec_len(st.fds) >= max_conn {
                    // backpressure: reject (53300 too_many_connections)
                    http_respond_keepalive(fd, http_json_response(503, "{\"error\":\"too many connections\",\"sqlstate\":\"53300\"}"), 0)?
                    tcp_close(fd)?
                } else {
                    st = boila_poll_add(st, fd)?
                    map_set(readers, fd, http_reader(fd))
                }
            }
        }
        let mut i: i64 = 0
        while i < vec_len(pr.ready) {
            let fd = vec_get(pr.ready, i)
            if fd != listener && boila_poll_has(st, fd) == 1 {
                let tk = boila_http_on_readable(srv, st, readers, fd)?
                srv = tk.srv
                st = tk.st
                readers = tk.readers
                if tk.drop_fd >= 0 {
                    st = boila_poll_drop(st, tk.drop_fd)?
                }
            }
            i = i + 1
        }
    }
    return 0
}
