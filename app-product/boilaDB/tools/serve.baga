// serve.baga — HTTP: go_bg per-conn + shared BoilaServer under mutex.
//
// Env: BOILA_PATH, BOILA_PORT, BOILA_SHARDS, BOILA_MAX_CONN, BOILA_WORKERS
//   BOILA_WORKERS=0 (default) → go_bg per connection
//   BOILA_WORKERS=N → reserved (same go_bg for now)
//
// Per-conn txn; server store/pc protected by mutex (serial SQL mutate,
// parallel network I/O).

import "httpdbaga/http.baga"
import "metbaga/met.baga"
import "../api/http_sql.baga"
import "../storage/databases.baga"
import "../txn/mvcc.baga"
import "std/net/tcp.baga"
import "std/net/poll.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn boila_env_or(name: str, dflt: str) -> str !IO {
    let v = env(name)
    if v == "" {
        return dflt
    }
    return v
}

// Shared: Map key 0 → BoilaServer; mu protects get/set.
fn boila_sh_pack(mu: i64, mh: i64) -> i64 {
    return cell2(mu, mh)
}

fn boila_sh_lock_get(pack: i64) -> BoilaServer !Par {
    let mu = cell2_0(pack)
    let mh = cell2_1(pack)
    mutex_lock(mu)
    let m: Map<i64, BoilaServer> = h_map(mh)
    return map_get(m, 0)
}

fn boila_sh_put_unlock(pack: i64, srv: BoilaServer) -> i64 !Par {
    let mu = cell2_0(pack)
    let mh = cell2_1(pack)
    let m: Map<i64, BoilaServer> = h_map(mh)
    map_set(m, 0, srv)
    mutex_unlock(mu)
    return 0
}

fn boila_route_locked(pack: i64, txn: BoilaTxn, req: Request) -> BoilaHttpSql !IO !Time !Par {
    let mut srv = boila_sh_lock_get(pack)?
    let method = http_method(req)
    let path = http_path_only(req)
    if method == "GET" && path == "/health" {
        let mut body = "{\"status\":\"ok\",\"open_databases\":"
        body = concat(body, int_to_str(vec_len(srv.names)))
        body = concat(body, ",\"max_db\":")
        body = concat(body, int_to_str(srv.max_db))
        body = concat(body, ",\"mode\":\"mt\"}")
        boila_sh_put_unlock(pack, srv)?
        return BoilaHttpSql { srv: srv, txn: txn, resp: http_json_response(200, body) }
    }
    if method == "GET" && path == "/metrics" {
        let m = met_new()
        let up = met_gauge(m, "boila_up", "boilaDB process alive")
        met_set(m, up, 1)
        let od = met_gauge(m, "boila_databases_open", "open databases")
        met_set(m, od, vec_len(srv.names))
        let resp = http_response(200, met_render(m))
        boila_sh_put_unlock(pack, srv)?
        return BoilaHttpSql { srv: srv, txn: txn, resp: http_set_header(resp, "Content-Type", "text/plain; version=0.0.4") }
    }
    if method == "POST" && path == "/sql" {
        let r = boila_http_sql_tx(srv, txn, req)?
        boila_sh_put_unlock(pack, r.srv)?
        return r
    }
    boila_sh_put_unlock(pack, srv)?
    return BoilaHttpSql { srv: srv, txn: txn, resp: http_json_response(404, "{\"error\":\"not found\"}") }
}

// go_bg entry: ctx = cell2(fd, pack)
fn boila_http_conn(ctx: i64) -> i64 !IO !Net !Time !Par {
    let fd = cell2_0(ctx)
    let pack = cell2_1(ctx)
    tcp_set_nodelay(fd)?
    let mut txn = boila_txn_new()
    let mut r = http_reader(fd)
    let mut keep = true
    while keep {
        let out = http_read_request_r(r)?
        r = out.reader
        if out.err != 0 {
            http_respond_keepalive(fd, http_json_response(out.err, "{\"error\":\"bad request\"}"), 0)?
            keep = false
        } else {
            if http_method(out.req) == "" {
                keep = false
            } else {
                let ka = http_keepalive(out.req)
                let rt = boila_route_locked(pack, txn, out.req)?
                txn = rt.txn
                http_respond_keepalive(fd, rt.resp, ka)?
                if ka == 0 {
                    keep = false
                }
            }
        }
    }
    if txn.active == 1 {
        txn = boila_txn_rollback(txn)
    }
    tcp_close(fd)?
    return 0
}

fn main() -> i64 !Net !IO !Time !Par {
    let root = boila_env_or("BOILA_PATH", "/tmp/baga_boila")
    let port = parse_int(boila_env_or("BOILA_PORT", "6570"))
    let nshards = parse_int(boila_env_or("BOILA_SHARDS", "4"))
    let flush_at = parse_int(boila_env_or("BOILA_FLUSH_AT", "256"))
    let compact_at = parse_int(boila_env_or("BOILA_COMPACT_AT", "4"))
    let max_db = parse_int(boila_env_or("BOILA_MAX_DB", "64"))
    let max_conn = parse_int(boila_env_or("BOILA_MAX_CONN", "256"))

    let srv0 = boila_server_open(root, nshards, flush_at, compact_at, max_db)?
    if srv0.ok == 0 {
        print(concat("boiladb: неуспешно отваряне на root ", root))
        return 1
    }
    let sm: Map<i64, BoilaServer> = map_new()
    map_set(sm, 0, srv0)
    let mu = mutex_new()
    let pack = boila_sh_pack(mu, map_h(sm))

    let mut line = "boiladb listening on :"
    line = concat(line, int_to_str(port))
    line = concat(line, " (root=")
    line = concat(line, root)
    line = concat(line, ", max_conn=")
    line = concat(line, int_to_str(max_conn))
    line = concat(line, ", go_bg+mutex)")
    print(line)

    let listener = tcp_listen(port)?
    let pollfds: Vec<i64> = vec_new()
    vec_push(pollfds, listener)
    let mut inflight: i64 = 0
    while true {
        let pr = poll_wait(pollfds, 200)?
        if pr.ok < 0 {
            return 1
        }
        if poll_has(pr.ready, listener) == 1 {
            let fd = tcp_accept(listener)?
            if fd >= 0 {
                if inflight >= max_conn {
                    http_respond_keepalive(fd, http_json_response(503, "{\"error\":\"too many connections\",\"sqlstate\":\"53300\"}"), 0)?
                    tcp_close(fd)?
                } else {
                    inflight = inflight + 1
                    go_bg(boila_http_conn, cell2(fd, pack))
                    // inflight not decremented (best-effort cap; true count needs atomics)
                    if inflight > max_conn * 2 {
                        inflight = max_conn
                    }
                }
            }
        }
    }
    return 0
}
