// serve.baga — HTTP go_bg + per-db parallel + live conn (api/serve_mt.baga).
// Env: BOILA_PATH, BOILA_PORT, BOILA_SHARDS, BOILA_MAX_CONN, BOILA_MAX_DB

import "httpdbaga/http.baga"
import "metbaga/met.baga"
import "../api/http_sql.baga"
import "../api/http_auth.baga"
import "../api/http_guc.baga"
import "../api/serve_mt.baga"
import "../api/serve_stats.baga"
import "../server/databases.baga"
import "../server/exec_server.baga"
import "../sql/plan_cache.baga"
import "../txn/mvcc.baga"
import "std/net/tcp.baga"
import "std/net/poll.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

fn boila_version() -> str {
    return "0.1.0"
}

fn boila_env_or(name: str, dflt: str) -> str !IO !Par {
    let v = env(name)
    if v == "" {
        return dflt
    }
    return v
}

fn boila_route_mt(pack: i64, txn: BoilaTxn, sess_db: str, guc: Map<str, str>, req: Request) -> BoilaHttpSql !IO !Time !Par {
    let method = http_method(req)
    let path = http_path_only(req)
    if path == "/sql" || path == "/metrics" {
        let au = boila_mt_http_auth(pack, guc, req)?
        guc = au.guc
        if au.ok == 0 {
            return boila_http_auth_fail_guc(txn, sess_db, guc)
        }
    }
    if method == "GET" && path == "/health" {
        boila_mt_stat_inc(pack, boila_st_http())?
        let od = boila_mt_open_count(pack)?
        let md = boila_mt_max_db(pack)?
        let lv = boila_mt_live(pack)?
        let mut body = "{\"status\":\"ok\",\"open_databases\":"
        body = concat(body, int_to_str(od))
        body = concat(body, ",\"max_db\":")
        body = concat(body, int_to_str(md))
        body = concat(body, ",\"live_conn\":")
        body = concat(body, int_to_str(lv))
        body = concat(body, ",\"mode\":\"mt-shard\",\"version\":\"")
        body = concat(body, boila_version())
        body = concat(body, "\"}")
        return boila_http_pack(boila_seed(), txn, http_json_response(200, body), sess_db, guc)
    }
    if method == "GET" && path == "/ready" {
        boila_mt_stat_inc(pack, boila_st_http())?
        let lv = boila_mt_live(pack)?
        let mc = boila_mt_max_conn(pack)?
        let mut body = "{\"status\":"
        let mut code: i64 = 200
        if mc > 0 && lv >= mc {
            body = concat(body, "\"not_ready\",\"reason\":\"max_conn\",\"live_conn\":")
            body = concat(body, int_to_str(lv))
            body = concat(body, ",\"max_conn\":")
            body = concat(body, int_to_str(mc))
            body = concat(body, "}")
            code = 503
        } else {
            body = concat(body, "\"ready\",\"live_conn\":")
            body = concat(body, int_to_str(lv))
            body = concat(body, ",\"max_conn\":")
            body = concat(body, int_to_str(mc))
            body = concat(body, ",\"version\":\"")
            body = concat(body, boila_version())
            body = concat(body, "\"}")
        }
        return boila_http_pack(boila_seed(), txn, http_json_response(code, body), sess_db, guc)
    }
    if method == "GET" && path == "/metrics" {
        let m = met_new()
        let up = met_gauge(m, "boila_up", "alive")
        met_set(m, up, 1)
        let bi = met_gauge(m, "boila_build_info", concat("boilaDB build info version=", boila_version()))
        met_set(m, bi, 1)
        let od = met_gauge(m, "boila_databases_open", "open dbs")
        met_set(m, od, boila_mt_open_count(pack)?)
        let lc = met_gauge(m, "boila_conn_live", "live go_bg conns")
        met_set(m, lc, boila_mt_live(pack)?)
        let st = met_counter(m, "boila_sql_total", "SQL statements executed")
        met_set(m, st, boila_mt_stat_get(pack, boila_st_sql())?)
        let so = met_counter(m, "boila_sql_ok", "SQL statements ok")
        met_set(m, so, boila_mt_stat_get(pack, boila_st_sql_ok())?)
        let se = met_counter(m, "boila_sql_err", "SQL statements error")
        met_set(m, se, boila_mt_stat_get(pack, boila_st_sql_err())?)
        let hr = met_counter(m, "boila_http_requests", "HTTP requests")
        met_set(m, hr, boila_mt_stat_get(pack, boila_st_http())?)
        let pg = met_counter(m, "boila_pg_queries", "PG wire query executions")
        met_set(m, pg, boila_mt_stat_get(pack, boila_st_pg())?)
        let resp = http_set_header(http_response(200, met_render(m)), "Content-Type", "text/plain; version=0.0.4")
        return boila_http_pack(boila_seed(), txn, resp, sess_db, guc)
    }
    if method == "POST" && path == "/sql" {
        boila_mt_stat_inc(pack, boila_st_http())?
        let db = boila_http_pick_db(sess_db, req)?
        let sql = http_body(req)
        let gt = boila_http_try_guc(txn, db, guc, sql)
        if gt.hit == 1 {
            return gt.r
        }
        let out = boila_mt_exec_guc(pack, txn, db, sql, guc)?
        // keep session user across requests
        return boila_http_encode(out, sess_db, db, guc)?
    }
    return boila_http_pack(boila_seed(), txn, http_json_response(404, "{\"error\":\"not found\"}"), sess_db, guc)
}

fn boila_seed() -> BoilaServer {
    let names: Vec<str> = vec_new()
    let stores: Vec<BoilaStore> = vec_new()
    return BoilaServer {
        meta: boila_store_empty(), root: "", names: names, stores: stores,
        flush_at: 0, compact_at: 0, dflt_shards: 1, max_db: 1,
        session_txn: boila_txn_new(), pc: boila_pc_new(), guc: map_new(), mt: 0, ok: 0
    }
}

fn boila_http_conn(ctx: i64) -> i64 !IO !Net !Time !Par {
    let fd = cell2_0(ctx)
    let pack = cell2_1(ctx)
    tcp_set_nodelay(fd)?
    let mut txn = boila_txn_new()
    let mut sess_db = "boila"
    let mut sess_db_p = "boila"
    let mut sess_guc: Map<str, str> = map_new()
    let mut r = http_reader(fd)
    // MEM-4 (Q2): per-request arena rewind. Session state, който трябва да
    // преживее rewind-а, е persist-алокиран (guc maps, plan cache, lazy
    // open — на съответните места); тук се пазят само idle txn обвивката,
    // празният reader буфер и (при промяна) session db името. Mark-ът
    // оцелява през отворена транзакция — rewind е след COMMIT/ROLLBACK.
    mem_persist_begin()
    let idle_txn = boila_txn_new()
    let hempty = empty_bytes()
    mem_persist_end()
    let mut rmark: i64 = 0
    let mut have_mark = false
    let mut keep = true
    while keep {
        if txn.active == 0 {
            rmark = mem_mark()
            have_mark = true
        }
        let out = http_read_request_r(r)?
        r = out.reader
        if out.err != 0 {
            http_respond_keepalive(fd, http_json_response(out.err, "{\"error\":\"bad request\"}"), 0)?
            keep = false
        } else {
            if http_method(out.req) == "" {
                keep = false
            } else {
                let ka = http_keepalive(out.req)
                let rt = boila_route_mt(pack, txn, sess_db, sess_guc, out.req)?
                txn = rt.txn
                sess_db = rt.db
                sess_guc = rt.guc
                http_respond_keepalive(fd, rt.resp, ka)?
                if ka == 0 {
                    keep = false
                }
            }
        }
        if have_mark && txn.active == 0 {
            mem_persist_begin()
            let mut sdb = sess_db_p
            if sess_db != sess_db_p {
                sdb = substr(sess_db, 0, len(sess_db))
            }
            let mut nb = hempty
            if r.pos < bytes_len(r.buf) {
                nb = bytes_slice(r.buf, r.pos, bytes_len(r.buf))
            }
            mem_persist_end()
            sess_db_p = sdb
            sess_db = sdb
            r = HttpReader { fd: fd, buf: nb, pos: 0 }
            txn = idle_txn
            mem_rewind(rmark)
            have_mark = false
        }
    }
    if txn.active == 1 {
        txn = boila_txn_rollback(txn)
    }
    tcp_close(fd)?
    boila_mt_end_conn(pack)?
    return 0
}

fn main() -> i64 !Net !IO !Time !Par {
    let root = boila_env_or("BOILA_PATH", "/tmp/baga_boila")
    let port = parse_int(boila_env_or("BOILA_PORT", "6570"))
    let nshards = parse_int(boila_env_or("BOILA_SHARDS", "4"))
    let flush_at = parse_int(boila_env_or("BOILA_FLUSH_AT", "256"))
    let compact_at = parse_int(boila_env_or("BOILA_COMPACT_AT", "4"))
    let max_db = parse_int(boila_env_or("BOILA_MAX_DB", "64"))
    let max_conn = parse_int(boila_env_or("BOILA_MAX_CONN", "64"))

    let srv0 = boila_server_open_mt(root, nshards, flush_at, compact_at, max_db)?
    if srv0.ok == 0 {
        print(concat("boiladb: open failed ", root))
        return 1
    }
    let pack = boila_mt_new(srv0, max_conn)?
    let sw = boila_mt_start_sweeper(pack)?

    let mut line = "boiladb listening on :"
    line = concat(line, int_to_str(port))
    line = concat(line, " (max_conn=")
    line = concat(line, int_to_str(max_conn))
    line = concat(line, ", go_bg+per-shard+multi-db")
    if sw == 1 {
        line = concat(line, "+ttl-sweep")
    }
    line = concat(line, ")")
    print(line)

    let listener = tcp_listen(port)?
    let pollfds: Vec<i64> = vec_new()
    vec_push(pollfds, listener)
    while true {
        let pr = poll_wait(pollfds, 200)?
        if pr.ok < 0 {
            return 1
        }
        if poll_has(pr.ready, listener) == 1 {
            let fd = tcp_accept(listener)?
            if fd >= 0 {
                if boila_mt_try_conn(pack)? == 0 {
                    http_respond_keepalive(fd, http_json_response(503, "{\"error\":\"too many connections\",\"sqlstate\":\"53300\"}"), 0)?
                    tcp_close(fd)?
                } else {
                    go_bg(boila_http_conn, cell2(fd, pack))
                }
            }
        }
    }
    return 0
}
