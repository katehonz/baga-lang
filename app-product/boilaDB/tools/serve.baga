// serve.baga — входната точка на boilaDB.
//
// HTTP сървър върху N shard-а × rocksbaga:
//   GET  /health  → {"status":"ok","shards":N}
//   GET  /metrics → Prometheus текст (metbaga)
//   POST /sql     → BoilaSQL (P1: SELECT, CREATE TABLE), вж. api/http_sql
//   друго         → 404
//
// Env: BOILA_PATH (default /tmp/baga_boila), BOILA_SHARDS (4),
//      BOILA_PORT (6570), BOILA_FLUSH_AT (256), BOILA_COMPACT_AT (4).
//
// Конкурентност (честно за P1, gaps H2): accept loop-ът е SYNC — една
// връзка се обработва до край, после следващата. Причината: SQL пътят
// мутира store-а (каталог), а struct-по-стойност изисква един собственик.
// P2 въвежда shard-owner нишки + канали; P5 — bounded pool за wire-а.

import "httpdbaga/http.baga"
import "metbaga/met.baga"
import "../api/http_sql.baga"
import "../storage/shards.baga"
import "std/net/tcp.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn boila_env_or(name: str, dflt: str) -> str !IO {
    let v = env(name)
    if v == "" {
        return dflt
    }
    return v
}

struct BoilaRouteOut {
    s: BoilaStore,
    resp: Response
}

fn boila_route(s: BoilaStore, req: Request) -> BoilaRouteOut !IO !Time {
    let method = http_method(req)
    let path = http_path_only(req)
    let n = boila_shards(s)
    if method == "GET" && path == "/health" {
        let mut body = "{\"status\":\"ok\",\"shards\":"
        body = concat(body, int_to_str(n))
        body = concat(body, "}")
        return BoilaRouteOut { s: s, resp: http_json_response(200, body) }
    }
    if method == "GET" && path == "/metrics" {
        let m = met_new()
        let up = met_gauge(m, "boila_up", "boilaDB process alive")
        met_set(m, up, 1)
        let sh = met_gauge(m, "boila_shards", "rocksbaga shard count")
        met_set(m, sh, n)
        let resp = http_response(200, met_render(m))
        return BoilaRouteOut { s: s, resp: http_set_header(resp, "Content-Type", "text/plain; version=0.0.4") }
    }
    if method == "POST" && path == "/sql" {
        let r = boila_http_sql(s, req)?
        return BoilaRouteOut { s: r.s, resp: r.resp }
    }
    return BoilaRouteOut { s: s, resp: http_json_response(404, "{\"error\":\"not found\"}") }
}

struct BoilaConnOut {
    s: BoilaStore
}

// HTTP/1.1 keep-alive loop; tcp_close накрая е задължително — клиентите
// четат до EOF (урокът от oauthbaga P1).
fn boila_conn(fd: i64, s0: BoilaStore) -> BoilaConnOut !IO !Net !Time {
    let mut s = s0
    let mut r = http_reader(fd)
    let mut keep = true
    while keep {
        let out = http_read_request_r(r)?
        r = out.reader
        if out.err != 0 {
            http_respond_keepalive(fd, http_json_response(out.err, "{\"error\":\"bad request\"}"), 0)?
            keep = false
        } else {
            if http_method(out.req) == "" {
                keep = false
            } else {
                let ka = http_keepalive(out.req)
                let rt = boila_route(s, out.req)?
                s = rt.s
                http_respond_keepalive(fd, rt.resp, ka)?
                if ka == 0 {
                    keep = false
                }
            }
        }
    }
    tcp_close(fd)?
    return BoilaConnOut { s: s }
}

fn main() -> i64 !Net !IO !Time {
    let dir = boila_env_or("BOILA_PATH", "/tmp/baga_boila")
    let port = parse_int(boila_env_or("BOILA_PORT", "6570"))
    let nshards = parse_int(boila_env_or("BOILA_SHARDS", "4"))
    let flush_at = parse_int(boila_env_or("BOILA_FLUSH_AT", "256"))
    let compact_at = parse_int(boila_env_or("BOILA_COMPACT_AT", "4"))

    let mut store = boila_open(dir, nshards, flush_at, compact_at)?
    if store.ok == 0 {
        print(concat("boiladb: неуспешно отваряне на ", dir))
        return 1
    }
    let mut line = "boiladb listening on :"
    line = concat(line, int_to_str(port))
    line = concat(line, " (shards=")
    line = concat(line, int_to_str(boila_shards(store)))
    line = concat(line, ", dir=")
    line = concat(line, dir)
    line = concat(line, ", sync-mode P1)")
    print(line)

    let listener = tcp_listen(port)?
    while true {
        let fd = tcp_accept(listener)?
        let co = boila_conn(fd, store)?
        store = co.s
    }
    return 0
}
