// retention.baga — TTL sweep (P9). Catalog keys in catalog/ttl.baga.
// rocksbaga lazy-expire-ва на get/flush/compact (BAGATTL1).

import "../storage/shards.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "../core/row.baga"
import "../catalog/ttl.baga"
import "rocksbaga/db/shard.baga"
import "rocksbaga/db/shard_read.baga"
import "rocksbaga/db/shard_ttl.baga"
import "rocksbaga/db/engine.baga"
import "rocksbaga/db/engine_wal.baga"
import "rocksbaga/db/engine_ttl.baga"
import "rocksbaga/db/engine_keys.baga"
import "rocksbaga/db/engine_scan.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"
import "std/os/os.baga"

// S6c: max scan pages per sweep (sys catalog / per-table data).
fn boila_sweep_sys_rounds() -> i64 !IO {
    let e = env("BOILA_SWEEP_SYS_ROUNDS")
    if e == "" { return 500 }
    let n = parse_int(e)
    if n < 1 { return 500 }
    return n
}

fn boila_sweep_data_rounds() -> i64 !IO {
    let e = env("BOILA_SWEEP_DATA_ROUNDS")
    if e == "" { return 2000 }
    let n = parse_int(e)
    if n < 1 { return 2000 }
    return n
}

struct BoilaDbSize {
    s: BoilaStore,
    keys: i64
}

fn boila_dbsize(s: BoilaStore) -> BoilaDbSize !IO !Time !Par {
    if s.dbs_h == 0 {
        let r = lsm_cluster_dbsize(s.c)?
        return BoilaDbSize {
            s: BoilaStore { c: r.c, dbs_h: 0, mus_h: 0, n: r.c.n, ok: r.c.ok },
            keys: r.n
        }
    }
    boila_all_lock(s)?
    let dbs: Map<i64, LsmDB> = h_map(s.dbs_h)
    let mut n: i64 = 0
    let mut i: i64 = 0
    while i < s.n {
        let ds = lsm_dbsize(map_get(dbs, i))?
        map_set(dbs, i, ds.db)
        n = n + ds.n
        i = i + 1
    }
    boila_all_unlock(s)?
    return BoilaDbSize { s: s, keys: n }
}

// S6b/c: flush + per-key GET on TTL tables. Caps via
// BOILA_SWEEP_SYS_ROUNDS (default 500), BOILA_SWEEP_DATA_ROUNDS (2000).
fn boila_ts_sweep(s: BoilaStore) -> BoilaStore !IO !Time !Par {
    s = boila_flush(s)?
    let sys_max = boila_sweep_sys_rounds()?
    let data_max = boila_sweep_data_rounds()?
    let tids: Vec<i64> = vec_new()
    let mut cursor: i64 = 0
    let mut rounds: i64 = 0
    let mut done = false
    while done == false && rounds < sys_max {
        let sc = boila_scan(s, boila_cf_sys(), 1, cursor, 64)?
        s = sc.s
        let mut j: i64 = 0
        while j < vec_len(sc.keys) {
            let k = vec_get(sc.keys, j)
            if bytes_len(k) > 8 {
                let pk = bytes_slice(k, 5, bytes_len(k))
                let pks = str_of_bytes(pk)
                if len(pks) > 3 {
                    if char_at(pks, 0) == 116 && char_at(pks, 1) == 100 && char_at(pks, 2) == 124 {
                        let tid = parse_int(substr(pks, 3, len(pks)))
                        if tid > 0 {
                            let tg = boila_ttl_get(s, tid)?
                            s = tg.s
                            if tg.ttl_sec > 0 {
                                vec_push(tids, tid)
                            }
                        }
                    }
                }
            }
            j = j + 1
        }
        cursor = sc.next
        rounds = rounds + 1
        if cursor == 0 { done = true }
    }
    let mut ti: i64 = 0
    while ti < vec_len(tids) {
        let tid = vec_get(tids, ti)
        let mut c2: i64 = 0
        let mut r2: i64 = 0
        let mut d2 = false
        while d2 == false && r2 < data_max {
            let sc = boila_scan(s, boila_cf_data(), tid, c2, 64)?
            s = sc.s
            let mut j: i64 = 0
            while j < vec_len(sc.keys) {
                let k = vec_get(sc.keys, j)
                if bytes_len(k) > 5 {
                    let dpk = bytes_slice(k, 5, bytes_len(k))
                    let g = boila_get(s, boila_cf_data(), tid, dpk)?
                    s = g.s
                }
                j = j + 1
            }
            c2 = sc.next
            r2 = r2 + 1
            if c2 == 0 { d2 = true }
        }
        ti = ti + 1
    }
    return s
}
