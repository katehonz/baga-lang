// secondary.baga — вторични индекси (P3 rev.2).
//
// Дефинициите живеят в schema row-а на таблицата (catalog/schema.baga) —
// зареждането е point GET, не scan (границата на rocksbaga SCAN snapshot-а,
// gaps K7). Каталог по име (за duplicate check): pk "x|<table_id>|<име>"
// → row [index_id, col_idx].
// Entries (index CF, table_id на таблицата):
//   pk част = [ix_id u32 BE][value enc][pk enc] → празна стойност
//
// K6: NULL се индексира (като PG). Lookup с null val → IS NULL path.
// K2b: lookup via boila_scan_pref(cf|table|ix|val) — no full CF page.

import "../storage/shards.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "../core/row.baga"
import "../catalog/schema.baga"
import "../txn/mvcc.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

struct BoilaIxTxnRes {
    s: BoilaStore,
    txn: BoilaTxn,
    ok: i64,
    err: str,
    state: str,
    id: i64
}

struct BoilaIxLookup {
    s: BoilaStore,
    pks: Vec<bytes>
}

fn boila_ix_cat_pk(table_id: i64, name: str) -> bytes {
    return bytes_of_str(concat(concat(concat("x|", int_to_str(table_id)), "|"), name))
}

fn boila_ix_meta_pk() -> bytes {
    return bytes_of_str("m|next_ix")
}

// Entry ключ за стойност на индексирана колона.
fn boila_ix_entry_pk(ix_id: i64, val: BoilaVal, pk: bytes) -> bytes {
    let mut out = boila_enc_u32_be(ix_id)
    out = bytes_concat(out, boila_val_enc(val))
    return bytes_concat(out, pk)
}

// Префикс за exact lookup по (ix_id, стойност).
fn boila_ix_lookup_prefix(ix_id: i64, val: BoilaVal) -> bytes {
    let mut out = boila_enc_u32_be(ix_id)
    return bytes_concat(out, boila_val_enc(val))
}

// Index id по колона — чисто, без IO (дефинициите са в BoilaTable).
fn boila_ix_by_col_t(t: BoilaTable, col_idx: i64) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(t.ixs) {
        let m = vec_get(t.ixs, i)
        if m.col_idx == col_idx {
            return m.id
        }
        i = i + 1
    }
    return 0 - 1
}

// CREATE INDEX (P4): изцяло през txn buffer-а — каталог, schema rewrite,
// брояч и build entries се commit-ват атомно заедно (auto-txn в exec_sql).
// Build: pk списък през boila_txn_keys (storage + buffer), без писания
// по време на събирането.
fn boila_ix_create(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, ix_name: str, col_name: str) -> BoilaIxTxnRes !IO !Time !Par {
    // колоната съществува ли
    let mut col_idx: i64 = 0 - 1
    let mut i: i64 = 0
    while i < vec_len(t.cols) {
        let cd = vec_get(t.cols, i)
        if cd.name == col_name {
            col_idx = i
        }
        i = i + 1
    }
    if col_idx < 0 {
        return BoilaIxTxnRes { s: s, txn: txn, ok: 0, err: concat("колона '", concat(col_name, "' не съществува")), state: "42703", id: 0 }
    }
    // дубликат по име (point GET)
    let g = boila_get(s, boila_cf_sys(), 1, boila_ix_cat_pk(t.id, ix_name))?
    s = g.s
    if g.found == 1 {
        return BoilaIxTxnRes { s: s, txn: txn, ok: 0, err: concat("индекс '", concat(ix_name, "' вече съществува")), state: "42710", id: 0 }
    }
    // следващ id: първо в buffer-а (втори CREATE INDEX в същия txn)
    let mut next: i64 = 1
    let cix = boila_txn_find(txn, boila_cf_sys(), 1, boila_ix_meta_pk())
    if cix >= 0 {
        let w = vec_get(txn.writes, cix)
        let row = boila_row_dec(w.row)
        if vec_len(row) > 0 {
            next = vec_get(row, 0).i
        }
    } else {
        let g2 = boila_get(s, boila_cf_sys(), 1, boila_ix_meta_pk())?
        s = g2.s
        if g2.found == 1 {
            let row = boila_row_dec(g2.val)
            if vec_len(row) > 0 {
                next = vec_get(row, 0).i
            }
        }
    }
    let cnt: Vec<BoilaVal> = vec_new()
    vec_push(cnt, boila_val_i64(next + 1))
    let r1 = boila_txn_put(s, txn, boila_cf_sys(), 1, boila_ix_meta_pk(), boila_row_enc(cnt))
    if r1.ok == 0 {
        return BoilaIxTxnRes { s: s, txn: r1.txn, ok: 0, err: r1.err, state: r1.state, id: 0 }
    }
    txn = r1.txn
    // каталог по име
    let cat: Vec<BoilaVal> = vec_new()
    vec_push(cat, boila_val_i64(next))
    vec_push(cat, boila_val_i64(col_idx))
    let r2 = boila_txn_put(s, txn, boila_cf_sys(), 1, boila_ix_cat_pk(t.id, ix_name), boila_row_enc(cat))
    if r2.ok == 0 {
        return BoilaIxTxnRes { s: s, txn: r2.txn, ok: 0, err: r2.err, state: r2.state, id: 0 }
    }
    txn = r2.txn
    // schema rewrite: старите ixs + новият
    let newixs: Vec<BoilaIxMeta> = vec_new()
    i = 0
    while i < vec_len(t.ixs) {
        vec_push(newixs, vec_get(t.ixs, i))
        i = i + 1
    }
    vec_push(newixs, BoilaIxMeta { id: next, col_idx: col_idx, name: ix_name })
    let t2 = BoilaTable { id: t.id, name: t.name, cols: t.cols, pk_idx: t.pk_idx, ixs: newixs, ttl_sec: t.ttl_sec }
    let r3 = boila_txn_put(s, txn, boila_cf_sys(), 1, boila_cat_pk_schema(t.id), boila_row_enc(boila_cat_schema_row(t2)))
    if r3.ok == 0 {
        return BoilaIxTxnRes { s: s, txn: r3.txn, ok: 0, err: r3.err, state: r3.state, id: 0 }
    }
    txn = r3.txn
    // build: събери pk-та (storage + buffer), после buffer-ирай entries
    let ks = boila_txn_keys(s, txn, t.id)?
    s = ks.s
    let mut ki: i64 = 0
    while ki < vec_len(ks.pks) {
        let pkenc = vec_get(ks.pks, ki)
        let g3 = boila_txn_get(s, txn, t.id, pkenc)?
        s = g3.s
        if g3.found == 1 {
            let row = boila_row_dec(g3.row)
            if col_idx < vec_len(row) {
                let v = vec_get(row, col_idx)
                let r4 = boila_txn_put(s, txn, boila_cf_index(), t.id, boila_ix_entry_pk(next, v, pkenc), bytes_new(0))
                if r4.ok == 0 {
                    return BoilaIxTxnRes { s: s, txn: r4.txn, ok: 0, err: r4.err, state: r4.state, id: 0 }
                }
                txn = r4.txn
            }
        }
        ki = ki + 1
    }
    return BoilaIxTxnRes { s: s, txn: txn, ok: 1, err: "", state: "", id: next }
}

// Писане/триене на entries за индексите на таблицата при DML —
// P4: през txn buffer-а (commit-ът е в exec_sql).
fn boila_ix_put_all_txn(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, row: Vec<BoilaVal>, pkenc: bytes) -> BoilaTxnRes {
    let mut i: i64 = 0
    while i < vec_len(t.ixs) {
        let m = vec_get(t.ixs, i)
        if m.col_idx < vec_len(row) {
            let v = vec_get(row, m.col_idx)
            let r = boila_txn_put(s, txn, boila_cf_index(), t.id, boila_ix_entry_pk(m.id, v, pkenc), bytes_new(0))
            if r.ok == 0 {
                return r
            }
            txn = r.txn
        }
        i = i + 1
    }
    return boila_txn_res(s, txn, 1, "", "", 0)
}

fn boila_ix_del_all_txn(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, row: Vec<BoilaVal>, pkenc: bytes) -> BoilaTxnRes {
    let mut i: i64 = 0
    while i < vec_len(t.ixs) {
        let m = vec_get(t.ixs, i)
        if m.col_idx < vec_len(row) {
            let v = vec_get(row, m.col_idx)
            let r = boila_txn_del(s, txn, boila_cf_index(), t.id, boila_ix_entry_pk(m.id, v, pkenc))
            if r.ok == 0 {
                return r
            }
            txn = r.txn
        }
        i = i + 1
    }
    return boila_txn_res(s, txn, 1, "", "", 0)
}

// Exact lookup: всички pk-та, чиято колона има тази стойност.
// K2b: scan only cf|table|ix_id|val prefix (not full table index CF).
fn boila_ix_lookup(s: BoilaStore, t: BoilaTable, ix_id: i64, val: BoilaVal) -> BoilaIxLookup !IO !Time !Par {
    let pks: Vec<bytes> = vec_new()
    let pref = boila_ix_lookup_prefix(ix_id, val)
    let full_pref = boila_key_row(boila_cf_index(), t.id, pref)
    let plen = bytes_len(full_pref)
    let mut cursor: i64 = 0
    let mut rounds: i64 = 0
    let mut done = false
    while done == false && rounds < 10000 {
        let sc = boila_scan_pref(s, full_pref, cursor, 64)?
        let mut j: i64 = 0
        while j < vec_len(sc.keys) {
            let k = vec_get(sc.keys, j)
            vec_push(pks, bytes_slice(k, plen, bytes_len(k)))
            j = j + 1
        }
        cursor = sc.next
        rounds = rounds + 1
        s = sc.s
        if cursor == 0 {
            done = true
        }
    }
    return BoilaIxLookup { s: s, pks: pks }
}

// Fixed-width val_enc size from tag (str/bytes/json → -1).
fn boila_ix_val_width(tag: i64) -> i64 {
    if tag == boila_v_null() { return 1 }
    if tag == boila_v_bool() { return 2 }
    if tag == boila_v_i64() { return 9 }
    if tag == boila_v_ts() { return 9 }
    return 0 - 1
}

// K3d/f: secondary index range. Fixed val width, or var val + fixed PK.
// has=0 → caller seq-filters; has=1 → pks are matches.
struct BoilaIxRange {
    s: BoilaStore,
    ok: i64,
    err: str,
    state: str,
    has: i64,
    pks: Vec<bytes>
}

// lo_excl/hi_excl: 1 = strict (col > lo / col < hi); 0 = inclusive (>= / <=).
fn boila_ix_range(s: BoilaStore, t: BoilaTable, ix_id: i64, has_lo: i64, lo: BoilaVal, has_hi: i64, hi: BoilaVal, lo_excl: i64, hi_excl: i64) -> BoilaIxRange !IO !Time !Par {
    let pks: Vec<bytes> = vec_new()
    let mut tag: i64 = 0 - 1
    if has_lo == 1 { tag = lo.tag }
    if has_hi == 1 {
        if tag >= 0 && hi.tag != tag {
            return BoilaIxRange { s: s, ok: 0, err: "range lo/hi — различен тип", state: "42804", has: 0, pks: pks }
        }
        tag = hi.tag
    }
    let vw = boila_ix_val_width(tag)
    let mut pw: i64 = 0 - 1
    if t.pk_idx >= 0 && t.pk_idx < vec_len(t.cols) {
        pw = boila_ix_val_width(vec_get(t.cols, t.pk_idx).typ)
    }
    // need fixed val OR (var val + fixed pk tail)
    if vw < 0 && pw < 0 {
        return BoilaIxRange { s: s, ok: 1, err: "", state: "", has: 0, pks: pks }
    }
    let pref = boila_enc_u32_be(ix_id)
    let full_pref = boila_key_row(boila_cf_index(), t.id, pref)
    let plen = bytes_len(full_pref)
    let mut cursor: i64 = 0
    let mut rounds: i64 = 0
    let mut done = false
    while done == false && rounds < 10000 {
        let sc = boila_scan_pref(s, full_pref, cursor, 64)?
        let mut j: i64 = 0
        while j < vec_len(sc.keys) {
            let body = bytes_slice(vec_get(sc.keys, j), plen, bytes_len(vec_get(sc.keys, j)))
            let bl = bytes_len(body)
            let mut venc = bytes_new(0)
            let mut pkpart = bytes_new(0)
            let mut okb = 0
            if vw >= 0 {
                if bl >= vw {
                    venc = bytes_slice(body, 0, vw)
                    pkpart = bytes_slice(body, vw, bl)
                    okb = 1
                }
            } else {
                if pw >= 0 && bl > pw {
                    venc = bytes_slice(body, 0, bl - pw)
                    pkpart = bytes_slice(body, bl - pw, bl)
                    okb = 1
                }
            }
            if okb == 1 {
                let pkv = boila_val_dec(venc)
                let mut keep = true
                if has_lo == 1 {
                    let c = boila_val_cmp(pkv, lo)
                    if lo_excl == 1 {
                        if c != 1 { keep = false }
                    } else {
                        if c != 0 && c != 1 { keep = false }
                    }
                }
                if keep && has_hi == 1 {
                    let c = boila_val_cmp(pkv, hi)
                    if hi_excl == 1 {
                        if c != 0 - 1 { keep = false }
                    } else {
                        if c != 0 && c != 0 - 1 { keep = false }
                    }
                }
                if keep { vec_push(pks, pkpart) }
            }
            j = j + 1
        }
        cursor = sc.next
        rounds = rounds + 1
        s = sc.s
        if cursor == 0 { done = true }
    }
    return BoilaIxRange { s: s, ok: 1, err: "", state: "", has: 1, pks: pks }
}
