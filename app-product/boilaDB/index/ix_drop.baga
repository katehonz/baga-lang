// ix_drop.baga — DROP INDEX name ON table (secondary / FTS / HNSW).
import "secondary.baga"
import "../storage/shards.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "../core/row.baga"
import "../catalog/schema.baga"
import "../catalog/drop.baga"
import "../fts/fts.baga"
import "../fts/fts_doc.baga"
import "../vector/hnsw_store.baga"
import "../txn/mvcc.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

fn boila_ix_wipe_pref_txn(s: BoilaStore, txn: BoilaTxn, cf: i64, table_id: i64, pref: bytes) -> BoilaIxTxnRes !IO !Time !Par {
    let ks = boila_cf_keys_raw(s, cf, table_id)?
    s = ks.s
    let mut i: i64 = 0
    while i < vec_len(ks.pks) {
        let pk = vec_get(ks.pks, i)
        if boila_bytes_has_prefix(pk, pref) == 1 {
            let r = boila_txn_del(s, txn, cf, table_id, pk)
            s = r.s
            txn = r.txn
            if r.ok == 0 {
                return BoilaIxTxnRes { s: s, txn: txn, ok: 0, err: r.err, state: r.state, id: 0 }
            }
        }
        i = i + 1
    }
    return BoilaIxTxnRes { s: s, txn: txn, ok: 1, err: "", state: "", id: 0 }
}

// Secondary btree DROP (no IF EXISTS — caller cascades).
fn boila_ix_drop_sec(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, ix_name: str) -> BoilaIxTxnRes !IO !Time !Par {
    let cpk = boila_ix_cat_pk(t.id, ix_name)
    let mut found = 0
    let mut ix_id: i64 = 0
    if txn.active == 1 {
        let bix = boila_txn_find(txn, boila_cf_sys(), 1, cpk)
        if bix >= 0 {
            let w = vec_get(txn.writes, bix)
            if w.is_del == 0 {
                let row = boila_row_dec(w.row)
                if vec_len(row) >= 1 { found = 1; ix_id = vec_get(row, 0).i }
            } else { found = 0 - 1 }
        }
    }
    if found == 0 {
        let g = boila_get(s, boila_cf_sys(), 1, cpk)?
        s = g.s
        if g.found == 1 {
            let row = boila_row_dec(g.val)
            if vec_len(row) >= 1 { found = 1; ix_id = vec_get(row, 0).i }
        }
    }
    if found != 1 {
        return BoilaIxTxnRes { s: s, txn: txn, ok: 0, err: "miss", state: "42704", id: 0 }
    }
    let d1 = boila_txn_del(s, txn, boila_cf_sys(), 1, cpk)
    if d1.ok == 0 { return BoilaIxTxnRes { s: d1.s, txn: d1.txn, ok: 0, err: d1.err, state: d1.state, id: 0 } }
    s = d1.s
    txn = d1.txn
    let newixs: Vec<BoilaIxMeta> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(t.ixs) {
        let m = vec_get(t.ixs, i)
        if m.id != ix_id { vec_push(newixs, m) }
        i = i + 1
    }
    let t2 = BoilaTable { id: t.id, name: t.name, cols: t.cols, pk_idx: t.pk_idx, ixs: newixs, ttl_sec: t.ttl_sec }
    let r3 = boila_txn_put(s, txn, boila_cf_sys(), 1, boila_cat_pk_schema(t.id), boila_row_enc(boila_cat_schema_row(t2)))
    if r3.ok == 0 { return BoilaIxTxnRes { s: s, txn: r3.txn, ok: 0, err: r3.err, state: r3.state, id: 0 } }
    txn = r3.txn
    let w = boila_ix_wipe_pref_txn(s, txn, boila_cf_index(), t.id, boila_enc_u32_be(ix_id))?
    if w.ok == 0 { return w }
    return BoilaIxTxnRes { s: w.s, txn: w.txn, ok: 1, err: "", state: "", id: ix_id }
}

// FTS DROP: cat + list + stats; wipe fts CF if last index on table.
fn boila_ix_drop_fts(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, ix_name: str) -> BoilaIxTxnRes !IO !Time !Par {
    let gl = fts_list_for_table(s, t.id)?
    s = gl.s
    let mut found = 0
    let mut fid: i64 = 0
    let kept: Vec<BoilaFtsDef> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(gl.defs) {
        let d = vec_get(gl.defs, i)
        if d.name == ix_name {
            found = 1
            fid = d.id
        } else {
            vec_push(kept, d)
        }
        i = i + 1
    }
    if found == 0 {
        return BoilaIxTxnRes { s: s, txn: txn, ok: 0, err: "miss", state: "42704", id: 0 }
    }
    let d1 = boila_txn_del(s, txn, boila_cf_sys(), 1, fts_cat_pk(t.id, ix_name))
    if d1.ok == 0 { return BoilaIxTxnRes { s: d1.s, txn: d1.txn, ok: 0, err: d1.err, state: d1.state, id: 0 } }
    s = d1.s
    txn = d1.txn
    let d2 = boila_txn_del(s, txn, boila_cf_sys(), 1, fts_stats_pk(fid))
    if d2.ok == 0 { return BoilaIxTxnRes { s: d2.s, txn: d2.txn, ok: 0, err: d2.err, state: d2.state, id: 0 } }
    s = d2.s
    txn = d2.txn
    if vec_len(kept) == 0 {
        let d3 = boila_txn_del(s, txn, boila_cf_sys(), 1, fts_list_pk(t.id))
        if d3.ok == 0 { return BoilaIxTxnRes { s: d3.s, txn: d3.txn, ok: 0, err: d3.err, state: d3.state, id: 0 } }
        s = d3.s
        txn = d3.txn
        let w = boila_cf_wipe_txn(s, txn, boila_cf_fts(), t.id)?
        if w.ok == 0 { return BoilaIxTxnRes { s: w.s, txn: w.txn, ok: 0, err: w.err, state: w.state, id: 0 } }
        s = w.s
        txn = w.txn
    } else {
        let rl = boila_txn_put(s, txn, boila_cf_sys(), 1, fts_list_pk(t.id), fts_defs_enc(kept))
        if rl.ok == 0 { return BoilaIxTxnRes { s: s, txn: rl.txn, ok: 0, err: rl.err, state: rl.state, id: 0 } }
        s = rl.s
        txn = rl.txn
    }
    return BoilaIxTxnRes { s: s, txn: txn, ok: 1, err: "", state: "", id: fid }
}

// HNSW DROP: cat + list + vm; wipe vec nbrs with n|<ix_id> prefix.
fn boila_ix_drop_hnsw(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, ix_name: str) -> BoilaIxTxnRes !IO !Time !Par {
    let gl = hnsw_list_for_table(s, t.id)?
    s = gl.s
    let mut found = 0
    let mut hid: i64 = 0
    let kept: Vec<BoilaHnswDef> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(gl.defs) {
        let d = vec_get(gl.defs, i)
        if d.name == ix_name {
            found = 1
            hid = d.id
        } else {
            vec_push(kept, d)
        }
        i = i + 1
    }
    if found == 0 {
        return BoilaIxTxnRes { s: s, txn: txn, ok: 0, err: "miss", state: "42704", id: 0 }
    }
    let d1 = boila_txn_del(s, txn, boila_cf_sys(), 1, hnsw_cat_pk(t.id, ix_name))
    if d1.ok == 0 { return BoilaIxTxnRes { s: d1.s, txn: d1.txn, ok: 0, err: d1.err, state: d1.state, id: 0 } }
    s = d1.s
    txn = d1.txn
    let d2 = boila_txn_del(s, txn, boila_cf_sys(), 1, hnsw_vm_pk(hid))
    if d2.ok == 0 { return BoilaIxTxnRes { s: d2.s, txn: d2.txn, ok: 0, err: d2.err, state: d2.state, id: 0 } }
    s = d2.s
    txn = d2.txn
    if vec_len(kept) == 0 {
        let d3 = boila_txn_del(s, txn, boila_cf_sys(), 1, hnsw_list_pk(t.id))
        if d3.ok == 0 { return BoilaIxTxnRes { s: d3.s, txn: d3.txn, ok: 0, err: d3.err, state: d3.state, id: 0 } }
        s = d3.s
        txn = d3.txn
    } else {
        let rl = boila_txn_put(s, txn, boila_cf_sys(), 1, hnsw_list_pk(t.id), hnsw_defs_enc(kept))
        if rl.ok == 0 { return BoilaIxTxnRes { s: s, txn: rl.txn, ok: 0, err: rl.err, state: rl.state, id: 0 } }
        s = rl.s
        txn = rl.txn
    }
    let mut pref = bytes_of_str("n|")
    pref = bytes_concat(pref, boila_enc_u32_be(hid))
    let w = boila_ix_wipe_pref_txn(s, txn, boila_cf_vec(), t.id, pref)?
    if w.ok == 0 { return w }
    return BoilaIxTxnRes { s: w.s, txn: w.txn, ok: 1, err: "", state: "", id: hid }
}

fn boila_ix_drop_any(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, ix_name: str) -> BoilaIxTxnRes !IO !Time !Par {
    let a = boila_ix_drop_sec(s, txn, t, ix_name)?
    if a.ok == 1 || a.state != "42704" { return a }
    s = a.s
    txn = a.txn
    let b = boila_ix_drop_fts(s, txn, t, ix_name)?
    if b.ok == 1 || b.state != "42704" { return b }
    s = b.s
    txn = b.txn
    return boila_ix_drop_hnsw(s, txn, t, ix_name)?
}

fn boila_ix_drop_run(s: BoilaStore, txn: BoilaTxn, db: str, table: str, ix_name: str, if_exists: i64) -> BoilaIxTxnRes !IO !Time !Par {
    let was = txn.active
    if was == 0 {
        let b = boila_txn_begin(s, txn, 0, db)?
        s = b.s
        txn = b.txn
    }
    let ct = boila_cat_by_name_txn(s, txn, table)?
    s = ct.s
    if ct.ok == 0 {
        if was == 0 { txn = boila_txn_rollback(txn) }
        if if_exists == 1 && ct.state == "42P01" {
            return BoilaIxTxnRes { s: s, txn: txn, ok: 1, err: "", state: "", id: 0 }
        }
        return BoilaIxTxnRes { s: s, txn: txn, ok: 0, err: ct.err, state: ct.state, id: 0 }
    }
    let dr = boila_ix_drop_any(s, txn, ct.table, ix_name)?
    s = dr.s
    txn = dr.txn
    if dr.ok == 0 {
        if was == 0 { txn = boila_txn_rollback(txn) }
        if if_exists == 1 && dr.state == "42704" {
            return BoilaIxTxnRes { s: s, txn: txn, ok: 1, err: "", state: "", id: 0 }
        }
        if dr.state == "42704" {
            return BoilaIxTxnRes { s: s, txn: txn, ok: 0, err: concat("индекс '", concat(ix_name, "' не съществува")), state: "42704", id: 0 }
        }
        return BoilaIxTxnRes { s: s, txn: txn, ok: 0, err: dr.err, state: dr.state, id: 0 }
    }
    if was == 0 {
        let c = boila_txn_commit(s, txn)?
        s = c.s
        txn = c.txn
        if c.ok == 0 {
            return BoilaIxTxnRes { s: s, txn: txn, ok: 0, err: c.err, state: c.state, id: 0 }
        }
    }
    return BoilaIxTxnRes { s: s, txn: txn, ok: 1, err: "", state: "", id: dr.id }
}
