// hnsw_store.baga — HNSW cat/keys/nbrs; L0 embeds VECTOR pay (V4c).
import "../storage/shards.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "../core/row.baga"
import "../catalog/schema.baga"
import "../txn/mvcc.baga"
import "distance.baga"
import "std/bytes/bytes.baga"
import "std/str/str.baga"

struct BoilaHnswDef {
    id: i64,
    col_idx: i64,
    name: str,
    dim: i64,
    metric: i64
}

struct BoilaHnswList {
    s: BoilaStore,
    defs: Vec<BoilaHnswDef>
}

struct BoilaHnswMeta {
    s: BoilaStore,
    txn: BoilaTxn,
    has_ep: i64,
    count: i64,
    max_lvl: i64,
    ep: bytes
}

struct BoilaHnswNbrs {
    s: BoilaStore,
    txn: BoilaTxn,
    pks: Vec<bytes>,
    pay: bytes
}

fn hnsw_cat_pk(table_id: i64, name: str) -> bytes {
    return bytes_of_str(concat(concat(concat("vh|", int_to_str(table_id)), "|"), name))
}

fn hnsw_list_pk(table_id: i64) -> bytes {
    return bytes_of_str(concat("vl|", int_to_str(table_id)))
}

fn hnsw_meta_next_pk() -> bytes {
    return bytes_of_str("m|next_hnsw")
}

fn hnsw_vm_pk(id: i64) -> bytes {
    return bytes_of_str(concat("vm|", int_to_str(id)))
}

fn hnsw_nbr_pk(ix_id: i64, level: i64, pk: bytes) -> bytes {
    let mut out = bytes_of_str("n|")
    out = bytes_concat(out, boila_enc_u32_be(ix_id))
    let lb = bytes_new(1)
    bytes_set(lb, 0, level & 255)
    out = bytes_concat(out, lb)
    return bytes_concat(out, pk)
}

fn hnsw_M() -> i64 { return 16 }
fn hnsw_ef_c() -> i64 { return 64 }
// Search ef: tuned for LIMIT≈10 / V2 gate (was 50 → 24 → 20).
fn hnsw_ef_s() -> i64 { return 20 }

fn hnsw_unwrap(val: bytes) -> bytes {
    if bytes_len(val) > 8 {
        return bytes_slice(val, 8, bytes_len(val))
    }
    return bytes_new(0)
}

// magic 0xFFFFFFFE → extended with VECTOR pay before nbr list
fn hnsw_nbrs_magic() -> i64 { return 4294967294 }

fn hnsw_nbrs_enc(pks: Vec<bytes>) -> bytes {
    return hnsw_nbrs_enc_ex(bytes_new(0), pks)
}

fn hnsw_nbrs_enc_ex(pay: bytes, pks: Vec<bytes>) -> bytes {
    let mut out = bytes_new(0)
    if bytes_len(pay) > 0 {
        out = boila_enc_u32_be(hnsw_nbrs_magic())
        out = bytes_concat(out, boila_enc_u32_be(bytes_len(pay)))
        out = bytes_concat(out, pay)
    }
    out = bytes_concat(out, boila_enc_u32_be(vec_len(pks)))
    let mut i: i64 = 0
    while i < vec_len(pks) {
        let pk = vec_get(pks, i)
        out = bytes_concat(out, boila_enc_u32_be(bytes_len(pk)))
        out = bytes_concat(out, pk)
        i = i + 1
    }
    return out
}

fn hnsw_nbrs_dec_pay(b: bytes) -> bytes {
    if bytes_len(b) < 8 { return bytes_new(0) }
    if boila_dec_u32_be(b, 0) != hnsw_nbrs_magic() { return bytes_new(0) }
    let plen = boila_dec_u32_be(b, 4)
    if 8 + plen > bytes_len(b) { return bytes_new(0) }
    return bytes_slice(b, 8, 8 + plen)
}

fn hnsw_nbrs_dec(b: bytes) -> Vec<bytes> {
    let pks: Vec<bytes> = vec_new()
    let mut off: i64 = 0
    if bytes_len(b) < 4 { return pks }
    if boila_dec_u32_be(b, 0) == hnsw_nbrs_magic() {
        if bytes_len(b) < 8 { return pks }
        let plen = boila_dec_u32_be(b, 4)
        off = 8 + plen
        if off > bytes_len(b) { return pks }
    }
    if off + 4 > bytes_len(b) { return pks }
    let n = boila_dec_u32_be(b, off)
    off = off + 4
    let mut i: i64 = 0
    while i < n && off + 4 <= bytes_len(b) {
        let pl = boila_dec_u32_be(b, off)
        off = off + 4
        if off + pl > bytes_len(b) {
            i = n
        } else {
            vec_push(pks, bytes_slice(b, off, off + pl))
            off = off + pl
            i = i + 1
        }
    }
    return pks
}

fn hnsw_defs_enc(defs: Vec<BoilaHnswDef>) -> bytes {
    let r: Vec<BoilaVal> = vec_new()
    vec_push(r, boila_val_i64(vec_len(defs)))
    let mut i: i64 = 0
    while i < vec_len(defs) {
        let d = vec_get(defs, i)
        vec_push(r, boila_val_i64(d.id))
        vec_push(r, boila_val_i64(d.col_idx))
        vec_push(r, boila_val_str(d.name))
        vec_push(r, boila_val_i64(d.dim))
        vec_push(r, boila_val_i64(d.metric))
        i = i + 1
    }
    return boila_row_enc(r)
}

fn hnsw_list_for_table(s: BoilaStore, table_id: i64) -> BoilaHnswList !IO !Time !Par {
    let defs: Vec<BoilaHnswDef> = vec_new()
    let g = boila_get(s, boila_cf_sys(), 1, hnsw_list_pk(table_id))?
    s = g.s
    if g.found == 0 {
        return BoilaHnswList { s: s, defs: defs }
    }
    let row = boila_row_dec(g.val)
    if vec_len(row) < 1 {
        return BoilaHnswList { s: s, defs: defs }
    }
    let n = vec_get(row, 0).i
    let mut off: i64 = 1
    let mut i: i64 = 0
    while i < n && off + 5 <= vec_len(row) {
        vec_push(defs, BoilaHnswDef {
            id: vec_get(row, off).i,
            col_idx: vec_get(row, off + 1).i,
            name: str_of_bytes(vec_get(row, off + 2).b),
            dim: vec_get(row, off + 3).i,
            metric: vec_get(row, off + 4).i
        })
        off = off + 5
        i = i + 1
    }
    return BoilaHnswList { s: s, defs: defs }
}

fn hnsw_vm_get(s: BoilaStore, txn: BoilaTxn, id: i64) -> BoilaHnswMeta !IO !Time !Par {
    let z = bytes_new(0)
    let bix = boila_txn_find(txn, boila_cf_sys(), 1, hnsw_vm_pk(id))
    if bix >= 0 {
        let w = vec_get(txn.writes, bix)
        if w.is_del == 1 {
            return BoilaHnswMeta { s: s, txn: txn, has_ep: 0, count: 0, max_lvl: 0, ep: z }
        }
        let row = boila_row_dec(w.row)
        return hnsw_vm_from_row(s, txn, row)
    }
    let g = boila_get(s, boila_cf_sys(), 1, hnsw_vm_pk(id))?
    s = g.s
    if g.found == 0 {
        return BoilaHnswMeta { s: s, txn: txn, has_ep: 0, count: 0, max_lvl: 0, ep: z }
    }
    return hnsw_vm_from_row(s, txn, boila_row_dec(g.val))
}

fn hnsw_vm_from_row(s: BoilaStore, txn: BoilaTxn, row: Vec<BoilaVal>) -> BoilaHnswMeta {
    let z = bytes_new(0)
    if vec_len(row) < 4 {
        return BoilaHnswMeta { s: s, txn: txn, has_ep: 0, count: 0, max_lvl: 0, ep: z }
    }
    return BoilaHnswMeta {
        s: s, txn: txn,
        has_ep: vec_get(row, 0).i,
        count: vec_get(row, 1).i,
        max_lvl: vec_get(row, 2).i,
        ep: vec_get(row, 3).b
    }
}

fn hnsw_vm_put(s: BoilaStore, txn: BoilaTxn, id: i64, has_ep: i64, count: i64, max_lvl: i64, ep: bytes) -> BoilaHnswMeta {
    let r: Vec<BoilaVal> = vec_new()
    vec_push(r, boila_val_i64(has_ep))
    vec_push(r, boila_val_i64(count))
    vec_push(r, boila_val_i64(max_lvl))
    vec_push(r, boila_val_bytes(ep))
    let w = boila_txn_put(s, txn, boila_cf_sys(), 1, hnsw_vm_pk(id), boila_row_enc(r))
    return BoilaHnswMeta { s: s, txn: w.txn, has_ep: has_ep, count: count, max_lvl: max_lvl, ep: ep }
}

fn hnsw_nbrs_get(s: BoilaStore, txn: BoilaTxn, table_id: i64, ix_id: i64, level: i64, pk: bytes) -> BoilaHnswNbrs !IO !Time !Par {
    let empty: Vec<bytes> = vec_new()
    let z = bytes_new(0)
    let key = hnsw_nbr_pk(ix_id, level, pk)
    let bix = boila_txn_find(txn, boila_cf_vec(), table_id, key)
    if bix >= 0 {
        let w = vec_get(txn.writes, bix)
        if w.is_del == 1 {
            return BoilaHnswNbrs { s: s, txn: txn, pks: empty, pay: z }
        }
        return BoilaHnswNbrs { s: s, txn: txn, pks: hnsw_nbrs_dec(w.row), pay: hnsw_nbrs_dec_pay(w.row) }
    }
    let g = boila_get(s, boila_cf_vec(), table_id, key)?
    s = g.s
    if g.found == 0 {
        return BoilaHnswNbrs { s: s, txn: txn, pks: empty, pay: z }
    }
    let raw = hnsw_unwrap(g.val)
    return BoilaHnswNbrs { s: s, txn: txn, pks: hnsw_nbrs_dec(raw), pay: hnsw_nbrs_dec_pay(raw) }
}

// V4/V4c: cache raw encoding; seed vcache from L0-embedded pay.
fn hnsw_nbrs_get_c(s: BoilaStore, txn: BoilaTxn, table_id: i64, ix_id: i64, level: i64, pk: bytes, cache: Map<bytes, bytes>, vcache: Map<bytes, bytes>) -> BoilaHnswNbrs !IO !Time !Par {
    let key = hnsw_nbr_pk(ix_id, level, pk)
    if map_has(cache, key) == 1 {
        let raw = map_get(cache, key)
        let pay = hnsw_nbrs_dec_pay(raw)
        if bytes_len(pay) >= 4 { map_set(vcache, pk, pay) }
        return BoilaHnswNbrs { s: s, txn: txn, pks: hnsw_nbrs_dec(raw), pay: pay }
    }
    let nb = hnsw_nbrs_get(s, txn, table_id, ix_id, level, pk)?
    let raw = hnsw_nbrs_enc_ex(nb.pay, nb.pks)
    map_set(cache, key, raw)
    if bytes_len(nb.pay) >= 4 { map_set(vcache, pk, nb.pay) }
    return BoilaHnswNbrs { s: nb.s, txn: nb.txn, pks: nb.pks, pay: nb.pay }
}

// Prefetch ep + 1-hop at levels max_lvl..1 into cache.
fn hnsw_warm_upper(s: BoilaStore, txn: BoilaTxn, table_id: i64, ix_id: i64, ep: bytes, max_lvl: i64, cache: Map<bytes, bytes>, vcache: Map<bytes, bytes>) -> BoilaHnswNbrs !IO !Time !Par {
    let mut lvl = max_lvl
    let mut ss = s
    let mut tt = txn
    while lvl > 0 {
        let nb = hnsw_nbrs_get_c(ss, tt, table_id, ix_id, lvl, ep, cache, vcache)?
        ss = nb.s
        tt = nb.txn
        let mut j: i64 = 0
        while j < vec_len(nb.pks) {
            let n2 = hnsw_nbrs_get_c(ss, tt, table_id, ix_id, lvl, vec_get(nb.pks, j), cache, vcache)?
            ss = n2.s
            tt = n2.txn
            j = j + 1
        }
        lvl = lvl - 1
    }
    let empty: Vec<bytes> = vec_new()
    return BoilaHnswNbrs { s: ss, txn: tt, pks: empty, pay: bytes_new(0) }
}

fn hnsw_nbrs_put(s: BoilaStore, txn: BoilaTxn, table_id: i64, ix_id: i64, level: i64, pk: bytes, pks: Vec<bytes>) -> BoilaHnswNbrs {
    return hnsw_nbrs_put_ex(s, txn, table_id, ix_id, level, pk, pks, bytes_new(0))
}

fn hnsw_nbrs_put_ex(s: BoilaStore, txn: BoilaTxn, table_id: i64, ix_id: i64, level: i64, pk: bytes, pks: Vec<bytes>, pay: bytes) -> BoilaHnswNbrs {
    let w = boila_txn_put(s, txn, boila_cf_vec(), table_id, hnsw_nbr_pk(ix_id, level, pk), hnsw_nbrs_enc_ex(pay, pks))
    return BoilaHnswNbrs { s: s, txn: w.txn, pks: pks, pay: pay }
}

// Вектор от data row (col_idx); coerce str→vector.
struct BoilaHnswVec {
    s: BoilaStore,
    txn: BoilaTxn,
    ok: i64,
    dims: Vec<f64>
}

fn hnsw_row_vec(s: BoilaStore, txn: BoilaTxn, table_id: i64, pk: bytes, col_idx: i64, dim: i64) -> BoilaHnswVec !IO !Time !Par {
    let empty: Vec<f64> = vec_new()
    let g = boila_txn_get(s, txn, table_id, pk)?
    s = g.s
    if g.found == 0 {
        return BoilaHnswVec { s: s, txn: txn, ok: 0, dims: empty }
    }
    let row = boila_row_dec(g.row)
    if col_idx < 0 || col_idx >= vec_len(row) {
        return BoilaHnswVec { s: s, txn: txn, ok: 0, dims: empty }
    }
    let c = boila_vec_coerce(vec_get(row, col_idx), dim)
    if c.ok == 0 {
        return BoilaHnswVec { s: s, txn: txn, ok: 0, dims: empty }
    }
    return BoilaHnswVec { s: s, txn: txn, ok: 1, dims: boila_vec_from_val(c.v) }
}

// V4c: payload cache; L0-embedded pay preferred (fills ncache too).
struct BoilaHnswPay {
    s: BoilaStore,
    txn: BoilaTxn,
    ok: i64,
    pay: bytes
}

fn hnsw_row_payload_c(s: BoilaStore, txn: BoilaTxn, table_id: i64, pk: bytes, col_idx: i64, dim: i64, ix_id: i64, vcache: Map<bytes, bytes>, ncache: Map<bytes, bytes>) -> BoilaHnswPay !IO !Time !Par {
    let empty = bytes_new(0)
    if map_has(vcache, pk) == 1 {
        return BoilaHnswPay { s: s, txn: txn, ok: 1, pay: map_get(vcache, pk) }
    }
    if ix_id > 0 {
        let key = hnsw_nbr_pk(ix_id, 0, pk)
        let mut raw = bytes_new(0)
        let mut got = 0
        if map_has(ncache, key) == 1 {
            raw = map_get(ncache, key)
            got = 1
        } else {
            let bix = boila_txn_find(txn, boila_cf_vec(), table_id, key)
            if bix >= 0 {
                let w = vec_get(txn.writes, bix)
                if w.is_del == 0 { raw = w.row; got = 1; map_set(ncache, key, raw) }
            } else {
                let g0 = boila_get(s, boila_cf_vec(), table_id, key)?
                s = g0.s
                if g0.found == 1 {
                    raw = hnsw_unwrap(g0.val)
                    got = 1
                    map_set(ncache, key, raw)
                }
            }
        }
        if got == 1 {
            let pay = hnsw_nbrs_dec_pay(raw)
            if bytes_len(pay) >= 4 {
                map_set(vcache, pk, pay)
                return BoilaHnswPay { s: s, txn: txn, ok: 1, pay: pay }
            }
        }
    }
    let g = boila_txn_get(s, txn, table_id, pk)?
    s = g.s
    if g.found == 0 {
        return BoilaHnswPay { s: s, txn: txn, ok: 0, pay: empty }
    }
    let row = boila_row_dec(g.row)
    if col_idx < 0 || col_idx >= vec_len(row) {
        return BoilaHnswPay { s: s, txn: txn, ok: 0, pay: empty }
    }
    let c = boila_vec_coerce(vec_get(row, col_idx), dim)
    if c.ok == 0 {
        return BoilaHnswPay { s: s, txn: txn, ok: 0, pay: empty }
    }
    map_set(vcache, pk, c.v.b)
    return BoilaHnswPay { s: s, txn: txn, ok: 1, pay: c.v.b }
}

