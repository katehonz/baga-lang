// tokenizer.baga — FTS токенизър (P7).
//
// Term = [a-z0-9] + UTF-8 letters. Case fold: ASCII A-Z; Cyrillic
// А-Я/Ё → а-я/ё (UTF-8 2-byte). Other UTF-8 kept as-is (F1 residual:
// full Unicode casefold / σ-ς needs tables). Split on the rest.

import "std/bytes/bytes.baga"
import "std/str/str.baga"

fn fts_one_b(v: i64) -> bytes {
    let b = bytes_new(1)
    bytes_set(b, 0, v & 255)
    return b
}

fn fts_two_b(a: i64, b: i64) -> bytes {
    return bytes_concat(fts_one_b(a), fts_one_b(b))
}

// F1: fold Cyrillic capital → lower (UTF-8). b0/b1 are the two bytes.
// Returns folded 2-byte sequence; non-cyrillic pair returned unchanged.
fn fts_fold_cyr2(b0: i64, b1: i64) -> bytes {
    if b0 == 208 {
        // D0: Ё U+0401 (D0 81) → ё D1 91; А-П D0 90-9F → D0 B0-BF;
        // Р-Я D0 A0-AF → D1 80-8F
        if b1 == 129 {
            return fts_two_b(209, 145)
        }
        if b1 >= 144 && b1 <= 159 {
            return fts_two_b(208, b1 + 32)
        }
        if b1 >= 160 && b1 <= 175 {
            return fts_two_b(209, b1 - 32)
        }
    }
    return fts_two_b(b0, b1)
}

// Cyrillic letter lead? D0 + (Ё|А-я range) or D1 + (р-я|ё)
fn fts_is_cyr_pair(b0: i64, b1: i64) -> i64 {
    if b0 == 208 {
        if b1 == 129 {
            return 1
        }
        if b1 >= 144 && b1 <= 175 {
            return 1
        }
        if b1 >= 176 && b1 <= 191 {
            return 1
        }
        return 0
    }
    if b0 == 209 {
        if b1 >= 128 && b1 <= 143 {
            return 1
        }
        if b1 == 145 {
            return 1
        }
        return 0
    }
    return 0
}

fn fts_is_ascii_term(c: i64) -> i64 {
    if c >= 97 && c <= 122 {
        return 1
    }
    if c >= 65 && c <= 90 {
        return 1
    }
    if c >= 48 && c <= 57 {
        return 1
    }
    return 0
}

// Текст → terms (дубликатите се пазят — честотата има значение за BM25).
fn fts_tokenize(text: str) -> Vec<str> {
    let out: Vec<str> = vec_new()
    let sb = bytes_of_str(text)
    let n = bytes_len(sb)
    let mut run = bytes_new(0)
    let mut i: i64 = 0
    while i < n {
        let c = bytes_at(sb, i) & 255
        if fts_is_ascii_term(c) == 1 {
            let mut lo = c
            if c >= 65 && c <= 90 {
                lo = c + 32
            }
            run = bytes_concat(run, fts_one_b(lo))
            i = i + 1
        } else {
            if i + 1 < n {
                let b1 = bytes_at(sb, i + 1) & 255
                if fts_is_cyr_pair(c, b1) == 1 {
                    run = bytes_concat(run, fts_fold_cyr2(c, b1))
                    i = i + 2
                } else {
                    if c >= 128 {
                        run = bytes_concat(run, fts_one_b(c))
                        i = i + 1
                    } else {
                        if bytes_len(run) > 0 {
                            vec_push(out, str_of_bytes(run))
                            run = bytes_new(0)
                        }
                        i = i + 1
                    }
                }
            } else {
                if c >= 128 {
                    run = bytes_concat(run, fts_one_b(c))
                    i = i + 1
                } else {
                    if bytes_len(run) > 0 {
                        vec_push(out, str_of_bytes(run))
                        run = bytes_new(0)
                    }
                    i = i + 1
                }
            }
        }
    }
    if bytes_len(run) > 0 {
        vec_push(out, str_of_bytes(run))
    }
    return out
}

// Брой срещания на term в списъка (term frequency).
fn fts_tf(terms: Vec<str>, term: str) -> i64 {
    let mut c: i64 = 0
    let mut i: i64 = 0
    while i < vec_len(terms) {
        if vec_get(terms, i) == term {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// F5: phrase match with gaps (PG: a <-> b ≡ a <1> b; a <N> b → b at i+N).
fn fts_phrase_match_gaps(doc: Vec<str>, phrase: Vec<str>, gaps: Vec<i64>) -> i64 {
    let pn = vec_len(phrase)
    if pn == 0 { return 1 }
    let dn = vec_len(doc)
    if pn == 1 {
        let mut i: i64 = 0
        while i < dn {
            if vec_get(doc, i) == vec_get(phrase, 0) { return 1 }
            i = i + 1
        }
        return 0
    }
    let mut i: i64 = 0
    while i < dn {
        if vec_get(doc, i) == vec_get(phrase, 0) {
            let mut pos = i
            let mut ok = true
            let mut j: i64 = 0
            while j + 1 < pn {
                let mut g: i64 = 1
                if j < vec_len(gaps) { g = vec_get(gaps, j) }
                if g < 1 { g = 1 }
                pos = pos + g
                if pos >= dn {
                    ok = false
                    j = pn
                } else {
                    if vec_get(doc, pos) != vec_get(phrase, j + 1) {
                        ok = false
                        j = pn
                    }
                }
                j = j + 1
            }
            if ok { return 1 }
        }
        i = i + 1
    }
    return 0
}

fn fts_phrase_match(doc: Vec<str>, phrase: Vec<str>) -> i64 {
    let gaps: Vec<i64> = vec_new()
    let mut i: i64 = 0
    while i + 1 < vec_len(phrase) {
        vec_push(gaps, 1)
        i = i + 1
    }
    return fts_phrase_match_gaps(doc, phrase, gaps)
}

// F3: BM25 idf via integer ln (×1000).
fn fts_ilog2(x: i64) -> i64 {
    if x <= 1 {
        return 0
    }
    let mut n: i64 = 0
    let mut v = x
    while v > 1 {
        v = v / 2
        n = n + 1
    }
    return n
}

fn fts_ln_x1000(x: i64) -> i64 {
    if x <= 1 {
        return 0
    }
    let e = fts_ilog2(x)
    let mut p2: i64 = 1
    let mut i: i64 = 0
    while i < e {
        p2 = p2 * 2
        i = i + 1
    }
    let m = (x * 1000) / p2
    let y = m - 1000
    let y2 = (y * y) / 1000
    let y3 = (y2 * y) / 1000
    let ln_m = y - y2 / 2 + y3 / 3
    return e * 693 + ln_m
}

// idf ×1000 = ln(1 + (N-df+0.5)/(df+0.5))
fn fts_bm25_idf(n: i64, df: i64) -> i64 {
    let mut d = df
    if d < 1 {
        d = 1
    }
    let mut nn = n
    if nn < d {
        nn = d
    }
    let num = (nn - d) * 2 + 1
    let den = d * 2 + 1
    let mut idf = fts_ln_x1000(den + num) - fts_ln_x1000(den)
    if idf < 0 {
        idf = 0
    }
    return idf
}

// Уникални terms (за индексиране без повторения).
fn fts_unique(terms: Vec<str>) -> Vec<str> {
    let out: Vec<str> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(terms) {
        let t = vec_get(terms, i)
        let mut dup = false
        let mut j: i64 = 0
        while j < vec_len(out) {
            if vec_get(out, j) == t {
                dup = true
            }
            j = j + 1
        }
        if dup == false {
            vec_push(out, t)
        }
        i = i + 1
    }
    return out
}
