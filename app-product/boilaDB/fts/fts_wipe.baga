// fts_wipe.baga — table/index wipe + truncate reset (kimi-deps D5).
// Catalog cascade lives here; sql/exec_drop orchestrates.

import "fts.baga"
import "fts_doc.baga"
import "../storage/shards.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "../core/row.baga"
import "../catalog/schema.baga"
import "../catalog/drop.baga"
import "../txn/mvcc.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

// DROP FTS INDEX: cat + list + stats; wipe fts CF if last on table.
fn fts_drop_index_txn(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, ix_name: str) -> BoilaFtsRes !IO !Time !Par {
    let gl = fts_list_for_table(s, t.id)?
    s = gl.s
    let mut found = 0
    let mut fid: i64 = 0
    let kept: Vec<BoilaFtsDef> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(gl.defs) {
        let d = vec_get(gl.defs, i)
        if d.name == ix_name {
            found = 1
            fid = d.id
        } else {
            vec_push(kept, d)
        }
        i = i + 1
    }
    if found == 0 {
        return BoilaFtsRes { s: s, txn: txn, ok: 0, err: "miss", state: "42704", id: 0 }
    }
    let d1 = boila_txn_del(s, txn, boila_cf_sys(), 1, fts_cat_pk(t.id, ix_name))
    if d1.ok == 0 { return BoilaFtsRes { s: d1.s, txn: d1.txn, ok: 0, err: d1.err, state: d1.state, id: 0 } }
    s = d1.s
    txn = d1.txn
    let d2 = boila_txn_del(s, txn, boila_cf_sys(), 1, fts_stats_pk(fid))
    if d2.ok == 0 { return BoilaFtsRes { s: d2.s, txn: d2.txn, ok: 0, err: d2.err, state: d2.state, id: 0 } }
    s = d2.s
    txn = d2.txn
    if vec_len(kept) == 0 {
        let d3 = boila_txn_del(s, txn, boila_cf_sys(), 1, fts_list_pk(t.id))
        if d3.ok == 0 { return BoilaFtsRes { s: d3.s, txn: d3.txn, ok: 0, err: d3.err, state: d3.state, id: 0 } }
        s = d3.s
        txn = d3.txn
        let w = boila_cf_wipe_txn(s, txn, boila_cf_fts(), t.id)?
        if w.ok == 0 { return BoilaFtsRes { s: w.s, txn: w.txn, ok: 0, err: w.err, state: w.state, id: 0 } }
        s = w.s
        txn = w.txn
    } else {
        let rl = boila_txn_put(s, txn, boila_cf_sys(), 1, fts_list_pk(t.id), fts_defs_enc(kept))
        if rl.ok == 0 { return BoilaFtsRes { s: s, txn: rl.txn, ok: 0, err: rl.err, state: rl.state, id: 0 } }
        s = rl.s
        txn = rl.txn
    }
    return BoilaFtsRes { s: s, txn: txn, ok: 1, err: "", state: "", id: fid }
}

// DROP TABLE: wipe all FTS catalog + fts CF for table_id.
fn fts_wipe_table_txn(s: BoilaStore, txn: BoilaTxn, tid: i64) -> BoilaFtsRes !IO !Time !Par {
    let w = boila_cf_wipe_txn(s, txn, boila_cf_fts(), tid)?
    if w.ok == 0 { return BoilaFtsRes { s: w.s, txn: w.txn, ok: 0, err: w.err, state: w.state, id: 0 } }
    s = w.s
    txn = w.txn
    let ftsl = fts_list_for_table(s, tid)?
    s = ftsl.s
    let mut fi: i64 = 0
    while fi < vec_len(ftsl.defs) {
        let d = vec_get(ftsl.defs, fi)
        let a = boila_drop_txn_del(s, txn, fts_cat_pk(tid, d.name))
        if a.ok == 0 { return BoilaFtsRes { s: a.s, txn: a.txn, ok: 0, err: a.err, state: a.state, id: 0 } }
        s = a.s
        txn = a.txn
        let b = boila_drop_txn_del(s, txn, fts_stats_pk(d.id))
        if b.ok == 0 { return BoilaFtsRes { s: b.s, txn: b.txn, ok: 0, err: b.err, state: b.state, id: 0 } }
        s = b.s
        txn = b.txn
        fi = fi + 1
    }
    let fl = boila_drop_txn_del(s, txn, fts_list_pk(tid))
    if fl.ok == 0 { return BoilaFtsRes { s: fl.s, txn: fl.txn, ok: 0, err: fl.err, state: fl.state, id: 0 } }
    return BoilaFtsRes { s: fl.s, txn: fl.txn, ok: 1, err: "", state: "", id: tid }
}

// Non-txn path (direct store).
fn fts_wipe_table(s: BoilaStore, tid: i64) -> BoilaStore !IO !Time !Par {
    s = boila_cf_wipe(s, boila_cf_fts(), tid)?
    let ftsl = fts_list_for_table(s, tid)?
    s = ftsl.s
    let mut fi: i64 = 0
    while fi < vec_len(ftsl.defs) {
        let d = vec_get(ftsl.defs, fi)
        s = boila_del(s, boila_cf_sys(), 1, fts_cat_pk(tid, d.name))?
        s = boila_del(s, boila_cf_sys(), 1, fts_stats_pk(d.id))?
        fi = fi + 1
    }
    return boila_del(s, boila_cf_sys(), 1, fts_list_pk(tid))?
}

// TRUNCATE: keep defs, zero stats, wipe fts CF payloads.
fn fts_reset_table_txn(s: BoilaStore, txn: BoilaTxn, tid: i64) -> BoilaFtsRes !IO !Time !Par {
    let w = boila_cf_wipe_txn(s, txn, boila_cf_fts(), tid)?
    if w.ok == 0 { return BoilaFtsRes { s: w.s, txn: w.txn, ok: 0, err: w.err, state: w.state, id: 0 } }
    s = w.s
    txn = w.txn
    let ftsl = fts_list_for_table(s, tid)?
    s = ftsl.s
    let mut fi: i64 = 0
    while fi < vec_len(ftsl.defs) {
        let d = vec_get(ftsl.defs, fi)
        let su = fts_stats_write(s, txn, d.id, 0, 0)
        s = su.s
        txn = su.txn
        fi = fi + 1
    }
    return BoilaFtsRes { s: s, txn: txn, ok: 1, err: "", state: "", id: tid }
}
