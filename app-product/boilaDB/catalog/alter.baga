// alter.baga — ALTER TABLE ADD/RENAME/DROP COLUMN (schema only).
// DROP COLUMN cascade (ix/fts/hnsw/graph check) → sql/exec_alter (D5).
import "schema.baga"
import "ddl_types.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "../core/row.baga"
import "../txn/mvcc.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

fn boila_cat_add_col_txn(s: BoilaStore, txn: BoilaTxn, table: str, col: str, typ: i64) -> BoilaCatTxnRes !IO !Time !Par {
    let ct = boila_cat_by_name_txn(s, txn, table)?
    s = ct.s
    if ct.ok == 0 {
        return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: ct.err, state: ct.state, table: boila_cat_empty_table(), id: 0 }
    }
    let t = ct.table
    let mut i: i64 = 0
    while i < vec_len(t.cols) {
        if vec_get(t.cols, i).name == col {
            return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: concat("колона '", concat(col, "' вече съществува")), state: "42701", table: boila_cat_empty_table(), id: 0 }
        }
        i = i + 1
    }
    let mut t2 = t
    vec_push(t2.cols, boila_coldef(col, typ))
    let r = boila_txn_put(s, txn, boila_cf_sys(), 1, boila_cat_pk_schema(t2.id), boila_row_enc(boila_cat_schema_row(t2)))
    if r.ok == 0 {
        return BoilaCatTxnRes { s: s, txn: r.txn, ok: 0, err: r.err, state: r.state, table: boila_cat_empty_table(), id: 0 }
    }
    return BoilaCatTxnRes { s: s, txn: r.txn, ok: 1, err: "", state: "", table: t2, id: t2.id }
}

// RENAME TABLE: swap n|<name> keys; schema id unchanged.
fn boila_cat_rename_table_txn(s: BoilaStore, txn: BoilaTxn, old_name: str, new_name: str) -> BoilaCatTxnRes !IO !Time !Par {
    if old_name == new_name {
        let ct0 = boila_cat_by_name_txn(s, txn, old_name)?
        if ct0.ok == 0 {
            return BoilaCatTxnRes { s: ct0.s, txn: txn, ok: 0, err: ct0.err, state: ct0.state, table: boila_cat_empty_table(), id: 0 }
        }
        return BoilaCatTxnRes { s: ct0.s, txn: txn, ok: 1, err: "", state: "", table: ct0.table, id: ct0.table.id }
    }
    let ct = boila_cat_by_name_txn(s, txn, old_name)?
    s = ct.s
    if ct.ok == 0 {
        return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: ct.err, state: ct.state, table: boila_cat_empty_table(), id: 0 }
    }
    let t = ct.table
    let dup = boila_cat_by_name_txn(s, txn, new_name)?
    s = dup.s
    if dup.ok == 1 {
        return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: concat("таблица '", concat(new_name, "' вече съществува")), state: "42P07", table: boila_cat_empty_table(), id: 0 }
    }
    let idrow: Vec<BoilaVal> = vec_new()
    vec_push(idrow, boila_val_i64(t.id))
    let r1 = boila_txn_put(s, txn, boila_cf_sys(), 1, boila_cat_pk_name(new_name), boila_row_enc(idrow))
    if r1.ok == 0 {
        return BoilaCatTxnRes { s: s, txn: r1.txn, ok: 0, err: r1.err, state: r1.state, table: boila_cat_empty_table(), id: 0 }
    }
    txn = r1.txn
    let r2 = boila_txn_del(s, txn, boila_cf_sys(), 1, boila_cat_pk_name(old_name))
    if r2.ok == 0 {
        return BoilaCatTxnRes { s: r2.s, txn: r2.txn, ok: 0, err: r2.err, state: r2.state, table: boila_cat_empty_table(), id: 0 }
    }
    let t2 = BoilaTable { id: t.id, name: new_name, cols: t.cols, pk_idx: t.pk_idx, ixs: t.ixs, ttl_sec: t.ttl_sec }
    return BoilaCatTxnRes { s: r2.s, txn: r2.txn, ok: 1, err: "", state: "", table: t2, id: t.id }
}

// RENAME COLUMN: schema rewrite only (data is positional).
fn boila_cat_rename_col_txn(s: BoilaStore, txn: BoilaTxn, table: str, old_col: str, new_col: str) -> BoilaCatTxnRes !IO !Time !Par {
    let ct = boila_cat_by_name_txn(s, txn, table)?
    s = ct.s
    if ct.ok == 0 {
        return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: ct.err, state: ct.state, table: boila_cat_empty_table(), id: 0 }
    }
    let t = ct.table
    if old_col == new_col {
        return BoilaCatTxnRes { s: s, txn: txn, ok: 1, err: "", state: "", table: t, id: t.id }
    }
    let mut found = 0
    let mut i: i64 = 0
    while i < vec_len(t.cols) {
        let n = vec_get(t.cols, i).name
        if n == new_col {
            return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: concat("колона '", concat(new_col, "' вече съществува")), state: "42701", table: boila_cat_empty_table(), id: 0 }
        }
        if n == old_col { found = 1 }
        i = i + 1
    }
    if found == 0 {
        return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: concat("колона '", concat(old_col, "' не съществува")), state: "42703", table: boila_cat_empty_table(), id: 0 }
    }
    let ncols: Vec<BoilaColDef> = vec_new()
    i = 0
    while i < vec_len(t.cols) {
        let c = vec_get(t.cols, i)
        if c.name == old_col {
            vec_push(ncols, boila_coldef(new_col, c.typ))
        } else {
            vec_push(ncols, c)
        }
        i = i + 1
    }
    let t2 = BoilaTable { id: t.id, name: t.name, cols: ncols, pk_idx: t.pk_idx, ixs: t.ixs, ttl_sec: t.ttl_sec }
    let r = boila_txn_put(s, txn, boila_cf_sys(), 1, boila_cat_pk_schema(t2.id), boila_row_enc(boila_cat_schema_row(t2)))
    if r.ok == 0 {
        return BoilaCatTxnRes { s: s, txn: r.txn, ok: 0, err: r.err, state: r.state, table: boila_cat_empty_table(), id: 0 }
    }
    return BoilaCatTxnRes { s: s, txn: r.txn, ok: 1, err: "", state: "", table: t2, id: t2.id }
}

// DROP COLUMN schema rewrite only (last non-PK). Caller cascades first.
fn boila_cat_drop_col_txn(s: BoilaStore, txn: BoilaTxn, table: str, col: str) -> BoilaCatTxnRes !IO !Time !Par {
    let ct = boila_cat_by_name_txn(s, txn, table)?
    s = ct.s
    if ct.ok == 0 {
        return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: ct.err, state: ct.state, table: boila_cat_empty_table(), id: 0 }
    }
    let t = ct.table
    let mut cix: i64 = 0 - 1
    let mut i: i64 = 0
    while i < vec_len(t.cols) {
        if vec_get(t.cols, i).name == col { cix = i }
        i = i + 1
    }
    if cix < 0 {
        return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: concat("колона '", concat(col, "' не съществува")), state: "42703", table: boila_cat_empty_table(), id: 0 }
    }
    if cix == t.pk_idx {
        return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: "не може DROP PRIMARY KEY колона", state: "0A000", table: boila_cat_empty_table(), id: 0 }
    }
    if cix != vec_len(t.cols) - 1 {
        return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: "DROP COLUMN само последната колона (позиционни редове)", state: "0A000", table: boila_cat_empty_table(), id: 0 }
    }
    let ncols: Vec<BoilaColDef> = vec_new()
    i = 0
    while i < cix {
        vec_push(ncols, vec_get(t.cols, i))
        i = i + 1
    }
    let t2 = BoilaTable { id: t.id, name: t.name, cols: ncols, pk_idx: t.pk_idx, ixs: t.ixs, ttl_sec: t.ttl_sec }
    let r = boila_txn_put(s, txn, boila_cf_sys(), 1, boila_cat_pk_schema(t2.id), boila_row_enc(boila_cat_schema_row(t2)))
    if r.ok == 0 {
        return BoilaCatTxnRes { s: s, txn: r.txn, ok: 0, err: r.err, state: r.state, table: boila_cat_empty_table(), id: 0 }
    }
    return BoilaCatTxnRes { s: s, txn: r.txn, ok: 1, err: "", state: "", table: t2, id: t2.id }
}


