// alter.baga — ALTER TABLE ADD COLUMN / RENAME TO / RENAME COLUMN.
import "schema.baga"
import "drop.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "../core/row.baga"
import "../sql/ast.baga"
import "../sql/parse_alter.baga"
import "../fts/fts.baga"
import "../vector/hnsw_store.baga"
import "../graph/adjacency.baga"
import "../index/ix_drop.baga"
import "../txn/mvcc.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

fn boila_cat_add_col_txn(s: BoilaStore, txn: BoilaTxn, table: str, col: str, typ: i64) -> BoilaCatTxnRes !IO !Time !Par {
    let ct = boila_cat_by_name_txn(s, txn, table)?
    s = ct.s
    if ct.ok == 0 {
        return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: ct.err, state: ct.state, table: boila_cat_empty_table(), id: 0 }
    }
    let t = ct.table
    let mut i: i64 = 0
    while i < vec_len(t.cols) {
        if vec_get(t.cols, i).name == col {
            return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: concat("колона '", concat(col, "' вече съществува")), state: "42701", table: boila_cat_empty_table(), id: 0 }
        }
        i = i + 1
    }
    let mut t2 = t
    vec_push(t2.cols, boila_coldef(col, typ))
    let r = boila_txn_put(s, txn, boila_cf_sys(), 1, boila_cat_pk_schema(t2.id), boila_row_enc(boila_cat_schema_row(t2)))
    if r.ok == 0 {
        return BoilaCatTxnRes { s: s, txn: r.txn, ok: 0, err: r.err, state: r.state, table: boila_cat_empty_table(), id: 0 }
    }
    return BoilaCatTxnRes { s: s, txn: r.txn, ok: 1, err: "", state: "", table: t2, id: t2.id }
}

// RENAME TABLE: swap n|<name> keys; schema id unchanged.
fn boila_cat_rename_table_txn(s: BoilaStore, txn: BoilaTxn, old_name: str, new_name: str) -> BoilaCatTxnRes !IO !Time !Par {
    if old_name == new_name {
        let ct0 = boila_cat_by_name_txn(s, txn, old_name)?
        if ct0.ok == 0 {
            return BoilaCatTxnRes { s: ct0.s, txn: txn, ok: 0, err: ct0.err, state: ct0.state, table: boila_cat_empty_table(), id: 0 }
        }
        return BoilaCatTxnRes { s: ct0.s, txn: txn, ok: 1, err: "", state: "", table: ct0.table, id: ct0.table.id }
    }
    let ct = boila_cat_by_name_txn(s, txn, old_name)?
    s = ct.s
    if ct.ok == 0 {
        return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: ct.err, state: ct.state, table: boila_cat_empty_table(), id: 0 }
    }
    let t = ct.table
    let dup = boila_cat_by_name_txn(s, txn, new_name)?
    s = dup.s
    if dup.ok == 1 {
        return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: concat("таблица '", concat(new_name, "' вече съществува")), state: "42P07", table: boila_cat_empty_table(), id: 0 }
    }
    let idrow: Vec<BoilaVal> = vec_new()
    vec_push(idrow, boila_val_i64(t.id))
    let r1 = boila_txn_put(s, txn, boila_cf_sys(), 1, boila_cat_pk_name(new_name), boila_row_enc(idrow))
    if r1.ok == 0 {
        return BoilaCatTxnRes { s: s, txn: r1.txn, ok: 0, err: r1.err, state: r1.state, table: boila_cat_empty_table(), id: 0 }
    }
    txn = r1.txn
    let r2 = boila_txn_del(s, txn, boila_cf_sys(), 1, boila_cat_pk_name(old_name))
    if r2.ok == 0 {
        return BoilaCatTxnRes { s: r2.s, txn: r2.txn, ok: 0, err: r2.err, state: r2.state, table: boila_cat_empty_table(), id: 0 }
    }
    let t2 = BoilaTable { id: t.id, name: new_name, cols: t.cols, pk_idx: t.pk_idx, ixs: t.ixs, ttl_sec: t.ttl_sec }
    return BoilaCatTxnRes { s: r2.s, txn: r2.txn, ok: 1, err: "", state: "", table: t2, id: t.id }
}

// RENAME COLUMN: schema rewrite only (data is positional).
fn boila_cat_rename_col_txn(s: BoilaStore, txn: BoilaTxn, table: str, old_col: str, new_col: str) -> BoilaCatTxnRes !IO !Time !Par {
    let ct = boila_cat_by_name_txn(s, txn, table)?
    s = ct.s
    if ct.ok == 0 {
        return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: ct.err, state: ct.state, table: boila_cat_empty_table(), id: 0 }
    }
    let t = ct.table
    if old_col == new_col {
        return BoilaCatTxnRes { s: s, txn: txn, ok: 1, err: "", state: "", table: t, id: t.id }
    }
    let mut found = 0
    let mut i: i64 = 0
    while i < vec_len(t.cols) {
        let n = vec_get(t.cols, i).name
        if n == new_col {
            return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: concat("колона '", concat(new_col, "' вече съществува")), state: "42701", table: boila_cat_empty_table(), id: 0 }
        }
        if n == old_col { found = 1 }
        i = i + 1
    }
    if found == 0 {
        return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: concat("колона '", concat(old_col, "' не съществува")), state: "42703", table: boila_cat_empty_table(), id: 0 }
    }
    let ncols: Vec<BoilaColDef> = vec_new()
    i = 0
    while i < vec_len(t.cols) {
        let c = vec_get(t.cols, i)
        if c.name == old_col {
            vec_push(ncols, boila_coldef(new_col, c.typ))
        } else {
            vec_push(ncols, c)
        }
        i = i + 1
    }
    let t2 = BoilaTable { id: t.id, name: t.name, cols: ncols, pk_idx: t.pk_idx, ixs: t.ixs, ttl_sec: t.ttl_sec }
    let r = boila_txn_put(s, txn, boila_cf_sys(), 1, boila_cat_pk_schema(t2.id), boila_row_enc(boila_cat_schema_row(t2)))
    if r.ok == 0 {
        return BoilaCatTxnRes { s: s, txn: r.txn, ok: 0, err: r.err, state: r.state, table: boila_cat_empty_table(), id: 0 }
    }
    return BoilaCatTxnRes { s: s, txn: r.txn, ok: 1, err: "", state: "", table: t2, id: t2.id }
}

// DROP COLUMN: last non-PK only. CASCADE drops secondary/FTS/HNSW on col; GRAPH still blocks.
fn boila_cat_drop_col_txn(s: BoilaStore, txn: BoilaTxn, table: str, col: str) -> BoilaCatTxnRes !IO !Time !Par {
    let ct = boila_cat_by_name_txn(s, txn, table)?
    s = ct.s
    if ct.ok == 0 {
        return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: ct.err, state: ct.state, table: boila_cat_empty_table(), id: 0 }
    }
    let mut t = ct.table
    let mut cix: i64 = 0 - 1
    let mut i: i64 = 0
    while i < vec_len(t.cols) {
        if vec_get(t.cols, i).name == col { cix = i }
        i = i + 1
    }
    if cix < 0 {
        return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: concat("колона '", concat(col, "' не съществува")), state: "42703", table: boila_cat_empty_table(), id: 0 }
    }
    if cix == t.pk_idx {
        return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: "не може DROP PRIMARY KEY колона", state: "0A000", table: boila_cat_empty_table(), id: 0 }
    }
    if cix != vec_len(t.cols) - 1 {
        return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: "DROP COLUMN само последната колона (позиционни редове)", state: "0A000", table: boila_cat_empty_table(), id: 0 }
    }
    // GRAPH still requires explicit DROP GRAPH
    let grpl = graph_list_for_table(s, t.id)?
    s = grpl.s
    i = 0
    while i < vec_len(grpl.defs) {
        let d = vec_get(grpl.defs, i)
        if d.src_idx == cix || d.dst_idx == cix || d.w_idx == cix {
            return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: "колоната се ползва от GRAPH — DROP GRAPH първо", state: "2BP01", table: boila_cat_empty_table(), id: 0 }
        }
        i = i + 1
    }
    // cascade secondary indexes on this col (names live in x|<tid>|<name>)
    let pref = bytes_of_str(concat(concat("x|", int_to_str(t.id)), "|"))
    let ks = boila_cf_keys_raw(s, boila_cf_sys(), 1)?
    s = ks.s
    let names: Vec<str> = vec_new()
    i = 0
    while i < vec_len(ks.pks) {
        let pk = vec_get(ks.pks, i)
        if boila_bytes_has_prefix(pk, pref) == 1 {
            let g = boila_get(s, boila_cf_sys(), 1, pk)?
            s = g.s
            if g.found == 1 {
                let row = boila_row_dec(g.val)
                if vec_len(row) >= 2 && vec_get(row, 1).i == cix {
                    let full = str_of_bytes(pk)
                    let pfx = concat(concat("x|", int_to_str(t.id)), "|")
                    // name after prefix
                    if len(full) > len(pfx) {
                        vec_push(names, substr(full, len(pfx), len(full)))
                    }
                }
            }
        }
        i = i + 1
    }
    i = 0
    while i < vec_len(names) {
        let dr = boila_ix_drop_sec(s, txn, t, vec_get(names, i))?
        s = dr.s
        txn = dr.txn
        if dr.ok == 0 {
            return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: dr.err, state: dr.state, table: boila_cat_empty_table(), id: 0 }
        }
        // refresh table after schema rewrite in drop_sec
        let ct2 = boila_cat_by_name_txn(s, txn, table)?
        s = ct2.s
        if ct2.ok == 1 { t = ct2.table }
        i = i + 1
    }
    // cascade FTS
    let ftsl = fts_list_for_table(s, t.id)?
    s = ftsl.s
    i = 0
    while i < vec_len(ftsl.defs) {
        let d = vec_get(ftsl.defs, i)
        if d.col_idx == cix {
            let dr = boila_ix_drop_fts(s, txn, t, d.name)?
            s = dr.s
            txn = dr.txn
            if dr.ok == 0 {
                return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: dr.err, state: dr.state, table: boila_cat_empty_table(), id: 0 }
            }
        }
        i = i + 1
    }
    // cascade HNSW
    let hnswl = hnsw_list_for_table(s, t.id)?
    s = hnswl.s
    i = 0
    while i < vec_len(hnswl.defs) {
        let d = vec_get(hnswl.defs, i)
        if d.col_idx == cix {
            let dr = boila_ix_drop_hnsw(s, txn, t, d.name)?
            s = dr.s
            txn = dr.txn
            if dr.ok == 0 {
                return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: dr.err, state: dr.state, table: boila_cat_empty_table(), id: 0 }
            }
        }
        i = i + 1
    }
    let ct3 = boila_cat_by_name_txn(s, txn, table)?
    s = ct3.s
    if ct3.ok == 1 { t = ct3.table }
    // recompute cix after possible no-op
    cix = 0 - 1
    i = 0
    while i < vec_len(t.cols) {
        if vec_get(t.cols, i).name == col { cix = i }
        i = i + 1
    }
    if cix < 0 || cix != vec_len(t.cols) - 1 {
        return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: "DROP COLUMN вътрешна грешка", state: "XX000", table: boila_cat_empty_table(), id: 0 }
    }
    let ncols: Vec<BoilaColDef> = vec_new()
    i = 0
    while i < cix {
        vec_push(ncols, vec_get(t.cols, i))
        i = i + 1
    }
    let t2 = BoilaTable { id: t.id, name: t.name, cols: ncols, pk_idx: t.pk_idx, ixs: t.ixs, ttl_sec: t.ttl_sec }
    let r = boila_txn_put(s, txn, boila_cf_sys(), 1, boila_cat_pk_schema(t2.id), boila_row_enc(boila_cat_schema_row(t2)))
    if r.ok == 0 {
        return BoilaCatTxnRes { s: s, txn: r.txn, ok: 0, err: r.err, state: r.state, table: boila_cat_empty_table(), id: 0 }
    }
    return BoilaCatTxnRes { s: s, txn: r.txn, ok: 1, err: "", state: "", table: t2, id: t2.id }
}

fn boila_alter_run(s: BoilaStore, txn: BoilaTxn, db: str, alt: BoilaAlter) -> BoilaCatTxnRes !IO !Time !Par {
    let was = txn.active
    if was == 0 {
        let b = boila_txn_begin(s, txn, 0, db)?
        s = b.s
        txn = b.txn
    }
    let mut ar = BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: "unknown alter", state: "XX000", table: boila_cat_empty_table(), id: 0 }
    if alt.kind == 1 {
        ar = boila_cat_add_col_txn(s, txn, alt.table, alt.col, alt.typ)?
    }
    if alt.kind == 2 {
        ar = boila_cat_rename_table_txn(s, txn, alt.table, alt.new_name)?
    }
    if alt.kind == 3 {
        ar = boila_cat_rename_col_txn(s, txn, alt.table, alt.col, alt.new_name)?
    }
    if alt.kind == 4 {
        ar = boila_cat_drop_col_txn(s, txn, alt.table, alt.col)?
    }
    s = ar.s
    txn = ar.txn
    if ar.ok == 0 {
        if was == 0 { txn = boila_txn_rollback(txn) }
        return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: ar.err, state: ar.state, table: boila_cat_empty_table(), id: 0 }
    }
    if was == 0 {
        let c = boila_txn_commit(s, txn)?
        s = c.s
        txn = c.txn
        if c.ok == 0 {
            return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: c.err, state: c.state, table: boila_cat_empty_table(), id: 0 }
        }
    }
    return BoilaCatTxnRes { s: s, txn: txn, ok: 1, err: "", state: "", table: ar.table, id: ar.id }
}

// legacy
fn boila_alter_add_run(s: BoilaStore, txn: BoilaTxn, db: str, table: str, col: str, typ: i64) -> BoilaCatTxnRes !IO !Time !Par {
    return boila_alter_run(s, txn, db, BoilaAlter { kind: 1, table: table, col: col, typ: typ, new_name: "" })?
}
