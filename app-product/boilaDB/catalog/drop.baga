// drop.baga — DROP TABLE core wipe (catalog + data/index CF only).
// Modal cascade (fts/vec/graph) is orchestrated in sql/exec_drop (kimi-deps D5).

import "schema.baga"
import "../storage/shards.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "../core/row.baga"
import "../txn/mvcc.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

fn boila_bytes_has_prefix(pk: bytes, pre: bytes) -> i64 {
    if bytes_len(pk) < bytes_len(pre) {
        return 0
    }
    let mut i: i64 = 0
    while i < bytes_len(pre) {
        if bytes_at(pk, i) != bytes_at(pre, i) {
            return 0
        }
        i = i + 1
    }
    return 1
}

// Delete sys (table_id=1) keys whose pk starts with prefix.
fn boila_sys_prefix_wipe(s: BoilaStore, prefix: str) -> BoilaStore !IO !Time !Par {
    let pre = bytes_of_str(prefix)
    let ks = boila_cf_keys_raw(s, boila_cf_sys(), 1)?
    s = ks.s
    let mut i: i64 = 0
    while i < vec_len(ks.pks) {
        let pk = vec_get(ks.pks, i)
        if boila_bytes_has_prefix(pk, pre) == 1 {
            s = boila_del(s, boila_cf_sys(), 1, pk)?
        }
        i = i + 1
    }
    return s
}

fn boila_cf_wipe_txn(s: BoilaStore, txn: BoilaTxn, cf: i64, table_id: i64) -> BoilaCatTxnRes !IO !Time !Par {
    let ks = boila_cf_keys_raw(s, cf, table_id)?
    s = ks.s
    let mut i: i64 = 0
    while i < vec_len(ks.pks) {
        let r = boila_txn_del(s, txn, cf, table_id, vec_get(ks.pks, i))
        s = r.s
        txn = r.txn
        if r.ok == 0 {
            return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: r.err, state: r.state, table: boila_cat_empty_table(), id: 0 }
        }
        i = i + 1
    }
    return BoilaCatTxnRes { s: s, txn: txn, ok: 1, err: "", state: "", table: boila_cat_empty_table(), id: 0 }
}

fn boila_sys_prefix_wipe_txn(s: BoilaStore, txn: BoilaTxn, prefix: str) -> BoilaCatTxnRes !IO !Time !Par {
    let pre = bytes_of_str(prefix)
    let ks = boila_cf_keys_raw(s, boila_cf_sys(), 1)?
    s = ks.s
    let mut i: i64 = 0
    while i < vec_len(ks.pks) {
        let pk = vec_get(ks.pks, i)
        if boila_bytes_has_prefix(pk, pre) == 1 {
            let r = boila_txn_del(s, txn, boila_cf_sys(), 1, pk)
            s = r.s
            txn = r.txn
            if r.ok == 0 {
                return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: r.err, state: r.state, table: boila_cat_empty_table(), id: 0 }
            }
        }
        i = i + 1
    }
    return BoilaCatTxnRes { s: s, txn: txn, ok: 1, err: "", state: "", table: boila_cat_empty_table(), id: 0 }
}

fn boila_drop_txn_del(s: BoilaStore, txn: BoilaTxn, pk: bytes) -> BoilaCatTxnRes {
    let r = boila_txn_del(s, txn, boila_cf_sys(), 1, pk)
    if r.ok == 0 {
        return BoilaCatTxnRes { s: r.s, txn: r.txn, ok: 0, err: r.err, state: r.state, table: boila_cat_empty_table(), id: 0 }
    }
    return BoilaCatTxnRes { s: r.s, txn: r.txn, ok: 1, err: "", state: "", table: boila_cat_empty_table(), id: 0 }
}

// Core DROP: data + index CF, secondary name cats x|*, name/schema/ttl.
// Caller must wipe fts/vec/graph first (sql/exec_drop).
fn boila_table_drop_core_txn(s: BoilaStore, txn: BoilaTxn, name: str) -> BoilaCatTxnRes !IO !Time !Par {
    let ct = boila_cat_by_name_txn(s, txn, name)?
    s = ct.s
    if ct.ok == 0 {
        return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: ct.err, state: ct.state, table: ct.table, id: 0 }
    }
    let t = ct.table
    let tid = t.id

    let w1 = boila_cf_wipe_txn(s, txn, boila_cf_data(), tid)?
    s = w1.s
    txn = w1.txn
    if w1.ok == 0 { return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: w1.err, state: w1.state, table: t, id: 0 } }
    let w2 = boila_cf_wipe_txn(s, txn, boila_cf_index(), tid)?
    s = w2.s
    txn = w2.txn
    if w2.ok == 0 { return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: w2.err, state: w2.state, table: t, id: 0 } }

    let xp = boila_sys_prefix_wipe_txn(s, txn, concat(concat("x|", int_to_str(tid)), "|"))?
    s = xp.s
    txn = xp.txn
    if xp.ok == 0 { return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: xp.err, state: xp.state, table: t, id: 0 } }
    // K3j rollup catalog: ru|<tid>|* and list rul|<tid>
    let rp = boila_sys_prefix_wipe_txn(s, txn, concat(concat("ru|", int_to_str(tid)), "|"))?
    s = rp.s
    txn = rp.txn
    if rp.ok == 0 { return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: rp.err, state: rp.state, table: t, id: 0 } }
    let rld = boila_drop_txn_del(s, txn, bytes_of_str(concat("rul|", int_to_str(tid))))
    s = rld.s
    txn = rld.txn
    if rld.ok == 0 { return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: rld.err, state: rld.state, table: t, id: 0 } }

    let dn = boila_drop_txn_del(s, txn, boila_cat_pk_name(name))
    s = dn.s
    txn = dn.txn
    if dn.ok == 0 { return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: dn.err, state: dn.state, table: t, id: 0 } }
    let ds = boila_drop_txn_del(s, txn, boila_cat_pk_schema(tid))
    s = ds.s
    txn = ds.txn
    if ds.ok == 0 { return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: ds.err, state: ds.state, table: t, id: 0 } }
    // ttl key: "td|<tid>" — raw del (no ts/ import; same layout as retention)
    let dt = boila_drop_txn_del(s, txn, bytes_of_str(concat("td|", int_to_str(tid))))
    s = dt.s
    txn = dt.txn
    if dt.ok == 0 { return BoilaCatTxnRes { s: s, txn: txn, ok: 0, err: dt.err, state: dt.state, table: t, id: 0 } }

    return BoilaCatTxnRes { s: s, txn: txn, ok: 1, err: "", state: "", table: t, id: tid }
}

// Core non-txn DROP (catalog + data/index only).
fn boila_table_drop_core(s: BoilaStore, name: str) -> BoilaCatRes !IO !Time !Par {
    let ct = boila_cat_by_name(s, name)?
    s = ct.s
    if ct.ok == 0 {
        return ct
    }
    let t = ct.table
    let tid = t.id
    s = boila_cf_wipe(s, boila_cf_data(), tid)?
    s = boila_cf_wipe(s, boila_cf_index(), tid)?
    s = boila_sys_prefix_wipe(s, concat(concat("x|", int_to_str(tid)), "|"))?
    s = boila_sys_prefix_wipe(s, concat(concat("ru|", int_to_str(tid)), "|"))?
    s = boila_del(s, boila_cf_sys(), 1, bytes_of_str(concat("rul|", int_to_str(tid))))?
    s = boila_del(s, boila_cf_sys(), 1, boila_cat_pk_name(name))?
    s = boila_del(s, boila_cf_sys(), 1, boila_cat_pk_schema(tid))?
    s = boila_del(s, boila_cf_sys(), 1, bytes_of_str(concat("td|", int_to_str(tid))))?
    return BoilaCatRes { s: s, ok: 1, err: "", state: "", table: t, id: tid }
}
