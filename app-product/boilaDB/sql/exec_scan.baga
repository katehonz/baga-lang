// exec_scan.baga — SELECT executor (P5): fetch (point/index/seq + WHERE),
// pipeline (agg/join → ORDER BY → проекция → DISTINCT → OFFSET/LIMIT).
//
// Писанията/четенията минават през txn buffer-а (P4).

import "../storage/shards.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "../core/row.baga"
import "../catalog/schema.baga"
import "../index/secondary.baga"
import "../fts/fts.baga"
import "../txn/mvcc.baga"
import "ast.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

struct BoilaResult {
    cols: Vec<str>,
    rows: Vec<Vec<BoilaVal>>
}

struct BoilaExec {
    s: BoilaStore,
    txn: BoilaTxn,
    ok: i64,
    err: str,
    state: str,
    kind: i64,
    res: BoilaResult
}

struct BoilaFetch {
    s: BoilaStore,
    txn: BoilaTxn,
    ok: i64,
    err: str,
    state: str,
    rows: Vec<Vec<BoilaVal>>
}

fn boila_result_empty() -> BoilaResult {
    let cols: Vec<str> = vec_new()
    let rows: Vec<Vec<BoilaVal>> = vec_new()
    return BoilaResult { cols: cols, rows: rows }
}

fn boila_fetch_empty(s: BoilaStore, txn: BoilaTxn) -> BoilaFetch {
    let rows: Vec<Vec<BoilaVal>> = vec_new()
    return BoilaFetch { s: s, txn: txn, ok: 1, err: "", state: "", rows: rows }
}

fn boila_fetch_fail(s: BoilaStore, txn: BoilaTxn, msg: str, state: str) -> BoilaFetch {
    let rows: Vec<Vec<BoilaVal>> = vec_new()
    return BoilaFetch { s: s, txn: txn, ok: 0, err: msg, state: state, rows: rows }
}

fn boila_exec_fail(s: BoilaStore, txn: BoilaTxn, msg: str, state: str) -> BoilaExec {
    return BoilaExec { s: s, txn: txn, ok: 0, err: msg, state: state, kind: 0, res: boila_result_empty() }
}

fn boila_exec_ok_select(s: BoilaStore, txn: BoilaTxn, r: BoilaResult) -> BoilaExec {
    return BoilaExec { s: s, txn: txn, ok: 1, err: "", state: "", kind: 1, res: r }
}

// Индекс на колона в таблица; -1 ако липсва.
fn boila_col_idx(t: BoilaTable, name: str) -> i64 {
    return boila_col_idx_of(t.cols, name)
}

fn boila_col_idx_of(cols: Vec<BoilaColDef>, name: str) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(cols) {
        let cd = vec_get(cols, i)
        if cd.name == name {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// Проекция на ред по индекси; празен proj = всичките колони.
fn boila_project(row: Vec<BoilaVal>, proj: Vec<i64>) -> Vec<BoilaVal> {
    if vec_len(proj) == 0 {
        return row
    }
    let out: Vec<BoilaVal> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(proj) {
        let ix = vec_get(proj, i)
        if ix >= 0 && ix < vec_len(row) {
            vec_push(out, vec_get(row, ix))
        } else {
            vec_push(out, boila_val_null())
        }
        i = i + 1
    }
    return out
}

// Дали литералът съответства на типа на колоната (null минава).
fn boila_pk_lit_ok(typ: i64, v: BoilaVal) -> i64 {
    if v.tag == boila_v_null() {
        return 1
    }
    if typ == boila_v_i64() || typ == boila_v_ts() {
        if v.tag == boila_v_i64() {
            return 1
        }
        return 0
    }
    if v.tag == typ {
        return 1
    }
    return 0
}

// pk-та от buffer-а, чиято колона col_idx има стойност val (index merge).
fn boila_scan_buf_eq(txn: BoilaTxn, t: BoilaTable, col_idx: i64, val: BoilaVal, pks: Vec<bytes>) {
    let mut i: i64 = 0
    while i < vec_len(txn.writes) {
        let w = vec_get(txn.writes, i)
        if w.cf == boila_cf_data() && w.table_id == t.id && w.is_del == 0 {
            let row = boila_row_dec(w.row)
            if col_idx < vec_len(row) {
                if boila_val_cmp(vec_get(row, col_idx), val) == 0 {
                    let mut dup = false
                    let mut j: i64 = 0
                    while j < vec_len(pks) {
                        if bytes_eq_b(vec_get(pks, j), w.pk) {
                            dup = true
                        }
                        j = j + 1
                    }
                    if dup == false {
                        vec_push(pks, w.pk)
                    }
                }
            }
        }
        i = i + 1
    }
}

// --- fetch: редовете на таблица с WHERE (point/index/range/seq) ---

fn boila_fetch_rows(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, sel: BoilaSel) -> BoilaFetch !IO !Time {
    let rows: Vec<Vec<BoilaVal>> = vec_new()
    // FTS път (P7): WHERE col @@ to_tsquery('…')
    if sel.has_fts == 1 {
        let fl = fts_list_for_table(s, t.id)?
        s = fl.s
        let col_ix = boila_col_idx(t, sel.fts_col)
        if col_ix < 0 {
            return boila_fetch_fail(s, txn, concat("колона '", concat(sel.fts_col, "' не съществува")), "42703")
        }
        let mut fdi: i64 = 0 - 1
        let mut k: i64 = 0
        while k < vec_len(fl.defs) {
            let d = vec_get(fl.defs, k)
            if d.col_idx == col_ix {
                fdi = k
            }
            k = k + 1
        }
        if fdi < 0 {
            return boila_fetch_fail(s, txn, concat("колона '", concat(sel.fts_col, "' няма fts индекс")), "0A000")
        }
        let def = vec_get(fl.defs, fdi)
        let fq = fts_query(s, txn, t, def, sel.fts_terms, sel.fts_mode)?
        s = fq.s
        let mut qi: i64 = 0
        while qi < vec_len(fq.pks) {
            let g = boila_txn_get(s, txn, t.id, vec_get(fq.pks, qi))?
            s = g.s
            if g.found == 1 {
                vec_push(rows, boila_row_dec(g.row))
            }
            qi = qi + 1
        }
        return BoilaFetch { s: s, txn: txn, ok: 1, err: "", state: "", rows: rows }
    }
    let pkcol = vec_get(t.cols, t.pk_idx)
    if sel.has_lo == 1 && sel.lo_col != pkcol.name {
        return boila_fetch_fail(s, txn, concat("range по '", concat(sel.lo_col, "' — само по PRIMARY KEY")), "0A000")
    }
    if sel.has_hi == 1 && sel.hi_col != pkcol.name {
        return boila_fetch_fail(s, txn, concat("range по '", concat(sel.hi_col, "' — само по PRIMARY KEY")), "0A000")
    }
    if sel.has_lo == 1 && boila_pk_lit_ok(pkcol.typ, sel.pk_lo) == 0 {
        return boila_fetch_fail(s, txn, "литералът в >= не съответства на типа на PRIMARY KEY", "42804")
    }
    if sel.has_hi == 1 && boila_pk_lit_ok(pkcol.typ, sel.pk_hi) == 0 {
        return boila_fetch_fail(s, txn, "литералът в <= не съответства на типа на PRIMARY KEY", "42804")
    }
    if sel.has_eq == 1 {
        if sel.eq_col == pkcol.name {
            if boila_pk_lit_ok(pkcol.typ, sel.pk_eq) == 0 {
                return boila_fetch_fail(s, txn, "литералът в = не съответства на типа на PRIMARY KEY", "42804")
            }
            let pkenc = boila_val_enc(sel.pk_eq)
            let g = boila_txn_get(s, txn, t.id, pkenc)?
            if g.found == 1 {
                vec_push(rows, boila_row_dec(g.row))
            }
            return BoilaFetch { s: g.s, txn: txn, ok: 1, err: "", state: "", rows: rows }
        }
        let cix = boila_col_idx(t, sel.eq_col)
        if cix < 0 {
            return boila_fetch_fail(s, txn, concat("колона '", concat(sel.eq_col, "' не съществува")), "42703")
        }
        let cd = vec_get(t.cols, cix)
        if boila_pk_lit_ok(cd.typ, sel.pk_eq) == 0 {
            return boila_fetch_fail(s, txn, "литералът в = не съответства на типа на колоната", "42804")
        }
        let ixid = boila_ix_by_col_t(t, cix)
        if ixid < 0 {
            return boila_fetch_fail(s, txn, concat("WHERE по '", concat(sel.eq_col, "' — колона без индекс")), "0A000")
        }
        let lk = boila_ix_lookup(s, t, ixid, sel.pk_eq)?
        s = lk.s
        boila_scan_buf_eq(txn, t, cix, sel.pk_eq, lk.pks)
        let mut li: i64 = 0
        while li < vec_len(lk.pks) {
            let g = boila_txn_get(s, txn, t.id, vec_get(lk.pks, li))?
            s = g.s
            if g.found == 1 {
                vec_push(rows, boila_row_dec(g.row))
            }
            li = li + 1
        }
        return BoilaFetch { s: s, txn: txn, ok: 1, err: "", state: "", rows: rows }
    }
    // range / seq
    let ks = boila_txn_keys(s, txn, t.id)?
    s = ks.s
    let mut ki: i64 = 0
    while ki < vec_len(ks.pks) {
        let pkenc = vec_get(ks.pks, ki)
        let pkv = boila_val_dec(pkenc)
        let mut keep = true
        if sel.has_lo == 1 {
            let c = boila_val_cmp(pkv, sel.pk_lo)
            if c != 1 && c != 0 {
                keep = false
            }
        }
        if keep && sel.has_hi == 1 {
            let c = boila_val_cmp(pkv, sel.pk_hi)
            if c != 0 - 1 && c != 0 {
                keep = false
            }
        }
        if keep {
            let g = boila_txn_get(s, txn, t.id, pkenc)?
            s = g.s
            if g.found == 1 {
                vec_push(rows, boila_row_dec(g.row))
            }
        }
        ki = ki + 1
    }
    return BoilaFetch { s: s, txn: txn, ok: 1, err: "", state: "", rows: rows }
}

fn boila_fetch_all(s: BoilaStore, txn: BoilaTxn, t: BoilaTable) -> BoilaFetch !IO !Time {
    let rows: Vec<Vec<BoilaVal>> = vec_new()
    let ks = boila_txn_keys(s, txn, t.id)?
    s = ks.s
    let mut ki: i64 = 0
    while ki < vec_len(ks.pks) {
        let g = boila_txn_get(s, txn, t.id, vec_get(ks.pks, ki))?
        s = g.s
        if g.found == 1 {
            vec_push(rows, boila_row_dec(g.row))
        }
        ki = ki + 1
    }
    return BoilaFetch { s: s, txn: txn, ok: 1, err: "", state: "", rows: rows }
}

// --- DISTINCT: нова дедуплицирана копия по сериализиран ред ---

fn boila_row_ser(row: Vec<BoilaVal>) -> bytes {
    let mut out = bytes_new(0)
    let mut i: i64 = 0
    while i < vec_len(row) {
        out = bytes_concat(out, boila_val_enc(vec_get(row, i)))
        out = bytes_concat(out, bytes_of_str("|"))
        i = i + 1
    }
    return out
}

fn boila_distinct_rows(rows: Vec<Vec<BoilaVal>>) -> Vec<Vec<BoilaVal>> {
    let out: Vec<Vec<BoilaVal>> = vec_new()
    let seen: Vec<bytes> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(rows) {
        let ser = boila_row_ser(vec_get(rows, i))
        let mut dup = false
        let mut j: i64 = 0
        while j < vec_len(seen) {
            if bytes_eq_b(vec_get(seen, j), ser) {
                dup = true
            }
            j = j + 1
        }
        if dup == false {
            vec_push(seen, ser)
            vec_push(out, vec_get(rows, i))
        }
        i = i + 1
    }
    return out
}

// --- OFFSET/LIMIT връща нов списък ---

fn boila_apply_offlim(rows: Vec<Vec<BoilaVal>>, off: i64, lim: i64) -> Vec<Vec<BoilaVal>> {
    let out: Vec<Vec<BoilaVal>> = vec_new()
    let n = vec_len(rows)
    let mut i = off
    if i < 0 {
        i = 0
    }
    let mut taken: i64 = 0
    while i < n {
        if lim > 0 && taken >= lim {
            i = n
        } else {
            vec_push(out, vec_get(rows, i))
            taken = taken + 1
            i = i + 1
        }
    }
    return out
}
