// exec_scan.baga — SELECT fetch + txn reads.
import "../storage/shards.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "../core/row.baga"
import "../catalog/schema.baga"
import "../index/secondary.baga"
import "../fts/fts.baga"
import "../core/budget.baga"
import "../txn/mvcc.baga"
import "ast.baga"
import "exec_sort.baga"
import "exec_buf.baga"
import "exec_filter.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"
struct BoilaResult { cols: Vec<str>, tags: Vec<i64>, rows: Vec<Vec<BoilaVal>> }
struct BoilaExec { s: BoilaStore, txn: BoilaTxn, ok: i64, err: str, state: str, kind: i64, res: BoilaResult }
struct BoilaFetch { s: BoilaStore, txn: BoilaTxn, ok: i64, err: str, state: str, rows: Vec<Vec<BoilaVal>> }
fn boila_result_empty() -> BoilaResult {
    let cols: Vec<str> = vec_new()
    let tags: Vec<i64> = vec_new()
    let rows: Vec<Vec<BoilaVal>> = vec_new()
    return BoilaResult { cols: cols, tags: tags, rows: rows }
}
fn boila_result_add_col(res: BoilaResult, name: str, tag: i64) {
    vec_push(res.cols, name)
    vec_push(res.tags, tag)
}
fn boila_fetch_empty(s: BoilaStore, txn: BoilaTxn) -> BoilaFetch {
    let rows: Vec<Vec<BoilaVal>> = vec_new()
    return BoilaFetch { s: s, txn: txn, ok: 1, err: "", state: "", rows: rows }
}
fn boila_fetch_fail(s: BoilaStore, txn: BoilaTxn, msg: str, state: str) -> BoilaFetch {
    let rows: Vec<Vec<BoilaVal>> = vec_new()
    return BoilaFetch { s: s, txn: txn, ok: 0, err: msg, state: state, rows: rows }
}
fn boila_exec_fail(s: BoilaStore, txn: BoilaTxn, msg: str, state: str) -> BoilaExec {
    return BoilaExec { s: s, txn: txn, ok: 0, err: msg, state: state, kind: 0, res: boila_result_empty() }
}
fn boila_exec_ok_select(s: BoilaStore, txn: BoilaTxn, r: BoilaResult) -> BoilaExec {
    return BoilaExec { s: s, txn: txn, ok: 1, err: "", state: "", kind: 1, res: r }
}
fn boila_col_idx(t: BoilaTable, name: str) -> i64 {
    return boila_col_idx_of(t.cols, name)
}

fn boila_col_idx_of(cols: Vec<BoilaColDef>, name: str) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(cols) {
        let cd = vec_get(cols, i)
        if cd.name == name {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// Име на колона в изходен списък (ORDER BY след проекция/агрегация).
fn boila_col_name_idx(names: Vec<str>, name: str) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(names) {
        if vec_get(names, i) == name {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// Проекция на ред по индекси; празен proj = всичките колони.
fn boila_project(row: Vec<BoilaVal>, proj: Vec<i64>) -> Vec<BoilaVal> {
    if vec_len(proj) == 0 {
        return row
    }
    let out: Vec<BoilaVal> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(proj) {
        let ix = vec_get(proj, i)
        if ix >= 0 && ix < vec_len(row) {
            vec_push(out, vec_get(row, ix))
        } else {
            vec_push(out, boila_val_null())
        }
        i = i + 1
    }
    return out
}

// Дали литералът съответства на типа на колоната (null минава).
fn boila_pk_lit_ok(typ: i64, v: BoilaVal) -> i64 {
    if v.tag == boila_v_null() || boila_is_param(v) == 1 {
        return 1
    }
    if typ == boila_v_i64() || typ == boila_v_ts() {
        if v.tag == boila_v_i64() {
            return 1
        }
        return 0
    }
    if v.tag == typ {
        return 1
    }
    return 0
}

// Q-fetch-limit: stop after offset+limit kept rows when LIMIT without
// ORDER BY / DISTINCT / expression WHERE (same gate as Q-join-limit).
// 0 = no cap. Not used by fetch_pks (JOIN outer / kNN cands need full set).
fn boila_fetch_need(sel: BoilaSel) -> i64 {
    if sel.limit <= 0 {
        return 0
    }
    if sel.has_order == 1 || sel.distinct == 1 || sel.has_xw == 1 {
        return 0
    }
    let mut n = sel.limit
    if sel.offset > 0 {
        n = n + sel.offset
    }
    if n < 1 {
        return sel.limit
    }
    return n
}

// Q-fetch-topn: ORDER BY + LIMIT → keep at most offset+limit best source
// rows via boila_topn_offer (no full sort of N). oidxs filled when > 0.
// All ORDER BY cols must resolve on the table (aliases → order_after path).
fn boila_fetch_topn(sel: BoilaSel, t: BoilaTable, oidxs: Vec<i64>) -> i64 {
    if sel.limit <= 0 || sel.has_order == 0 || sel.distinct == 1 || sel.has_xw == 1 {
        return 0
    }
    if vec_len(sel.ord_cols) == 0 {
        return 0
    }
    let mut i: i64 = 0
    while i < vec_len(sel.ord_cols) {
        let ix = boila_col_idx(t, vec_get(sel.ord_cols, i))
        if ix < 0 {
            return 0
        }
        vec_push(oidxs, ix)
        i = i + 1
    }
    let mut n = sel.offset + sel.limit
    if n < 1 {
        n = sel.limit
    }
    return n
}

// Keep a row: top-N window, or plain push.
fn boila_fetch_emit(rows: Vec<Vec<BoilaVal>>, row: Vec<BoilaVal>, topn: i64, oidxs: Vec<i64>, odesc: Vec<i64>) {
    if topn > 0 {
        boila_topn_offer(rows, row, oidxs, odesc, topn)
    } else {
        vec_push(rows, row)
    }
}

fn boila_fetch_rows(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, sel: BoilaSel) -> BoilaFetch !IO !Time !Par {
    let rows: Vec<Vec<BoilaVal>> = vec_new()
    let need = boila_fetch_need(sel)
    let oidxs: Vec<i64> = vec_new()
    let topn = boila_fetch_topn(sel, t, oidxs)
    let odesc = sel.ord_desc
    // kNN: see exec_knn.baga (dispatched from exec_select)
    // FTS + AND (F6)
    if sel.has_fts == 1 {
        let fl = fts_list_for_table(s, t.id)?
        s = fl.s
        let col_ix = boila_col_idx(t, sel.fts_col)
        if col_ix < 0 {
            return boila_fetch_fail(s, txn, concat("колона '", concat(sel.fts_col, "' не съществува")), "42703")
        }
        let mut fdi: i64 = 0 - 1
        let mut k: i64 = 0
        while k < vec_len(fl.defs) {
            let d = vec_get(fl.defs, k)
            if d.col_idx == col_ix { fdi = k }
            k = k + 1
        }
        if fdi < 0 {
            return boila_fetch_fail(s, txn, concat("колона '", concat(sel.fts_col, "' няма fts индекс")), "0A000")
        }
        let def = vec_get(fl.defs, fdi)
        let fq = fts_query_gaps(s, txn, t, def, sel.fts_terms, sel.fts_mode, sel.fts_gaps)?
        s = fq.s
        let mut qi: i64 = 0
        while qi < vec_len(fq.pks) {
            if need > 0 && vec_len(rows) >= need {
                qi = vec_len(fq.pks)
            } else {
                let g = boila_txn_get(s, txn, t.id, vec_get(fq.pks, qi))?
                s = g.s
                if g.found == 1 {
                    let row = boila_row_dec(g.row)
                    if boila_row_pass_filters(row, t, sel) == 1 {
                        boila_fetch_emit(rows, row, topn, oidxs, odesc)
                    }
                }
                qi = qi + 1
            }
        }
        return BoilaFetch { s: s, txn: txn, ok: 1, err: "", state: "", rows: rows }
    }
    let pkcol = vec_get(t.cols, t.pk_idx)
    // K3b: PK range → sorted early-stop; non-PK → seq + post-filter
    let mut pk_range: i64 = 1
    if sel.has_lo == 1 {
        let cix = boila_col_idx(t, sel.lo_col)
        if cix < 0 { return boila_fetch_fail(s, txn, concat("колона '", concat(sel.lo_col, "' не съществува")), "42703") }
        if boila_pk_lit_ok(vec_get(t.cols, cix).typ, sel.pk_lo) == 0 {
            return boila_fetch_fail(s, txn, "литералът в >= не съответства на типа на колоната", "42804")
        }
        if sel.lo_col != pkcol.name { pk_range = 0 }
    }
    if sel.has_hi == 1 {
        let cix = boila_col_idx(t, sel.hi_col)
        if cix < 0 { return boila_fetch_fail(s, txn, concat("колона '", concat(sel.hi_col, "' не съществува")), "42703") }
        if boila_pk_lit_ok(vec_get(t.cols, cix).typ, sel.pk_hi) == 0 {
            return boila_fetch_fail(s, txn, "литералът в <= не съответства на типа на колоната", "42804")
        }
        if sel.hi_col != pkcol.name { pk_range = 0 }
    }
    // K6: IS [NOT] NULL → exec_isnull (dispatched from exec_select)
    if sel.has_eq == 1 {
        // SQL 3VL: col = NULL never matches (use IS NULL)
        if sel.pk_eq.tag == boila_v_null() {
            return BoilaFetch { s: s, txn: txn, ok: 1, err: "", state: "", rows: rows }
        }
        if sel.eq_col == pkcol.name {
            if boila_pk_lit_ok(pkcol.typ, sel.pk_eq) == 0 {
                return boila_fetch_fail(s, txn, "литералът в = не съответства на типа на PRIMARY KEY", "42804")
            }
            let pkenc = boila_val_enc(sel.pk_eq)
            let g = boila_txn_get(s, txn, t.id, pkenc)?
            if g.found == 1 {
                boila_fetch_emit(rows, boila_row_dec(g.row), topn, oidxs, odesc)
            }
            return BoilaFetch { s: g.s, txn: txn, ok: 1, err: "", state: "", rows: rows }
        }
        let cix = boila_col_idx(t, sel.eq_col)
        if cix < 0 {
            return boila_fetch_fail(s, txn, concat("колона '", concat(sel.eq_col, "' не съществува")), "42703")
        }
        let cd = vec_get(t.cols, cix)
        if boila_pk_lit_ok(cd.typ, sel.pk_eq) == 0 {
            return boila_fetch_fail(s, txn, "литералът в = не съответства на типа на колоната", "42804")
        }
        let ixid = boila_ix_by_col_t(t, cix)
        if ixid >= 0 {
            let lk = boila_ix_lookup(s, t, ixid, sel.pk_eq)?
            s = lk.s
            boila_scan_buf_eq(txn, t, cix, sel.pk_eq, lk.pks)
            let mut li: i64 = 0
            while li < vec_len(lk.pks) {
                if need > 0 && vec_len(rows) >= need {
                    li = vec_len(lk.pks)
                } else {
                    let g = boila_txn_get(s, txn, t.id, vec_get(lk.pks, li))?
                    s = g.s
                    if g.found == 1 {
                        boila_fetch_emit(rows, boila_row_dec(g.row), topn, oidxs, odesc)
                    }
                    li = li + 1
                }
            }
            return BoilaFetch { s: s, txn: txn, ok: 1, err: "", state: "", rows: rows }
        }
    }
    // K3d: secondary index range (fixed-size col); else seq
    if (sel.has_lo == 1 || sel.has_hi == 1) && pk_range == 0 && sel.has_eq == 0 {
        let mut rc = sel.lo_col
        if sel.has_lo == 0 { rc = sel.hi_col }
        let mut okc = 1
        if sel.has_lo == 1 && sel.has_hi == 1 && sel.lo_col != sel.hi_col { okc = 0 }
        if okc == 1 {
            let cix = boila_col_idx(t, rc)
            let ixid = boila_ix_by_col_t(t, cix)
            if cix >= 0 && ixid >= 0 {
                let xr = boila_ix_range(s, t, ixid, sel.has_lo, sel.pk_lo, sel.has_hi, sel.pk_hi, sel.lo_excl, sel.hi_excl)?
                s = xr.s
                if xr.ok == 0 { return boila_fetch_fail(s, txn, xr.err, xr.state) }
                if xr.has == 1 {
                    boila_scan_buf_range(txn, t, cix, sel.has_lo, sel.pk_lo, sel.has_hi, sel.pk_hi, sel.lo_excl, sel.hi_excl, xr.pks)
                    let mut li: i64 = 0
                    while li < vec_len(xr.pks) {
                        if need > 0 && vec_len(rows) >= need {
                            li = vec_len(xr.pks)
                        } else {
                            let g = boila_txn_get(s, txn, t.id, vec_get(xr.pks, li))?
                            s = g.s
                            if g.found == 1 {
                                boila_fetch_emit(rows, boila_row_dec(g.row), topn, oidxs, odesc)
                            }
                            li = li + 1
                        }
                    }
                    return BoilaFetch { s: s, txn: txn, ok: 1, err: "", state: "", rows: rows }
                }
            }
        }
    }
    let bud = boila_budget_begin()?
    let ks = boila_txn_keys(s, txn, t.id)?
    s = ks.s
    let g0 = boila_budget_gate(bud, 0, vec_len(ks.pks), 0)?
    if g0 != "" { return boila_fetch_fail(s, txn, g0, boila_budget_gate_state(g0)) }
    let pks = ks.pks
    let n = vec_len(pks)
    // NOT BETWEEN is not a contiguous PK range — use full scan + filter
    if (sel.has_lo == 1 || sel.has_hi == 1) && pk_range == 1 && sel.between_not == 0 {
        boila_pk_sort(pks)
        let mut ki: i64 = 0
        let mut lo_enc = bytes_new(0)
        if sel.has_lo == 1 {
            lo_enc = boila_val_enc(sel.pk_lo)
            ki = boila_pk_lb(pks, lo_enc)
            if sel.lo_excl == 1 && ki < n && boila_bytes_cmp(vec_get(pks, ki), lo_enc) == 0 {
                ki = ki + 1
            }
        }
        let mut hi_enc = bytes_new(0)
        if sel.has_hi == 1 { hi_enc = boila_val_enc(sel.pk_hi) }
        while ki < n {
            if need > 0 && vec_len(rows) >= need {
                ki = n
            } else {
                let ge = boila_budget_gate(bud, ki, 0, vec_len(rows))?
                if ge != "" { return boila_fetch_fail(s, txn, ge, boila_budget_gate_state(ge)) }
                let pkenc = vec_get(pks, ki)
                if sel.has_hi == 1 {
                    let hc = boila_bytes_cmp(pkenc, hi_enc)
                    if sel.hi_excl == 1 {
                        if hc >= 0 { ki = n }
                    } else {
                        if hc > 0 { ki = n }
                    }
                }
                if ki < n {
                    let g = boila_txn_get(s, txn, t.id, pkenc)?
                    s = g.s
                    if g.found == 1 {
                        let row = boila_row_dec(g.row)
                        if (sel.has_like == 0 && sel.has_in == 0 && sel.has_ne == 0) || boila_row_pass_filters(row, t, sel) == 1 {
                            boila_fetch_emit(rows, row, topn, oidxs, odesc)
                        }
                    }
                    ki = ki + 1
                }
            }
        }
        return BoilaFetch { s: s, txn: txn, ok: 1, err: "", state: "", rows: rows }
    }
    let mut need_f = sel.has_eq
    if (sel.has_lo == 1 || sel.has_hi == 1) && (pk_range == 0 || sel.between_not == 1) { need_f = 1 }
    if sel.has_like > 0 { need_f = 1 }
    if sel.has_in > 0 { need_f = 1 }
    if sel.has_ne == 1 { need_f = 1 }
    let mut ki: i64 = 0
    while ki < n {
        // Q-fetch-limit only; topn must scan all candidates
        if need > 0 && topn == 0 && vec_len(rows) >= need {
            ki = n
        } else {
            let ge = boila_budget_gate(bud, ki, 0, vec_len(rows))?
            if ge != "" { return boila_fetch_fail(s, txn, ge, boila_budget_gate_state(ge)) }
            let g = boila_txn_get(s, txn, t.id, vec_get(pks, ki))?
            s = g.s
            if g.found == 1 {
                let row = boila_row_dec(g.row)
                if need_f == 0 || boila_row_pass_filters(row, t, sel) == 1 {
                    boila_fetch_emit(rows, row, topn, oidxs, odesc)
                }
            }
            ki = ki + 1
        }
    }
    return BoilaFetch { s: s, txn: txn, ok: 1, err: "", state: "", rows: rows }
}

fn boila_fetch_all(s: BoilaStore, txn: BoilaTxn, t: BoilaTable) -> BoilaFetch !IO !Time !Par {
    let rows: Vec<Vec<BoilaVal>> = vec_new()
    let bud = boila_budget_begin()?
    let ks = boila_txn_keys(s, txn, t.id)?
    s = ks.s
    let g0 = boila_budget_gate(bud, 0, vec_len(ks.pks), 0)?
    if g0 != "" { return boila_fetch_fail(s, txn, g0, boila_budget_gate_state(g0)) }
    let mut ki: i64 = 0
    while ki < vec_len(ks.pks) {
        let ge = boila_budget_gate(bud, ki, 0, vec_len(rows))?
        if ge != "" { return boila_fetch_fail(s, txn, ge, boila_budget_gate_state(ge)) }
        let g = boila_txn_get(s, txn, t.id, vec_get(ks.pks, ki))?
        s = g.s
        if g.found == 1 { vec_push(rows, boila_row_dec(g.row)) }
        ki = ki + 1
    }
    return BoilaFetch { s: s, txn: txn, ok: 1, err: "", state: "", rows: rows }
}

// Q-stream-join: matching outer pks only (no row Vec). Filters applied at GET.
struct BoilaPksOut {
    s: BoilaStore,
    txn: BoilaTxn,
    ok: i64,
    err: str,
    state: str,
    pks: Vec<bytes>
}

fn boila_pks_fail(s: BoilaStore, txn: BoilaTxn, msg: str, state: str) -> BoilaPksOut {
    let pks: Vec<bytes> = vec_new()
    return BoilaPksOut { s: s, txn: txn, ok: 0, err: msg, state: state, pks: pks }
}

fn boila_fetch_pks(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, sel: BoilaSel) -> BoilaPksOut !IO !Time !Par {
    // Reuse fetch_rows paths that already collect pks first; for the rest
    // walk candidates and keep only matching pks (one live row at a time).
    let pks: Vec<bytes> = vec_new()
    if sel.has_fts == 1 {
        let f = boila_fetch_rows(s, txn, t, sel)?
        if f.ok == 0 {
            return boila_pks_fail(f.s, f.txn, f.err, f.state)
        }
        let mut i: i64 = 0
        while i < vec_len(f.rows) {
            let row = vec_get(f.rows, i)
            if t.pk_idx >= 0 && t.pk_idx < vec_len(row) {
                vec_push(pks, boila_val_enc(vec_get(row, t.pk_idx)))
            }
            i = i + 1
        }
        return BoilaPksOut { s: f.s, txn: f.txn, ok: 1, err: "", state: "", pks: pks }
    }
    let pkcol = vec_get(t.cols, t.pk_idx)
    let mut pk_range: i64 = 1
    if sel.has_lo == 1 {
        let cix = boila_col_idx(t, sel.lo_col)
        if cix < 0 { return boila_pks_fail(s, txn, concat("колона '", concat(sel.lo_col, "' не съществува")), "42703") }
        if boila_pk_lit_ok(vec_get(t.cols, cix).typ, sel.pk_lo) == 0 {
            return boila_pks_fail(s, txn, "литералът в >= не съответства на типа на колоната", "42804")
        }
        if sel.lo_col != pkcol.name { pk_range = 0 }
    }
    if sel.has_hi == 1 {
        let cix = boila_col_idx(t, sel.hi_col)
        if cix < 0 { return boila_pks_fail(s, txn, concat("колона '", concat(sel.hi_col, "' не съществува")), "42703") }
        if boila_pk_lit_ok(vec_get(t.cols, cix).typ, sel.pk_hi) == 0 {
            return boila_pks_fail(s, txn, "литералът в <= не съответства на типа на колоната", "42804")
        }
        if sel.hi_col != pkcol.name { pk_range = 0 }
    }
    if sel.has_eq == 1 {
        if sel.pk_eq.tag == boila_v_null() {
            return BoilaPksOut { s: s, txn: txn, ok: 1, err: "", state: "", pks: pks }
        }
        if sel.eq_col == pkcol.name {
            if boila_pk_lit_ok(pkcol.typ, sel.pk_eq) == 0 {
                return boila_pks_fail(s, txn, "литералът в = не съответства на типа на PRIMARY KEY", "42804")
            }
            let pkenc = boila_val_enc(sel.pk_eq)
            let g = boila_txn_get(s, txn, t.id, pkenc)?
            if g.found == 1 {
                vec_push(pks, pkenc)
            }
            return BoilaPksOut { s: g.s, txn: txn, ok: 1, err: "", state: "", pks: pks }
        }
        let cix = boila_col_idx(t, sel.eq_col)
        if cix < 0 {
            return boila_pks_fail(s, txn, concat("колона '", concat(sel.eq_col, "' не съществува")), "42703")
        }
        let cd = vec_get(t.cols, cix)
        if boila_pk_lit_ok(cd.typ, sel.pk_eq) == 0 {
            return boila_pks_fail(s, txn, "литералът в = не съответства на типа на колоната", "42804")
        }
        let ixid = boila_ix_by_col_t(t, cix)
        if ixid >= 0 {
            let lk = boila_ix_lookup(s, t, ixid, sel.pk_eq)?
            s = lk.s
            boila_scan_buf_eq(txn, t, cix, sel.pk_eq, lk.pks)
            let mut li: i64 = 0
            while li < vec_len(lk.pks) {
                let g = boila_txn_get(s, txn, t.id, vec_get(lk.pks, li))?
                s = g.s
                if g.found == 1 {
                    vec_push(pks, vec_get(lk.pks, li))
                }
                li = li + 1
            }
            return BoilaPksOut { s: s, txn: txn, ok: 1, err: "", state: "", pks: pks }
        }
    }
    if (sel.has_lo == 1 || sel.has_hi == 1) && pk_range == 0 && sel.has_eq == 0 {
        let mut rc = sel.lo_col
        if sel.has_lo == 0 { rc = sel.hi_col }
        let mut okc = 1
        if sel.has_lo == 1 && sel.has_hi == 1 && sel.lo_col != sel.hi_col { okc = 0 }
        if okc == 1 {
            let cix = boila_col_idx(t, rc)
            let ixid = boila_ix_by_col_t(t, cix)
            if cix >= 0 && ixid >= 0 {
                let xr = boila_ix_range(s, t, ixid, sel.has_lo, sel.pk_lo, sel.has_hi, sel.pk_hi, sel.lo_excl, sel.hi_excl)?
                s = xr.s
                if xr.ok == 0 { return boila_pks_fail(s, txn, xr.err, xr.state) }
                if xr.has == 1 {
                    boila_scan_buf_range(txn, t, cix, sel.has_lo, sel.pk_lo, sel.has_hi, sel.pk_hi, sel.lo_excl, sel.hi_excl, xr.pks)
                    let mut li: i64 = 0
                    while li < vec_len(xr.pks) {
                        let g = boila_txn_get(s, txn, t.id, vec_get(xr.pks, li))?
                        s = g.s
                        if g.found == 1 {
                            vec_push(pks, vec_get(xr.pks, li))
                        }
                        li = li + 1
                    }
                    return BoilaPksOut { s: s, txn: txn, ok: 1, err: "", state: "", pks: pks }
                }
            }
        }
    }
    let bud = boila_budget_begin()?
    let ks = boila_txn_keys(s, txn, t.id)?
    s = ks.s
    let g0 = boila_budget_gate(bud, 0, vec_len(ks.pks), 0)?
    if g0 != "" { return boila_pks_fail(s, txn, g0, boila_budget_gate_state(g0)) }
    let all = ks.pks
    let n = vec_len(all)
    if (sel.has_lo == 1 || sel.has_hi == 1) && pk_range == 1 && sel.between_not == 0 {
        boila_pk_sort(all)
        let mut ki: i64 = 0
        let mut lo_enc = bytes_new(0)
        if sel.has_lo == 1 {
            lo_enc = boila_val_enc(sel.pk_lo)
            ki = boila_pk_lb(all, lo_enc)
            if sel.lo_excl == 1 && ki < n && boila_bytes_cmp(vec_get(all, ki), lo_enc) == 0 {
                ki = ki + 1
            }
        }
        let mut hi_enc = bytes_new(0)
        if sel.has_hi == 1 { hi_enc = boila_val_enc(sel.pk_hi) }
        while ki < n {
            let ge = boila_budget_gate(bud, ki, 0, 0)?
            if ge != "" { return boila_pks_fail(s, txn, ge, boila_budget_gate_state(ge)) }
            let pkenc = vec_get(all, ki)
            if sel.has_hi == 1 {
                let hc = boila_bytes_cmp(pkenc, hi_enc)
                if sel.hi_excl == 1 {
                    if hc >= 0 { ki = n }
                } else {
                    if hc > 0 { ki = n }
                }
            }
            if ki < n {
                let g = boila_txn_get(s, txn, t.id, pkenc)?
                s = g.s
                if g.found == 1 {
                    let row = boila_row_dec(g.row)
                    if (sel.has_like == 0 && sel.has_in == 0 && sel.has_ne == 0) || boila_row_pass_filters(row, t, sel) == 1 {
                        vec_push(pks, pkenc)
                    }
                }
                ki = ki + 1
            }
        }
        return BoilaPksOut { s: s, txn: txn, ok: 1, err: "", state: "", pks: pks }
    }
    let mut need_f = sel.has_eq
    if (sel.has_lo == 1 || sel.has_hi == 1) && (pk_range == 0 || sel.between_not == 1) { need_f = 1 }
    if sel.has_like > 0 { need_f = 1 }
    if sel.has_in > 0 { need_f = 1 }
    if sel.has_ne == 1 { need_f = 1 }
    // Unfiltered full table: pks = live keys (no GET until join probe)
    if need_f == 0 {
        return BoilaPksOut { s: s, txn: txn, ok: 1, err: "", state: "", pks: all }
    }
    let mut ki: i64 = 0
    while ki < n {
        let ge = boila_budget_gate(bud, ki, 0, 0)?
        if ge != "" { return boila_pks_fail(s, txn, ge, boila_budget_gate_state(ge)) }
        let pkenc = vec_get(all, ki)
        let g = boila_txn_get(s, txn, t.id, pkenc)?
        s = g.s
        if g.found == 1 {
            let row = boila_row_dec(g.row)
            if boila_row_pass_filters(row, t, sel) == 1 {
                vec_push(pks, pkenc)
            }
        }
        ki = ki + 1
    }
    return BoilaPksOut { s: s, txn: txn, ok: 1, err: "", state: "", pks: pks }
}

fn boila_row_ser(row: Vec<BoilaVal>) -> bytes {
    let mut out = bytes_new(0)
    let mut i: i64 = 0
    while i < vec_len(row) {
        out = bytes_concat(out, boila_val_enc(vec_get(row, i)))
        out = bytes_concat(out, bytes_of_str("|"))
        i = i + 1
    }
    return out
}

// Q-distinct-limit: offer one projected row into out if not yet seen.
// Returns 1 if added, 0 if duplicate. `seen` holds boila_row_ser keys.
fn boila_distinct_offer(out: Vec<Vec<BoilaVal>>, seen: Vec<bytes>, row: Vec<BoilaVal>) -> i64 {
    let ser = boila_row_ser(row)
    let mut j: i64 = 0
    while j < vec_len(seen) {
        if bytes_eq_b(vec_get(seen, j), ser) {
            return 0
        }
        j = j + 1
    }
    vec_push(seen, ser)
    vec_push(out, row)
    return 1
}

fn boila_distinct_rows(rows: Vec<Vec<BoilaVal>>) -> Vec<Vec<BoilaVal>> {
    let out: Vec<Vec<BoilaVal>> = vec_new()
    let seen: Vec<bytes> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(rows) {
        boila_distinct_offer(out, seen, vec_get(rows, i))
        i = i + 1
    }
    return out
}

// Cap for DISTINCT early-stop: offset+limit when LIMIT without order_after.
// 0 = collect all unique (no early-stop).
fn boila_distinct_need(sel: BoilaSel, order_after: i64) -> i64 {
    if sel.distinct == 0 || sel.limit <= 0 || order_after == 1 {
        return 0
    }
    let mut n = sel.offset + sel.limit
    if n < 1 {
        n = sel.limit
    }
    return n
}

fn boila_apply_offlim(rows: Vec<Vec<BoilaVal>>, off: i64, lim: i64) -> Vec<Vec<BoilaVal>> {
    let out: Vec<Vec<BoilaVal>> = vec_new()
    let n = vec_len(rows)
    let mut i = off
    if i < 0 {
        i = 0
    }
    let mut taken: i64 = 0
    while i < n {
        if lim > 0 && taken >= lim {
            i = n
        } else {
            vec_push(out, vec_get(rows, i))
            taken = taken + 1
            i = i + 1
        }
    }
    return out
}
