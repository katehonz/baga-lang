// parse_common.baga — общи parser помощници (токени, литерали, проекция).

import "token.baga"
import "lexer.baga"
import "ast.baga"
import "sfn.baga"
import "../core/value.baga"
import "../ts/time_bucket.baga"
import "std/str/str.baga"

struct BoilaLit {
    ok: i64,
    v: BoilaVal,
    param: i64,   // 0 = concrete; N = $N (W2)
    err: str,
    state: str
}

fn boila_ps_tok(l: BoilaLex, i: i64) -> Token {
    if i < vec_len(l.toks) {
        return vec_get(l.toks, i)
    }
    return token_new(tok_eof(), "")
}

// literal → BoilaVal; ok=0 при не-литерал. $N → ok=1, param=N.
fn boila_ps_literal(l: BoilaLex, i: i64) -> BoilaLit {
    let t = boila_ps_tok(l, i)
    if t.kind == tok_param() {
        let n = parse_int(t.txt)
        if n < 1 {
            return BoilaLit { ok: 0, v: boila_val_null(), param: 0, err: "параметър $N — N≥1", state: "42601" }
        }
        return BoilaLit { ok: 1, v: boila_val_param(n), param: n, err: "", state: "" }
    }
    if t.kind == tok_num() {
        return BoilaLit { ok: 1, v: boila_val_i64(parse_int(t.txt)), param: 0, err: "", state: "" }
    }
    if t.kind == tok_str() {
        return BoilaLit { ok: 1, v: boila_val_str(t.txt), param: 0, err: "", state: "" }
    }
    if tok_kw(t, "null") == 1 {
        return BoilaLit { ok: 1, v: boila_val_null(), param: 0, err: "", state: "" }
    }
    if tok_kw(t, "true") == 1 {
        return BoilaLit { ok: 1, v: boila_val_bool(1), param: 0, err: "", state: "" }
    }
    if tok_kw(t, "false") == 1 {
        return BoilaLit { ok: 1, v: boila_val_bool(0), param: 0, err: "", state: "" }
    }
    return BoilaLit { ok: 0, v: boila_val_null(), param: 0, err: concat("очаквах литерал, получих '", concat(t.txt, "'")), state: "42601" }
}

// agg име → kind (1 count, 3 sum, 4 avg, 5 min, 6 max); 0 не е agg.
fn boila_ps_agg_kind(name: str) -> i64 {
    if name == "count" {
        return 1
    }
    if name == "sum" {
        return 3
    }
    if name == "avg" {
        return 4
    }
    if name == "min" {
        return 5
    }
    if name == "max" {
        return 6
    }
    return 0
}

// Проекционен елемент: колона или agg( * | колона ).
struct BoilaPsItem {
    ok: i64,
    item: BoilaSelItem,
    pos: i64,
    err: str,
    state: str
}

// Clause keywords that end SELECT projection (not bare aliases).
fn boila_ps_is_clause_kw(t: Token) -> i64 {
    if t.kind != tok_ident() {
        return 0
    }
    if tok_kw(t, "from") == 1 { return 1 }
    if tok_kw(t, "where") == 1 { return 1 }
    if tok_kw(t, "group") == 1 { return 1 }
    if tok_kw(t, "having") == 1 { return 1 }
    if tok_kw(t, "order") == 1 { return 1 }
    if tok_kw(t, "limit") == 1 { return 1 }
    if tok_kw(t, "offset") == 1 { return 1 }
    if tok_kw(t, "join") == 1 { return 1 }
    if tok_kw(t, "inner") == 1 { return 1 }
    if tok_kw(t, "left") == 1 { return 1 }
    if tok_kw(t, "right") == 1 { return 1 }
    if tok_kw(t, "full") == 1 { return 1 }
    if tok_kw(t, "cross") == 1 { return 1 }
    if tok_kw(t, "union") == 1 { return 1 }
    if tok_kw(t, "except") == 1 { return 1 }
    if tok_kw(t, "intersect") == 1 { return 1 }
    if tok_kw(t, "window") == 1 { return 1 }
    if tok_kw(t, "returning") == 1 { return 1 }
    return 0
}

// S7b/S7c: optional [AS] alias after a projection item.
fn boila_ps_item_alias(l: BoilaLex, item: BoilaSelItem, pos: i64) -> BoilaPsItem {
    if tok_kw(boila_ps_tok(l, pos), "as") == 1 {
        let a = boila_ps_tok(l, pos + 1)
        if a.kind != tok_ident() {
            return BoilaPsItem { ok: 0, item: item, pos: pos, err: "очаквах идентификатор след AS", state: "42601" }
        }
        item.alias = a.txt
        return BoilaPsItem { ok: 1, item: item, pos: pos + 2, err: "", state: "" }
    }
    // bare alias: SELECT col alias FROM … (not a clause keyword)
    let n = boila_ps_tok(l, pos)
    if n.kind == tok_ident() && boila_ps_is_clause_kw(n) == 0 {
        item.alias = n.txt
        return BoilaPsItem { ok: 1, item: item, pos: pos + 1, err: "", state: "" }
    }
    return BoilaPsItem { ok: 1, item: item, pos: pos, err: "", state: "" }
}

fn boila_ps_item(l: BoilaLex, i: i64) -> BoilaPsItem {
    let t = boila_ps_tok(l, i)
    // Q-expr: literal / paren / unary-op start → dual-expression item
    if t.kind == tok_num() || t.kind == tok_str() || t.kind == tok_lparen() || t.kind == tok_op() || t.kind == tok_star() {
        return boila_ps_expr_item(l, i)
    }
    if t.kind != tok_ident() {
        return BoilaPsItem { ok: 0, item: boila_sel_item_col(""), pos: i, err: concat("очаквах колона в проекцията, получих '", concat(t.txt, "'")), state: "42601" }
    }
    // Q-expr: CASE / NOT / TRUE / FALSE / NULL start an expression
    if tok_kw(t, "case") == 1 || tok_kw(t, "not") == 1 || tok_kw(t, "true") == 1 || tok_kw(t, "false") == 1 || tok_kw(t, "null") == 1 {
        return boila_ps_expr_item(l, i)
    }
    // S7: time_bucket('1m', col) in SELECT list
    if t.txt == "time_bucket" {
        if boila_ps_tok(l, i + 1).kind != tok_lparen() {
            return BoilaPsItem { ok: 0, item: boila_sel_item_col(""), pos: i, err: "очаквах '(' след time_bucket", state: "42601" }
        }
        let ivt = boila_ps_tok(l, i + 2)
        if ivt.kind != tok_str() {
            return BoilaPsItem { ok: 0, item: boila_sel_item_col(""), pos: i, err: "очаквах интервал-стринг в time_bucket", state: "42601" }
        }
        if boila_ps_tok(l, i + 3).kind != tok_comma() {
            return BoilaPsItem { ok: 0, item: boila_sel_item_col(""), pos: i, err: "очаквах ',' в time_bucket", state: "42601" }
        }
        let col = boila_ps_tok(l, i + 4)
        if col.kind != tok_ident() {
            return BoilaPsItem { ok: 0, item: boila_sel_item_col(""), pos: i, err: "очаквах колона в time_bucket", state: "42601" }
        }
        if boila_ps_tok(l, i + 5).kind != tok_rparen() {
            return BoilaPsItem { ok: 0, item: boila_sel_item_col(""), pos: i, err: "очаквах ')' в time_bucket", state: "42601" }
        }
        let iv = boila_tb_parse_iv(ivt.txt)
        if iv.ok == 0 {
            return BoilaPsItem { ok: 0, item: boila_sel_item_col(""), pos: i, err: iv.err, state: iv.state }
        }
        return boila_ps_item_alias(l, boila_sel_item_bucket(col.txt, iv.sec), i + 6)
    }
    let kind = boila_ps_agg_kind(t.txt)
    if kind == 0 {
        if boila_ps_tok(l, i + 1).kind == tok_lparen() {
            // Q-sfn: scalar fn over columns/literals; on arg-shape
            // mismatch (expression args) fall back to a full Q-expr
            // item. Arity errors (42883) stay strict.
            if boila_sfn_known(t.txt) == 1 {
                let sf = boila_ps_sfn_item(l, t.txt, i)
                if sf.ok == 1 || sf.state == "42883" {
                    return sf
                }
                return boila_ps_expr_item(l, i)
            }
            // unknown fn(…) → 42883 (CAST is an evaluator special form)
            if t.txt != "cast" {
                return BoilaPsItem { ok: 0, item: boila_sel_item_col(""), pos: i, err: concat(concat("непозната функция '", t.txt), "()"), state: "42883" }
            }
            return boila_ps_expr_item(l, i)
        }
        // Q-expr: ident followed by operator / predicate keyword
        let nx = boila_ps_tok(l, i + 1)
        if nx.kind == tok_op() || nx.kind == tok_star() || boila_ps_is_pred_kw(nx) == 1 {
            return boila_ps_expr_item(l, i)
        }
        return boila_ps_item_alias(l, boila_sel_item_col(t.txt), i + 1)
    }
    // agg( ... )
    if boila_ps_tok(l, i + 1).kind != tok_lparen() {
        return boila_ps_item_alias(l, boila_sel_item_col(t.txt), i + 1)
    }
    let arg = boila_ps_tok(l, i + 2)
    if arg.kind == tok_star() {
        if kind != 1 {
            return BoilaPsItem { ok: 0, item: boila_sel_item_col(""), pos: i, err: concat(t.txt, "(*) — само count поддържа *"), state: "0A000" }
        }
        if boila_ps_tok(l, i + 3).kind != tok_rparen() {
            return BoilaPsItem { ok: 0, item: boila_sel_item_col(""), pos: i, err: "очаквах ')' след count(*)", state: "42601" }
        }
        return boila_ps_item_alias(l, boila_sel_item_agg(1, ""), i + 4)
    }
    // bare col: sum(sal) / count(name)
    let nxt = boila_ps_tok(l, i + 3)
    if arg.kind == tok_ident() && nxt.kind == tok_rparen() {
        let mut k = kind
        if k == 1 {
            k = 2   // count(col)
        }
        return boila_ps_item_alias(l, boila_sel_item_agg(k, arg.txt), i + 4)
    }
    // Q-aexpr: sum(sal + 1), count(upper(name)), min(id * 2)
    let xe = boila_ps_expr_item(l, i + 2)
    if xe.ok == 0 {
        return BoilaPsItem { ok: 0, item: boila_sel_item_col(""), pos: i, err: xe.err, state: xe.state }
    }
    if boila_ps_tok(l, xe.pos).kind != tok_rparen() {
        return BoilaPsItem { ok: 0, item: boila_sel_item_col(""), pos: xe.pos, err: concat("очаквах ')' след ", t.txt), state: "42601" }
    }
    let mut k2 = kind
    if k2 == 1 {
        k2 = 2
    }
    return boila_ps_item_alias(l, boila_sel_item_agg_x(k2, xe.item.xtoks), xe.pos + 1)
}

// Q-sfn: fn(col|lit, …) projection item. Args are columns and literals
// only — no nested calls, no $N; generate_series is dual-only.
fn boila_ps_sfn_item(l: BoilaLex, fnm: str, i: i64) -> BoilaPsItem {
    let z = boila_sel_item_col("")
    if boila_sfn_known(fnm) == 0 {
        return BoilaPsItem { ok: 0, item: z, pos: i, err: concat(concat("непозната функция '", fnm), "()"), state: "42883" }
    }
    if fnm == "generate_series" {
        return BoilaPsItem { ok: 0, item: z, pos: i, err: "generate_series е само за dual (без FROM)", state: "0A000" }
    }
    let cols: Vec<str> = vec_new()
    let vals: Vec<BoilaVal> = vec_new()
    let mut p = i + 2
    if boila_ps_tok(l, p).kind == tok_rparen() {
        return BoilaPsItem { ok: 0, item: z, pos: i, err: concat(fnm, "() изисква аргументи в проекция"), state: "42883" }
    }
    let mut more = true
    while more {
        let at = boila_ps_tok(l, p)
        if at.kind == tok_param() {
            return BoilaPsItem { ok: 0, item: z, pos: i, err: "$N в аргумент на функция не се поддържа", state: "0A000" }
        }
        if at.kind == tok_ident() && tok_kw(at, "null") != 1 && tok_kw(at, "true") != 1 && tok_kw(at, "false") != 1 {
            vec_push(cols, at.txt)
            vec_push(vals, boila_val_null())
            p = p + 1
        } else {
            let lit = boila_ps_literal(l, p)
            if lit.ok == 0 {
                return BoilaPsItem { ok: 0, item: z, pos: i, err: concat("очаквах колона или литерал в ", concat(fnm, "(...)")), state: "42601" }
            }
            vec_push(cols, "")
            vec_push(vals, lit.v)
            p = p + 1
        }
        if boila_ps_tok(l, p).kind == tok_comma() {
            p = p + 1
        } else {
            more = false
        }
    }
    if boila_ps_tok(l, p).kind != tok_rparen() {
        return BoilaPsItem { ok: 0, item: z, pos: i, err: concat("очаквах ')' в ", concat(fnm, "(...)")), state: "42601" }
    }
    let na = vec_len(cols)
    if boila_ps_sfn_arity(fnm, na) == 0 {
        return BoilaPsItem { ok: 0, item: z, pos: i, err: concat(concat(concat(fnm, " — "), concat(int_to_str(na), " аргумента")), " не се поддържа"), state: "42883" }
    }
    return boila_ps_item_alias(l, boila_sel_item_sfn(fnm, cols, vals), p + 1)
}

// Q-sfn arity check: 1 ok, 0 wrong count.
fn boila_ps_sfn_arity(fnm: str, n: i64) -> i64 {
    if fnm == "nullif" || fnm == "mod" || fnm == "power" || fnm == "pow" || fnm == "strpos" || fnm == "starts_with" || fnm == "ends_with" || fnm == "left" || fnm == "right" || fnm == "repeat" {
        if n == 2 { return 1 }
        return 0
    }
    if fnm == "replace" {
        if n == 3 { return 1 }
        return 0
    }
    if fnm == "substr" || fnm == "substring" || fnm == "lpad" || fnm == "rpad" {
        if n == 2 || n == 3 { return 1 }
        return 0
    }
    if boila_dual_is_unary_fn(fnm) == 1 {
        if n == 1 { return 1 }
        return 0
    }
    if n >= 1 { return 1 }
    return 0
}

// Q-expr: predicate keywords that turn `col …` into an expression item.
fn boila_ps_is_pred_kw(t: Token) -> i64 {
    if t.kind != tok_ident() {
        return 0
    }
    if tok_kw(t, "like") == 1 || tok_kw(t, "ilike") == 1 || tok_kw(t, "between") == 1 || tok_kw(t, "in") == 1 || tok_kw(t, "is") == 1 || tok_kw(t, "not") == 1 {
        return 1
    }
    return 0
}

// Q-xw: 1 = `col <pred>` structural WHERE predicate (index/range path
// keeps its acceleration); 0 = anything else → expression filter.
fn boila_ps_is_struct_pred(l: BoilaLex, i: i64) -> i64 {
    let t0 = boila_ps_tok(l, i)
    if t0.kind != tok_ident() {
        return 0
    }
    let t1 = boila_ps_tok(l, i + 1)
    if t1.kind == tok_op() {
        if t1.txt == "=" || t1.txt == "<>" || t1.txt == "!=" || t1.txt == "<" || t1.txt == ">" || t1.txt == "<=" || t1.txt == ">=" || t1.txt == "@@" || t1.txt == "<->" || t1.txt == "<=>" || t1.txt == "<#>" {
            return 1
        }
        return 0
    }
    if tok_kw(t1, "like") == 1 || tok_kw(t1, "ilike") == 1 || tok_kw(t1, "is") == 1 || tok_kw(t1, "in") == 1 || tok_kw(t1, "between") == 1 || tok_kw(t1, "not") == 1 {
        return 1
    }
    return 0
}

// Q-expr: keywords that continue an expression (not bare aliases).
fn boila_ps_expr_cont_kw(t: Token) -> i64 {
    if tok_kw(t, "and") == 1 || tok_kw(t, "or") == 1 || tok_kw(t, "not") == 1 || tok_kw(t, "like") == 1 || tok_kw(t, "ilike") == 1 || tok_kw(t, "between") == 1 || tok_kw(t, "in") == 1 || tok_kw(t, "is") == 1 || tok_kw(t, "escape") == 1 || tok_kw(t, "then") == 1 || tok_kw(t, "when") == 1 || tok_kw(t, "else") == 1 || tok_kw(t, "end") == 1 || tok_kw(t, "case") == 1 {
        return 1
    }
    return 0
}

// Q-expr: capture a dual-expression token span as a projection item.
// Ends at top-level comma / clause keyword / AS / bare alias / ; / EOF.
fn boila_ps_expr_item(l: BoilaLex, i: i64) -> BoilaPsItem {
    let xtoks: Vec<Token> = vec_new()
    let mut j = i
    let mut depth: i64 = 0
    let mut prev_term: i64 = 0
    let mut more = true
    while more {
        let tj = boila_ps_tok(l, j)
        if tj.kind == tok_eof() || tj.kind == tok_semi() {
            more = false
        } else {
            if depth == 0 && tj.kind == tok_comma() {
                more = false
            } else {
                if depth == 0 && tj.kind == tok_rparen() {
                    more = false
                } else {
                    if depth == 0 && (tok_kw(tj, "as") == 1 || boila_ps_is_clause_kw(tj) == 1) {
                        more = false
                    } else {
                        if depth == 0 && prev_term == 1 && tj.kind == tok_ident() && boila_ps_expr_cont_kw(tj) == 0 {
                            more = false   // bare alias
                        } else {
                            if tj.kind == tok_lparen() { depth = depth + 1 }
                            if tj.kind == tok_rparen() { depth = depth - 1 }
                            vec_push(xtoks, tj)
                            prev_term = 0
                            if tj.kind == tok_ident() || tj.kind == tok_num() || tj.kind == tok_str() || tj.kind == tok_rparen() {
                                prev_term = 1
                            }
                            // operand-expecting keywords keep the expr open
                            if tj.kind == tok_ident() && boila_ps_expr_cont_kw(tj) == 1 && tok_kw(tj, "end") != 1 {
                                prev_term = 0
                            }
                            j = j + 1
                        }
                    }
                }
            }
        }
    }
    if vec_len(xtoks) == 0 {
        return BoilaPsItem { ok: 0, item: boila_sel_item_col(""), pos: i, err: "очаквах израз в проекцията", state: "42601" }
    }
    let mut g: i64 = 0
    while g < vec_len(xtoks) {
        let tg = vec_get(xtoks, g)
        if tg.kind == tok_ident() && tg.txt == "generate_series" {
            return BoilaPsItem { ok: 0, item: boila_sel_item_col(""), pos: i, err: "generate_series е само за dual (без FROM)", state: "0A000" }
        }
        g = g + 1
    }
    return boila_ps_item_alias(l, boila_sel_item_expr(xtoks), j)
}
