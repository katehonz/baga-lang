// exec_sql.baga — SQL dispatch (P5). DML/DDL via txn buffer; bare stmts
// auto-commit. Plan cache on single-table SELECT; DDL invalidates.

import "lexer.baga"
import "token.baga"
import "parse_select.baga"
import "parse_ddl.baga"
import "parse_alter.baga"
import "parse_index.baga"
import "../catalog/alter.baga"
import "parse_dml.baga"
import "parse_insert.baga"
import "parse_txn.baga"
import "parse_with.baga"
import "exec_scan.baga"
import "exec_out.baga"
import "exec_dual.baga"
import "exec_explain.baga"
import "exec_select.baga"
import "exec_dml.baga"
import "exec_modify.baga"
import "exec_with.baga"
import "plan_cache.baga"
import "../fts/fts.baga"
import "../vector/hnsw.baga"
import "../vector/distance.baga"
import "../graph/adjacency.baga"
import "../catalog/schema.baga"
import "../storage/shards.baga"
import "../index/secondary.baga"
import "../txn/mvcc.baga"
import "exec_drop.baga"
import "exec_show.baga"
import "std/str/str.baga"

// pc_mu=0 → unlocked (tests / single-thread). Serve passes per-db mutex.
fn boila_exec_sql(s: BoilaStore, txn: BoilaTxn, db: str, sql: str, pc: BoilaPlanCache) -> BoilaSqlOut !IO !Time !Par {
    let guc: Map<str, str> = map_new()
    return boila_exec_sql_mu(s, txn, db, sql, pc, 0, guc)?
}

fn boila_exec_sql_guc(s: BoilaStore, txn: BoilaTxn, db: str, sql: str, pc: BoilaPlanCache, guc: Map<str, str>) -> BoilaSqlOut !IO !Time !Par {
    return boila_exec_sql_mu(s, txn, db, sql, pc, 0, guc)?
}

fn boila_exec_sql_mu(s: BoilaStore, txn: BoilaTxn, db: str, sql: str, pc: BoilaPlanCache, pc_mu: i64, guc: Map<str, str>) -> BoilaSqlOut !IO !Time !Par {
    let lx = boila_lex(sql)
    if lx.err != "" {
        return boila_sql_fail(s, txn, pc, lx.err, "42601")
    }
    let t0 = vec_get(lx.toks, 0)
    if t0.kind == tok_eof() {
        return boila_sql_fail(s, txn, pc, "празна заявка", "42601")
    }

    // --- транзакционен контрол ---
    if tok_kw(t0, "begin") == 1 || tok_kw(t0, "start") == 1 || tok_kw(t0, "commit") == 1 || tok_kw(t0, "end") == 1 || tok_kw(t0, "rollback") == 1 || tok_kw(t0, "abort") == 1 {
        let p = boila_parse_txn(lx)
        if p.ok == 0 {
            return boila_sql_fail(s, txn, pc, p.err, p.state)
        }
        if p.op == 1 {
            let b = boila_txn_begin(s, txn, p.read_only, db)?
            if b.ok == 0 {
                return boila_sql_fail(b.s, b.txn, pc, b.err, b.state)
            }
            return BoilaSqlOut { s: b.s, txn: b.txn, pc: pc, ok: 1, err: "", state: "", kind: 10, res: boila_result_empty(), id: b.lsn }
        }
        if p.op == 2 {
            let c = boila_txn_commit(s, txn)?
            if c.ok == 0 {
                return boila_sql_fail(c.s, c.txn, pc, c.err, c.state)
            }
            return BoilaSqlOut { s: c.s, txn: c.txn, pc: pc, ok: 1, err: "", state: "", kind: 11, res: boila_result_empty(), id: c.lsn }
        }
        let t2 = boila_txn_rollback(txn)
        return BoilaSqlOut { s: s, txn: t2, pc: pc, ok: 1, err: "", state: "", kind: 12, res: boila_result_empty(), id: 0 }
    }

    if tok_kw(t0, "explain") == 1 {
        return boila_exec_explain(s, txn, pc, db, lx, guc, sql)?
    }
    if tok_kw(t0, "with") == 1 {
        let p = boila_parse_with(lx)
        if p.ok == 0 {
            return boila_sql_fail(s, txn, pc, p.err, p.state)
        }
        let ex = boila_exec_with(s, txn, p.w)?
        return BoilaSqlOut { s: ex.s, txn: ex.txn, pc: pc, ok: ex.ok, err: ex.err, state: ex.state, kind: 16, res: ex.res, id: vec_len(ex.res.rows) }
    }
    // PG: TABLE name … ≡ SELECT * FROM name …
    if tok_kw(t0, "table") == 1 {
        let sql2 = boila_table_stmt_to_select(lx)
        if sql2 == "" {
            return boila_sql_fail(s, txn, pc, "очаквах име на таблица след TABLE", "42601")
        }
        return boila_exec_sql_mu(s, txn, db, sql2, pc, pc_mu, guc)?
    }
    if tok_kw(t0, "select") == 1 || tok_kw(t0, "values") == 1 {
        let du = boila_try_exec_dual(s, txn, pc, db, lx, guc)?
        if du.hit == 1 { return du.out }
        if tok_kw(t0, "values") == 1 {
            return boila_sql_fail(s, txn, pc, "невалиден VALUES", "42601")
        }
        let hit = boila_pc_get_mu(pc, sql, pc_mu)?
        if hit.hit == 1 {
            let ex = boila_exec_select(s, txn, hit.plan.table, hit.plan.sel)?
            return BoilaSqlOut { s: ex.s, txn: ex.txn, pc: pc, ok: ex.ok, err: ex.err, state: ex.state, kind: 1, res: ex.res, id: 0 }
        }
        let ps = boila_parse_select(lx)
        if ps.ok == 0 { return boila_sql_fail(s, txn, pc, ps.err, ps.state) }
        let ct = boila_cat_by_name_txn(s, txn, ps.sel.table)?
        s = ct.s
        if ct.ok == 0 { return boila_sql_fail(s, txn, pc, ct.err, ct.state) }
        boila_pc_put_mu(pc, sql, BoilaSelPlan { sel: ps.sel, table: ct.table }, pc_mu)?
        let ex = boila_exec_select(s, txn, ct.table, ps.sel)?
        return BoilaSqlOut { s: ex.s, txn: ex.txn, pc: pc, ok: ex.ok, err: ex.err, state: ex.state, kind: 1, res: ex.res, id: 0 }
    }
    if tok_kw(t0, "drop") == 1 {
        return boila_exec_drop(s, txn, db, lx, pc, pc_mu)?
    }
    if tok_kw(t0, "truncate") == 1 {
        return boila_exec_truncate(s, txn, db, lx, pc, pc_mu)?
    }
    if tok_kw(t0, "alter") == 1 {
        let p = boila_parse_alter(lx)
        if p.ok == 0 { return boila_sql_fail(s, txn, pc, p.err, p.state) }
        let ar = boila_alter_run(s, txn, db, p.alt)?
        if ar.ok == 0 { return boila_sql_fail(ar.s, ar.txn, pc, ar.err, ar.state) }
        return BoilaSqlOut { s: ar.s, txn: ar.txn, pc: boila_pc_invalidate_mu(pc, pc_mu)?, ok: 1, err: "", state: "", kind: 22, res: boila_result_empty(), id: ar.id }
    }
    if tok_kw(t0, "create") == 1 {
        let t1 = vec_get(lx.toks, 1)
        if tok_kw(t1, "table") == 1 {
            let pc2 = boila_parse_create(lx)
            if pc2.ok == 0 {
                return boila_sql_fail(s, txn, pc, pc2.err, pc2.state)
            }
            // T5: CREATE TABLE през txn buffer (rollback-able)
            let was_active = txn.active
            if was_active == 0 {
                let b = boila_txn_begin(s, txn, 0, db)?
                s = b.s
                txn = b.txn
            }
            let cr = boila_cat_create_txn(s, txn, pc2.create)?
            s = cr.s
            txn = cr.txn
            if cr.ok == 0 {
                if was_active == 0 { txn = boila_txn_rollback(txn) }
                if pc2.if_not_exists == 1 && cr.state == "42P07" {
                    return BoilaSqlOut { s: s, txn: txn, pc: pc, ok: 1, err: "", state: "", kind: 2, res: boila_result_empty(), id: 0 }
                }
                return boila_sql_fail(s, txn, pc, cr.err, cr.state)
            }
            if was_active == 0 {
                let c = boila_txn_commit(s, txn)?
                s = c.s
                txn = c.txn
                if c.ok == 0 { return boila_sql_fail(s, txn, pc, c.err, c.state) }
            }
            return BoilaSqlOut { s: s, txn: txn, pc: boila_pc_invalidate_mu(pc, pc_mu)?, ok: 1, err: "", state: "", kind: 2, res: boila_result_empty(), id: cr.id }
        }
        if tok_kw(t1, "index") == 1 {
            let p = boila_parse_create_ix2(lx)
            if p.ok == 0 {
                return boila_sql_fail(s, txn, pc, p.err, p.state)
            }
            let ct = boila_cat_by_name_txn(s, txn, p.ix.table)?
            s = ct.s
            if ct.ok == 0 {
                return boila_sql_fail(s, txn, pc, ct.err, ct.state)
            }
            let was_active = txn.active
            if was_active == 0 {
                let b = boila_txn_begin(s, txn, 0, db)?
                s = b.s
                txn = b.txn
            }
            if p.kind == 1 {
                let hx = hnsw_create(s, txn, ct.table, p.ix.ix_name, p.ix.col, p.metric)?
                s = hx.s
                txn = hx.txn
                if hx.ok == 0 {
                    if was_active == 0 { txn = boila_txn_rollback(txn) }
                    if p.if_not_exists == 1 && hx.state == "42710" {
                        return BoilaSqlOut { s: s, txn: txn, pc: pc, ok: 1, err: "", state: "", kind: 15, res: boila_result_empty(), id: 0 }
                    }
                    if was_active == 1 { txn = boila_txn_rollback(txn) }
                    return boila_sql_fail(s, txn, pc, hx.err, hx.state)
                }
                if was_active == 0 {
                    let c = boila_txn_commit(s, txn)?
                    s = c.s
                    txn = c.txn
                    if c.ok == 0 { return boila_sql_fail(s, txn, pc, c.err, c.state) }
                }
                return BoilaSqlOut { s: s, txn: txn, pc: boila_pc_invalidate_mu(pc, pc_mu)?, ok: 1, err: "", state: "", kind: 15, res: boila_result_empty(), id: hx.id }
            }
            let ix = boila_ix_create(s, txn, ct.table, p.ix.ix_name, p.ix.col)?
            s = ix.s
            txn = ix.txn
            if ix.ok == 0 {
                if was_active == 0 { txn = boila_txn_rollback(txn) }
                if p.if_not_exists == 1 && ix.state == "42710" {
                    return BoilaSqlOut { s: s, txn: txn, pc: pc, ok: 1, err: "", state: "", kind: 9, res: boila_result_empty(), id: 0 }
                }
                if was_active == 1 { txn = boila_txn_rollback(txn) }
                return boila_sql_fail(s, txn, pc, ix.err, ix.state)
            }
            if was_active == 0 {
                let c = boila_txn_commit(s, txn)?
                s = c.s
                txn = c.txn
                if c.ok == 0 { return boila_sql_fail(s, txn, pc, c.err, c.state) }
            }
            return BoilaSqlOut { s: s, txn: txn, pc: boila_pc_invalidate_mu(pc, pc_mu)?, ok: 1, err: "", state: "", kind: 9, res: boila_result_empty(), id: ix.id }
        }
        if tok_kw(t1, "graph") == 1 {
            let p = boila_parse_create_graph(lx)
            if p.ok == 0 { return boila_sql_fail(s, txn, pc, p.err, p.state) }
            let ct = boila_cat_by_name_txn(s, txn, p.table)?
            s = ct.s
            if ct.ok == 0 { return boila_sql_fail(s, txn, pc, ct.err, ct.state) }
            let was_active = txn.active
            if was_active == 0 {
                let b = boila_txn_begin(s, txn, 0, db)?
                s = b.s
                txn = b.txn
            }
            let gx = graph_create(s, txn, ct.table, p.name, p.src, p.dst, p.wcol)?
            s = gx.s
            txn = gx.txn
            if gx.ok == 0 {
                if was_active == 0 { txn = boila_txn_rollback(txn) }
                if p.if_not_exists == 1 && gx.state == "42710" {
                    return BoilaSqlOut { s: s, txn: txn, pc: pc, ok: 1, err: "", state: "", kind: 17, res: boila_result_empty(), id: 0 }
                }
                if was_active == 1 { txn = boila_txn_rollback(txn) }
                return boila_sql_fail(s, txn, pc, gx.err, gx.state)
            }
            if was_active == 0 {
                let c = boila_txn_commit(s, txn)?
                s = c.s
                txn = c.txn
                if c.ok == 0 { return boila_sql_fail(s, txn, pc, c.err, c.state) }
            }
            return BoilaSqlOut { s: s, txn: txn, pc: boila_pc_invalidate_mu(pc, pc_mu)?, ok: 1, err: "", state: "", kind: 17, res: boila_result_empty(), id: gx.id }
        }
        if tok_kw(t1, "fts") == 1 {
            let p = boila_parse_create_fts(lx)
            if p.ok == 0 { return boila_sql_fail(s, txn, pc, p.err, p.state) }
            let ct = boila_cat_by_name_txn(s, txn, p.ix.table)?
            s = ct.s
            if ct.ok == 0 { return boila_sql_fail(s, txn, pc, ct.err, ct.state) }
            let was_active = txn.active
            if was_active == 0 {
                let b = boila_txn_begin(s, txn, 0, db)?
                s = b.s
                txn = b.txn
            }
            let fx = fts_create(s, txn, ct.table, p.ix.ix_name, p.ix.col)?
            s = fx.s
            txn = fx.txn
            if fx.ok == 0 {
                if was_active == 0 { txn = boila_txn_rollback(txn) }
                if p.if_not_exists == 1 && fx.state == "42710" {
                    return BoilaSqlOut { s: s, txn: txn, pc: pc, ok: 1, err: "", state: "", kind: 14, res: boila_result_empty(), id: 0 }
                }
                if was_active == 1 { txn = boila_txn_rollback(txn) }
                return boila_sql_fail(s, txn, pc, fx.err, fx.state)
            }
            if was_active == 0 {
                let c = boila_txn_commit(s, txn)?
                s = c.s
                txn = c.txn
                if c.ok == 0 { return boila_sql_fail(s, txn, pc, c.err, c.state) }
            }
            return BoilaSqlOut { s: s, txn: txn, pc: boila_pc_invalidate_mu(pc, pc_mu)?, ok: 1, err: "", state: "", kind: 14, res: boila_result_empty(), id: fx.id }
        }
        return boila_sql_fail(s, txn, pc, "CREATE TABLE / INDEX / FTS INDEX / INDEX USING hnsw", "0A000")
    }
    if tok_kw(t0, "insert") == 1 {
        let p = boila_parse_insert(lx)
        if p.ok == 0 {
            return boila_sql_fail(s, txn, pc, p.err, p.state)
        }
        let ct = boila_cat_by_name_txn(s, txn, p.ins.table)?
        s = ct.s
        if ct.ok == 0 {
            return boila_sql_fail(s, txn, pc, ct.err, ct.state)
        }
        let was_active = txn.active
        if was_active == 0 {
            let b = boila_txn_begin(s, txn, 0, db)?
            s = b.s
            txn = b.txn
        }
        let ex = boila_exec_insert(s, txn, ct.table, p.ins)?
        s = ex.s
        txn = ex.txn
        if ex.ok == 0 {
            // грешка → rollback на буфера (T1): и за явна, и за имплицитна
            txn = boila_txn_rollback(txn)
            return boila_sql_fail(s, txn, pc, ex.err, ex.state)
        }
        if was_active == 0 {
            let c = boila_txn_commit(s, txn)?
            s = c.s
            txn = c.txn
            if c.ok == 0 {
                return boila_sql_fail(s, txn, pc, c.err, c.state)
            }
        }
        return BoilaSqlOut { s: s, txn: txn, pc: pc, ok: 1, err: "", state: "", kind: 6, res: ex.res, id: ex.affected }
    }
    if tok_kw(t0, "update") == 1 {
        let p = boila_parse_update(lx)
        if p.ok == 0 {
            return boila_sql_fail(s, txn, pc, p.err, p.state)
        }
        let ct = boila_cat_by_name_txn(s, txn, p.upd.table)?
        s = ct.s
        if ct.ok == 0 {
            return boila_sql_fail(s, txn, pc, ct.err, ct.state)
        }
        let was_active = txn.active
        if was_active == 0 {
            let b = boila_txn_begin(s, txn, 0, db)?
            s = b.s
            txn = b.txn
        }
        let ex = boila_exec_update(s, txn, ct.table, p.upd)?
        s = ex.s
        txn = ex.txn
        if ex.ok == 0 {
            txn = boila_txn_rollback(txn)
            return boila_sql_fail(s, txn, pc, ex.err, ex.state)
        }
        if was_active == 0 {
            let c = boila_txn_commit(s, txn)?
            s = c.s
            txn = c.txn
            if c.ok == 0 {
                return boila_sql_fail(s, txn, pc, c.err, c.state)
            }
        }
        return BoilaSqlOut { s: s, txn: txn, pc: pc, ok: 1, err: "", state: "", kind: 7, res: ex.res, id: ex.affected }
    }
    if tok_kw(t0, "delete") == 1 {
        let p = boila_parse_delete(lx)
        if p.ok == 0 {
            return boila_sql_fail(s, txn, pc, p.err, p.state)
        }
        let ct = boila_cat_by_name_txn(s, txn, p.del.table)?
        s = ct.s
        if ct.ok == 0 {
            return boila_sql_fail(s, txn, pc, ct.err, ct.state)
        }
        let was_active = txn.active
        if was_active == 0 {
            let b = boila_txn_begin(s, txn, 0, db)?
            s = b.s
            txn = b.txn
        }
        let ex = boila_exec_delete(s, txn, ct.table, p.del)?
        s = ex.s
        txn = ex.txn
        if ex.ok == 0 {
            txn = boila_txn_rollback(txn)
            return boila_sql_fail(s, txn, pc, ex.err, ex.state)
        }
        if was_active == 0 {
            let c = boila_txn_commit(s, txn)?
            s = c.s
            txn = c.txn
            if c.ok == 0 {
                return boila_sql_fail(s, txn, pc, c.err, c.state)
            }
        }
        return BoilaSqlOut { s: s, txn: txn, pc: pc, ok: 1, err: "", state: "", kind: 8, res: ex.res, id: ex.affected }
    }
    // W7 fallback (no session map — mt_exec path); server_exec intercepts first
    if tok_kw(t0, "set") == 1 { return boila_exec_set_ok(s, txn, pc) }
    if tok_kw(t0, "show") == 1 { return boila_exec_show(s, txn, pc, lx)? }
    if tok_kw(t0, "describe") == 1 || tok_kw(t0, "desc") == 1 {
        return boila_exec_describe(s, txn, pc, lx)?
    }
    if tok_kw(t0, "reset") == 1 { return boila_sql_ok(s, txn, pc, 20, boila_result_empty(), 0) }
    if tok_kw(t0, "discard") == 1 { return boila_sql_ok(s, txn, pc, 21, boila_result_empty(), 0) }
    return boila_sql_fail(s, txn, pc, concat("неподдържана конструкция '", concat(t0.txt, "'")), "0A000")
}
