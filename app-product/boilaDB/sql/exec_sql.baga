// exec_sql.baga — dispatch: SQL текст → лекс → parse → catalog → exec (P5).
//
// Транзакционен модел: DML/CREATE INDEX се буферизират в txn; извън явна
// транзакция всяко заявление е имплицитен auto-commit txn (begin → exec →
// commit; грешка → rollback на буфера). Явните BEGIN/COMMIT/ROLLBACK
// държат буфера отворен между заявленията.
// Plan cache (P5): резолвнати едно-таблични SELECT планове по SQL текст;
// DDL инвалидира картата.

import "lexer.baga"
import "token.baga"
import "parse_select.baga"
import "parse_ddl.baga"
import "parse_index.baga"
import "parse_dml.baga"
import "parse_insert.baga"
import "parse_txn.baga"
import "parse_with.baga"
import "exec_scan.baga"
import "exec_select.baga"
import "exec_dml.baga"
import "exec_modify.baga"
import "exec_with.baga"
import "plan_cache.baga"
import "../fts/fts.baga"
import "../vector/hnsw.baga"
import "../vector/distance.baga"
import "../graph/adjacency.baga"
import "../catalog/schema.baga"
import "../storage/shards.baga"
import "../index/secondary.baga"
import "../txn/mvcc.baga"
import "std/str/str.baga"

struct BoilaSqlOut {
    s: BoilaStore,
    txn: BoilaTxn,
    pc: BoilaPlanCache,
    ok: i64,
    err: str,
    state: str,
    kind: i64,    // 1 select, 2 create table, 6/7/8 DML, 9 create index,
                  // 10 begin, 11 commit, 12 rollback
    res: BoilaResult,
    id: i64       // affected (DML) / table id / index id / commit lsn
}

fn boila_sql_fail(s: BoilaStore, txn: BoilaTxn, pc: BoilaPlanCache, msg: str, state: str) -> BoilaSqlOut {
    return BoilaSqlOut { s: s, txn: txn, pc: pc, ok: 0, err: msg, state: state, kind: 0, res: boila_result_empty(), id: 0 }
}

fn boila_exec_sql(s: BoilaStore, txn: BoilaTxn, db: str, sql: str, pc: BoilaPlanCache) -> BoilaSqlOut !IO !Time {
    let lx = boila_lex(sql)
    if lx.err != "" {
        return boila_sql_fail(s, txn, pc, lx.err, "42601")
    }
    let t0 = vec_get(lx.toks, 0)
    if t0.kind == tok_eof() {
        return boila_sql_fail(s, txn, pc, "празна заявка", "42601")
    }

    // --- транзакционен контрол ---
    if tok_kw(t0, "begin") == 1 || tok_kw(t0, "start") == 1 || tok_kw(t0, "commit") == 1 || tok_kw(t0, "rollback") == 1 {
        let p = boila_parse_txn(lx)
        if p.ok == 0 {
            return boila_sql_fail(s, txn, pc, p.err, p.state)
        }
        if p.op == 1 {
            let b = boila_txn_begin(s, txn, p.read_only, db)?
            if b.ok == 0 {
                return boila_sql_fail(b.s, b.txn, pc, b.err, b.state)
            }
            return BoilaSqlOut { s: b.s, txn: b.txn, pc: pc, ok: 1, err: "", state: "", kind: 10, res: boila_result_empty(), id: b.lsn }
        }
        if p.op == 2 {
            let c = boila_txn_commit(s, txn)?
            if c.ok == 0 {
                return boila_sql_fail(c.s, c.txn, pc, c.err, c.state)
            }
            return BoilaSqlOut { s: c.s, txn: c.txn, pc: pc, ok: 1, err: "", state: "", kind: 11, res: boila_result_empty(), id: c.lsn }
        }
        let t2 = boila_txn_rollback(txn)
        return BoilaSqlOut { s: s, txn: t2, pc: pc, ok: 1, err: "", state: "", kind: 12, res: boila_result_empty(), id: 0 }
    }

    if tok_kw(t0, "with") == 1 {
        let p = boila_parse_with(lx)
        if p.ok == 0 {
            return boila_sql_fail(s, txn, pc, p.err, p.state)
        }
        let ex = boila_exec_with(s, txn, p.w)?
        return BoilaSqlOut { s: ex.s, txn: ex.txn, pc: pc, ok: ex.ok, err: ex.err, state: ex.state, kind: 16, res: ex.res, id: vec_len(ex.res.rows) }
    }
    if tok_kw(t0, "select") == 1 {
        // plan cache hit?
        let hit = boila_pc_get(pc, sql)
        if hit.hit == 1 {
            let ex = boila_exec_select(s, txn, hit.plan.table, hit.plan.sel)?
            return BoilaSqlOut { s: ex.s, txn: ex.txn, pc: pc, ok: ex.ok, err: ex.err, state: ex.state, kind: 1, res: ex.res, id: 0 }
        }
        let ps = boila_parse_select(lx)
        if ps.ok == 0 {
            return boila_sql_fail(s, txn, pc, ps.err, ps.state)
        }
        let ct = boila_cat_by_name(s, ps.sel.table)?
        s = ct.s
        if ct.ok == 0 {
            return boila_sql_fail(s, txn, pc, ct.err, ct.state)
        }
        // кеширай само едно-табличните (join-ите плащат parse, gaps C1)
        if ps.sel.has_join == 0 {
            boila_pc_put(pc, sql, BoilaSelPlan { sel: ps.sel, table: ct.table })
        }
        let ex = boila_exec_select(s, txn, ct.table, ps.sel)?
        return BoilaSqlOut { s: ex.s, txn: ex.txn, pc: pc, ok: ex.ok, err: ex.err, state: ex.state, kind: 1, res: ex.res, id: 0 }
    }
    if tok_kw(t0, "drop") == 1 {
        let t1 = vec_get(lx.toks, 1)
        if tok_kw(t1, "table") == 1 {
            if txn.active == 1 {
                return boila_sql_fail(s, txn, pc, "DROP TABLE извън транзакционния буфер (като CREATE TABLE)", "0A000")
            }
            let p = boila_parse_drop_table(lx)
            if p.ok == 0 {
                return boila_sql_fail(s, txn, pc, p.err, p.state)
            }
            let dr = boila_cat_drop(s, p.name)?
            s = dr.s
            if dr.ok == 0 {
                return boila_sql_fail(s, txn, pc, dr.err, dr.state)
            }
            return BoilaSqlOut { s: s, txn: txn, pc: boila_pc_invalidate(pc), ok: 1, err: "", state: "", kind: 18, res: boila_result_empty(), id: dr.id }
        }
        return boila_sql_fail(s, txn, pc, "DROP TABLE / DROP DATABASE (сърверно)", "0A000")
    }
    if tok_kw(t0, "create") == 1 {
        let t1 = vec_get(lx.toks, 1)
        if tok_kw(t1, "table") == 1 {
            if txn.active == 1 {
                return boila_sql_fail(s, txn, pc, "CREATE TABLE извън транзакционния буфер в P4 (gaps T5)", "0A000")
            }
            let pc2 = boila_parse_create(lx)
            if pc2.ok == 0 {
                return boila_sql_fail(s, txn, pc, pc2.err, pc2.state)
            }
            let cr = boila_cat_create(s, pc2.create)?
            s = cr.s
            if cr.ok == 0 {
                return boila_sql_fail(s, txn, pc, cr.err, cr.state)
            }
            return BoilaSqlOut { s: s, txn: txn, pc: boila_pc_invalidate(pc), ok: 1, err: "", state: "", kind: 2, res: boila_result_empty(), id: cr.id }
        }
        if tok_kw(t1, "index") == 1 {
            let p = boila_parse_create_ix2(lx)
            if p.ok == 0 {
                return boila_sql_fail(s, txn, pc, p.err, p.state)
            }
            let ct = boila_cat_by_name(s, p.ix.table)?
            s = ct.s
            if ct.ok == 0 {
                return boila_sql_fail(s, txn, pc, ct.err, ct.state)
            }
            let was_active = txn.active
            if was_active == 0 {
                let b = boila_txn_begin(s, txn, 0, db)?
                s = b.s
                txn = b.txn
            }
            if p.kind == 1 {
                let hx = hnsw_create(s, txn, ct.table, p.ix.ix_name, p.ix.col, p.metric)?
                s = hx.s
                txn = hx.txn
                if hx.ok == 0 {
                    txn = boila_txn_rollback(txn)
                    return boila_sql_fail(s, txn, pc, hx.err, hx.state)
                }
                if was_active == 0 {
                    let c = boila_txn_commit(s, txn)?
                    s = c.s
                    txn = c.txn
                    if c.ok == 0 {
                        return boila_sql_fail(s, txn, pc, c.err, c.state)
                    }
                }
                return BoilaSqlOut { s: s, txn: txn, pc: boila_pc_invalidate(pc), ok: 1, err: "", state: "", kind: 15, res: boila_result_empty(), id: hx.id }
            }
            let ix = boila_ix_create(s, txn, ct.table, p.ix.ix_name, p.ix.col)?
            s = ix.s
            txn = ix.txn
            if ix.ok == 0 {
                txn = boila_txn_rollback(txn)
                return boila_sql_fail(s, txn, pc, ix.err, ix.state)
            }
            if was_active == 0 {
                let c = boila_txn_commit(s, txn)?
                s = c.s
                txn = c.txn
                if c.ok == 0 {
                    return boila_sql_fail(s, txn, pc, c.err, c.state)
                }
            }
            return BoilaSqlOut { s: s, txn: txn, pc: boila_pc_invalidate(pc), ok: 1, err: "", state: "", kind: 9, res: boila_result_empty(), id: ix.id }
        }
        if tok_kw(t1, "graph") == 1 {
            let p = boila_parse_create_graph(lx)
            if p.ok == 0 {
                return boila_sql_fail(s, txn, pc, p.err, p.state)
            }
            let ct = boila_cat_by_name(s, p.table)?
            s = ct.s
            if ct.ok == 0 {
                return boila_sql_fail(s, txn, pc, ct.err, ct.state)
            }
            let was_active = txn.active
            if was_active == 0 {
                let b = boila_txn_begin(s, txn, 0, db)?
                s = b.s
                txn = b.txn
            }
            let gx = graph_create(s, txn, ct.table, p.name, p.src, p.dst, p.wcol)?
            s = gx.s
            txn = gx.txn
            if gx.ok == 0 {
                txn = boila_txn_rollback(txn)
                return boila_sql_fail(s, txn, pc, gx.err, gx.state)
            }
            if was_active == 0 {
                let c = boila_txn_commit(s, txn)?
                s = c.s
                txn = c.txn
                if c.ok == 0 {
                    return boila_sql_fail(s, txn, pc, c.err, c.state)
                }
            }
            return BoilaSqlOut { s: s, txn: txn, pc: boila_pc_invalidate(pc), ok: 1, err: "", state: "", kind: 17, res: boila_result_empty(), id: gx.id }
        }
        if tok_kw(t1, "fts") == 1 {
            let p = boila_parse_create_fts(lx)
            if p.ok == 0 {
                return boila_sql_fail(s, txn, pc, p.err, p.state)
            }
            let ct = boila_cat_by_name(s, p.ix.table)?
            s = ct.s
            if ct.ok == 0 {
                return boila_sql_fail(s, txn, pc, ct.err, ct.state)
            }
            let was_active = txn.active
            if was_active == 0 {
                let b = boila_txn_begin(s, txn, 0, db)?
                s = b.s
                txn = b.txn
            }
            let fx = fts_create(s, txn, ct.table, p.ix.ix_name, p.ix.col)?
            s = fx.s
            txn = fx.txn
            if fx.ok == 0 {
                txn = boila_txn_rollback(txn)
                return boila_sql_fail(s, txn, pc, fx.err, fx.state)
            }
            if was_active == 0 {
                let c = boila_txn_commit(s, txn)?
                s = c.s
                txn = c.txn
                if c.ok == 0 {
                    return boila_sql_fail(s, txn, pc, c.err, c.state)
                }
            }
            return BoilaSqlOut { s: s, txn: txn, pc: boila_pc_invalidate(pc), ok: 1, err: "", state: "", kind: 14, res: boila_result_empty(), id: fx.id }
        }
        return boila_sql_fail(s, txn, pc, "CREATE TABLE / INDEX / FTS INDEX / INDEX USING hnsw", "0A000")
    }
    if tok_kw(t0, "insert") == 1 {
        let p = boila_parse_insert(lx)
        if p.ok == 0 {
            return boila_sql_fail(s, txn, pc, p.err, p.state)
        }
        let ct = boila_cat_by_name(s, p.ins.table)?
        s = ct.s
        if ct.ok == 0 {
            return boila_sql_fail(s, txn, pc, ct.err, ct.state)
        }
        let was_active = txn.active
        if was_active == 0 {
            let b = boila_txn_begin(s, txn, 0, db)?
            s = b.s
            txn = b.txn
        }
        let ex = boila_exec_insert(s, txn, ct.table, p.ins)?
        s = ex.s
        txn = ex.txn
        if ex.ok == 0 {
            // грешка → rollback на буфера (T1): и за явна, и за имплицитна
            txn = boila_txn_rollback(txn)
            return boila_sql_fail(s, txn, pc, ex.err, ex.state)
        }
        if was_active == 0 {
            let c = boila_txn_commit(s, txn)?
            s = c.s
            txn = c.txn
            if c.ok == 0 {
                return boila_sql_fail(s, txn, pc, c.err, c.state)
            }
        }
        return BoilaSqlOut { s: s, txn: txn, pc: pc, ok: 1, err: "", state: "", kind: 6, res: ex.res, id: ex.affected }
    }
    if tok_kw(t0, "update") == 1 {
        let p = boila_parse_update(lx)
        if p.ok == 0 {
            return boila_sql_fail(s, txn, pc, p.err, p.state)
        }
        let ct = boila_cat_by_name(s, p.upd.table)?
        s = ct.s
        if ct.ok == 0 {
            return boila_sql_fail(s, txn, pc, ct.err, ct.state)
        }
        let was_active = txn.active
        if was_active == 0 {
            let b = boila_txn_begin(s, txn, 0, db)?
            s = b.s
            txn = b.txn
        }
        let ex = boila_exec_update(s, txn, ct.table, p.upd)?
        s = ex.s
        txn = ex.txn
        if ex.ok == 0 {
            txn = boila_txn_rollback(txn)
            return boila_sql_fail(s, txn, pc, ex.err, ex.state)
        }
        if was_active == 0 {
            let c = boila_txn_commit(s, txn)?
            s = c.s
            txn = c.txn
            if c.ok == 0 {
                return boila_sql_fail(s, txn, pc, c.err, c.state)
            }
        }
        return BoilaSqlOut { s: s, txn: txn, pc: pc, ok: 1, err: "", state: "", kind: 7, res: ex.res, id: ex.affected }
    }
    if tok_kw(t0, "delete") == 1 {
        let p = boila_parse_delete(lx)
        if p.ok == 0 {
            return boila_sql_fail(s, txn, pc, p.err, p.state)
        }
        let ct = boila_cat_by_name(s, p.del.table)?
        s = ct.s
        if ct.ok == 0 {
            return boila_sql_fail(s, txn, pc, ct.err, ct.state)
        }
        let was_active = txn.active
        if was_active == 0 {
            let b = boila_txn_begin(s, txn, 0, db)?
            s = b.s
            txn = b.txn
        }
        let ex = boila_exec_delete(s, txn, ct.table, p.del)?
        s = ex.s
        txn = ex.txn
        if ex.ok == 0 {
            txn = boila_txn_rollback(txn)
            return boila_sql_fail(s, txn, pc, ex.err, ex.state)
        }
        if was_active == 0 {
            let c = boila_txn_commit(s, txn)?
            s = c.s
            txn = c.txn
            if c.ok == 0 {
                return boila_sql_fail(s, txn, pc, c.err, c.state)
            }
        }
        return BoilaSqlOut { s: s, txn: txn, pc: pc, ok: 1, err: "", state: "", kind: 8, res: ex.res, id: ex.affected }
    }
    return boila_sql_fail(s, txn, pc, concat("неподдържана конструкция '", concat(t0.txt, "' (P5: SELECT, CREATE TABLE/INDEX, INSERT, UPDATE, DELETE, BEGIN/COMMIT/ROLLBACK)")), "0A000")
}
