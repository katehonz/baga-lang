// exec_sql.baga — SQL dispatch (P5): txn контрол, SELECT/EXPLAIN/WITH/
// TABLE, DDL/DML делегират на exec_sql_ddl / exec_sql_dml. DML/DDL през
// txn buffer; bare stmts auto-commit. Plan cache на single-table SELECT;
// DDL invalidates.

import "lexer.baga"
import "token.baga"
import "parse_select.baga"
import "parse_alter.baga"
import "parse_txn.baga"
import "parse_with.baga"
import "exec_alter.baga"
import "exec_scan.baga"
import "exec_out.baga"
import "exec_dual.baga"
import "exec_explain.baga"
import "exec_select.baga"
import "exec_knn.baga"
import "exec_with.baga"
import "exec_sql_ddl.baga"
import "exec_sql_dml.baga"
import "plan_cache.baga"
import "../catalog/schema.baga"
import "../storage/shards.baga"
import "../txn/mvcc.baga"
import "exec_drop.baga"
import "exec_show.baga"
import "std/str/str.baga"

// pc_mu=0 → unlocked (tests / single-thread). Serve passes per-db mutex.
// exec_sql.baga — SQL dispatch (P5). DML/DDL via txn buffer; bare stmts
// auto-commit. Plan cache on single-table SELECT; DDL invalidates.

import "lexer.baga"
import "token.baga"
import "parse_select.baga"
import "parse_ddl.baga"
import "parse_alter.baga"
import "parse_index.baga"
import "exec_alter.baga"
import "parse_dml.baga"
import "parse_insert.baga"
import "parse_txn.baga"
import "parse_with.baga"
import "exec_scan.baga"
import "exec_out.baga"
import "exec_dual.baga"
import "exec_explain.baga"
import "exec_select.baga"
import "exec_knn.baga"
import "exec_dml.baga"
import "exec_modify.baga"
import "exec_with.baga"
import "plan_cache.baga"
import "../fts/fts.baga"
import "../vector/hnsw.baga"
import "../vector/distance.baga"
import "../graph/adjacency.baga"
import "../ts/rollup.baga"
import "../catalog/schema.baga"
import "../storage/shards.baga"
import "../index/secondary.baga"
import "../txn/mvcc.baga"
import "exec_drop.baga"
import "exec_show.baga"
import "std/str/str.baga"

// pc_mu=0 → unlocked (tests / single-thread). Serve passes per-db mutex.
fn boila_exec_sql(s: BoilaStore, txn: BoilaTxn, db: str, sql: str, pc: BoilaPlanCache) -> BoilaSqlOut !IO !Time !Par {
    let guc: Map<str, str> = map_new()
    return boila_exec_sql_mu(s, txn, db, sql, pc, 0, guc)?
}

fn boila_exec_sql_guc(s: BoilaStore, txn: BoilaTxn, db: str, sql: str, pc: BoilaPlanCache, guc: Map<str, str>) -> BoilaSqlOut !IO !Time !Par {
    return boila_exec_sql_mu(s, txn, db, sql, pc, 0, guc)?
}

fn boila_exec_sql_mu(s: BoilaStore, txn: BoilaTxn, db: str, sql: str, pc: BoilaPlanCache, pc_mu: i64, guc: Map<str, str>) -> BoilaSqlOut !IO !Time !Par {
    let lx = boila_lex(sql)
    if lx.err != "" {
        return boila_sql_fail(s, txn, pc, lx.err, "42601")
    }
    let t0 = vec_get(lx.toks, 0)
    if t0.kind == tok_eof() {
        return boila_sql_fail(s, txn, pc, "празна заявка", "42601")
    }

    // --- транзакционен контрол ---
    if tok_kw(t0, "begin") == 1 || tok_kw(t0, "start") == 1 || tok_kw(t0, "commit") == 1 || tok_kw(t0, "end") == 1 || tok_kw(t0, "rollback") == 1 || tok_kw(t0, "abort") == 1 {
        let p = boila_parse_txn(lx)
        if p.ok == 0 {
            return boila_sql_fail(s, txn, pc, p.err, p.state)
        }
        if p.op == 1 {
            let b = boila_txn_begin(s, txn, p.read_only, db)?
            if b.ok == 0 {
                return boila_sql_fail(b.s, b.txn, pc, b.err, b.state)
            }
            return BoilaSqlOut { s: b.s, txn: b.txn, pc: pc, ok: 1, err: "", state: "", kind: 10, res: boila_result_empty(), id: b.lsn }
        }
        if p.op == 2 {
            let c = boila_txn_commit(s, txn)?
            if c.ok == 0 {
                return boila_sql_fail(c.s, c.txn, pc, c.err, c.state)
            }
            return BoilaSqlOut { s: c.s, txn: c.txn, pc: pc, ok: 1, err: "", state: "", kind: 11, res: boila_result_empty(), id: c.lsn }
        }
        let t2 = boila_txn_rollback(txn)
        return BoilaSqlOut { s: s, txn: t2, pc: pc, ok: 1, err: "", state: "", kind: 12, res: boila_result_empty(), id: 0 }
    }

    if tok_kw(t0, "explain") == 1 {
        return boila_exec_explain(s, txn, pc, db, lx, guc, sql)?
    }
    if tok_kw(t0, "with") == 1 {
        let p = boila_parse_with(lx)
        if p.ok == 0 {
            return boila_sql_fail(s, txn, pc, p.err, p.state)
        }
        let ex = boila_exec_with(s, txn, p.w)?
        return BoilaSqlOut { s: ex.s, txn: ex.txn, pc: pc, ok: ex.ok, err: ex.err, state: ex.state, kind: 16, res: ex.res, id: vec_len(ex.res.rows) }
    }
    // PG: TABLE name … ≡ SELECT * FROM name …
    if tok_kw(t0, "table") == 1 {
        let sql2 = boila_table_stmt_to_select(lx)
        if sql2 == "" {
            return boila_sql_fail(s, txn, pc, "очаквах име на таблица след TABLE", "42601")
        }
        return boila_exec_sql_mu(s, txn, db, sql2, pc, pc_mu, guc)?
    }
    if tok_kw(t0, "select") == 1 || tok_kw(t0, "values") == 1 {
        let du = boila_try_exec_dual(s, txn, pc, db, lx, guc)?
        if du.hit == 1 { return du.out }
        if tok_kw(t0, "values") == 1 {
            return boila_sql_fail(s, txn, pc, "невалиден VALUES", "42601")
        }
        let hit = boila_pc_get_mu(pc, sql, pc_mu)?
        if hit.hit == 1 {
            // MEM-4: кеширан е само sel (persist регион); таблицата се
            // resolve-ва прясно от каталога всяка заявка (ephemeral).
            let cth = boila_cat_by_name_txn(s, txn, hit.plan.sel.table)?
            s = cth.s
            if cth.ok == 0 { return boila_sql_fail(s, txn, pc, cth.err, cth.state) }
            let ex = boila_exec_select(s, txn, cth.table, hit.plan.sel)?
            return BoilaSqlOut { s: ex.s, txn: ex.txn, pc: pc, ok: ex.ok, err: ex.err, state: ex.state, kind: 1, res: ex.res, id: 0 }
        }
        let ps = boila_parse_select(lx)
        if ps.ok == 0 { return boila_sql_fail(s, txn, pc, ps.err, ps.state) }
        let ct = boila_cat_by_name_txn(s, txn, ps.sel.table)?
        s = ct.s
        if ct.ok == 0 { return boila_sql_fail(s, txn, pc, ct.err, ct.state) }
        let sel = boila_knn_prep_sel(ct.table, ps.sel)
        // MEM-4: кешът преживява per-request rewind — кешираната копия е
        // re-parse + ключ в persist региона (чисти операции, без ?);
        // изпълнението на тази заявка ползва ephemeral копието (sel).
        mem_persist_begin()
        let lx2 = boila_lex(sql)
        let ps2 = boila_parse_select(lx2)
        if ps2.ok == 1 {
            let sel2 = boila_knn_prep_sel(ct.table, ps2.sel)
            boila_pc_put(pc, substr(sql, 0, len(sql)), BoilaSelPlan { sel: sel2, table: boila_cat_empty_table() })
        }
        mem_persist_end()
        let ex = boila_exec_select(s, txn, ct.table, sel)?
        return BoilaSqlOut { s: ex.s, txn: ex.txn, pc: pc, ok: ex.ok, err: ex.err, state: ex.state, kind: 1, res: ex.res, id: 0 }
    }
    if tok_kw(t0, "drop") == 1 {
        return boila_exec_drop(s, txn, db, lx, pc, pc_mu)?
    }
    if tok_kw(t0, "truncate") == 1 {
        return boila_exec_truncate(s, txn, db, lx, pc, pc_mu)?
    }
    if tok_kw(t0, "alter") == 1 {
        let p = boila_parse_alter(lx)
        if p.ok == 0 { return boila_sql_fail(s, txn, pc, p.err, p.state) }
        return boila_exec_alter(s, txn, db, p.alt, pc, pc_mu)?
    }
    if tok_kw(t0, "create") == 1 {
        return boila_exec_sql_ddl(s, txn, db, pc, pc_mu, lx)?
    }
    if tok_kw(t0, "insert") == 1 || tok_kw(t0, "update") == 1 || tok_kw(t0, "delete") == 1 {
        return boila_exec_sql_dml(s, txn, db, pc, pc_mu, lx)?
    }
    // W7 fallback (no session map — mt_exec path); server_exec intercepts first
    if tok_kw(t0, "set") == 1 { return boila_exec_set_ok(s, txn, pc) }
    if tok_kw(t0, "show") == 1 { return boila_exec_show(s, txn, pc, lx)? }
    if tok_kw(t0, "describe") == 1 || tok_kw(t0, "desc") == 1 {
        return boila_exec_describe(s, txn, pc, lx)?
    }
    if tok_kw(t0, "reset") == 1 { return boila_sql_ok(s, txn, pc, 20, boila_result_empty(), 0) }
    if tok_kw(t0, "discard") == 1 { return boila_sql_ok(s, txn, pc, 21, boila_result_empty(), 0) }
    return boila_sql_fail(s, txn, pc, concat("неподдържана конструкция '", concat(t0.txt, "'")), "0A000")
}
