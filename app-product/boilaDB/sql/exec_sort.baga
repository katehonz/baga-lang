// exec_sort.baga — ORDER BY (P5). multi-key; NULLS FIRST/LAST.
// ord_desc packed: bit0=DESC, bits1.. = nulls mode (0=PG default, 1=FIRST, 2=LAST).
// PG default: ASC → NULLS LAST, DESC → NULLS FIRST.

import "../core/value.baga"

fn boila_ord_is_desc(packed: i64) -> i64 {
    return packed & 1
}

// 1 = nulls first, 0 = nulls last
fn boila_ord_nulls_first(packed: i64) -> i64 {
    let nm = packed / 2
    if nm == 1 { return 1 }
    if nm == 2 { return 0 }
    // default: same as DESC bit (PG)
    return packed & 1
}

fn boila_cmp_vals_nf(a: BoilaVal, b: BoilaVal, nulls_first: i64) -> i64 {
    if a.tag == boila_v_null() && b.tag == boila_v_null() {
        return 0
    }
    if a.tag == boila_v_null() {
        if nulls_first == 1 { return 0 - 1 }
        return 1
    }
    if b.tag == boila_v_null() {
        if nulls_first == 1 { return 1 }
        return 0 - 1
    }
    return boila_val_cmp(a, b)
}

fn boila_cmp_vals(a: BoilaVal, b: BoilaVal) -> i64 {
    return boila_cmp_vals_nf(a, b, 0)
}

// Сравнение по ключове; DESC обръща само non-NULL cmp.
fn boila_cmp_rows(a: Vec<BoilaVal>, b: Vec<BoilaVal>, idxs: Vec<i64>, desc: Vec<i64>) -> i64 {
    let mut k: i64 = 0
    while k < vec_len(idxs) {
        let ix = vec_get(idxs, k)
        let pk = vec_get(desc, k)
        let mut av = BoilaVal { tag: 0, i: 0, b: bytes_new(0) }
        let mut bv = BoilaVal { tag: 0, i: 0, b: bytes_new(0) }
        if ix >= 0 && ix < vec_len(a) { av = vec_get(a, ix) }
        if ix >= 0 && ix < vec_len(b) { bv = vec_get(b, ix) }
        let nf = boila_ord_nulls_first(pk)
        // null vs non-null: respect NULLS FIRST/LAST only
        if av.tag == boila_v_null() || bv.tag == boila_v_null() {
            let c = boila_cmp_vals_nf(av, bv, nf)
            if c != 0 { return c }
        } else {
            let c = boila_val_cmp(av, bv)
            if c != 0 {
                if boila_ord_is_desc(pk) == 1 {
                    if c == 1 { return 0 - 1 }
                    return 1
                }
                return c
            }
        }
        k = k + 1
    }
    return 0
}

fn boila_sort_ins(rows: Vec<Vec<BoilaVal>>, lo: i64, hi: i64, idxs: Vec<i64>, desc: Vec<i64>) {
    let mut i = lo + 1
    while i <= hi {
        let key = vec_get(rows, i)
        let mut j = i - 1
        let mut moving = 1
        while moving == 1 {
            if j < lo {
                moving = 0
            } else {
                if boila_cmp_rows(vec_get(rows, j), key, idxs, desc) <= 0 {
                    moving = 0
                } else {
                    vec_set(rows, j + 1, vec_get(rows, j))
                    j = j - 1
                }
            }
        }
        vec_set(rows, j + 1, key)
        i = i + 1
    }
}

fn boila_sort_part(rows: Vec<Vec<BoilaVal>>, lo: i64, hi: i64, idxs: Vec<i64>, desc: Vec<i64>) -> i64 {
    let pivot = vec_get(rows, hi)
    let mut i = lo
    let mut j = lo
    while j < hi {
        if boila_cmp_rows(vec_get(rows, j), pivot, idxs, desc) <= 0 {
            let tmp = vec_get(rows, i)
            vec_set(rows, i, vec_get(rows, j))
            vec_set(rows, j, tmp)
            i = i + 1
        }
        j = j + 1
    }
    let tmp = vec_get(rows, i)
    vec_set(rows, i, vec_get(rows, hi))
    vec_set(rows, hi, tmp)
    return i
}

fn boila_sort_qs(rows: Vec<Vec<BoilaVal>>, lo: i64, hi: i64, idxs: Vec<i64>, desc: Vec<i64>) {
    if hi - lo < 16 {
        if lo < hi {
            boila_sort_ins(rows, lo, hi, idxs, desc)
        }
        return
    }
    if lo < hi {
        let p = boila_sort_part(rows, lo, hi, idxs, desc)
        boila_sort_qs(rows, lo, p - 1, idxs, desc)
        boila_sort_qs(rows, p + 1, hi, idxs, desc)
    }
}

// in-place сортиране; idxs/desc са успоредни вектори с дължина ≥ 1.
fn boila_sort_rows(rows: Vec<Vec<BoilaVal>>, idxs: Vec<i64>, desc: Vec<i64>) {
    let n = vec_len(rows)
    if n > 1 {
        boila_sort_qs(rows, 0, n - 1, idxs, desc)
    }
}

// Q-join-topn: keep at most `need` best rows (sorted best-first by idxs/desc).
// cmp < 0 ⇒ a before b (better). Worst is last when full.
fn boila_topn_offer(rows: Vec<Vec<BoilaVal>>, row: Vec<BoilaVal>, idxs: Vec<i64>, desc: Vec<i64>, need: i64) {
    if need <= 0 {
        vec_push(rows, row)
        return
    }
    let n = vec_len(rows)
    if n < need {
        vec_push(rows, row)
        // bubble left into sorted place
        let mut i = n
        while i > 0 {
            if boila_cmp_rows(vec_get(rows, i), vec_get(rows, i - 1), idxs, desc) < 0 {
                let tmp = vec_get(rows, i)
                vec_set(rows, i, vec_get(rows, i - 1))
                vec_set(rows, i - 1, tmp)
                i = i - 1
            } else {
                i = 0
            }
        }
        return
    }
    // full: discard if not better than worst
    if boila_cmp_rows(row, vec_get(rows, n - 1), idxs, desc) >= 0 {
        return
    }
    vec_set(rows, n - 1, row)
    let mut i2 = n - 1
    while i2 > 0 {
        if boila_cmp_rows(vec_get(rows, i2), vec_get(rows, i2 - 1), idxs, desc) < 0 {
            let tmp = vec_get(rows, i2)
            vec_set(rows, i2, vec_get(rows, i2 - 1))
            vec_set(rows, i2 - 1, tmp)
            i2 = i2 - 1
        } else {
            i2 = 0
        }
    }
}

// K3: sort-order PK bytes (boila_val_enc) — in-place insertion sort.
fn boila_pk_sort_ins(pks: Vec<bytes>, lo: i64, hi: i64) {
    let mut i = lo + 1
    while i <= hi {
        let key = vec_get(pks, i)
        let mut j = i - 1
        let mut done = false
        while done == false && j >= lo {
            if boila_bytes_cmp(vec_get(pks, j), key) <= 0 {
                done = true
            } else {
                vec_set(pks, j + 1, vec_get(pks, j))
                j = j - 1
            }
        }
        vec_set(pks, j + 1, key)
        i = i + 1
    }
}

fn boila_pk_sort_part(pks: Vec<bytes>, lo: i64, hi: i64) -> i64 {
    // middle pivot — last-element pivot is O(n²) on already-sorted keys
    // (prefix scans return sorted full keys since K3h)
    let mid = lo + (hi - lo) / 2
    let t0 = vec_get(pks, mid)
    vec_set(pks, mid, vec_get(pks, hi))
    vec_set(pks, hi, t0)
    let piv = vec_get(pks, hi)
    let mut i = lo
    let mut j = lo
    while j < hi {
        if boila_bytes_cmp(vec_get(pks, j), piv) <= 0 {
            let t = vec_get(pks, i)
            vec_set(pks, i, vec_get(pks, j))
            vec_set(pks, j, t)
            i = i + 1
        }
        j = j + 1
    }
    let t = vec_get(pks, i)
    vec_set(pks, i, vec_get(pks, hi))
    vec_set(pks, hi, t)
    return i
}

fn boila_pk_sort_qs(pks: Vec<bytes>, lo: i64, hi: i64) {
    if hi - lo < 16 {
        if lo < hi {
            boila_pk_sort_ins(pks, lo, hi)
        }
        return
    }
    if lo < hi {
        let p = boila_pk_sort_part(pks, lo, hi)
        boila_pk_sort_qs(pks, lo, p - 1)
        boila_pk_sort_qs(pks, p + 1, hi)
    }
}

fn boila_pk_sort(pks: Vec<bytes>) {
    let n = vec_len(pks)
    if n > 1 {
        boila_pk_sort_qs(pks, 0, n - 1)
    }
}

// first index i where pks[i] >= target; n if all < target (sorted pks).
fn boila_pk_lb(pks: Vec<bytes>, target: bytes) -> i64 {
    let mut lo: i64 = 0
    let mut hi = vec_len(pks)
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if boila_bytes_cmp(vec_get(pks, mid), target) < 0 {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo
}
