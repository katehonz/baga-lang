// lexer.baga — BoilaSQL токенизър (P1 подмножество).
//
// Идентификаторите се fold-ват до lowercase (PostgreSQL поведение за
// не-quoted идентификатори). Ключовите думи остават ident-и — parser-ът
// ги разпознава по текст. '' е escape за единична кавичка в стринг.

import "token.baga"
import "std/str/str.baga"

struct BoilaLex {
    toks: Vec<Token>,
    err: str
}

fn boila_is_alpha(c: i64) -> i64 {
    if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 {
        return 1
    }
    return 0
}

fn boila_is_digit(c: i64) -> i64 {
    if c >= 48 && c <= 57 {
        return 1
    }
    return 0
}

fn boila_is_alnum(c: i64) -> i64 {
    if boila_is_alpha(c) == 1 || boila_is_digit(c) == 1 {
        return 1
    }
    return 0
}

// ASCII fold към lowercase (PG folding за unquoted identifiers).
fn boila_lower_char(c: i64) -> i64 {
    if c >= 65 && c <= 90 {
        return c + 32
    }
    return c
}

fn boila_substr(s: str, lo: i64, hi: i64) -> str {
    let mut out = ""
    let mut i = lo
    while i < hi {
        out = concat(out, chr(char_at(s, i)))
        i = i + 1
    }
    return out
}

fn boila_fold_lower(s: str) -> str {
    let mut out = ""
    let mut i: i64 = 0
    while i < len(s) {
        out = concat(out, chr(boila_lower_char(char_at(s, i))))
        i = i + 1
    }
    return out
}

fn boila_lex(src: str) -> BoilaLex {
    let toks: Vec<Token> = vec_new()
    let n = len(src)
    let mut i: i64 = 0
    while i < n {
        let c = char_at(src, i)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            i = i + 1
        } else {
            if boila_is_alpha(c) == 1 {
                let st = i
                while i < n && boila_is_alnum(char_at(src, i)) > 0 {
                    i = i + 1
                }
                vec_push(toks, token_new(tok_ident(), boila_fold_lower(boila_substr(src, st, i))))
            } else {
                if boila_is_digit(c) == 1 || (c == 45 && i + 1 < n && boila_is_digit(char_at(src, i + 1)) == 1) {
                    let st = i
                    if c == 45 {
                        i = i + 1
                    }
                    while i < n && boila_is_digit(char_at(src, i)) == 1 {
                        i = i + 1
                    }
                    vec_push(toks, token_new(tok_num(), boila_substr(src, st, i)))
                } else {
                    if c == 39 {
                        // bytes акумулатор — chr() ре-енкодира байтове ≥ 0x80
                        // като UTF-8 codepoints и би счупил кирилица/UTF-8.
                        let mut buf = bytes_new(0)
                        i = i + 1
                        let mut closed = false
                        while i < n && closed == false {
                            let ch = char_at(src, i)
                            if ch == 39 {
                                if i + 1 < n && char_at(src, i + 1) == 39 {
                                    buf = bytes_push(buf, 39)
                                    i = i + 2
                                } else {
                                    closed = true
                                    i = i + 1
                                }
                            } else {
                                if ch == 0 {
                                    return BoilaLex { toks: toks, err: "NUL байт в стринг литерал" }
                                }
                                buf = bytes_push(buf, ch & 255)
                                i = i + 1
                            }
                        }
                        if closed == false {
                            return BoilaLex { toks: toks, err: "незатворен стринг литерал" }
                        }
                        vec_push(toks, token_new(tok_str(), str_of_bytes(buf)))
                    } else {
                        if c == 61 {
                            vec_push(toks, token_new(tok_op(), "="))
                            i = i + 1
                        } else {
                            if c == 60 {
                                if i + 1 < n && char_at(src, i + 1) == 61 {
                                    vec_push(toks, token_new(tok_op(), "<="))
                                    i = i + 2
                                } else {
                                    if i + 1 < n && char_at(src, i + 1) == 62 {
                                        vec_push(toks, token_new(tok_op(), "<>"))
                                        i = i + 2
                                    } else {
                                        vec_push(toks, token_new(tok_op(), "<"))
                                        i = i + 1
                                    }
                                }
                            } else {
                                if c == 62 {
                                    if i + 1 < n && char_at(src, i + 1) == 61 {
                                        vec_push(toks, token_new(tok_op(), ">="))
                                        i = i + 2
                                    } else {
                                        vec_push(toks, token_new(tok_op(), ">"))
                                        i = i + 1
                                    }
                                } else {
                                    if c == 40 {
                                        vec_push(toks, token_new(tok_lparen(), "("))
                                        i = i + 1
                                    } else {
                                        if c == 41 {
                                            vec_push(toks, token_new(tok_rparen(), ")"))
                                            i = i + 1
                                        } else {
                                            if c == 44 {
                                                vec_push(toks, token_new(tok_comma(), ","))
                                                i = i + 1
                                            } else {
                                                if c == 42 {
                                                    vec_push(toks, token_new(tok_star(), "*"))
                                                    i = i + 1
                                                } else {
                                                    if c == 59 {
                                                        vec_push(toks, token_new(tok_semi(), ";"))
                                                        i = i + 1
                                                    } else {
                                                        if c == 64 && i + 1 < n && char_at(src, i + 1) == 64 {
                                                            vec_push(toks, token_new(tok_op(), "@@"))
                                                            i = i + 2
                                                        } else {
                                                            return BoilaLex { toks: toks, err: concat("непознат символ: ", chr(c)) }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    vec_push(toks, token_new(tok_eof(), ""))
    return BoilaLex { toks: toks, err: "" }
}
