// exec_knn.baga — kNN fetch: HNSW + V3 index pre-filter + V6 post-filter.

import "../storage/shards.baga"
import "../core/value.baga"
import "../core/row.baga"
import "../core/codec.baga"
import "../catalog/schema.baga"
import "../index/secondary.baga"
import "../vector/hnsw.baga"
import "../vector/hnsw_search.baga"
import "../vector/distance.baga"
import "../vector/hnsw_store.baga"
import "../txn/mvcc.baga"
import "ast.baga"
import "exec_scan.baga"
import "exec_buf.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

// V4e: pack kNN query into sel.knn_pay for plan cache warm path.
fn boila_knn_prep_sel(t: BoilaTable, sel: BoilaSel) -> BoilaSel {
    if sel.has_knn == 0 {
        return sel
    }
    let cix = boila_col_idx(t, sel.knn_col)
    if cix < 0 {
        return sel
    }
    let dim = boila_vec_dim_of(vec_get(t.cols, cix).typ)
    if dim <= 0 {
        return sel
    }
    let qp = boila_vec_parse(sel.knn_query, dim)
    if qp.ok == 0 {
        return sel
    }
    let mut out = sel
    out.knn_pay = qp.v.b
    return out
}

// V3/V3b: candidate pks from PK eq/range or secondary index eq.
// has=0 → no pre-filter; has=1 → use cands (may be empty = no hits).
struct BoilaKnnPref {
    s: BoilaStore,
    txn: BoilaTxn,
    ok: i64,
    err: str,
    state: str,
    has: i64,
    cands: Vec<bytes>
}

// Keep cands whose decoded PK is within [lo, hi] (sort-order cmp).
fn boila_knn_cands_in_range(cands: Vec<bytes>, has_lo: i64, lo: BoilaVal, has_hi: i64, hi: BoilaVal) -> Vec<bytes> {
    let out: Vec<bytes> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(cands) {
        let pk = vec_get(cands, i)
        let pkv = boila_val_dec(pk)
        let mut keep = true
        if has_lo == 1 {
            let c = boila_val_cmp(pkv, lo)
            if c != 0 && c != 1 {
                keep = false
            }
        }
        if keep && has_hi == 1 {
            let c = boila_val_cmp(pkv, hi)
            if c != 0 && c != 0 - 1 {
                keep = false
            }
        }
        if keep {
            vec_push(out, pk)
        }
        i = i + 1
    }
    return out
}

fn boila_knn_pref(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, sel: BoilaSel) -> BoilaKnnPref !IO !Time !Par {
    let mut cands: Vec<bytes> = vec_new()
    let mut has: i64 = 0
    let pkcol = vec_get(t.cols, t.pk_idx)
    if sel.has_eq == 1 {
        if sel.eq_col == pkcol.name {
            if boila_pk_lit_ok(pkcol.typ, sel.pk_eq) == 0 {
                return BoilaKnnPref { s: s, txn: txn, ok: 0, err: "литералът в = не съответства на типа на PRIMARY KEY", state: "42804", has: 0, cands: cands }
            }
            let pkenc = boila_val_enc(sel.pk_eq)
            let g = boila_txn_get(s, txn, t.id, pkenc)?
            s = g.s
            if g.found == 1 {
                vec_push(cands, pkenc)
            }
            has = 1
        } else {
            let cix = boila_col_idx(t, sel.eq_col)
            if cix < 0 {
                return BoilaKnnPref { s: s, txn: txn, ok: 0, err: concat("колона '", concat(sel.eq_col, "' не съществува")), state: "42703", has: 0, cands: cands }
            }
            let cd = vec_get(t.cols, cix)
            if boila_pk_lit_ok(cd.typ, sel.pk_eq) == 0 {
                return BoilaKnnPref { s: s, txn: txn, ok: 0, err: "литералът в = не съответства на типа на колоната", state: "42804", has: 0, cands: cands }
            }
            let ixid = boila_ix_by_col_t(t, cix)
            if ixid >= 0 {
                let lk = boila_ix_lookup(s, t, ixid, sel.pk_eq)?
                s = lk.s
                boila_scan_buf_eq(txn, t, cix, sel.pk_eq, lk.pks)
                cands = lk.pks
                has = 1
            }
            // unindexed meta eq → has=0 (HNSW + V6 post)
        }
    }
    // V3b: PK range pre-filter (or narrow eq cands)
    let pk_range = sel.has_lo == 1 || sel.has_hi == 1
    let mut lo_ok = 1
    let mut hi_ok = 1
    if sel.has_lo == 1 && sel.lo_col != pkcol.name {
        lo_ok = 0
    }
    if sel.has_hi == 1 && sel.hi_col != pkcol.name {
        hi_ok = 0
    }
    if pk_range && lo_ok == 1 && hi_ok == 1 {
        if has == 1 {
            cands = boila_knn_cands_in_range(cands, sel.has_lo, sel.pk_lo, sel.has_hi, sel.pk_hi)
        } else {
            let mut rsel = sel
            rsel.has_eq = 0
            rsel.has_knn = 0
            rsel.has_fts = 0
            let fr = boila_fetch_rows(s, txn, t, rsel)?
            s = fr.s
            txn = fr.txn
            if fr.ok == 0 {
                return BoilaKnnPref { s: s, txn: txn, ok: 0, err: fr.err, state: fr.state, has: 0, cands: cands }
            }
            let mut i: i64 = 0
            while i < vec_len(fr.rows) {
                let row = vec_get(fr.rows, i)
                if t.pk_idx >= 0 && t.pk_idx < vec_len(row) {
                    vec_push(cands, boila_val_enc(vec_get(row, t.pk_idx)))
                }
                i = i + 1
            }
            has = 1
        }
    }
    return BoilaKnnPref { s: s, txn: txn, ok: 1, err: "", state: "", has: has, cands: cands }
}

struct BoilaKnnHits {
    s: BoilaStore,
    txn: BoilaTxn,
    ok: i64,
    err: str,
    state: str,
    pks: Vec<bytes>
}

// Ranked candidate pks (post-filter applied at GET time by callers).
fn boila_knn_hit_pks(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, sel: BoilaSel) -> BoilaKnnHits !IO !Time !Par {
    let empty: Vec<bytes> = vec_new()
    let hl = hnsw_list_for_table(s, t.id)?
    s = hl.s
    let col_ix = boila_col_idx(t, sel.knn_col)
    if col_ix < 0 {
        return BoilaKnnHits { s: s, txn: txn, ok: 0, err: concat("колона '", concat(sel.knn_col, "' не съществува")), state: "42703", pks: empty }
    }
    let mut hdi: i64 = 0 - 1
    let mut k: i64 = 0
    while k < vec_len(hl.defs) {
        let d = vec_get(hl.defs, k)
        if d.col_idx == col_ix { hdi = k }
        k = k + 1
    }
    if hdi < 0 {
        return BoilaKnnHits { s: s, txn: txn, ok: 0, err: concat("колона '", concat(sel.knn_col, "' няма hnsw индекс")), state: "0A000", pks: empty }
    }
    let def = vec_get(hl.defs, hdi)
    let mut q_pay = sel.knn_pay
    let mut q_f: Vec<f64> = vec_new()
    if bytes_len(q_pay) < 4 {
        let qp = boila_vec_parse(sel.knn_query, def.dim)
        if qp.ok == 0 {
            return BoilaKnnHits { s: s, txn: txn, ok: 0, err: qp.err, state: "42601", pks: empty }
        }
        q_pay = qp.v.b
        if sel.knn_metric != boila_vec_metric_l2() {
            q_f = boila_vec_from_val(qp.v)
        }
    } else {
        if sel.knn_metric != boila_vec_metric_l2() {
            q_f = boila_vec_from_val(BoilaVal { tag: boila_v_vector(), i: def.dim, b: q_pay })
        }
    }
    let mut mdef = def
    mdef.metric = sel.knn_metric
    let mut kk = sel.limit
    if kk <= 0 { kk = 10 }
    let pref = boila_knn_pref(s, txn, t, sel)?
    s = pref.s
    txn = pref.txn
    if pref.ok == 0 {
        return BoilaKnnHits { s: s, txn: txn, ok: 0, err: pref.err, state: pref.state, pks: empty }
    }
    let mut hq_pks: Vec<bytes> = vec_new()
    if pref.has == 1 {
        if vec_len(q_f) == 0 {
            q_f = boila_vec_from_val(BoilaVal { tag: boila_v_vector(), i: def.dim, b: q_pay })
        }
        let hq = hnsw_brute_cands(s, txn, t, mdef, q_f, kk, pref.cands)?
        s = hq.s
        txn = hq.txn
        hq_pks = hq.pks
    } else {
        if sel.has_lo == 1 || sel.has_hi == 1 || sel.has_eq == 1 {
            kk = kk * 16
            if kk < 64 { kk = 64 }
        }
        let hq = hnsw_search_pay(s, txn, t, mdef, q_pay, q_f, kk)?
        s = hq.s
        txn = hq.txn
        hq_pks = hq.pks
    }
    return BoilaKnnHits { s: s, txn: txn, ok: 1, err: "", state: "", pks: hq_pks }
}

fn boila_fetch_knn(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, sel: BoilaSel) -> BoilaFetch !IO !Time !Par {
    let rows: Vec<Vec<BoilaVal>> = vec_new()
    let hits = boila_knn_hit_pks(s, txn, t, sel)?
    s = hits.s
    txn = hits.txn
    if hits.ok == 0 {
        return boila_fetch_fail(s, txn, hits.err, hits.state)
    }
    let mut qi: i64 = 0
    while qi < vec_len(hits.pks) {
        let g = boila_txn_get(s, txn, t.id, vec_get(hits.pks, qi))?
        s = g.s
        if g.found == 1 {
            let row = boila_row_dec(g.row)
            if boila_row_pass_filters(row, t, sel) == 1 {
                vec_push(rows, row)
            }
        }
        qi = qi + 1
    }
    return BoilaFetch { s: s, txn: txn, ok: 1, err: "", state: "", rows: rows }
}
