// exec_knn.baga — kNN fetch: HNSW + V3 index pre-filter + V6 post-filter.

import "../storage/shards.baga"
import "../core/value.baga"
import "../core/row.baga"
import "../core/codec.baga"
import "../catalog/schema.baga"
import "../index/secondary.baga"
import "../vector/hnsw.baga"
import "../vector/hnsw_search.baga"
import "../vector/distance.baga"
import "../vector/hnsw_store.baga"
import "../txn/mvcc.baga"
import "ast.baga"
import "exec_scan.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

// V3: collect candidate pks from PK point or secondary index eq.
// has=0 → no pre-filter; has=1 → use cands (may be empty = no hits).
struct BoilaKnnPref {
    s: BoilaStore,
    txn: BoilaTxn,
    ok: i64,
    err: str,
    state: str,
    has: i64,
    cands: Vec<bytes>
}

fn boila_knn_pref(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, sel: BoilaSel) -> BoilaKnnPref !IO !Time !Par {
    let cands: Vec<bytes> = vec_new()
    if sel.has_eq == 0 {
        return BoilaKnnPref { s: s, txn: txn, ok: 1, err: "", state: "", has: 0, cands: cands }
    }
    let pkcol = vec_get(t.cols, t.pk_idx)
    if sel.eq_col == pkcol.name {
        if boila_pk_lit_ok(pkcol.typ, sel.pk_eq) == 0 {
            return BoilaKnnPref { s: s, txn: txn, ok: 0, err: "литералът в = не съответства на типа на PRIMARY KEY", state: "42804", has: 0, cands: cands }
        }
        let pkenc = boila_val_enc(sel.pk_eq)
        let g = boila_txn_get(s, txn, t.id, pkenc)?
        s = g.s
        if g.found == 1 {
            vec_push(cands, pkenc)
        }
        return BoilaKnnPref { s: s, txn: txn, ok: 1, err: "", state: "", has: 1, cands: cands }
    }
    let cix = boila_col_idx(t, sel.eq_col)
    if cix < 0 {
        return BoilaKnnPref { s: s, txn: txn, ok: 0, err: concat("колона '", concat(sel.eq_col, "' не съществува")), state: "42703", has: 0, cands: cands }
    }
    let cd = vec_get(t.cols, cix)
    if boila_pk_lit_ok(cd.typ, sel.pk_eq) == 0 {
        return BoilaKnnPref { s: s, txn: txn, ok: 0, err: "литералът в = не съответства на типа на колоната", state: "42804", has: 0, cands: cands }
    }
    let ixid = boila_ix_by_col_t(t, cix)
    if ixid < 0 {
        // unindexed meta → HNSW + V6 post-filter
        return BoilaKnnPref { s: s, txn: txn, ok: 1, err: "", state: "", has: 0, cands: cands }
    }
    let lk = boila_ix_lookup(s, t, ixid, sel.pk_eq)?
    s = lk.s
    boila_scan_buf_eq(txn, t, cix, sel.pk_eq, lk.pks)
    return BoilaKnnPref { s: s, txn: txn, ok: 1, err: "", state: "", has: 1, cands: lk.pks }
}

fn boila_fetch_knn(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, sel: BoilaSel) -> BoilaFetch !IO !Time !Par {
    let rows: Vec<Vec<BoilaVal>> = vec_new()
    let hl = hnsw_list_for_table(s, t.id)?
    s = hl.s
    let col_ix = boila_col_idx(t, sel.knn_col)
    if col_ix < 0 {
        return boila_fetch_fail(s, txn, concat("колона '", concat(sel.knn_col, "' не съществува")), "42703")
    }
    let mut hdi: i64 = 0 - 1
    let mut k: i64 = 0
    while k < vec_len(hl.defs) {
        let d = vec_get(hl.defs, k)
        if d.col_idx == col_ix { hdi = k }
        k = k + 1
    }
    if hdi < 0 {
        return boila_fetch_fail(s, txn, concat("колона '", concat(sel.knn_col, "' няма hnsw индекс")), "0A000")
    }
    let def = vec_get(hl.defs, hdi)
    let qp = boila_vec_parse(sel.knn_query, def.dim)
    if qp.ok == 0 {
        return boila_fetch_fail(s, txn, qp.err, "42601")
    }
    let mut mdef = def
    mdef.metric = sel.knn_metric
    let mut kk = sel.limit
    if kk <= 0 { kk = 10 }
    let pref = boila_knn_pref(s, txn, t, sel)?
    s = pref.s
    txn = pref.txn
    if pref.ok == 0 {
        return boila_fetch_fail(s, txn, pref.err, pref.state)
    }
    let mut hq_pks: Vec<bytes> = vec_new()
    if pref.has == 1 {
        // V3: exact kNN only on index/pk candidates
        let hq = hnsw_brute_cands(s, txn, t, mdef, boila_vec_from_val(qp.v), kk, pref.cands)?
        s = hq.s
        txn = hq.txn
        hq_pks = hq.pks
    } else {
        // full HNSW; overfetch if residual filters (range)
        if sel.has_lo == 1 || sel.has_hi == 1 {
            kk = kk * 16
            if kk < 64 { kk = 64 }
        }
        let hq = hnsw_search(s, txn, t, mdef, boila_vec_from_val(qp.v), kk)?
        s = hq.s
        txn = hq.txn
        hq_pks = hq.pks
    }
    let mut qi: i64 = 0
    while qi < vec_len(hq_pks) {
        let g = boila_txn_get(s, txn, t.id, vec_get(hq_pks, qi))?
        s = g.s
        if g.found == 1 {
            let row = boila_row_dec(g.row)
            if boila_row_pass_filters(row, t, sel) == 1 {
                vec_push(rows, row)
            }
        }
        qi = qi + 1
    }
    return BoilaFetch { s: s, txn: txn, ok: 1, err: "", state: "", rows: rows }
}
