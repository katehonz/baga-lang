// parse_having.baga — HAVING with AND/OR precedence + parentheses (Q-havprec).
// Grammar:  or  := and (OR and)*
//           and := primary (AND primary)*
//           primary := '(' or ')' | agg_pred
// AND binds tighter than OR (PG). Leaves collected in order into preds.

import "token.baga"
import "lexer.baga"
import "ast.baga"
import "parse_common.baga"
import "../core/value.baga"
import "std/str/str.baga"

struct BoilaParseHav {
    ok: i64,
    preds: Vec<BoilaHavPred>,
    nodes: Vec<BoilaHavNode>,
    root: i64,
    pos: i64,
    err: str,
    state: str
}

fn boila_ph_fail(msg: str, state: str, pos: i64) -> BoilaParseHav {
    let p: Vec<BoilaHavPred> = vec_new()
    let n: Vec<BoilaHavNode> = vec_new()
    return BoilaParseHav { ok: 0, preds: p, nodes: n, root: 0 - 1, pos: pos, err: msg, state: state }
}

// Parse one leaf pred at i; append to preds/nodes; return root leaf index + pos.
struct BoilaPhLeaf {
    ok: i64,
    root: i64,
    preds: Vec<BoilaHavPred>,
    nodes: Vec<BoilaHavNode>,
    pos: i64,
    err: str,
    state: str
}

fn boila_ph_leaf_fail(msg: str, state: str, pos: i64, preds: Vec<BoilaHavPred>, nodes: Vec<BoilaHavNode>) -> BoilaPhLeaf {
    return BoilaPhLeaf { ok: 0, root: 0 - 1, preds: preds, nodes: nodes, pos: pos, err: msg, state: state }
}

fn boila_ph_one(l: BoilaLex, i: i64, preds: Vec<BoilaHavPred>, nodes: Vec<BoilaHavNode>) -> BoilaPhLeaf {
    let an = boila_ps_tok(l, i)
    let kind = boila_ps_agg_kind(an.txt)
    if an.kind != tok_ident() || kind == 0 {
        return boila_ph_leaf_fail("очаквах агрегат в HAVING", "42601", i, preds, nodes)
    }
    if boila_ps_tok(l, i + 1).kind != tok_lparen() {
        return boila_ph_leaf_fail("очаквах '(' след агрегата в HAVING", "42601", i, preds, nodes)
    }
    let arg = boila_ps_tok(l, i + 2)
    let mut hcol = ""
    let mut hkind = kind
    let mut hxt: Vec<Token> = vec_new()
    let mut p = i + 2
    if arg.kind == tok_star() {
        if kind != 1 {
            return boila_ph_leaf_fail("HAVING с * — само count", "0A000", i, preds, nodes)
        }
        p = i + 3
    } else {
        let nxt = boila_ps_tok(l, i + 3)
        if arg.kind == tok_ident() && nxt.kind == tok_rparen() {
            hcol = arg.txt
            if kind == 1 {
                hkind = 2
            }
            p = i + 3
        } else {
            let xe = boila_ps_expr_item(l, i + 2)
            if xe.ok == 0 {
                return boila_ph_leaf_fail(xe.err, xe.state, i, preds, nodes)
            }
            hxt = xe.item.xtoks
            if kind == 1 {
                hkind = 2
            }
            p = xe.pos
        }
    }
    if boila_ps_tok(l, p).kind != tok_rparen() {
        return boila_ph_leaf_fail("очаквах ')' в HAVING агрегата", "42601", p, preds, nodes)
    }
    p = p + 1
    let op = boila_ps_tok(l, p)
    if op.kind != tok_op() {
        return boila_ph_leaf_fail("очаквах оператор в HAVING", "42601", p, preds, nodes)
    }
    let hv = boila_ps_literal(l, p + 1)
    if hv.ok == 0 {
        return boila_ph_leaf_fail(hv.err, hv.state, p + 1, preds, nodes)
    }
    if hv.v.tag != boila_v_i64() {
        return boila_ph_leaf_fail("HAVING стойност — само цяло число", "0A000", p + 1, preds, nodes)
    }
    let pred = boila_hav_pred(hkind, hcol, hxt, op.txt, hv.v.i)
    let leaf_ix = vec_len(preds)
    vec_push(preds, pred)
    let node_ix = vec_len(nodes)
    vec_push(nodes, boila_hav_leaf(leaf_ix))
    return BoilaPhLeaf { ok: 1, root: node_ix, preds: preds, nodes: nodes, pos: p + 2, err: "", state: "" }
}

// primary := '(' or_expr ')' | pred
fn boila_ph_primary(l: BoilaLex, i: i64, preds: Vec<BoilaHavPred>, nodes: Vec<BoilaHavNode>) -> BoilaPhLeaf {
    if boila_ps_tok(l, i).kind == tok_lparen() {
        let inner = boila_ph_or(l, i + 1, preds, nodes)
        if inner.ok == 0 {
            return inner
        }
        if boila_ps_tok(l, inner.pos).kind != tok_rparen() {
            return boila_ph_leaf_fail("очаквах ')' в HAVING", "42601", inner.pos, inner.preds, inner.nodes)
        }
        return BoilaPhLeaf { ok: 1, root: inner.root, preds: inner.preds, nodes: inner.nodes, pos: inner.pos + 1, err: "", state: "" }
    }
    return boila_ph_one(l, i, preds, nodes)
}

// and := primary (AND primary)*
fn boila_ph_and(l: BoilaLex, i: i64, preds: Vec<BoilaHavPred>, nodes: Vec<BoilaHavNode>) -> BoilaPhLeaf {
    let mut cur = boila_ph_primary(l, i, preds, nodes)
    if cur.ok == 0 {
        return cur
    }
    let mut more = true
    while more {
        if tok_kw(boila_ps_tok(l, cur.pos), "and") == 1 {
            let r = boila_ph_primary(l, cur.pos + 1, cur.preds, cur.nodes)
            if r.ok == 0 {
                return r
            }
            let node_ix = vec_len(r.nodes)
            vec_push(r.nodes, boila_hav_bin(1, cur.root, r.root))
            cur = BoilaPhLeaf { ok: 1, root: node_ix, preds: r.preds, nodes: r.nodes, pos: r.pos, err: "", state: "" }
        } else {
            more = false
        }
    }
    return cur
}

// or := and (OR and)*
fn boila_ph_or(l: BoilaLex, i: i64, preds: Vec<BoilaHavPred>, nodes: Vec<BoilaHavNode>) -> BoilaPhLeaf {
    let mut cur = boila_ph_and(l, i, preds, nodes)
    if cur.ok == 0 {
        return cur
    }
    let mut more = true
    while more {
        if tok_kw(boila_ps_tok(l, cur.pos), "or") == 1 {
            let r = boila_ph_and(l, cur.pos + 1, cur.preds, cur.nodes)
            if r.ok == 0 {
                return r
            }
            let node_ix = vec_len(r.nodes)
            vec_push(r.nodes, boila_hav_bin(2, cur.root, r.root))
            cur = BoilaPhLeaf { ok: 1, root: node_ix, preds: r.preds, nodes: r.nodes, pos: r.pos, err: "", state: "" }
        } else {
            more = false
        }
    }
    return cur
}

// HAVING … — i is first token after HAVING keyword.
fn boila_parse_having(l: BoilaLex, i: i64) -> BoilaParseHav {
    let preds0: Vec<BoilaHavPred> = vec_new()
    let nodes0: Vec<BoilaHavNode> = vec_new()
    let r = boila_ph_or(l, i, preds0, nodes0)
    if r.ok == 0 {
        return BoilaParseHav { ok: 0, preds: r.preds, nodes: r.nodes, root: 0 - 1, pos: r.pos, err: r.err, state: r.state }
    }
    return BoilaParseHav { ok: 1, preds: r.preds, nodes: r.nodes, root: r.root, pos: r.pos, err: "", state: "" }
}
