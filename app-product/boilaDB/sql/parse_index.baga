// parse_index.baga — CREATE INDEX / FTS INDEX / USING hnsw / ROLLUP (P3/P7/P8/K3j).

import "token.baga"
import "lexer.baga"
import "ast.baga"
import "parse_ddl.baga"
import "../vector/distance.baga"
import "../ts/time_bucket.baga"
import "std/str/str.baga"

struct BoilaParseRu {
    ok: i64,
    name: str,
    table: str,
    ts_col: str,
    iv_sec: i64,
    sum_col: str,   // "" = count only
    if_not_exists: i64,
    err: str,
    state: str
}

fn boila_pru_fail(msg: str, state: str) -> BoilaParseRu {
    return BoilaParseRu {
        ok: 0, name: "", table: "", ts_col: "", iv_sec: 0, sum_col: "",
        if_not_exists: 0, err: msg, state: state
    }
}

// CREATE ROLLUP [IF NOT EXISTS] name ON table USING time_bucket('1m', col) [SUM(col)]
fn boila_parse_create_rollup(l: BoilaLex) -> BoilaParseRu {
    let mut i: i64 = 2
    let mut ifne: i64 = 0
    let sk = boila_parse_if_not_exists(l, i)
    if sk > 0 { ifne = 1; i = i + sk }
    let nm = boila_pc_tok(l, i)
    if nm.kind != tok_ident() {
        return boila_pru_fail("очаквах име след CREATE ROLLUP", "42601")
    }
    i = i + 1
    if tok_kw(boila_pc_tok(l, i), "on") != 1 {
        return boila_pru_fail("очаквах ON след името на rollup", "42601")
    }
    let tb = boila_pc_tok(l, i + 1)
    if tb.kind != tok_ident() {
        return boila_pru_fail("очаквах таблица след ON", "42601")
    }
    i = i + 2
    if tok_kw(boila_pc_tok(l, i), "using") != 1 {
        return boila_pru_fail("очаквах USING time_bucket(...)", "42601")
    }
    i = i + 1
    let tbk = boila_pc_tok(l, i)
    if tbk.kind != tok_ident() || tbk.txt != "time_bucket" {
        return boila_pru_fail("очаквах time_bucket след USING", "42601")
    }
    if boila_pc_tok(l, i + 1).kind != tok_lparen() {
        return boila_pru_fail("очаквах '(' след time_bucket", "42601")
    }
    let ivt = boila_pc_tok(l, i + 2)
    if ivt.kind != tok_str() {
        return boila_pru_fail("очаквах интервал-стринг в time_bucket", "42601")
    }
    let iv = boila_tb_parse_iv(ivt.txt)
    if iv.ok == 0 {
        return boila_pru_fail(iv.err, iv.state)
    }
    if boila_pc_tok(l, i + 3).kind != tok_comma() {
        return boila_pru_fail("очаквах ',' в time_bucket", "42601")
    }
    let col = boila_pc_tok(l, i + 4)
    if col.kind != tok_ident() {
        return boila_pru_fail("очаквах колона в time_bucket", "42601")
    }
    if boila_pc_tok(l, i + 5).kind != tok_rparen() {
        return boila_pru_fail("очаквах ')' в time_bucket", "42601")
    }
    i = i + 6
    let mut sum_col = ""
    if tok_kw(boila_pc_tok(l, i), "sum") == 1 || (boila_pc_tok(l, i).kind == tok_ident() && boila_pc_tok(l, i).txt == "sum") {
        if boila_pc_tok(l, i + 1).kind != tok_lparen() {
            return boila_pru_fail("очаквах '(' след SUM", "42601")
        }
        let sc = boila_pc_tok(l, i + 2)
        if sc.kind != tok_ident() {
            return boila_pru_fail("очаквах колона в SUM", "42601")
        }
        if boila_pc_tok(l, i + 3).kind != tok_rparen() {
            return boila_pru_fail("очаквах ')' след SUM колона", "42601")
        }
        sum_col = sc.txt
        i = i + 4
    }
    if boila_pc_tok(l, i).kind == tok_semi() { i = i + 1 }
    if boila_pc_tok(l, i).kind != tok_eof() {
        return boila_pru_fail(concat("неочакван токен '", concat(boila_pc_tok(l, i).txt, "' след CREATE ROLLUP")), "0A000")
    }
    return BoilaParseRu {
        ok: 1, name: nm.txt, table: tb.txt, ts_col: col.txt, iv_sec: iv.sec,
        sum_col: sum_col, if_not_exists: ifne, err: "", state: ""
    }
}

struct BoilaParseIx {
    ok: i64,
    ix: BoilaIxDef,
    err: str,
    state: str
}

fn boila_pix_fail(msg: str, state: str) -> BoilaParseIx {
    return BoilaParseIx { ok: 0, ix: BoilaIxDef { ix_name: "", table: "", col: "" }, err: msg, state: state }
}

struct BoilaParseFts {
    ok: i64,
    ix: BoilaIxDef,
    if_not_exists: i64,
    err: str,
    state: str
}

fn boila_pfts_fail(msg: str, state: str) -> BoilaParseFts {
    return BoilaParseFts { ok: 0, ix: BoilaIxDef { ix_name: "", table: "", col: "" }, if_not_exists: 0, err: msg, state: state }
}

fn boila_parse_if_not_exists(l: BoilaLex, i: i64) -> i64 {
    // returns 3 if IF NOT EXISTS at i, else 0
    if tok_kw(boila_pc_tok(l, i), "if") == 1 && tok_kw(boila_pc_tok(l, i + 1), "not") == 1 && tok_kw(boila_pc_tok(l, i + 2), "exists") == 1 {
        return 3
    }
    return 0
}

fn boila_parse_create_fts(l: BoilaLex) -> BoilaParseFts {
    if tok_kw(boila_pc_tok(l, 2), "index") != 1 {
        return boila_pfts_fail("очаквах INDEX след CREATE FTS", "42601")
    }
    let mut i: i64 = 3
    let mut ifne: i64 = 0
    let sk = boila_parse_if_not_exists(l, i)
    if sk > 0 { ifne = 1; i = i + sk }
    let nm = boila_pc_tok(l, i)
    if nm.kind != tok_ident() {
        return boila_pfts_fail("очаквах име на fts индекс", "42601")
    }
    i = i + 1
    if tok_kw(boila_pc_tok(l, i), "on") != 1 {
        return boila_pfts_fail("очаквах ON след името на fts индекса", "42601")
    }
    let tb = boila_pc_tok(l, i + 1)
    if tb.kind != tok_ident() {
        return boila_pfts_fail("очаквах таблица след ON", "42601")
    }
    if boila_pc_tok(l, i + 2).kind != tok_lparen() {
        return boila_pfts_fail("очаквах '(' след таблицата", "42601")
    }
    let col = boila_pc_tok(l, i + 3)
    if col.kind != tok_ident() {
        return boila_pfts_fail("очаквах колона в CREATE FTS INDEX", "42601")
    }
    if boila_pc_tok(l, i + 4).kind != tok_rparen() {
        return boila_pfts_fail("P7: fts индекс върху една колона", "0A000")
    }
    i = i + 5
    if boila_pc_tok(l, i).kind == tok_semi() { i = i + 1 }
    if boila_pc_tok(l, i).kind != tok_eof() {
        return boila_pfts_fail(concat("неочакван токен '", concat(boila_pc_tok(l, i).txt, "' след CREATE FTS INDEX")), "0A000")
    }
    return BoilaParseFts { ok: 1, ix: BoilaIxDef { ix_name: nm.txt, table: tb.txt, col: col.txt }, if_not_exists: ifne, err: "", state: "" }
}

struct BoilaParseIx2 {
    ok: i64,
    ix: BoilaIxDef,
    kind: i64,
    metric: i64,
    if_not_exists: i64,
    err: str,
    state: str
}

fn boila_pix2_fail(msg: str, state: str) -> BoilaParseIx2 {
    return BoilaParseIx2 { ok: 0, ix: BoilaIxDef { ix_name: "", table: "", col: "" }, kind: 0, metric: 0, if_not_exists: 0, err: msg, state: state }
}

fn boila_parse_create_ix(l: BoilaLex) -> BoilaParseIx {
    let p = boila_parse_create_ix2(l)
    if p.ok == 0 {
        return BoilaParseIx { ok: 0, ix: p.ix, err: p.err, state: p.state }
    }
    if p.kind != 0 {
        return BoilaParseIx { ok: 0, ix: p.ix, err: "ползвай boila_parse_create_ix2 за HNSW", state: "XX000" }
    }
    return BoilaParseIx { ok: 1, ix: p.ix, err: "", state: "" }
}

fn boila_parse_create_ix2(l: BoilaLex) -> BoilaParseIx2 {
    let mut i: i64 = 2
    let mut ifne: i64 = 0
    let sk = boila_parse_if_not_exists(l, i)
    if sk > 0 { ifne = 1; i = i + sk }
    let nm = boila_pc_tok(l, i)
    if nm.kind != tok_ident() {
        return boila_pix2_fail("очаквах име на индекс след CREATE INDEX", "42601")
    }
    i = i + 1
    if tok_kw(boila_pc_tok(l, i), "on") != 1 {
        return boila_pix2_fail("очаквах ON след името на индекса", "42601")
    }
    let tb = boila_pc_tok(l, i + 1)
    if tb.kind != tok_ident() {
        return boila_pix2_fail("очаквах име на таблица след ON", "42601")
    }
    i = i + 2
    let mut kind: i64 = 0
    let mut metric: i64 = boila_vec_metric_l2()
    if tok_kw(boila_pc_tok(l, i), "using") == 1 {
        let am = boila_pc_tok(l, i + 1)
        if am.kind != tok_ident() || am.txt != "hnsw" {
            return boila_pix2_fail("P8: USING поддържа само hnsw", "0A000")
        }
        kind = 1
        i = i + 2
    }
    if boila_pc_tok(l, i).kind != tok_lparen() {
        return boila_pix2_fail("очаквах '(' след таблицата/USING", "42601")
    }
    let col = boila_pc_tok(l, i + 1)
    if col.kind != tok_ident() {
        return boila_pix2_fail("очаквах колона в CREATE INDEX", "42601")
    }
    if boila_pc_tok(l, i + 2).kind != tok_rparen() {
        return boila_pix2_fail("индекс върху една колона", "0A000")
    }
    i = i + 3
    if boila_pc_tok(l, i).kind == tok_semi() { i = i + 1 }
    if boila_pc_tok(l, i).kind != tok_eof() {
        return boila_pix2_fail(concat("неочакван токен '", concat(boila_pc_tok(l, i).txt, "' след CREATE INDEX")), "0A000")
    }
    return BoilaParseIx2 {
        ok: 1,
        ix: BoilaIxDef { ix_name: nm.txt, table: tb.txt, col: col.txt },
        kind: kind, metric: metric, if_not_exists: ifne, err: "", state: ""
    }
}

struct BoilaParseDropIx {
    ok: i64,
    ix_name: str,
    table: str,
    if_exists: i64,
    err: str,
    state: str
}

fn boila_pdix_fail(msg: str, state: str) -> BoilaParseDropIx {
    return BoilaParseDropIx { ok: 0, ix_name: "", table: "", if_exists: 0, err: msg, state: state }
}

// DROP {INDEX|GRAPH} [IF EXISTS] name ON table [;]
fn boila_parse_drop_on(l: BoilaLex, kind: str) -> BoilaParseDropIx {
    if tok_kw(boila_pc_tok(l, 0), "drop") != 1 || tok_kw(boila_pc_tok(l, 1), kind) != 1 {
        return boila_pdix_fail(concat("очаквах DROP ", kind), "42601")
    }
    let mut i: i64 = 2
    let mut if_ex: i64 = 0
    if tok_kw(boila_pc_tok(l, i), "if") == 1 {
        if tok_kw(boila_pc_tok(l, i + 1), "exists") != 1 {
            return boila_pdix_fail("очаквах EXISTS след IF", "42601")
        }
        if_ex = 1
        i = i + 2
    }
    let nm = boila_pc_tok(l, i)
    if nm.kind != tok_ident() {
        return boila_pdix_fail("очаквах име", "42601")
    }
    i = i + 1
    if tok_kw(boila_pc_tok(l, i), "on") != 1 {
        return boila_pdix_fail("очаквах ON table", "42601")
    }
    let tb = boila_pc_tok(l, i + 1)
    if tb.kind != tok_ident() {
        return boila_pdix_fail("очаквах таблица след ON", "42601")
    }
    i = i + 2
    if boila_pc_tok(l, i).kind == tok_semi() { i = i + 1 }
    if boila_pc_tok(l, i).kind != tok_eof() {
        return boila_pdix_fail(concat("неочакван токен '", concat(boila_pc_tok(l, i).txt, "'")), "42601")
    }
    return BoilaParseDropIx { ok: 1, ix_name: nm.txt, table: tb.txt, if_exists: if_ex, err: "", state: "" }
}

fn boila_parse_drop_index(l: BoilaLex) -> BoilaParseDropIx {
    return boila_parse_drop_on(l, "index")
}

fn boila_parse_drop_graph(l: BoilaLex) -> BoilaParseDropIx {
    return boila_parse_drop_on(l, "graph")
}
