// exec_agg_hav.baga — Q-havx / Q-havand: HAVING slots + multi-pred eval.

import "../core/value.baga"
import "../catalog/schema.baga"
import "ast.baga"
import "token.baga"
import "exec_scan.baga"
import "exec_agg_extra.baga"
import "exec_xw.baga"
import "exec_dual_ops.baga"
import "std/str/str.baga"

// Token-span equality (HAVING expr-agg ↔ projection match).
fn boila_xtoks_eq(a: Vec<Token>, b: Vec<Token>) -> i64 {
    if vec_len(a) != vec_len(b) {
        return 0
    }
    let mut i: i64 = 0
    while i < vec_len(a) {
        let ta = vec_get(a, i)
        let tb = vec_get(b, i)
        if ta.kind != tb.kind || ta.txt != tb.txt {
            return 0
        }
        i = i + 1
    }
    return 1
}

struct BoilaHavVal {
    ok: i64,
    v: i64
}

fn boila_hav_pass(op: str, hv: i64, want: i64) -> i64 {
    if op == "=" && hv == want { return 1 }
    if op == ">=" && hv >= want { return 1 }
    if op == "<=" && hv <= want { return 1 }
    if op == ">" && hv > want { return 1 }
    if op == "<" && hv < want { return 1 }
    if op == "<>" && hv != want { return 1 }
    if op == "!=" && hv != want { return 1 }
    return 0
}

fn boila_hav_slot_val(acc: BoilaAggAcc, hkind: i64, hix: i64) -> BoilaHavVal {
    if hkind == 1 {
        return BoilaHavVal { ok: 1, v: acc.n }
    }
    if hkind == 2 {
        return BoilaHavVal { ok: 1, v: vec_get(acc.cnt, hix) }
    }
    if vec_get(acc.hasv, hix) == 0 {
        return BoilaHavVal { ok: 0, v: 0 }
    }
    if hkind == 3 {
        return BoilaHavVal { ok: 1, v: vec_get(acc.sum, hix) }
    }
    if hkind == 4 {
        let c = vec_get(acc.cnt, hix)
        if c == 0 {
            return BoilaHavVal { ok: 0, v: 0 }
        }
        return BoilaHavVal { ok: 1, v: vec_get(acc.sum, hix) / c }
    }
    if hkind == 5 {
        return BoilaHavVal { ok: 1, v: vec_get(acc.minv, hix).i }
    }
    return BoilaHavVal { ok: 1, v: vec_get(acc.maxv, hix).i }
}

struct BoilaHavSetup {
    ok: i64,
    err: str,
    state: str,
    items: Vec<BoilaSelItem>,
    aixs: Vec<i64>,
    slots: Vec<i64>,
    n_proj: i64
}

fn boila_hav_setup(cols: Vec<BoilaColDef>, sel: BoilaSel, items0: Vec<BoilaSelItem>, aixs0: Vec<i64>) -> BoilaHavSetup {
    let n_proj = vec_len(items0)
    let mut items = items0
    let mut aixs = aixs0
    let slots: Vec<i64> = vec_new()
    if sel.has_having == 0 {
        return BoilaHavSetup { ok: 1, err: "", state: "", items: items, aixs: aixs, slots: slots, n_proj: n_proj }
    }
    let mut hi: i64 = 0
    while hi < vec_len(sel.hav_preds) {
        let hp = vec_get(sel.hav_preds, hi)
        let mut slot: i64 = 0 - 1
        // agg==0 → non-agg first-row expr (no accumulate slot)
        if hp.agg > 1 || (hp.agg == 2) {
            let mut a: i64 = 0
            while a < vec_len(items) {
                let it = vec_get(items, a)
                if it.agg == hp.agg {
                    if vec_len(hp.xtoks) > 0 {
                        if boila_xtoks_eq(it.xtoks, hp.xtoks) == 1 {
                            slot = a
                        }
                    } else {
                        if it.col == hp.col && vec_len(it.xtoks) == 0 {
                            slot = a
                        }
                    }
                }
                a = a + 1
            }
            if slot < 0 {
                if vec_len(hp.xtoks) > 0 {
                    vec_push(items, boila_sel_item_agg_x(hp.agg, hp.xtoks))
                    vec_push(aixs, 0 - 2)
                } else {
                    let ix = boila_col_idx_of(cols, hp.col)
                    if ix < 0 {
                        return BoilaHavSetup { ok: 0, err: concat("HAVING колона '", concat(hp.col, "' не съществува")), state: "42703", items: items, aixs: aixs, slots: slots, n_proj: n_proj }
                    }
                    if hp.agg == 3 || hp.agg == 4 {
                        let cd = vec_get(cols, ix)
                        if cd.typ != boila_v_i64() && cd.typ != boila_v_ts() {
                            return BoilaHavSetup { ok: 0, err: "HAVING sum/avg само върху BIGINT", state: "0A000", items: items, aixs: aixs, slots: slots, n_proj: n_proj }
                        }
                    }
                    vec_push(items, boila_sel_item_agg(hp.agg, hp.col))
                    vec_push(aixs, ix)
                }
                slot = vec_len(items) - 1
            }
        }
        // count(*) → slot -1; non-agg expr → slot -1 (leaf uses xtoks)
        vec_push(slots, slot)
        hi = hi + 1
    }
    return BoilaHavSetup { ok: 1, err: "", state: "", items: items, aixs: aixs, slots: slots, n_proj: n_proj }
}

struct BoilaHavEmit {
    ok: i64,
    err: str,
    state: str,
    emit: i64
}

// Evaluate one leaf predicate.
fn boila_hav_leaf_val(acc: BoilaAggAcc, sel: BoilaSel, slots: Vec<i64>, leaf: i64, cols: Vec<BoilaColDef>, brows: Vec<Vec<BoilaVal>>) -> BoilaHavEmit !Time {
    let hp = vec_get(sel.hav_preds, leaf)
    let slot = vec_get(slots, leaf)
    // Q-havxrow: non-agg expression on group first-row
    if hp.agg == 0 {
        if vec_len(acc.first) == 0 && vec_len(sel.group_cols) > 0 {
            return BoilaHavEmit { ok: 1, err: "", state: "", emit: 0 }
        }
        let names: Vec<str> = vec_new()
        let mut ci: i64 = 0
        while ci < vec_len(cols) {
            vec_push(names, vec_get(cols, ci).name)
            ci = ci + 1
        }
        // pad first row if empty (no-group zero rows)
        let mut row = acc.first
        if vec_len(row) == 0 {
            ci = 0
            while ci < vec_len(cols) {
                vec_push(row, boila_val_null())
                ci = ci + 1
            }
        }
        let ev = boila_xw_eval(names, hp.xtoks, row)?
        if ev.ok == 0 {
            return BoilaHavEmit { ok: 0, err: ev.err, state: ev.state, emit: 0 }
        }
        return BoilaHavEmit { ok: 1, err: "", state: "", emit: boila_dual_when_true(ev.val) }
    }
    if hp.agg == 1 {
        return BoilaHavEmit { ok: 1, err: "", state: "", emit: boila_hav_pass(hp.op, acc.n, hp.val) }
    }
    if slot < 0 {
        if vec_len(sel.group_cols) > 0 {
            return BoilaHavEmit { ok: 0, err: "HAVING агрегат извън проекцията", state: "0A000", emit: 0 }
        }
        if vec_len(hp.xtoks) > 0 {
            return BoilaHavEmit { ok: 0, err: "HAVING expr-agg без GROUP BY изисква проекция", state: "0A000", emit: 0 }
        }
        let ex = boila_agg_extra(cols, brows, hp.agg, hp.col)
        if ex.ok == 0 {
            return BoilaHavEmit { ok: 0, err: ex.err, state: ex.state, emit: 0 }
        }
        let mut one: i64 = 0
        if ex.has == 1 {
            one = boila_hav_pass(hp.op, ex.val, hp.val)
        }
        return BoilaHavEmit { ok: 1, err: "", state: "", emit: one }
    }
    let hv = boila_hav_slot_val(acc, hp.agg, slot)
    let mut one2: i64 = 0
    if hv.ok == 1 {
        one2 = boila_hav_pass(hp.op, hv.v, hp.val)
    }
    return BoilaHavEmit { ok: 1, err: "", state: "", emit: one2 }
}

// Tree walk: post-order via push-only stack (no vec_pop).
fn boila_hav_eval(acc: BoilaAggAcc, sel: BoilaSel, slots: Vec<i64>, cols: Vec<BoilaColDef>, brows: Vec<Vec<BoilaVal>>) -> BoilaHavEmit !Time {
    if sel.has_having == 0 {
        return BoilaHavEmit { ok: 1, err: "", state: "", emit: 1 }
    }
    if sel.hav_root < 0 || vec_len(sel.hav_nodes) == 0 {
        return BoilaHavEmit { ok: 1, err: "", state: "", emit: 1 }
    }
    let st: Vec<i64> = vec_new()
    let out: Vec<i64> = vec_new()
    vec_push(st, sel.hav_root)
    let mut sp: i64 = 1
    while sp > 0 {
        sp = sp - 1
        let n = vec_get(st, sp)
        vec_push(out, n)
        let node = vec_get(sel.hav_nodes, n)
        if node.kind != 0 {
            if node.a >= 0 {
                if sp < vec_len(st) {
                    vec_set(st, sp, node.a)
                } else {
                    vec_push(st, node.a)
                }
                sp = sp + 1
            }
            if node.b >= 0 {
                if sp < vec_len(st) {
                    vec_set(st, sp, node.b)
                } else {
                    vec_push(st, node.b)
                }
                sp = sp + 1
            }
        }
    }
    let vals: Vec<i64> = vec_new()
    let mut vi: i64 = 0
    while vi < vec_len(sel.hav_nodes) {
        vec_push(vals, 0)
        vi = vi + 1
    }
    let mut oi = vec_len(out) - 1
    while oi >= 0 {
        let n = vec_get(out, oi)
        let node = vec_get(sel.hav_nodes, n)
        if node.kind == 0 {
            let lv = boila_hav_leaf_val(acc, sel, slots, node.leaf, cols, brows)?
            if lv.ok == 0 {
                return lv
            }
            vec_set(vals, n, lv.emit)
        } else {
            let va = vec_get(vals, node.a)
            let vb = vec_get(vals, node.b)
            if node.kind == 1 {
                if va == 1 && vb == 1 {
                    vec_set(vals, n, 1)
                } else {
                    vec_set(vals, n, 0)
                }
            } else {
                if va == 1 || vb == 1 {
                    vec_set(vals, n, 1)
                } else {
                    vec_set(vals, n, 0)
                }
            }
        }
        oi = oi - 1
    }
    return BoilaHavEmit { ok: 1, err: "", state: "", emit: vec_get(vals, sel.hav_root) }
}
