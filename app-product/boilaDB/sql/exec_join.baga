// exec_join.baga — JOIN: index NL | hash | nested loop (A2 cost).
// WHERE eq/range: left pushdown; right post-filter (A3). ON '='.
// Q-stream-join: boila_join_into_fold streams matches into hash-agg (no wide Vec).

import "../storage/shards.baga"
import "../core/value.baga"
import "../core/row.baga"
import "../catalog/schema.baga"
import "../index/secondary.baga"
import "../txn/mvcc.baga"
import "ast.baga"
import "exec_scan.baga"
import "exec_buf.baga"
import "exec_sort.baga"
import "exec_agg_fold.baga"
import "exec_agg_feed.baga"
import "exec_xw.baga"
import "exec_dual_ops.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"
import "std/os/os.baga"

// A2c: outer rows ≤ this → nested loop (no ix); else hash. Default 8.
fn boila_join_nl_max() -> i64 !IO {
    let e = env("BOILA_JOIN_NL_MAX")
    if e == "" { return 8 }
    let n = parse_int(e)
    if n < 0 { return 8 }
    return n
}

// Emit kept wide row: top-N window, or plain push (+ optional LIMIT stop).
// Returns 1 if probe should stop (unordered / sorted-outer LIMIT full).
fn boila_join_emit(rows: Vec<Vec<BoilaVal>>, wide: Vec<BoilaVal>, need: i64, topn: i64, oidxs: Vec<i64>, odesc: Vec<i64>) -> i64 {
    if topn > 0 {
        boila_topn_offer(rows, wide, oidxs, odesc, topn)
        return 0
    }
    vec_push(rows, wide)
    if need > 0 && vec_len(rows) >= need {
        return 1
    }
    return 0
}

// Q-join-sorted-outer: sort outer pks by left ORDER BY keys (one GET each).
// idxs = column indices on left table; desc = sel.ord_desc.
fn boila_join_sort_outer_pks(s: BoilaStore, txn: BoilaTxn, table_id: i64, pks: Vec<bytes>, idxs: Vec<i64>, desc: Vec<i64>) -> BoilaPksOut !IO !Time !Par {
    let n = vec_len(pks)
    if n <= 1 {
        return BoilaPksOut { s: s, txn: txn, ok: 1, err: "", state: "", pks: pks }
    }
    // keyrows[i] = order-key projection of pks[i]
    let keyrows: Vec<Vec<BoilaVal>> = vec_new()
    let mut i: i64 = 0
    while i < n {
        let g = boila_txn_get(s, txn, table_id, vec_get(pks, i))?
        s = g.s
        let kr: Vec<BoilaVal> = vec_new()
        if g.found == 1 {
            let row = boila_row_dec(g.row)
            let mut k: i64 = 0
            while k < vec_len(idxs) {
                let ix = vec_get(idxs, k)
                if ix >= 0 && ix < vec_len(row) {
                    vec_push(kr, vec_get(row, ix))
                } else {
                    vec_push(kr, boila_val_null())
                }
                k = k + 1
            }
        } else {
            let mut k2: i64 = 0
            while k2 < vec_len(idxs) {
                vec_push(kr, boila_val_null())
                k2 = k2 + 1
            }
        }
        vec_push(keyrows, kr)
        i = i + 1
    }
    // identity column idxs for keyrows
    let kid: Vec<i64> = vec_new()
    let mut ki: i64 = 0
    while ki < vec_len(idxs) {
        vec_push(kid, ki)
        ki = ki + 1
    }
    // insertion sort pks + keyrows together
    i = 1
    while i < n {
        let pk = vec_get(pks, i)
        let kr = vec_get(keyrows, i)
        let mut j = i - 1
        let mut moving = 1
        while moving == 1 {
            if j < 0 {
                moving = 0
            } else {
                if boila_cmp_rows(vec_get(keyrows, j), kr, kid, desc) <= 0 {
                    moving = 0
                } else {
                    vec_set(pks, j + 1, vec_get(pks, j))
                    vec_set(keyrows, j + 1, vec_get(keyrows, j))
                    j = j - 1
                }
            }
        }
        vec_set(pks, j + 1, pk)
        vec_set(keyrows, j + 1, kr)
        i = i + 1
    }
    return BoilaPksOut { s: s, txn: txn, ok: 1, err: "", state: "", pks: pks }
}

struct BoilaJoinOut {
    s: BoilaStore,
    txn: BoilaTxn,
    ok: i64,
    err: str,
    state: str,
    cols: Vec<BoilaColDef>,
    rows: Vec<Vec<BoilaVal>>
}

// A2 / Q-join-inner-pks: hash join key → inner pks (not full rows).
struct BoilaHJBucket {
    pks: Vec<bytes>
}

fn boila_join_fail(s: BoilaStore, txn: BoilaTxn, msg: str, state: str) -> BoilaJoinOut {
    let cols: Vec<BoilaColDef> = vec_new()
    let rows: Vec<Vec<BoilaVal>> = vec_new()
    return BoilaJoinOut { s: s, txn: txn, ok: 0, err: msg, state: state, cols: cols, rows: rows }
}

fn boila_wide_row(l: Vec<BoilaVal>, r: Vec<BoilaVal>) -> Vec<BoilaVal> {
    let out: Vec<BoilaVal> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(l) {
        vec_push(out, vec_get(l, i))
        i = i + 1
    }
    i = 0
    while i < vec_len(r) {
        vec_push(out, vec_get(r, i))
        i = i + 1
    }
    return out
}

fn boila_null_row(ncols: i64) -> Vec<BoilaVal> {
    let out: Vec<BoilaVal> = vec_new()
    let mut i: i64 = 0
    while i < ncols {
        vec_push(out, boila_val_null())
        i = i + 1
    }
    return out
}

fn boila_join_filter_right(rows: Vec<Vec<BoilaVal>>, off: i64, cix: i64, val: BoilaVal) -> Vec<Vec<BoilaVal>> {
    let out: Vec<Vec<BoilaVal>> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(rows) {
        let row = vec_get(rows, i)
        let ix = off + cix
        if ix >= 0 && ix < vec_len(row) {
            if boila_val_eq_ix(vec_get(row, ix), val) == 1 {
                vec_push(out, row)
            }
        }
        i = i + 1
    }
    return out
}

// A3b: post-filter wide rows by >= lo and/or <= hi on column at off+cix.
fn boila_join_filter_range(rows: Vec<Vec<BoilaVal>>, off: i64, cix: i64, has_lo: i64, lo: BoilaVal, has_hi: i64, hi: BoilaVal) -> Vec<Vec<BoilaVal>> {
    let out: Vec<Vec<BoilaVal>> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(rows) {
        let row = vec_get(rows, i)
        let ix = off + cix
        let mut keep = true
        if ix < 0 || ix >= vec_len(row) {
            keep = false
        } else {
            let v = vec_get(row, ix)
            if v.tag == boila_v_null() {
                keep = false
            } else {
                if has_lo == 1 {
                    let c = boila_val_cmp(v, lo)
                    if c != 0 && c != 1 {
                        keep = false
                    }
                }
                if keep && has_hi == 1 {
                    let c = boila_val_cmp(v, hi)
                    if c != 0 && c != 0 - 1 {
                        keep = false
                    }
                }
            }
        }
        if keep {
            vec_push(out, row)
        }
        i = i + 1
    }
    return out
}

// Q-join-inner-pks: build hash join key → inner pks (GET once, drop row).
struct BoilaHJBuild {
    s: BoilaStore,
    txn: BoilaTxn,
    ht: Map<bytes, BoilaHJBucket>
}

fn boila_hj_build_pks(s: BoilaStore, txn: BoilaTxn, t2: BoilaTable, ridx: i64) -> BoilaHJBuild !IO !Time !Par {
    let m: Map<bytes, BoilaHJBucket> = map_new()
    let empty_sel = boila_sel_empty()
    let ip = boila_fetch_pks(s, txn, t2, empty_sel)?
    s = ip.s
    txn = ip.txn
    let mut i: i64 = 0
    while i < vec_len(ip.pks) {
        let pk = vec_get(ip.pks, i)
        let g = boila_txn_get(s, txn, t2.id, pk)?
        s = g.s
        if g.found == 1 {
            let row = boila_row_dec(g.row)
            if ridx >= 0 && ridx < vec_len(row) {
                let v = vec_get(row, ridx)
                if v.tag != boila_v_null() {
                    let k = boila_val_enc(v)
                    if map_has(m, k) == 1 {
                        let b = map_get(m, k)
                        vec_push(b.pks, pk)
                        map_set(m, k, b)
                    } else {
                        let bp: Vec<bytes> = vec_new()
                        vec_push(bp, pk)
                        map_set(m, k, BoilaHJBucket { pks: bp })
                    }
                }
            }
        }
        i = i + 1
    }
    return BoilaHJBuild { s: s, txn: txn, ht: m }
}

// A3c: all ON pairs match (lrow left table, rrow right table).
fn boila_join_eq_all(lrow: Vec<BoilaVal>, rrow: Vec<BoilaVal>, lixs: Vec<i64>, rixs: Vec<i64>) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(lixs) {
        let li = vec_get(lixs, i)
        let ri = vec_get(rixs, i)
        if li < 0 || li >= vec_len(lrow) || ri < 0 || ri >= vec_len(rrow) {
            return 0
        }
        if boila_val_cmp(vec_get(lrow, li), vec_get(rrow, ri)) != 0 {
            return 0
        }
        i = i + 1
    }
    return 1
}

fn boila_join_rows(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, sel: BoilaSel) -> BoilaJoinOut !IO !Time !Par {
    // resolve ON pairs (A3c multi-eq); fallback to singular join_lcol/rcol
    let mut lnames = sel.join_lcols
    let mut rnames = sel.join_rcols
    if vec_len(lnames) == 0 {
        vec_push(lnames, sel.join_lcol)
        vec_push(rnames, sel.join_rcol)
    }
    let lixs: Vec<i64> = vec_new()
    let rixs: Vec<i64> = vec_new()
    let mut pi: i64 = 0
    while pi < vec_len(lnames) {
        let ln = vec_get(lnames, pi)
        let rn = vec_get(rnames, pi)
        let li = boila_col_idx(t, ln)
        if li < 0 {
            return boila_join_fail(s, txn, concat("JOIN колона '", concat(ln, "' не съществува в лявата таблица")), "42703")
        }
        vec_push(lixs, li)
        pi = pi + 1
    }
    let ct2 = boila_cat_by_name_txn(s, txn, sel.join_table)?
    s = ct2.s
    if ct2.ok == 0 {
        return boila_join_fail(s, txn, ct2.err, ct2.state)
    }
    let t2 = ct2.table
    pi = 0
    while pi < vec_len(rnames) {
        let rn = vec_get(rnames, pi)
        let ri = boila_col_idx(t2, rn)
        if ri < 0 {
            return boila_join_fail(s, txn, concat("JOIN колона '", concat(rn, "' не съществува в дясната таблица")), "42703")
        }
        vec_push(rixs, ri)
        pi = pi + 1
    }
    let lidx = vec_get(lixs, 0)
    let ridx = vec_get(rixs, 0)
    let mut left_sel = sel
    let mut r_eq: i64 = 0
    let mut r_cix: i64 = 0 - 1
    let mut r_val = boila_val_null()
    let mut r_lo: i64 = 0
    let mut r_lo_cix: i64 = 0 - 1
    let mut r_hi: i64 = 0
    let mut r_hi_cix: i64 = 0 - 1
    if sel.has_eq == 1 {
        let on_l = boila_col_idx(t, sel.eq_col)
        let on_r = boila_col_idx(t2, sel.eq_col)
        if on_l >= 0 {
            r_eq = 0
        } else {
            if on_r >= 0 {
                left_sel.has_eq = 0
                r_eq = 1
                r_cix = on_r
                r_val = sel.pk_eq
            } else {
                return boila_join_fail(s, txn, concat("WHERE колона '", concat(sel.eq_col, "' не е в JOIN таблиците")), "42703")
            }
        }
    }
    // A3b: range on right → post-filter; strip from left fetch
    if sel.has_lo == 1 {
        let on_l = boila_col_idx(t, sel.lo_col)
        let on_r = boila_col_idx(t2, sel.lo_col)
        if on_l < 0 {
            if on_r < 0 {
                return boila_join_fail(s, txn, concat("WHERE колона '", concat(sel.lo_col, "' не е в JOIN таблиците")), "42703")
            }
            left_sel.has_lo = 0
            r_lo = 1
            r_lo_cix = on_r
        }
    }
    if sel.has_hi == 1 {
        let on_l = boila_col_idx(t, sel.hi_col)
        let on_r = boila_col_idx(t2, sel.hi_col)
        if on_l < 0 {
            if on_r < 0 {
                return boila_join_fail(s, txn, concat("WHERE колона '", concat(sel.hi_col, "' не е в JOIN таблиците")), "42703")
            }
            left_sel.has_hi = 0
            r_hi = 1
            r_hi_cix = on_r
        }
    }
    let wcols: Vec<BoilaColDef> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(t.cols) {
        vec_push(wcols, vec_get(t.cols, i))
        i = i + 1
    }
    i = 0
    while i < vec_len(t2.cols) {
        vec_push(wcols, vec_get(t2.cols, i))
        i = i + 1
    }
    // Outer: pks first (stream GET during probe) — Q-stream-join-outer
    let mut op = boila_fetch_pks(s, txn, t, left_sel)?
    s = op.s
    txn = op.txn
    if op.ok == 0 {
        return boila_join_fail(s, txn, op.err, op.state)
    }
    let mut rows: Vec<Vec<BoilaVal>> = vec_new()
    let nullr = boila_null_row(vec_len(t2.cols))
    if vec_len(op.pks) == 0 {
        return BoilaJoinOut { s: s, txn: txn, ok: 1, err: "", state: "", cols: wcols, rows: rows }
    }
    let loff = vec_len(t.cols)
    if r_lo == 1 && r_hi == 1 && r_lo_cix != r_hi_cix {
        return boila_join_fail(s, txn, "range WHERE на JOIN — lo/hi трябва да са една дясна колона", "0A000")
    }
    // Q-join-limit: stop probe when enough kept rows (no ORDER/DISTINCT/xw).
    let mut need: i64 = 0
    if sel.limit > 0 && sel.has_order == 0 && sel.distinct == 0 && sel.has_xw == 0 {
        need = sel.offset + sel.limit
        if need < 1 { need = sel.limit }
    }
    // Q-join-topn / Q-join-sorted-outer for ORDER BY + LIMIT
    let mut topn: i64 = 0
    let oidxs: Vec<i64> = vec_new()
    if sel.limit > 0 && sel.has_order == 1 && sel.distinct == 0 && sel.has_xw == 0 {
        let mut left_only: i64 = 1
        let lidxs: Vec<i64> = vec_new()
        let mut oi: i64 = 0
        while oi < vec_len(sel.ord_cols) {
            let nm = vec_get(sel.ord_cols, oi)
            let lx = boila_col_idx(t, nm)
            if lx < 0 {
                left_only = 0
            } else {
                vec_push(lidxs, lx)
            }
            let wx = boila_col_idx_of(wcols, nm)
            if wx < 0 {
                left_only = 0
            }
            vec_push(oidxs, wx)
            oi = oi + 1
        }
        if left_only == 1 && vec_len(lidxs) == vec_len(sel.ord_cols) && vec_len(lidxs) > 0 {
            // Sort outer by ORDER BY left keys → stream in order → early-stop
            let so = boila_join_sort_outer_pks(s, txn, t.id, op.pks, lidxs, sel.ord_desc)?
            s = so.s
            txn = so.txn
            op.pks = so.pks
            need = sel.offset + sel.limit
            if need < 1 { need = sel.limit }
            topn = 0
        } else {
            // Mixed/right ORDER BY: full probe + top-N heap
            let mut ok_ord = 1
            oi = 0
            while oi < vec_len(oidxs) {
                if vec_get(oidxs, oi) < 0 { ok_ord = 0 }
                oi = oi + 1
            }
            if ok_ord == 1 && vec_len(oidxs) > 0 {
                topn = sel.offset + sel.limit
                if topn < 1 { topn = sel.limit }
            }
        }
    }
    let on = vec_len(op.pks)
    let ixid = boila_ix_by_col_t(t2, ridx)
    if ixid >= 0 {
        // index nested loop on first ON pair; filter remaining pairs
        let mut oi: i64 = 0
        let mut done = false
        while oi < on && done == false {
            let g0 = boila_txn_get(s, txn, t.id, vec_get(op.pks, oi))?
            s = g0.s
            if g0.found == 1 {
                let orow = boila_row_dec(g0.row)
                let lv = vec_get(orow, lidx)
                let mut matched = false
                if lv.tag != boila_v_null() {
                    let lk = boila_ix_lookup(s, t2, ixid, lv)?
                    s = lk.s
                    let mut li: i64 = 0
                    while li < vec_len(lk.pks) && done == false {
                        let g = boila_txn_get(s, txn, t2.id, vec_get(lk.pks, li))?
                        s = g.s
                        if g.found == 1 {
                            let irow = boila_row_dec(g.row)
                            if boila_join_eq_all(orow, irow, lixs, rixs) == 1 {
                                matched = true
                                let wide = boila_wide_row(orow, irow)
                                if boila_join_wide_keep(wide, loff, r_eq, r_cix, r_val, r_lo, r_lo_cix, r_hi, r_hi_cix, sel.pk_lo, sel.pk_hi) == 1 {
                                    if boila_join_emit(rows, wide, need, topn, oidxs, sel.ord_desc) == 1 {
                                        done = true
                                    }
                                }
                            }
                        }
                        li = li + 1
                    }
                }
                if done == false && matched == false && sel.join_kind == 2 {
                    let wide = boila_wide_row(orow, nullr)
                    if boila_join_wide_keep(wide, loff, r_eq, r_cix, r_val, r_lo, r_lo_cix, r_hi, r_hi_cix, sel.pk_lo, sel.pk_hi) == 1 {
                        if boila_join_emit(rows, wide, need, topn, oidxs, sel.ord_desc) == 1 {
                            done = true
                        }
                    }
                }
            }
            oi = oi + 1
        }
    } else {
        // Q-join-inner-pks: hash key→pks (no full inner row Vec)
        let hb = boila_hj_build_pks(s, txn, t2, ridx)?
        s = hb.s
        txn = hb.txn
        let ht = hb.ht
        let mut oi: i64 = 0
        let mut done = false
        while oi < on && done == false {
            let g0 = boila_txn_get(s, txn, t.id, vec_get(op.pks, oi))?
            s = g0.s
            if g0.found == 1 {
                let orow = boila_row_dec(g0.row)
                let lv = vec_get(orow, lidx)
                let mut matched = false
                if lv.tag != boila_v_null() {
                    let k = boila_val_enc(lv)
                    if map_has(ht, k) == 1 {
                        let b = map_get(ht, k)
                        let mut j: i64 = 0
                        while j < vec_len(b.pks) && done == false {
                            let g = boila_txn_get(s, txn, t2.id, vec_get(b.pks, j))?
                            s = g.s
                            if g.found == 1 {
                                let irow = boila_row_dec(g.row)
                                if boila_join_eq_all(orow, irow, lixs, rixs) == 1 {
                                    matched = true
                                    let wide = boila_wide_row(orow, irow)
                                    if boila_join_wide_keep(wide, loff, r_eq, r_cix, r_val, r_lo, r_lo_cix, r_hi, r_hi_cix, sel.pk_lo, sel.pk_hi) == 1 {
                                        if boila_join_emit(rows, wide, need, topn, oidxs, sel.ord_desc) == 1 {
                                            done = true
                                        }
                                    }
                                }
                            }
                            j = j + 1
                        }
                    }
                }
                if done == false && matched == false && sel.join_kind == 2 {
                    let wide = boila_wide_row(orow, nullr)
                    if boila_join_wide_keep(wide, loff, r_eq, r_cix, r_val, r_lo, r_lo_cix, r_hi, r_hi_cix, sel.pk_lo, sel.pk_hi) == 1 {
                        if boila_join_emit(rows, wide, need, topn, oidxs, sel.ord_desc) == 1 {
                            done = true
                        }
                    }
                }
            }
            oi = oi + 1
        }
    }
    // right WHERE already applied via wide_keep during probe
    return BoilaJoinOut { s: s, txn: txn, ok: 1, err: "", state: "", cols: wcols, rows: rows }
}

// Feed one join match into fold (optional xw on wide row).
fn boila_join_fold_match(st: BoilaAggFold, sel: BoilaSel, xnames: Vec<str>, wide: Vec<BoilaVal>) -> BoilaAggFold !Time {
    if sel.has_xw == 1 {
        let e = boila_xw_eval(xnames, sel.xw_toks, wide)?
        if e.ok == 0 {
            st.ok = 0
            st.err = e.err
            st.state = e.state
            return st
        }
        if boila_dual_when_true(e.val) == 0 {
            return st
        }
    }
    return boila_agg_fold_row(st, sel, wide)?
}

// Right-side filters on a wide row (same rules as join post-filter).
fn boila_join_wide_keep(wide: Vec<BoilaVal>, loff: i64, r_eq: i64, r_cix: i64, r_val: BoilaVal, r_lo: i64, r_lo_cix: i64, r_hi: i64, r_hi_cix: i64, pk_lo: BoilaVal, pk_hi: BoilaVal) -> i64 {
    if r_eq == 1 {
        let ix = loff + r_cix
        if ix < 0 || ix >= vec_len(wide) { return 0 }
        if boila_val_eq_ix(vec_get(wide, ix), r_val) == 0 { return 0 }
    }
    if r_lo == 1 || r_hi == 1 {
        let mut cix = r_lo_cix
        if r_lo == 0 { cix = r_hi_cix }
        if r_lo == 1 && r_hi == 1 && r_lo_cix != r_hi_cix { return 0 }
        let ix = loff + cix
        if ix < 0 || ix >= vec_len(wide) { return 0 }
        let v = vec_get(wide, ix)
        if v.tag == boila_v_null() { return 0 }
        if r_lo == 1 {
            let c = boila_val_cmp(v, pk_lo)
            if c != 0 && c != 1 { return 0 }
        }
        if r_hi == 1 {
            let c = boila_val_cmp(v, pk_hi)
            if c != 0 && c != 0 - 1 { return 0 }
        }
    }
    return 1
}

struct BoilaJoinFoldOut {
    s: BoilaStore,
    txn: BoilaTxn,
    ok: i64,
    err: str,
    state: str,
    res: BoilaResult
}

fn boila_join_fold_fail(s: BoilaStore, txn: BoilaTxn, msg: str, state: str) -> BoilaJoinFoldOut {
    return BoilaJoinFoldOut { s: s, txn: txn, ok: 0, err: msg, state: state, res: boila_result_empty() }
}

// Q-stream-join: same join plans as boila_join_rows, but each match is
// folded immediately (no materialize of join output rows).
fn boila_join_into_fold(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, sel: BoilaSel) -> BoilaJoinFoldOut !IO !Time !Par {
    let mut lnames = sel.join_lcols
    let mut rnames = sel.join_rcols
    if vec_len(lnames) == 0 {
        vec_push(lnames, sel.join_lcol)
        vec_push(rnames, sel.join_rcol)
    }
    let lixs: Vec<i64> = vec_new()
    let rixs: Vec<i64> = vec_new()
    let mut pi: i64 = 0
    while pi < vec_len(lnames) {
        let ln = vec_get(lnames, pi)
        let li = boila_col_idx(t, ln)
        if li < 0 {
            return boila_join_fold_fail(s, txn, concat("JOIN колона '", concat(ln, "' не съществува в лявата таблица")), "42703")
        }
        vec_push(lixs, li)
        pi = pi + 1
    }
    let ct2 = boila_cat_by_name_txn(s, txn, sel.join_table)?
    s = ct2.s
    if ct2.ok == 0 {
        return boila_join_fold_fail(s, txn, ct2.err, ct2.state)
    }
    let t2 = ct2.table
    pi = 0
    while pi < vec_len(rnames) {
        let rn = vec_get(rnames, pi)
        let ri = boila_col_idx(t2, rn)
        if ri < 0 {
            return boila_join_fold_fail(s, txn, concat("JOIN колона '", concat(rn, "' не съществува в дясната таблица")), "42703")
        }
        vec_push(rixs, ri)
        pi = pi + 1
    }
    let lidx = vec_get(lixs, 0)
    let ridx = vec_get(rixs, 0)
    let mut left_sel = sel
    let mut r_eq: i64 = 0
    let mut r_cix: i64 = 0 - 1
    let mut r_val = boila_val_null()
    let mut r_lo: i64 = 0
    let mut r_lo_cix: i64 = 0 - 1
    let mut r_hi: i64 = 0
    let mut r_hi_cix: i64 = 0 - 1
    if sel.has_eq == 1 {
        let on_l = boila_col_idx(t, sel.eq_col)
        let on_r = boila_col_idx(t2, sel.eq_col)
        if on_l < 0 {
            if on_r >= 0 {
                left_sel.has_eq = 0
                r_eq = 1
                r_cix = on_r
                r_val = sel.pk_eq
            } else {
                return boila_join_fold_fail(s, txn, concat("WHERE колона '", concat(sel.eq_col, "' не е в JOIN таблиците")), "42703")
            }
        }
    }
    if sel.has_lo == 1 {
        let on_l = boila_col_idx(t, sel.lo_col)
        let on_r = boila_col_idx(t2, sel.lo_col)
        if on_l < 0 {
            if on_r < 0 {
                return boila_join_fold_fail(s, txn, concat("WHERE колона '", concat(sel.lo_col, "' не е в JOIN таблиците")), "42703")
            }
            left_sel.has_lo = 0
            r_lo = 1
            r_lo_cix = on_r
        }
    }
    if sel.has_hi == 1 {
        let on_l = boila_col_idx(t, sel.hi_col)
        let on_r = boila_col_idx(t2, sel.hi_col)
        if on_l < 0 {
            if on_r < 0 {
                return boila_join_fold_fail(s, txn, concat("WHERE колона '", concat(sel.hi_col, "' не е в JOIN таблиците")), "42703")
            }
            left_sel.has_hi = 0
            r_hi = 1
            r_hi_cix = on_r
        }
    }
    if r_lo == 1 && r_hi == 1 && r_lo_cix != r_hi_cix {
        return boila_join_fold_fail(s, txn, "range WHERE на JOIN — lo/hi трябва да са една дясна колона", "0A000")
    }
    let wcols: Vec<BoilaColDef> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(t.cols) {
        vec_push(wcols, vec_get(t.cols, i))
        i = i + 1
    }
    i = 0
    while i < vec_len(t2.cols) {
        vec_push(wcols, vec_get(t2.cols, i))
        i = i + 1
    }
    let loff = vec_len(t.cols)
    let mut st = boila_agg_fold_start(wcols, sel)?
    if st.ok == 0 {
        return boila_join_fold_fail(s, txn, st.err, st.state)
    }
    let xnames: Vec<str> = vec_new()
    i = 0
    while i < vec_len(wcols) {
        vec_push(xnames, vec_get(wcols, i).name)
        i = i + 1
    }
    // Q-stream-join-outer: pks only (GET one outer row at a time during probe)
    let op = boila_fetch_pks(s, txn, t, left_sel)?
    s = op.s
    txn = op.txn
    if op.ok == 0 {
        return boila_join_fold_fail(s, txn, op.err, op.state)
    }
    let nullr = boila_null_row(vec_len(t2.cols))
    let on = vec_len(op.pks)
    if on == 0 {
        let ag0 = boila_agg_fold_end(st, sel)?
        if ag0.ok == 0 {
            return boila_join_fold_fail(s, txn, ag0.err, ag0.state)
        }
        return BoilaJoinFoldOut { s: s, txn: txn, ok: 1, err: "", state: "", res: ag0.res }
    }
    let ixid = boila_ix_by_col_t(t2, ridx)

    if ixid >= 0 {
        // index nested loop — stream outer
        let mut oi: i64 = 0
        while oi < on {
            let g0 = boila_txn_get(s, txn, t.id, vec_get(op.pks, oi))?
            s = g0.s
            if g0.found == 1 {
                let orow = boila_row_dec(g0.row)
                let lv = vec_get(orow, lidx)
                let mut matched = false
                if lv.tag != boila_v_null() {
                    let lk = boila_ix_lookup(s, t2, ixid, lv)?
                    s = lk.s
                    let mut li: i64 = 0
                    while li < vec_len(lk.pks) {
                        let g = boila_txn_get(s, txn, t2.id, vec_get(lk.pks, li))?
                        s = g.s
                        if g.found == 1 {
                            let irow = boila_row_dec(g.row)
                            if boila_join_eq_all(orow, irow, lixs, rixs) == 1 {
                                let wide = boila_wide_row(orow, irow)
                                if boila_join_wide_keep(wide, loff, r_eq, r_cix, r_val, r_lo, r_lo_cix, r_hi, r_hi_cix, sel.pk_lo, sel.pk_hi) == 1 {
                                    st = boila_join_fold_match(st, sel, xnames, wide)?
                                    if st.ok == 0 {
                                        return boila_join_fold_fail(s, txn, st.err, st.state)
                                    }
                                }
                                matched = true
                            }
                        }
                        li = li + 1
                    }
                }
                if matched == false && sel.join_kind == 2 {
                    let wide = boila_wide_row(orow, nullr)
                    if boila_join_wide_keep(wide, loff, r_eq, r_cix, r_val, r_lo, r_lo_cix, r_hi, r_hi_cix, sel.pk_lo, sel.pk_hi) == 1 {
                        st = boila_join_fold_match(st, sel, xnames, wide)?
                        if st.ok == 0 {
                            return boila_join_fold_fail(s, txn, st.err, st.state)
                        }
                    }
                }
            }
            oi = oi + 1
        }
    } else {
        // Q-join-inner-pks: hash key→pks, GET on probe
        let hb = boila_hj_build_pks(s, txn, t2, ridx)?
        s = hb.s
        txn = hb.txn
        let ht = hb.ht
        let mut oi: i64 = 0
        while oi < on {
            let g0 = boila_txn_get(s, txn, t.id, vec_get(op.pks, oi))?
            s = g0.s
            if g0.found == 1 {
                let orow = boila_row_dec(g0.row)
                let lv = vec_get(orow, lidx)
                let mut matched = false
                if lv.tag != boila_v_null() {
                    let k = boila_val_enc(lv)
                    if map_has(ht, k) == 1 {
                        let b = map_get(ht, k)
                        let mut j: i64 = 0
                        while j < vec_len(b.pks) {
                            let g = boila_txn_get(s, txn, t2.id, vec_get(b.pks, j))?
                            s = g.s
                            if g.found == 1 {
                                let irow = boila_row_dec(g.row)
                                if boila_join_eq_all(orow, irow, lixs, rixs) == 1 {
                                    let wide = boila_wide_row(orow, irow)
                                    if boila_join_wide_keep(wide, loff, r_eq, r_cix, r_val, r_lo, r_lo_cix, r_hi, r_hi_cix, sel.pk_lo, sel.pk_hi) == 1 {
                                        st = boila_join_fold_match(st, sel, xnames, wide)?
                                        if st.ok == 0 {
                                            return boila_join_fold_fail(s, txn, st.err, st.state)
                                        }
                                    }
                                    matched = true
                                }
                            }
                            j = j + 1
                        }
                    }
                }
                if matched == false && sel.join_kind == 2 {
                    let wide = boila_wide_row(orow, nullr)
                    if boila_join_wide_keep(wide, loff, r_eq, r_cix, r_val, r_lo, r_lo_cix, r_hi, r_hi_cix, sel.pk_lo, sel.pk_hi) == 1 {
                        st = boila_join_fold_match(st, sel, xnames, wide)?
                        if st.ok == 0 {
                            return boila_join_fold_fail(s, txn, st.err, st.state)
                        }
                    }
                }
            }
            oi = oi + 1
        }
    }
    let ag = boila_agg_fold_end(st, sel)?
    if ag.ok == 0 {
        return boila_join_fold_fail(s, txn, ag.err, ag.state)
    }
    return BoilaJoinFoldOut { s: s, txn: txn, ok: 1, err: "", state: "", res: ag.res }
}
