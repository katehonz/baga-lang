// parse_with.baga — WITH RECURSIVE BFS/DFS/Dijkstra (P10) + CREATE GRAPH.
// Mode: *_dfs/*_dij name suffix, or MODE BFS|DFS|DIJ[KSTRA] after CTE name.

import "token.baga"
import "lexer.baga"
import "ast.baga"
import "parse_common.baga"
import "../core/value.baga"
import "std/str/str.baga"

struct BoilaWith {
    cte: str,
    mode: i64,          // 1 bfs, 2 dfs, 3 dijkstra
    start: BoilaVal,
    edge_table: str,
    src_col: str,
    dst_col: str,
    max_depth: i64,
    graph_name: str     // "" = първи graph на edge_table
}

struct BoilaParseWith {
    ok: i64,
    w: BoilaWith,
    err: str,
    state: str
}

fn boila_with_empty() -> BoilaWith {
    return BoilaWith {
        cte: "", mode: 1, start: boila_val_null(),
        edge_table: "", src_col: "", dst_col: "",
        max_depth: 3, graph_name: ""
    }
}

fn boila_pw_fail(msg: str, state: str) -> BoilaParseWith {
    return BoilaParseWith { ok: 0, w: boila_with_empty(), err: msg, state: state }
}

fn boila_pw_tok(l: BoilaLex, i: i64) -> Token {
    return boila_ps_tok(l, i)
}

// mode от CTE име: *_dfs → 2, *_dij/*_dijkstra → 3, else 1
fn boila_with_mode(name: str) -> i64 {
    let n = len(name)
    if n >= 4 {
        if char_at(name, n - 4) == 95 && char_at(name, n - 3) == 100 && char_at(name, n - 2) == 102 && char_at(name, n - 1) == 115 {
            return 2
        }
    }
    if n >= 4 {
        if char_at(name, n - 4) == 95 && char_at(name, n - 3) == 100 && char_at(name, n - 2) == 105 && char_at(name, n - 1) == 106 {
            return 3
        }
    }
    return 1
}

// G4: MODE BFS|DFS|DIJ|DIJKSTRA → 1|2|3; 0 = unknown
fn boila_with_mode_kw(t: Token) -> i64 {
    if tok_kw(t, "bfs") == 1 { return 1 }
    if tok_kw(t, "dfs") == 1 { return 2 }
    if tok_kw(t, "dij") == 1 { return 3 }
    if tok_kw(t, "dijkstra") == 1 { return 3 }
    return 0
}

fn boila_parse_with(l: BoilaLex) -> BoilaParseWith {
    // WITH RECURSIVE ident [MODE bfs|dfs|dij] (node, depth) AS ( ... ) SELECT ... FROM cte
    if tok_kw(boila_pw_tok(l, 0), "with") != 1 {
        return boila_pw_fail("очаквах WITH", "42601")
    }
    if tok_kw(boila_pw_tok(l, 1), "recursive") != 1 {
        return boila_pw_fail("P10: само WITH RECURSIVE", "0A000")
    }
    let cn = boila_pw_tok(l, 2)
    if cn.kind != tok_ident() {
        return boila_pw_fail("очаквах CTE име", "42601")
    }
    let mut w = boila_with_empty()
    w.cte = cn.txt
    w.mode = boila_with_mode(cn.txt)
    let mut b: i64 = 3
    // G4: optional MODE keyword overrides name suffix
    if tok_kw(boila_pw_tok(l, b), "mode") == 1 {
        let mk = boila_with_mode_kw(boila_pw_tok(l, b + 1))
        if mk == 0 {
            return boila_pw_fail("MODE очаква BFS, DFS или DIJKSTRA/DIJ", "42601")
        }
        w.mode = mk
        b = b + 2
    }
    if boila_pw_tok(l, b).kind != tok_lparen() {
        return boila_pw_fail("очаквах '(' след CTE име", "42601")
    }
    // (node, depth) — exactly 2 cols
    let c0 = boila_pw_tok(l, b + 1)
    let c1 = boila_pw_tok(l, b + 3)
    if c0.kind != tok_ident() || boila_pw_tok(l, b + 2).kind != tok_comma() || c1.kind != tok_ident() {
        return boila_pw_fail("P10: CTE колони (node, depth)", "0A000")
    }
    if boila_pw_tok(l, b + 4).kind != tok_rparen() {
        return boila_pw_fail("очаквах ')' след CTE колони", "42601")
    }
    if tok_kw(boila_pw_tok(l, b + 5), "as") != 1 {
        return boila_pw_fail("очаквах AS", "42601")
    }
    if boila_pw_tok(l, b + 6).kind != tok_lparen() {
        return boila_pw_fail("очаквах '(' след AS", "42601")
    }
    // base: SELECT lit , 0
    if tok_kw(boila_pw_tok(l, b + 7), "select") != 1 {
        return boila_pw_fail("очаквах SELECT в base CTE", "42601")
    }
    let lit = boila_ps_literal(l, b + 8)
    if lit.ok == 0 {
        return boila_pw_fail(lit.err, lit.state)
    }
    w.start = lit.v
    if boila_pw_tok(l, b + 9).kind != tok_comma() {
        return boila_pw_fail("очаквах ',' след start lit", "42601")
    }
    let z = boila_pw_tok(l, b + 10)
    if z.kind != tok_num() || z.txt != "0" {
        return boila_pw_fail("P10: base depth трябва 0", "0A000")
    }
    // UNION ALL
    if tok_kw(boila_pw_tok(l, b + 11), "union") != 1 {
        return boila_pw_fail("очаквах UNION", "42601")
    }
    let mut i: i64 = b + 12
    if tok_kw(boila_pw_tok(l, i), "all") == 1 {
        i = i + 1
    }
    if tok_kw(boila_pw_tok(l, i), "select") != 1 {
        return boila_pw_fail("очаквах SELECT в recursive CTE", "42601")
    }
    i = i + 1
    // e.dst or just dst — require ident . ident or ident
    let a0 = boila_pw_tok(l, i)
    if a0.kind != tok_ident() {
        return boila_pw_fail("очаквах edge.dst колона", "42601")
    }
    i = i + 1
    // skip optional . ident for qualified
    // pattern: alias.col , cte.depth + 1 FROM edges alias , cte WHERE ...
    // Simplified: SELECT dst, depth+1 — we look for FROM
    // Actually tokens: e . dst , r . depth + num FROM edges e , cte WHERE e . src = cte . node AND cte . depth < N
    // Too many variants. Fixed pattern:
    // SELECT <dst_ident>, <cte>.depth + 1 FROM <table> <alias>, <cte>
    // WHERE <alias>.<src> = <cte>.node AND <cte>.depth < <num>
    
    // rewind-friendly: scan for FROM
    let mut found_from = false
    while i < vec_len(l.toks) && found_from == false {
        if tok_kw(boila_pw_tok(l, i), "from") == 1 {
            found_from = true
        } else {
            i = i + 1
        }
    }
    if found_from == false {
        return boila_pw_fail("очаквах FROM в recursive CTE", "42601")
    }
    i = i + 1
    let et = boila_pw_tok(l, i)
    if et.kind != tok_ident() {
        return boila_pw_fail("очаквах edge таблица", "42601")
    }
    w.edge_table = et.txt
    i = i + 1
    // optional alias
    if boila_pw_tok(l, i).kind == tok_ident() && tok_kw(boila_pw_tok(l, i), "where") != 1 {
        // alias or comma
        if boila_pw_tok(l, i).kind == tok_comma() {
        } else {
            i = i + 1
        }
    }
    if boila_pw_tok(l, i).kind == tok_comma() {
        i = i + 1
    }
    // cte ref
    if boila_pw_tok(l, i).kind != tok_ident() {
        return boila_pw_fail("очаквах CTE ref след comma", "42601")
    }
    i = i + 1
    if tok_kw(boila_pw_tok(l, i), "where") != 1 {
        return boila_pw_fail("очаквах WHERE в recursive CTE", "42601")
    }
    i = i + 1
    // scan for depth < N — last comparison
    let mut maxd: i64 = 0 - 1
    let mut src_col = ""
    let mut dst_col = a0.txt
    // if a0 was alias, next might have been . dst - re-check early tokens
    // Re-parse dst from after SELECT: tokens  after select at recursive part
    // Find first ident after recursive SELECT that isn't keyword
    // For simplicity require: WHERE e.src = cte.node AND cte.depth < N
    // Walk tokens until depth and <
    while i < vec_len(l.toks) {
        let t = boila_pw_tok(l, i)
        if t.kind == tok_ident() && t.txt == "depth" {
            // look for < num after
            let mut j = i + 1
            // skip . already passed; expect op <
            if boila_pw_tok(l, j).kind == tok_op() && boila_pw_tok(l, j).txt == "<" {
                let n = boila_pw_tok(l, j + 1)
                if n.kind == tok_num() {
                    maxd = parse_int(n.txt)
                }
            }
        }
        // src: pattern ident = cte . node  — capture left ident before =
        if t.kind == tok_op() && t.txt == "=" {
            let left = boila_pw_tok(l, i - 1)
            if left.kind == tok_ident() && left.txt != "node" && left.txt != w.cte {
                // could be src col (or alias if qualified - then left is col after .)
                if src_col == "" {
                    src_col = left.txt
                }
            }
        }
        if t.kind == tok_rparen() {
            // end of AS (
            i = i + 1
            // break
            let end = true
            if end {
                i = i
            }
            // stop loop
            i = vec_len(l.toks)
        } else {
            i = i + 1
        }
    }
    // Re-scan for closing paren and outer SELECT more carefully
    let mut pi: i64 = 0
    let mut depth: i64 = 0
    let mut as_open: i64 = 0 - 1
    while pi < vec_len(l.toks) {
        let t = boila_pw_tok(l, pi)
        if t.kind == tok_lparen() {
            depth = depth + 1
            if as_open < 0 && pi >= 9 {
                as_open = pi
            }
        }
        if t.kind == tok_rparen() {
            depth = depth - 1
            if depth == 0 && as_open >= 0 {
                // outer SELECT after this
                pi = pi + 1
                // skip to end check SELECT FROM cte
                if tok_kw(boila_pw_tok(l, pi), "select") != 1 {
                    return boila_pw_fail("очаквах външен SELECT след CTE", "42601")
                }
                // find FROM cte
                let mut k = pi
                let mut ok_from = false
                while k < vec_len(l.toks) {
                    if tok_kw(boila_pw_tok(l, k), "from") == 1 {
                        let ft = boila_pw_tok(l, k + 1)
                        if ft.kind == tok_ident() && ft.txt == w.cte {
                            ok_from = true
                        }
                    }
                    k = k + 1
                }
                if ok_from == false {
                    return boila_pw_fail("външният SELECT трябва FROM <cte>", "0A000")
                }
                k = vec_len(l.toks)
                pi = vec_len(l.toks)
            } else {
                pi = pi + 1
            }
        } else {
            pi = pi + 1
        }
    }
    if maxd < 0 {
        return boila_pw_fail("очаквах cte.depth < N в recursive WHERE", "42601")
    }
    if src_col == "" {
        return boila_pw_fail("очаквах e.src = cte.node в WHERE", "42601")
    }
    // dst_col: first ident after recursive SELECT — may be qualified e.dst
    // re-find
    let mut ri: i64 = 0
    let mut seen_union = false
    let mut got_dst = false
    while ri < vec_len(l.toks) && got_dst == false {
        if tok_kw(boila_pw_tok(l, ri), "union") == 1 {
            seen_union = true
        }
        if seen_union && tok_kw(boila_pw_tok(l, ri), "select") == 1 {
            let t1 = boila_pw_tok(l, ri + 1)
            if t1.kind == tok_ident() {
                // e . dst ?
                if boila_pw_tok(l, ri + 2).kind == tok_ident() {
                    // unlikely without .
                    dst_col = t1.txt
                }
                // check for something that looks like col after dot - we don't have . token
                // lexer doesn't produce . — so qualified names aren't supported unless we add .
                dst_col = t1.txt
                got_dst = true
            }
        }
        ri = ri + 1
    }
    w.dst_col = dst_col
    w.src_col = src_col
    w.max_depth = maxd
    return BoilaParseWith { ok: 1, w: w, err: "", state: "" }
}

// CREATE GRAPH name ON table (src, dst [, weight])
struct BoilaParseGraph {
    ok: i64,
    name: str,
    table: str,
    src: str,
    dst: str,
    wcol: str,
    err: str,
    state: str
}

fn boila_pg_fail(msg: str, state: str) -> BoilaParseGraph {
    return BoilaParseGraph { ok: 0, name: "", table: "", src: "", dst: "", wcol: "", err: msg, state: state }
}

fn boila_parse_create_graph(l: BoilaLex) -> BoilaParseGraph {
    // CREATE GRAPH name ON table ( src , dst [, w ] )
    let nm = boila_pw_tok(l, 2)
    if nm.kind != tok_ident() {
        return boila_pg_fail("очаквах име след CREATE GRAPH", "42601")
    }
    if tok_kw(boila_pw_tok(l, 3), "on") != 1 {
        return boila_pg_fail("очаквах ON", "42601")
    }
    let tb = boila_pw_tok(l, 4)
    if tb.kind != tok_ident() {
        return boila_pg_fail("очаквах таблица", "42601")
    }
    if boila_pw_tok(l, 5).kind != tok_lparen() {
        return boila_pg_fail("очаквах '('", "42601")
    }
    let s = boila_pw_tok(l, 6)
    if s.kind != tok_ident() {
        return boila_pg_fail("очаквах src колона", "42601")
    }
    if boila_pw_tok(l, 7).kind != tok_comma() {
        return boila_pg_fail("очаквах ','", "42601")
    }
    let d = boila_pw_tok(l, 8)
    if d.kind != tok_ident() {
        return boila_pg_fail("очаквах dst колона", "42601")
    }
    let mut i: i64 = 9
    let mut wcol = ""
    if boila_pw_tok(l, i).kind == tok_comma() {
        let w = boila_pw_tok(l, i + 1)
        if w.kind != tok_ident() {
            return boila_pg_fail("очаквах weight колона", "42601")
        }
        wcol = w.txt
        i = i + 2
    }
    if boila_pw_tok(l, i).kind != tok_rparen() {
        return boila_pg_fail("очаквах ')'", "42601")
    }
    i = i + 1
    if boila_pw_tok(l, i).kind == tok_semi() {
        i = i + 1
    }
    if boila_pw_tok(l, i).kind != tok_eof() {
        return boila_pg_fail("неочакван токен след CREATE GRAPH", "0A000")
    }
    return BoilaParseGraph { ok: 1, name: nm.txt, table: tb.txt, src: s.txt, dst: d.txt, wcol: wcol, err: "", state: "" }
}
