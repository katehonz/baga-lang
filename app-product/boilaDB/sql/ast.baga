// ast.baga — AST структури за BoilaSQL (P1 → P5).

import "../core/value.baga"
import "../catalog/ddl_types.baga"
import "token.baga"

// SELECT (P5): projection от BoilaSelItem-и (колони/агрегати), WHERE по
// pk или индексирана колона (eq + lo + hi с AND), DISTINCT, ORDER BY/
// OFFSET, GROUP BY/HAVING, един JOIN (INNER/LEFT, ON equality).

// One HAVING predicate: agg(*) | agg(col) | agg(<expr>) op lit.
// next_join is not stored here — see BoilaSel.hav_joins.
struct BoilaHavPred {
    agg: i64,       // 1 count(*), 2 count(col|expr), 3 sum, …
    col: str,       // "" if count(*) or expr-arg
    xtoks: Vec<Token>, // empty = bare col / *
    op: str,
    val: i64
}

fn boila_hav_pred(agg: i64, col: str, xtoks: Vec<Token>, op: str, val: i64) -> BoilaHavPred {
    return BoilaHavPred { agg: agg, col: col, xtoks: xtoks, op: op, val: val }
}

struct BoilaSelItem {
    agg: i64,   // 0 колона, 1 count(*), 2 count(col|expr), 3 sum, 4 avg, 5 min, 6 max
    col: str,
    biv: i64,   // S7: time_bucket interval sec (0 = plain col/agg)
    alias: str, // S7b: AS alias ("" = default name)
    // Q-sfn: scalar fn projection item (sfn != ""). Parallel args:
    // sfn_cols[k] != "" → column; else literal at sfn_vals[k].
    sfn: str,
    sfn_cols: Vec<str>,
    sfn_vals: Vec<BoilaVal>,
    // Q-expr / Q-aexpr: when agg==0 → projection expr; when agg>0 →
    // aggregate argument expression (sum(sal+1)); bare col uses col.
    xtoks: Vec<Token>
}

struct BoilaSel {
    table: str,
    star: i64,
    items: Vec<BoilaSelItem>,
    eq_col: str, has_eq: i64, pk_eq: BoilaVal, eq_param: i64,
    // K6: IS [NOT] NULL — 0 none, 1 IS NULL, 2 IS NOT NULL
    isnull_mode: i64,
    isnull_col: str,
    lo_col: str, has_lo: i64, pk_lo: BoilaVal, lo_param: i64, lo_excl: i64,
    hi_col: str, has_hi: i64, pk_hi: BoilaVal, hi_param: i64, hi_excl: i64,
    between_not: i64,       // 1 = NOT BETWEEN (invert inclusive lo/hi)
    limit: i64, lim_param: i64,
    offset: i64,
    has_order: i64,
    ord_cols: Vec<str>,
    ord_desc: Vec<i64>,
    distinct: i64,
    has_group: i64,
    group_cols: Vec<str>,
    // Q-gbyx: parallel to group_cols; empty vec = bare column name in
    // group_cols[i]; non-empty = GROUP BY <expr> (key = eval on row).
    group_xtoks: Vec<Vec<Token>>,
    has_having: i64,
    // Q-havx / Q-havand: list of HAVING predicates; joins between them
    // (1=AND, 2=OR) left-associative. Empty xtoks = bare col / count(*).
    hav_preds: Vec<BoilaHavPred>,
    hav_joins: Vec<i64>,
    has_join: i64,
    join_kind: i64,   // 1 INNER, 2 LEFT
    join_table: str,
    join_lcol: str,   // first ON pair (compat)
    join_rcol: str,
    join_lcols: Vec<str>, // A3c: ON a=b AND c=d …
    join_rcols: Vec<str>,
    // FTS (P7): WHERE col @@ to_tsquery('…')
    has_fts: i64,
    fts_col: str,
    fts_mode: i64,          // 1 AND, 2 OR, 3 PHRASE (F5)
    fts_terms: Vec<str>,
    fts_gaps: Vec<i64>,     // PHRASE: distance between terms (PG <N>)
    // kNN (P8): WHERE col <->|<=>|<#> '[…]'  (+ LIMIT = k)
    has_knn: i64,
    knn_col: str,
    knn_metric: i64,        // 1 L2, 2 cos, 3 ip
    knn_query: str,         // суров vector литерал
    // time_bucket (P9): GROUP BY time_bucket('1m', col)
    bucket_iv: i64,         // 0 = none; else interval seconds
    bucket_col: str,
    // Q-like: WHERE col LIKE|ILIKE 'pat' [ESCAPE 'e'] (post-filter; % _)
    has_like: i64,          // 0 none, 1 LIKE, 2 ILIKE
    like_col: str,
    like_pat: str,
    like_esc: str,          // "" = none; else single-char escape
    // Q-in: WHERE col IN|NOT IN (lit,…) — 1 IN, 2 NOT IN
    has_in: i64,
    in_col: str,
    in_vals: Vec<BoilaVal>,
    // Q-ne: WHERE col <>|!= lit (post-filter)
    has_ne: i64,
    ne_col: str,
    pk_ne: BoilaVal,
    ne_param: i64,
    // Q-xw: WHERE <expr> — dual-expression predicate, post-fetch filter
    has_xw: i64,
    xw_toks: Vec<Token>
}

fn boila_sel_item_col(name: str) -> BoilaSelItem {
    let fc: Vec<str> = vec_new()
    let fv: Vec<BoilaVal> = vec_new()
    let xt: Vec<Token> = vec_new()
    return BoilaSelItem { agg: 0, col: name, biv: 0, alias: "", sfn: "", sfn_cols: fc, sfn_vals: fv, xtoks: xt }
}

fn boila_sel_item_agg(kind: i64, col: str) -> BoilaSelItem {
    let fc: Vec<str> = vec_new()
    let fv: Vec<BoilaVal> = vec_new()
    let xt: Vec<Token> = vec_new()
    return BoilaSelItem { agg: kind, col: col, biv: 0, alias: "", sfn: "", sfn_cols: fc, sfn_vals: fv, xtoks: xt }
}

// Q-aexpr: aggregate over an expression argument (sum(a+1), count(upper(c))).
fn boila_sel_item_agg_x(kind: i64, xtoks: Vec<Token>) -> BoilaSelItem {
    let fc: Vec<str> = vec_new()
    let fv: Vec<BoilaVal> = vec_new()
    return BoilaSelItem { agg: kind, col: "", biv: 0, alias: "", sfn: "", sfn_cols: fc, sfn_vals: fv, xtoks: xtoks }
}

fn boila_sel_item_bucket(col: str, iv: i64) -> BoilaSelItem {
    let fc: Vec<str> = vec_new()
    let fv: Vec<BoilaVal> = vec_new()
    let xt: Vec<Token> = vec_new()
    return BoilaSelItem { agg: 0, col: col, biv: iv, alias: "", sfn: "", sfn_cols: fc, sfn_vals: fv, xtoks: xt }
}

fn boila_sel_item_sfn(fnm: str, cols: Vec<str>, vals: Vec<BoilaVal>) -> BoilaSelItem {
    let xt: Vec<Token> = vec_new()
    return BoilaSelItem { agg: 0, col: "", biv: 0, alias: "", sfn: fnm, sfn_cols: cols, sfn_vals: vals, xtoks: xt }
}

fn boila_sel_item_expr(toks: Vec<Token>) -> BoilaSelItem {
    let fc: Vec<str> = vec_new()
    let fv: Vec<BoilaVal> = vec_new()
    return BoilaSelItem { agg: 0, col: "", biv: 0, alias: "", sfn: "", sfn_cols: fc, sfn_vals: fv, xtoks: toks }
}

// Output column name: alias > expr > sfn name > time_bucket > col.
fn boila_sel_item_out_name(it: BoilaSelItem) -> str {
    if it.alias != "" {
        return it.alias
    }
    if it.agg > 0 && vec_len(it.xtoks) > 0 {
        return boila_agg_item_name_base(it.agg)
    }
    if vec_len(it.xtoks) > 0 {
        return "?column?"
    }
    if it.sfn != "" {
        return it.sfn
    }
    if it.biv > 0 {
        return "time_bucket"
    }
    return it.col
}

// Default agg output name without column suffix (expr args).
fn boila_agg_item_name_base(agg: i64) -> str {
    if agg == 1 || agg == 2 { return "count" }
    if agg == 3 { return "sum" }
    if agg == 4 { return "avg" }
    if agg == 5 { return "min" }
    return "max"
}

// BoilaColDef / BoilaCreate / boila_coldef / boila_create_empty →
// catalog/ddl_types.baga (kimi-deps D4).

fn boila_sel_empty() -> BoilaSel {
    let items: Vec<BoilaSelItem> = vec_new()
    let oc: Vec<str> = vec_new()
    let od: Vec<i64> = vec_new()
    let gc: Vec<str> = vec_new()
    let gx: Vec<Vec<Token>> = vec_new()
    let ft: Vec<str> = vec_new()
    let fg: Vec<i64> = vec_new()
    let jl: Vec<str> = vec_new()
    let jr: Vec<str> = vec_new()
    let iv: Vec<BoilaVal> = vec_new()
    let xw: Vec<Token> = vec_new()
    let hp: Vec<BoilaHavPred> = vec_new()
    let hj: Vec<i64> = vec_new()
    return BoilaSel {
        table: "", star: 0, items: items,
        eq_col: "", has_eq: 0, pk_eq: BoilaVal { tag: 0, i: 0, b: bytes_new(0) }, eq_param: 0,
        isnull_mode: 0, isnull_col: "",
        lo_col: "", has_lo: 0, pk_lo: BoilaVal { tag: 0, i: 0, b: bytes_new(0) }, lo_param: 0, lo_excl: 0,
        hi_col: "", has_hi: 0, pk_hi: BoilaVal { tag: 0, i: 0, b: bytes_new(0) }, hi_param: 0, hi_excl: 0,
        between_not: 0,
        limit: 0, lim_param: 0, offset: 0,
        has_order: 0, ord_cols: oc, ord_desc: od,
        distinct: 0,
        has_group: 0, group_cols: gc, group_xtoks: gx,
        has_having: 0, hav_preds: hp, hav_joins: hj,
        has_join: 0, join_kind: 0, join_table: "", join_lcol: "", join_rcol: "",
        join_lcols: jl, join_rcols: jr,
        has_fts: 0, fts_col: "", fts_mode: 1, fts_terms: ft, fts_gaps: fg,
        has_knn: 0, knn_col: "", knn_metric: 1, knn_query: "",
        bucket_iv: 0, bucket_col: "",
        has_like: 0, like_col: "", like_pat: "", like_esc: "",
        has_in: 0, in_col: "", in_vals: iv,
        has_ne: 0, ne_col: "", pk_ne: BoilaVal { tag: 0, i: 0, b: bytes_new(0) }, ne_param: 0,
        has_xw: 0, xw_toks: xw
    }
}

// --- DML (P3) ---

// INSERT: oc = 0 без, 1 DO NOTHING, 2 DO UPDATE SET.
struct BoilaIns {
    table: str,
    cols: Vec<str>,
    rows: Vec<Vec<BoilaVal>>,
    oc: i64,
    oc_cols: Vec<str>,
    oc_vals: Vec<BoilaVal>,
    // Q-oc-expr: per-SET expression tokens (parallel to oc_cols;
    // empty vec = literal at oc_vals). Unqualified names = OLD row;
    // EXCLUDED.col rewritten to excluded$col at parse.
    oc_xtoks: Vec<Vec<Token>>,
    has_ret: i64,
    ret_star: i64,
    ret_cols: Vec<str>
}

fn boila_ins_empty() -> BoilaIns {
    let cols: Vec<str> = vec_new()
    let rows: Vec<Vec<BoilaVal>> = vec_new()
    let oc_cols: Vec<str> = vec_new()
    let oc_vals: Vec<BoilaVal> = vec_new()
    let oc_xtoks: Vec<Vec<Token>> = vec_new()
    let ret_cols: Vec<str> = vec_new()
    return BoilaIns { table: "", cols: cols, rows: rows, oc: 0, oc_cols: oc_cols, oc_vals: oc_vals, oc_xtoks: oc_xtoks, has_ret: 0, ret_star: 0, ret_cols: ret_cols }
}

// UPDATE/DELETE: WHERE е pk-only или по индексирана колона (P3),
// същите has_eq/lo/hi полета като BoilaSel.
struct BoilaUpd {
    table: str,
    set_cols: Vec<str>,
    set_vals: Vec<BoilaVal>,
    // Q-xdml: per-SET expression tokens (parallel to set_cols;
    // empty vec = literal at set_vals); evaluated on the OLD row.
    set_xtoks: Vec<Vec<Token>>,
    eq_col: str, has_eq: i64, pk_eq: BoilaVal,
    lo_col: str, has_lo: i64, pk_lo: BoilaVal,
    hi_col: str, has_hi: i64, pk_hi: BoilaVal,
    has_xw: i64, xw_toks: Vec<Token>,
    has_ret: i64,
    ret_star: i64,
    ret_cols: Vec<str>
}

fn boila_upd_empty() -> BoilaUpd {
    let sc: Vec<str> = vec_new()
    let sv: Vec<BoilaVal> = vec_new()
    let sx: Vec<Vec<Token>> = vec_new()
    let rc: Vec<str> = vec_new()
    let xw: Vec<Token> = vec_new()
    let z = BoilaVal { tag: 0, i: 0, b: bytes_new(0) }
    return BoilaUpd { table: "", set_cols: sc, set_vals: sv, set_xtoks: sx, eq_col: "", has_eq: 0, pk_eq: z, lo_col: "", has_lo: 0, pk_lo: z, hi_col: "", has_hi: 0, pk_hi: z, has_xw: 0, xw_toks: xw, has_ret: 0, ret_star: 0, ret_cols: rc }
}

struct BoilaDel {
    table: str,
    eq_col: str, has_eq: i64, pk_eq: BoilaVal,
    lo_col: str, has_lo: i64, pk_lo: BoilaVal,
    hi_col: str, has_hi: i64, pk_hi: BoilaVal,
    has_xw: i64, xw_toks: Vec<Token>,
    has_ret: i64,
    ret_star: i64,
    ret_cols: Vec<str>
}

fn boila_del_empty() -> BoilaDel {
    let rc: Vec<str> = vec_new()
    let xw: Vec<Token> = vec_new()
    let z = BoilaVal { tag: 0, i: 0, b: bytes_new(0) }
    return BoilaDel { table: "", eq_col: "", has_eq: 0, pk_eq: z, lo_col: "", has_lo: 0, pk_lo: z, hi_col: "", has_hi: 0, pk_hi: z, has_xw: 0, xw_toks: xw, has_ret: 0, ret_star: 0, ret_cols: rc }
}

// CREATE INDEX име ON таблица (колона)
struct BoilaIxDef {
    ix_name: str,
    table: str,
    col: str
}
