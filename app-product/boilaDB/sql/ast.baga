// ast.baga — AST структури за BoilaSQL (P1 → P5).

import "../core/value.baga"

// SELECT (P5): projection от BoilaSelItem-и (колони/агрегати), WHERE по
// pk или индексирана колона (eq + lo + hi с AND), DISTINCT, ORDER BY/
// OFFSET, GROUP BY/HAVING, един JOIN (INNER/LEFT, ON equality).
struct BoilaSelItem {
    agg: i64,   // 0 колона, 1 count(*), 2 count(col), 3 sum, 4 avg, 5 min, 6 max
    col: str,
    biv: i64    // S7: time_bucket interval sec (0 = plain col/agg)
}

struct BoilaSel {
    table: str,
    star: i64,
    items: Vec<BoilaSelItem>,
    eq_col: str, has_eq: i64, pk_eq: BoilaVal, eq_param: i64,
    // K6: IS [NOT] NULL — 0 none, 1 IS NULL, 2 IS NOT NULL
    isnull_mode: i64,
    isnull_col: str,
    lo_col: str, has_lo: i64, pk_lo: BoilaVal, lo_param: i64,
    hi_col: str, has_hi: i64, pk_hi: BoilaVal, hi_param: i64,
    limit: i64, lim_param: i64,
    offset: i64,
    has_order: i64,
    ord_cols: Vec<str>,
    ord_desc: Vec<i64>,
    distinct: i64,
    has_group: i64,
    group_cols: Vec<str>,
    has_having: i64,
    hav_agg: i64,
    hav_col: str,
    hav_op: str,
    hav_val: i64,
    has_join: i64,
    join_kind: i64,   // 1 INNER, 2 LEFT
    join_table: str,
    join_lcol: str,
    join_rcol: str,
    // FTS (P7): WHERE col @@ to_tsquery('…')
    has_fts: i64,
    fts_col: str,
    fts_mode: i64,          // 1 AND, 2 OR, 3 PHRASE (F5)
    fts_terms: Vec<str>,
    // kNN (P8): WHERE col <->|<=>|<#> '[…]'  (+ LIMIT = k)
    has_knn: i64,
    knn_col: str,
    knn_metric: i64,        // 1 L2, 2 cos, 3 ip
    knn_query: str,         // суров vector литерал
    // time_bucket (P9): GROUP BY time_bucket('1m', col)
    bucket_iv: i64,         // 0 = none; else interval seconds
    bucket_col: str
}

fn boila_sel_item_col(name: str) -> BoilaSelItem {
    return BoilaSelItem { agg: 0, col: name, biv: 0 }
}

fn boila_sel_item_agg(kind: i64, col: str) -> BoilaSelItem {
    return BoilaSelItem { agg: kind, col: col, biv: 0 }
}

fn boila_sel_item_bucket(col: str, iv: i64) -> BoilaSelItem {
    return BoilaSelItem { agg: 0, col: col, biv: iv }
}

// Тип на колона = tag от value модела (i64/bool/str/bytes/json/ts).
struct BoilaColDef {
    name: str,
    typ: i64
}

struct BoilaCreate {
    table: str,
    cols: Vec<BoilaColDef>,
    pk_idx: i64,
    ttl_sec: i64    // P9: 0 = none; FROM WITH (ttl_days|ttl_sec)
}

fn boila_sel_empty() -> BoilaSel {
    let items: Vec<BoilaSelItem> = vec_new()
    let oc: Vec<str> = vec_new()
    let od: Vec<i64> = vec_new()
    let gc: Vec<str> = vec_new()
    let ft: Vec<str> = vec_new()
    return BoilaSel {
        table: "", star: 0, items: items,
        eq_col: "", has_eq: 0, pk_eq: BoilaVal { tag: 0, i: 0, b: bytes_new(0) }, eq_param: 0,
        isnull_mode: 0, isnull_col: "",
        lo_col: "", has_lo: 0, pk_lo: BoilaVal { tag: 0, i: 0, b: bytes_new(0) }, lo_param: 0,
        hi_col: "", has_hi: 0, pk_hi: BoilaVal { tag: 0, i: 0, b: bytes_new(0) }, hi_param: 0,
        limit: 0, lim_param: 0, offset: 0,
        has_order: 0, ord_cols: oc, ord_desc: od,
        distinct: 0,
        has_group: 0, group_cols: gc,
        has_having: 0, hav_agg: 0, hav_col: "", hav_op: "", hav_val: 0,
        has_join: 0, join_kind: 0, join_table: "", join_lcol: "", join_rcol: "",
        has_fts: 0, fts_col: "", fts_mode: 1, fts_terms: ft,
        has_knn: 0, knn_col: "", knn_metric: 1, knn_query: "",
        bucket_iv: 0, bucket_col: ""
    }
}

fn boila_coldef(name: str, typ: i64) -> BoilaColDef {
    return BoilaColDef { name: name, typ: typ }
}

fn boila_create_empty() -> BoilaCreate {
    let cols: Vec<BoilaColDef> = vec_new()
    return BoilaCreate { table: "", cols: cols, pk_idx: 0 - 1, ttl_sec: 0 }
}

// --- DML (P3) ---

// INSERT: oc = 0 без, 1 DO NOTHING, 2 DO UPDATE SET.
struct BoilaIns {
    table: str,
    cols: Vec<str>,
    rows: Vec<Vec<BoilaVal>>,
    oc: i64,
    oc_cols: Vec<str>,
    oc_vals: Vec<BoilaVal>,
    has_ret: i64,
    ret_star: i64,
    ret_cols: Vec<str>
}

fn boila_ins_empty() -> BoilaIns {
    let cols: Vec<str> = vec_new()
    let rows: Vec<Vec<BoilaVal>> = vec_new()
    let oc_cols: Vec<str> = vec_new()
    let oc_vals: Vec<BoilaVal> = vec_new()
    let ret_cols: Vec<str> = vec_new()
    return BoilaIns { table: "", cols: cols, rows: rows, oc: 0, oc_cols: oc_cols, oc_vals: oc_vals, has_ret: 0, ret_star: 0, ret_cols: ret_cols }
}

// UPDATE/DELETE: WHERE е pk-only или по индексирана колона (P3),
// същите has_eq/lo/hi полета като BoilaSel.
struct BoilaUpd {
    table: str,
    set_cols: Vec<str>,
    set_vals: Vec<BoilaVal>,
    eq_col: str, has_eq: i64, pk_eq: BoilaVal,
    lo_col: str, has_lo: i64, pk_lo: BoilaVal,
    hi_col: str, has_hi: i64, pk_hi: BoilaVal,
    has_ret: i64,
    ret_star: i64,
    ret_cols: Vec<str>
}

fn boila_upd_empty() -> BoilaUpd {
    let sc: Vec<str> = vec_new()
    let sv: Vec<BoilaVal> = vec_new()
    let rc: Vec<str> = vec_new()
    let z = BoilaVal { tag: 0, i: 0, b: bytes_new(0) }
    return BoilaUpd { table: "", set_cols: sc, set_vals: sv, eq_col: "", has_eq: 0, pk_eq: z, lo_col: "", has_lo: 0, pk_lo: z, hi_col: "", has_hi: 0, pk_hi: z, has_ret: 0, ret_star: 0, ret_cols: rc }
}

struct BoilaDel {
    table: str,
    eq_col: str, has_eq: i64, pk_eq: BoilaVal,
    lo_col: str, has_lo: i64, pk_lo: BoilaVal,
    hi_col: str, has_hi: i64, pk_hi: BoilaVal,
    has_ret: i64,
    ret_star: i64,
    ret_cols: Vec<str>
}

fn boila_del_empty() -> BoilaDel {
    let rc: Vec<str> = vec_new()
    let z = BoilaVal { tag: 0, i: 0, b: bytes_new(0) }
    return BoilaDel { table: "", eq_col: "", has_eq: 0, pk_eq: z, lo_col: "", has_lo: 0, pk_lo: z, hi_col: "", has_hi: 0, pk_hi: z, has_ret: 0, ret_star: 0, ret_cols: rc }
}

// CREATE INDEX име ON таблица (колона)
struct BoilaIxDef {
    ix_name: str,
    table: str,
    col: str
}
