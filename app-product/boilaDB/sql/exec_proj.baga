// exec_proj.baga — форма на резултата: проекция, DISTINCT, OFFSET/LIMIT.
// Q-distinct-limit: seen-ключовете са boila_row_ser (bytes). Няма
// зависимости от exec_scan — чист reshape на вече извлечени редове.

import "../core/value.baga"
import "../core/row.baga"
import "ast.baga"
import "std/bytes/bytes.baga"

// Име на колона в изходен списък (ORDER BY след проекция/агрегация).
fn boila_col_name_idx(names: Vec<str>, name: str) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(names) {
        if vec_get(names, i) == name {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// Проекция на ред по индекси; празен proj = всичките колони.
fn boila_project(row: Vec<BoilaVal>, proj: Vec<i64>) -> Vec<BoilaVal> {
    if vec_len(proj) == 0 {
        return row
    }
    let out: Vec<BoilaVal> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(proj) {
        let ix = vec_get(proj, i)
        if ix >= 0 && ix < vec_len(row) {
            vec_push(out, vec_get(row, ix))
        } else {
            vec_push(out, boila_val_null())
        }
        i = i + 1
    }
    return out
}

// Дали литералът съответства на типа на колоната (null минава).
fn boila_row_ser(row: Vec<BoilaVal>) -> bytes {
    let mut out = bytes_new(0)
    let mut i: i64 = 0
    while i < vec_len(row) {
        out = bytes_concat(out, boila_val_enc(vec_get(row, i)))
        out = bytes_concat(out, bytes_of_str("|"))
        i = i + 1
    }
    return out
}

// Q-distinct-limit: offer one projected row into out if not yet seen.
// Returns 1 if added, 0 if duplicate. `seen` holds boila_row_ser keys.
fn boila_distinct_offer(out: Vec<Vec<BoilaVal>>, seen: Vec<bytes>, row: Vec<BoilaVal>) -> i64 {
    let ser = boila_row_ser(row)
    let mut j: i64 = 0
    while j < vec_len(seen) {
        if bytes_eq_b(vec_get(seen, j), ser) {
            return 0
        }
        j = j + 1
    }
    vec_push(seen, ser)
    vec_push(out, row)
    return 1
}

fn boila_distinct_rows(rows: Vec<Vec<BoilaVal>>) -> Vec<Vec<BoilaVal>> {
    let out: Vec<Vec<BoilaVal>> = vec_new()
    let seen: Vec<bytes> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(rows) {
        boila_distinct_offer(out, seen, vec_get(rows, i))
        i = i + 1
    }
    return out
}

// Cap for DISTINCT early-stop: offset+limit when LIMIT without order_after.
// 0 = collect all unique (no early-stop).
fn boila_distinct_need(sel: BoilaSel, order_after: i64) -> i64 {
    if sel.distinct == 0 || sel.limit <= 0 || order_after == 1 {
        return 0
    }
    let mut n = sel.offset + sel.limit
    if n < 1 {
        n = sel.limit
    }
    return n
}

fn boila_apply_offlim(rows: Vec<Vec<BoilaVal>>, off: i64, lim: i64) -> Vec<Vec<BoilaVal>> {
    let out: Vec<Vec<BoilaVal>> = vec_new()
    let n = vec_len(rows)
    let mut i = off
    if i < 0 {
        i = 0
    }
    let mut taken: i64 = 0
    while i < n {
        if lim > 0 && taken >= lim {
            i = n
        } else {
            vec_push(out, vec_get(rows, i))
            taken = taken + 1
            i = i + 1
        }
    }
    return out
}
