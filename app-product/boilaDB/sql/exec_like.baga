// exec_like.baga — LIKE / ILIKE matcher (% and _; Q-like).
import "lexer.baga"
import "std/str/str.baga"

// Match s against pat. icase=1 → fold both via boila_fold_lower.
// Returns 1 match, 0 no.
fn boila_like_match(s: str, pat: str, icase: i64) -> i64 {
    let mut a = s
    let mut p = pat
    if icase == 1 {
        a = boila_fold_lower(s)
        p = boila_fold_lower(pat)
    }
    return boila_like_rec(a, 0, p, 0)
}

fn boila_like_rec(s: str, si: i64, p: str, pi: i64) -> i64 {
    let sn = len(s)
    let pn = len(p)
    if pi >= pn {
        if si >= sn { return 1 }
        return 0
    }
    let pc = char_at(p, pi)
    // %
    if pc == 37 {
        // greedy backtrack: try match rest at each s position
        let mut k = si
        while k <= sn {
            if boila_like_rec(s, k, p, pi + 1) == 1 {
                return 1
            }
            k = k + 1
        }
        return 0
    }
    if si >= sn {
        return 0
    }
    // _
    if pc == 95 {
        return boila_like_rec(s, si + 1, p, pi + 1)
    }
    if char_at(s, si) != pc {
        return 0
    }
    return boila_like_rec(s, si + 1, p, pi + 1)
}
