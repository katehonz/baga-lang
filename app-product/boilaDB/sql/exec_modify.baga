// exec_modify.baga — executor за UPDATE / DELETE (P4, през txn buffer-а).
// Помощниците (BoilaDml, row copy, проекции) са в exec_dml.baga.

import "../storage/shards.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "../core/row.baga"
import "../catalog/schema.baga"
import "../index/secondary.baga"
import "../fts/fts.baga"
import "../vector/hnsw.baga"
import "../vector/hnsw_store.baga"
import "../graph/adjacency.baga"
import "../graph/dml.baga"
import "../txn/mvcc.baga"
import "ast.baga"
import "exec_scan.baga"
import "exec_dml.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

// WHERE targets: PK/index eq; PK or non-PK range (K3b post-filter); all.
struct BoilaDmlTgts {
    s: BoilaStore,
    txn: BoilaTxn,
    ok: i64,
    err: str,
    state: str,
    pks: Vec<bytes>
}

fn boila_dml_targets(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, eq_col: str, has_eq: i64, v_eq: BoilaVal, lo_col: str, has_lo: i64, v_lo: BoilaVal, hi_col: str, has_hi: i64, v_hi: BoilaVal) -> BoilaDmlTgts !IO !Time !Par {
    let pks: Vec<bytes> = vec_new()
    let pkcol = vec_get(t.cols, t.pk_idx)
    if has_eq == 1 {
        if eq_col == pkcol.name {
            if boila_pk_lit_ok(pkcol.typ, v_eq) == 0 {
                return BoilaDmlTgts { s: s, txn: txn, ok: 0, err: "литералът в = не съответства на PRIMARY KEY типа", state: "42804", pks: pks }
            }
            vec_push(pks, boila_val_enc(v_eq))
            return BoilaDmlTgts { s: s, txn: txn, ok: 1, err: "", state: "", pks: pks }
        }
        let cix = boila_col_idx(t, eq_col)
        if cix < 0 {
            return BoilaDmlTgts { s: s, txn: txn, ok: 0, err: concat("колона '", concat(eq_col, "' не съществува")), state: "42703", pks: pks }
        }
        let cd = vec_get(t.cols, cix)
        if boila_dml_val_ok(cd.typ, v_eq) == 0 {
            return BoilaDmlTgts { s: s, txn: txn, ok: 0, err: "литералът в = не съответства на типа на колоната", state: "42804", pks: pks }
        }
        let ixid = boila_ix_by_col_t(t, cix)
        if ixid >= 0 {
            let lk = boila_ix_lookup(s, t, ixid, v_eq)?
            s = lk.s
            boila_scan_buf_eq(txn, t, cix, v_eq, lk.pks)
            return BoilaDmlTgts { s: s, txn: txn, ok: 1, err: "", state: "", pks: lk.pks }
        }
        // K3c: no index → scan all keys and filter by col eq below
        let ks = boila_txn_keys(s, txn, t.id)?
        s = ks.s
        let mut ki: i64 = 0
        while ki < vec_len(ks.pks) {
            let pkenc = vec_get(ks.pks, ki)
            let g = boila_txn_get(s, txn, t.id, pkenc)?
            s = g.s
            if g.found == 1 {
                let row = boila_row_dec(g.row)
                if cix >= 0 && cix < vec_len(row) {
                    if boila_val_cmp(vec_get(row, cix), v_eq) == 0 {
                        vec_push(pks, pkenc)
                    }
                }
            }
            ki = ki + 1
        }
        return BoilaDmlTgts { s: s, txn: txn, ok: 1, err: "", state: "", pks: pks }
    }
    // range: PK cmp on key; non-PK → get row + col cmp (K3b)
    let mut pk_range: i64 = 1
    let mut lo_cix: i64 = 0 - 1
    let mut hi_cix: i64 = 0 - 1
    if has_lo == 1 {
        lo_cix = boila_col_idx(t, lo_col)
        if lo_cix < 0 {
            return BoilaDmlTgts { s: s, txn: txn, ok: 0, err: concat("колона '", concat(lo_col, "' не съществува")), state: "42703", pks: pks }
        }
        if boila_dml_val_ok(vec_get(t.cols, lo_cix).typ, v_lo) == 0 {
            return BoilaDmlTgts { s: s, txn: txn, ok: 0, err: "литералът в >= не съответства на типа на колоната", state: "42804", pks: pks }
        }
        if lo_col != pkcol.name { pk_range = 0 }
    }
    if has_hi == 1 {
        hi_cix = boila_col_idx(t, hi_col)
        if hi_cix < 0 {
            return BoilaDmlTgts { s: s, txn: txn, ok: 0, err: concat("колона '", concat(hi_col, "' не съществува")), state: "42703", pks: pks }
        }
        if boila_dml_val_ok(vec_get(t.cols, hi_cix).typ, v_hi) == 0 {
            return BoilaDmlTgts { s: s, txn: txn, ok: 0, err: "литералът в <= не съответства на типа на колоната", state: "42804", pks: pks }
        }
        if hi_col != pkcol.name { pk_range = 0 }
    }
    // K3d: secondary index range (fixed-size) before full seq
    if pk_range == 0 && (has_lo == 1 || has_hi == 1) {
        let mut rc = lo_col
        if has_lo == 0 { rc = hi_col }
        let mut same = 1
        if has_lo == 1 && has_hi == 1 && lo_col != hi_col { same = 0 }
        if same == 1 {
            let cix = boila_col_idx(t, rc)
            let ixid = boila_ix_by_col_t(t, cix)
            if cix >= 0 && ixid >= 0 {
                let xr = boila_ix_range(s, t, ixid, has_lo, v_lo, has_hi, v_hi)?
                s = xr.s
                if xr.ok == 0 {
                    return BoilaDmlTgts { s: s, txn: txn, ok: 0, err: xr.err, state: xr.state, pks: pks }
                }
                if xr.has == 1 {
                    return BoilaDmlTgts { s: s, txn: txn, ok: 1, err: "", state: "", pks: xr.pks }
                }
            }
        }
    }
    let ks = boila_txn_keys(s, txn, t.id)?
    s = ks.s
    let mut ki: i64 = 0
    while ki < vec_len(ks.pks) {
        let pkenc = vec_get(ks.pks, ki)
        let mut keep = true
        if pk_range == 1 && (has_lo == 1 || has_hi == 1) {
            let pkv = boila_val_dec(pkenc)
            if has_lo == 1 {
                let cmp = boila_val_cmp(pkv, v_lo)
                if cmp != 1 && cmp != 0 { keep = false }
            }
            if keep && has_hi == 1 {
                let cmp = boila_val_cmp(pkv, v_hi)
                if cmp != 0 - 1 && cmp != 0 { keep = false }
            }
        } else {
            if has_lo == 1 || has_hi == 1 {
                let g = boila_txn_get(s, txn, t.id, pkenc)?
                s = g.s
                if g.found == 0 {
                    keep = false
                } else {
                    let row = boila_row_dec(g.row)
                    if has_lo == 1 {
                        if lo_cix < 0 || lo_cix >= vec_len(row) {
                            keep = false
                        } else {
                            let cmp = boila_val_cmp(vec_get(row, lo_cix), v_lo)
                            if cmp != 1 && cmp != 0 { keep = false }
                        }
                    }
                    if keep && has_hi == 1 {
                        if hi_cix < 0 || hi_cix >= vec_len(row) {
                            keep = false
                        } else {
                            let cmp = boila_val_cmp(vec_get(row, hi_cix), v_hi)
                            if cmp != 0 - 1 && cmp != 0 { keep = false }
                        }
                    }
                }
            }
        }
        if keep {
            vec_push(pks, pkenc)
        }
        ki = ki + 1
    }
    return BoilaDmlTgts { s: s, txn: txn, ok: 1, err: "", state: "", pks: pks }
}

fn boila_exec_update(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, upd: BoilaUpd) -> BoilaDml !IO !Time !Par {
    let six: Vec<i64> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(upd.set_cols) {
        let nm = vec_get(upd.set_cols, i)
        let ix = boila_col_idx(t, nm)
        if ix < 0 {
            return boila_dml_fail(s, txn, 7, concat("SET колона '", concat(nm, "' не съществува")), "42703")
        }
        if ix == t.pk_idx {
            return boila_dml_fail(s, txn, 7, "SET върху PRIMARY KEY не се поддържа в P4", "0A000")
        }
        vec_push(six, ix)
        i = i + 1
    }
    let mut res = boila_result_empty()
    if upd.has_ret == 1 {
        let pj = boila_dml_proj(t, upd.ret_star, upd.ret_cols)
        if pj.ok == 0 {
            return boila_dml_fail(s, txn, 7, pj.err, pj.state)
        }
        i = 0
        while i < vec_len(t.cols) {
            let cd = vec_get(t.cols, i)
            if upd.ret_star == 1 {
                boila_result_add_col(res, cd.name, cd.typ)
            } else {
                let mut k: i64 = 0
                while k < vec_len(pj.proj) {
                    if vec_get(pj.proj, k) == i {
                        boila_result_add_col(res, cd.name, cd.typ)
                    }
                    k = k + 1
                }
            }
            i = i + 1
        }
    }
    let pj2 = boila_dml_proj(t, upd.ret_star, upd.ret_cols)
    let tg = boila_dml_targets(s, txn, t, upd.eq_col, upd.has_eq, upd.pk_eq, upd.lo_col, upd.has_lo, upd.pk_lo, upd.hi_col, upd.has_hi, upd.pk_hi)?
    s = tg.s
    txn = tg.txn
    if tg.ok == 0 {
        return boila_dml_fail(s, txn, 7, tg.err, tg.state)
    }
    let ftsl = fts_list_for_table(s, t.id)?
    s = ftsl.s
    let hnswl = hnsw_list_for_table(s, t.id)?
    s = hnswl.s
    let grpl = graph_list_for_table(s, t.id)?
    s = grpl.s
    let mut affected: i64 = 0
    let mut r: i64 = 0
    while r < vec_len(tg.pks) {
        let pkenc = vec_get(tg.pks, r)
        let g = boila_txn_get(s, txn, t.id, pkenc)?
        s = g.s
        if g.found == 1 {
            let old = boila_row_dec(g.row)
            let new = boila_row_copy(old)
            let mut c: i64 = 0
            while c < vec_len(six) {
                let v = vec_get(upd.set_vals, c)
                let cd = vec_get(t.cols, vec_get(six, c))
                if boila_dml_val_ok(cd.typ, v) == 0 {
                    return boila_dml_fail(s, txn, 7, concat("стойност за '", concat(cd.name, "' не съответства на типа")), "42804")
                }
                vec_set(new, vec_get(six, c), boila_dml_coerce(cd.typ, v))
                c = c + 1
            }
            let xd = boila_ix_del_all_txn(s, txn, t, old, pkenc)
            if xd.ok == 0 {
                return boila_dml_fail(s, txn, 7, xd.err, xd.state)
            }
            txn = xd.txn
            let pw = boila_txn_put(s, txn, boila_cf_data(), t.id, pkenc, boila_row_enc(new))
            if pw.ok == 0 {
                return boila_dml_fail(s, txn, 7, pw.err, pw.state)
            }
            txn = pw.txn
            let pw2 = boila_ix_put_all_txn(s, txn, t, new, pkenc)
            if pw2.ok == 0 {
                return boila_dml_fail(s, txn, 7, pw2.err, pw2.state)
            }
            txn = pw2.txn
            let mut fi: i64 = 0
            while fi < vec_len(ftsl.defs) {
                let d = vec_get(ftsl.defs, fi)
                let fu = fts_unindex_doc(s, txn, t.id, d.id, pkenc)?
                s = fu.s
                txn = fu.txn
                if d.col_idx < vec_len(new) {
                    let v = vec_get(new, d.col_idx)
                    if v.tag == boila_v_str() {
                        let fw = fts_index_doc(s, txn, t.id, d.id, pkenc, str_of_bytes(v.b))?
                        s = fw.s
                        txn = fw.txn
                    }
                }
                fi = fi + 1
            }
            let mut hi: i64 = 0
            while hi < vec_len(hnswl.defs) {
                let d = vec_get(hnswl.defs, hi)
                let hu = hnsw_unindex_doc(s, txn, t.id, d, pkenc)?
                s = hu.s
                txn = hu.txn
                if d.col_idx < vec_len(new) {
                    let hw = hnsw_index_doc(s, txn, t, d, pkenc, vec_get(new, d.col_idx))?
                    s = hw.s
                    txn = hw.txn
                }
                hi = hi + 1
            }
            let gs = graph_sync_row(s, txn, t.id, grpl.defs, old, 1, new, 1)?
            s = gs.s
            txn = gs.txn
            if gs.ok == 0 {
                return boila_dml_fail(s, txn, 7, gs.err, gs.state)
            }
            affected = affected + 1
            if upd.has_ret == 1 {
                vec_push(res.rows, boila_project(new, pj2.proj))
            }
        }
        r = r + 1
    }
    return boila_dml_ok(s, txn, 7, affected, res)
}

fn boila_exec_delete(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, del: BoilaDel) -> BoilaDml !IO !Time !Par {
    let mut res = boila_result_empty()
    if del.has_ret == 1 {
        let pj = boila_dml_proj(t, del.ret_star, del.ret_cols)
        if pj.ok == 0 {
            return boila_dml_fail(s, txn, 8, pj.err, pj.state)
        }
        let mut i: i64 = 0
        while i < vec_len(t.cols) {
            let cd = vec_get(t.cols, i)
            if del.ret_star == 1 {
                boila_result_add_col(res, cd.name, cd.typ)
            } else {
                let mut k: i64 = 0
                while k < vec_len(pj.proj) {
                    if vec_get(pj.proj, k) == i {
                        boila_result_add_col(res, cd.name, cd.typ)
                    }
                    k = k + 1
                }
            }
            i = i + 1
        }
    }
    let pj2 = boila_dml_proj(t, del.ret_star, del.ret_cols)
    let tg = boila_dml_targets(s, txn, t, del.eq_col, del.has_eq, del.pk_eq, del.lo_col, del.has_lo, del.pk_lo, del.hi_col, del.has_hi, del.pk_hi)?
    s = tg.s
    txn = tg.txn
    if tg.ok == 0 {
        return boila_dml_fail(s, txn, 8, tg.err, tg.state)
    }
    let ftsl = fts_list_for_table(s, t.id)?
    s = ftsl.s
    let hnswl = hnsw_list_for_table(s, t.id)?
    s = hnswl.s
    let grpl = graph_list_for_table(s, t.id)?
    s = grpl.s
    let mut affected: i64 = 0
    let mut r: i64 = 0
    while r < vec_len(tg.pks) {
        let pkenc = vec_get(tg.pks, r)
        let g = boila_txn_get(s, txn, t.id, pkenc)?
        s = g.s
        if g.found == 1 {
            let old = boila_row_dec(g.row)
            let xd = boila_ix_del_all_txn(s, txn, t, old, pkenc)
            if xd.ok == 0 {
                return boila_dml_fail(s, txn, 8, xd.err, xd.state)
            }
            txn = xd.txn
            let mut fi: i64 = 0
            while fi < vec_len(ftsl.defs) {
                let d = vec_get(ftsl.defs, fi)
                let fu = fts_unindex_doc(s, txn, t.id, d.id, pkenc)?
                s = fu.s
                txn = fu.txn
                fi = fi + 1
            }
            let mut hi: i64 = 0
            while hi < vec_len(hnswl.defs) {
                let d = vec_get(hnswl.defs, hi)
                let hu = hnsw_unindex_doc(s, txn, t.id, d, pkenc)?
                s = hu.s
                txn = hu.txn
                hi = hi + 1
            }
            let empty: Vec<BoilaVal> = vec_new()
            let gs = graph_sync_row(s, txn, t.id, grpl.defs, old, 1, empty, 0)?
            s = gs.s
            txn = gs.txn
            if gs.ok == 0 {
                return boila_dml_fail(s, txn, 8, gs.err, gs.state)
            }
            let dd = boila_txn_del(s, txn, boila_cf_data(), t.id, pkenc)
            if dd.ok == 0 {
                return boila_dml_fail(s, txn, 8, dd.err, dd.state)
            }
            txn = dd.txn
            affected = affected + 1
            if del.has_ret == 1 {
                vec_push(res.rows, boila_project(old, pj2.proj))
            }
        }
        r = r + 1
    }
    return boila_dml_ok(s, txn, 8, affected, res)
}
