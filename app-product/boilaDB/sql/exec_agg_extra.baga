// exec_agg_extra.baga — структури и чисти помощници за агрегацията (P5).
// exec_agg.baga държи само exec логиката и импорт-ва този файл.

import "../core/value.baga"
import "../catalog/schema.baga"
import "ast.baga"
import "exec_scan.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

struct BoilaAggAcc {
    n: i64,
    cnt: Vec<i64>,
    sum: Vec<i64>,
    hasv: Vec<i64>,
    minv: Vec<BoilaVal>,
    maxv: Vec<BoilaVal>,
    first: Vec<BoilaVal>
}

fn boila_agg_new_acc(nitems: i64, first_row: Vec<BoilaVal>) -> BoilaAggAcc {
    let cnt: Vec<i64> = vec_new()
    let sum: Vec<i64> = vec_new()
    let hasv: Vec<i64> = vec_new()
    let mn: Vec<BoilaVal> = vec_new()
    let mx: Vec<BoilaVal> = vec_new()
    let z = BoilaVal { tag: 0, i: 0, b: bytes_new(0) }
    let mut i: i64 = 0
    while i < nitems {
        vec_push(cnt, 0)
        vec_push(sum, 0)
        vec_push(hasv, 0)
        vec_push(mn, z)
        vec_push(mx, z)
        i = i + 1
    }
    return BoilaAggAcc { n: 0, cnt: cnt, sum: sum, hasv: hasv, minv: mn, maxv: mx, first: first_row }
}

// Сериализиран ключ на група от стойностите на group колоните.
fn boila_agg_key(row: Vec<BoilaVal>, gixs: Vec<i64>) -> bytes {
    let mut out = bytes_new(0)
    let mut i: i64 = 0
    while i < vec_len(gixs) {
        let ix = vec_get(gixs, i)
        if ix >= 0 && ix < vec_len(row) {
            out = bytes_concat(out, boila_val_enc(vec_get(row, ix)))
        }
        out = bytes_concat(out, bytes_of_str("|"))
        i = i + 1
    }
    return out
}

fn boila_agg_item_name(it: BoilaSelItem) -> str {
    if it.alias != "" {
        return it.alias
    }
    // Q-aexpr: sum(sal+1) → "sum" (no column suffix)
    if vec_len(it.xtoks) > 0 && it.col == "" {
        return boila_agg_item_name_base(it.agg)
    }
    if it.agg == 1 {
        return "count"
    }
    if it.agg == 2 {
        return concat("count_", it.col)
    }
    if it.agg == 3 {
        return concat("sum_", it.col)
    }
    if it.agg == 4 {
        return concat("avg_", it.col)
    }
    if it.agg == 5 {
        return concat("min_", it.col)
    }
    return concat("max_", it.col)
}

// Q-gexpr: SELECT list has scalar fn or projection-expression items
// (not aggregate-argument xtoks).
fn boila_agg_has_gexpr(sel: BoilaSel) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(sel.items) {
        let it = vec_get(sel.items, i)
        if it.agg == 0 && (it.sfn != "" || vec_len(it.xtoks) > 0) {
            return 1
        }
        i = i + 1
    }
    return 0
}

// Q-gbyx: any GROUP BY expression keys?
fn boila_agg_has_gbyx(sel: BoilaSel) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(sel.group_xtoks) {
        if vec_len(vec_get(sel.group_xtoks, i)) > 0 {
            return 1
        }
        i = i + 1
    }
    return 0
}

// HAVING helpers → exec_agg_hav.baga (Q-havx / Q-havand).

// Single aggregate cell from an accumulator slot.
fn boila_agg_cell(acc: BoilaAggAcc, it: BoilaSelItem, a: i64) -> BoilaVal {
    if it.agg == 1 || it.agg == 2 {
        return boila_val_i64(vec_get(acc.cnt, a))
    }
    if it.agg == 3 {
        if vec_get(acc.hasv, a) == 0 {
            return boila_val_null()
        }
        return boila_val_i64(vec_get(acc.sum, a))
    }
    if it.agg == 4 {
        let c = vec_get(acc.cnt, a)
        if c == 0 {
            return boila_val_null()
        }
        return boila_val_i64(vec_get(acc.sum, a) / c)
    }
    if it.agg == 5 {
        if vec_get(acc.hasv, a) == 0 {
            return boila_val_null()
        }
        return vec_get(acc.minv, a)
    }
    if vec_get(acc.hasv, a) == 0 {
        return boila_val_null()
    }
    return vec_get(acc.maxv, a)
}

// Index of this agg item among agg_items (order of appearance).
fn boila_agg_slot(agg_items: Vec<BoilaSelItem>, it: BoilaSelItem) -> i64 {
    let mut a: i64 = 0
    while a < vec_len(agg_items) {
        let x = vec_get(agg_items, a)
        if x.agg == it.agg && x.col == it.col && vec_len(x.xtoks) == vec_len(it.xtoks) {
            return a
        }
        a = a + 1
    }
    return 0 - 1
}

// Дали group_col е в group_cols.
fn boila_agg_in_group(sel: BoilaSel, col: str) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(sel.group_cols) {
        if vec_get(sel.group_cols, i) == col {
            return 1
        }
        i = i + 1
    }
    return 0
}

// Изходен ред на група: group стойности + агрегати.
fn boila_agg_row(acc: BoilaAggAcc, gixs: Vec<i64>, agg_items: Vec<BoilaSelItem>, aixs: Vec<i64>) -> Vec<BoilaVal> {
    let out: Vec<BoilaVal> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(gixs) {
        let ix = vec_get(gixs, i)
        if ix >= 0 && ix < vec_len(acc.first) {
            vec_push(out, vec_get(acc.first, ix))
        } else {
            vec_push(out, boila_val_null())
        }
        i = i + 1
    }
    let mut a: i64 = 0
    while a < vec_len(agg_items) {
        vec_push(out, boila_agg_cell(acc, vec_get(agg_items, a), a))
        a = a + 1
    }
    return out
}

struct BoilaAggExtra {
    ok: i64,
    err: str,
    state: str,
    val: i64,
    has: i64
}

// HAVING агрегат извън проекцията — само за единствената група без
// GROUP BY (всички редове). С GROUP BY exec_agg-ът го отказва.
fn boila_agg_extra(cols: Vec<BoilaColDef>, rows: Vec<Vec<BoilaVal>>, kind: i64, col: str) -> BoilaAggExtra {
    let ix = boila_col_idx_of(cols, col)
    if ix < 0 {
        return BoilaAggExtra { ok: 0, err: concat("HAVING колона '", concat(col, "' не съществува")), state: "42703", val: 0, has: 0 }
    }
    let mut cnt: i64 = 0
    let mut sum: i64 = 0
    let mut has: i64 = 0
    let mut mn: i64 = 0
    let mut mx: i64 = 0
    let mut r: i64 = 0
    while r < vec_len(rows) {
        let row = vec_get(rows, r)
        let v = vec_get(row, ix)
        if v.tag != boila_v_null() {
            cnt = cnt + 1
            sum = sum + v.i
            if has == 0 {
                mn = v.i
                mx = v.i
                has = 1
            } else {
                if v.i < mn {
                    mn = v.i
                }
                if v.i > mx {
                    mx = v.i
                }
            }
        }
        r = r + 1
    }
    if kind == 2 {
        return BoilaAggExtra { ok: 1, err: "", state: "", val: cnt, has: 1 }
    }
    if kind == 3 {
        return BoilaAggExtra { ok: 1, err: "", state: "", val: sum, has: has }
    }
    if kind == 4 {
        if cnt == 0 {
            return BoilaAggExtra { ok: 1, err: "", state: "", val: 0, has: 0 }
        }
        return BoilaAggExtra { ok: 1, err: "", state: "", val: sum / cnt, has: 1 }
    }
    if kind == 5 {
        return BoilaAggExtra { ok: 1, err: "", state: "", val: mn, has: has }
    }
    return BoilaAggExtra { ok: 1, err: "", state: "", val: mx, has: has }
}
