// tsquery.baga — парсер за tsquery низове (P7).
// to_tsquery: tokens разделени с интервал; '&' → AND, '|' → OR
// (смесване → 0A000). plainto_tsquery: всички думи са terms, режим AND.

import "std/bytes/bytes.baga"
import "std/str/str.baga"

struct BoilaTsParse {
    ok: i64,
    mode: i64,
    terms: Vec<str>,
    err: str,
    state: str
}

fn boila_ts_parse(s: str, plain: i64) -> BoilaTsParse {
    let terms: Vec<str> = vec_new()
    let sb = bytes_of_str(s)
    let n = bytes_len(sb)
    let mut has_and = false
    let mut has_or = false
    let mut run = bytes_new(0)
    let mut i: i64 = 0
    while i <= n {
        let mut is_sep = i == n
        if is_sep == false {
            let c = bytes_at(sb, i) & 255
            if c == 32 || c == 9 {
                is_sep = true
            }
        }
        if is_sep {
            if bytes_len(run) > 0 {
                let tok = str_of_bytes(run)
                if plain == 0 && tok == "&" {
                    has_and = true
                } else {
                    if plain == 0 && tok == "|" {
                        has_or = true
                    } else {
                        vec_push(terms, tok)
                    }
                }
                run = bytes_new(0)
            }
        } else {
            let one = bytes_new(1)
            bytes_set(one, 0, bytes_at(sb, i) & 255)
            run = bytes_concat(run, one)
        }
        i = i + 1
    }
    if has_and && has_or {
        return BoilaTsParse { ok: 0, mode: 1, terms: terms, err: "tsquery: смесване на '&' и '|' не е в P7", state: "0A000" }
    }
    let mut mode: i64 = 1
    if has_or {
        mode = 2
    }
    return BoilaTsParse { ok: 1, mode: mode, terms: terms, err: "", state: "" }
}
