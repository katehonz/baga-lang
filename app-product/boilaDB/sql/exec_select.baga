// exec_select.baga — SELECT оркестраторът (P5): fetch/join → агрегати →
// ORDER BY → проекция → DISTINCT → OFFSET/LIMIT.

import "../storage/shards.baga"
import "../core/value.baga"
import "../catalog/schema.baga"
import "../txn/mvcc.baga"
import "ast.baga"
import "sfn.baga"
import "token.baga"
import "lexer.baga"
import "exec_scan.baga"
import "exec_knn.baga"
import "exec_isnull.baga"
import "exec_agg.baga"
import "exec_join.baga"
import "exec_sort.baga"
import "exec_dual_ops.baga"
import "exec_dual_fn.baga"
import "exec_dual_parse.baga"
import "../ts/time_bucket.baga"
import "std/str/str.baga"

fn boila_exec_select(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, sel: BoilaSel) -> BoilaExec !IO !Time !Par {
    // редове + схема
    let mut cols = t.cols
    let mut rows: Vec<Vec<BoilaVal>> = vec_new()
    if sel.has_join == 1 {
        let j = boila_join_rows(s, txn, t, sel)?
        s = j.s
        txn = j.txn
        if j.ok == 0 {
            return boila_exec_fail(s, txn, j.err, j.state)
        }
        cols = j.cols
        rows = j.rows
    } else {
        let mut f = boila_fetch_empty(s, txn)
        if sel.has_knn == 1 {
            f = boila_fetch_knn(s, txn, t, sel)?
        } else {
            if sel.isnull_mode != 0 {
                f = boila_fetch_isnull(s, txn, t, sel)?
            } else {
                f = boila_fetch_rows(s, txn, t, sel)?
            }
        }
        s = f.s
        if f.ok == 0 {
            return boila_exec_fail(s, txn, f.err, f.state)
        }
        rows = f.rows
    }

    // има ли агрегати в проекцията
    let mut has_agg = false
    let mut k: i64 = 0
    while k < vec_len(sel.items) {
        let it = vec_get(sel.items, k)
        if it.agg > 0 {
            has_agg = true
        }
        k = k + 1
    }

    if has_agg == true || sel.has_group == 1 {
        let ag = boila_agg_exec(cols, rows, sel)
        if ag.ok == 0 {
            return boila_exec_fail(s, txn, ag.err, ag.state)
        }
        let mut res = ag.res
        // ORDER BY върху изходните колони
        if sel.has_order == 1 {
            let idxs: Vec<i64> = vec_new()
            let mut i: i64 = 0
            while i < vec_len(sel.ord_cols) {
                let nm = vec_get(sel.ord_cols, i)
                let ix = boila_col_name_idx(res.cols, nm)
                if ix < 0 {
                    return boila_exec_fail(s, txn, concat("ORDER BY колона '", concat(nm, "' не е в изхода")), "42703")
                }
                vec_push(idxs, ix)
                i = i + 1
            }
            boila_sort_rows(res.rows, idxs, sel.ord_desc)
        }
        if sel.distinct == 1 {
            res.rows = boila_distinct_rows(res.rows)
        }
        res.rows = boila_apply_offlim(res.rows, sel.offset, sel.limit)
        return boila_exec_ok_select(s, txn, res)
    }

    // S7b: ORDER BY on source cols if all resolve; else after projection
    // (time_bucket / AS alias live only in output names).
    let mut order_after = 0
    if sel.has_order == 1 {
        let idxs: Vec<i64> = vec_new()
        let mut i: i64 = 0
        let mut all_src = 1
        while i < vec_len(sel.ord_cols) {
            let nm = vec_get(sel.ord_cols, i)
            let ix = boila_col_idx_of(cols, nm)
            if ix < 0 {
                all_src = 0
            }
            vec_push(idxs, ix)
            i = i + 1
        }
        if all_src == 1 {
            boila_sort_rows(rows, idxs, sel.ord_desc)
        } else {
            order_after = 1
        }
    }

    // проекция (S7: time_bucket + AS alias; Q-sfn: scalar fn items)
    let mut res = boila_result_empty()
    let proj: Vec<i64> = vec_new()
    let bivs: Vec<i64> = vec_new()
    let sitems: Vec<BoilaSelItem> = vec_new()
    if sel.star == 1 {
        let mut i: i64 = 0
        while i < vec_len(cols) {
            let cd = vec_get(cols, i)
            boila_result_add_col(res, cd.name, cd.typ)
            vec_push(proj, i)
            vec_push(bivs, 0)
            vec_push(sitems, boila_sel_item_col(""))
            i = i + 1
        }
    } else {
        let mut i: i64 = 0
        while i < vec_len(sel.items) {
            let it = vec_get(sel.items, i)
            if vec_len(it.xtoks) > 0 {
                // Q-expr: NULL-bound probe → early errors + static type
                let pr = boila_expr_probe(cols, it.xtoks)?
                if pr.ok == 0 {
                    return boila_exec_fail(s, txn, pr.err, pr.state)
                }
                if pr.pos < vec_len(it.xtoks) {
                    return boila_exec_fail(s, txn, concat("неочакван токен '", concat(vec_get(it.xtoks, pr.pos).txt, "' в израз")), "42601")
                }
                if pr.series == 1 {
                    return boila_exec_fail(s, txn, "generate_series е само за dual (без FROM)", "0A000")
                }
                let mut ty = pr.tag
                if ty == boila_v_null() {
                    ty = boila_expr_type_guess(it.xtoks)
                }
                boila_result_add_col(res, boila_sel_item_out_name(it), ty)
                vec_push(proj, 0 - 1)
                vec_push(bivs, 0)
                vec_push(sitems, it)
            } else {
                if it.sfn != "" {
                    // Q-sfn: resolve arg cols, static output type
                    let mut t0: i64 = boila_v_str()
                    let mut have_t0: i64 = 0
                    let mut a: i64 = 0
                    while a < vec_len(it.sfn_cols) {
                        let cn = vec_get(it.sfn_cols, a)
                        if cn != "" {
                            let ax = boila_col_idx_of(cols, cn)
                            if ax < 0 {
                                return boila_exec_fail(s, txn, concat("колона '", concat(cn, "' не съществува")), "42703")
                            }
                            if have_t0 == 0 {
                                t0 = vec_get(cols, ax).typ
                                have_t0 = 1
                            }
                        } else {
                            if have_t0 == 0 {
                                t0 = vec_get(it.sfn_vals, a).tag
                                have_t0 = 1
                            }
                        }
                        a = a + 1
                    }
                    boila_result_add_col(res, boila_sel_item_out_name(it), boila_sfn_out_type(it.sfn, t0))
                    vec_push(proj, 0 - 1)
                    vec_push(bivs, 0)
                    vec_push(sitems, it)
                } else {
                    let ix = boila_col_idx_of(cols, it.col)
                    if ix < 0 {
                        return boila_exec_fail(s, txn, concat("колона '", concat(it.col, "' не съществува")), "42703")
                    }
                    let cd = vec_get(cols, ix)
                    boila_result_add_col(res, boila_sel_item_out_name(it), cd.typ)
                    vec_push(proj, ix)
                    vec_push(bivs, it.biv)
                    vec_push(sitems, boila_sel_item_col(""))
                }
            }
            i = i + 1
        }
    }
    let xnames: Vec<str> = vec_new()
    let mut xn: i64 = 0
    while xn < vec_len(cols) {
        vec_push(xnames, vec_get(cols, xn).name)
        xn = xn + 1
    }
    let eguc: Map<str, str> = map_new()
    let mut r: i64 = 0
    while r < vec_len(rows) {
        let src = vec_get(rows, r)
        let out: Vec<BoilaVal> = vec_new()
        let mut j: i64 = 0
        while j < vec_len(proj) {
            let sit = vec_get(sitems, j)
            let mut v = boila_val_null()
            if vec_len(sit.xtoks) > 0 {
                let fx = boila_expr_eval(xnames, sit.xtoks, src, "", eguc)?
                if fx.ok == 0 {
                    return boila_exec_fail(s, txn, fx.err, fx.state)
                }
                v = fx.val
            } else {
                if sit.sfn != "" {
                    let args: Vec<BoilaVal> = vec_new()
                    let tags: Vec<i64> = vec_new()
                    let mut a: i64 = 0
                    while a < vec_len(sit.sfn_cols) {
                        let cn = vec_get(sit.sfn_cols, a)
                        let mut av = vec_get(sit.sfn_vals, a)
                        if cn != "" {
                            let ax = boila_col_idx_of(cols, cn)
                            if ax >= 0 && ax < vec_len(src) {
                                av = vec_get(src, ax)
                            }
                        }
                        vec_push(args, av)
                        vec_push(tags, av.tag)
                        a = a + 1
                    }
                    let fr = boila_sfn_call(sit.sfn, args, tags)
                    if fr.ok == 0 {
                        return boila_exec_fail(s, txn, fr.err, fr.state)
                    }
                    v = fr.val
                } else {
                    let ix = vec_get(proj, j)
                    if ix >= 0 && ix < vec_len(src) {
                        v = vec_get(src, ix)
                    }
                    let bv = vec_get(bivs, j)
                    if bv > 0 {
                        v = boila_tb_apply(v, bv)
                    }
                }
            }
            vec_push(out, v)
            j = j + 1
        }
        vec_push(res.rows, out)
        r = r + 1
    }
    if order_after == 1 {
        let idxs: Vec<i64> = vec_new()
        let mut i: i64 = 0
        while i < vec_len(sel.ord_cols) {
            let nm = vec_get(sel.ord_cols, i)
            let ix = boila_col_name_idx(res.cols, nm)
            if ix < 0 {
                return boila_exec_fail(s, txn, concat("ORDER BY колона '", concat(nm, "' не е в изхода")), "42703")
            }
            vec_push(idxs, ix)
            i = i + 1
        }
        boila_sort_rows(res.rows, idxs, sel.ord_desc)
    }
    if sel.distinct == 1 {
        res.rows = boila_distinct_rows(res.rows)
    }
    res.rows = boila_apply_offlim(res.rows, sel.offset, sel.limit)
    return boila_exec_ok_select(s, txn, res)
}

// Име на колона в изходен списък (за ORDER BY след агрегация).
fn boila_col_name_idx(names: Vec<str>, name: str) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(names) {
        if vec_get(names, i) == name {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// Q-sfn: dispatch to the dual scalar-fn machinery (shared semantics).
fn boila_sfn_call(fnm: str, args: Vec<BoilaVal>, tags: Vec<i64>) -> BoilaDualExpr {
    if vec_len(args) == 1 {
        return boila_dual_call_unary(fnm, vec_get(args, 0), vec_get(tags, 0), 0)
    }
    return boila_dual_call_multi(fnm, args, tags, 0)
}

// Q-expr: evaluate a token-span expression; names/vals are the bound
// columns of the current row (db/guc empty — session fns are dual-only).
fn boila_expr_eval(names: Vec<str>, xtoks: Vec<Token>, vals: Vec<BoilaVal>, db: str, guc: Map<str, str>) -> BoilaDualExpr !Time {
    let lx = BoilaLex { toks: xtoks, err: "" }
    let bind = BoilaDualBind { on: 1, names: names, vals: vals }
    return boila_dual_parse_expr(lx, 0, db, guc, bind)?
}

// Q-expr: NULL-bound probe — early errors + static output type.
fn boila_expr_probe(cols: Vec<BoilaColDef>, xtoks: Vec<Token>) -> BoilaDualExpr !Time {
    let names: Vec<str> = vec_new()
    let vals: Vec<BoilaVal> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(cols) {
        vec_push(names, vec_get(cols, i).name)
        vec_push(vals, boila_val_null())
        i = i + 1
    }
    let g: Map<str, str> = map_new()
    return boila_expr_eval(names, xtoks, vals, "", g)?
}

// Q-expr: type fallback when the NULL probe yields NULL.
fn boila_expr_type_guess(xtoks: Vec<Token>) -> i64 {
    let mut has_cmp: i64 = 0
    let mut has_str: i64 = 0
    let mut has_arith: i64 = 0
    let mut i: i64 = 0
    while i < vec_len(xtoks) {
        let t = vec_get(xtoks, i)
        if t.kind == tok_op() {
            if t.txt == "=" || t.txt == "<" || t.txt == ">" || t.txt == "<=" || t.txt == ">=" || t.txt == "<>" || t.txt == "!=" {
                has_cmp = 1
            } else {
                if t.txt == "||" { has_str = 1 } else { if t.txt != "::" { has_arith = 1 } }
            }
        } else {
            if t.kind == tok_star() { has_arith = 1 }
        }
        if tok_kw(t, "like") == 1 || tok_kw(t, "ilike") == 1 || tok_kw(t, "between") == 1 || tok_kw(t, "in") == 1 || tok_kw(t, "is") == 1 {
            has_cmp = 1
        }
        i = i + 1
    }
    if has_cmp == 1 {
        return boila_v_bool()
    }
    if has_str == 1 {
        return boila_v_str()
    }
    if has_arith == 1 {
        return boila_v_i64()
    }
    return boila_v_str()
}
