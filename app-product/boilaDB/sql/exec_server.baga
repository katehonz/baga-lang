// exec_server.baga — CREATE/DROP DATABASE, USE + store exec.
//
// boila_server_exec(srv, db, sql) — single-thread: uses srv.session_txn
// boila_server_exec_tx(srv, txn, db, sql) — MT: external per-conn txn
// boila_server_exec_sel — W2 prepared SELECT (bound AST, no re-parse)

import "lexer.baga"
import "token.baga"
import "parse_ddl.baga"
import "exec_sql.baga"
import "exec_out.baga"
import "exec_show.baga"
import "exec_show_acl.baga"
import "exec_acl.baga"
import "exec_select.baga"
import "plan_cache.baga"
import "../catalog/acl.baga"
import "exec_scan.baga"
import "ast.baga"
import "../catalog/schema.baga"
import "../storage/databases.baga"
import "../txn/mvcc.baga"
import "../core/row.baga"
import "std/str/str.baga"

struct BoilaSrvOut {
    srv: BoilaServer,
    txn: BoilaTxn,
    ok: i64,
    err: str,
    state: str,
    kind: i64,
    res: BoilaResult,
    id: i64,
    db: str
}

fn boila_srv_out_fail(srv: BoilaServer, txn: BoilaTxn, msg: str, state: str) -> BoilaSrvOut {
    return BoilaSrvOut { srv: srv, txn: txn, ok: 0, err: msg, state: state, kind: 0, res: boila_result_empty(), id: 0, db: "" }
}

// Single-thread / tests: txn lives on srv.session_txn.
fn boila_server_exec(srv: BoilaServer, db: str, sql: str) -> BoilaSrvOut !IO !Time !Par {
    let out = boila_server_exec_tx(srv, srv.session_txn, db, sql)?
    out.srv.session_txn = out.txn
    return out
}

// MT path: caller owns txn.
fn boila_server_exec_tx(srv: BoilaServer, txn: BoilaTxn, db: str, sql: str) -> BoilaSrvOut !IO !Time !Par {
    let lx = boila_lex(sql)
    if lx.err != "" {
        return boila_srv_out_fail(srv, txn, lx.err, "42601")
    }
    let t0 = vec_get(lx.toks, 0)
    if t0.kind == tok_eof() {
        return boila_srv_out_fail(srv, txn, "празна заявка", "42601")
    }

    // --- users / roles / grants (meta ACL) ---
    if tok_kw(t0, "create") == 1 && vec_len(lx.toks) > 1 && (tok_kw(vec_get(lx.toks, 1), "user") == 1 || tok_kw(vec_get(lx.toks, 1), "role") == 1) {
        let r = boila_exec_create_user(srv.meta, srv.guc, lx)?
        srv.meta = r.meta
        srv.guc = r.guc
        if r.ok == 0 { return boila_srv_out_fail(srv, txn, r.err, r.state) }
        return BoilaSrvOut { srv: srv, txn: txn, ok: 1, err: "", state: "", kind: r.kind, res: boila_result_empty(), id: 0, db: r.name }
    }
    if tok_kw(t0, "drop") == 1 && vec_len(lx.toks) > 1 && (tok_kw(vec_get(lx.toks, 1), "user") == 1 || tok_kw(vec_get(lx.toks, 1), "role") == 1) {
        let r = boila_exec_drop_user(srv.meta, srv.guc, lx)?
        srv.meta = r.meta
        srv.guc = r.guc
        if r.ok == 0 { return boila_srv_out_fail(srv, txn, r.err, r.state) }
        return BoilaSrvOut { srv: srv, txn: txn, ok: 1, err: "", state: "", kind: r.kind, res: boila_result_empty(), id: 0, db: r.name }
    }
    if tok_kw(t0, "alter") == 1 && vec_len(lx.toks) > 1 && (tok_kw(vec_get(lx.toks, 1), "user") == 1 || tok_kw(vec_get(lx.toks, 1), "role") == 1) {
        let r = boila_exec_alter_user(srv.meta, srv.guc, lx)?
        srv.meta = r.meta
        srv.guc = r.guc
        if r.ok == 0 { return boila_srv_out_fail(srv, txn, r.err, r.state) }
        return BoilaSrvOut { srv: srv, txn: txn, ok: 1, err: "", state: "", kind: r.kind, res: boila_result_empty(), id: 0, db: r.name }
    }
    if tok_kw(t0, "grant") == 1 {
        let r = boila_exec_grant_rev(srv.meta, srv.guc, db, lx, 0)?
        srv.meta = r.meta
        srv.guc = r.guc
        if r.ok == 0 { return boila_srv_out_fail(srv, txn, r.err, r.state) }
        return BoilaSrvOut { srv: srv, txn: txn, ok: 1, err: "", state: "", kind: r.kind, res: boila_result_empty(), id: 0, db: r.name }
    }
    if tok_kw(t0, "revoke") == 1 {
        let r = boila_exec_grant_rev(srv.meta, srv.guc, db, lx, 1)?
        srv.meta = r.meta
        srv.guc = r.guc
        if r.ok == 0 { return boila_srv_out_fail(srv, txn, r.err, r.state) }
        return BoilaSrvOut { srv: srv, txn: txn, ok: 1, err: "", state: "", kind: r.kind, res: boila_result_empty(), id: 0, db: r.name }
    }

    // ACL gate (empty session user = open/legacy mode)
    if boila_sess_user(srv.guc) != "" {
        let need = boila_acl_need_sql(lx)
        if need.skip == 0 {
            let chk = boila_acl_require(srv.meta, srv.guc, db, need.table, need.need)?
            srv.meta = chk.s
            if chk.ok == 0 {
                return boila_srv_out_fail(srv, txn, chk.err, chk.state)
            }
        }
    }

    if tok_kw(t0, "create") == 1 && vec_len(lx.toks) > 1 && tok_kw(vec_get(lx.toks, 1), "database") == 1 {
        let p = boila_parse_create_db(lx)
        if p.ok == 0 {
            return boila_srv_out_fail(srv, txn, p.err, p.state)
        }
        let r = boila_srv_db_create(srv, p.name)?
        if r.ok == 0 {
            if p.if_exists == 1 && r.state == "42P04" {
                return BoilaSrvOut { srv: r.srv, txn: txn, ok: 1, err: "", state: "", kind: 3, res: boila_result_empty(), id: 0, db: p.name }
            }
            return boila_srv_out_fail(r.srv, txn, r.err, r.state)
        }
        return BoilaSrvOut { srv: r.srv, txn: txn, ok: 1, err: "", state: "", kind: 3, res: boila_result_empty(), id: 0, db: p.name }
    }

    if tok_kw(t0, "drop") == 1 && vec_len(lx.toks) > 1 && tok_kw(vec_get(lx.toks, 1), "database") == 1 {
        let p = boila_parse_drop_db(lx)
        if p.ok == 0 {
            return boila_srv_out_fail(srv, txn, p.err, p.state)
        }
        let r = boila_srv_db_drop(srv, p.name, db)?
        if r.ok == 0 {
            if p.if_exists == 1 && r.state == "3D000" {
                return BoilaSrvOut { srv: r.srv, txn: txn, ok: 1, err: "", state: "", kind: 4, res: boila_result_empty(), id: 0, db: p.name }
            }
            return boila_srv_out_fail(r.srv, txn, r.err, r.state)
        }
        return BoilaSrvOut { srv: r.srv, txn: txn, ok: 1, err: "", state: "", kind: 4, res: boila_result_empty(), id: 0, db: p.name }
    }

    if tok_kw(t0, "use") == 1 {
        if txn.active == 1 {
            return boila_srv_out_fail(srv, txn, "USE по време на активна транзакция — COMMIT/ROLLBACK първо", "0A000")
        }
        let p = boila_parse_use(lx)
        if p.ok == 0 {
            return boila_srv_out_fail(srv, txn, p.err, p.state)
        }
        let r = boila_srv_db(srv, p.name)?
        if r.ok == 0 {
            return boila_srv_out_fail(r.srv, txn, r.err, r.state)
        }
        return BoilaSrvOut { srv: r.srv, txn: txn, ok: 1, err: "", state: "", kind: 5, res: boila_result_empty(), id: 0, db: p.name }
    }

    // W7b: session GUC; SET ROLE name [PASSWORD 'pw'] | NONE
    // Superuser may switch without password; others must supply PASSWORD.
    if tok_kw(t0, "set") == 1 && vec_len(lx.toks) > 1 && tok_kw(vec_get(lx.toks, 1), "role") == 1 {
        let t2 = vec_get(lx.toks, 2)
        if tok_kw(t2, "none") == 1 {
            srv.guc = boila_sess_set_user(srv.guc, "", 0)
            map_del(srv.guc, "boila.user")
            map_del(srv.guc, "boila.super")
            return BoilaSrvOut { srv: srv, txn: txn, ok: 1, err: "", state: "", kind: 19, res: boila_result_empty(), id: 0, db: db }
        }
        if t2.kind != tok_ident() {
            return boila_srv_out_fail(srv, txn, "SET ROLE name [PASSWORD '…'] | NONE", "42601")
        }
        let target = t2.txt
        let mut i: i64 = 3
        let mut pw = ""
        let mut has_pw: i64 = 0
        if tok_kw(vec_get(lx.toks, i), "password") == 1 || (tok_kw(vec_get(lx.toks, i), "with") == 1 && tok_kw(vec_get(lx.toks, i + 1), "password") == 1) {
            if tok_kw(vec_get(lx.toks, i), "with") == 1 { i = i + 1 }
            i = i + 1
            let pt = vec_get(lx.toks, i)
            if pt.kind != tok_str() {
                return boila_srv_out_fail(srv, txn, "очаквах string след PASSWORD", "42601")
            }
            pw = pt.txt
            has_pw = 1
        }
        let cur = boila_sess_user(srv.guc)
        let cur_sup = boila_sess_super(srv.guc)
        // need password unless current is superuser (or open mode switching with pw)
        if has_pw == 1 {
            let ar = boila_acl_auth(srv.meta, target, pw)?
            srv.meta = ar.s
            if ar.ok == 0 {
                return boila_srv_out_fail(srv, txn, ar.err, ar.state)
            }
            srv.guc = boila_sess_set_user(srv.guc, target, ar.super)
            return BoilaSrvOut { srv: srv, txn: txn, ok: 1, err: "", state: "", kind: 19, res: boila_result_empty(), id: 0, db: db }
        }
        // no password: only superuser (or same role) may switch
        if cur_sup == 0 && cur != target {
            return boila_srv_out_fail(srv, txn, "SET ROLE изисква PASSWORD (или superuser)", "42501")
        }
        if cur_sup == 0 && cur == "" {
            return boila_srv_out_fail(srv, txn, "SET ROLE изисква PASSWORD", "42501")
        }
        let ug = boila_acl_user_get(srv.meta, target)?
        srv.meta = ug.s
        if ug.ok == 0 {
            return boila_srv_out_fail(srv, txn, ug.err, ug.state)
        }
        srv.guc = boila_sess_set_user(srv.guc, target, ug.super)
        return BoilaSrvOut { srv: srv, txn: txn, ok: 1, err: "", state: "", kind: 19, res: boila_result_empty(), id: 0, db: db }
    }
    if tok_kw(t0, "set") == 1 {
        let gs = boila_guc_set_parse(srv.guc, lx)
        if gs.ok == 0 {
            return boila_srv_out_fail(srv, txn, gs.err, gs.state)
        }
        srv.guc = gs.guc
        return BoilaSrvOut { srv: srv, txn: txn, ok: 1, err: "", state: "", kind: 19, res: boila_result_empty(), id: 0, db: db }
    }
    if tok_kw(t0, "show") == 1 {
        let mut is_meta = 0
        let mut is_dbs = 0
        let mut is_users = 0
        let mut is_grants = 0
        if vec_len(lx.toks) > 1 {
            let t1 = vec_get(lx.toks, 1)
            if tok_kw(t1, "databases") == 1 || tok_kw(t1, "database") == 1 {
                is_dbs = 1
            }
            if tok_kw(t1, "users") == 1 || tok_kw(t1, "roles") == 1 {
                is_users = 1
            }
            if tok_kw(t1, "grants") == 1 {
                is_grants = 1
            }
            if tok_kw(t1, "tables") == 1 || tok_kw(t1, "index") == 1 || tok_kw(t1, "indexes") == 1 || tok_kw(t1, "columns") == 1 || tok_kw(t1, "fields") == 1 || tok_kw(t1, "create") == 1 {
                is_meta = 1
            }
        }
        if is_dbs == 1 {
            let out = boila_show_databases(srv.meta, srv.pc)?
            srv.meta = out.s
            return BoilaSrvOut { srv: srv, txn: txn, ok: 1, err: "", state: "", kind: 1, res: out.res, id: 0, db: db }
        }
        if is_users == 1 {
            let out = boila_show_users(srv.meta, srv.pc)?
            srv.meta = out.s
            return BoilaSrvOut { srv: srv, txn: txn, ok: 1, err: "", state: "", kind: 1, res: out.res, id: 0, db: db }
        }
        if is_grants == 1 {
            let mut fu = ""
            // SHOW GRANTS FOR user
            if vec_len(lx.toks) > 3 && tok_kw(vec_get(lx.toks, 2), "for") == 1 && vec_get(lx.toks, 3).kind == tok_ident() {
                fu = vec_get(lx.toks, 3).txt
            }
            let out = boila_show_grants(srv.meta, srv.pc, fu)?
            srv.meta = out.s
            return BoilaSrvOut { srv: srv, txn: txn, ok: 1, err: "", state: "", kind: 1, res: out.res, id: 0, db: db }
        }
        if is_meta == 1 {
            let g = boila_srv_db(srv, db)?
            if g.ok == 0 {
                return boila_srv_out_fail(g.srv, txn, g.err, g.state)
            }
            srv = g.srv
            let out = boila_exec_show_ex(g.store, txn, srv.pc, lx, srv.guc)?
            srv = boila_srv_store_putback(srv, db, out.s)
            srv.pc = out.pc
            if out.ok == 0 {
                return boila_srv_out_fail(srv, out.txn, out.err, out.state)
            }
            return BoilaSrvOut { srv: srv, txn: out.txn, ok: 1, err: "", state: "", kind: 1, res: out.res, id: 0, db: db }
        }
        let res = boila_guc_show(srv.guc, lx)
        return BoilaSrvOut { srv: srv, txn: txn, ok: 1, err: "", state: "", kind: 1, res: res, id: 0, db: db }
    }
    if tok_kw(t0, "reset") == 1 {
        let gs = boila_guc_reset(srv.guc, lx)
        if gs.ok == 0 {
            return boila_srv_out_fail(srv, txn, gs.err, gs.state)
        }
        srv.guc = gs.guc
        return BoilaSrvOut { srv: srv, txn: txn, ok: 1, err: "", state: "", kind: 20, res: boila_result_empty(), id: 0, db: db }
    }
    if tok_kw(t0, "discard") == 1 {
        let gs = boila_guc_discard(srv.guc, lx)
        if gs.ok == 0 {
            return boila_srv_out_fail(srv, txn, gs.err, gs.state)
        }
        srv.guc = gs.guc
        return BoilaSrvOut { srv: srv, txn: txn, ok: 1, err: "", state: "", kind: 21, res: boila_result_empty(), id: 0, db: db }
    }

    if txn.active == 1 && txn.db != db {
        return boila_srv_out_fail(srv, txn, "транзакция, започната в друга база — COMMIT/ROLLBACK първо", "0A000")
    }
    let g = boila_srv_db(srv, db)?
    if g.ok == 0 {
        return boila_srv_out_fail(g.srv, txn, g.err, g.state)
    }
    let out = boila_exec_sql_guc(g.store, txn, db, sql, g.srv.pc, g.srv.guc)?
    let mut srv2 = boila_srv_store_putback(g.srv, db, out.s)
    srv2.pc = out.pc
    srv2.guc = g.srv.guc
    return BoilaSrvOut { srv: srv2, txn: out.txn, ok: out.ok, err: out.err, state: out.state, kind: out.kind, res: out.res, id: out.id, db: db }
}

// W2: execute a bound SELECT AST (params already filled).
fn boila_server_exec_sel(srv: BoilaServer, txn: BoilaTxn, db: str, sel: BoilaSel) -> BoilaSrvOut !IO !Time !Par {
    if txn.active == 1 && txn.db != db {
        return boila_srv_out_fail(srv, txn, "транзакция, започната в друга база — COMMIT/ROLLBACK първо", "0A000")
    }
    let g = boila_srv_db(srv, db)?
    if g.ok == 0 {
        return boila_srv_out_fail(g.srv, txn, g.err, g.state)
    }
    let ct = boila_cat_by_name_txn(g.store, txn, sel.table)?
    let mut s = ct.s
    if ct.ok == 0 {
        let srv2 = boila_srv_store_putback(g.srv, db, s)
        return boila_srv_out_fail(srv2, txn, ct.err, ct.state)
    }
    let ex = boila_exec_select(s, txn, ct.table, sel)?
    let srv2 = boila_srv_store_putback(g.srv, db, ex.s)
    return BoilaSrvOut {
        srv: srv2, txn: ex.txn, ok: ex.ok, err: ex.err, state: ex.state,
        kind: 1, res: ex.res, id: 0, db: db
    }
}
