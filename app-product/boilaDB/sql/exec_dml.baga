// exec_dml.baga — DML общи структури/помощници + INSERT executor (P4).
// UPDATE/DELETE са в exec_modify.baga (файлова дисциплина, §9).
//
// P4: писанията отиват в txn buffer-а (boila_txn_put/del); commit-ът
// (явен или имплицитен за statement) е в exec_sql. Грешка в заявление →
// exec_sql rollback-ва буфера (T1 затворен за буферизираните писания).

import "../storage/shards.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "../core/row.baga"
import "../catalog/schema.baga"
import "../index/secondary.baga"
import "../fts/fts.baga"
import "../vector/hnsw.baga"
import "../vector/hnsw_store.baga"
import "../vector/distance.baga"
import "../graph/adjacency.baga"
import "../graph/dml.baga"
import "../ts/rollup.baga"
import "../txn/mvcc.baga"
import "ast.baga"
import "exec_scan.baga"
import "exec_proj.baga"
import "exec_xw.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

struct BoilaDml {
    s: BoilaStore,
    txn: BoilaTxn,
    ok: i64,
    err: str,
    state: str,
    kind: i64,      // 6 insert, 7 update, 8 delete
    affected: i64,
    res: BoilaResult
}

fn boila_dml_fail(s: BoilaStore, txn: BoilaTxn, kind: i64, msg: str, state: str) -> BoilaDml {
    return BoilaDml { s: s, txn: txn, ok: 0, err: msg, state: state, kind: kind, affected: 0, res: boila_result_empty() }
}

fn boila_dml_ok(s: BoilaStore, txn: BoilaTxn, kind: i64, affected: i64, res: BoilaResult) -> BoilaDml {
    return BoilaDml { s: s, txn: txn, ok: 1, err: "", state: "", kind: kind, affected: affected, res: res }
}

fn boila_row_copy(row: Vec<BoilaVal>) -> Vec<BoilaVal> {
    let out: Vec<BoilaVal> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(row) {
        vec_push(out, vec_get(row, i))
        i = i + 1
    }
    return out
}

// Дали литерал съответства на типа на колона (null минава навсякъде).
// VECTOR: приема tag=vector или str '[…]'.
fn boila_dml_val_ok(typ: i64, v: BoilaVal) -> i64 {
    if v.tag == boila_v_null() || boila_is_param(v) == 1 {
        return 1
    }
    if boila_is_vec_typ(typ) == 1 {
        let c = boila_vec_coerce(v, boila_vec_dim_of(typ))
        return c.ok
    }
    if typ == boila_v_i64() || typ == boila_v_ts() {
        if v.tag == boila_v_i64() {
            return 1
        }
        return 0
    }
    if v.tag == typ {
        return 1
    }
    return 0
}

fn boila_dml_coerce(typ: i64, v: BoilaVal) -> BoilaVal {
    if boila_is_vec_typ(typ) == 1 && v.tag != boila_v_null() {
        let c = boila_vec_coerce(v, boila_vec_dim_of(typ))
        if c.ok == 1 {
            return c.v
        }
    }
    return v
}

// RETURNING проекция: star → празен proj (всички колони).
struct BoilaDmlProj {
    ok: i64,
    err: str,
    state: str,
    proj: Vec<i64>
}

fn boila_dml_proj(t: BoilaTable, ret_star: i64, ret_cols: Vec<str>) -> BoilaDmlProj {
    let proj: Vec<i64> = vec_new()
    if ret_star == 1 {
        return BoilaDmlProj { ok: 1, err: "", state: "", proj: proj }
    }
    let mut i: i64 = 0
    while i < vec_len(ret_cols) {
        let ix = boila_col_idx(t, vec_get(ret_cols, i))
        if ix < 0 {
            return BoilaDmlProj { ok: 0, err: concat("RETURNING колона '", concat(vec_get(ret_cols, i), "' не съществува")), state: "42703", proj: proj }
        }
        vec_push(proj, ix)
        i = i + 1
    }
    return BoilaDmlProj { ok: 1, err: "", state: "", proj: proj }
}
// Подготовка на INSERT: колони → индекси, pk слот, ON CONFLICT SET,
// Q-oc-expr bind, RETURNING проекция. Един запис на изпълнение.
struct BoilaInsPrep {
    s: BoilaStore,
    txn: BoilaTxn,
    ok: i64,
    err: str,
    state: str,
    cix: Vec<i64>,
    ocix: Vec<i64>,
    xnames: Vec<str>,
    xnulls: Vec<BoilaVal>,
    res: BoilaResult,
    pj2: BoilaDmlProj,
    pk_slot: i64
}

// Резултат от един INSERT ред (upsert или plain put).
struct BoilaInsOne {
    s: BoilaStore,
    txn: BoilaTxn,
    ok: i64,
    err: str,
    state: str,
    affected: i64,
    res: BoilaResult
}

fn boila_insert_prep_fail(s: BoilaStore, txn: BoilaTxn, msg: str, state: str) -> BoilaInsPrep {
    let cix: Vec<i64> = vec_new()
    let ocix: Vec<i64> = vec_new()
    let xnames: Vec<str> = vec_new()
    let xnulls: Vec<BoilaVal> = vec_new()
    let proj: Vec<i64> = vec_new()
    return BoilaInsPrep { s: s, txn: txn, ok: 0, err: msg, state: state, cix: cix, ocix: ocix, xnames: xnames, xnulls: xnulls, res: boila_result_empty(), pj2: BoilaDmlProj { ok: 0, err: msg, state: state, proj: proj }, pk_slot: 0 }
}

fn boila_insert_one_fail(s: BoilaStore, txn: BoilaTxn, msg: str, state: str) -> BoilaInsOne {
    return BoilaInsOne { s: s, txn: txn, ok: 0, err: msg, state: state, affected: 0, res: boila_result_empty() }
}

