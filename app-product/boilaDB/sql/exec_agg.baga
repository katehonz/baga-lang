// exec_agg.baga — агрегати + GROUP BY + HAVING exec логика (P5).
// Структурите и помощниците са в exec_agg_extra.baga.
//
// count(*) брой редове; count(col)/sum/avg/min/max върху не-NULL
// стойности; avg е целочислено деление (gaps A1); sum/avg само за
// i64-тип колони. Групиране: Map<str,i64> hash lookup (S5 / Q-ghash).

import "../core/value.baga"
import "../core/row.baga"
import "../catalog/schema.baga"
import "../ts/time_bucket.baga"
import "ast.baga"
import "token.baga"
import "exec_scan.baga"
import "exec_agg_extra.baga"
import "exec_agg_gexpr.baga"
import "exec_agg_hav.baga"
import "exec_xw.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

struct BoilaAggOut {
    ok: i64,
    err: str,
    state: str,
    res: BoilaResult
}

fn boila_agg_fail(msg: str, state: str) -> BoilaAggOut {
    return BoilaAggOut { ok: 0, err: msg, state: state, res: boila_result_empty() }
}

fn boila_agg_exec(cols: Vec<BoilaColDef>, rows: Vec<Vec<BoilaVal>>, sel: BoilaSel) -> BoilaAggOut !Time {
    // group колони → индекси; -1 = Q-gbyx expression key
    let gixs: Vec<i64> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(sel.group_cols) {
        let nm = vec_get(sel.group_cols, i)
        let mut gxt: Vec<Token> = vec_new()
        if i < vec_len(sel.group_xtoks) {
            gxt = vec_get(sel.group_xtoks, i)
        }
        let mut ix: i64 = 0 - 1
        if vec_len(gxt) > 0 {
            ix = 0 - 1
        } else {
            if nm == "time_bucket" && sel.bucket_iv > 0 {
                ix = boila_col_idx_of(cols, sel.bucket_col)
                if ix < 0 {
                    return boila_agg_fail(concat("time_bucket колона '", concat(sel.bucket_col, "' не съществува")), "42703")
                }
            } else {
                ix = boila_col_idx_of(cols, nm)
                if ix < 0 {
                    return boila_agg_fail(concat("GROUP BY колона '", concat(nm, "' не съществува")), "42703")
                }
            }
        }
        vec_push(gixs, ix)
        i = i + 1
    }
    // bind names for group/agg expressions
    let xnames: Vec<str> = vec_new()
    i = 0
    while i < vec_len(cols) {
        vec_push(xnames, vec_get(cols, i).name)
        i = i + 1
    }
    // P9: bucket on the fly (no full-table materialize — S5)
    let brows = rows
    let mut bucket_ix: i64 = 0 - 1
    if sel.bucket_iv > 0 {
        bucket_ix = boila_col_idx_of(cols, sel.bucket_col)
        if bucket_ix < 0 {
            return boila_agg_fail(concat("time_bucket колона '", concat(sel.bucket_col, "' не съществува")), "42703")
        }
    }
    // агрегатни колони → индекси (-2 = Q-aexpr; -1 = count(*))
    let mut aixs: Vec<i64> = vec_new()
    let mut agg_items: Vec<BoilaSelItem> = vec_new()
    i = 0
    while i < vec_len(sel.items) {
        let it = vec_get(sel.items, i)
        if it.agg > 0 {
            if it.agg == 1 {
                vec_push(aixs, 0 - 1)   // count(*)
            } else {
                if vec_len(it.xtoks) > 0 {
                    // Q-aexpr: sum(expr) / count(expr) / …
                    vec_push(aixs, 0 - 2)
                } else {
                    let ix = boila_col_idx_of(cols, it.col)
                    if ix < 0 {
                        return boila_agg_fail(concat("агрегатна колона '", concat(it.col, "' не съществува")), "42703")
                    }
                    if it.agg == 3 || it.agg == 4 {
                        let cd = vec_get(cols, ix)
                        if cd.typ != boila_v_i64() && cd.typ != boila_v_ts() {
                            return boila_agg_fail(concat("sum/avg само върху BIGINT колона ('", concat(it.col, "')")), "0A000")
                        }
                    }
                    vec_push(aixs, ix)
                }
            }
            vec_push(agg_items, it)
        }
        i = i + 1
    }
    // Q-havx/Q-havand: attach HAVING-only slots
    let hs = boila_hav_setup(cols, sel, agg_items, aixs)
    if hs.ok == 0 {
        return boila_agg_fail(hs.err, hs.state)
    }
    agg_items = hs.items
    aixs = hs.aixs
    let hav_slots = hs.slots
    let n_proj_aggs = hs.n_proj
    let nitems = vec_len(agg_items)
    // 42803: bare SELECT cols must be in GROUP BY (both legacy + gexpr)
    if sel.has_group == 1 {
        let mut pi: i64 = 0
        while pi < vec_len(sel.items) {
            let it = vec_get(sel.items, pi)
            if it.agg == 0 && it.sfn == "" && vec_len(it.xtoks) == 0 && it.biv == 0 {
                if boila_agg_in_group(sel, it.col) == 0 {
                    return boila_agg_fail(concat("колона '", concat(it.col, "' трябва да е в GROUP BY или агрегат")), "42803")
                }
            }
            pi = pi + 1
        }
    }
    let use_gexpr = boila_agg_has_gexpr(sel)
    // GROUP BY expr also needs SELECT-list projection when keys are not plain cols
    let mut use_proj = use_gexpr
    if boila_agg_has_gbyx(sel) == 1 {
        use_proj = 1
    }
    let mut res = boila_result_empty()
    if use_gexpr == 1 || use_proj == 1 {
        let gs = boila_agg_gexpr_schema(cols, sel)?
        if gs.ok == 0 {
            return boila_agg_fail(gs.err, gs.state)
        }
        res = gs.res
        // xnames already built above
    } else {
        // legacy: group + агрегати (S7e: SELECT alias on group cols)
        i = 0
        while i < vec_len(sel.group_cols) {
            let nm = vec_get(sel.group_cols, i)
            let mut tag = boila_v_i64()
            if nm == "time_bucket" && sel.bucket_iv > 0 {
                let bix = boila_col_idx_of(cols, sel.bucket_col)
                if bix >= 0 { tag = vec_get(cols, bix).typ }
            } else {
                let gix = boila_col_idx_of(cols, nm)
                if gix >= 0 { tag = vec_get(cols, gix).typ }
            }
            let mut onm = nm
            let mut j: i64 = 0
            while j < vec_len(sel.items) {
                let it = vec_get(sel.items, j)
                if it.agg == 0 {
                    if nm == "time_bucket" && it.biv > 0 {
                        onm = boila_sel_item_out_name(it)
                        j = vec_len(sel.items)
                    } else {
                        if it.biv == 0 && it.col == nm {
                            onm = boila_sel_item_out_name(it)
                            j = vec_len(sel.items)
                        }
                    }
                }
                j = j + 1
            }
            boila_result_add_col(res, onm, tag)
            i = i + 1
        }
        i = 0
        while i < n_proj_aggs {
            boila_result_add_col(res, boila_agg_item_name(vec_get(agg_items, i)), boila_v_i64())
            i = i + 1
        }
    }
    // групи — Map hash: i64 fast path only for single numeric/ts group
    // (time_bucket / BIGINT). TEXT/bytes groups stay on Map<str,i64> hex.
    let gkeys: Vec<bytes> = vec_new()
    let gaccs: Vec<BoilaAggAcc> = vec_new()
    let gmap: Map<str, i64> = map_new()
    let gimap: Map<i64, i64> = map_new()
    let mut single_i64 = 0
    if vec_len(gixs) == 1 {
        if sel.bucket_iv > 0 {
            single_i64 = 1
        } else {
            let g0 = vec_get(gixs, 0)
            if g0 >= 0 && g0 < vec_len(cols) {
                let gt = vec_get(cols, g0).typ
                if gt == boila_v_i64() || gt == boila_v_ts() {
                    single_i64 = 1
                }
            }
        }
    }
    let mut r: i64 = 0
    while r < vec_len(brows) {
        let row = vec_get(brows, r)
        let mut gi: i64 = 0 - 1
        if single_i64 == 1 {
            // fast path: single BIGINT/ts/time_bucket key → Map<i64,i64>
            // (no bytes encode; gkeys only tracks group count)
            let gix = vec_get(gixs, 0)
            let mut gvi: i64 = 0
            if gix >= 0 && gix < vec_len(row) {
                let mut gv = vec_get(row, gix)
                if sel.bucket_iv > 0 && gix == bucket_ix {
                    gv = boila_tb_apply(gv, sel.bucket_iv)
                }
                gvi = gv.i
            }
            if map_has(gimap, gvi) == 1 {
                gi = map_get(gimap, gvi)
            } else {
                gi = vec_len(gaccs)
                map_set(gimap, gvi, gi)
                let mut first = row
                if sel.bucket_iv > 0 && bucket_ix >= 0 && bucket_ix < vec_len(row) {
                    first = vec_new()
                    let mut c: i64 = 0
                    while c < vec_len(row) {
                        if c == bucket_ix {
                            vec_push(first, boila_tb_apply(vec_get(row, c), sel.bucket_iv))
                        } else {
                            vec_push(first, vec_get(row, c))
                        }
                        c = c + 1
                    }
                }
                vec_push(gkeys, bytes_new(0))
                vec_push(gaccs, boila_agg_new_acc(nitems, first))
            }
        } else {
            // multi-col / text / expr groups: encode key → hex → Map
            let mut key = bytes_new(0)
            let mut gi0: i64 = 0
            while gi0 < vec_len(gixs) {
                let gix = vec_get(gixs, gi0)
                let mut gv = boila_val_null()
                if gix >= 0 {
                    if gix < vec_len(row) {
                        gv = vec_get(row, gix)
                        if sel.bucket_iv > 0 && gix == bucket_ix {
                            gv = boila_tb_apply(gv, sel.bucket_iv)
                        }
                    }
                } else {
                    let mut gxt: Vec<Token> = vec_new()
                    if gi0 < vec_len(sel.group_xtoks) {
                        gxt = vec_get(sel.group_xtoks, gi0)
                    }
                    if vec_len(gxt) > 0 {
                        let ev = boila_xw_eval(xnames, gxt, row)?
                        if ev.ok == 0 {
                            return boila_agg_fail(ev.err, ev.state)
                        }
                        gv = ev.val
                    }
                }
                key = bytes_concat(key, boila_val_enc(gv))
                key = bytes_concat(key, bytes_of_str("|"))
                gi0 = gi0 + 1
            }
            let kh = boila_bytes_hex(key)
            if map_has(gmap, kh) == 1 {
                gi = map_get(gmap, kh)
            } else {
                gi = vec_len(gaccs)
                map_set(gmap, kh, gi)
                vec_push(gkeys, key)
                vec_push(gaccs, boila_agg_new_acc(nitems, row))
            }
        }
        let acc = vec_get(gaccs, gi)
        acc.n = acc.n + 1
        let mut a: i64 = 0
        while a < nitems {
            let it = vec_get(agg_items, a)
            let cix = vec_get(aixs, a)
            if it.agg == 1 {
                vec_set(acc.cnt, a, vec_get(acc.cnt, a) + 1)
            } else {
                let mut v = boila_val_null()
                if cix == 0 - 2 {
                    // Q-aexpr: evaluate argument expression
                    let ev = boila_xw_eval(xnames, it.xtoks, row)?
                    if ev.ok == 0 {
                        return boila_agg_fail(ev.err, ev.state)
                    }
                    v = ev.val
                    if (it.agg == 3 || it.agg == 4) && v.tag != boila_v_null() {
                        if v.tag != boila_v_i64() && v.tag != boila_v_ts() && v.tag != boila_v_bool() {
                            return boila_agg_fail("sum/avg изисква числов израз", "0A000")
                        }
                    }
                } else {
                    v = vec_get(row, cix)
                }
                if v.tag != boila_v_null() {
                    vec_set(acc.cnt, a, vec_get(acc.cnt, a) + 1)
                    if vec_get(acc.hasv, a) == 0 {
                        vec_set(acc.hasv, a, 1)
                        vec_set(acc.minv, a, v)
                        vec_set(acc.maxv, a, v)
                    } else {
                        if boila_val_cmp(v, vec_get(acc.minv, a)) == (0 - 1) {
                            vec_set(acc.minv, a, v)
                        }
                        if boila_val_cmp(v, vec_get(acc.maxv, a)) == 1 {
                            vec_set(acc.maxv, a, v)
                        }
                    }
                    if it.agg == 3 || it.agg == 4 {
                        vec_set(acc.sum, a, vec_get(acc.sum, a) + v.i)
                    }
                }
            }
            a = a + 1
        }
        vec_set(gaccs, gi, acc)
        r = r + 1
    }
    // празен вход без GROUP BY → една нулева група (PG семантика)
    if vec_len(gkeys) == 0 && vec_len(sel.group_cols) == 0 && nitems > 0 {
        let empty_row: Vec<BoilaVal> = vec_new()
        vec_push(gkeys, bytes_new(0))
        vec_push(gaccs, boila_agg_new_acc(nitems, empty_row))
    }
    // изходни редове + HAVING
    let mut g: i64 = 0
    while g < vec_len(gaccs) {
        let acc = vec_get(gaccs, g)
        let mut emit = true
        if sel.has_having == 1 {
            let he = boila_hav_eval(acc, sel, hav_slots, cols, brows)?
            if he.ok == 0 {
                return boila_agg_fail(he.err, he.state)
            }
            emit = false
            if he.emit == 1 {
                emit = true
            }
        }
        if emit == true {
            if use_proj == 0 {
                // only project SELECT aggs (not HAVING-only extra slot)
                let pagg: Vec<BoilaSelItem> = vec_new()
                let mut pa: i64 = 0
                while pa < n_proj_aggs {
                    vec_push(pagg, vec_get(agg_items, pa))
                    pa = pa + 1
                }
                vec_push(res.rows, boila_agg_row(acc, gixs, pagg, aixs))
            } else {
                let gr = boila_agg_gexpr_row(cols, sel, acc, agg_items, xnames)?
                if gr.ok == 0 {
                    return boila_agg_fail(gr.err, gr.state)
                }
                vec_push(res.rows, gr.row)
            }
        }
        g = g + 1
    }
    return BoilaAggOut { ok: 1, err: "", state: "", res: res }
}
