// exec_agg.baga — агрегати + GROUP BY + HAVING (P5).
// Fold state: exec_agg_fold.baga; stream scan: exec_agg_stream.baga.
//
// count(*) / count(col) / sum / avg / min / max; avg integer div (gaps A1).
// Hash group: Map<i64,i64> single numeric/time_bucket; Map<str,i64> else.

import "../core/value.baga"
import "../catalog/schema.baga"
import "ast.baga"
import "exec_scan.baga"
import "exec_agg_fold.baga"
import "exec_agg_feed.baga"

fn boila_agg_fail(msg: str, state: str) -> BoilaAggOut {
    return boila_agg_out_fail(msg, state)
}

fn boila_agg_exec(cols: Vec<BoilaColDef>, rows: Vec<Vec<BoilaVal>>, sel: BoilaSel) -> BoilaAggOut !Time {
    let mut st = boila_agg_fold_start(cols, sel)?
    if st.ok == 0 {
        return boila_agg_out_fail(st.err, st.state)
    }
    let mut r: i64 = 0
    while r < vec_len(rows) {
        st = boila_agg_fold_row(st, sel, vec_get(rows, r))?
        if st.ok == 0 {
            return boila_agg_out_fail(st.err, st.state)
        }
        r = r + 1
    }
    return boila_agg_fold_end(st, sel)?
}
