// parse_select.baga — SELECT parser (P5+P7/P8 + K6 IS NULL).
import "token.baga"
import "lexer.baga"
import "ast.baga"
import "parse_common.baga"
import "tsquery.baga"
import "../core/value.baga"
import "../ts/time_bucket.baga"
import "std/str/str.baga"
struct BoilaParseSel { ok: i64, sel: BoilaSel, err: str, state: str }
fn boila_ps_fail(msg: str, state: str) -> BoilaParseSel {
    return BoilaParseSel { ok: 0, sel: boila_sel_empty(), err: msg, state: state }
}

fn boila_parse_select(l: BoilaLex) -> BoilaParseSel {
    let mut sel = boila_sel_empty()
    let mut i: i64 = 1
    if tok_kw(boila_ps_tok(l, i), "distinct") == 1 {
        sel.distinct = 1
        i = i + 1
    }
    let t = boila_ps_tok(l, i)
    if t.kind == tok_star() {
        sel.star = 1
        i = i + 1
    } else {
        let mut more = true
        while more {
            let it = boila_ps_item(l, i)
            if it.ok == 0 {
                return boila_ps_fail(it.err, it.state)
            }
            vec_push(sel.items, it.item)
            i = it.pos
            if boila_ps_tok(l, i).kind == tok_comma() {
                i = i + 1
            } else {
                more = false
            }
        }
    }

    // FROM
    if tok_kw(boila_ps_tok(l, i), "from") != 1 {
        let got = boila_ps_tok(l, i)
        return boila_ps_fail(concat("очаквах FROM, получих '", concat(got.txt, "'")), "42601")
    }
    i = i + 1
    let tb = boila_ps_tok(l, i)
    if tb.kind != tok_ident() {
        return boila_ps_fail("очаквах име на таблица след FROM", "42601")
    }
    sel.table = tb.txt
    i = i + 1

    // JOIN (един в P5)
    let mut jk: i64 = 0
    if tok_kw(boila_ps_tok(l, i), "inner") == 1 {
        if tok_kw(boila_ps_tok(l, i + 1), "join") != 1 {
            return boila_ps_fail("очаквах JOIN след INNER", "42601")
        }
        jk = 1
        i = i + 2
    } else {
        if tok_kw(boila_ps_tok(l, i), "left") == 1 {
            let mut p = i + 1
            if tok_kw(boila_ps_tok(l, p), "outer") == 1 {
                p = p + 1
            }
            if tok_kw(boila_ps_tok(l, p), "join") != 1 {
                return boila_ps_fail("очаквах JOIN след LEFT", "42601")
            }
            jk = 2
            i = p + 1
        } else {
            if tok_kw(boila_ps_tok(l, i), "join") == 1 {
                jk = 1
                i = i + 1
            }
        }
    }
    if jk > 0 {
        let jt = boila_ps_tok(l, i)
        if jt.kind != tok_ident() {
            return boila_ps_fail("очаквах име на таблица след JOIN", "42601")
        }
        sel.has_join = 1
        sel.join_kind = jk
        sel.join_table = jt.txt
        i = i + 1
        if tok_kw(boila_ps_tok(l, i), "on") != 1 {
            return boila_ps_fail("очаквах ON след JOIN таблица", "42601")
        }
        i = i + 1
        let lc = boila_ps_tok(l, i)
        if lc.kind != tok_ident() {
            return boila_ps_fail("очаквах лява колона в ON", "42601")
        }
        if boila_ps_tok(l, i + 1).kind != tok_op() || boila_ps_tok(l, i + 1).txt != "=" {
            return boila_ps_fail("ON поддържа само '=' в P5", "0A000")
        }
        let rc = boila_ps_tok(l, i + 2)
        if rc.kind != tok_ident() {
            return boila_ps_fail("очаквах дясна колона в ON", "42601")
        }
        sel.join_lcol = lc.txt
        sel.join_rcol = rc.txt
        i = i + 3
        if tok_kw(boila_ps_tok(l, i), "join") == 1 || tok_kw(boila_ps_tok(l, i), "inner") == 1 || tok_kw(boila_ps_tok(l, i), "left") == 1 {
            return boila_ps_fail("втори JOIN не е в P5", "0A000")
        }
    }

    // WHERE
    if tok_kw(boila_ps_tok(l, i), "where") == 1 {
        i = i + 1
        let mut more = true
        while more {
            let col = boila_ps_tok(l, i)
            if col.kind != tok_ident() {
                return boila_ps_fail("очаквах колона в WHERE", "42601")
            }
            i = i + 1
            // K6: IS [NOT] NULL
            if tok_kw(boila_ps_tok(l, i), "is") == 1 {
                i = i + 1
                let mut notn: i64 = 0
                if tok_kw(boila_ps_tok(l, i), "not") == 1 { notn = 1; i = i + 1 }
                if tok_kw(boila_ps_tok(l, i), "null") != 1 {
                    return boila_ps_fail("очаквах NULL след IS", "42601")
                }
                i = i + 1
                if sel.isnull_mode != 0 { return boila_ps_fail("повторно IS NULL", "0A000") }
                if notn == 1 { sel.isnull_mode = 2 } else { sel.isnull_mode = 1 }
                sel.isnull_col = col.txt
                if tok_kw(boila_ps_tok(l, i), "and") == 1 { i = i + 1 } else { more = false }
            } else {
            let op = boila_ps_tok(l, i)
            if op.kind != tok_op() {
                return boila_ps_fail(concat("очаквах оператор в WHERE, получих '", concat(op.txt, "'")), "42601")
            }
            i = i + 1
            if op.txt == "@@" {
                if sel.has_fts == 1 { return boila_ps_fail("повторно @@ условие", "0A000") }
                if sel.has_knn == 1 { return boila_ps_fail("@@ заедно с kNN", "0A000") }
                let fn_t = boila_ps_tok(l, i)
                let mut plain: i64 = 0 - 1
                if fn_t.kind == tok_ident() && fn_t.txt == "to_tsquery" { plain = 0 }
                if fn_t.kind == tok_ident() && fn_t.txt == "plainto_tsquery" { plain = 1 }
                if fn_t.kind == tok_ident() && fn_t.txt == "phraseto_tsquery" { plain = 2 }
                if plain < 0 { return boila_ps_fail("очаквах to_tsquery/plainto/phraseto_tsquery след @@", "42601") }
                if boila_ps_tok(l, i + 1).kind != tok_lparen() { return boila_ps_fail("очаквах '(' след tsquery", "42601") }
                let lit = boila_ps_tok(l, i + 2)
                if lit.kind != tok_str() { return boila_ps_fail("очаквах стринг в tsquery", "42601") }
                if boila_ps_tok(l, i + 3).kind != tok_rparen() { return boila_ps_fail("очаквах ')' в tsquery", "42601") }
                i = i + 4
                let tp = boila_ts_parse(lit.txt, plain)
                if tp.ok == 0 { return boila_ps_fail(tp.err, tp.state) }
                sel.has_fts = 1
                sel.fts_col = col.txt
                sel.fts_mode = tp.mode
                sel.fts_terms = tp.terms
                sel.fts_gaps = tp.gaps
                if tok_kw(boila_ps_tok(l, i), "and") == 1 { i = i + 1 } else { more = false }
            } else {
            if op.txt == "<->" || op.txt == "<=>" || op.txt == "<#>" {
                if sel.has_knn == 1 { return boila_ps_fail("повторно kNN условие", "0A000") }
                if sel.has_fts == 1 { return boila_ps_fail("kNN заедно с @@", "0A000") }
                let lit = boila_ps_tok(l, i)
                if lit.kind != tok_str() { return boila_ps_fail("очаквах vector литерал '[…]'", "42601") }
                i = i + 1
                let mut metric: i64 = 1
                if op.txt == "<=>" { metric = 2 }
                if op.txt == "<#>" { metric = 3 }
                sel.has_knn = 1
                sel.knn_col = col.txt
                sel.knn_metric = metric
                sel.knn_query = lit.txt
                if tok_kw(boila_ps_tok(l, i), "and") == 1 { i = i + 1 } else { more = false }
            } else {
            let lit = boila_ps_literal(l, i)
            if lit.ok == 0 {
                return boila_ps_fail(lit.err, lit.state)
            }
            i = i + 1
            let v = lit.v
            if op.txt == "=" {
                if sel.has_eq == 1 {
                    return boila_ps_fail("повторно = условие", "0A000")
                }
                sel.has_eq = 1
                sel.eq_col = col.txt
                sel.pk_eq = v
                sel.eq_param = lit.param
            } else {
                if op.txt == ">=" {
                    if sel.has_lo == 1 {
                        return boila_ps_fail("повторно >= условие", "0A000")
                    }
                    sel.has_lo = 1
                    sel.lo_col = col.txt
                    sel.pk_lo = v
                    sel.lo_param = lit.param
                } else {
                    if op.txt == "<=" {
                        if sel.has_hi == 1 {
                            return boila_ps_fail("повторно <= условие", "0A000")
                        }
                        sel.has_hi = 1
                        sel.hi_col = col.txt
                        sel.pk_hi = v
                        sel.hi_param = lit.param
                    } else {
                        return boila_ps_fail(concat("операторът '", concat(op.txt, "' не е в SELECT подмножеството")), "0A000")
                    }
                }
            }
            if tok_kw(boila_ps_tok(l, i), "and") == 1 {
                i = i + 1
            } else {
                more = false
            }
            }
            }
            }
        }
    }

    // GROUP BY
    if tok_kw(boila_ps_tok(l, i), "group") == 1 {
        if tok_kw(boila_ps_tok(l, i + 1), "by") != 1 {
            return boila_ps_fail("очаквах BY след GROUP", "42601")
        }
        i = i + 2
        sel.has_group = 1
        let mut more = true
        while more {
            let c = boila_ps_tok(l, i)
            if c.kind != tok_ident() {
                return boila_ps_fail("очаквах колона/time_bucket в GROUP BY", "42601")
            }
            // P9: time_bucket('1m', col)
            if c.txt == "time_bucket" {
                if boila_ps_tok(l, i + 1).kind != tok_lparen() {
                    return boila_ps_fail("очаквах '(' след time_bucket", "42601")
                }
                let ivt = boila_ps_tok(l, i + 2)
                if ivt.kind != tok_str() {
                    return boila_ps_fail("очаквах интервал-стринг в time_bucket", "42601")
                }
                if boila_ps_tok(l, i + 3).kind != tok_comma() {
                    return boila_ps_fail("очаквах ',' в time_bucket", "42601")
                }
                let col = boila_ps_tok(l, i + 4)
                if col.kind != tok_ident() {
                    return boila_ps_fail("очаквах колона в time_bucket", "42601")
                }
                if boila_ps_tok(l, i + 5).kind != tok_rparen() {
                    return boila_ps_fail("очаквах ')' в time_bucket", "42601")
                }
                let iv = boila_tb_parse_iv(ivt.txt)
                if iv.ok == 0 {
                    return boila_ps_fail(iv.err, iv.state)
                }
                if sel.bucket_iv > 0 {
                    return boila_ps_fail("повторно time_bucket в GROUP BY", "0A000")
                }
                sel.bucket_iv = iv.sec
                sel.bucket_col = col.txt
                vec_push(sel.group_cols, "time_bucket")
                i = i + 6
            } else {
                vec_push(sel.group_cols, c.txt)
                i = i + 1
            }
            if boila_ps_tok(l, i).kind == tok_comma() {
                i = i + 1
            } else {
                more = false
            }
        }
    }

    // HAVING agg(col) op num
    if tok_kw(boila_ps_tok(l, i), "having") == 1 {
        i = i + 1
        let an = boila_ps_tok(l, i)
        let kind = boila_ps_agg_kind(an.txt)
        if an.kind != tok_ident() || kind == 0 {
            return boila_ps_fail("очаквах агрегат в HAVING", "42601")
        }
        if boila_ps_tok(l, i + 1).kind != tok_lparen() {
            return boila_ps_fail("очаквах '(' след агрегата в HAVING", "42601")
        }
        let arg = boila_ps_tok(l, i + 2)
        let mut hcol = ""
        let mut hkind = kind
        if arg.kind == tok_star() {
            if kind != 1 {
                return boila_ps_fail("HAVING с * — само count", "0A000")
            }
        } else {
            if arg.kind != tok_ident() {
                return boila_ps_fail("очаквах колона в HAVING агрегата", "42601")
            }
            hcol = arg.txt
            if kind == 1 {
                hkind = 2
            }
        }
        if boila_ps_tok(l, i + 3).kind != tok_rparen() {
            return boila_ps_fail("очаквах ')' в HAVING агрегата", "42601")
        }
        let op = boila_ps_tok(l, i + 4)
        if op.kind != tok_op() {
            return boila_ps_fail("очаквах оператор в HAVING", "42601")
        }
        let hv = boila_ps_literal(l, i + 5)
        if hv.ok == 0 {
            return boila_ps_fail(hv.err, hv.state)
        }
        if hv.v.tag != boila_v_i64() {
            return boila_ps_fail("HAVING стойност — само цяло число в P5", "0A000")
        }
        sel.has_having = 1
        sel.hav_agg = hkind
        sel.hav_col = hcol
        sel.hav_op = op.txt
        sel.hav_val = hv.v.i
        i = i + 6
    }

    // ORDER BY
    if tok_kw(boila_ps_tok(l, i), "order") == 1 {
        if tok_kw(boila_ps_tok(l, i + 1), "by") != 1 { return boila_ps_fail("очаквах BY след ORDER", "42601") }
        i = i + 2
        sel.has_order = 1
        let mut more = true
        while more {
            let c = boila_ps_tok(l, i)
            if c.kind != tok_ident() { return boila_ps_fail("очаквах колона в ORDER BY", "42601") }
            vec_push(sel.ord_cols, c.txt)
            i = i + 1
            let mut desc: i64 = 0
            if tok_kw(boila_ps_tok(l, i), "desc") == 1 { desc = 1; i = i + 1 }
            else { if tok_kw(boila_ps_tok(l, i), "asc") == 1 { i = i + 1 } }
            vec_push(sel.ord_desc, desc)
            if boila_ps_tok(l, i).kind == tok_comma() { i = i + 1 } else { more = false }
        }
    }
    // LIMIT / OFFSET ($N ok for LIMIT — W2)
    if tok_kw(boila_ps_tok(l, i), "limit") == 1 {
        let lt = boila_ps_tok(l, i + 1)
        if lt.kind == tok_param() {
            sel.lim_param = parse_int(lt.txt)
            i = i + 2
        } else {
            if lt.kind != tok_num() { return boila_ps_fail("очаквах число след LIMIT", "42601") }
            sel.limit = parse_int(lt.txt)
            i = i + 2
        }
    }
    if tok_kw(boila_ps_tok(l, i), "offset") == 1 {
        let ot = boila_ps_tok(l, i + 1)
        if ot.kind != tok_num() { return boila_ps_fail("очаквах число след OFFSET", "42601") }
        sel.offset = parse_int(ot.txt)
        i = i + 2
    }
    if boila_ps_tok(l, i).kind == tok_semi() { i = i + 1 }
    let end = boila_ps_tok(l, i)
    if end.kind != tok_eof() {
        return boila_ps_fail(concat("неочакван токен '", concat(end.txt, "' в SELECT")), "0A000")
    }
    let mut has_agg: i64 = 0
    let mut has_plain: i64 = 0
    let mut k: i64 = 0
    while k < vec_len(sel.items) {
        if vec_get(sel.items, k).agg == 0 { has_plain = 1 } else { has_agg = 1 }
        k = k + 1
    }
    if has_agg == 1 && has_plain == 1 && sel.has_group == 0 {
        return boila_ps_fail("колони и агрегати заедно изискват GROUP BY", "0A000")
    }
    if sel.has_having == 1 && has_agg == 0 && sel.has_group == 0 {
        return boila_ps_fail("HAVING изисква агрегат или GROUP BY", "0A000")
    }
    return BoilaParseSel { ok: 1, sel: sel, err: "", state: "" }
}
