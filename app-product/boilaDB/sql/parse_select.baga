// parse_select.baga — SELECT parser (P5+P7/P8 + K6 IS NULL).
import "token.baga"
import "lexer.baga"
import "ast.baga"
import "parse_common.baga"
import "parse_where.baga"
import "tsquery.baga"
import "../core/value.baga"
import "../ts/time_bucket.baga"
import "std/str/str.baga"
struct BoilaParseSel { ok: i64, sel: BoilaSel, err: str, state: str }
fn boila_ps_fail(msg: str, state: str) -> BoilaParseSel {
    return BoilaParseSel { ok: 0, sel: boila_sel_empty(), err: msg, state: state }
}
// PG TABLE t … → SELECT * FROM t …
fn boila_table_stmt_to_select(l: BoilaLex) -> str {
    if tok_kw(boila_ps_tok(l, 0), "table") != 1 { return "" }
    let tn = boila_ps_tok(l, 1)
    if tn.kind != tok_ident() { return "" }
    let mut rest = ""
    let mut j: i64 = 2
    while j < vec_len(l.toks) {
        let t = boila_ps_tok(l, j)
        if t.kind == tok_eof() || t.kind == tok_semi() { break }
        if rest != "" { rest = concat(rest, " ") }
        if t.kind == tok_str() {
            rest = concat(rest, concat("'", concat(t.txt, "'")))
        } else {
            rest = concat(rest, t.txt)
        }
        j = j + 1
    }
    return concat(concat(concat("SELECT * FROM ", tn.txt), " "), rest)
}

fn boila_parse_select(l: BoilaLex) -> BoilaParseSel {
    let mut sel = boila_sel_empty()
    let mut i: i64 = 1
    // SELECT ALL … is a no-op (default); DISTINCT still sets flag
    if tok_kw(boila_ps_tok(l, i), "all") == 1 {
        i = i + 1
    }
    if tok_kw(boila_ps_tok(l, i), "distinct") == 1 {
        sel.distinct = 1
        i = i + 1
    }
    let t = boila_ps_tok(l, i)
    if t.kind == tok_star() {
        sel.star = 1
        i = i + 1
    } else {
        let mut more = true
        while more {
            let it = boila_ps_item(l, i)
            if it.ok == 0 {
                return boila_ps_fail(it.err, it.state)
            }
            vec_push(sel.items, it.item)
            i = it.pos
            if boila_ps_tok(l, i).kind == tok_comma() {
                i = i + 1
            } else {
                more = false
            }
        }
    }

    // FROM
    if tok_kw(boila_ps_tok(l, i), "from") != 1 {
        let got = boila_ps_tok(l, i)
        return boila_ps_fail(concat("очаквах FROM, получих '", concat(got.txt, "'")), "42601")
    }
    i = i + 1
    let tb = boila_ps_tok(l, i)
    if tb.kind != tok_ident() {
        return boila_ps_fail("очаквах име на таблица след FROM", "42601")
    }
    sel.table = tb.txt
    i = i + 1

    // JOIN (един в P5)
    let mut jk: i64 = 0
    if tok_kw(boila_ps_tok(l, i), "inner") == 1 {
        if tok_kw(boila_ps_tok(l, i + 1), "join") != 1 { return boila_ps_fail("очаквах JOIN след INNER", "42601") }
        jk = 1
        i = i + 2
    } else {
        if tok_kw(boila_ps_tok(l, i), "left") == 1 {
            let mut p = i + 1
            if tok_kw(boila_ps_tok(l, p), "outer") == 1 { p = p + 1 }
            if tok_kw(boila_ps_tok(l, p), "join") != 1 { return boila_ps_fail("очаквах JOIN след LEFT", "42601") }
            jk = 2
            i = p + 1
        } else {
            if tok_kw(boila_ps_tok(l, i), "join") == 1 { jk = 1; i = i + 1 }
        }
    }
    if jk > 0 {
        let jt = boila_ps_tok(l, i)
        if jt.kind != tok_ident() {
            return boila_ps_fail("очаквах име на таблица след JOIN", "42601")
        }
        sel.has_join = 1
        sel.join_kind = jk
        sel.join_table = jt.txt
        i = i + 1
        if tok_kw(boila_ps_tok(l, i), "on") != 1 { return boila_ps_fail("очаквах ON след JOIN таблица", "42601") }
        i = i + 1
        // A3c: ON a = b [AND c = d …]
        let mut more_on = true
        while more_on {
            let lc = boila_ps_tok(l, i)
            if lc.kind != tok_ident() { return boila_ps_fail("очаквах лява колона в ON", "42601") }
            if boila_ps_tok(l, i + 1).kind != tok_op() || boila_ps_tok(l, i + 1).txt != "=" {
                return boila_ps_fail("ON поддържа само '=' ", "0A000")
            }
            let rc = boila_ps_tok(l, i + 2)
            if rc.kind != tok_ident() { return boila_ps_fail("очаквах дясна колона в ON", "42601") }
            if vec_len(sel.join_lcols) == 0 { sel.join_lcol = lc.txt; sel.join_rcol = rc.txt }
            vec_push(sel.join_lcols, lc.txt)
            vec_push(sel.join_rcols, rc.txt)
            i = i + 3
            if tok_kw(boila_ps_tok(l, i), "and") == 1 { i = i + 1 } else { more_on = false }
        }
        if tok_kw(boila_ps_tok(l, i), "join") == 1 || tok_kw(boila_ps_tok(l, i), "inner") == 1 || tok_kw(boila_ps_tok(l, i), "left") == 1 {
            return boila_ps_fail("втори JOIN не е в P5", "0A000")
        }
    }

    // WHERE (eq/range/IS NULL/FTS/kNN/LIKE)
    let wh = boila_parse_where(l, sel, i)
    if wh.ok == 0 {
        return boila_ps_fail(wh.err, wh.state)
    }
    sel = wh.sel
    i = wh.pos

    // GROUP BY
    if tok_kw(boila_ps_tok(l, i), "group") == 1 {
        if tok_kw(boila_ps_tok(l, i + 1), "by") != 1 {
            return boila_ps_fail("очаквах BY след GROUP", "42601")
        }
        i = i + 2
        sel.has_group = 1
        let mut more = true
        while more {
            let c = boila_ps_tok(l, i)
            if c.kind != tok_ident() {
                return boila_ps_fail("очаквах колона/time_bucket в GROUP BY", "42601")
            }
            // P9: time_bucket('1m', col)
            if c.txt == "time_bucket" {
                if boila_ps_tok(l, i + 1).kind != tok_lparen() {
                    return boila_ps_fail("очаквах '(' след time_bucket", "42601")
                }
                let ivt = boila_ps_tok(l, i + 2)
                if ivt.kind != tok_str() {
                    return boila_ps_fail("очаквах интервал-стринг в time_bucket", "42601")
                }
                if boila_ps_tok(l, i + 3).kind != tok_comma() {
                    return boila_ps_fail("очаквах ',' в time_bucket", "42601")
                }
                let col = boila_ps_tok(l, i + 4)
                if col.kind != tok_ident() {
                    return boila_ps_fail("очаквах колона в time_bucket", "42601")
                }
                if boila_ps_tok(l, i + 5).kind != tok_rparen() {
                    return boila_ps_fail("очаквах ')' в time_bucket", "42601")
                }
                let iv = boila_tb_parse_iv(ivt.txt)
                if iv.ok == 0 {
                    return boila_ps_fail(iv.err, iv.state)
                }
                if sel.bucket_iv > 0 {
                    return boila_ps_fail("повторно time_bucket в GROUP BY", "0A000")
                }
                sel.bucket_iv = iv.sec
                sel.bucket_col = col.txt
                vec_push(sel.group_cols, "time_bucket")
                i = i + 6
            } else {
                vec_push(sel.group_cols, c.txt)
                i = i + 1
            }
            if boila_ps_tok(l, i).kind == tok_comma() {
                i = i + 1
            } else {
                more = false
            }
        }
    }

    // HAVING agg(col) op num
    if tok_kw(boila_ps_tok(l, i), "having") == 1 {
        i = i + 1
        let an = boila_ps_tok(l, i)
        let kind = boila_ps_agg_kind(an.txt)
        if an.kind != tok_ident() || kind == 0 {
            return boila_ps_fail("очаквах агрегат в HAVING", "42601")
        }
        if boila_ps_tok(l, i + 1).kind != tok_lparen() {
            return boila_ps_fail("очаквах '(' след агрегата в HAVING", "42601")
        }
        let arg = boila_ps_tok(l, i + 2)
        let mut hcol = ""
        let mut hkind = kind
        if arg.kind == tok_star() {
            if kind != 1 {
                return boila_ps_fail("HAVING с * — само count", "0A000")
            }
        } else {
            if arg.kind != tok_ident() {
                return boila_ps_fail("очаквах колона в HAVING агрегата", "42601")
            }
            hcol = arg.txt
            if kind == 1 {
                hkind = 2
            }
        }
        if boila_ps_tok(l, i + 3).kind != tok_rparen() {
            return boila_ps_fail("очаквах ')' в HAVING агрегата", "42601")
        }
        let op = boila_ps_tok(l, i + 4)
        if op.kind != tok_op() {
            return boila_ps_fail("очаквах оператор в HAVING", "42601")
        }
        let hv = boila_ps_literal(l, i + 5)
        if hv.ok == 0 {
            return boila_ps_fail(hv.err, hv.state)
        }
        if hv.v.tag != boila_v_i64() {
            return boila_ps_fail("HAVING стойност — само цяло число в P5", "0A000")
        }
        sel.has_having = 1
        sel.hav_agg = hkind
        sel.hav_col = hcol
        sel.hav_op = op.txt
        sel.hav_val = hv.v.i
        i = i + 6
    }

    // ORDER BY
    if tok_kw(boila_ps_tok(l, i), "order") == 1 {
        if tok_kw(boila_ps_tok(l, i + 1), "by") != 1 { return boila_ps_fail("очаквах BY след ORDER", "42601") }
        i = i + 2
        sel.has_order = 1
        let mut more = true
        while more {
            let c = boila_ps_tok(l, i)
            if c.kind != tok_ident() { return boila_ps_fail("очаквах колона в ORDER BY", "42601") }
            vec_push(sel.ord_cols, c.txt)
            i = i + 1
            let mut desc: i64 = 0
            if tok_kw(boila_ps_tok(l, i), "desc") == 1 { desc = 1; i = i + 1 }
            else { if tok_kw(boila_ps_tok(l, i), "asc") == 1 { i = i + 1 } }
            // NULLS FIRST|LAST → pack into ord_desc (bits 1..)
            let mut nm: i64 = 0
            if tok_kw(boila_ps_tok(l, i), "nulls") == 1 {
                if tok_kw(boila_ps_tok(l, i + 1), "first") == 1 {
                    nm = 1
                    i = i + 2
                } else {
                    if tok_kw(boila_ps_tok(l, i + 1), "last") == 1 {
                        nm = 2
                        i = i + 2
                    } else {
                        return boila_ps_fail("очаквах FIRST|LAST след NULLS", "42601")
                    }
                }
            }
            vec_push(sel.ord_desc, desc + nm * 2)
            if boila_ps_tok(l, i).kind == tok_comma() { i = i + 1 } else { more = false }
        }
    }
    // LIMIT / OFFSET ($N ok for LIMIT — W2); LIMIT ALL = no limit
    if tok_kw(boila_ps_tok(l, i), "limit") == 1 {
        let lt = boila_ps_tok(l, i + 1)
        if tok_kw(lt, "all") == 1 {
            i = i + 2
        } else {
            if lt.kind == tok_param() {
                sel.lim_param = parse_int(lt.txt)
                i = i + 2
            } else {
                if lt.kind != tok_num() { return boila_ps_fail("очаквах число|ALL след LIMIT", "42601") }
                sel.limit = parse_int(lt.txt)
                i = i + 2
            }
        }
    }
    if tok_kw(boila_ps_tok(l, i), "offset") == 1 {
        let ot = boila_ps_tok(l, i + 1)
        if ot.kind != tok_num() { return boila_ps_fail("очаквах число след OFFSET", "42601") }
        sel.offset = parse_int(ot.txt)
        i = i + 2
    }
    if boila_ps_tok(l, i).kind == tok_semi() { i = i + 1 }
    let end = boila_ps_tok(l, i)
    if end.kind != tok_eof() {
        return boila_ps_fail(concat("неочакван токен '", concat(end.txt, "' в SELECT")), "0A000")
    }
    let mut has_agg: i64 = 0
    let mut has_plain: i64 = 0
    let mut has_sfn: i64 = 0
    let mut has_expr: i64 = 0
    let mut plain_bucket: i64 = 1
    let mut ab_iv: i64 = 0
    let mut ab_col = ""
    let mut k: i64 = 0
    while k < vec_len(sel.items) {
        let it = vec_get(sel.items, k)
        if it.agg == 0 {
            has_plain = 1
            if it.biv <= 0 { plain_bucket = 0 }
            else {
                if ab_iv == 0 { ab_iv = it.biv; ab_col = it.col }
                else { if it.biv != ab_iv || it.col != ab_col { plain_bucket = 0 } }
            }
        } else { has_agg = 1 }
        if it.sfn != "" { has_sfn = 1 }
        if vec_len(it.xtoks) > 0 { has_expr = 1 }
        k = k + 1
    }
    // Q-sfn/Q-expr: fns/expressions are projection-only (no agg/GROUP BY)
    if (has_sfn == 1 || has_expr == 1) && (has_agg == 1 || sel.has_group == 1) {
        return boila_ps_fail("скаларна функция/израз с агрегат/GROUP BY не се поддържа", "0A000")
    }
    // S7d: time_bucket + agg → auto GROUP BY time_bucket
    if has_agg == 1 && has_plain == 1 && sel.has_group == 0 {
        if plain_bucket == 1 && ab_iv > 0 {
            sel.has_group = 1
            sel.bucket_iv = ab_iv
            sel.bucket_col = ab_col
            vec_push(sel.group_cols, "time_bucket")
        } else {
            return boila_ps_fail("колони и агрегати заедно изискват GROUP BY", "0A000")
        }
    }
    if sel.has_having == 1 && has_agg == 0 && sel.has_group == 0 {
        return boila_ps_fail("HAVING изисква агрегат или GROUP BY", "0A000")
    }
    return BoilaParseSel { ok: 1, sel: sel, err: "", state: "" }
}
