// exec_agg_stream.baga — stream hash-agg: GET rows → fold, no full row Vec.
// K3j: time_bucket GROUP BY via continuous rollup (full + partial windows).

import "../storage/shards.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "../core/row.baga"
import "../core/budget.baga"
import "../catalog/schema.baga"
import "../index/secondary.baga"
import "../ts/rollup.baga"
import "../ts/time_bucket.baga"
import "../txn/mvcc.baga"
import "ast.baga"
import "exec_scan.baga"
import "exec_sort.baga"
import "exec_filter.baga"
import "exec_buf.baga"
import "exec_agg_fold.baga"
import "exec_agg_feed.baga"
import "exec_agg_extra.baga"
import "std/bytes/bytes.baga"

// Stream when fold can replace materialize+agg (no join/knn/fts/isnull/xw).
fn boila_agg_streamable(sel: BoilaSel) -> i64 {
    if sel.has_join == 1 { return 0 }
    if sel.has_knn == 1 { return 0 }
    if sel.has_fts == 1 { return 0 }
    if sel.isnull_mode != 0 { return 0 }
    if sel.has_xw == 1 { return 0 }
    return 1
}

// Read one rollup cell (txn buffer + storage). found=0 if missing/deleted.
fn boila_ru_cell_read(s: BoilaStore, txn: BoilaTxn, table_id: i64, epk: bytes) -> BoilaTxnGet !IO !Time !Par {
    let tix = boila_txn_find(txn, boila_cf_index(), table_id, epk)
    if tix >= 0 {
        let w = vec_get(txn.writes, tix)
        if w.is_del == 1 {
            return BoilaTxnGet { s: s, found: 0, row: bytes_new(0), lsn: 0 }
        }
        return BoilaTxnGet { s: s, found: 1, row: w.row, lsn: 0 }
    }
    let g = boila_get(s, boila_cf_index(), table_id, epk)?
    if g.found == 0 {
        return BoilaTxnGet { s: g.s, found: 0, row: bytes_new(0), lsn: 0 }
    }
    return BoilaTxnGet { s: g.s, found: 1, row: boila_unwrap_row(g.val), lsn: 0 }
}

// Append one output row from bucket cell (count/sum/avg items).
fn boila_ru_push_row(res: BoilaResult, sel: BoilaSel, ts_typ: i64, bsec: i64, cnt: i64, sum: i64) {
    if cnt <= 0 {
        return
    }
    let row: Vec<BoilaVal> = vec_new()
    if ts_typ == boila_v_ts() {
        vec_push(row, boila_val_ts(bsec * 1000000))
    } else {
        vec_push(row, boila_val_i64(bsec))
    }
    let mut a: i64 = 0
    while a < vec_len(sel.items) {
        let it = vec_get(sel.items, a)
        if it.agg == 1 {
            vec_push(row, boila_val_i64(cnt))
        } else {
            if it.agg == 3 {
                vec_push(row, boila_val_i64(sum))
            } else {
                if it.agg == 4 {
                    if cnt == 0 {
                        vec_push(row, boila_val_null())
                    } else {
                        vec_push(row, boila_val_i64(sum / cnt))
                    }
                }
            }
        }
        a = a + 1
    }
    vec_push(res.rows, row)
}

// K3j/K3k: continuous rollup for GROUP BY time_bucket.
// Unfiltered: all cells. Partial window on bucket_col: complete buckets
// from rollup + raw secondary scan on left/right partial edges.
fn boila_agg_scan_rollup(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, sel: BoilaSel) -> BoilaExec !IO !Time !Par {
    if sel.bucket_iv <= 0 || sel.has_group == 0 {
        return boila_exec_fail(s, txn, "", "RU0")
    }
    if vec_len(sel.group_cols) != 1 || vec_get(sel.group_cols, 0) != "time_bucket" {
        return boila_exec_fail(s, txn, "", "RU0")
    }
    if sel.has_eq == 1 {
        return boila_exec_fail(s, txn, "", "RU0")
    }
    if sel.has_like > 0 || sel.has_in > 0 || sel.has_ne == 1 || sel.has_xw == 1 || sel.has_having == 1 {
        return boila_exec_fail(s, txn, "", "RU0")
    }
    // Range filters only on bucket_col (or none).
    let mut has_win: i64 = 0
    if sel.has_lo == 1 || sel.has_hi == 1 {
        has_win = 1
        if sel.has_lo == 1 && sel.lo_col != sel.bucket_col {
            return boila_exec_fail(s, txn, "", "RU0")
        }
        if sel.has_hi == 1 && sel.hi_col != sel.bucket_col {
            return boila_exec_fail(s, txn, "", "RU0")
        }
        if sel.has_lo == 1 && sel.has_hi == 1 && sel.lo_col != sel.hi_col {
            return boila_exec_fail(s, txn, "", "RU0")
        }
    }
    let ts_idx = boila_col_idx(t, sel.bucket_col)
    if ts_idx < 0 {
        return boila_exec_fail(s, txn, "", "RU0")
    }
    let mut need_sum: i64 = 0
    let mut sum_idx: i64 = 0 - 1
    let mut i: i64 = 0
    while i < vec_len(sel.items) {
        let it = vec_get(sel.items, i)
        if it.agg == 0 {
            if it.biv > 0 {
                if it.biv != sel.bucket_iv || it.col != sel.bucket_col {
                    return boila_exec_fail(s, txn, "", "RU0")
                }
            } else {
                if it.sfn != "" || vec_len(it.xtoks) > 0 || it.col != sel.bucket_col {
                    return boila_exec_fail(s, txn, "", "RU0")
                }
            }
        } else {
            if it.agg == 1 {
            } else {
                if it.agg == 3 || it.agg == 4 {
                    if vec_len(it.xtoks) > 0 {
                        return boila_exec_fail(s, txn, "", "RU0")
                    }
                    let sx = boila_col_idx(t, it.col)
                    if sx < 0 {
                        return boila_exec_fail(s, txn, "", "RU0")
                    }
                    if need_sum == 1 && sx != sum_idx {
                        return boila_exec_fail(s, txn, "", "RU0")
                    }
                    need_sum = 1
                    sum_idx = sx
                } else {
                    return boila_exec_fail(s, txn, "", "RU0")
                }
            }
        }
        i = i + 1
    }
    let gl = boila_ru_list_for_table(s, t.id)?
    s = gl.s
    let mi = boila_ru_match(gl.defs, ts_idx, sel.bucket_iv, need_sum, sum_idx)
    if mi < 0 {
        return boila_exec_fail(s, txn, "", "RU0")
    }
    let d = vec_get(gl.defs, mi)
    let iv = sel.bucket_iv
    let ts_typ = vec_get(t.cols, ts_idx).typ
    let mut res = boila_result_empty()
    let mut gnm = "time_bucket"
    i = 0
    while i < vec_len(sel.items) {
        let it = vec_get(sel.items, i)
        if it.agg == 0 && it.biv > 0 {
            gnm = boila_sel_item_out_name(it)
            i = vec_len(sel.items)
        }
        i = i + 1
    }
    boila_result_add_col(res, gnm, ts_typ)
    i = 0
    while i < vec_len(sel.items) {
        let it = vec_get(sel.items, i)
        if it.agg > 0 {
            boila_result_add_col(res, boila_agg_item_name(it), boila_v_i64())
        }
        i = i + 1
    }

    // --- full table: scan all rollup cells ---
    if has_win == 0 {
        let pref = boila_ru_prefix(d.id)
        let full_pref = boila_key_row(boila_cf_index(), t.id, pref)
        let plen = bytes_len(full_pref)
        let sa = boila_scan_pref_all(s, full_pref)?
        s = sa.s
        let mut j: i64 = 0
        while j < vec_len(sa.keys) {
            let k = vec_get(sa.keys, j)
            if bytes_len(k) >= plen + 8 {
                let bsec = boila_dec_i64_ord(k, plen)
                let epk = bytes_slice(k, 5, bytes_len(k))
                let cell = boila_ru_cell_read(s, txn, t.id, epk)?
                s = cell.s
                if cell.found == 1 {
                    let r = boila_row_dec(cell.row)
                    let mut cnt: i64 = 0
                    let mut sum: i64 = 0
                    if vec_len(r) > 0 { cnt = vec_get(r, 0).i }
                    if vec_len(r) > 1 { sum = vec_get(r, 1).i }
                    boila_ru_push_row(res, sel, ts_typ, bsec, cnt, sum)
                }
            }
            j = j + 1
        }
        return boila_exec_ok_select(s, txn, res)
    }

    // --- partial window on bucket_col (K3k) ---
    // [lo, hi) with inclusive/exclusive flags from sel.
    let mut lo_sec: i64 = 0
    let mut hi_sec: i64 = 0
    let mut have_lo: i64 = 0
    let mut have_hi: i64 = 0
    if sel.has_lo == 1 {
        lo_sec = boila_tb_to_sec(sel.pk_lo)
        have_lo = 1
        if sel.lo_excl == 1 {
            lo_sec = lo_sec + 1
        }
    }
    if sel.has_hi == 1 {
        hi_sec = boila_tb_to_sec(sel.pk_hi)
        have_hi = 1
        if sel.hi_excl == 0 {
            // inclusive hi → half-open end = hi+1 (seconds)
            hi_sec = hi_sec + 1
        }
    }
    // first/last complete bucket starts
    let mut first_full: i64 = 0
    let mut last_full: i64 = 0
    let mut has_full: i64 = 0
    let mut left_partial: i64 = 0
    let mut has_left: i64 = 0
    let mut right_partial: i64 = 0
    let mut has_right: i64 = 0
    if have_lo == 1 && have_hi == 1 {
        if lo_sec >= hi_sec {
            return boila_exec_ok_select(s, txn, res)
        }
        let lc = boila_tb_bucket(lo_sec, iv)
        let hc = boila_tb_bucket(hi_sec, iv)
        if lo_sec > lc {
            has_left = 1
            left_partial = lc
            first_full = lc + iv
        } else {
            first_full = lc
        }
        if hi_sec > hc {
            has_right = 1
            right_partial = hc
            last_full = hc - iv
        } else {
            // hi aligned: last complete ends at hi
            last_full = hc - iv
        }
        if first_full <= last_full {
            has_full = 1
        }
        // window inside one partial bucket
        if has_full == 0 && has_left == 1 && has_right == 1 && left_partial == right_partial {
            has_right = 0
        }
        if has_full == 0 && has_left == 0 && has_right == 0 {
            // lo and hi aligned to same boundary with empty interior
            return boila_exec_ok_select(s, txn, res)
        }
    } else {
        if have_lo == 1 {
            let lc = boila_tb_bucket(lo_sec, iv)
            if lo_sec > lc {
                has_left = 1
                left_partial = lc
                first_full = lc + iv
            } else {
                first_full = lc
            }
            has_full = 1
            last_full = 9223372036854775807  // scan all cells >= first_full
        } else {
            // only hi
            let hc = boila_tb_bucket(hi_sec, iv)
            if hi_sec > hc {
                has_right = 1
                right_partial = hc
                last_full = hc - iv
            } else {
                last_full = hc - iv
            }
            has_full = 1
            first_full = (0 - 9223372036854775807)  // all cells <= last_full
        }
    }

    // Edges first (secondary ix prefix cache shared); complete via point GETs.
    let mut need_edge = has_left
    if has_right == 1 { need_edge = 1 }
    if need_edge == 1 {
        let ixid = boila_ix_by_col_t(t, ts_idx)
        if ixid < 0 {
            return boila_exec_fail(s, txn, "", "RU0")
        }
        let mut st = boila_agg_fold_start(t.cols, sel)?
        if st.ok == 0 {
            return boila_exec_fail(s, txn, st.err, st.state)
        }
        if has_left == 1 {
            let mut ehi = first_full
            if have_hi == 1 && ehi > hi_sec { ehi = hi_sec }
            let mut lo_v = boila_val_i64(lo_sec)
            let mut hi_v = boila_val_i64(ehi)
            if ts_typ == boila_v_ts() {
                lo_v = boila_val_ts(lo_sec * 1000000)
                hi_v = boila_val_ts(ehi * 1000000)
            }
            let xr = boila_ix_range(s, t, ixid, 1, lo_v, 1, hi_v, 0, 1)?
            s = xr.s
            if xr.ok == 0 {
                return boila_exec_fail(s, txn, xr.err, xr.state)
            }
            if xr.has == 1 {
                boila_scan_buf_range(txn, t, ts_idx, 1, lo_v, 1, hi_v, 0, 1, xr.pks)
                let mut li: i64 = 0
                while li < vec_len(xr.pks) {
                    let g = boila_txn_get(s, txn, t.id, vec_get(xr.pks, li))?
                    s = g.s
                    if g.found == 1 {
                        st = boila_agg_fold_row(st, sel, boila_row_dec(g.row))?
                        if st.ok == 0 {
                            return boila_exec_fail(s, txn, st.err, st.state)
                        }
                    }
                    li = li + 1
                }
            }
        }
        if has_right == 1 {
            let mut elo = right_partial
            if have_lo == 1 && elo < lo_sec { elo = lo_sec }
            let mut lo_v = boila_val_i64(elo)
            let mut hi_v = boila_val_i64(hi_sec)
            if ts_typ == boila_v_ts() {
                lo_v = boila_val_ts(elo * 1000000)
                hi_v = boila_val_ts(hi_sec * 1000000)
            }
            let xr = boila_ix_range(s, t, ixid, 1, lo_v, 1, hi_v, 0, 1)?
            s = xr.s
            if xr.ok == 0 {
                return boila_exec_fail(s, txn, xr.err, xr.state)
            }
            if xr.has == 1 {
                boila_scan_buf_range(txn, t, ts_idx, 1, lo_v, 1, hi_v, 0, 1, xr.pks)
                let mut li: i64 = 0
                while li < vec_len(xr.pks) {
                    let g = boila_txn_get(s, txn, t.id, vec_get(xr.pks, li))?
                    s = g.s
                    if g.found == 1 {
                        st = boila_agg_fold_row(st, sel, boila_row_dec(g.row))?
                        if st.ok == 0 {
                            return boila_exec_fail(s, txn, st.err, st.state)
                        }
                    }
                    li = li + 1
                }
            }
        }
        if has_full == 0 {
            let ag = boila_agg_fold_end(st, sel)?
            if ag.ok == 0 {
                return boila_exec_fail(s, txn, ag.err, ag.state)
            }
            return boila_exec_ok_select(s, txn, ag.res)
        }
        let ag = boila_agg_fold_end(st, sel)?
        if ag.ok == 0 {
            return boila_exec_fail(s, txn, ag.err, ag.state)
        }
        let mut ei: i64 = 0
        while ei < vec_len(ag.res.rows) {
            vec_push(res.rows, vec_get(ag.res.rows, ei))
            ei = ei + 1
        }
    }

    // complete buckets: direct cell GETs (no full rollup prefix rebuild)
    if has_full == 1 {
        if have_lo == 1 && have_hi == 1 {
            let mut bsec = first_full
            while bsec <= last_full {
                let epk = boila_ru_entry_pk(d.id, bsec)
                let cell = boila_ru_cell_read(s, txn, t.id, epk)?
                s = cell.s
                if cell.found == 1 {
                    let r = boila_row_dec(cell.row)
                    let mut cnt: i64 = 0
                    let mut sum: i64 = 0
                    if vec_len(r) > 0 { cnt = vec_get(r, 0).i }
                    if vec_len(r) > 1 { sum = vec_get(r, 1).i }
                    boila_ru_push_row(res, sel, ts_typ, bsec, cnt, sum)
                }
                bsec = bsec + iv
            }
        } else {
            // open-ended lo or hi: prefix scan + filter
            let pref = boila_ru_prefix(d.id)
            let full_pref = boila_key_row(boila_cf_index(), t.id, pref)
            let plen = bytes_len(full_pref)
            let sa = boila_scan_pref_all(s, full_pref)?
            s = sa.s
            let mut j: i64 = 0
            while j < vec_len(sa.keys) {
                let k = vec_get(sa.keys, j)
                if bytes_len(k) >= plen + 8 {
                    let bsec = boila_dec_i64_ord(k, plen)
                    let mut keep = 1
                    if have_lo == 1 && bsec < first_full { keep = 0 }
                    if have_hi == 1 && bsec > last_full { keep = 0 }
                    if keep == 1 {
                        let epk = bytes_slice(k, 5, bytes_len(k))
                        let cell = boila_ru_cell_read(s, txn, t.id, epk)?
                        s = cell.s
                        if cell.found == 1 {
                            let r = boila_row_dec(cell.row)
                            let mut cnt: i64 = 0
                            let mut sum: i64 = 0
                            if vec_len(r) > 0 { cnt = vec_get(r, 0).i }
                            if vec_len(r) > 1 { sum = vec_get(r, 1).i }
                            boila_ru_push_row(res, sel, ts_typ, bsec, cnt, sum)
                        }
                    }
                }
                j = j + 1
            }
        }
    }
    return boila_exec_ok_select(s, txn, res)
}

// Fused fetch+fold for plain table (filters applied per row).
fn boila_agg_scan(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, sel: BoilaSel) -> BoilaExec !IO !Time !Par {
    // K3j pre-agg path (unfiltered time_bucket)
    let ru = boila_agg_scan_rollup(s, txn, t, sel)?
    if ru.ok == 1 {
        return ru
    }
    // RU0 sentinel = shape/catalog miss → fall through
    if ru.state != "RU0" {
        return ru
    }
    s = ru.s
    txn = ru.txn
    let cols = t.cols
    let mut st = boila_agg_fold_start(cols, sel)?
    if st.ok == 0 {
        return boila_exec_fail(s, txn, st.err, st.state)
    }
    let pkcol = vec_get(t.cols, t.pk_idx)
    let mut pk_range: i64 = 1
    if sel.has_lo == 1 {
        let cix = boila_col_idx(t, sel.lo_col)
        if cix < 0 {
            return boila_exec_fail(s, txn, concat("колона '", concat(sel.lo_col, "' не съществува")), "42703")
        }
        if boila_pk_lit_ok(vec_get(t.cols, cix).typ, sel.pk_lo) == 0 {
            return boila_exec_fail(s, txn, "литералът в >= не съответства на типа на колоната", "42804")
        }
        if sel.lo_col != pkcol.name { pk_range = 0 }
    }
    if sel.has_hi == 1 {
        let cix = boila_col_idx(t, sel.hi_col)
        if cix < 0 {
            return boila_exec_fail(s, txn, concat("колона '", concat(sel.hi_col, "' не съществува")), "42703")
        }
        if boila_pk_lit_ok(vec_get(t.cols, cix).typ, sel.pk_hi) == 0 {
            return boila_exec_fail(s, txn, "литералът в <= не съответства на типа на колоната", "42804")
        }
        if sel.hi_col != pkcol.name { pk_range = 0 }
    }
    // eq point / secondary — small results; use materialize path via empty skip
    if sel.has_eq == 1 {
        let f = boila_fetch_rows(s, txn, t, sel)?
        s = f.s
        if f.ok == 0 {
            return boila_exec_fail(s, txn, f.err, f.state)
        }
        let mut r: i64 = 0
        while r < vec_len(f.rows) {
            st = boila_agg_fold_row(st, sel, vec_get(f.rows, r))?
            if st.ok == 0 {
                return boila_exec_fail(s, txn, st.err, st.state)
            }
            r = r + 1
        }
        let ag = boila_agg_fold_end(st, sel)?
        if ag.ok == 0 {
            return boila_exec_fail(s, txn, ag.err, ag.state)
        }
        return boila_exec_ok_select(s, txn, ag.res)
    }
    // secondary index range → pks then fold (no full row Vec)
    if (sel.has_lo == 1 || sel.has_hi == 1) && pk_range == 0 && sel.has_eq == 0 {
        let mut rc = sel.lo_col
        if sel.has_lo == 0 { rc = sel.hi_col }
        let mut okc = 1
        if sel.has_lo == 1 && sel.has_hi == 1 && sel.lo_col != sel.hi_col { okc = 0 }
        if okc == 1 {
            let cix = boila_col_idx(t, rc)
            let ixid = boila_ix_by_col_t(t, cix)
            if cix >= 0 && ixid >= 0 {
                let xr = boila_ix_range(s, t, ixid, sel.has_lo, sel.pk_lo, sel.has_hi, sel.pk_hi, sel.lo_excl, sel.hi_excl)?
                s = xr.s
                if xr.ok == 0 {
                    return boila_exec_fail(s, txn, xr.err, xr.state)
                }
                if xr.has == 1 {
                    boila_scan_buf_range(txn, t, cix, sel.has_lo, sel.pk_lo, sel.has_hi, sel.pk_hi, sel.lo_excl, sel.hi_excl, xr.pks)
                    let bud = boila_budget_begin()?
                    let mut li: i64 = 0
                    while li < vec_len(xr.pks) {
                        let ge = boila_budget_gate(bud, li, 0, 0)?
                        if ge != "" {
                            return boila_exec_fail(s, txn, ge, boila_budget_gate_state(ge))
                        }
                        let g = boila_txn_get(s, txn, t.id, vec_get(xr.pks, li))?
                        s = g.s
                        if g.found == 1 {
                            let row = boila_row_dec(g.row)
                            st = boila_agg_fold_row(st, sel, row)?
                            if st.ok == 0 {
                                return boila_exec_fail(s, txn, st.err, st.state)
                            }
                        }
                        li = li + 1
                    }
                    let ag = boila_agg_fold_end(st, sel)?
                    if ag.ok == 0 {
                        return boila_exec_fail(s, txn, ag.err, ag.state)
                    }
                    return boila_exec_ok_select(s, txn, ag.res)
                }
            }
        }
    }
    // full keys / PK range
    let bud = boila_budget_begin()?
    let ks = boila_txn_keys(s, txn, t.id)?
    s = ks.s
    let g0 = boila_budget_gate(bud, 0, vec_len(ks.pks), 0)?
    if g0 != "" {
        return boila_exec_fail(s, txn, g0, boila_budget_gate_state(g0))
    }
    let pks = ks.pks
    let n = vec_len(pks)
    if (sel.has_lo == 1 || sel.has_hi == 1) && pk_range == 1 && sel.between_not == 0 {
        boila_pk_sort(pks)
        let mut ki: i64 = 0
        let mut lo_enc = bytes_new(0)
        if sel.has_lo == 1 {
            lo_enc = boila_val_enc(sel.pk_lo)
            ki = boila_pk_lb(pks, lo_enc)
            if sel.lo_excl == 1 && ki < n && boila_bytes_cmp(vec_get(pks, ki), lo_enc) == 0 {
                ki = ki + 1
            }
        }
        let mut hi_enc = bytes_new(0)
        if sel.has_hi == 1 { hi_enc = boila_val_enc(sel.pk_hi) }
        while ki < n {
            let ge = boila_budget_gate(bud, ki, 0, 0)?
            if ge != "" {
                return boila_exec_fail(s, txn, ge, boila_budget_gate_state(ge))
            }
            let pkenc = vec_get(pks, ki)
            if sel.has_hi == 1 {
                let hc = boila_bytes_cmp(pkenc, hi_enc)
                if sel.hi_excl == 1 {
                    if hc >= 0 { ki = n }
                } else {
                    if hc > 0 { ki = n }
                }
            }
            if ki < n {
                let g = boila_txn_get(s, txn, t.id, pkenc)?
                s = g.s
                if g.found == 1 {
                    let row = boila_row_dec(g.row)
                    if (sel.has_like == 0 && sel.has_in == 0 && sel.has_ne == 0) || boila_row_pass_filters(row, t, sel) == 1 {
                        st = boila_agg_fold_row(st, sel, row)?
                        if st.ok == 0 {
                            return boila_exec_fail(s, txn, st.err, st.state)
                        }
                    }
                }
                ki = ki + 1
            }
        }
        let ag = boila_agg_fold_end(st, sel)?
        if ag.ok == 0 {
            return boila_exec_fail(s, txn, ag.err, ag.state)
        }
        return boila_exec_ok_select(s, txn, ag.res)
    }
    let mut need_f = sel.has_eq
    if (sel.has_lo == 1 || sel.has_hi == 1) && (pk_range == 0 || sel.between_not == 1) { need_f = 1 }
    if sel.has_like > 0 { need_f = 1 }
    if sel.has_in > 0 { need_f = 1 }
    if sel.has_ne == 1 { need_f = 1 }
    let mut ki: i64 = 0
    while ki < n {
        let ge = boila_budget_gate(bud, ki, 0, 0)?
        if ge != "" {
            return boila_exec_fail(s, txn, ge, boila_budget_gate_state(ge))
        }
        let g = boila_txn_get(s, txn, t.id, vec_get(pks, ki))?
        s = g.s
        if g.found == 1 {
            let row = boila_row_dec(g.row)
            if need_f == 0 || boila_row_pass_filters(row, t, sel) == 1 {
                st = boila_agg_fold_row(st, sel, row)?
                if st.ok == 0 {
                    return boila_exec_fail(s, txn, st.err, st.state)
                }
            }
        }
        ki = ki + 1
    }
    let ag = boila_agg_fold_end(st, sel)?
    if ag.ok == 0 {
        return boila_exec_fail(s, txn, ag.err, ag.state)
    }
    return boila_exec_ok_select(s, txn, ag.res)
}
