// exec_agg_stream.baga — stream fold за plain / join / xw (+ филтри):
// gate-ът пред fold-а и споделената fold+хw стъпка. Пътеките на
// модалите са в exec_agg_modal.baga, rollup-ът — в exec_agg_rollup.baga,
// fused fetch+fold — в exec_agg_scan.baga.

import "ast.baga"
import "exec_agg_feed.baga"
import "exec_xw.baga"
import "exec_dual_ops.baga"

fn boila_agg_streamable(sel: BoilaSel) -> i64 {
    return 1
}

fn boila_agg_fold_row_xw(st: BoilaAggFold, sel: BoilaSel, names: Vec<str>, row: Vec<BoilaVal>) -> BoilaAggFold !Time {
    if sel.has_xw == 1 {
        let e = boila_xw_eval(names, sel.xw_toks, row)?
        if e.ok == 0 {
            st.ok = 0
            st.err = e.err
            st.state = e.state
            return st
        }
        if boila_dual_when_true(e.val) == 0 {
            return st
        }
    }
    return boila_agg_fold_row(st, sel, row)?
}
