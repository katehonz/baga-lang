// parse_insert.baga — parser за INSERT (P3).
//
// Граматика:
//   INSERT INTO t (col,...) VALUES (lit,...) [,(lit,...)]*
//     [ON CONFLICT DO NOTHING | DO UPDATE SET col = lit|expr [,...]]
//     [RETURNING (* | col,...)] [;]
//
// Q-oc-expr: SET values may be dual expressions (OLD row cols) or
// EXCLUDED.col (proposed insert row). Dots only for EXCLUDED rewrite.

import "token.baga"
import "lexer.baga"
import "ast.baga"
import "parse_select.baga"
import "parse_common.baga"
import "parse_dml.baga"
import "../core/value.baga"
import "std/str/str.baga"

// Rewrite EXCLUDED.col → ident excluded$col (dual bind name).
fn boila_oc_rewrite_excluded(xtoks: Vec<Token>) -> Vec<Token> {
    let out: Vec<Token> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(xtoks) {
        let t = vec_get(xtoks, i)
        if t.kind == tok_ident() && t.txt == "excluded" && i + 2 < vec_len(xtoks) {
            let d = vec_get(xtoks, i + 1)
            let c = vec_get(xtoks, i + 2)
            if d.kind == tok_dot() && c.kind == tok_ident() {
                vec_push(out, token_new(tok_ident(), concat("excluded$", c.txt)))
                i = i + 3
            } else {
                vec_push(out, t)
                i = i + 1
            }
        } else {
            vec_push(out, t)
            i = i + 1
        }
    }
    return out
}

struct BoilaParseIns {
    ok: i64,
    ins: BoilaIns,
    err: str,
    state: str
}

fn boila_pi_fail(msg: str, state: str) -> BoilaParseIns {
    return BoilaParseIns { ok: 0, ins: boila_ins_empty(), err: msg, state: state }
}

// tok0 = INSERT проверено от dispatch.
fn boila_parse_insert(l: BoilaLex) -> BoilaParseIns {
    let mut ins = boila_ins_empty()
    let mut i: i64 = 1
    if tok_kw(boila_ps_tok(l, i), "into") != 1 {
        return boila_pi_fail("очаквах INTO след INSERT", "42601")
    }
    i = i + 1
    let tb = boila_ps_tok(l, i)
    if tb.kind != tok_ident() {
        return boila_pi_fail("очаквах име на таблица след INSERT INTO", "42601")
    }
    ins.table = tb.txt
    i = i + 1
    if boila_ps_tok(l, i).kind != tok_lparen() {
        return boila_pi_fail("очаквах '(' с колони след името на таблицата", "42601")
    }
    i = i + 1
    let mut more = true
    while more {
        let c = boila_ps_tok(l, i)
        if c.kind != tok_ident() {
            return boila_pi_fail("очаквах име на колона в INSERT", "42601")
        }
        vec_push(ins.cols, c.txt)
        i = i + 1
        if boila_ps_tok(l, i).kind == tok_comma() {
            i = i + 1
        } else {
            if boila_ps_tok(l, i).kind != tok_rparen() {
                return boila_pi_fail("очаквах ',' или ')' в списъка с колони", "42601")
            }
            i = i + 1
            more = false
        }
    }
    if tok_kw(boila_ps_tok(l, i), "values") != 1 {
        return boila_pi_fail("очаквах VALUES", "42601")
    }
    i = i + 1
    let mut tuples = true
    while tuples {
        if boila_ps_tok(l, i).kind != tok_lparen() {
            return boila_pi_fail("очаквах '(' пред стойностите", "42601")
        }
        i = i + 1
        let row: Vec<BoilaVal> = vec_new()
        let mut vals = true
        while vals {
            let lit = boila_ps_literal(l, i)
            if lit.ok == 0 {
                return boila_pi_fail(lit.err, lit.state)
            }
            vec_push(row, lit.v)
            i = i + 1
            if boila_ps_tok(l, i).kind == tok_comma() {
                i = i + 1
            } else {
                if boila_ps_tok(l, i).kind != tok_rparen() {
                    return boila_pi_fail("очаквах ',' или ')' във VALUES", "42601")
                }
                i = i + 1
                vals = false
            }
        }
        if vec_len(row) != vec_len(ins.cols) {
            return boila_pi_fail("брой стойности != брой колони", "42601")
        }
        vec_push(ins.rows, row)
        if boila_ps_tok(l, i).kind == tok_comma() {
            i = i + 1
        } else {
            tuples = false
        }
    }
    // ON CONFLICT
    if tok_kw(boila_ps_tok(l, i), "on") == 1 {
        if tok_kw(boila_ps_tok(l, i + 1), "conflict") != 1 {
            return boila_pi_fail("очаквах CONFLICT след ON", "42601")
        }
        i = i + 2
        if tok_kw(boila_ps_tok(l, i), "do") != 1 {
            return boila_pi_fail("очаквах DO след ON CONFLICT", "42601")
        }
        i = i + 1
        if tok_kw(boila_ps_tok(l, i), "nothing") == 1 {
            ins.oc = 1
            i = i + 1
        } else {
            if tok_kw(boila_ps_tok(l, i), "update") != 1 {
                return boila_pi_fail("очаквах NOTHING или UPDATE след ON CONFLICT DO", "42601")
            }
            i = i + 1
            if tok_kw(boila_ps_tok(l, i), "set") != 1 {
                return boila_pi_fail("очаквах SET след DO UPDATE", "42601")
            }
            i = i + 1
            ins.oc = 2
            let mut sets = true
            while sets {
                let c = boila_ps_tok(l, i)
                if c.kind != tok_ident() {
                    return boila_pi_fail("очаквах колона в DO UPDATE SET", "42601")
                }
                if boila_ps_tok(l, i + 1).kind != tok_op() || boila_ps_tok(l, i + 1).txt != "=" {
                    return boila_pi_fail("очаквах '=' в DO UPDATE SET", "42601")
                }
                let vt = boila_ps_tok(l, i + 2)
                let mut is_lit: i64 = 0
                if vt.kind == tok_num() || vt.kind == tok_str() || vt.kind == tok_param() {
                    is_lit = 1
                }
                if vt.kind == tok_ident() && (tok_kw(vt, "null") == 1 || tok_kw(vt, "true") == 1 || tok_kw(vt, "false") == 1) {
                    is_lit = 1
                }
                // Q-xparam: bare lit only if the value is not the start of a larger expr
                if is_lit == 1 {
                    let aft = boila_ps_tok(l, i + 3)
                    if aft.kind == tok_op() || aft.kind == tok_star() || aft.kind == tok_lparen() {
                        is_lit = 0
                    }
                    if aft.kind == tok_ident() && (tok_kw(aft, "and") == 1 || tok_kw(aft, "or") == 1 || tok_kw(aft, "between") == 1 || tok_kw(aft, "in") == 1 || tok_kw(aft, "like") == 1 || tok_kw(aft, "ilike") == 1 || tok_kw(aft, "is") == 1 || tok_kw(aft, "not") == 1) {
                        is_lit = 0
                    }
                }
                if is_lit == 1 {
                    let lit = boila_ps_literal(l, i + 2)
                    if lit.ok == 0 {
                        return boila_pi_fail(lit.err, lit.state)
                    }
                    vec_push(ins.oc_cols, c.txt)
                    vec_push(ins.oc_vals, lit.v)
                    let ex0: Vec<Token> = vec_new()
                    vec_push(ins.oc_xtoks, ex0)
                    i = i + 3
                } else {
                    // Q-oc-expr: SET col = <expr> (OLD / EXCLUDED.col)
                    let xe = boila_ps_expr_item(l, i + 2)
                    if xe.ok == 0 {
                        return boila_pi_fail(xe.err, xe.state)
                    }
                    let xt = boila_oc_rewrite_excluded(xe.item.xtoks)
                    let gd = boila_pd_xw_guard(xt)
                    if gd.ok == 0 {
                        return boila_pi_fail(gd.err, gd.state)
                    }
                    vec_push(ins.oc_cols, c.txt)
                    vec_push(ins.oc_vals, boila_val_null())
                    vec_push(ins.oc_xtoks, xt)
                    i = xe.pos
                }
                if boila_ps_tok(l, i).kind == tok_comma() {
                    i = i + 1
                } else {
                    sets = false
                }
            }
        }
    }
    let ret = boila_pd_returning(l, i)
    if ret.ok == 0 {
        return boila_pi_fail(ret.err, ret.state)
    }
    ins.has_ret = ret.has_ret
    ins.ret_star = ret.ret_star
    ins.ret_cols = ret.ret_cols
    i = ret.pos
    if boila_ps_tok(l, i).kind == tok_semi() {
        i = i + 1
    }
    if boila_ps_tok(l, i).kind != tok_eof() {
        let extra = boila_ps_tok(l, i)
        return boila_pi_fail(concat("неочакван токен '", concat(extra.txt, "' в INSERT")), "0A000")
    }
    return BoilaParseIns { ok: 1, ins: ins, err: "", state: "" }
}
