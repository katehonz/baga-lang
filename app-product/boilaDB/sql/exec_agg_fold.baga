// exec_agg_fold.baga — shared hash-agg fold state (stream + materialize).
// Setup / feed one row / finish emit. Used by exec_agg + exec_agg_stream.

import "../core/value.baga"
import "../core/row.baga"
import "../catalog/schema.baga"
import "../ts/time_bucket.baga"
import "ast.baga"
import "token.baga"
import "exec_scan.baga"
import "exec_agg_extra.baga"
import "exec_agg_gexpr.baga"
import "exec_agg_hav.baga"
import "exec_xw.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

struct BoilaAggFold {
    ok: i64,
    err: str,
    state: str,
    gixs: Vec<i64>,
    aixs: Vec<i64>,
    agg_items: Vec<BoilaSelItem>,
    hav_slots: Vec<i64>,
    n_proj: i64,
    nitems: i64,
    xnames: Vec<str>,
    bucket_ix: i64,
    single_i64: i64,
    gkeys: Vec<bytes>,
    gaccs: Vec<BoilaAggAcc>,
    gmap: Map<str, i64>,
    gimap: Map<i64, i64>,
    use_proj: i64,
    res: BoilaResult,
    cols: Vec<BoilaColDef>
}

fn boila_agg_fold_fail(msg: str, state: str) -> BoilaAggFold {
    let z: Vec<i64> = vec_new()
    let zb: Vec<bytes> = vec_new()
    let za: Vec<BoilaAggAcc> = vec_new()
    let zi: Vec<BoilaSelItem> = vec_new()
    let zs: Vec<str> = vec_new()
    let zc: Vec<BoilaColDef> = vec_new()
    let gm: Map<str, i64> = map_new()
    let gi: Map<i64, i64> = map_new()
    return BoilaAggFold {
        ok: 0, err: msg, state: state,
        gixs: z, aixs: z, agg_items: zi, hav_slots: z, n_proj: 0, nitems: 0,
        xnames: zs, bucket_ix: 0 - 1, single_i64: 0,
        gkeys: zb, gaccs: za, gmap: gm, gimap: gi,
        use_proj: 0, res: boila_result_empty(), cols: zc
    }
}

fn boila_agg_fold_start(cols: Vec<BoilaColDef>, sel: BoilaSel) -> BoilaAggFold !Time {
    let gixs: Vec<i64> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(sel.group_cols) {
        let nm = vec_get(sel.group_cols, i)
        let mut gxt: Vec<Token> = vec_new()
        if i < vec_len(sel.group_xtoks) {
            gxt = vec_get(sel.group_xtoks, i)
        }
        let mut ix: i64 = 0 - 1
        if vec_len(gxt) > 0 {
            ix = 0 - 1
        } else {
            if nm == "time_bucket" && sel.bucket_iv > 0 {
                ix = boila_col_idx_of(cols, sel.bucket_col)
                if ix < 0 {
                    return boila_agg_fold_fail(concat("time_bucket колона '", concat(sel.bucket_col, "' не съществува")), "42703")
                }
            } else {
                ix = boila_col_idx_of(cols, nm)
                if ix < 0 {
                    return boila_agg_fold_fail(concat("GROUP BY колона '", concat(nm, "' не съществува")), "42703")
                }
            }
        }
        vec_push(gixs, ix)
        i = i + 1
    }
    let xnames: Vec<str> = vec_new()
    i = 0
    while i < vec_len(cols) {
        vec_push(xnames, vec_get(cols, i).name)
        i = i + 1
    }
    let mut bucket_ix: i64 = 0 - 1
    if sel.bucket_iv > 0 {
        bucket_ix = boila_col_idx_of(cols, sel.bucket_col)
        if bucket_ix < 0 {
            return boila_agg_fold_fail(concat("time_bucket колона '", concat(sel.bucket_col, "' не съществува")), "42703")
        }
    }
    let mut aixs: Vec<i64> = vec_new()
    let mut agg_items: Vec<BoilaSelItem> = vec_new()
    i = 0
    while i < vec_len(sel.items) {
        let it = vec_get(sel.items, i)
        if it.agg > 0 {
            if it.agg == 1 {
                vec_push(aixs, 0 - 1)
            } else {
                if vec_len(it.xtoks) > 0 {
                    vec_push(aixs, 0 - 2)
                } else {
                    let ix = boila_col_idx_of(cols, it.col)
                    if ix < 0 {
                        return boila_agg_fold_fail(concat("агрегатна колона '", concat(it.col, "' не съществува")), "42703")
                    }
                    if it.agg == 3 || it.agg == 4 {
                        let cd = vec_get(cols, ix)
                        if cd.typ != boila_v_i64() && cd.typ != boila_v_ts() {
                            return boila_agg_fold_fail(concat("sum/avg само върху BIGINT колона ('", concat(it.col, "')")), "0A000")
                        }
                    }
                    vec_push(aixs, ix)
                }
            }
            vec_push(agg_items, it)
        }
        i = i + 1
    }
    let hs = boila_hav_setup(cols, sel, agg_items, aixs)
    if hs.ok == 0 {
        return boila_agg_fold_fail(hs.err, hs.state)
    }
    agg_items = hs.items
    aixs = hs.aixs
    let hav_slots = hs.slots
    let n_proj_aggs = hs.n_proj
    let nitems = vec_len(agg_items)
    if sel.has_group == 1 {
        let mut pi: i64 = 0
        while pi < vec_len(sel.items) {
            let it = vec_get(sel.items, pi)
            if it.agg == 0 && it.sfn == "" && vec_len(it.xtoks) == 0 && it.biv == 0 {
                if boila_agg_in_group(sel, it.col) == 0 {
                    return boila_agg_fold_fail(concat("колона '", concat(it.col, "' трябва да е в GROUP BY или агрегат")), "42803")
                }
            }
            pi = pi + 1
        }
    }
    let use_gexpr = boila_agg_has_gexpr(sel)
    let mut use_proj = use_gexpr
    if boila_agg_has_gbyx(sel) == 1 {
        use_proj = 1
    }
    let mut res = boila_result_empty()
    if use_gexpr == 1 || use_proj == 1 {
        let gs = boila_agg_gexpr_schema(cols, sel)?
        if gs.ok == 0 {
            return boila_agg_fold_fail(gs.err, gs.state)
        }
        res = gs.res
    } else {
        i = 0
        while i < vec_len(sel.group_cols) {
            let nm = vec_get(sel.group_cols, i)
            let mut tag = boila_v_i64()
            if nm == "time_bucket" && sel.bucket_iv > 0 {
                let bix = boila_col_idx_of(cols, sel.bucket_col)
                if bix >= 0 { tag = vec_get(cols, bix).typ }
            } else {
                let gix = boila_col_idx_of(cols, nm)
                if gix >= 0 { tag = vec_get(cols, gix).typ }
            }
            let mut onm = nm
            let mut j: i64 = 0
            while j < vec_len(sel.items) {
                let it = vec_get(sel.items, j)
                if it.agg == 0 {
                    if nm == "time_bucket" && it.biv > 0 {
                        onm = boila_sel_item_out_name(it)
                        j = vec_len(sel.items)
                    } else {
                        if it.biv == 0 && it.col == nm {
                            onm = boila_sel_item_out_name(it)
                            j = vec_len(sel.items)
                        }
                    }
                }
                j = j + 1
            }
            boila_result_add_col(res, onm, tag)
            i = i + 1
        }
        i = 0
        while i < n_proj_aggs {
            boila_result_add_col(res, boila_agg_item_name(vec_get(agg_items, i)), boila_v_i64())
            i = i + 1
        }
    }
    let mut single_i64 = 0
    if vec_len(gixs) == 1 {
        if sel.bucket_iv > 0 {
            single_i64 = 1
        } else {
            let g0 = vec_get(gixs, 0)
            if g0 >= 0 && g0 < vec_len(cols) {
                let gt = vec_get(cols, g0).typ
                if gt == boila_v_i64() || gt == boila_v_ts() {
                    single_i64 = 1
                }
            }
        }
    }
    let gkeys: Vec<bytes> = vec_new()
    let gaccs: Vec<BoilaAggAcc> = vec_new()
    let gmap: Map<str, i64> = map_new()
    let gimap: Map<i64, i64> = map_new()
    return BoilaAggFold {
        ok: 1, err: "", state: "",
        gixs: gixs, aixs: aixs, agg_items: agg_items, hav_slots: hav_slots,
        n_proj: n_proj_aggs, nitems: nitems, xnames: xnames,
        bucket_ix: bucket_ix, single_i64: single_i64,
        gkeys: gkeys, gaccs: gaccs, gmap: gmap, gimap: gimap,
        use_proj: use_proj, res: res, cols: cols
    }
}

struct BoilaAggOut {
    ok: i64,
    err: str,
    state: str,
    res: BoilaResult
}

fn boila_agg_out_fail(msg: str, state: str) -> BoilaAggOut {
    return BoilaAggOut { ok: 0, err: msg, state: state, res: boila_result_empty() }
}
