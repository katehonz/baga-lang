// exec_scan_pks.baga — Q-stream-join/outer: PK-и без ред вектори.
// BoilaPksOut + boila_fetch_pks: кандидатите се филтрират при GET
// (по един жив ред наведнъж). BoilaPksOut е споделен с exec_join
// (sorted outer) и exec_knn.

import "../storage/shards.baga"
import "../core/codec.baga"
import "../core/value.baga"
import "../core/row.baga"
import "../catalog/schema.baga"
import "../index/secondary.baga"
import "../fts/fts.baga"
import "../core/budget.baga"
import "../txn/mvcc.baga"
import "ast.baga"
import "exec_sort.baga"
import "exec_buf.baga"
import "exec_filter.baga"
import "exec_scan.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

// Q-stream-join: matching outer pks only (no row Vec). Filters applied at GET.
struct BoilaPksOut {
    s: BoilaStore,
    txn: BoilaTxn,
    ok: i64,
    err: str,
    state: str,
    pks: Vec<bytes>
}

fn boila_pks_fail(s: BoilaStore, txn: BoilaTxn, msg: str, state: str) -> BoilaPksOut {
    let pks: Vec<bytes> = vec_new()
    return BoilaPksOut { s: s, txn: txn, ok: 0, err: msg, state: state, pks: pks }
}

fn boila_fetch_pks(s: BoilaStore, txn: BoilaTxn, t: BoilaTable, sel: BoilaSel) -> BoilaPksOut !IO !Time !Par {
    // Reuse fetch_rows paths that already collect pks first; for the rest
    // walk candidates and keep only matching pks (one live row at a time).
    let pks: Vec<bytes> = vec_new()
    if sel.has_fts == 1 {
        let f = boila_fetch_rows(s, txn, t, sel)?
        if f.ok == 0 {
            return boila_pks_fail(f.s, f.txn, f.err, f.state)
        }
        let mut i: i64 = 0
        while i < vec_len(f.rows) {
            let row = vec_get(f.rows, i)
            if t.pk_idx >= 0 && t.pk_idx < vec_len(row) {
                vec_push(pks, boila_val_enc(vec_get(row, t.pk_idx)))
            }
            i = i + 1
        }
        return BoilaPksOut { s: f.s, txn: f.txn, ok: 1, err: "", state: "", pks: pks }
    }
    let pkcol = vec_get(t.cols, t.pk_idx)
    let mut pk_range: i64 = 1
    if sel.has_lo == 1 {
        let cix = boila_col_idx(t, sel.lo_col)
        if cix < 0 { return boila_pks_fail(s, txn, concat("колона '", concat(sel.lo_col, "' не съществува")), "42703") }
        if boila_pk_lit_ok(vec_get(t.cols, cix).typ, sel.pk_lo) == 0 {
            return boila_pks_fail(s, txn, "литералът в >= не съответства на типа на колоната", "42804")
        }
        if sel.lo_col != pkcol.name { pk_range = 0 }
    }
    if sel.has_hi == 1 {
        let cix = boila_col_idx(t, sel.hi_col)
        if cix < 0 { return boila_pks_fail(s, txn, concat("колона '", concat(sel.hi_col, "' не съществува")), "42703") }
        if boila_pk_lit_ok(vec_get(t.cols, cix).typ, sel.pk_hi) == 0 {
            return boila_pks_fail(s, txn, "литералът в <= не съответства на типа на колоната", "42804")
        }
        if sel.hi_col != pkcol.name { pk_range = 0 }
    }
    if sel.has_eq == 1 {
        if sel.pk_eq.tag == boila_v_null() {
            return BoilaPksOut { s: s, txn: txn, ok: 1, err: "", state: "", pks: pks }
        }
        if sel.eq_col == pkcol.name {
            if boila_pk_lit_ok(pkcol.typ, sel.pk_eq) == 0 {
                return boila_pks_fail(s, txn, "литералът в = не съответства на типа на PRIMARY KEY", "42804")
            }
            let pkenc = boila_val_enc(sel.pk_eq)
            let g = boila_txn_get(s, txn, t.id, pkenc)?
            if g.found == 1 {
                vec_push(pks, pkenc)
            }
            return BoilaPksOut { s: g.s, txn: txn, ok: 1, err: "", state: "", pks: pks }
        }
        let cix = boila_col_idx(t, sel.eq_col)
        if cix < 0 {
            return boila_pks_fail(s, txn, concat("колона '", concat(sel.eq_col, "' не съществува")), "42703")
        }
        let cd = vec_get(t.cols, cix)
        if boila_pk_lit_ok(cd.typ, sel.pk_eq) == 0 {
            return boila_pks_fail(s, txn, "литералът в = не съответства на типа на колоната", "42804")
        }
        let ixid = boila_ix_by_col_t(t, cix)
        if ixid >= 0 {
            let lk = boila_ix_lookup(s, t, ixid, sel.pk_eq)?
            s = lk.s
            boila_scan_buf_eq(txn, t, cix, sel.pk_eq, lk.pks)
            let mut li: i64 = 0
            while li < vec_len(lk.pks) {
                let g = boila_txn_get(s, txn, t.id, vec_get(lk.pks, li))?
                s = g.s
                if g.found == 1 {
                    vec_push(pks, vec_get(lk.pks, li))
                }
                li = li + 1
            }
            return BoilaPksOut { s: s, txn: txn, ok: 1, err: "", state: "", pks: pks }
        }
    }
    if (sel.has_lo == 1 || sel.has_hi == 1) && pk_range == 0 && sel.has_eq == 0 {
        let mut rc = sel.lo_col
        if sel.has_lo == 0 { rc = sel.hi_col }
        let mut okc = 1
        if sel.has_lo == 1 && sel.has_hi == 1 && sel.lo_col != sel.hi_col { okc = 0 }
        if okc == 1 {
            let cix = boila_col_idx(t, rc)
            let ixid = boila_ix_by_col_t(t, cix)
            if cix >= 0 && ixid >= 0 {
                let xr = boila_ix_range(s, t, ixid, sel.has_lo, sel.pk_lo, sel.has_hi, sel.pk_hi, sel.lo_excl, sel.hi_excl)?
                s = xr.s
                if xr.ok == 0 { return boila_pks_fail(s, txn, xr.err, xr.state) }
                if xr.has == 1 {
                    boila_scan_buf_range(txn, t, cix, sel.has_lo, sel.pk_lo, sel.has_hi, sel.pk_hi, sel.lo_excl, sel.hi_excl, xr.pks)
                    let mut li: i64 = 0
                    while li < vec_len(xr.pks) {
                        let g = boila_txn_get(s, txn, t.id, vec_get(xr.pks, li))?
                        s = g.s
                        if g.found == 1 {
                            vec_push(pks, vec_get(xr.pks, li))
                        }
                        li = li + 1
                    }
                    return BoilaPksOut { s: s, txn: txn, ok: 1, err: "", state: "", pks: pks }
                }
            }
        }
    }
    let bud = boila_budget_begin()?
    let ks = boila_txn_keys(s, txn, t.id)?
    s = ks.s
    let g0 = boila_budget_gate(bud, 0, vec_len(ks.pks), 0)?
    if g0 != "" { return boila_pks_fail(s, txn, g0, boila_budget_gate_state(g0)) }
    let all = ks.pks
    let n = vec_len(all)
    if (sel.has_lo == 1 || sel.has_hi == 1) && pk_range == 1 && sel.between_not == 0 {
        boila_pk_sort(all)
        let mut ki: i64 = 0
        let mut lo_enc = bytes_new(0)
        if sel.has_lo == 1 {
            lo_enc = boila_val_enc(sel.pk_lo)
            ki = boila_pk_lb(all, lo_enc)
            if sel.lo_excl == 1 && ki < n && boila_bytes_cmp(vec_get(all, ki), lo_enc) == 0 {
                ki = ki + 1
            }
        }
        let mut hi_enc = bytes_new(0)
        if sel.has_hi == 1 { hi_enc = boila_val_enc(sel.pk_hi) }
        while ki < n {
            let ge = boila_budget_gate(bud, ki, 0, 0)?
            if ge != "" { return boila_pks_fail(s, txn, ge, boila_budget_gate_state(ge)) }
            let pkenc = vec_get(all, ki)
            if sel.has_hi == 1 {
                let hc = boila_bytes_cmp(pkenc, hi_enc)
                if sel.hi_excl == 1 {
                    if hc >= 0 { ki = n }
                } else {
                    if hc > 0 { ki = n }
                }
            }
            if ki < n {
                let g = boila_txn_get(s, txn, t.id, pkenc)?
                s = g.s
                if g.found == 1 {
                    let row = boila_row_dec(g.row)
                    if (sel.has_like == 0 && sel.has_in == 0 && sel.has_ne == 0) || boila_row_pass_filters(row, t, sel) == 1 {
                        vec_push(pks, pkenc)
                    }
                }
                ki = ki + 1
            }
        }
        return BoilaPksOut { s: s, txn: txn, ok: 1, err: "", state: "", pks: pks }
    }
    let mut need_f = sel.has_eq
    if (sel.has_lo == 1 || sel.has_hi == 1) && (pk_range == 0 || sel.between_not == 1) { need_f = 1 }
    if sel.has_like > 0 { need_f = 1 }
    if sel.has_in > 0 { need_f = 1 }
    if sel.has_ne == 1 { need_f = 1 }
    // Unfiltered full table: pks = live keys (no GET until join probe)
    if need_f == 0 {
        return BoilaPksOut { s: s, txn: txn, ok: 1, err: "", state: "", pks: all }
    }
    let mut ki: i64 = 0
    while ki < n {
        let ge = boila_budget_gate(bud, ki, 0, 0)?
        if ge != "" { return boila_pks_fail(s, txn, ge, boila_budget_gate_state(ge)) }
        let pkenc = vec_get(all, ki)
        let g = boila_txn_get(s, txn, t.id, pkenc)?
        s = g.s
        if g.found == 1 {
            let row = boila_row_dec(g.row)
            if boila_row_pass_filters(row, t, sel) == 1 {
                vec_push(pks, pkenc)
            }
        }
        ki = ki + 1
    }
    return BoilaPksOut { s: s, txn: txn, ok: 1, err: "", state: "", pks: pks }
}
