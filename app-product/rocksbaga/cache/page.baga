// page.baga — S5/R19 clock page cache over positioned binary file IO.
//
// Shared across open files: keys are (file_id, page_no); writeback uses a
// per-file fd registry (R19). Pin counts block eviction of pages a caller
// still holds. Mutable scalar/vec fields use the return-updated struct
// pattern (assignment through a by-value param does not stick; Maps do).

import "std/os/os.baga"
import "std/str/str.baga"

// Composite key: file_id * 1_000_000_000 + page_no  (file_id = SST gen, etc.)
fn pc_key(file_id: i64, page_no: i64) -> i64 {
    return file_id * 1000000000 + page_no
}

fn pc_file_id(key: i64) -> i64 {
    return key / 1000000000
}

fn pc_page_no(key: i64) -> i64 {
    return key % 1000000000
}

struct PageCache {
    page_size: i64,
    cap: i64,
    hand: i64,
    data: Map<i64, bytes>,
    dirty: Map<i64, i64>,
    refbit: Map<i64, i64>,
    pins: Map<i64, i64>,   // R19: pin count; >0 ⇒ never evict
    fds: Map<i64, i64>,    // R19: file_id → open fd for multi-file writeback
    keys: Vec<i64>,
    scratch: str  // R18: shared pread buffer — raw write space, never a string
}

fn pc_new(page_size: i64, cap: i64) -> PageCache {
    let mut ps = page_size
    if ps < 256 {
        ps = 4096
    }
    let mut c = cap
    if c < 1 {
        c = 16
    }
    return PageCache {
        page_size: ps,
        cap: c,
        hand: 0,
        data: map_new(),
        dirty: map_new(),
        refbit: map_new(),
        pins: map_new(),
        fds: map_new(),
        keys: vec_new(),
        scratch: str_repeat(" ", ps)
    }
}

// --- R19: open-file registry (Maps mutate in place) ---

fn pc_register_file(pc: PageCache, file_id: i64, fd: i64) {
    if fd >= 0 {
        // MEM-4: pc.fds is cross-request cache state (survives serve rewind).
        mem_persist_begin()
        map_set(pc.fds, file_id, fd)
        mem_persist_end()
    }
}

fn pc_unregister_file(pc: PageCache, file_id: i64) {
    map_del(pc.fds, file_id)
}

// Resolve writeback/read fd: registered file wins, else caller fallback.
fn pc_fd_for(pc: PageCache, file_id: i64, fallback_fd: i64) -> i64 {
    if map_has(pc.fds, file_id) == 1 {
        return map_get(pc.fds, file_id)
    }
    return fallback_fd
}

// --- R19: pin counts ---

fn pc_pin_count(pc: PageCache, key: i64) -> i64 {
    if map_has(pc.pins, key) == 0 {
        return 0
    }
    return map_get(pc.pins, key)
}

// Pin a resident page (or mark key pinned before insert). Maps mutate in place.
fn pc_pin(pc: PageCache, file_id: i64, page_no: i64) {
    let key = pc_key(file_id, page_no)
    let n = pc_pin_count(pc, key)
    // Pins are request-scoped (pc_read_at unpins before return); ephemeral.
    map_set(pc.pins, key, n + 1)
}

fn pc_unpin(pc: PageCache, file_id: i64, page_no: i64) {
    let key = pc_key(file_id, page_no)
    let n = pc_pin_count(pc, key)
    if n <= 1 {
        map_del(pc.pins, key)
    } else {
        map_set(pc.pins, key, n - 1)
    }
}

// Write one dirty page back. Uses registry fd for key's file when present.
// 0 ok, -1 error.
fn pc_writeback(pc: PageCache, fallback_fd: i64, key: i64) -> i64 !IO {
    if map_has(pc.dirty, key) == 0 {
        return 0
    }
    if map_get(pc.dirty, key) == 0 {
        return 0
    }
    let file_id = pc_file_id(key)
    let page_no = pc_page_no(key)
    let fd = pc_fd_for(pc, file_id, fallback_fd)
    if fd < 0 {
        return 0 - 1
    }
    let data = map_get(pc.data, key)
    let off = page_no * pc.page_size
    if fd_pwrite_bytes(fd, data, off) != 0 {
        return 0 - 1
    }
    map_set(pc.dirty, key, 0)
    return 0
}

struct PcEvict {
    pc: PageCache,
    rc: i64
}

// Evict one unpinned page via clock. Skips pin>0. rc: 0 ok, -1 IO, -2 all pinned.
fn pc_evict_one(pc: PageCache, fallback_fd: i64) -> PcEvict !IO {
    if vec_len(pc.keys) == 0 {
        return PcEvict { pc: pc, rc: 0 }
    }
    let n = vec_len(pc.keys)
    let mut steps: i64 = 0
    let mut hand = pc.hand
    while steps < n * 2 {
        if hand >= vec_len(pc.keys) {
            hand = 0
        }
        let key = vec_get(pc.keys, hand)
        // R19: never evict a pinned page
        if pc_pin_count(pc, key) > 0 {
            hand = hand + 1
            steps = steps + 1
        } else {
            if map_has(pc.refbit, key) == 1 && map_get(pc.refbit, key) == 1 {
                map_set(pc.refbit, key, 0)
                hand = hand + 1
                steps = steps + 1
            } else {
                if pc_writeback(pc, fallback_fd, key)? != 0 {
                    pc.hand = hand
                    return PcEvict { pc: pc, rc: 0 - 1 }
                }
                let mut nk: Vec<i64> = vec_new()
                for i in 0..vec_len(pc.keys) {
                    if i != hand {
                        vec_push(nk, vec_get(pc.keys, i))
                    }
                }
                // MEM-4д: старият keys vec се drop-ва — иначе в persist
                // региона всяка eviction оставя ~cap×8 B завинаги (8.7 GB
                // при 200k реда на insert bench-а). Масивът се рециклира
                // през persist freelist-а за следващата eviction.
                let oldk = pc.keys
                pc.keys = nk
                drop(oldk)
                let pb = map_get(pc.data, key)
                drop(pb)  // R18: recycle the page block
                map_del(pc.data, key)
                map_del(pc.dirty, key)
                map_del(pc.refbit, key)
                map_del(pc.pins, key)
                if hand >= vec_len(pc.keys) {
                    hand = 0
                }
                pc.hand = hand
                return PcEvict { pc: pc, rc: 0 }
            }
        }
    }
    // Force: first unpinned key
    let mut fi: i64 = 0
    while fi < vec_len(pc.keys) {
        let key = vec_get(pc.keys, fi)
        if pc_pin_count(pc, key) == 0 {
            if pc_writeback(pc, fallback_fd, key)? != 0 {
                pc.hand = fi
                return PcEvict { pc: pc, rc: 0 - 1 }
            }
            let mut nk2: Vec<i64> = vec_new()
            for i in 0..vec_len(pc.keys) {
                if i != fi {
                    vec_push(nk2, vec_get(pc.keys, i))
                }
            }
            // MEM-4д: drop на стария keys vec (вж. clock пътя по-горе).
            let oldk2 = pc.keys
            pc.keys = nk2
            drop(oldk2)
            let pb2 = map_get(pc.data, key)
            drop(pb2)
            map_del(pc.data, key)
            map_del(pc.dirty, key)
            map_del(pc.refbit, key)
            map_del(pc.pins, key)
            if fi >= vec_len(pc.keys) {
                pc.hand = 0
            } else {
                pc.hand = fi
            }
            return PcEvict { pc: pc, rc: 0 }
        }
        fi = fi + 1
    }
    // All resident pages are pinned — cannot free a slot.
    return PcEvict { pc: pc, rc: 0 - 2 }
}

fn pc_ensure_cap(pc: PageCache, fallback_fd: i64) -> PcEvict !IO {
    let mut cur = pc
    while vec_len(cur.keys) >= cur.cap {
        let e = pc_evict_one(cur, fallback_fd)?
        cur = e.pc
        if e.rc != 0 {
            return PcEvict { pc: cur, rc: e.rc }
        }
    }
    return PcEvict { pc: cur, rc: 0 }
}

struct PcGet {
    pc: PageCache,
    data: bytes
}

// Load page on miss; return page bytes (page_size, zero-padded on short read).
// Does not pin — use pc_pin after if the caller will hold the bytes across
// further cache mutations.
// MEM-4: cache съдържанието е cross-request state (boilaDB serve rewind) —
// fill/eviction пътят е в persist регион; evicted страници се drop-ват и
// рециклират през споделените free lists (безопасна посока).
fn pc_get(pc: PageCache, fd: i64, file_id: i64, page_no: i64) -> PcGet !IO {
    let key = pc_key(file_id, page_no)
    if map_has(pc.data, key) == 1 {
        // MEM-4: refbit entry may be new (persist) or update of existing.
        mem_persist_begin()
        map_set(pc.refbit, key, 1)
        mem_persist_end()
        return PcGet { pc: pc, data: map_get(pc.data, key) }
    }
    mem_persist_begin()
    // Prefer registered fd for this file when reading (shared multi-file).
    let rfd = pc_fd_for(pc, file_id, fd)
    let e = pc_ensure_cap(pc, rfd)?
    let mut cur = e.pc
    if e.rc != 0 {
        mem_persist_end()
        return PcGet { pc: cur, data: bytes_new(0) }
    }
    let off = page_no * cur.page_size
    let raw = fd_pread_into(rfd, cur.scratch, cur.page_size, off)?
    let mut page = bytes_new(cur.page_size)
    let n = bytes_len(raw)
    let mut i: i64 = 0
    while i < n {
        bytes_set(page, i, bytes_at(raw, i))
        i = i + 1
    }
    drop(raw)  // R18: copied into page; recycle the read buffer
    map_set(cur.data, key, page)
    map_set(cur.dirty, key, 0)
    map_set(cur.refbit, key, 1)
    vec_push(cur.keys, key)
    mem_persist_end()
    return PcGet { pc: cur, data: page }
}

// Get + pin (caller must pc_unpin when done holding the page bytes).
fn pc_get_pin(pc: PageCache, fd: i64, file_id: i64, page_no: i64) -> PcGet !IO {
    let g = pc_get(pc, fd, file_id, page_no)?
    if bytes_len(g.data) > 0 {
        pc_pin(g.pc, file_id, page_no)
    }
    return g
}

struct PcPut {
    pc: PageCache,
    rc: i64
}

fn pc_put_page(pc: PageCache, fd: i64, file_id: i64, page_no: i64, page: bytes) -> PcPut !IO {
    let key = pc_key(file_id, page_no)
    let mut cur = pc
    // MEM-4: cache state в persist регион (cross-request при boilaDB serve)
    mem_persist_begin()
    if map_has(cur.data, key) == 0 {
        let rfd = pc_fd_for(cur, file_id, fd)
        let e = pc_ensure_cap(cur, rfd)?
        cur = e.pc
        if e.rc != 0 {
            mem_persist_end()
            return PcPut { pc: cur, rc: e.rc }
        }
        vec_push(cur.keys, key)
    }
    // MEM-4: page идва от caller-а (може ephemeral) — persist копие
    map_set(cur.data, key, bytes_slice(page, 0, bytes_len(page)))
    map_set(cur.dirty, key, 1)
    map_set(cur.refbit, key, 1)
    mem_persist_end()
    return PcPut { pc: cur, rc: 0 }
}

fn pc_flush_file(pc: PageCache, fd: i64, file_id: i64) -> i64 !IO {
    let lo = file_id * 1000000000
    let hi = lo + 1000000000
    for i in 0..vec_len(pc.keys) {
        let key = vec_get(pc.keys, i)
        if key >= lo && key < hi {
            if pc_writeback(pc, fd, key)? != 0 {
                return 0 - 1
            }
        }
    }
    return 0
}

// Drop all cached pages for file_id (after unlink). No writeback.
// Also unregisters the file fd. Refuses to drop pinned pages: returns
// updated cache; caller should unpin first. Pinned pages for this file are
// left (and unregistered) — rare; compact path invalidates after drop fd.
fn pc_invalidate_file(pc: PageCache, file_id: i64) -> PageCache {
    let lo = file_id * 1000000000
    let hi = lo + 1000000000
    // MEM-4: nk е cross-request cache state — persist регион
    mem_persist_begin()
    let mut nk: Vec<i64> = vec_new()
    for i in 0..vec_len(pc.keys) {
        let key = vec_get(pc.keys, i)
        if key >= lo && key < hi {
            // Force-drop even if pinned: file is gone (compact/unlink).
            let pb = map_get(pc.data, key)
            drop(pb)  // R18: recycle the page block (file is gone)
            map_del(pc.data, key)
            map_del(pc.dirty, key)
            map_del(pc.refbit, key)
            map_del(pc.pins, key)
        } else {
            vec_push(nk, key)
        }
    }
    pc.keys = nk
    pc.hand = 0
    pc_unregister_file(pc, file_id)
    mem_persist_end()
    return pc
}

struct PcRead {
    pc: PageCache,
    data: bytes
}

// Read n bytes at file offset through the page cache (may span pages).
// Preallocates the result — avoids O(n²) bytes_push on every byte (R11).
// Pins each source page while copying so a tiny cap cannot drop the page
// mid-span under concurrent ensure_cap from the next page miss (R19).
fn pc_read_at(pc: PageCache, fd: i64, file_id: i64, off: i64, n: i64) -> PcRead !IO {
    if n <= 0 {
        return PcRead { pc: pc, data: bytes_new(0) }
    }
    let mut cur = pc
    // R24: single-page span → one pin + C memcpy via bytes_slice (avoids
    // baga-level per-byte bytes_set; ~2× on random GET block loads).
    let p0 = off / cur.page_size
    let po0 = off % cur.page_size
    if po0 + n <= cur.page_size {
        let g = pc_get_pin(cur, fd, file_id, p0)?
        cur = g.pc
        let page = g.data
        if bytes_len(page) == 0 {
            return PcRead { pc: cur, data: bytes_new(0) }
        }
        let mut end = po0 + n
        if end > bytes_len(page) {
            end = bytes_len(page)
        }
        if end <= po0 {
            pc_unpin(cur, file_id, p0)
            return PcRead { pc: cur, data: bytes_new(0) }
        }
        let out = bytes_slice(page, po0, end)
        pc_unpin(cur, file_id, p0)
        return PcRead { pc: cur, data: out }
    }
    let out = bytes_new(n)
    let mut w: i64 = 0
    let mut left = n
    let mut pos = off
    while left > 0 {
        let pno = pos / cur.page_size
        let poff = pos % cur.page_size
        let g = pc_get_pin(cur, fd, file_id, pno)?
        cur = g.pc
        let page = g.data
        if bytes_len(page) == 0 {
            // Short read: return only what was filled.
            if w == 0 {
                return PcRead { pc: cur, data: bytes_new(0) }
            }
            return PcRead { pc: cur, data: bytes_slice(out, 0, w) }
        }
        let mut take = cur.page_size - poff
        if take > left {
            take = left
        }
        // R25: copy 8-byte words then tail (fewer baga loop iterations).
        let mut i: i64 = 0
        while i + 8 <= take {
            let b0 = bytes_at(page, poff + i)
            let b1 = bytes_at(page, poff + i + 1)
            let b2 = bytes_at(page, poff + i + 2)
            let b3 = bytes_at(page, poff + i + 3)
            let b4 = bytes_at(page, poff + i + 4)
            let b5 = bytes_at(page, poff + i + 5)
            let b6 = bytes_at(page, poff + i + 6)
            let b7 = bytes_at(page, poff + i + 7)
            bytes_set(out, w + i, b0)
            bytes_set(out, w + i + 1, b1)
            bytes_set(out, w + i + 2, b2)
            bytes_set(out, w + i + 3, b3)
            bytes_set(out, w + i + 4, b4)
            bytes_set(out, w + i + 5, b5)
            bytes_set(out, w + i + 6, b6)
            bytes_set(out, w + i + 7, b7)
            i = i + 8
        }
        while i < take {
            bytes_set(out, w + i, bytes_at(page, poff + i))
            i = i + 1
        }
        pc_unpin(cur, file_id, pno)
        w = w + take
        pos = pos + take
        left = left - take
    }
    return PcRead { pc: cur, data: out }
}
