// bloom.baga — in-memory filter + R9 BAGABLM1 sidecar.
// No dependency on SST rows (build from key list).

import "../util/codec.baga"
import "std/os/os.baga"
import "std/crypto/crc32c.baga"
import "std/str/str.baga"

fn bloom_k() -> i64 {
    return 4
}

fn bloom_path(dir: str, gen: i64) -> str {
    return concat(concat(dir, ".bloom."), int_to_str(gen))
}

fn bloom_h1(key: str) -> i64 {
    let mut h: i64 = 2166136261
    let n = len(key)
    let mut i: i64 = 0
    while i < n {
        h = h ^ (char_at(key, i) & 255)
        h = (h * 16777619) & 4294967295
        i = i + 1
    }
    return h
}

fn bloom_h2(key: str) -> i64 {
    let mut h: i64 = 0
    let n = len(key)
    let mut i: i64 = 0
    while i < n {
        h = (h * 33 + (char_at(key, i) & 255)) & 4294967295
        i = i + 1
    }
    if h == 0 {
        h = 1
    }
    return h
}

fn bloom_bits_for(nkeys: i64) -> i64 {
    let mut b = nkeys * 10
    if b < 64 {
        b = 64
    }
    return ((b + 7) / 8) * 8
}

fn bloom_set_bit(bits: bytes, bit: i64) {
    let bi = bit / 8
    let bo = bit % 8
    let cur = bytes_at(bits, bi)
    bytes_set(bits, bi, cur | (1 << bo))
}

fn bloom_test_bit(bits: bytes, bit: i64) -> i64 {
    let bi = bit / 8
    let bo = bit % 8
    if (bytes_at(bits, bi) & (1 << bo)) != 0 {
        return 1
    }
    return 0
}

fn bloom_add(bits: bytes, m: i64, key: str) {
    let h1 = bloom_h1(key)
    let h2 = bloom_h2(key)
    let k = bloom_k()
    let mut i: i64 = 0
    while i < k {
        let mut bit = (h1 + i * h2) % m
        if bit < 0 {
            bit = 0 - bit
        }
        bloom_set_bit(bits, bit)
        i = i + 1
    }
}

fn bloom_may(bits: bytes, m: i64, key: str) -> i64 {
    if m <= 0 || bytes_len(bits) == 0 {
        return 1
    }
    let h1 = bloom_h1(key)
    let h2 = bloom_h2(key)
    let k = bloom_k()
    let mut i: i64 = 0
    while i < k {
        let mut bit = (h1 + i * h2) % m
        if bit < 0 {
            bit = 0 - bit
        }
        if bloom_test_bit(bits, bit) == 0 {
            return 0
        }
        i = i + 1
    }
    return 1
}

fn bloom_build_keys(keys: Vec<str>) -> bytes {
    let m = bloom_bits_for(vec_len(keys))
    let nbytes = m / 8
    let bits = bytes_new(nbytes)
    let mut i: i64 = 0
    while i < nbytes {
        bytes_set(bits, i, 0)
        i = i + 1
    }
    let n = vec_len(keys)
    let mut j: i64 = 0
    while j < n {
        bloom_add(bits, m, vec_get(keys, j))
        j = j + 1
    }
    return bits
}

// Write R9 sidecar: BAGABLM1 | m | bits | crc32c(m||bits). Returns 0 ok.
// R14: single preallocated file buffer.
fn bloom_write_file(dir: str, gen: i64, bits: bytes, m: i64) -> i64 !IO {
    let path = bloom_path(dir, gen)
    let fd = open(path, 578, 420)?
    if fd < 0 {
        return -1
    }
    let blen = bytes_len(bits)
    let payload = bytes_new(4 + blen)
    put_u32_le(payload, 0, m)
    let mut i: i64 = 0
    while i < blen {
        bytes_set(payload, 4 + i, bytes_at(bits, i))
        i = i + 1
    }
    let crc = crc32c_b(payload)
    // magic(8) + payload + crc(4)
    let file = bytes_new(8 + 4 + blen + 4)
    let mag = bytes_of_str("BAGABLM1")
    i = 0
    while i < 8 {
        bytes_set(file, i, bytes_at(mag, i))
        i = i + 1
    }
    i = 0
    while i < 4 + blen {
        bytes_set(file, 8 + i, bytes_at(payload, i))
        i = i + 1
    }
    put_u32_le(file, 8 + 4 + blen, crc)
    if fd_write_bytes(fd, file) != 0 {
        close(fd)
        return -1
    }
    if fsync(fd)? != 0 {
        close(fd)
        return -1
    }
    close(fd)
    return 0
}

// Returns: 0 = not present (skip SST), 1 = maybe, 2 = no/bad file.
// Uncached (open+read+crc every call). Prefer bloom_cache_may on the hot path.
fn bloom_file_may(dir: str, gen: i64, key: str) -> i64 !IO {
    let path = bloom_path(dir, gen)
    let fd = open(path, 0, 0)?
    if fd < 0 {
        return 2
    }
    let fsize = fd_size(fd)?
    if fsize < 8 + 4 + 4 {
        close(fd)
        return 2
    }
    let raw = fd_pread_bytes(fd, fsize, 0)?
    close(fd)
    if bytes_len(raw) < fsize {
        return 2
    }
    if str_of_bytes(bytes_slice(raw, 0, 8)) != "BAGABLM1" {
        return 2
    }
    let body_len = fsize - 8 - 4
    if body_len < 4 {
        return 2
    }
    let body = bytes_slice(raw, 8, 8 + body_len)
    let want = get_u32_le(raw, 8 + body_len)
    if crc32c_b(body) != want {
        return 2
    }
    let m = get_u32_le(body, 0)
    if m <= 0 {
        return 2
    }
    let nbytes = m / 8
    if bytes_len(body) != 4 + nbytes {
        return 2
    }
    let bits = bytes_slice(body, 4, 4 + nbytes)
    if bloom_may(bits, m, key) == 0 {
        return 0
    }
    return 1
}

// --- R11 in-memory bloom cache (load sidecar once per gen) ---

struct BloomCache {
    bits: Map<i64, bytes>,
    m: Map<i64, i64>,
    st: Map<i64, i64>   // 1 = loaded filter, 2 = no/bad sidecar
}

fn bloom_cache_new() -> BloomCache {
    return BloomCache {
        bits: map_new(),
        m: map_new(),
        st: map_new()
    }
}

fn bloom_cache_drop(cache: BloomCache, gen: i64) -> BloomCache {
    map_del(cache.bits, gen)
    map_del(cache.m, gen)
    map_del(cache.st, gen)
    return cache
}

struct BloomMay {
    cache: BloomCache,
    may: i64   // 0 = skip SST, 1 = maybe, 2 = no sidecar (open SST)
}

// Load-or-hit bloom sidecar; same return codes as bloom_file_may.
fn bloom_cache_may(cache: BloomCache, dir: str, gen: i64, key: str) -> BloomMay !IO {
    if map_has(cache.st, gen) == 1 {
        let s = map_get(cache.st, gen)
        if s == 2 {
            return BloomMay { cache: cache, may: 2 }
        }
        let m = map_get(cache.m, gen)
        let bits = map_get(cache.bits, gen)
        if bloom_may(bits, m, key) == 0 {
            return BloomMay { cache: cache, may: 0 }
        }
        return BloomMay { cache: cache, may: 1 }
    }
    let path = bloom_path(dir, gen)
    let fd = open(path, 0, 0)?
    if fd < 0 {
        map_set(cache.st, gen, 2)
        return BloomMay { cache: cache, may: 2 }
    }
    let fsize = fd_size(fd)?
    if fsize < 8 + 4 + 4 {
        close(fd)
        map_set(cache.st, gen, 2)
        return BloomMay { cache: cache, may: 2 }
    }
    let raw = fd_pread_bytes(fd, fsize, 0)?
    close(fd)
    if bytes_len(raw) < fsize {
        map_set(cache.st, gen, 2)
        return BloomMay { cache: cache, may: 2 }
    }
    if str_of_bytes(bytes_slice(raw, 0, 8)) != "BAGABLM1" {
        map_set(cache.st, gen, 2)
        return BloomMay { cache: cache, may: 2 }
    }
    let body_len = fsize - 8 - 4
    if body_len < 4 {
        map_set(cache.st, gen, 2)
        return BloomMay { cache: cache, may: 2 }
    }
    let body = bytes_slice(raw, 8, 8 + body_len)
    let want = get_u32_le(raw, 8 + body_len)
    if crc32c_b(body) != want {
        map_set(cache.st, gen, 2)
        return BloomMay { cache: cache, may: 2 }
    }
    let m = get_u32_le(body, 0)
    if m <= 0 {
        map_set(cache.st, gen, 2)
        return BloomMay { cache: cache, may: 2 }
    }
    let nbytes = m / 8
    if bytes_len(body) != 4 + nbytes {
        map_set(cache.st, gen, 2)
        return BloomMay { cache: cache, may: 2 }
    }
    let bits = bytes_slice(body, 4, 4 + nbytes)
    map_set(cache.bits, gen, bits)
    map_set(cache.m, gen, m)
    map_set(cache.st, gen, 1)
    if bloom_may(bits, m, key) == 0 {
        return BloomMay { cache: cache, may: 0 }
    }
    return BloomMay { cache: cache, may: 1 }
}
