// sstable.baga — sorted string table (BAGASST5). Bloom: table/bloom.baga.
// Record layout: table/block.baga. R20: block-level scan for compact.
// R67: keys are raw bytes end-to-end in memory (NUL-safe); the on-disk
// record format is unchanged (already length-prefixed).
//
// On-disk (new writes = v5):
//   magic 8 = "BAGASST5"
//   body:
//     core: u32 count | records | N×u32 restart_off | u32 N | N×u32 block_crc
//       (block_crc[i] = crc32c of records in [restart_i, restart_{i+1}))
//     bloom: m/8 bytes  (still embedded for v5 readers)
//     fixed footer 24:
//       u32 core_len | bloom_nbytes | bloom_bits | n_restarts | count | tag=5
//   u32 le crc32c(body)   // full-load paths (KEYS / legacy compact fallback)
//
// R9 external bloom (sidecar, optional):
//   <dir>.bloom.<gen> — magic "BAGABLM1" | u32 m | bits | u32 crc32c(m||bits)
// Get prefers sidecar before opening SST data (skip file on bloom miss).
// v1–v4 still readable (no sidecar required).

import "../util/codec.baga"
import "../cache/page.baga"
import "block.baga"
import "bloom.baga"
import "std/os/os.baga"
import "std/crypto/crc32c.baga"
import "std/str/str.baga"

fn sst_restart_every() -> i64 {
    return block_restart_every()
}

fn sst_footer_len() -> i64 {
    return block_footer_len()
}

struct SstRow {
    op: i64,
    key: bytes,   // R67: raw key bytes (NUL-safe)
    val: bytes
}

fn sst_path(dir: str, gen: i64) -> str {
    return concat(concat(dir, ".sst."), int_to_str(gen))
}

fn bloom_build_bits(rows: Vec<SstRow>) -> bytes {
    let keys: Vec<bytes> = vec_new()
    let n = vec_len(rows)
    let mut j: i64 = 0
    while j < n {
        vec_push(keys, vec_get(rows, j).key)
        j = j + 1
    }
    return bloom_build_keys(keys)
}

struct SstBuilt {
    body: bytes,
    bloom: bytes,
    m: i64
}

// Build v5 body: core (+ block CRCs) + bloom + fixed footer.
// R14: return bloom once so sst_write does not rebuild the filter.
// R17: exact prealloc + offset writes. The concat chain was O(n²) in time
// *and* in unreachable garbage (no GC) — merges past ~4.5k rows got OOM-killed.
fn sst_build(rows: Vec<SstRow>) -> SstBuilt {
    let n = vec_len(rows)
    let every = sst_restart_every()
    let nr = (n + every - 1) / every
    // Pass 1: exact core size (count + records + restart offs + nr + CRCs).
    let mut rec_end: i64 = 4
    let mut i: i64 = 0
    while i < n {
        let r = vec_get(rows, i)
        rec_end = rec_end + block_rec_size(bytes_len(r.key), bytes_len(r.val))
        i = i + 1
    }
    let core_len = rec_end + 4 * nr + 4 + 4 * nr
    let core = bytes_new(core_len)
    put_u32_le(core, 0, n)
    // Pass 2: fill records via block_rec_put (R20 shared builder).
    let restarts: Vec<i64> = vec_new()
    let mut off: i64 = 4
    i = 0
    while i < n {
        if i % every == 0 {
            vec_push(restarts, off)
        }
        let r = vec_get(rows, i)
        off = block_rec_put(core, off, r.op, r.key, r.val)
        i = i + 1
    }
    // Per-restart-block crc32c (R6) — computed before index is appended.
    let bcrcs: Vec<i64> = vec_new()
    let mut bi: i64 = 0
    while bi < nr {
        let start = vec_get(restarts, bi)
        let mut end = rec_end
        if bi + 1 < nr {
            end = vec_get(restarts, bi + 1)
        }
        vec_push(bcrcs, crc32c_b(bytes_slice(core, start, end)))
        bi = bi + 1
    }
    bi = 0
    while bi < nr {
        put_u32_le(core, off, vec_get(restarts, bi))
        off = off + 4
        bi = bi + 1
    }
    put_u32_le(core, off, nr)
    off = off + 4
    bi = 0
    while bi < nr {
        put_u32_le(core, off, vec_get(bcrcs, bi))
        off = off + 4
        bi = bi + 1
    }
    let bloom = bloom_build_bits(rows)
    let m = bloom_bits_for(n)
    let blen = bytes_len(bloom)
    let mut body = bytes_new(core_len + blen + 24)
    i = 0
    while i < core_len {
        bytes_set(body, i, bytes_at(core, i))
        i = i + 1
    }
    i = 0
    while i < blen {
        bytes_set(body, core_len + i, bytes_at(bloom, i))
        i = i + 1
    }
    // footer 24 (tag=5)
    let foff = core_len + blen
    put_u32_le(body, foff, core_len)
    put_u32_le(body, foff + 4, blen)
    put_u32_le(body, foff + 8, m)
    put_u32_le(body, foff + 12, nr)
    put_u32_le(body, foff + 16, n)
    put_u32_le(body, foff + 20, 5)
    return SstBuilt { body: body, bloom: bloom, m: m }
}

fn sst_write(dir: str, gen: i64, rows: Vec<SstRow>) -> i64 !IO {
    let path = sst_path(dir, gen)
    let fd = open(path, 578, 420)?
    if fd < 0 {
        return -1
    }
    let built = sst_build(rows)
    let body = built.body
    let crc = crc32c_b(body)
    // Pre-size: magic(8) + body + crc(4)
    let file = bytes_new(8 + bytes_len(body) + 4)
    let mag = bytes_of_str("BAGASST5")
    let mut i: i64 = 0
    while i < 8 {
        bytes_set(file, i, bytes_at(mag, i))
        i = i + 1
    }
    i = 0
    while i < bytes_len(body) {
        bytes_set(file, 8 + i, bytes_at(body, i))
        i = i + 1
    }
    put_u32_le(file, 8 + bytes_len(body), crc)
    drop(body)  // R18: fully copied into file
    if fd_write_bytes(fd, file) != 0 {
        close(fd)
        return -1
    }
    if fsync(fd)? != 0 {
        close(fd)
        return -1
    }
    close(fd)
    drop(file)  // R18: on disk now
    // R9/R14: sidecar reuses the bloom from sst_build (no second filter pass).
    let bloom = built.bloom
    let m = built.m
    if bloom_write_file(dir, gen, bloom, m)? != 0 {
        return -1
    }
    drop(bloom)
    return 0
}

struct SstParse {
    ok: i64,
    rows: Vec<SstRow>
}

// Compat alias — record decode lives in table/block.baga (R20).
struct SstRec {
    ok: i64,
    op: i64,
    key: bytes,
    val: bytes,
    next: i64
}

fn sst_rec_at(body: bytes, pos: i64) -> SstRec {
    let r = block_rec_at(body, pos)
    return SstRec { ok: r.ok, op: r.op, key: r.key, val: r.val, next: r.next }
}

fn sst_parse_rows(body: bytes) -> SstParse {
    let empty: Vec<SstRow> = vec_new()
    if bytes_len(body) < 4 {
        return SstParse { ok: 0, rows: empty }
    }
    let count = get_u32_le(body, 0)
    let mut pos: i64 = 4
    let rows: Vec<SstRow> = vec_new()
    let mut i: i64 = 0
    let mut ok: i64 = 1
    while i < count && ok == 1 {
        let rec = block_rec_at(body, pos)
        if rec.ok == 0 {
            ok = 0
        } else {
            vec_push(rows, SstRow { op: rec.op, key: rec.key, val: rec.val })
            pos = rec.next
            i = i + 1
        }
    }
    if ok == 0 {
        return SstParse { ok: 0, rows: empty }
    }
    return SstParse { ok: 1, rows: rows }
}

fn sst_magic_ok(mag: str) -> i64 {
    if mag == "BAGASST1" {
        return 1
    }
    if mag == "BAGASST2" {
        return 1
    }
    if mag == "BAGASST3" {
        return 1
    }
    if mag == "BAGASST4" {
        return 1
    }
    if mag == "BAGASST5" {
        return 1
    }
    return 0
}

fn sst_parse(data: bytes) -> SstParse {
    let empty: Vec<SstRow> = vec_new()
    if bytes_len(data) < 8 + 4 + 4 {
        return SstParse { ok: 0, rows: empty }
    }
    let mag = str_of_bytes(bytes_slice(data, 0, 8))
    if sst_magic_ok(mag) == 0 {
        return SstParse { ok: 0, rows: empty }
    }
    let body = bytes_slice(data, 8, bytes_len(data) - 4)
    let got = get_u32_le(data, bytes_len(data) - 4)
    if crc32c_b(body) != got {
        return SstParse { ok: 0, rows: empty }
    }
    return sst_parse_rows(body)
}

struct SstLoad {
    pc: PageCache,
    parse: SstParse
}

struct SstRaw {
    pc: PageCache,
    ok: i64,
    data: bytes
}

fn sst_read_raw(pc: PageCache, dir: str, gen: i64) -> SstRaw !IO {
    let path = sst_path(dir, gen)
    let fd = open(path, 0, 0)?
    if fd < 0 {
        return SstRaw { pc: pc, ok: 0, data: bytes_new(0) }
    }
    let mut cur = pc
    // R19: temporary open — register so eviction writeback hits this fd.
    pc_register_file(cur, gen, fd)
    let fsize = fd_size(fd)?
    if fsize <= 0 {
        close(fd)
        pc_unregister_file(cur, gen)
        return SstRaw { pc: cur, ok: 1, data: bytes_new(0) }
    }
    // R18: exact prealloc + page copies through the cache. The old
    // push_bytes-per-page chain leaked O(pages^2) garbage (~45 MB per
    // 600 KB file in a no-GC runtime).
    let data = bytes_new(fsize)
    let npages = (fsize + cur.page_size - 1) / cur.page_size
    let mut pno: i64 = 0
    while pno < npages {
        let g = pc_get(cur, fd, gen, pno)?
        cur = g.pc
        if bytes_len(g.data) == 0 {
            close(fd)
            pc_unregister_file(cur, gen)
            return SstRaw { pc: cur, ok: 0, data: bytes_new(0) }
        }
        let base = pno * cur.page_size
        let mut take = cur.page_size
        if base + take > fsize {
            take = fsize - base
        }
        let mut i: i64 = 0
        while i < take {
            bytes_set(data, base + i, bytes_at(g.data, i))
            i = i + 1
        }
        pno = pno + 1
    }
    close(fd)
    pc_unregister_file(cur, gen)
    return SstRaw { pc: cur, ok: 1, data: data }
}

fn sst_load(pc: PageCache, dir: str, gen: i64) -> SstLoad !IO {
    let empty: Vec<SstRow> = vec_new()
    let raw = sst_read_raw(pc, dir, gen)?
    if raw.ok == 0 {
        return SstLoad { pc: raw.pc, parse: SstParse { ok: 0, rows: empty } }
    }
    let d = raw.data
    let p = sst_parse(d)
    drop(d)  // R18: rows hold copies (sst_rec_at slices out) — body is dead
    return SstLoad { pc: raw.pc, parse: p }
}

struct SstLookup {
    pc: PageCache,
    blooms: BloomCache,
    sst_fds: Map<i64, i64>,
    sst_sizes: Map<i64, i64>,
    sst_meta: Map<i64, SstMeta>,
    found: i64,
    alive: i64,
    val: bytes,
    // R23: get-path hot restart-block (owned; not used by compact/scan)
    hot_gen: i64,
    hot_off: i64,
    hot_n: i64,
    hot_data: bytes
}

// Open or reuse cached SST fd (R11). R19: also register fd on the page cache
// so multi-file writeback during eviction uses the correct descriptor.
fn sst_fd_get(pc: PageCache, fds: Map<i64, i64>, sizes: Map<i64, i64>, dir: str, gen: i64) -> i64 !IO {
    if map_has(fds, gen) == 1 {
        let fd = map_get(fds, gen)
        pc_register_file(pc, gen, fd)
        return fd
    }
    let path = sst_path(dir, gen)
    let fd = open(path, 0, 0)?
    if fd < 0 {
        return 0 - 1
    }
    let fsize = fd_size(fd)?
    map_set(fds, gen, fd)
    map_set(sizes, gen, fsize)
    pc_register_file(pc, gen, fd)
    return fd
}

fn sst_fd_drop(pc: PageCache, fds: Map<i64, i64>, sizes: Map<i64, i64>, gen: i64) -> i64 !IO {
    if map_has(fds, gen) == 1 {
        let fd = map_get(fds, gen)
        if fd >= 0 {
            close(fd)
        }
        map_del(fds, gen)
        map_del(sizes, gen)
    }
    pc_unregister_file(pc, gen)
    return 0
}

struct SstHit {
    found: i64,
    alive: i64,
    val: bytes
}

fn sst_bsearch(rows: Vec<SstRow>, key: bytes) -> i64 {
    let n = vec_len(rows)
    if n == 0 {
        return 0 - 1
    }
    if bytes_cmp(key, vec_get(rows, 0).key) < 0 {
        return 0 - 1
    }
    if bytes_cmp(key, vec_get(rows, n - 1).key) > 0 {
        return 0 - 1
    }
    let mut lo: i64 = 0
    let mut hi = n - 1
    while lo <= hi {
        let mid = lo + (hi - lo) / 2
        let r = vec_get(rows, mid)
        let c = bytes_cmp(r.key, key)
        if c == 0 {
            return mid
        }
        if c < 0 {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return 0 - 1
}

fn sst_hit_from_row(r: SstRow) -> SstHit {
    if r.op == 2 {
        return SstHit { found: 1, alive: 0, val: bytes_new(0) }
    }
    return SstHit { found: 1, alive: 1, val: r.val }
}

fn sst_last_key(body: bytes, start: i64, end: i64) -> bytes {
    return block_last_key(body, start, end)
}

// Indexed lookup on core body (ends with restart footer).
fn sst_lookup_indexed(body: bytes, key: bytes) -> SstHit {
    let miss = SstHit { found: 0, alive: 0, val: bytes_new(0) }
    let blen = bytes_len(body)
    if blen < 8 {
        return miss
    }
    let count = get_u32_le(body, 0)
    if count <= 0 {
        return miss
    }
    let n_restarts = get_u32_le(body, blen - 4)
    if n_restarts <= 0 {
        return miss
    }
    let idx_base = blen - 4 - n_restarts * 4
    if idx_base < 4 {
        return miss
    }
    let first_off = get_u32_le(body, idx_base)
    if first_off != 4 {
        return miss
    }
    let first_rec = sst_rec_at(body, first_off)
    if first_rec.ok == 0 {
        return miss
    }
    if bytes_cmp(key, first_rec.key) < 0 {
        return miss
    }
    let last_off = get_u32_le(body, idx_base + (n_restarts - 1) * 4)
    let last_key = sst_last_key(body, last_off, idx_base)
    if bytes_len(last_key) == 0 {
        return miss
    }
    if bytes_cmp(key, last_key) > 0 {
        return miss
    }
    let mut lo: i64 = 0
    let mut hi = n_restarts - 1
    let mut best: i64 = 0
    while lo <= hi {
        let mid = lo + (hi - lo) / 2
        let off = get_u32_le(body, idx_base + mid * 4)
        let rec = sst_rec_at(body, off)
        if rec.ok == 0 {
            return miss
        }
        let c = bytes_cmp(rec.key, key)
        if c == 0 {
            return sst_hit_from_row(SstRow { op: rec.op, key: rec.key, val: rec.val })
        }
        if c < 0 {
            best = mid
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    let start = get_u32_le(body, idx_base + best * 4)
    let mut end = idx_base
    if best + 1 < n_restarts {
        end = get_u32_le(body, idx_base + (best + 1) * 4)
    }
    let mut pos = start
    let mut go: i64 = 1
    let mut hit = miss
    while go == 1 {
        if pos >= end {
            go = 0
        } else {
            let rec = sst_rec_at(body, pos)
            if rec.ok == 0 {
                go = 0
            } else {
                if rec.next > end {
                    go = 0
                } else {
                    let c = bytes_cmp(rec.key, key)
                    if c == 0 {
                        hit = sst_hit_from_row(SstRow { op: rec.op, key: rec.key, val: rec.val })
                        go = 0
                    } else {
                        if c > 0 {
                            go = 0
                        } else {
                            pos = rec.next
                        }
                    }
                }
            }
        }
    }
    return hit
}

// v3 layout in full buffer: core+bloom_bits_u32 at end of bloom section.
fn sst_lookup_v3(body: bytes, key: bytes) -> SstHit {
    let miss = SstHit { found: 0, alive: 0, val: bytes_new(0) }
    let blen = bytes_len(body)
    if blen < 12 {
        return miss
    }
    let m = get_u32_le(body, blen - 4)
    if m <= 0 {
        return miss
    }
    let nbytes = m / 8
    if nbytes <= 0 || blen < 4 + nbytes + 8 {
        return miss
    }
    let bloom_off = blen - 4 - nbytes
    let bits = bytes_slice(body, bloom_off, bloom_off + nbytes)
    if bloom_may_b(bits, m, key) == 0 {
        return miss
    }
    return sst_lookup_indexed(bytes_slice(body, 0, bloom_off), key)
}

// Footer path (tag 4 = v4, tag 5 = v5 with per-block CRCs after restart index).
fn sst_lookup_footer(body: bytes, key: bytes) -> SstHit {
    let miss = SstHit { found: 0, alive: 0, val: bytes_new(0) }
    let blen = bytes_len(body)
    let fl = sst_footer_len()
    if blen < fl + 8 {
        return miss
    }
    let fo = blen - fl
    let core_len = get_u32_le(body, fo)
    let bloom_nbytes = get_u32_le(body, fo + 4)
    let m = get_u32_le(body, fo + 8)
    let n_restarts = get_u32_le(body, fo + 12)
    let tag = get_u32_le(body, fo + 20)
    if tag != 4 {
        if tag != 5 {
            return miss
        }
    }
    if core_len <= 0 || bloom_nbytes < 0 || n_restarts <= 0 {
        return miss
    }
    if core_len + bloom_nbytes + fl != blen {
        return miss
    }
    let bits = bytes_slice(body, core_len, core_len + bloom_nbytes)
    if bloom_may_b(bits, m, key) == 0 {
        return miss
    }
    // Pure restart core (strip trailing block CRCs for v5).
    let mut pure_len = core_len
    if tag == 5 {
        pure_len = core_len - n_restarts * 4
        if pure_len < 8 {
            return miss
        }
    }
    let pure = bytes_slice(body, 0, pure_len)
    let hit = sst_lookup_indexed(pure, key)
    // Optional: verify the block we would scan — full path already trusts whole-body CRC.
    return hit
}

fn sst_lookup_data(data: bytes, key: bytes) -> SstHit {
    let miss = SstHit { found: 0, alive: 0, val: bytes_new(0) }
    if bytes_len(data) < 8 + 4 + 4 {
        return miss
    }
    let mag = str_of_bytes(bytes_slice(data, 0, 8))
    let body = bytes_slice(data, 8, bytes_len(data) - 4)
    let got = get_u32_le(data, bytes_len(data) - 4)
    if crc32c_b(body) != got {
        return miss
    }
    if mag == "BAGASST5" {
        return sst_lookup_footer(body, key)
    }
    if mag == "BAGASST4" {
        return sst_lookup_footer(body, key)
    }
    if mag == "BAGASST3" {
        return sst_lookup_v3(body, key)
    }
    if mag == "BAGASST2" {
        return sst_lookup_indexed(body, key)
    }
    if mag == "BAGASST1" {
        let p = sst_parse_rows(body)
        if p.ok == 0 {
            return miss
        }
        let j = sst_bsearch(p.rows, key)
        if j < 0 {
            return miss
        }
        return sst_hit_from_row(vec_get(p.rows, j))
    }
    return miss
}

// --- R5 partial get for BAGASST4 (footer + bloom + block via page cache) ---

struct SstKeyAt {
    pc: PageCache,
    ok: i64,
    key: bytes,
    op: i64,
    val: bytes,
    next: i64
}

// Read one record at body offset via page cache (file off = 8 + body_off).
fn sst_rec_at_fd(pc: PageCache, fd: i64, gen: i64, body_off: i64) -> SstKeyAt !IO {
    let bad = SstKeyAt { pc: pc, ok: 0, key: bytes_new(0), op: 0, val: bytes_new(0), next: body_off }
    let h = pc_read_at(pc, fd, gen, 8 + body_off, 5)?
    if bytes_len(h.data) < 5 {
        return SstKeyAt { pc: h.pc, ok: 0, key: bytes_new(0), op: 0, val: bytes_new(0), next: body_off }
    }
    let op = bytes_at(h.data, 0)
    let klen = get_u32_le(h.data, 1)
    if klen < 0 || klen > 1048576 {
        return SstKeyAt { pc: h.pc, ok: 0, key: bytes_new(0), op: 0, val: bytes_new(0), next: body_off }
    }
    let kr = pc_read_at(h.pc, fd, gen, 8 + body_off + 5, klen + 4)?
    if bytes_len(kr.data) < klen + 4 {
        return SstKeyAt { pc: kr.pc, ok: 0, key: bytes_new(0), op: 0, val: bytes_new(0), next: body_off }
    }
    // R67: keep the key as raw bytes (no str_of_bytes — lossy on NUL keys).
    let key = bytes_slice(kr.data, 0, klen)
    let vlen = get_u32_le(kr.data, klen)
    if vlen < 0 || vlen > 67108864 {
        return SstKeyAt { pc: kr.pc, ok: 0, key: bytes_new(0), op: 0, val: bytes_new(0), next: body_off }
    }
    let vr = pc_read_at(kr.pc, fd, gen, 8 + body_off + 5 + klen + 4, vlen)?
    if bytes_len(vr.data) < vlen {
        return SstKeyAt { pc: vr.pc, ok: 0, key: bytes_new(0), op: 0, val: bytes_new(0), next: body_off }
    }
    let next = body_off + 1 + 4 + klen + 4 + vlen
    return SstKeyAt {
        pc: vr.pc, ok: 1, key: key, op: op, val: vr.data, next: next
    }
}

struct SstHitPc {
    pc: PageCache,
    hit: SstHit,
    hot_gen: i64,
    hot_off: i64,
    hot_n: i64,
    hot_data: bytes
}

// R12/R13: cached SST layout for partial get.
// idx = restart offsets; rkeys = first key of each restart block (R13).
// R27: bcrcs = per-block crc32c for tag=5 (empty for v4).
// R67: first_key/last_key/rkeys are raw bytes.
struct SstMeta {
    ok: i64,
    core_len: i64,
    n_restarts: i64,
    idx_base: i64,
    tag: i64,
    first_key: bytes,
    last_key: bytes,
    idx: bytes,        // n_restarts × u32 LE offsets
    rkeys: Vec<bytes>, // n_restarts restart keys (in-memory bsearch)
    bcrcs: bytes       // n_restarts × u32 LE block CRCs (tag 5 only)
}

fn sst_meta_empty() -> SstMeta {
    let empty: Vec<bytes> = vec_new()
    return SstMeta {
        ok: 0, core_len: 0, n_restarts: 0, idx_base: 0, tag: 0,
        first_key: bytes_new(0), last_key: bytes_new(0), idx: bytes_new(0),
        rkeys: empty, bcrcs: bytes_new(0)
    }
}

struct SstMetaLoad {
    pc: PageCache,
    meta: SstMeta
}

// Load footer + restart index + first/last key once per gen.
fn sst_meta_load(pc: PageCache, fd: i64, gen: i64, fsize: i64) -> SstMetaLoad !IO {
    let bad = sst_meta_empty()
    let fl = sst_footer_len()
    if fsize < 8 + fl + 4 {
        return SstMetaLoad { pc: pc, meta: bad }
    }
    let body_len = fsize - 8 - 4
    let footer_file_off = 8 + body_len - fl
    let fr = pc_read_at(pc, fd, gen, footer_file_off, fl)?
    let mut cur = fr.pc
    if bytes_len(fr.data) < fl {
        return SstMetaLoad { pc: cur, meta: bad }
    }
    let core_len = get_u32_le(fr.data, 0)
    let bloom_nbytes = get_u32_le(fr.data, 4)
    let n_restarts = get_u32_le(fr.data, 12)
    let tag = get_u32_le(fr.data, 20)
    if tag != 4 {
        if tag != 5 {
            return SstMetaLoad { pc: cur, meta: bad }
        }
    }
    if core_len <= 0 || n_restarts <= 0 {
        return SstMetaLoad { pc: cur, meta: bad }
    }
    if core_len + bloom_nbytes + fl != body_len {
        return SstMetaLoad { pc: cur, meta: bad }
    }
    let mut idx_base = core_len - 4 - n_restarts * 4
    if tag == 5 {
        idx_base = core_len - 4 - n_restarts * 4 - n_restarts * 4
    }
    if idx_base < 4 {
        return SstMetaLoad { pc: cur, meta: bad }
    }
    let idx_len = n_restarts * 4 + 4
    let ir = pc_read_at(cur, fd, gen, 8 + idx_base, idx_len)?
    cur = ir.pc
    if bytes_len(ir.data) < idx_len {
        return SstMetaLoad { pc: cur, meta: bad }
    }
    let first_off = get_u32_le(ir.data, 0)
    if first_off != 4 {
        return SstMetaLoad { pc: cur, meta: bad }
    }
    // R13: load every restart key once (bsearch becomes pure memory).
    let rkeys: Vec<bytes> = vec_new()
    let mut ri: i64 = 0
    while ri < n_restarts {
        let off = get_u32_le(ir.data, ri * 4)
        let rk = sst_rec_at_fd(cur, fd, gen, off)?
        cur = rk.pc
        if rk.ok == 0 {
            return SstMetaLoad { pc: cur, meta: bad }
        }
        vec_push(rkeys, rk.key)
        ri = ri + 1
    }
    let last_off = get_u32_le(ir.data, (n_restarts - 1) * 4)
    let span = idx_base - last_off
    if span < 0 || span > 16777216 {
        return SstMetaLoad { pc: cur, meta: bad }
    }
    let lr = pc_read_at(cur, fd, gen, 8 + last_off, span)?
    cur = lr.pc
    let last_key = sst_last_key(lr.data, 0, bytes_len(lr.data))
    if bytes_len(last_key) == 0 {
        return SstMetaLoad { pc: cur, meta: bad }
    }
    let idx = bytes_slice(ir.data, 0, n_restarts * 4)
    let first_key = vec_get(rkeys, 0)
    // R27: load per-block CRCs for BAGASST5 (after u32 N in core).
    let mut bcrcs = bytes_new(0)
    if tag == 5 {
        let crc_off = 8 + idx_base + n_restarts * 4 + 4
        let crc_len = n_restarts * 4
        let cr = pc_read_at(cur, fd, gen, crc_off, crc_len)?
        cur = cr.pc
        if bytes_len(cr.data) < crc_len {
            return SstMetaLoad { pc: cur, meta: bad }
        }
        bcrcs = cr.data
    }
    return SstMetaLoad {
        pc: cur,
        meta: SstMeta {
            ok: 1, core_len: core_len, n_restarts: n_restarts, idx_base: idx_base,
            tag: tag, first_key: first_key, last_key: last_key, idx: idx, rkeys: rkeys,
            bcrcs: bcrcs
        }
    }
}

// R27: verify block payload against meta.bcrcs[bi]. 1 = ok, 0 = fail/skip.
// tag≠5 or missing table → ok (no check). Soft CRC is cheap for ~1 KiB blocks.
fn sst_block_crc_ok(meta: SstMeta, bi: i64, block: bytes) -> i64 {
    if meta.tag != 5 {
        return 1
    }
    if bi < 0 || bi >= meta.n_restarts {
        return 0
    }
    if bytes_len(meta.bcrcs) < (bi + 1) * 4 {
        return 0
    }
    let want = get_u32_le(meta.bcrcs, bi * 4)
    let got = crc32c_b(block)
    if got != want {
        return 0
    }
    return 1
}

// Partial get using cached meta (R12) + in-memory restart-key bsearch (R13).
// R23: optional hot span (gen/off/n/data) reuses last restart block without
// re-copying from the page cache — get-path only (caller owns hot_*).
fn sst_lookup_with_meta(pc: PageCache, fd: i64, gen: i64, meta: SstMeta, key: bytes,
                        hot_gen: i64, hot_off: i64, hot_n: i64, hot_data: bytes) -> SstHitPc !IO {
    let miss = SstHit { found: 0, alive: 0, val: bytes_new(0) }
    let mut hg = hot_gen
    let mut ho = hot_off
    let mut hn = hot_n
    let mut hd = hot_data
    if meta.ok == 0 {
        return SstHitPc { pc: pc, hit: miss, hot_gen: hg, hot_off: ho, hot_n: hn, hot_data: hd }
    }
    if bytes_cmp(key, meta.first_key) < 0 {
        return SstHitPc { pc: pc, hit: miss, hot_gen: hg, hot_off: ho, hot_n: hn, hot_data: hd }
    }
    if bytes_cmp(key, meta.last_key) > 0 {
        return SstHitPc { pc: pc, hit: miss, hot_gen: hg, hot_off: ho, hot_n: hn, hot_data: hd }
    }
    let mut cur = pc
    let n_restarts = meta.n_restarts
    let idx = meta.idx
    let idx_base = meta.idx_base
    let rkeys = meta.rkeys
    // Binary search over cached restart keys — no IO.
    let mut lo: i64 = 0
    let mut hi = n_restarts - 1
    let mut best: i64 = 0
    while lo <= hi {
        let mid = lo + (hi - lo) / 2
        let c = bytes_cmp(vec_get(rkeys, mid), key)
        if c == 0 {
            best = mid
            lo = mid + 1
            hi = mid - 1
        } else {
            if c < 0 {
                best = mid
                lo = mid + 1
            } else {
                hi = mid - 1
            }
        }
    }
    let start = get_u32_le(idx, best * 4)
    let mut end = idx_base
    if best + 1 < n_restarts {
        end = get_u32_le(idx, (best + 1) * 4)
    }
    let bspan = end - start
    if bspan < 0 || bspan > 16777216 {
        return SstHitPc { pc: cur, hit: miss, hot_gen: hg, hot_off: ho, hot_n: hn, hot_data: hd }
    }
    let file_off = 8 + start
    let mut block = bytes_new(0)
    if hg == gen && ho == file_off && hn == bspan && bytes_len(hd) == bspan {
        block = hd
    } else {
        let br2 = pc_read_at(cur, fd, gen, file_off, bspan)?
        cur = br2.pc
        // replace hot span
        if hn > 0 {
            let old = hd
            hd = br2.data
            drop(old)
        } else {
            hd = br2.data
        }
        hg = gen
        ho = file_off
        hn = bspan
        block = hd
    }
    // R27: get path does not re-check block CRC (R11 perf — soft CRC of a
    // ~1 KiB block per get cut throughput ~4×). Scan/compact verify on load.
    // R23: no-alloc key compare on the block; materialize only on hit.
    let rec = block_find(block, key)
    if rec.ok == 0 {
        return SstHitPc { pc: cur, hit: miss, hot_gen: hg, hot_off: ho, hot_n: hn, hot_data: hd }
    }
    let hit = sst_hit_from_row(SstRow { op: rec.op, key: rec.key, val: rec.val })
    return SstHitPc { pc: cur, hit: hit, hot_gen: hg, hot_off: ho, hot_n: hn, hot_data: hd }
}

// Legacy entry (uncached meta) — kept for callers that do not pass a meta map.
fn sst_lookup_partial(pc: PageCache, fd: i64, gen: i64, fsize: i64, key: bytes, skip_bloom: i64) -> SstHitPc !IO {
    let ml = sst_meta_load(pc, fd, gen, fsize)?
    // skip_bloom unused: meta path does not re-check embedded bloom (R11+).
    if skip_bloom == 0 {
        // still no embedded bloom on this path — bloom sidecar is preferred
    }
    if ml.meta.ok == 0 {
        return SstHitPc {
            pc: ml.pc, hit: SstHit { found: 0, alive: 0, val: bytes_new(0) },
            hot_gen: 0 - 1, hot_off: 0 - 1, hot_n: 0, hot_data: bytes_new(0)
        }
    }
    return sst_lookup_with_meta(ml.pc, fd, gen, ml.meta, key, 0 - 1, 0 - 1, 0, bytes_new(0))?
}

// Newest-first lookup. R9–R13 + R23 hot span on get path.
// v4/v5 partial page-cache path; older formats full read.
fn sst_get(pc: PageCache, blooms: BloomCache, fds: Map<i64, i64>, sizes: Map<i64, i64>,
           meta: Map<i64, SstMeta>, dir: str, gens: Vec<i64>, key: bytes,
           hot_gen: i64, hot_off: i64, hot_n: i64, hot_data: bytes) -> SstLookup !IO {
    let mut cur = pc
    let mut bc = blooms
    let mut hg = hot_gen
    let mut ho = hot_off
    let mut hn = hot_n
    let mut hd = hot_data
    let mut i = vec_len(gens) - 1
    while i >= 0 {
        let gen = vec_get(gens, i)
        let bm = bloom_cache_may(bc, dir, gen, key)?
        bc = bm.cache
        if bm.may == 0 {
            i = i - 1
        } else {
            let fd = sst_fd_get(cur, fds, sizes, dir, gen)?
            if fd < 0 {
                i = i - 1
            } else {
                let fsize = map_get(sizes, gen)
                if map_has(meta, gen) == 0 {
                    let ml = sst_meta_load(cur, fd, gen, fsize)?
                    cur = ml.pc
                    if ml.meta.ok == 1 {
                        map_set(meta, gen, ml.meta)
                    } else {
                        // Not v4/v5: full-file path once.
                        sst_fd_drop(cur, fds, sizes, gen)?
                        let raw = sst_read_raw(cur, dir, gen)?
                        cur = raw.pc
                        if raw.ok == 1 {
                            let h = sst_lookup_data(raw.data, key)
                            if h.found == 1 {
                                return SstLookup {
                                    pc: cur, blooms: bc, sst_fds: fds, sst_sizes: sizes,
                                    sst_meta: meta, found: 1, alive: h.alive, val: h.val,
                                    hot_gen: hg, hot_off: ho, hot_n: hn, hot_data: hd
                                }
                            }
                        }
                    }
                }
                if map_has(meta, gen) == 1 {
                    let m = map_get(meta, gen)
                    if bytes_cmp(key, m.first_key) < 0 {
                        i = i - 1
                    } else {
                        if bytes_cmp(key, m.last_key) > 0 {
                            i = i - 1
                        } else {
                            let r = sst_lookup_with_meta(cur, fd, gen, m, key, hg, ho, hn, hd)?
                            cur = r.pc
                            hg = r.hot_gen
                            ho = r.hot_off
                            hn = r.hot_n
                            hd = r.hot_data
                            if r.hit.found == 1 {
                                return SstLookup {
                                    pc: cur, blooms: bc, sst_fds: fds, sst_sizes: sizes,
                                    sst_meta: meta, found: 1, alive: r.hit.alive, val: r.hit.val,
                                    hot_gen: hg, hot_off: ho, hot_n: hn, hot_data: hd
                                }
                            }
                            i = i - 1
                        }
                    }
                } else {
                    i = i - 1
                }
            }
        }
    }
    return SstLookup {
        pc: cur, blooms: bc, sst_fds: fds, sst_sizes: sizes, sst_meta: meta,
        found: 0, alive: 0, val: bytes_new(0),
        hot_gen: hg, hot_off: ho, hot_n: hn, hot_data: hd
    }
}

// --- R20: block-level SST scan (compact / full iterate without full-file copy) ---

struct SstScan {
    pc: PageCache,
    fd: i64,
    gen: i64,
    meta: SstMeta,
    bi: i64,       // current restart block index
    pos: i64,      // offset inside current block bytes
    block: bytes,  // current restart-block payload
    open: i64      // 1 = usable (v4/v5 meta ok)
}

struct SstScanStep {
    scan: SstScan,
    ok: i64,    // 1 = yielded a row
    done: i64,  // 1 = end of file (or not open)
    row: SstRow
}

fn sst_scan_closed(pc: PageCache) -> SstScan {
    return SstScan {
        pc: pc, fd: 0 - 1, gen: 0, meta: sst_meta_empty(),
        bi: 0, pos: 0, block: bytes_new(0), open: 0
    }
}

// Load restart block `bi` into scan.block. Returns updated scan; open=0 on error.
fn sst_scan_load_block(sc: SstScan) -> SstScan !IO {
    let mut s = sc
    if s.open == 0 {
        return s
    }
    if s.bi >= s.meta.n_restarts {
        return s
    }
    let start = get_u32_le(s.meta.idx, s.bi * 4)
    let mut end = s.meta.idx_base
    if s.bi + 1 < s.meta.n_restarts {
        end = get_u32_le(s.meta.idx, (s.bi + 1) * 4)
    }
    let bspan = end - start
    if bspan < 0 || bspan > 16777216 {
        s.open = 0
        return s
    }
    // drop previous block payload before replace (R18 free-list)
    if bytes_len(s.block) > 0 {
        let oldb = s.block
        s.block = bytes_new(0)
        drop(oldb)
    }
    let br = pc_read_at(s.pc, s.fd, s.gen, 8 + start, bspan)?
    s.pc = br.pc
    if bytes_len(br.data) < bspan {
        s.open = 0
        s.block = bytes_new(0)
        return s
    }
    // R27: per-block crc32c (BAGASST5) — fail closed on mismatch.
    let blk = br.data
    if sst_block_crc_ok(s.meta, s.bi, blk) == 0 {
        drop(blk)
        s.open = 0
        s.block = bytes_new(0)
        return s
    }
    s.block = blk
    s.pos = 0
    return s
}

// Begin a block-level scan. open=0 if file is not v4/v5 (caller may fall back
// to sst_load). Does not take ownership of fd — caller keeps it open.
fn sst_scan_begin(pc: PageCache, fd: i64, gen: i64, fsize: i64) -> SstScan !IO {
    if fd < 0 || fsize <= 0 {
        return sst_scan_closed(pc)
    }
    let ml = sst_meta_load(pc, fd, gen, fsize)?
    if ml.meta.ok == 0 {
        return sst_scan_closed(ml.pc)
    }
    let mut sc = SstScan {
        pc: ml.pc, fd: fd, gen: gen, meta: ml.meta,
        bi: 0, pos: 0, block: bytes_new(0), open: 1
    }
    if sc.meta.n_restarts <= 0 {
        sc.open = 0
        return sc
    }
    return sst_scan_load_block(sc)?
}

// Yield next record in key order. When done=1, scan is finished (block freed).
fn sst_scan_next(sc: SstScan) -> SstScanStep !IO {
    let empty = SstRow { op: 0, key: bytes_new(0), val: bytes_new(0) }
    let mut s = sc
    if s.open == 0 {
        return SstScanStep { scan: s, ok: 0, done: 1, row: empty }
    }
    let mut guard: i64 = 0
    while guard < 100000000 {
        guard = guard + 1
        if s.bi >= s.meta.n_restarts {
            if bytes_len(s.block) > 0 {
                let oldb = s.block
                s.block = bytes_new(0)
                drop(oldb)
            }
            s.open = 0
            return SstScanStep { scan: s, ok: 0, done: 1, row: empty }
        }
        if s.pos >= bytes_len(s.block) {
            s.bi = s.bi + 1
            if s.bi >= s.meta.n_restarts {
                if bytes_len(s.block) > 0 {
                    let oldb2 = s.block
                    s.block = bytes_new(0)
                    drop(oldb2)
                }
                s.open = 0
                return SstScanStep { scan: s, ok: 0, done: 1, row: empty }
            }
            s = sst_scan_load_block(s)?
            if s.open == 0 {
                return SstScanStep { scan: s, ok: 0, done: 1, row: empty }
            }
        } else {
            let rec = block_rec_at(s.block, s.pos)
            if rec.ok == 0 {
                s.open = 0
                return SstScanStep { scan: s, ok: 0, done: 1, row: empty }
            }
            s.pos = rec.next
            return SstScanStep {
                scan: s, ok: 1, done: 0,
                row: SstRow { op: rec.op, key: rec.key, val: rec.val }
            }
        }
    }
    s.open = 0
    return SstScanStep { scan: s, ok: 0, done: 1, row: empty }
}

// Fold every row of one SST into acc/tomb maps (R20 compact path).
// Returns updated page cache. Uses block scan when v4/v5; else full sst_load.
// R27: if meta is v4/v5, never fall back to full load after CRC fail mid-scan
// (fail closed — leave acc/tomb partially updated from prior blocks only).
// R67: acc/tomb are keyed by raw bytes.
fn sst_fold_into(pc: PageCache, dir: str, gen: i64, fds: Map<i64, i64>, sizes: Map<i64, i64>,
                 acc: Map<bytes, bytes>, tomb: Map<bytes, i64>) -> PageCache !IO {
    let fd = sst_fd_get(pc, fds, sizes, dir, gen)?
    if fd < 0 {
        return pc
    }
    let fsize = map_get(sizes, gen)
    let mut sc = sst_scan_begin(pc, fd, gen, fsize)?
    // v4/v5: meta.ok=1 even if first block CRC fails (open=0).
    if sc.meta.ok == 1 {
        if sc.open == 0 {
            return sc.pc
        }
        let mut go: i64 = 1
        while go == 1 {
            let st = sst_scan_next(sc)?
            sc = st.scan
            if st.done == 1 {
                go = 0
            } else {
                if st.ok == 1 {
                    let r = st.row
                    if r.op == 2 {
                        map_del(acc, r.key)
                        map_set(tomb, r.key, 1)
                    } else {
                        map_set(acc, r.key, r.val)
                        map_del(tomb, r.key)
                    }
                }
            }
        }
        return sc.pc
    }
    // Legacy formats only: full-file parse (same as pre-R20).
    let ld = sst_load(sc.pc, dir, gen)?
    let prows = ld.parse.rows
    if ld.parse.ok == 1 {
        for j in 0..vec_len(prows) {
            let r = vec_get(prows, j)
            if r.op == 2 {
                map_del(acc, r.key)
                map_set(tomb, r.key, 1)
            } else {
                map_set(acc, r.key, r.val)
                map_del(tomb, r.key)
            }
        }
    }
    drop(prows)
    return ld.pc
}
