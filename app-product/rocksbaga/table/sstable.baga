// sstable.baga — sorted string table (BAGASST5): write path (build v5
// body: core + block CRCs + bloom + footer, pwrite на място) + споделени
// типове (SstRow, SstBuilt). Record layout: block.baga; parse — в
// sstable_parse.baga; lookup — sstable_lookup.baga; meta/fd — в
// sstable_meta.baga; scan/fold — в sstable_scan.baga.


import "../util/codec.baga"
import "../cache/page.baga"
import "block.baga"
import "bloom.baga"
import "std/os/os.baga"
import "std/crypto/crc32c.baga"
import "std/str/str.baga"

fn sst_restart_every() -> i64 {
    return block_restart_every()
}

fn sst_footer_len() -> i64 {
    return block_footer_len()
}

struct SstRow {
    op: i64,
    key: bytes,   // R67: raw key bytes (NUL-safe)
    val: bytes
}

fn sst_path(dir: str, gen: i64) -> str {
    return concat(concat(dir, ".sst."), int_to_str(gen))
}

fn bloom_build_bits(rows: Vec<SstRow>) -> bytes {
    let keys: Vec<bytes> = vec_new()
    let n = vec_len(rows)
    let mut j: i64 = 0
    while j < n {
        vec_push(keys, vec_get(rows, j).key)
        j = j + 1
    }
    return bloom_build_keys(keys)
}

struct SstBuilt {
    body: bytes,
    bloom: bytes,
    m: i64
}

// Build v5 body: core (+ block CRCs) + bloom + fixed footer.
// R14: return bloom once so sst_write does not rebuild the filter.
// R17: exact prealloc + offset writes. The concat chain was O(n²) in time
// *and* in unreachable garbage (no GC) — merges past ~4.5k rows got OOM-killed.
fn sst_build(rows: Vec<SstRow>) -> SstBuilt {
    let n = vec_len(rows)
    let every = sst_restart_every()
    let nr = (n + every - 1) / every
    // Pass 1: exact core size (count + records + restart offs + nr + CRCs).
    let mut rec_end: i64 = 4
    let mut i: i64 = 0
    while i < n {
        let r = vec_get(rows, i)
        rec_end = rec_end + block_rec_size(bytes_len(r.key), bytes_len(r.val))
        i = i + 1
    }
    let core_len = rec_end + 4 * nr + 4 + 4 * nr
    let core = bytes_new(core_len)
    put_u32_le(core, 0, n)
    // Pass 2: fill records via block_rec_put (R20 shared builder).
    let restarts: Vec<i64> = vec_new()
    let mut off: i64 = 4
    i = 0
    while i < n {
        if i % every == 0 {
            vec_push(restarts, off)
        }
        let r = vec_get(rows, i)
        off = block_rec_put(core, off, r.op, r.key, r.val)
        i = i + 1
    }
    // Per-restart-block crc32c (R6) — computed before index is appended.
    let bcrcs: Vec<i64> = vec_new()
    let mut bi: i64 = 0
    while bi < nr {
        let start = vec_get(restarts, bi)
        let mut end = rec_end
        if bi + 1 < nr {
            end = vec_get(restarts, bi + 1)
        }
        vec_push(bcrcs, crc32c_b(bytes_slice(core, start, end)))
        bi = bi + 1
    }
    bi = 0
    while bi < nr {
        put_u32_le(core, off, vec_get(restarts, bi))
        off = off + 4
        bi = bi + 1
    }
    put_u32_le(core, off, nr)
    off = off + 4
    bi = 0
    while bi < nr {
        put_u32_le(core, off, vec_get(bcrcs, bi))
        off = off + 4
        bi = bi + 1
    }
    let bloom = bloom_build_bits(rows)
    let m = bloom_bits_for(n)
    let blen = bytes_len(bloom)
    let mut body = bytes_new(core_len + blen + 24)
    i = 0
    while i < core_len {
        bytes_set(body, i, bytes_at(core, i))
        i = i + 1
    }
    i = 0
    while i < blen {
        bytes_set(body, core_len + i, bytes_at(bloom, i))
        i = i + 1
    }
    // footer 24 (tag=5)
    let foff = core_len + blen
    put_u32_le(body, foff, core_len)
    put_u32_le(body, foff + 4, blen)
    put_u32_le(body, foff + 8, m)
    put_u32_le(body, foff + 12, nr)
    put_u32_le(body, foff + 16, n)
    put_u32_le(body, foff + 20, 5)
    return SstBuilt { body: body, bloom: bloom, m: m }
}

fn sst_write(dir: str, gen: i64, rows: Vec<SstRow>) -> i64 !IO {
    let path = sst_path(dir, gen)
    let fd = open(path, 578, 420)?
    if fd < 0 {
        return -1
    }
    let built = sst_build(rows)
    let body = built.body
    let crc = crc32c_b(body)
    // Pre-size: magic(8) + body + crc(4)
    let file = bytes_new(8 + bytes_len(body) + 4)
    let mag = bytes_of_str("BAGASST5")
    let mut i: i64 = 0
    while i < 8 {
        bytes_set(file, i, bytes_at(mag, i))
        i = i + 1
    }
    i = 0
    while i < bytes_len(body) {
        bytes_set(file, 8 + i, bytes_at(body, i))
        i = i + 1
    }
    put_u32_le(file, 8 + bytes_len(body), crc)
    drop(body)  // R18: fully copied into file
    if fd_write_bytes(fd, file) != 0 {
        close(fd)
        return -1
    }
    if fsync(fd)? != 0 {
        close(fd)
        return -1
    }
    close(fd)
    drop(file)  // R18: on disk now
    // R9/R14: sidecar reuses the bloom from sst_build (no second filter pass).
    let bloom = built.bloom
    let m = built.m
    if bloom_write_file(dir, gen, bloom, m)? != 0 {
        return -1
    }
    drop(bloom)
    return 0
}
