// sstable.baga — sorted string table (R6: BAGASST5 + R9 external bloom).
//
// On-disk (new writes = v5):
//   magic 8 = "BAGASST5"
//   body:
//     core: u32 count | records | N×u32 restart_off | u32 N | N×u32 block_crc
//       (block_crc[i] = crc32c of records in [restart_i, restart_{i+1}))
//     bloom: m/8 bytes  (still embedded for v5 readers)
//     fixed footer 24:
//       u32 core_len | bloom_nbytes | bloom_bits | n_restarts | count | tag=5
//   u32 le crc32c(body)   // full-load paths (compact/KEYS)
//
// R9 external bloom (sidecar, optional):
//   <dir>.bloom.<gen> — magic "BAGABLM1" | u32 m | bits | u32 crc32c(m||bits)
// Get prefers sidecar before opening SST data (skip file on bloom miss).
// v1–v4 still readable (no sidecar required).

import "../util/codec.baga"
import "../cache/page.baga"
import "std/os/os.baga"
import "std/crypto/crc32c.baga"
import "std/str/str.baga"

fn sst_restart_every() -> i64 {
    return 16
}

fn bloom_k() -> i64 {
    return 4
}

// Fixed footer size at end of v4 body.
fn sst_footer_len() -> i64 {
    return 24
}

struct SstRow {
    op: i64,
    key: str,
    val: bytes
}

fn sst_path(dir: str, gen: i64) -> str {
    return concat(concat(dir, ".sst."), int_to_str(gen))
}

// R9 standalone bloom filter path (sidecar of SST).
fn bloom_path(dir: str, gen: i64) -> str {
    return concat(concat(dir, ".bloom."), int_to_str(gen))
}

// --- bloom ---

fn bloom_h1(key: str) -> i64 {
    let mut h: i64 = 2166136261
    let n = len(key)
    let mut i: i64 = 0
    while i < n {
        h = h ^ (char_at(key, i) & 255)
        h = (h * 16777619) & 4294967295
        i = i + 1
    }
    return h
}

fn bloom_h2(key: str) -> i64 {
    let mut h: i64 = 0
    let n = len(key)
    let mut i: i64 = 0
    while i < n {
        h = (h * 33 + (char_at(key, i) & 255)) & 4294967295
        i = i + 1
    }
    if h == 0 {
        h = 1
    }
    return h
}

fn bloom_bits_for(nkeys: i64) -> i64 {
    let mut b = nkeys * 10
    if b < 64 {
        b = 64
    }
    return ((b + 7) / 8) * 8
}

fn bloom_set_bit(bits: bytes, bit: i64) {
    let bi = bit / 8
    let bo = bit % 8
    let cur = bytes_at(bits, bi)
    bytes_set(bits, bi, cur | (1 << bo))
}

fn bloom_test_bit(bits: bytes, bit: i64) -> i64 {
    let bi = bit / 8
    let bo = bit % 8
    if (bytes_at(bits, bi) & (1 << bo)) != 0 {
        return 1
    }
    return 0
}

fn bloom_add(bits: bytes, m: i64, key: str) {
    let h1 = bloom_h1(key)
    let h2 = bloom_h2(key)
    let k = bloom_k()
    let mut i: i64 = 0
    while i < k {
        let mut bit = (h1 + i * h2) % m
        if bit < 0 {
            bit = 0 - bit
        }
        bloom_set_bit(bits, bit)
        i = i + 1
    }
}

fn bloom_may(bits: bytes, m: i64, key: str) -> i64 {
    if m <= 0 || bytes_len(bits) == 0 {
        return 1
    }
    let h1 = bloom_h1(key)
    let h2 = bloom_h2(key)
    let k = bloom_k()
    let mut i: i64 = 0
    while i < k {
        let mut bit = (h1 + i * h2) % m
        if bit < 0 {
            bit = 0 - bit
        }
        if bloom_test_bit(bits, bit) == 0 {
            return 0
        }
        i = i + 1
    }
    return 1
}

// Bloom bytes only (no trailing m); m returned via bits_for.
fn bloom_build_bits(rows: Vec<SstRow>) -> bytes {
    let m = bloom_bits_for(vec_len(rows))
    let nbytes = m / 8
    let bits = bytes_new(nbytes)
    let mut i: i64 = 0
    while i < nbytes {
        bytes_set(bits, i, 0)
        i = i + 1
    }
    let n = vec_len(rows)
    let mut j: i64 = 0
    while j < n {
        bloom_add(bits, m, vec_get(rows, j).key)
        j = j + 1
    }
    return bits
}

// Write R9 sidecar: BAGABLM1 | m | bits | crc32c(m||bits). Returns 0 ok.
fn bloom_write_file(dir: str, gen: i64, bits: bytes, m: i64) -> i64 !IO {
    let path = bloom_path(dir, gen)
    let fd = open(path, 578, 420)?
    if fd < 0 {
        return -1
    }
    let mut payload = bytes_new(0)
    payload = push_u32_le(payload, m)
    payload = push_bytes(payload, bits)
    let crc = crc32c_b(payload)
    let mut file = bytes_of_str("BAGABLM1")
    file = push_bytes(file, payload)
    file = push_u32_le(file, crc)
    if fd_write_bytes(fd, file) != 0 {
        close(fd)
        return -1
    }
    if fsync(fd)? != 0 {
        close(fd)
        return -1
    }
    close(fd)
    return 0
}

// Probe external bloom for key.
// Returns: 0 = key not present (safe skip SST), 1 = maybe present, 2 = no/bad file.
fn bloom_file_may(dir: str, gen: i64, key: str) -> i64 !IO {
    let path = bloom_path(dir, gen)
    let fd = open(path, 0, 0)?
    if fd < 0 {
        return 2
    }
    let fsize = fd_size(fd)?
    if fsize < 8 + 4 + 4 {
        close(fd)
        return 2
    }
    let raw = fd_pread_bytes(fd, fsize, 0)?
    close(fd)
    if bytes_len(raw) < fsize {
        return 2
    }
    if str_of_bytes(bytes_slice(raw, 0, 8)) != "BAGABLM1" {
        return 2
    }
    let body_len = fsize - 8 - 4
    if body_len < 4 {
        return 2
    }
    let body = bytes_slice(raw, 8, 8 + body_len)
    let want = get_u32_le(raw, 8 + body_len)
    if crc32c_b(body) != want {
        return 2
    }
    let m = get_u32_le(body, 0)
    if m <= 0 {
        return 2
    }
    let nbytes = m / 8
    if bytes_len(body) != 4 + nbytes {
        return 2
    }
    let bits = bytes_slice(body, 4, 4 + nbytes)
    if bloom_may(bits, m, key) == 0 {
        return 0
    }
    return 1
}

// Build v5 body: core (+ block CRCs) + bloom + fixed footer.
fn sst_build(rows: Vec<SstRow>) -> bytes {
    let mut core = bytes_new(0)
    core = push_u32_le(core, vec_len(rows))
    let restarts: Vec<i64> = vec_new()
    let every = sst_restart_every()
    let n = vec_len(rows)
    let mut i: i64 = 0
    while i < n {
        if i % every == 0 {
            vec_push(restarts, bytes_len(core))
        }
        let r = vec_get(rows, i)
        core = bytes_push(core, r.op & 255)
        let kb = bytes_of_str(r.key)
        core = push_u32_le(core, bytes_len(kb))
        core = push_bytes(core, kb)
        core = push_u32_le(core, bytes_len(r.val))
        core = push_bytes(core, r.val)
        i = i + 1
    }
    let rec_end = bytes_len(core)
    let nr = vec_len(restarts)
    // Per-restart-block crc32c (R6) — computed before index is appended.
    let bcrcs: Vec<i64> = vec_new()
    let mut bi: i64 = 0
    while bi < nr {
        let start = vec_get(restarts, bi)
        let mut end = rec_end
        if bi + 1 < nr {
            end = vec_get(restarts, bi + 1)
        }
        vec_push(bcrcs, crc32c_b(bytes_slice(core, start, end)))
        bi = bi + 1
    }
    let mut j: i64 = 0
    while j < nr {
        core = push_u32_le(core, vec_get(restarts, j))
        j = j + 1
    }
    core = push_u32_le(core, nr)
    let mut ci: i64 = 0
    while ci < nr {
        core = push_u32_le(core, vec_get(bcrcs, ci))
        ci = ci + 1
    }
    let core_len = bytes_len(core)
    let bloom = bloom_build_bits(rows)
    let m = bloom_bits_for(n)
    let mut body = core
    body = push_bytes(body, bloom)
    // footer 24 (tag=5)
    body = push_u32_le(body, core_len)
    body = push_u32_le(body, bytes_len(bloom))
    body = push_u32_le(body, m)
    body = push_u32_le(body, nr)
    body = push_u32_le(body, n)
    body = push_u32_le(body, 5)
    return body
}

fn sst_write(dir: str, gen: i64, rows: Vec<SstRow>) -> i64 !IO {
    let path = sst_path(dir, gen)
    let fd = open(path, 578, 420)?
    if fd < 0 {
        return -1
    }
    let magic = bytes_of_str("BAGASST5")
    let body = sst_build(rows)
    let crc = crc32c_b(body)
    let mut file = magic
    file = push_bytes(file, body)
    file = push_u32_le(file, crc)
    if fd_write_bytes(fd, file) != 0 {
        close(fd)
        return -1
    }
    if fsync(fd)? != 0 {
        close(fd)
        return -1
    }
    close(fd)
    // R9: standalone bloom sidecar (same bits as embedded in body).
    let bloom = bloom_build_bits(rows)
    let m = bloom_bits_for(vec_len(rows))
    if bloom_write_file(dir, gen, bloom, m)? != 0 {
        return -1
    }
    return 0
}

struct SstParse {
    ok: i64,
    rows: Vec<SstRow>
}

struct SstRec {
    ok: i64,
    op: i64,
    key: str,
    val: bytes,
    next: i64
}

fn sst_rec_at(body: bytes, pos: i64) -> SstRec {
    let bad = SstRec { ok: 0, op: 0, key: "", val: bytes_new(0), next: pos }
    if pos + 1 + 4 > bytes_len(body) {
        return bad
    }
    let op = bytes_at(body, pos)
    let mut p = pos + 1
    let klen = get_u32_le(body, p)
    p = p + 4
    if klen < 0 || p + klen + 4 > bytes_len(body) {
        return bad
    }
    let key = str_of_bytes(bytes_slice(body, p, p + klen))
    p = p + klen
    let vlen = get_u32_le(body, p)
    p = p + 4
    if vlen < 0 || p + vlen > bytes_len(body) {
        return bad
    }
    let val = bytes_slice(body, p, p + vlen)
    p = p + vlen
    return SstRec { ok: 1, op: op, key: key, val: val, next: p }
}

fn sst_parse_rows(body: bytes) -> SstParse {
    let empty: Vec<SstRow> = vec_new()
    if bytes_len(body) < 4 {
        return SstParse { ok: 0, rows: empty }
    }
    let count = get_u32_le(body, 0)
    let mut pos: i64 = 4
    let rows: Vec<SstRow> = vec_new()
    let mut i: i64 = 0
    let mut ok: i64 = 1
    while i < count && ok == 1 {
        let rec = sst_rec_at(body, pos)
        if rec.ok == 0 {
            ok = 0
        } else {
            vec_push(rows, SstRow { op: rec.op, key: rec.key, val: rec.val })
            pos = rec.next
            i = i + 1
        }
    }
    if ok == 0 {
        return SstParse { ok: 0, rows: empty }
    }
    return SstParse { ok: 1, rows: rows }
}

fn sst_magic_ok(mag: str) -> i64 {
    if mag == "BAGASST1" {
        return 1
    }
    if mag == "BAGASST2" {
        return 1
    }
    if mag == "BAGASST3" {
        return 1
    }
    if mag == "BAGASST4" {
        return 1
    }
    if mag == "BAGASST5" {
        return 1
    }
    return 0
}

fn sst_parse(data: bytes) -> SstParse {
    let empty: Vec<SstRow> = vec_new()
    if bytes_len(data) < 8 + 4 + 4 {
        return SstParse { ok: 0, rows: empty }
    }
    let mag = str_of_bytes(bytes_slice(data, 0, 8))
    if sst_magic_ok(mag) == 0 {
        return SstParse { ok: 0, rows: empty }
    }
    let body = bytes_slice(data, 8, bytes_len(data) - 4)
    let got = get_u32_le(data, bytes_len(data) - 4)
    if crc32c_b(body) != got {
        return SstParse { ok: 0, rows: empty }
    }
    return sst_parse_rows(body)
}

struct SstLoad {
    pc: PageCache,
    parse: SstParse
}

struct SstRaw {
    pc: PageCache,
    ok: i64,
    data: bytes
}

fn sst_read_raw(pc: PageCache, dir: str, gen: i64) -> SstRaw !IO {
    let path = sst_path(dir, gen)
    let fd = open(path, 0, 0)?
    if fd < 0 {
        return SstRaw { pc: pc, ok: 0, data: bytes_new(0) }
    }
    let mut cur = pc
    let mut data = bytes_new(0)
    let mut pno: i64 = 0
    let mut more: i64 = 1
    while more == 1 {
        let raw = fd_pread_bytes(fd, cur.page_size, pno * cur.page_size)?
        if bytes_len(raw) == 0 {
            more = 0
        } else {
            let g = pc_get(cur, fd, gen, pno)?
            cur = g.pc
            data = push_bytes(data, raw)
            if bytes_len(raw) < cur.page_size {
                more = 0
            } else {
                pno = pno + 1
            }
        }
    }
    close(fd)
    return SstRaw { pc: cur, ok: 1, data: data }
}

fn sst_load(pc: PageCache, dir: str, gen: i64) -> SstLoad !IO {
    let empty: Vec<SstRow> = vec_new()
    let raw = sst_read_raw(pc, dir, gen)?
    if raw.ok == 0 {
        return SstLoad { pc: raw.pc, parse: SstParse { ok: 0, rows: empty } }
    }
    return SstLoad { pc: raw.pc, parse: sst_parse(raw.data) }
}

struct SstLookup {
    pc: PageCache,
    found: i64,
    alive: i64,
    val: bytes
}

struct SstHit {
    found: i64,
    alive: i64,
    val: bytes
}

fn sst_bsearch(rows: Vec<SstRow>, key: str) -> i64 {
    let n = vec_len(rows)
    if n == 0 {
        return 0 - 1
    }
    if str_cmp(key, vec_get(rows, 0).key) < 0 {
        return 0 - 1
    }
    if str_cmp(key, vec_get(rows, n - 1).key) > 0 {
        return 0 - 1
    }
    let mut lo: i64 = 0
    let mut hi = n - 1
    while lo <= hi {
        let mid = lo + (hi - lo) / 2
        let r = vec_get(rows, mid)
        let c = str_cmp(r.key, key)
        if c == 0 {
            return mid
        }
        if c < 0 {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return 0 - 1
}

fn sst_hit_from_row(r: SstRow) -> SstHit {
    if r.op == 2 {
        return SstHit { found: 1, alive: 0, val: bytes_new(0) }
    }
    return SstHit { found: 1, alive: 1, val: r.val }
}

fn sst_last_key(body: bytes, start: i64, end: i64) -> str {
    let mut pos = start
    let mut last: str = ""
    let mut go: i64 = 1
    while go == 1 {
        if pos >= end {
            go = 0
        } else {
            let rec = sst_rec_at(body, pos)
            if rec.ok == 0 {
                go = 0
            } else {
                if rec.next > end {
                    go = 0
                } else {
                    last = rec.key
                    pos = rec.next
                }
            }
        }
    }
    return last
}

// Indexed lookup on core body (ends with restart footer).
fn sst_lookup_indexed(body: bytes, key: str) -> SstHit {
    let miss = SstHit { found: 0, alive: 0, val: bytes_new(0) }
    let blen = bytes_len(body)
    if blen < 8 {
        return miss
    }
    let count = get_u32_le(body, 0)
    if count <= 0 {
        return miss
    }
    let n_restarts = get_u32_le(body, blen - 4)
    if n_restarts <= 0 {
        return miss
    }
    let idx_base = blen - 4 - n_restarts * 4
    if idx_base < 4 {
        return miss
    }
    let first_off = get_u32_le(body, idx_base)
    if first_off != 4 {
        return miss
    }
    let first_rec = sst_rec_at(body, first_off)
    if first_rec.ok == 0 {
        return miss
    }
    if str_cmp(key, first_rec.key) < 0 {
        return miss
    }
    let last_off = get_u32_le(body, idx_base + (n_restarts - 1) * 4)
    let last_key = sst_last_key(body, last_off, idx_base)
    if len(last_key) == 0 {
        return miss
    }
    if str_cmp(key, last_key) > 0 {
        return miss
    }
    let mut lo: i64 = 0
    let mut hi = n_restarts - 1
    let mut best: i64 = 0
    while lo <= hi {
        let mid = lo + (hi - lo) / 2
        let off = get_u32_le(body, idx_base + mid * 4)
        let rec = sst_rec_at(body, off)
        if rec.ok == 0 {
            return miss
        }
        let c = str_cmp(rec.key, key)
        if c == 0 {
            return sst_hit_from_row(SstRow { op: rec.op, key: rec.key, val: rec.val })
        }
        if c < 0 {
            best = mid
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    let start = get_u32_le(body, idx_base + best * 4)
    let mut end = idx_base
    if best + 1 < n_restarts {
        end = get_u32_le(body, idx_base + (best + 1) * 4)
    }
    let mut pos = start
    let mut go: i64 = 1
    let mut hit = miss
    while go == 1 {
        if pos >= end {
            go = 0
        } else {
            let rec = sst_rec_at(body, pos)
            if rec.ok == 0 {
                go = 0
            } else {
                if rec.next > end {
                    go = 0
                } else {
                    let c = str_cmp(rec.key, key)
                    if c == 0 {
                        hit = sst_hit_from_row(SstRow { op: rec.op, key: rec.key, val: rec.val })
                        go = 0
                    } else {
                        if c > 0 {
                            go = 0
                        } else {
                            pos = rec.next
                        }
                    }
                }
            }
        }
    }
    return hit
}

// v3 layout in full buffer: core+bloom_bits_u32 at end of bloom section.
fn sst_lookup_v3(body: bytes, key: str) -> SstHit {
    let miss = SstHit { found: 0, alive: 0, val: bytes_new(0) }
    let blen = bytes_len(body)
    if blen < 12 {
        return miss
    }
    let m = get_u32_le(body, blen - 4)
    if m <= 0 {
        return miss
    }
    let nbytes = m / 8
    if nbytes <= 0 || blen < 4 + nbytes + 8 {
        return miss
    }
    let bloom_off = blen - 4 - nbytes
    let bits = bytes_slice(body, bloom_off, bloom_off + nbytes)
    if bloom_may(bits, m, key) == 0 {
        return miss
    }
    return sst_lookup_indexed(bytes_slice(body, 0, bloom_off), key)
}

// Footer path (tag 4 = v4, tag 5 = v5 with per-block CRCs after restart index).
fn sst_lookup_footer(body: bytes, key: str) -> SstHit {
    let miss = SstHit { found: 0, alive: 0, val: bytes_new(0) }
    let blen = bytes_len(body)
    let fl = sst_footer_len()
    if blen < fl + 8 {
        return miss
    }
    let fo = blen - fl
    let core_len = get_u32_le(body, fo)
    let bloom_nbytes = get_u32_le(body, fo + 4)
    let m = get_u32_le(body, fo + 8)
    let n_restarts = get_u32_le(body, fo + 12)
    let tag = get_u32_le(body, fo + 20)
    if tag != 4 {
        if tag != 5 {
            return miss
        }
    }
    if core_len <= 0 || bloom_nbytes < 0 || n_restarts <= 0 {
        return miss
    }
    if core_len + bloom_nbytes + fl != blen {
        return miss
    }
    let bits = bytes_slice(body, core_len, core_len + bloom_nbytes)
    if bloom_may(bits, m, key) == 0 {
        return miss
    }
    // Pure restart core (strip trailing block CRCs for v5).
    let mut pure_len = core_len
    if tag == 5 {
        pure_len = core_len - n_restarts * 4
        if pure_len < 8 {
            return miss
        }
    }
    let pure = bytes_slice(body, 0, pure_len)
    let hit = sst_lookup_indexed(pure, key)
    // Optional: verify the block we would scan — full path already trusts whole-body CRC.
    return hit
}

fn sst_lookup_data(data: bytes, key: str) -> SstHit {
    let miss = SstHit { found: 0, alive: 0, val: bytes_new(0) }
    if bytes_len(data) < 8 + 4 + 4 {
        return miss
    }
    let mag = str_of_bytes(bytes_slice(data, 0, 8))
    let body = bytes_slice(data, 8, bytes_len(data) - 4)
    let got = get_u32_le(data, bytes_len(data) - 4)
    if crc32c_b(body) != got {
        return miss
    }
    if mag == "BAGASST5" {
        return sst_lookup_footer(body, key)
    }
    if mag == "BAGASST4" {
        return sst_lookup_footer(body, key)
    }
    if mag == "BAGASST3" {
        return sst_lookup_v3(body, key)
    }
    if mag == "BAGASST2" {
        return sst_lookup_indexed(body, key)
    }
    if mag == "BAGASST1" {
        let p = sst_parse_rows(body)
        if p.ok == 0 {
            return miss
        }
        let j = sst_bsearch(p.rows, key)
        if j < 0 {
            return miss
        }
        return sst_hit_from_row(vec_get(p.rows, j))
    }
    return miss
}

// --- R5 partial get for BAGASST4 (footer + bloom + block via page cache) ---

struct SstKeyAt {
    pc: PageCache,
    ok: i64,
    key: str,
    op: i64,
    val: bytes,
    next: i64
}

// Read one record at body offset via page cache (file off = 8 + body_off).
fn sst_rec_at_fd(pc: PageCache, fd: i64, gen: i64, body_off: i64) -> SstKeyAt !IO {
    let bad = SstKeyAt { pc: pc, ok: 0, key: "", op: 0, val: bytes_new(0), next: body_off }
    let h = pc_read_at(pc, fd, gen, 8 + body_off, 5)?
    if bytes_len(h.data) < 5 {
        return SstKeyAt { pc: h.pc, ok: 0, key: "", op: 0, val: bytes_new(0), next: body_off }
    }
    let op = bytes_at(h.data, 0)
    let klen = get_u32_le(h.data, 1)
    if klen < 0 || klen > 1048576 {
        return SstKeyAt { pc: h.pc, ok: 0, key: "", op: 0, val: bytes_new(0), next: body_off }
    }
    let kr = pc_read_at(h.pc, fd, gen, 8 + body_off + 5, klen + 4)?
    if bytes_len(kr.data) < klen + 4 {
        return SstKeyAt { pc: kr.pc, ok: 0, key: "", op: 0, val: bytes_new(0), next: body_off }
    }
    let key = str_of_bytes(bytes_slice(kr.data, 0, klen))
    let vlen = get_u32_le(kr.data, klen)
    if vlen < 0 || vlen > 67108864 {
        return SstKeyAt { pc: kr.pc, ok: 0, key: "", op: 0, val: bytes_new(0), next: body_off }
    }
    let vr = pc_read_at(kr.pc, fd, gen, 8 + body_off + 5 + klen + 4, vlen)?
    if bytes_len(vr.data) < vlen {
        return SstKeyAt { pc: vr.pc, ok: 0, key: "", op: 0, val: bytes_new(0), next: body_off }
    }
    let next = body_off + 1 + 4 + klen + 4 + vlen
    return SstKeyAt {
        pc: vr.pc, ok: 1, key: key, op: op, val: vr.data, next: next
    }
}

struct SstHitPc {
    pc: PageCache,
    hit: SstHit
}

// Partial get for v4/v5: footer → bloom → restart index → one block (+ CRC for v5).
fn sst_lookup_partial(pc: PageCache, fd: i64, gen: i64, fsize: i64, key: str) -> SstHitPc !IO {
    let miss = SstHit { found: 0, alive: 0, val: bytes_new(0) }
    let fl = sst_footer_len()
    if fsize < 8 + fl + 4 {
        return SstHitPc { pc: pc, hit: miss }
    }
    let body_len = fsize - 8 - 4
    let footer_file_off = 8 + body_len - fl
    let fr = pc_read_at(pc, fd, gen, footer_file_off, fl)?
    let mut cur = fr.pc
    if bytes_len(fr.data) < fl {
        return SstHitPc { pc: cur, hit: miss }
    }
    let core_len = get_u32_le(fr.data, 0)
    let bloom_nbytes = get_u32_le(fr.data, 4)
    let m = get_u32_le(fr.data, 8)
    let n_restarts = get_u32_le(fr.data, 12)
    let tag = get_u32_le(fr.data, 20)
    if tag != 4 {
        if tag != 5 {
            return SstHitPc { pc: cur, hit: miss }
        }
    }
    if core_len <= 0 || n_restarts <= 0 {
        return SstHitPc { pc: cur, hit: miss }
    }
    if core_len + bloom_nbytes + fl != body_len {
        return SstHitPc { pc: cur, hit: miss }
    }
    if bloom_nbytes > 0 {
        let br = pc_read_at(cur, fd, gen, 8 + core_len, bloom_nbytes)?
        cur = br.pc
        if bytes_len(br.data) < bloom_nbytes {
            return SstHitPc { pc: cur, hit: miss }
        }
        if bloom_may(br.data, m, key) == 0 {
            return SstHitPc { pc: cur, hit: miss }
        }
    }
    // Restart index: before trailing block CRCs (v5) or at end of pure core (v4).
    let mut idx_base = core_len - 4 - n_restarts * 4
    if tag == 5 {
        idx_base = core_len - 4 - n_restarts * 4 - n_restarts * 4
    }
    if idx_base < 4 {
        return SstHitPc { pc: cur, hit: miss }
    }
    let idx_len = n_restarts * 4 + 4
    let ir = pc_read_at(cur, fd, gen, 8 + idx_base, idx_len)?
    cur = ir.pc
    if bytes_len(ir.data) < idx_len {
        return SstHitPc { pc: cur, hit: miss }
    }
    // ir.data is restarts + n_restarts; first N u32s are offsets.
    let first_off = get_u32_le(ir.data, 0)
    if first_off != 4 {
        return SstHitPc { pc: cur, hit: miss }
    }
    let frk = sst_rec_at_fd(cur, fd, gen, first_off)?
    cur = frk.pc
    if frk.ok == 0 {
        return SstHitPc { pc: cur, hit: miss }
    }
    if str_cmp(key, frk.key) < 0 {
        return SstHitPc { pc: cur, hit: miss }
    }
    let last_off = get_u32_le(ir.data, (n_restarts - 1) * 4)
    let block_end = idx_base
    let span = block_end - last_off
    if span < 0 || span > 16777216 {
        return SstHitPc { pc: cur, hit: miss }
    }
    let lr = pc_read_at(cur, fd, gen, 8 + last_off, span)?
    cur = lr.pc
    let last_key = sst_last_key(lr.data, 0, bytes_len(lr.data))
    if len(last_key) == 0 {
        return SstHitPc { pc: cur, hit: miss }
    }
    if str_cmp(key, last_key) > 0 {
        return SstHitPc { pc: cur, hit: miss }
    }
    let mut lo: i64 = 0
    let mut hi = n_restarts - 1
    let mut best: i64 = 0
    while lo <= hi {
        let mid = lo + (hi - lo) / 2
        let off = get_u32_le(ir.data, mid * 4)
        let rk = sst_rec_at_fd(cur, fd, gen, off)?
        cur = rk.pc
        if rk.ok == 0 {
            return SstHitPc { pc: cur, hit: miss }
        }
        let c = str_cmp(rk.key, key)
        if c == 0 {
            // Exact hit at restart — still verify block CRC for v5.
            if tag == 5 {
                let mut end = idx_base
                if mid + 1 < n_restarts {
                    end = get_u32_le(ir.data, (mid + 1) * 4)
                }
                let bspan = end - off
                let brc = pc_read_at(cur, fd, gen, 8 + off, bspan)?
                cur = brc.pc
                let want = pc_read_at(cur, fd, gen, 8 + core_len - n_restarts * 4 + mid * 4, 4)?
                cur = want.pc
                if bytes_len(want.data) < 4 {
                    return SstHitPc { pc: cur, hit: miss }
                }
                if crc32c_b(brc.data) != get_u32_le(want.data, 0) {
                    return SstHitPc { pc: cur, hit: miss }
                }
            }
            let h = sst_hit_from_row(SstRow { op: rk.op, key: rk.key, val: rk.val })
            return SstHitPc { pc: cur, hit: h }
        }
        if c < 0 {
            best = mid
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    let start = get_u32_le(ir.data, best * 4)
    let mut end = idx_base
    if best + 1 < n_restarts {
        end = get_u32_le(ir.data, (best + 1) * 4)
    }
    let bspan = end - start
    if bspan < 0 || bspan > 16777216 {
        return SstHitPc { pc: cur, hit: miss }
    }
    let br2 = pc_read_at(cur, fd, gen, 8 + start, bspan)?
    cur = br2.pc
    let block = br2.data
    if tag == 5 {
        let crc_off = core_len - n_restarts * 4 + best * 4
        let want = pc_read_at(cur, fd, gen, 8 + crc_off, 4)?
        cur = want.pc
        if bytes_len(want.data) < 4 {
            return SstHitPc { pc: cur, hit: miss }
        }
        if crc32c_b(block) != get_u32_le(want.data, 0) {
            return SstHitPc { pc: cur, hit: miss }
        }
    }
    let mut pos: i64 = 0
    let mut go: i64 = 1
    let mut hit = miss
    while go == 1 {
        if pos >= bytes_len(block) {
            go = 0
        } else {
            let rec = sst_rec_at(block, pos)
            if rec.ok == 0 {
                go = 0
            } else {
                let c = str_cmp(rec.key, key)
                if c == 0 {
                    hit = sst_hit_from_row(SstRow { op: rec.op, key: rec.key, val: rec.val })
                    go = 0
                } else {
                    if c > 0 {
                        go = 0
                    } else {
                        pos = rec.next
                    }
                }
            }
        }
    }
    return SstHitPc { pc: cur, hit: hit }
}

// Newest-first lookup. R9: external bloom can skip SST open on definite miss.
// v4/v5 partial page-cache path; older formats full read.
fn sst_get(pc: PageCache, dir: str, gens: Vec<i64>, key: str) -> SstLookup !IO {
    let mut cur = pc
    let mut i = vec_len(gens) - 1
    while i >= 0 {
        let gen = vec_get(gens, i)
        // Sidecar bloom: 0 = skip this gen without opening SST.
        let bm = bloom_file_may(dir, gen, key)?
        if bm == 0 {
            i = i - 1
        } else {
            let path = sst_path(dir, gen)
            let fd = open(path, 0, 0)?
            if fd >= 0 {
                let fsize = fd_size(fd)?
                let magb = fd_pread_bytes(fd, 8, 0)?
                if bytes_len(magb) == 8 {
                    let mag = str_of_bytes(magb)
                    if mag == "BAGASST5" {
                        let r = sst_lookup_partial(cur, fd, gen, fsize, key)?
                        cur = r.pc
                        close(fd)
                        if r.hit.found == 1 {
                            return SstLookup {
                                pc: cur, found: 1, alive: r.hit.alive, val: r.hit.val
                            }
                        }
                    } else {
                        if mag == "BAGASST4" {
                            let r = sst_lookup_partial(cur, fd, gen, fsize, key)?
                            cur = r.pc
                            close(fd)
                            if r.hit.found == 1 {
                                return SstLookup {
                                    pc: cur, found: 1, alive: r.hit.alive, val: r.hit.val
                                }
                            }
                        } else {
                            close(fd)
                            let raw = sst_read_raw(cur, dir, gen)?
                            cur = raw.pc
                            if raw.ok == 1 {
                                let h = sst_lookup_data(raw.data, key)
                                if h.found == 1 {
                                    return SstLookup {
                                        pc: cur, found: 1, alive: h.alive, val: h.val
                                    }
                                }
                            }
                        }
                    }
                } else {
                    close(fd)
                }
            }
            i = i - 1
        }
    }
    return SstLookup { pc: cur, found: 0, alive: 0, val: bytes_new(0) }
}
