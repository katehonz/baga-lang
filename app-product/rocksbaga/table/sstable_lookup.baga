// sstable_lookup.baga — in-memory SST lookup: bsearch + restart-index,
// v3 footer, fallback data scan, last_key. Мета/fd вариантът е в
// sstable_meta.baga.

import "../util/codec.baga"
import "../cache/page.baga"
import "sstable.baga"
import "block.baga"
import "bloom.baga"
import "std/os/os.baga"
import "std/str/str.baga"

struct SstHit {
    found: i64,
    alive: i64,
    val: bytes
}

fn sst_bsearch(rows: Vec<SstRow>, key: bytes) -> i64 {
    let n = vec_len(rows)
    if n == 0 {
        return 0 - 1
    }
    if bytes_cmp(key, vec_get(rows, 0).key) < 0 {
        return 0 - 1
    }
    if bytes_cmp(key, vec_get(rows, n - 1).key) > 0 {
        return 0 - 1
    }
    let mut lo: i64 = 0
    let mut hi = n - 1
    while lo <= hi {
        let mid = lo + (hi - lo) / 2
        let r = vec_get(rows, mid)
        let c = bytes_cmp(r.key, key)
        if c == 0 {
            return mid
        }
        if c < 0 {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return 0 - 1
}

fn sst_hit_from_row(r: SstRow) -> SstHit {
    if r.op == 2 {
        return SstHit { found: 1, alive: 0, val: bytes_new(0) }
    }
    return SstHit { found: 1, alive: 1, val: r.val }
}

fn sst_last_key(body: bytes, start: i64, end: i64) -> bytes {
    return block_last_key(body, start, end)
}

// Indexed lookup on core body (ends with restart footer).
fn sst_lookup_indexed(body: bytes, key: bytes) -> SstHit {
    let miss = SstHit { found: 0, alive: 0, val: bytes_new(0) }
    let blen = bytes_len(body)
    if blen < 8 {
        return miss
    }
    let count = get_u32_le(body, 0)
    if count <= 0 {
        return miss
    }
    let n_restarts = get_u32_le(body, blen - 4)
    if n_restarts <= 0 {
        return miss
    }
    let idx_base = blen - 4 - n_restarts * 4
    if idx_base < 4 {
        return miss
    }
    let first_off = get_u32_le(body, idx_base)
    if first_off != 4 {
        return miss
    }
    let first_rec = sst_rec_at(body, first_off)
    if first_rec.ok == 0 {
        return miss
    }
    if bytes_cmp(key, first_rec.key) < 0 {
        return miss
    }
    let last_off = get_u32_le(body, idx_base + (n_restarts - 1) * 4)
    let last_key = sst_last_key(body, last_off, idx_base)
    if bytes_len(last_key) == 0 {
        return miss
    }
    if bytes_cmp(key, last_key) > 0 {
        return miss
    }
    let mut lo: i64 = 0
    let mut hi = n_restarts - 1
    let mut best: i64 = 0
    while lo <= hi {
        let mid = lo + (hi - lo) / 2
        let off = get_u32_le(body, idx_base + mid * 4)
        let rec = sst_rec_at(body, off)
        if rec.ok == 0 {
            return miss
        }
        let c = bytes_cmp(rec.key, key)
        if c == 0 {
            return sst_hit_from_row(SstRow { op: rec.op, key: rec.key, val: rec.val })
        }
        if c < 0 {
            best = mid
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    let start = get_u32_le(body, idx_base + best * 4)
    let mut end = idx_base
    if best + 1 < n_restarts {
        end = get_u32_le(body, idx_base + (best + 1) * 4)
    }
    let mut pos = start
    let mut go: i64 = 1
    let mut hit = miss
    while go == 1 {
        if pos >= end {
            go = 0
        } else {
            let rec = sst_rec_at(body, pos)
            if rec.ok == 0 {
                go = 0
            } else {
                if rec.next > end {
                    go = 0
                } else {
                    let c = bytes_cmp(rec.key, key)
                    if c == 0 {
                        hit = sst_hit_from_row(SstRow { op: rec.op, key: rec.key, val: rec.val })
                        go = 0
                    } else {
                        if c > 0 {
                            go = 0
                        } else {
                            pos = rec.next
                        }
                    }
                }
            }
        }
    }
    return hit
}

// v3 layout in full buffer: core+bloom_bits_u32 at end of bloom section.
fn sst_lookup_v3(body: bytes, key: bytes) -> SstHit {
    let miss = SstHit { found: 0, alive: 0, val: bytes_new(0) }
    let blen = bytes_len(body)
    if blen < 12 {
        return miss
    }
    let m = get_u32_le(body, blen - 4)
    if m <= 0 {
        return miss
    }
    let nbytes = m / 8
    if nbytes <= 0 || blen < 4 + nbytes + 8 {
        return miss
    }
    let bloom_off = blen - 4 - nbytes
    let bits = bytes_slice(body, bloom_off, bloom_off + nbytes)
    if bloom_may_b(bits, m, key) == 0 {
        return miss
    }
    return sst_lookup_indexed(bytes_slice(body, 0, bloom_off), key)
}

// Footer path (tag 4 = v4, tag 5 = v5 with per-block CRCs after restart index).
fn sst_lookup_footer(body: bytes, key: bytes) -> SstHit {
    let miss = SstHit { found: 0, alive: 0, val: bytes_new(0) }
    let blen = bytes_len(body)
    let fl = sst_footer_len()
    if blen < fl + 8 {
        return miss
    }
    let fo = blen - fl
    let core_len = get_u32_le(body, fo)
    let bloom_nbytes = get_u32_le(body, fo + 4)
    let m = get_u32_le(body, fo + 8)
    let n_restarts = get_u32_le(body, fo + 12)
    let tag = get_u32_le(body, fo + 20)
    if tag != 4 {
        if tag != 5 {
            return miss
        }
    }
    if core_len <= 0 || bloom_nbytes < 0 || n_restarts <= 0 {
        return miss
    }
    if core_len + bloom_nbytes + fl != blen {
        return miss
    }
    let bits = bytes_slice(body, core_len, core_len + bloom_nbytes)
    if bloom_may_b(bits, m, key) == 0 {
        return miss
    }
    // Pure restart core (strip trailing block CRCs for v5).
    let mut pure_len = core_len
    if tag == 5 {
        pure_len = core_len - n_restarts * 4
        if pure_len < 8 {
            return miss
        }
    }
    let pure = bytes_slice(body, 0, pure_len)
    let hit = sst_lookup_indexed(pure, key)
    // Optional: verify the block we would scan — full path already trusts whole-body CRC.
    return hit
}

fn sst_lookup_data(data: bytes, key: bytes) -> SstHit {
    let miss = SstHit { found: 0, alive: 0, val: bytes_new(0) }
    if bytes_len(data) < 8 + 4 + 4 {
        return miss
    }
    let mag = str_of_bytes(bytes_slice(data, 0, 8))
    let body = bytes_slice(data, 8, bytes_len(data) - 4)
    let got = get_u32_le(data, bytes_len(data) - 4)
    if crc32c_b(body) != got {
        return miss
    }
    if mag == "BAGASST5" {
        return sst_lookup_footer(body, key)
    }
    if mag == "BAGASST4" {
        return sst_lookup_footer(body, key)
    }
    if mag == "BAGASST3" {
        return sst_lookup_v3(body, key)
    }
    if mag == "BAGASST2" {
        return sst_lookup_indexed(body, key)
    }
    if mag == "BAGASST1" {
        let p = sst_parse_rows(body)
        if p.ok == 0 {
            return miss
        }
        let j = sst_bsearch(p.rows, key)
        if j < 0 {
            return miss
        }
        return sst_hit_from_row(vec_get(p.rows, j))
    }
    return miss
}

