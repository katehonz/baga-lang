// server_mt.baga — R56/R57 MT inline изпълнение + active expire
// (hop-less): LsmMTCtx pack, mt get/put/del/int_op, lsm_mt_exec_kb.
// Conn loop-ът е в server_mt_conn.baga.

import "server.baga"
import "../db/shard.baga"
import "../db/shard_read.baga"
import "../db/shard_ttl.baga"
import "../db/engine.baga"
import "../db/engine_ttl.baga"
import "../db/engine_keys.baga"
import "../db/engine_scan.baga"
import "../db/workers.baga"
import "../db/workers_par.baga"
import "../db/workers_api.baga"
import "../db/multidb.baga"
import "kvbaga/resp.baga"
import "std/net/tcp.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/time/time.baga"
import "std/bytes/bytes.baga"

// --- R56/R57: MT inline command execution + active expire (hop-less) ---

// Shared MT context: shard dbs + per-shard mutexes + expires index.
// Maps are shared by reference; struct passed by value is fine.
struct LsmMTCtx {
    dbs: Map<i64, LsmDB>,
    mus: Map<i64, i64>,
    exps: Map<bytes, i64>, // u32le(sid)‖key -> deadline ms (R57; R68 binary-safe)
    emu: i64,              // mutex guarding exps
    nshards: i64
}

fn lsm_mt_ctx(h: i64) -> LsmMTCtx {
    let dbs: Map<i64, LsmDB> = h_map(cell2_0(h))
    let r1 = cell2_1(h)
    let mus: Map<i64, i64> = h_map(cell2_0(r1))
    let r2 = cell2_1(r1)
    let exps: Map<bytes, i64> = h_map(cell2_0(r2))
    let r3 = cell2_1(r2)
    return LsmMTCtx {
        dbs: dbs, mus: mus, exps: exps,
        emu: cell2_0(r3), nshards: cell2_1(r3)
    }
}

fn lsm_mt_pack_ctx(c: LsmMTCtx) -> i64 {
    return cell2(map_h(c.dbs), cell2(map_h(c.mus), cell2(map_h(c.exps), cell2(c.emu, c.nshards))))
}

// R68: expires-index key = u32 LE sid prefix + raw key bytes (one prealloc,
// no concat; the old "sid:key" str broke on keys with embedded NUL or ':').
fn lsm_mt_ek(sid: i64, key: bytes) -> bytes {
    let klen = bytes_len(key)
    let ek = bytes_new(4 + klen)
    put_u32_le(ek, 0, sid)
    let mut i: i64 = 0
    while i < klen {
        bytes_set(ek, 4 + i, bytes_at(key, i))
        i = i + 1
    }
    return ek
}

// R57: record/clear expiry intent (deadline ms; 0 = clear).
fn lsm_mt_exp_note(c: LsmMTCtx, sid: i64, key: bytes, deadline: i64) -> i64 !Par {
    let ek = lsm_mt_ek(sid, key)
    mutex_lock(c.emu)
    if deadline > 0 {
        map_set(c.exps, ek, deadline)
    } else {
        if map_has(c.exps, ek) == 1 {
            map_del(c.exps, ek)
        }
    }
    mutex_unlock(c.emu)
    return 0
}

struct LsmMTGet {
    found: i64,
    val: bytes
}

// R68: bytes-key MT get core.
fn lsm_mt_get_kb(c: LsmMTCtx, key: bytes) -> LsmMTGet !IO !Time !Par {
    let sid = lsm_shard_ix_b(c.nshards, key)
    let mu = map_get(c.mus, sid)
    mutex_lock(mu)
    let db0 = map_get(c.dbs, sid)
    let g = lsm_get_kb(db0, key)?
    map_set(c.dbs, sid, g.db)
    mutex_unlock(mu)
    return LsmMTGet { found: g.found, val: g.val }
}

fn lsm_mt_get(c: LsmMTCtx, key: str) -> LsmMTGet !IO !Time !Par {
    return lsm_mt_get_kb(c, bytes_of_str(key))?
}

// R68: bytes-key MT put core (ttl_sec <= 0 → plain put, clears TTL).
fn lsm_mt_put_kb(c: LsmMTCtx, key: bytes, val: bytes, ttl_sec: i64) -> i64 !IO !Time !Par {
    let sid = lsm_shard_ix_b(c.nshards, key)
    let mu = map_get(c.mus, sid)
    mutex_lock(mu)
    let db0 = map_get(c.dbs, sid)
    let mut db1 = db0
    if ttl_sec > 0 {
        db1 = lsm_put_ex_kb(db0, key, val, ttl_sec)?
    } else {
        db1 = lsm_put_kb(db0, key, val)?
    }
    map_set(c.dbs, sid, db1)
    mutex_unlock(mu)
    let mut dl: i64 = 0
    if ttl_sec > 0 {
        dl = time_now_ms()? + ttl_sec * 1000
    }
    lsm_mt_exp_note(c, sid, key, dl)?
    return 1
}

// R65: binary-safe MT put.
fn lsm_mt_put_b(c: LsmMTCtx, key: str, val: bytes, ttl_sec: i64) -> i64 !IO !Time !Par {
    return lsm_mt_put_kb(c, bytes_of_str(key), val, ttl_sec)?
}

// ttl_sec <= 0 → plain put (clears TTL, Redis semantics)
fn lsm_mt_put(c: LsmMTCtx, key: str, val: str, ttl_sec: i64) -> i64 !IO !Time !Par {
    return lsm_mt_put_b(c, key, bytes_of_str(val), ttl_sec)?
}

// R68: bytes-key MT delete core.
fn lsm_mt_del_kb(c: LsmMTCtx, key: bytes) -> i64 !IO !Time !Par {
    let sid = lsm_shard_ix_b(c.nshards, key)
    let mu = map_get(c.mus, sid)
    mutex_lock(mu)
    let db0 = map_get(c.dbs, sid)
    let g = lsm_get_kb(db0, key)?
    let mut db1 = g.db
    let mut nfound: i64 = 0
    if g.found == 1 {
        db1 = lsm_del_kb(db1, key)?
        nfound = 1
    }
    map_set(c.dbs, sid, db1)
    mutex_unlock(mu)
    if nfound == 1 {
        lsm_mt_exp_note(c, sid, key, 0)?
    }
    return nfound
}

fn lsm_mt_del(c: LsmMTCtx, key: str) -> i64 !IO !Time !Par {
    return lsm_mt_del_kb(c, bytes_of_str(key))?
}

// R68: bytes-key INCR/DECR core. Returns reply string: ":n\r\n" or error.
fn lsm_mt_int_op_kb(c: LsmMTCtx, key: bytes, delta: i64) -> str !IO !Time !Par {
    let sid = lsm_shard_ix_b(c.nshards, key)
    let mu = map_get(c.mus, sid)
    mutex_lock(mu)
    let db0 = map_get(c.dbs, sid)
    let g = lsm_get_kb(db0, key)?
    let mut db1 = g.db
    let mut base: i64 = 0
    let mut bad: i64 = 0
    if g.found == 1 {
        let vs = str_of_bytes(g.val)
        if lsm_is_int(vs) == 0 {
            bad = 1
        } else {
            base = parse_int(vs)
        }
    }
    let mut rep = "-ERR value is not an integer or out of range\r\n"
    if bad == 0 {
        let nv = base + delta
        db1 = lsm_put_kb(db1, key, bytes_of_str(int_to_str(nv)))?
        map_set(c.dbs, sid, db1)
        rep = concat(concat(":", int_to_str(nv)), "\r\n")
    }
    mutex_unlock(mu)
    if bad == 0 {
        lsm_mt_exp_note(c, sid, key, 0)?
    }
    return rep
}

fn lsm_mt_int_op(c: LsmMTCtx, key: str, delta: i64) -> str !IO !Time !Par {
    return lsm_mt_int_op_kb(c, bytes_of_str(key), delta)?
}

// R56: one RESP command → reply bytes, executed inline (no worker hop).
// Multi-key / all-shard commands lock one shard at a time — no deadlocks.
// R68: bytes-key core — raw RESP args; keys go to lsm_mt_*_kb (NUL-safe).
// Only command names / numbers parse via str_of_bytes (ASCII).
fn lsm_mt_exec_kb(c: LsmMTCtx, args: Vec<bytes>) -> bytes !IO !Time !Par {
    let c0 = str_of_bytes(vec_get(args, 0))
    let n = vec_len(args)
    if lsm_eq_ci(c0, "SET") == 1 && n == 3 {
        lsm_mt_put_kb(c, vec_get(args, 1), vec_get(args, 2), 0)?
        return resp_ok()
    }
    if lsm_eq_ci(c0, "SETEX") == 1 && n == 4 {
        let sec_s = str_of_bytes(vec_get(args, 2))
        if lsm_is_int(sec_s) == 0 {
            return resp_error("ERR value is not an integer or out of range")
        }
        lsm_mt_put_kb(c, vec_get(args, 1), vec_get(args, 3), parse_int(sec_s))?
        return resp_ok()
    }
    if lsm_eq_ci(c0, "GET") == 1 && n == 2 {
        let g = lsm_mt_get_kb(c, vec_get(args, 1))?
        if g.found == 0 {
            return resp_null_bulk()
        }
        return resp_bulk_b(g.val)
    }
    if lsm_eq_ci(c0, "DEL") == 1 && n == 2 {
        return resp_int(lsm_mt_del_kb(c, vec_get(args, 1))?)
    }
    if lsm_eq_ci(c0, "EXISTS") == 1 && n == 2 {
        let g = lsm_mt_get_kb(c, vec_get(args, 1))?
        return resp_int(g.found)
    }
    if lsm_eq_ci(c0, "INCR") == 1 && n == 2 {
        return bytes_of_str(lsm_mt_int_op_kb(c, vec_get(args, 1), 1)?)
    }
    if lsm_eq_ci(c0, "DECR") == 1 && n == 2 {
        return bytes_of_str(lsm_mt_int_op_kb(c, vec_get(args, 1), 0 - 1)?)
    }
    // R69: INCRBY / DECRBY k delta — MT parity.
    if lsm_eq_ci(c0, "INCRBY") == 1 && n == 3 {
        let d_s = str_of_bytes(vec_get(args, 2))
        if lsm_is_int(d_s) == 0 {
            return resp_error("ERR value is not an integer or out of range")
        }
        return bytes_of_str(lsm_mt_int_op_kb(c, vec_get(args, 1), parse_int(d_s))?)
    }
    if lsm_eq_ci(c0, "DECRBY") == 1 && n == 3 {
        let d_s = str_of_bytes(vec_get(args, 2))
        if lsm_is_int(d_s) == 0 {
            return resp_error("ERR value is not an integer or out of range")
        }
        return bytes_of_str(lsm_mt_int_op_kb(c, vec_get(args, 1), 0 - parse_int(d_s))?)
    }
    // R69: GETSET / STRLEN / GETDEL / SETNX / UNLINK — MT parity.
    if lsm_eq_ci(c0, "GETSET") == 1 && n == 3 {
        let k = vec_get(args, 1)
        let g = lsm_mt_get_kb(c, k)?
        lsm_mt_put_kb(c, k, vec_get(args, 2), 0)?
        if g.found == 0 {
            return resp_null_bulk()
        }
        return resp_bulk_b(g.val)
    }
    if lsm_eq_ci(c0, "STRLEN") == 1 && n == 2 {
        let g = lsm_mt_get_kb(c, vec_get(args, 1))?
        let mut vl: i64 = 0
        if g.found == 1 {
            vl = bytes_len(g.val)
        }
        return resp_int(vl)
    }
    if lsm_eq_ci(c0, "GETDEL") == 1 && n == 2 {
        let k = vec_get(args, 1)
        let g = lsm_mt_get_kb(c, k)?
        if g.found == 0 {
            return resp_null_bulk()
        }
        lsm_mt_del_kb(c, k)?
        return resp_bulk_b(g.val)
    }
    if lsm_eq_ci(c0, "SETNX") == 1 && n == 3 {
        let k = vec_get(args, 1)
        let g = lsm_mt_get_kb(c, k)?
        if g.found == 1 {
            return resp_int(0)
        }
        lsm_mt_put_kb(c, k, vec_get(args, 2), 0)?
        return resp_int(1)
    }
    if lsm_eq_ci(c0, "UNLINK") == 1 && n >= 2 {
        let mut ndel: i64 = 0
        let mut di: i64 = 1
        while di < n {
            ndel = ndel + lsm_mt_del_kb(c, vec_get(args, di))?
            di = di + 1
        }
        return resp_int(ndel)
    }
    if lsm_eq_ci(c0, "DEL") == 1 && n >= 3 {
        // R69: multi-key DEL — MT parity (single-key stays on the fast path).
        let mut ndel: i64 = 0
        let mut di: i64 = 1
        while di < n {
            ndel = ndel + lsm_mt_del_kb(c, vec_get(args, di))?
            di = di + 1
        }
        return resp_int(ndel)
    }
    if lsm_eq_ci(c0, "APPEND") == 1 && n == 3 {
        let key = vec_get(args, 1)
        let g = lsm_mt_get_kb(c, key)?
        let mut cur = bytes_new(0)
        if g.found == 1 {
            cur = g.val
        }
        let nv = bytes_concat(cur, vec_get(args, 2))
        let nlen = bytes_len(nv)
        lsm_mt_put_kb(c, key, nv, 0)?
        return resp_int(nlen)
    }
    if lsm_eq_ci(c0, "TYPE") == 1 && n == 2 {
        let g = lsm_mt_get_kb(c, vec_get(args, 1))?
        if g.found == 1 {
            return resp_simple("string")
        }
        return resp_simple("none")
    }
    if lsm_eq_ci(c0, "MGET") == 1 && n >= 2 {
        let mut r = resp_array(n - 1)
        let mut i: i64 = 1
        while i < n {
            let g = lsm_mt_get_kb(c, vec_get(args, i))?
            if g.found == 1 {
                r = bytes_concat(r, resp_bulk_b(g.val))
            } else {
                r = bytes_concat(r, resp_null_bulk())
            }
            i = i + 1
        }
        return r
    }
    if lsm_eq_ci(c0, "MSET") == 1 && n >= 3 && n % 2 == 1 {
        let mut i: i64 = 1
        while i + 1 < n {
            lsm_mt_put_kb(c, vec_get(args, i), vec_get(args, i + 1), 0)?
            i = i + 2
        }
        return resp_ok()
    }
    if lsm_eq_ci(c0, "EXPIRE") == 1 && n == 3 {
        let sec_s = str_of_bytes(vec_get(args, 2))
        if lsm_is_int(sec_s) == 0 {
            return resp_error("ERR value is not an integer or out of range")
        }
        let key = vec_get(args, 1)
        let sec = parse_int(sec_s)
        let sid = lsm_shard_ix_b(c.nshards, key)
        let mu = map_get(c.mus, sid)
        mutex_lock(mu)
        let db0 = map_get(c.dbs, sid)
        let e = lsm_expire_kb(db0, key, sec)?
        map_set(c.dbs, sid, e.db)
        mutex_unlock(mu)
        if e.ok == 1 {
            lsm_mt_exp_note(c, sid, key, time_now_ms()? + sec * 1000)?
        }
        return resp_int(e.ok)
    }
    if lsm_eq_ci(c0, "TTL") == 1 && n == 2 {
        let key = vec_get(args, 1)
        let sid = lsm_shard_ix_b(c.nshards, key)
        let mu = map_get(c.mus, sid)
        mutex_lock(mu)
        let db0 = map_get(c.dbs, sid)
        let t = lsm_ttl_kb(db0, key)?
        map_set(c.dbs, sid, t.db)
        mutex_unlock(mu)
        return resp_int(t.n)
    }
    if lsm_eq_ci(c0, "PERSIST") == 1 && n == 2 {
        let key = vec_get(args, 1)
        let sid = lsm_shard_ix_b(c.nshards, key)
        let mu = map_get(c.mus, sid)
        mutex_lock(mu)
        let db0 = map_get(c.dbs, sid)
        let pe = lsm_persist_kb(db0, key)?
        map_set(c.dbs, sid, pe.db)
        mutex_unlock(mu)
        if pe.ok == 1 {
            lsm_mt_exp_note(c, sid, key, 0)?
        }
        return resp_int(pe.ok)
    }
    if lsm_eq_ci(c0, "DBSIZE") == 1 && n == 1 {
        let mut total: i64 = 0
        let mut sid: i64 = 0
        while sid < c.nshards {
            let mu = map_get(c.mus, sid)
            mutex_lock(mu)
            let db0 = map_get(c.dbs, sid)
            let ds = lsm_dbsize(db0)?
            map_set(c.dbs, sid, ds.db)
            mutex_unlock(mu)
            total = total + ds.n
            sid = sid + 1
        }
        return resp_int(total)
    }
    if (lsm_eq_ci(c0, "SAVE") == 1 || lsm_eq_ci(c0, "BGSAVE") == 1) && n == 1 {
        let mut sid: i64 = 0
        while sid < c.nshards {
            let mu = map_get(c.mus, sid)
            mutex_lock(mu)
            let db0 = map_get(c.dbs, sid)
            let db1 = lsm_flush_force(db0)?
            map_set(c.dbs, sid, db1)
            mutex_unlock(mu)
            sid = sid + 1
        }
        return resp_ok()
    }
    if lsm_eq_ci(c0, "CHECKPOINT") == 1 && n == 2 {
        let dest = str_of_bytes(vec_get(args, 1))
        let mut sid: i64 = 0
        let mut ok_all: i64 = 1
        while sid < c.nshards {
            let mu = map_get(c.mus, sid)
            mutex_lock(mu)
            let db0 = map_get(c.dbs, sid)
            let mut d = dest
            if c.nshards > 1 {
                d = concat(concat(dest, ".s"), int_to_str(sid))
            }
            let db1 = lsm_checkpoint(db0, d)?
            if db1.ok == 0 {
                ok_all = 0
            }
            map_set(c.dbs, sid, db1)
            mutex_unlock(mu)
            sid = sid + 1
        }
        if ok_all == 1 {
            return resp_ok()
        }
        return resp_error("ERR checkpoint failed")
    }
    // R62: BACKUP dest — checkpoint each shard under mutex, then meta.
    if lsm_eq_ci(c0, "BACKUP") == 1 && n == 2 {
        let dest = str_of_bytes(vec_get(args, 1))
        let mut sid: i64 = 0
        let mut ok_all: i64 = 1
        while sid < c.nshards {
            let mu = map_get(c.mus, sid)
            mutex_lock(mu)
            let db0 = map_get(c.dbs, sid)
            let mut d = dest
            if c.nshards > 1 {
                d = concat(concat(dest, ".s"), int_to_str(sid))
            }
            let db1 = lsm_checkpoint(db0, d)?
            if db1.ok == 0 {
                ok_all = 0
            }
            map_set(c.dbs, sid, db1)
            mutex_unlock(mu)
            sid = sid + 1
        }
        if ok_all == 0 {
            return resp_error("ERR backup failed")
        }
        let st = lsm_backup_write_meta(dest, c.nshards)?
        if st.ok == 1 {
            return resp_ok()
        }
        return resp_error("ERR backup meta failed")
    }
    return resp_error(concat(concat("ERR unknown/unsupported command '", c0), "' (mt mode)"))
}

// R65/R68 wire entry: binary parse args → bytes-key MT core.
fn lsm_mt_exec_b(c: LsmMTCtx, args: Vec<bytes>) -> bytes !IO !Time !Par {
    let n = vec_len(args)
    if n < 1 {
        return resp_error("ERR empty command")
    }
    return lsm_mt_exec_kb(c, args)?
}

// str-arg compat wrapper (tests / legacy callers) — args convert losslessly.
fn lsm_mt_exec(c: LsmMTCtx, args: Vec<str>) -> bytes !IO !Time !Par {
    let n = vec_len(args)
    if n < 1 {
        return resp_error("ERR empty command")
    }
    return lsm_mt_exec_kb(c, lsm_args_bytes(args))?
}

// R57: active expire cycle (Redis-style). Every 100ms snapshot the due
// entries of the shared expires index, then tombstone each key whose VALUE
// is still expired (re-SET without TTL in the meantime → skip). Lazy
// expiry on read stays as the always-correct net; this frees the space.
// R68: index keys are u32le(sid)‖raw-key bytes — NUL-safe.
fn lsm_mt_sweeper(ctx: i64) -> i64 !IO !Par !Time {
    let c = lsm_mt_ctx(ctx)
    while true {
        sleep_ms(100)
        let now = time_now_ms()?
        let due: Vec<bytes> = vec_new()
        mutex_lock(c.emu)
        let ks = map_keys(c.exps)
        let mut i: i64 = 0
        while i < vec_len(ks) {
            let ek = vec_get(ks, i)
            if map_get(c.exps, ek) <= now {
                vec_push(due, ek)
            }
            i = i + 1
        }
        mutex_unlock(c.emu)
        let mut j: i64 = 0
        while j < vec_len(due) {
            let ek = vec_get(due, j)
            // claim the entry (only if still due) before touching the shard
            let mut mine: i64 = 0
            mutex_lock(c.emu)
            if map_has(c.exps, ek) == 1 {
                if map_get(c.exps, ek) <= now {
                    map_del(c.exps, ek)
                    mine = 1
                }
            }
            mutex_unlock(c.emu)
            if mine == 1 {
                let sid = get_u32_le(ek, 0)
                let key = bytes_slice(ek, 4, bytes_len(ek))
                let mu = map_get(c.mus, sid)
                mutex_lock(mu)
                let db0 = map_get(c.dbs, sid)
                let g = lsm_get_kb(db0, key)?
                let mut db1 = g.db
                if g.found == 0 {
                    // found==0: expired-in-place (lazy) or absent — tombstone
                    // clears the stale envelope; absent is a rare stray tomb
                    db1 = lsm_del_kb(db1, key)?
                }
                map_set(c.dbs, sid, db1)
                mutex_unlock(mu)
            }
            j = j + 1
        }
    }
    return 0
}

