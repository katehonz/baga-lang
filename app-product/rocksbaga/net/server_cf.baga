// server_cf.baga — R46 CF-mode RESP (LSM_CF=1): shared-WAL families,
// LsmCfExec изпълнител (exec_cf_kb), LsmCfSrv poll + serve_cf_to.

import "server.baga"
import "../db/cf.baga"
import "../db/cf_io.baga"
import "../db/engine.baga"
import "../db/engine_keys.baga"
import "../db/engine_scan.baga"
import "../db/multidb.baga"
import "kvbaga/resp.baga"
import "std/net/tcp.baga"
import "std/net/poll.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/time/time.baga"
import "std/bytes/bytes.baga"

// --- R46: CF-mode RESP (LSM_CF=1) — shared-WAL families + CF.* commands ---
// R49: CF.DROP name drops a whole family.

struct LsmCfExec {
    db: LsmCFDB,
    reply: bytes,
    quit: i64
}

// R68: bytes-key CF exec core — raw RESP args; CF names stay str (ASCII
// identifiers in the .cfs name map), keys go to lsm_cf_*_kb (NUL-safe).
fn lsm_exec_cf_kb(db: LsmCFDB, args: Vec<bytes>) -> LsmCfExec !IO !Time {
    let n = vec_len(args)
    if n < 1 {
        return LsmCfExec { db: db, reply: resp_error("ERR empty command"), quit: 0 }
    }
    let c0 = str_of_bytes(vec_get(args, 0))
    if lsm_eq_ci(c0, "PING") == 1 {
        return LsmCfExec { db: db, reply: resp_pong(), quit: 0 }
    }
    if lsm_eq_ci(c0, "QUIT") == 1 {
        return LsmCfExec { db: db, reply: resp_ok(), quit: 1 }
    }
    // CF.CREATE name
    if lsm_eq_ci(c0, "CF.CREATE") == 1 {
        if n != 2 {
            return LsmCfExec { db: db, reply: lsm_wrongnum("cf.create"), quit: 0 }
        }
        let cr = lsm_cf_create(db, str_of_bytes(vec_get(args, 1)))?
        db = cr.db
        if cr.id < 0 {
            return LsmCfExec { db: db, reply: resp_error("ERR cf create failed"), quit: 0 }
        }
        return LsmCfExec { db: db, reply: resp_int(cr.id), quit: 0 }
    }
    // CF.SET name key val  (auto-create CF)
    if lsm_eq_ci(c0, "CF.SET") == 1 {
        if n != 4 {
            return LsmCfExec { db: db, reply: lsm_wrongnum("cf.set"), quit: 0 }
        }
        let cr = lsm_cf_resolve(db, str_of_bytes(vec_get(args, 1)), 1)?
        db = cr.db
        if cr.id < 0 {
            return LsmCfExec { db: db, reply: resp_error("ERR bad cf name"), quit: 0 }
        }
        db = lsm_cf_put_kb(db, cr.id, vec_get(args, 2), vec_get(args, 3))?
        return LsmCfExec { db: db, reply: resp_ok(), quit: 0 }
    }
    // CF.GET name key
    if lsm_eq_ci(c0, "CF.GET") == 1 {
        if n != 3 {
            return LsmCfExec { db: db, reply: lsm_wrongnum("cf.get"), quit: 0 }
        }
        let id = lsm_cf_id_of(db, str_of_bytes(vec_get(args, 1)))
        if id < 0 {
            return LsmCfExec { db: db, reply: resp_null_bulk(), quit: 0 }
        }
        let g = lsm_cf_get_kb(db, id, vec_get(args, 2))?
        db = g.db
        if g.found == 0 {
            return LsmCfExec { db: db, reply: resp_null_bulk(), quit: 0 }
        }
        return LsmCfExec { db: db, reply: resp_bulk_b(g.val), quit: 0 }
    }
    // CF.DEL name key
    if lsm_eq_ci(c0, "CF.DEL") == 1 {
        if n != 3 {
            return LsmCfExec { db: db, reply: lsm_wrongnum("cf.del"), quit: 0 }
        }
        let id = lsm_cf_id_of(db, str_of_bytes(vec_get(args, 1)))
        if id < 0 {
            return LsmCfExec { db: db, reply: resp_int(0), quit: 0 }
        }
        let g = lsm_cf_get_kb(db, id, vec_get(args, 2))?
        db = g.db
        if g.found == 0 {
            return LsmCfExec { db: db, reply: resp_int(0), quit: 0 }
        }
        db = lsm_cf_del_kb(db, id, vec_get(args, 2))?
        return LsmCfExec { db: db, reply: resp_int(1), quit: 0 }
    }
    // CF.DROP name — drop whole family (R49)
    if lsm_eq_ci(c0, "CF.DROP") == 1 {
        if n != 2 {
            return LsmCfExec { db: db, reply: lsm_wrongnum("cf.drop"), quit: 0 }
        }
        let dr = lsm_cf_drop(db, str_of_bytes(vec_get(args, 1)))?
        db = dr.db
        if dr.rc < 0 {
            return LsmCfExec { db: db, reply: resp_error("ERR cannot drop default cf"), quit: 0 }
        }
        return LsmCfExec { db: db, reply: resp_int(dr.rc), quit: 0 }
    }
    // CF.SETOPT name flush_at|compact_at|cache_pages value
    // R61 flush/compact; R64 cache_pages. Single-key update (other opts kept).
    // 0 clears override (cache_pages: values < 16 clear).
    if lsm_eq_ci(c0, "CF.SETOPT") == 1 {
        if n != 4 {
            return LsmCfExec { db: db, reply: lsm_wrongnum("cf.setopt"), quit: 0 }
        }
        if lsm_is_int(str_of_bytes(vec_get(args, 3))) == 0 {
            return LsmCfExec {
                db: db, reply: resp_error("ERR value is not an integer or out of range"), quit: 0
            }
        }
        let v = parse_int(str_of_bytes(vec_get(args, 3)))
        let opt = str_of_bytes(vec_get(args, 2))
        // lsm_eq_ci expects an UPPERCASE literal for the second arg.
        let mut key = ""
        if lsm_eq_ci(opt, "FLUSH_AT") == 1 {
            key = "flush_at"
        } else {
            if lsm_eq_ci(opt, "COMPACT_AT") == 1 {
                key = "compact_at"
            } else {
                if lsm_eq_ci(opt, "CACHE_PAGES") == 1 || lsm_eq_ci(opt, "CACHE") == 1 {
                    key = "cache_pages"
                } else {
                    return LsmCfExec {
                        db: db,
                        reply: resp_error("ERR option must be flush_at, compact_at, or cache_pages"),
                        quit: 0
                    }
                }
            }
        }
        db = lsm_cf_setopt_one(db, str_of_bytes(vec_get(args, 1)), key, v)?
        if db.ok == 0 {
            return LsmCfExec { db: db, reply: resp_error("ERR no such cf or bad option"), quit: 0 }
        }
        return LsmCfExec { db: db, reply: resp_ok(), quit: 0 }
    }
    // CF.LIST → array of names
    if lsm_eq_ci(c0, "CF.LIST") == 1 {
        let names = lsm_cf_list(db)
        let mut r = resp_array(vec_len(names))
        let mut i: i64 = 0
        while i < vec_len(names) {
            r = bytes_concat(r, resp_bulk(vec_get(names, i)))
            i = i + 1
        }
        return LsmCfExec { db: db, reply: r, quit: 0 }
    }
    // Default CF 0: plain SET/GET/DEL for redis-cli familiarity
    if lsm_eq_ci(c0, "SET") == 1 && n == 3 {
        db = lsm_cf_put_kb(db, 0, vec_get(args, 1), vec_get(args, 2))?
        return LsmCfExec { db: db, reply: resp_ok(), quit: 0 }
    }
    if lsm_eq_ci(c0, "GET") == 1 && n == 2 {
        let g = lsm_cf_get_kb(db, 0, vec_get(args, 1))?
        db = g.db
        if g.found == 0 {
            return LsmCfExec { db: db, reply: resp_null_bulk(), quit: 0 }
        }
        return LsmCfExec { db: db, reply: resp_bulk_b(g.val), quit: 0 }
    }
    if lsm_eq_ci(c0, "DEL") == 1 && n >= 2 {
        // R69: multi-key DEL (Redis parity).
        let mut ndel: i64 = 0
        let mut di: i64 = 1
        while di < n {
            let k = vec_get(args, di)
            let g = lsm_cf_get_kb(db, 0, k)?
            db = g.db
            if g.found == 1 {
                db = lsm_cf_del_kb(db, 0, k)?
                ndel = ndel + 1
            }
            di = di + 1
        }
        return LsmCfExec { db: db, reply: resp_int(ndel), quit: 0 }
    }
    // R69: string/int parity on the default CF.
    if lsm_eq_ci(c0, "INCRBY") == 1 || lsm_eq_ci(c0, "DECRBY") == 1 {
        if n != 3 {
            return LsmCfExec { db: db, reply: lsm_wrongnum("incrby"), quit: 0 }
        }
        let d_s = str_of_bytes(vec_get(args, 2))
        if lsm_is_int(d_s) == 0 {
            return LsmCfExec {
                db: db, reply: resp_error("ERR value is not an integer or out of range"), quit: 0
            }
        }
        let k = vec_get(args, 1)
        let g = lsm_cf_get_kb(db, 0, k)?
        db = g.db
        let mut base: i64 = 0
        if g.found == 1 {
            let vs = str_of_bytes(g.val)
            if lsm_is_int(vs) == 0 {
                return LsmCfExec {
                    db: db, reply: resp_error("ERR value is not an integer or out of range"), quit: 0
                }
            }
            base = parse_int(vs)
        }
        let mut nv = base + parse_int(d_s)
        if lsm_eq_ci(c0, "DECRBY") == 1 {
            nv = base - parse_int(d_s)
        }
        db = lsm_cf_put_kb(db, 0, k, bytes_of_str(int_to_str(nv)))?
        return LsmCfExec { db: db, reply: resp_int(nv), quit: 0 }
    }
    if lsm_eq_ci(c0, "GETSET") == 1 && n == 3 {
        let k = vec_get(args, 1)
        let g = lsm_cf_get_kb(db, 0, k)?
        db = g.db
        db = lsm_cf_put_kb(db, 0, k, vec_get(args, 2))?
        if g.found == 0 {
            return LsmCfExec { db: db, reply: resp_null_bulk(), quit: 0 }
        }
        return LsmCfExec { db: db, reply: resp_bulk_b(g.val), quit: 0 }
    }
    if lsm_eq_ci(c0, "STRLEN") == 1 && n == 2 {
        let g = lsm_cf_get_kb(db, 0, vec_get(args, 1))?
        db = g.db
        let mut vl: i64 = 0
        if g.found == 1 {
            vl = bytes_len(g.val)
        }
        return LsmCfExec { db: db, reply: resp_int(vl), quit: 0 }
    }
    if lsm_eq_ci(c0, "GETDEL") == 1 && n == 2 {
        let k = vec_get(args, 1)
        let g = lsm_cf_get_kb(db, 0, k)?
        db = g.db
        if g.found == 0 {
            return LsmCfExec { db: db, reply: resp_null_bulk(), quit: 0 }
        }
        db = lsm_cf_del_kb(db, 0, k)?
        return LsmCfExec { db: db, reply: resp_bulk_b(g.val), quit: 0 }
    }
    if lsm_eq_ci(c0, "SETNX") == 1 && n == 3 {
        let k = vec_get(args, 1)
        let g = lsm_cf_get_kb(db, 0, k)?
        db = g.db
        if g.found == 1 {
            return LsmCfExec { db: db, reply: resp_int(0), quit: 0 }
        }
        db = lsm_cf_put_kb(db, 0, k, vec_get(args, 2))?
        return LsmCfExec { db: db, reply: resp_int(1), quit: 0 }
    }
    if lsm_eq_ci(c0, "UNLINK") == 1 && n >= 2 {
        let mut ndel: i64 = 0
        let mut di: i64 = 1
        while di < n {
            let k = vec_get(args, di)
            let g = lsm_cf_get_kb(db, 0, k)?
            db = g.db
            if g.found == 1 {
                db = lsm_cf_del_kb(db, 0, k)?
                ndel = ndel + 1
            }
            di = di + 1
        }
        return LsmCfExec { db: db, reply: resp_int(ndel), quit: 0 }
    }
    if lsm_eq_ci(c0, "SAVE") == 1 || lsm_eq_ci(c0, "BGSAVE") == 1 {
        // flush all open families
        let ks = map_keys(db.families)
        let mut i: i64 = 0
        while i < vec_len(ks) {
            db = lsm_cf_flush(db, vec_get(ks, i))?
            i = i + 1
        }
        return LsmCfExec { db: db, reply: resp_ok(), quit: 0 }
    }
    return LsmCfExec {
        db: db,
        reply: resp_error(concat(concat("ERR unknown command '", c0), "' (CF mode)")),
        quit: 0
    }
}

// R65/R68 wire entry: binary parse args → bytes-key CF core.
fn lsm_exec_cf_b(db: LsmCFDB, args: Vec<bytes>) -> LsmCfExec !IO !Time {
    return lsm_exec_cf_kb(db, args)?
}

// str-arg compat wrapper (tests / legacy callers) — args convert losslessly.
fn lsm_exec_cf(db: LsmCFDB, args: Vec<str>) -> LsmCfExec !IO !Time {
    return lsm_exec_cf_kb(db, lsm_args_bytes(args))?
}

struct LsmCfSrv {
    db: LsmCFDB,
    listener: i64,
    fds: Vec<i64>,
    bufs: Map<i64, bytes>,
    scratch: str
}

fn lsm_cf_srv_add(st: LsmCfSrv, fd: i64) -> LsmCfSrv !Net {
    tcp_set_nodelay(fd)?
    vec_push(st.fds, fd)
    map_set(st.bufs, fd, bytes_from_vec(vec_new()))
    return st
}

fn lsm_cf_srv_drop(st: LsmCfSrv, fd: i64) -> LsmCfSrv !Net !IO {
    tcp_close(fd)?
    map_del(st.bufs, fd)
    let nv: Vec<i64> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(st.fds) {
        if vec_get(st.fds, i) != fd {
            vec_push(nv, vec_get(st.fds, i))
        }
        i = i + 1
    }
    st.fds = nv
    return st
}

fn lsm_cf_on_readable(st: LsmCfSrv, fd: i64) -> LsmCfSrv !IO !Net !Time {
    let chunk = tcp_read_into(fd, st.scratch, 65536)?
    if bytes_len(chunk) == 0 {
        return lsm_cf_srv_drop(st, fd)?
    }
    let mut buf = map_get(st.bufs, fd)
    if bytes_len(buf) > 0 {
        let joined = bytes_concat(buf, chunk)
        drop(chunk)
        buf = joined
    } else {
        buf = chunk
    }
    let mut drop_me: i64 = 0
    let mut again: i64 = 1
    let mut out = bytes_new(0)
    let mut n_out: i64 = 0
    while again == 1 && drop_me == 0 {
        let p = resp_parse_command_b(buf)
        if p.ok == 0 {
            again = 0
        } else {
            let old = buf
            if p.consumed >= bytes_len(old) {
                buf = bytes_new(0)
            } else {
                buf = bytes_slice(old, p.consumed, bytes_len(old))
            }
            drop(old)
            let pargs = p.args
            let ex = lsm_exec_cf_b(st.db, pargs)?
            st.db = ex.db
            drop(pargs)
            let rep = ex.reply
            out = bytes_concat(out, rep)
            drop(rep)
            n_out = n_out + 1
            if ex.quit == 1 {
                drop_me = 1
            }
        }
    }
    if n_out > 0 {
        let w = tcp_write_bytes(fd, out)?
        drop(out)
        if w != 0 {
            drop_me = 1
        }
    }
    if drop_me == 1 {
        return lsm_cf_srv_drop(st, fd)?
    }
    map_set(st.bufs, fd, buf)
    return st
}

fn lsm_serve_cf_to(port: i64, timeout_s: i64) -> i64 !Net !IO !Time !Par {
    let mut dir = env("LSMPATH")?
    if dir == "" {
        dir = "/tmp/baga_lsm"
    }
    let mut flush_at: i64 = 256
    let fe = env("LSM_FLUSH_AT")?
    if fe != "" {
        flush_at = parse_int(fe)
    }
    let mut compact_at: i64 = 4
    let ce = env("LSM_COMPACT_AT")?
    if ce != "" {
        compact_at = parse_int(ce)
    }
    let mut db = lsm_cf_open(dir, flush_at, compact_at)?
    if db.ok == 0 {
        return 0 - 1
    }
    let se = env("LSM_SYNC_EVERY")?
    if se != "" {
        let sv = parse_int(se)
        if sv > 0 {
            db.sync_every = sv
        }
    }
    let listener = tcp_listen(port)?
    if listener < 0 {
        lsm_cf_close(db)?
        return 0 - 1
    }
    let mut st = LsmCfSrv {
        db: db, listener: listener, fds: vec_new(), bufs: map_new(),
        scratch: str_repeat(" ", 65536)
    }
    while true {
        let pollfds: Vec<i64> = vec_new()
        vec_push(pollfds, st.listener)
        let mut i: i64 = 0
        while i < vec_len(st.fds) {
            vec_push(pollfds, vec_get(st.fds, i))
            i = i + 1
        }
        let pr = poll_wait(pollfds, 200)?
        if pr.ok == 1 {
            if poll_has(pr.ready, st.listener) == 1 {
                let fd = tcp_accept(st.listener)?
                if fd >= 0 {
                    if timeout_s > 0 {
                        tcp_set_timeouts(fd, timeout_s)?
                    }
                    st = lsm_cf_srv_add(st, fd)?
                }
            }
            let snapshot: Vec<i64> = vec_new()
            let mut j: i64 = 0
            while j < vec_len(st.fds) {
                vec_push(snapshot, vec_get(st.fds, j))
                j = j + 1
            }
            let mut k: i64 = 0
            while k < vec_len(snapshot) {
                let fd = vec_get(snapshot, k)
                if poll_has(pr.ready, fd) == 1 {
                    st = lsm_cf_on_readable(st, fd)?
                }
                k = k + 1
            }
        }
    }
    return 0
}

// Default: poll multi-conn (R15). Dir/env same as before.
// LSM_SERIAL=1 → one-at-a-time accept.
// LSM_SHARDS=N → key-hash partition (R32).
// LSM_PARALLEL=1 → per-shard workers + RESP hop (R34).
// LSM_SERVE_MT=1 → go_bg per conn + shared shard workers (R45 multi-core).
// LSM_CF=1 → shared-WAL CF mode + CF.SET/GET/DEL/DROP (R46/R49).
