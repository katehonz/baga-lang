// server.baga — RESP2 front-end за rocksbaga (redis-cli compatible subset):
// помощници (upper/eq_ci/wrongnum/scan opts) + LsmExec — единичният
// shard изпълнител на команди (lsm_exec_kb). Serve режимите са в
// server_cluster / server_poll / server_par / server_mt* / server_cf;
// entry (serve_to / lsm_serve) — в server_entry.baga.

import "../db/engine.baga"
import "../db/engine_wal.baga"
import "../db/engine_ttl.baga"
import "../db/engine_keys.baga"
import "../db/engine_scan.baga"
import "../db/shard.baga"
import "../db/shard_read.baga"
import "../db/shard_ttl.baga"
import "../db/backup.baga"
import "../db/multidb.baga"
import "../db/cf.baga"
import "../db/cf_io.baga"
import "../db/workers.baga"
import "../db/workers_par.baga"
import "../db/workers_api.baga"
import "../cache/page.baga"
import "kvbaga/resp.baga"
import "std/net/tcp.baga"
import "std/net/poll.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/time/time.baga"
import "std/bytes/bytes.baga"

fn lsm_upper(s: str) -> str {
    let n = len(s)
    if n <= 0 {
        return s
    }
    let b = bytes_new(n)
    let mut i: i64 = 0
    while i < n {
        let mut c = char_at(s, i)
        if c >= 97 && c <= 122 {
            c = c - 32
        }
        bytes_set(b, i, c)
        i = i + 1
    }
    return str_of_bytes(b)
}

// R29: case-insensitive compare to an uppercase literal — no alloc.
fn lsm_eq_ci(s: str, upper: str) -> i64 {
    let n = len(s)
    if n != len(upper) {
        return 0
    }
    let mut i: i64 = 0
    while i < n {
        let mut c = char_at(s, i)
        if c >= 97 && c <= 122 {
            c = c - 32
        }
        if c != char_at(upper, i) {
            return 0
        }
        i = i + 1
    }
    return 1
}

fn lsm_wrongnum(cmd: str) -> bytes {
    return resp_error(concat(concat("ERR wrong number of arguments for '", cmd), "'"))
}

// R68: convert str args to bytes for the bytes-key dispatch cores
// (bytes_of_str is lossless — used by the str compat wrappers).
fn lsm_args_bytes(args: Vec<str>) -> Vec<bytes> {
    let out: Vec<bytes> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(args) {
        vec_push(out, bytes_of_str(vec_get(args, i)))
        i = i + 1
    }
    return out
}

// R43/R68: SCAN reply = [next_cursor, [k1, k2, …]] — keys as binary-safe bulks.
fn lsm_resp_scan_b(next: i64, keys: Vec<bytes>) -> bytes {
    let mut r = resp_array(2)
    r = bytes_concat(r, resp_bulk(int_to_str(next)))
    let n = vec_len(keys)
    r = bytes_concat(r, resp_array(n))
    let mut i: i64 = 0
    while i < n {
        r = bytes_concat(r, resp_bulk_b(vec_get(keys, i)))
        i = i + 1
    }
    return r
}

// Parse SCAN options after cursor: [MATCH pat] [COUNT n].
// R68: the MATCH pattern stays raw bytes (binary glob via lsm_match_glob_b);
// COUNT/cursor are ASCII and parse via str_of_bytes.
struct LsmScanOptsB {
    count: i64,
    match_pat: bytes,
    ok: i64
}

fn lsm_parse_scan_opts_b(args: Vec<bytes>, start: i64) -> LsmScanOptsB {
    let mut count: i64 = 10
    let mut match_pat = bytes_new(0)
    let bad = LsmScanOptsB { count: 10, match_pat: bytes_new(0), ok: 0 }
    let n = vec_len(args)
    let mut i = start
    while i < n {
        let a = str_of_bytes(vec_get(args, i))
        if lsm_eq_ci(a, "COUNT") == 1 {
            if i + 1 >= n || lsm_is_int(str_of_bytes(vec_get(args, i + 1))) == 0 {
                return bad
            }
            count = parse_int(str_of_bytes(vec_get(args, i + 1)))
            i = i + 2
        } else {
            if lsm_eq_ci(a, "MATCH") == 1 {
                if i + 1 >= n {
                    return bad
                }
                match_pat = vec_get(args, i + 1)
                i = i + 2
            } else {
                return bad
            }
        }
    }
    return LsmScanOptsB { count: count, match_pat: match_pat, ok: 1 }
}

fn lsm_is_int(s: str) -> i64 {
    if len(s) == 0 {
        return 0
    }
    let mut i: i64 = 0
    if char_at(s, 0) == 45 {
        if len(s) == 1 {
            return 0
        }
        i = 1
    }
    while i < len(s) {
        let c = char_at(s, i)
        if c < 48 || c > 57 {
            return 0
        }
        i = i + 1
    }
    return 1
}

struct LsmExec {
    db: LsmDB,
    reply: bytes,
    quit: i64
}

// Execute one RESP command. Mutates/returns db (flush may run).
// R29: command dispatch via lsm_eq_ci (no per-cmd uppercase alloc).
// R68: keys are raw RESP bytes end-to-end — every key arg goes to the
// engine _kb APIs without str conversion (NUL-safe); only command names,
// options and numbers parse via str_of_bytes (ASCII).
fn lsm_exec_kb(db: LsmDB, args: Vec<bytes>) -> LsmExec !IO !Time {
    let n = vec_len(args)
    if n < 1 {
        return LsmExec { db: db, reply: resp_error("ERR empty command"), quit: 0 }
    }
    let c0 = str_of_bytes(vec_get(args, 0))

    if lsm_eq_ci(c0, "PING") == 1 {
        return LsmExec { db: db, reply: resp_pong(), quit: 0 }
    }
    if lsm_eq_ci(c0, "QUIT") == 1 {
        return LsmExec { db: db, reply: resp_ok(), quit: 1 }
    }
    if lsm_eq_ci(c0, "SET") == 1 {
        if n < 3 {
            return LsmExec { db: db, reply: lsm_wrongnum("set"), quit: 0 }
        }
        // SET key val [EX seconds]
        if n == 5 {
            if lsm_eq_ci(str_of_bytes(vec_get(args, 3)), "EX") == 1 {
                let sec_s = str_of_bytes(vec_get(args, 4))
                if lsm_is_int(sec_s) == 0 {
                    return LsmExec {
                        db: db, reply: resp_error("ERR value is not an integer or out of range"), quit: 0
                    }
                }
                db = lsm_put_ex_kb(db, vec_get(args, 1), vec_get(args, 2), parse_int(sec_s))?
                return LsmExec { db: db, reply: resp_ok(), quit: 0 }
            }
            return LsmExec {
                db: db,
                reply: resp_error("ERR rocksbaga: SET options other than EX not supported"),
                quit: 0
            }
        }
        if n != 3 {
            return LsmExec {
                db: db,
                reply: resp_error("ERR rocksbaga: SET syntax"),
                quit: 0
            }
        }
        db = lsm_put_kb(db, vec_get(args, 1), vec_get(args, 2))?
        return LsmExec { db: db, reply: resp_ok(), quit: 0 }
    }
    if lsm_eq_ci(c0, "SETEX") == 1 {
        if n != 4 {
            return LsmExec { db: db, reply: lsm_wrongnum("setex"), quit: 0 }
        }
        let sec_s = str_of_bytes(vec_get(args, 2))
        if lsm_is_int(sec_s) == 0 {
            return LsmExec {
                db: db, reply: resp_error("ERR value is not an integer or out of range"), quit: 0
            }
        }
        db = lsm_put_ex_kb(db, vec_get(args, 1), vec_get(args, 3), parse_int(sec_s))?
        return LsmExec { db: db, reply: resp_ok(), quit: 0 }
    }
    if lsm_eq_ci(c0, "GET") == 1 {
        if n != 2 {
            return LsmExec { db: db, reply: lsm_wrongnum("get"), quit: 0 }
        }
        let g = lsm_get_kb(db, vec_get(args, 1))?
        db = g.db
        if g.found == 0 {
            return LsmExec { db: db, reply: resp_null_bulk(), quit: 0 }
        }
        return LsmExec { db: db, reply: resp_bulk_b(g.val), quit: 0 }
    }
    if lsm_eq_ci(c0, "DEL") == 1 {
        if n < 2 {
            return LsmExec { db: db, reply: lsm_wrongnum("del"), quit: 0 }
        }
        // R69: multi-key DEL (Redis parity).
        let mut cnt: i64 = 0
        let mut i: i64 = 1
        while i < n {
            let k = vec_get(args, i)
            let g = lsm_get_kb(db, k)?
            db = g.db
            if g.found == 1 {
                db = lsm_del_kb(db, k)?
                cnt = cnt + 1
            }
            i = i + 1
        }
        return LsmExec { db: db, reply: resp_int(cnt), quit: 0 }
    }
    if lsm_eq_ci(c0, "EXISTS") == 1 {
        if n != 2 {
            return LsmExec { db: db, reply: lsm_wrongnum("exists"), quit: 0 }
        }
        let g = lsm_exists_kb(db, vec_get(args, 1))?
        db = g.db
        return LsmExec { db: db, reply: resp_int(g.found), quit: 0 }
    }
    if lsm_eq_ci(c0, "INCR") == 1 {
        if n != 2 {
            return LsmExec { db: db, reply: lsm_wrongnum("incr"), quit: 0 }
        }
        let k = vec_get(args, 1)
        let g = lsm_get_kb(db, k)?
        db = g.db
        let mut base: i64 = 0
        if g.found == 1 {
            let vs = str_of_bytes(g.val)
            if lsm_is_int(vs) == 0 {
                return LsmExec {
                    db: db,
                    reply: resp_error("ERR value is not an integer or out of range"),
                    quit: 0
                }
            }
            base = parse_int(vs)
        }
        let nv = base + 1
        db = lsm_put_kb(db, k, bytes_of_str(int_to_str(nv)))?
        return LsmExec { db: db, reply: resp_int(nv), quit: 0 }
    }
    if lsm_eq_ci(c0, "APPEND") == 1 {
        if n != 3 {
            return LsmExec { db: db, reply: lsm_wrongnum("append"), quit: 0 }
        }
        // R65: binary-safe append (value may contain NUL).
        let k = vec_get(args, 1)
        let g = lsm_get_kb(db, k)?
        db = g.db
        let mut cur = bytes_new(0)
        if g.found == 1 {
            cur = g.val
        }
        let nv = bytes_concat(cur, vec_get(args, 2))
        let nlen = bytes_len(nv)
        db = lsm_put_kb(db, k, nv)?
        return LsmExec { db: db, reply: resp_int(nlen), quit: 0 }
    }
    if lsm_eq_ci(c0, "KEYS") == 1 {
        if n != 1 {
            return LsmExec { db: db, reply: lsm_wrongnum("keys"), quit: 0 }
        }
        // R68: keys reply with binary-safe bulks (raw key bytes).
        let kg = lsm_keys_kb(db)?
        db = kg.db
        let alive = kg.keys
        let mut r = resp_array(vec_len(alive))
        for i in 0..vec_len(alive) {
            r = bytes_concat(r, resp_bulk_b(vec_get(alive, i)))
        }
        return LsmExec { db: db, reply: r, quit: 0 }
    }
    if lsm_eq_ci(c0, "SCAN") == 1 {
        // R43: SCAN cursor [MATCH pat] [COUNT n]
        if n < 2 || lsm_is_int(str_of_bytes(vec_get(args, 1))) == 0 {
            return LsmExec { db: db, reply: lsm_wrongnum("scan"), quit: 0 }
        }
        let cursor = parse_int(str_of_bytes(vec_get(args, 1)))
        let opts = lsm_parse_scan_opts_b(args, 2)
        if opts.ok == 0 {
            return LsmExec {
                db: db, reply: resp_error("ERR syntax error"), quit: 0
            }
        }
        let sc = lsm_scan_kb(db, cursor, opts.count, opts.match_pat)?
        db = sc.db
        return LsmExec { db: db, reply: lsm_resp_scan_b(sc.next, sc.keys), quit: 0 }
    }
    if lsm_eq_ci(c0, "DBSIZE") == 1 {
        if n != 1 {
            return LsmExec { db: db, reply: lsm_wrongnum("dbsize"), quit: 0 }
        }
        // R31: count without sorting the key list.
        let ds = lsm_dbsize(db)?
        db = ds.db
        return LsmExec { db: db, reply: resp_int(ds.n), quit: 0 }
    }
    if lsm_eq_ci(c0, "SAVE") == 1 || lsm_eq_ci(c0, "BGSAVE") == 1 {
        // Forces memtable flush (durable snapshot of mem into SST).
        db = lsm_flush_force(db)?
        return LsmExec { db: db, reply: resp_ok(), quit: 0 }
    }
    if lsm_eq_ci(c0, "FLUSHDB") == 1 {
        // R42: wipe current single-store DB.
        db = lsm_flushdb(db)?
        return LsmExec { db: db, reply: resp_ok(), quit: 0 }
    }
    if lsm_eq_ci(c0, "FLUSHALL") == 1 {
        // Single LsmDB path: same as FLUSHDB.
        db = lsm_flushdb(db)?
        return LsmExec { db: db, reply: resp_ok(), quit: 0 }
    }
    if lsm_eq_ci(c0, "EXPIRE") == 1 {
        if n != 3 {
            return LsmExec { db: db, reply: lsm_wrongnum("expire"), quit: 0 }
        }
        let sec_s = str_of_bytes(vec_get(args, 2))
        if lsm_is_int(sec_s) == 0 {
            return LsmExec {
                db: db, reply: resp_error("ERR value is not an integer or out of range"), quit: 0
            }
        }
        let e = lsm_expire_kb(db, vec_get(args, 1), parse_int(sec_s))?
        db = e.db
        return LsmExec { db: db, reply: resp_int(e.ok), quit: 0 }
    }
    if lsm_eq_ci(c0, "TTL") == 1 {
        if n != 2 {
            return LsmExec { db: db, reply: lsm_wrongnum("ttl"), quit: 0 }
        }
        let t = lsm_ttl_kb(db, vec_get(args, 1))?
        db = t.db
        return LsmExec { db: db, reply: resp_int(t.n), quit: 0 }
    }
    if lsm_eq_ci(c0, "PERSIST") == 1 {
        if n != 2 {
            return LsmExec { db: db, reply: lsm_wrongnum("persist"), quit: 0 }
        }
        let p = lsm_persist_kb(db, vec_get(args, 1))?
        db = p.db
        return LsmExec { db: db, reply: resp_int(p.ok), quit: 0 }
    }
    // R69: INCRBY / DECRBY — INCR c delta.
    if lsm_eq_ci(c0, "INCRBY") == 1 || lsm_eq_ci(c0, "DECRBY") == 1 {
        if n != 3 {
            return LsmExec { db: db, reply: lsm_wrongnum("incrby"), quit: 0 }
        }
        let d_s = str_of_bytes(vec_get(args, 2))
        if lsm_is_int(d_s) == 0 {
            return LsmExec {
                db: db, reply: resp_error("ERR value is not an integer or out of range"), quit: 0
            }
        }
        let k = vec_get(args, 1)
        let g = lsm_get_kb(db, k)?
        db = g.db
        let mut base: i64 = 0
        if g.found == 1 {
            let vs = str_of_bytes(g.val)
            if lsm_is_int(vs) == 0 {
                return LsmExec {
                    db: db, reply: resp_error("ERR value is not an integer or out of range"), quit: 0
                }
            }
            base = parse_int(vs)
        }
        let mut nv = base + parse_int(d_s)
        if lsm_eq_ci(c0, "DECRBY") == 1 {
            nv = base - parse_int(d_s)
        }
        db = lsm_put_kb(db, k, bytes_of_str(int_to_str(nv)))?
        return LsmExec { db: db, reply: resp_int(nv), quit: 0 }
    }
    // R69: GETSET k v — set, reply old value (bulk or nil).
    if lsm_eq_ci(c0, "GETSET") == 1 {
        if n != 3 {
            return LsmExec { db: db, reply: lsm_wrongnum("getset"), quit: 0 }
        }
        let k = vec_get(args, 1)
        let g = lsm_get_kb(db, k)?
        db = g.db
        db = lsm_put_kb(db, k, vec_get(args, 2))?
        if g.found == 0 {
            return LsmExec { db: db, reply: resp_null_bulk(), quit: 0 }
        }
        return LsmExec { db: db, reply: resp_bulk_b(g.val), quit: 0 }
    }
    // R69: STRLEN k — byte length of the live value, 0 when missing.
    if lsm_eq_ci(c0, "STRLEN") == 1 {
        if n != 2 {
            return LsmExec { db: db, reply: lsm_wrongnum("strlen"), quit: 0 }
        }
        let g = lsm_get_kb(db, vec_get(args, 1))?
        db = g.db
        let mut vl: i64 = 0
        if g.found == 1 {
            vl = bytes_len(g.val)
        }
        return LsmExec { db: db, reply: resp_int(vl), quit: 0 }
    }
    // R69: GETDEL k — reply the value and delete it.
    if lsm_eq_ci(c0, "GETDEL") == 1 {
        if n != 2 {
            return LsmExec { db: db, reply: lsm_wrongnum("getdel"), quit: 0 }
        }
        let k = vec_get(args, 1)
        let g = lsm_get_kb(db, k)?
        db = g.db
        if g.found == 0 {
            return LsmExec { db: db, reply: resp_null_bulk(), quit: 0 }
        }
        db = lsm_del_kb(db, k)?
        return LsmExec { db: db, reply: resp_bulk_b(g.val), quit: 0 }
    }
    // R69: SETNX k v — set only when missing (:1 set, :0 existed).
    if lsm_eq_ci(c0, "SETNX") == 1 {
        if n != 3 {
            return LsmExec { db: db, reply: lsm_wrongnum("setnx"), quit: 0 }
        }
        let k = vec_get(args, 1)
        let g = lsm_exists_kb(db, k)?
        db = g.db
        if g.found == 1 {
            return LsmExec { db: db, reply: resp_int(0), quit: 0 }
        }
        db = lsm_put_kb(db, k, vec_get(args, 2))?
        return LsmExec { db: db, reply: resp_int(1), quit: 0 }
    }
    // R69: UNLINK k... — async-delete alias; here identical to DEL.
    if lsm_eq_ci(c0, "UNLINK") == 1 {
        if n < 2 {
            return LsmExec { db: db, reply: lsm_wrongnum("unlink"), quit: 0 }
        }
        let mut cnt: i64 = 0
        let mut i: i64 = 1
        while i < n {
            let k = vec_get(args, i)
            let g = lsm_get_kb(db, k)?
            db = g.db
            if g.found == 1 {
                db = lsm_del_kb(db, k)?
                cnt = cnt + 1
            }
            i = i + 1
        }
        return LsmExec { db: db, reply: resp_int(cnt), quit: 0 }
    }
    return LsmExec {
        db: db,
        reply: resp_error(concat(concat("ERR unknown command '", c0), "'")),
        quit: 0
    }
}

// str-arg compat wrapper (tests / legacy callers) — args convert losslessly
// (bytes_of_str); replies are built by the shared bytes-key core.
fn lsm_exec(db: LsmDB, args: Vec<str>) -> LsmExec !IO !Time {
    return lsm_exec_kb(db, lsm_args_bytes(args))?
}

// R65/R68 wire entry: binary parse args → bytes-key core.
fn lsm_exec_b(db: LsmDB, args: Vec<bytes>) -> LsmExec !IO !Time {
    return lsm_exec_kb(db, args)?
}

