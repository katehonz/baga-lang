// engine_keys.baga — live key map (mem + SST fold, R26/R31), KEYS,
// DBSIZE, glob MATCH (str + bytes, R68). Scan стъпките са в
// engine_scan.baga.

import "engine.baga"
import "../table/sstable.baga"
import "../table/sstable_scan.baga"
import "../util/codec.baga"
import "std/bytes/bytes.baga"
import "std/str/str.baga"
import "std/time/time.baga"

struct LsmGetKeys {
    db: LsmDB,
    keys: Vec<str>
}

// R67: bytes-key sibling of LsmGetKeys (internal fold result).

struct LsmGetKeysB {
    db: LsmDB,
    keys: Vec<bytes>
}


struct LsmDbSize {
    db: LsmDB,
    n: i64
}

// R67: build live key→raw map (mem + SST fold) keyed by raw bytes.
// Shared by KEYS / DBSIZE / SCAN (R31).

fn lsm_live_map_kb(db: LsmDB) -> LsmGetKeysB !IO !Time {
    let now = time_now_ms()?
    let seen: Map<bytes, bytes> = map_new()
    let dead: Map<bytes, i64> = map_new()
    let mut cur = db.cache
    for i in 0..vec_len(db.gens) {
        let gen = vec_get(db.gens, i)
        cur = sst_fold_into(cur, db.dir, gen, db.sst_fds, db.sst_sizes, seen, dead)?
    }
    db.cache = cur
    let mk = map_keys(db.mem)
    for i in 0..vec_len(mk) {
        let k = vec_get(mk, i)
        map_set(seen, k, map_get(db.mem, k))
        map_del(dead, k)
    }
    let tk = map_keys(db.tomb)
    for i in 0..vec_len(tk) {
        let k = vec_get(tk, i)
        map_del(seen, k)
        map_set(dead, k, 1)
    }
    // Drop expired (TTL) without sorting — caller decides order.
    let ks = map_keys(seen)
    let out: Vec<bytes> = vec_new()
    for i in 0..vec_len(ks) {
        let k = vec_get(ks, i)
        let u = ttl_unpack(map_get(seen, k))
        if ttl_expired(u.expire_at, now) == 0 {
            vec_push(out, k)
        }
    }
    drop(seen)
    drop(dead)
    return LsmGetKeysB { db: db, keys: out }
}

// K3i: live keys matching a raw byte prefix only (no full-shard map).
// SST: range skip + seek + early-stop; mem/tomb filtered by prefix.
// Empty prefix → same as full live_map.

fn lsm_live_map_prefix_kb(db: LsmDB, prefix: bytes) -> LsmGetKeysB !IO !Time {
    let np = bytes_len(prefix)
    if np <= 0 {
        return lsm_live_map_kb(db)?
    }
    let now = time_now_ms()?
    let seen: Map<bytes, bytes> = map_new()
    let dead: Map<bytes, i64> = map_new()
    let mut cur = db.cache
    for i in 0..vec_len(db.gens) {
        let gen = vec_get(db.gens, i)
        cur = sst_fold_prefix_into(cur, db.dir, gen, db.sst_fds, db.sst_sizes, seen, dead, prefix)?
    }
    db.cache = cur
    let mk = map_keys(db.mem)
    for i in 0..vec_len(mk) {
        let k = vec_get(mk, i)
        if lsm_bytes_has_prefix(k, prefix, np) == 1 {
            map_set(seen, k, map_get(db.mem, k))
            map_del(dead, k)
        }
    }
    let tk = map_keys(db.tomb)
    for i in 0..vec_len(tk) {
        let k = vec_get(tk, i)
        if lsm_bytes_has_prefix(k, prefix, np) == 1 {
            map_del(seen, k)
            map_set(dead, k, 1)
        }
    }
    let ks = map_keys(seen)
    let out: Vec<bytes> = vec_new()
    for i in 0..vec_len(ks) {
        let k = vec_get(ks, i)
        let u = ttl_unpack(map_get(seen, k))
        if ttl_expired(u.expire_at, now) == 0 {
            vec_push(out, k)
        }
    }
    drop(seen)
    drop(dead)
    return LsmGetKeysB { db: db, keys: out }
}

// Build live key list as str (mem + SST fold). R26: block scan fold.
// R67: keys live as bytes internally; converting to str here is LOSSY for
// keys with embedded NUL (str can't hold 0x00) — binary KEYS/MATCH is R68.

fn lsm_live_map(db: LsmDB) -> LsmGetKeys !IO !Time {
    let r = lsm_live_map_kb(db)?
    let out: Vec<str> = vec_new()
    for i in 0..vec_len(r.keys) {
        vec_push(out, str_of_bytes(vec_get(r.keys, i)))
    }
    return LsmGetKeys { db: r.db, keys: out }
}

// List live keys (mem + SST). R26: block scan fold. R31: shared live map + sort.

fn lsm_keys(db: LsmDB) -> LsmGetKeys !IO !Time {
    let r = lsm_live_map(db)?
    sort_strs(r.keys)
    return r
}

// R68: bytes-key KEYS core — raw live keys sorted via bytes_cmp (wire path).

fn lsm_keys_kb(db: LsmDB) -> LsmGetKeysB !IO !Time {
    let r = lsm_live_map_kb(db)?
    sort_bytes(r.keys)
    return r
}

// Live key count without sorting (RESP DBSIZE). Same semantics as KEYS length.

fn lsm_dbsize(db: LsmDB) -> LsmDbSize !IO !Time {
    let r = lsm_live_map_kb(db)?
    let n = vec_len(r.keys)
    return LsmDbSize { db: r.db, n: n }
}

// R43: simple glob for SCAN MATCH — supports *, prefix*, *suffix, *mid*, exact.
// Empty pattern or "*" matches all.

fn lsm_match_glob(pat: str, s: str) -> i64 {
    if pat == "" || pat == "*" {
        return 1
    }
    let np = len(pat)
    let ns = len(s)
    // find first '*'
    let mut star: i64 = 0 - 1
    let mut i: i64 = 0
    while i < np {
        if char_at(pat, i) == 42 {
            star = i
            i = np
        } else {
            i = i + 1
        }
    }
    if star < 0 {
        // exact
        if pat == s {
            return 1
        }
        return 0
    }
    // prefix before star
    let pre = substr(pat, 0, star)
    if str_starts_with(s, pre) == false {
        return 0
    }
    // suffix after star (only one * supported; rest is literal suffix)
    let suf = substr(pat, star + 1, np)
    if suf == "" {
        return 1
    }
    // if another * in suf, treat remaining as contains
    let mut star2: i64 = 0 - 1
    let mut j: i64 = 0
    while j < len(suf) {
        if char_at(suf, j) == 42 {
            star2 = j
            j = len(suf)
        } else {
            j = j + 1
        }
    }
    if star2 < 0 {
        if str_ends_with(s, suf) {
            return 1
        }
        return 0
    }
    // *a*b form: require contains middle between prefix and suffix
    let mid = substr(suf, 0, star2)
    let suf2 = substr(suf, star2 + 1, len(suf))
    if mid != "" {
        if str_find(s, mid) < 0 {
            return 0
        }
    }
    if suf2 != "" {
        if str_ends_with(s, suf2) == false {
            return 0
        }
    }
    return 1
}

// --- R68: bytes glob helpers (SCAN MATCH over raw key bytes) ---

// s starts with pat[0, n).

fn lsm_bytes_has_prefix(s: bytes, pat: bytes, n: i64) -> i64 {
    if bytes_len(s) < n {
        return 0
    }
    let mut i: i64 = 0
    while i < n {
        if bytes_at(s, i) != bytes_at(pat, i) {
            return 0
        }
        i = i + 1
    }
    return 1
}

// s ends with pat[poff, poff+n).

fn lsm_bytes_has_suffix(s: bytes, pat: bytes, poff: i64, n: i64) -> i64 {
    let ns = bytes_len(s)
    if ns < n {
        return 0
    }
    let base = ns - n
    let mut i: i64 = 0
    while i < n {
        if bytes_at(s, base + i) != bytes_at(pat, poff + i) {
            return 0
        }
        i = i + 1
    }
    return 1
}

// Index of pat[poff, poff+n) inside s, or -1.

fn lsm_bytes_find(s: bytes, pat: bytes, poff: i64, n: i64) -> i64 {
    let ns = bytes_len(s)
    if n <= 0 {
        return 0
    }
    let mut i: i64 = 0
    while i + n <= ns {
        let mut j: i64 = 0
        let mut same: i64 = 1
        while j < n && same == 1 {
            if bytes_at(s, i + j) != bytes_at(pat, poff + j) {
                same = 0
            }
            j = j + 1
        }
        if same == 1 {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// R68: bytes glob for SCAN MATCH — same grammar as lsm_match_glob
// (*, prefix*, *suffix, *mid*, exact) but NUL-safe over raw bytes.

fn lsm_match_glob_b(pat: bytes, s: bytes) -> i64 {
    let np = bytes_len(pat)
    if np == 0 {
        return 1
    }
    if np == 1 && bytes_at(pat, 0) == 42 {
        return 1
    }
    // find first '*'
    let mut star: i64 = 0 - 1
    let mut i: i64 = 0
    while i < np {
        if bytes_at(pat, i) == 42 {
            star = i
            i = np
        } else {
            i = i + 1
        }
    }
    if star < 0 {
        // exact
        if bytes_eq_b(pat, s) {
            return 1
        }
        return 0
    }
    // prefix before star
    if lsm_bytes_has_prefix(s, pat, star) == 0 {
        return 0
    }
    // suffix after star (only one * supported; rest is literal suffix)
    let nsuf = np - star - 1
    if nsuf == 0 {
        return 1
    }
    // if another * in suffix, treat remaining as contains
    let mut star2: i64 = 0 - 1
    let mut j: i64 = 0
    while j < nsuf {
        if bytes_at(pat, star + 1 + j) == 42 {
            star2 = j
            j = nsuf
        } else {
            j = j + 1
        }
    }
    if star2 < 0 {
        if lsm_bytes_has_suffix(s, pat, star + 1, nsuf) == 1 {
            return 1
        }
        return 0
    }
    // *a*b form: require contains middle between prefix and suffix
    if star2 > 0 {
        if lsm_bytes_find(s, pat, star + 1, star2) < 0 {
            return 0
        }
    }
    let nsuf2 = nsuf - star2 - 1
    if nsuf2 > 0 {
        if lsm_bytes_has_suffix(s, pat, star + 1 + star2 + 1, nsuf2) == 0 {
            return 0
        }
    }
    return 1
}

