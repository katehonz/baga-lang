// shard_read.baga — LsmCluster четене: get (str/bytes), flush_force,
// flushdb, keys, dbsize, streaming SCAN (match + prefix, с епохален кеш).
// Отварянето/писанията са в shard.baga; TTL — в shard_ttl.baga.

import "shard.baga"
import "engine.baga"
import "../cache/page.baga"
import "../util/codec.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"
import "std/os/os.baga"

struct LsmClusterGet {
    c: LsmCluster,
    found: i64,
    val: bytes
}

fn lsm_cluster_get(c: LsmCluster, key: str) -> LsmClusterGet !IO !Time {
    return lsm_cluster_get_kb(c, bytes_of_str(key))?
}

// R68: bytes-key get core.
fn lsm_cluster_get_kb(c: LsmCluster, key: bytes) -> LsmClusterGet !IO !Time {
    let i = lsm_shard_ix_b(c.n, key)
    let mut db = vec_get(c.shards, i)
    let g = lsm_get_kb(db, key)?
    db = g.db
    vec_set(c.shards, i, db)
    return LsmClusterGet { c: c, found: g.found, val: g.val }
}

fn lsm_cluster_flush_force(c: LsmCluster) -> LsmCluster !IO !Time {
    let mut i: i64 = 0
    while i < c.n {
        let mut db = vec_get(c.shards, i)
        db = lsm_flush_force(db)?
        vec_set(c.shards, i, db)
        if db.ok == 0 {
            c.ok = 0
        }
        i = i + 1
    }
    return c
}

// R42: wipe every shard path and reopen empty (Redis FLUSHDB).
fn lsm_cluster_flushdb(c: LsmCluster) -> LsmCluster !IO {
    let n = c.n
    let mut ok: i64 = 1
    let shards: Vec<LsmDB> = vec_new()
    let mut i: i64 = 0
    while i < n {
        let db = vec_get(c.shards, i)
        let ndb = lsm_flushdb(db)?
        if ndb.ok == 0 {
            ok = 0
        }
        vec_push(shards, ndb)
        i = i + 1
    }
    let sk: Vec<bytes> = vec_new()
    return LsmCluster {
        shards: shards, n: n,
        scan_epoch: 0 - 1, scan_pat: bytes_new(0), scan_keys: sk,
        ok: ok
    }
}

struct LsmClusterKeys {
    c: LsmCluster,
    keys: Vec<str>
}

// R68: bytes-key sibling of LsmClusterKeys (wire path).
struct LsmClusterKeysB {
    c: LsmCluster,
    keys: Vec<bytes>
}

// R68: bytes-key KEYS core — merge raw live keys from all shards (sorted).
fn lsm_cluster_keys_kb(c: LsmCluster) -> LsmClusterKeysB !IO !Time {
    let all: Vec<bytes> = vec_new()
    let mut i: i64 = 0
    while i < c.n {
        let mut db = vec_get(c.shards, i)
        let kr = lsm_keys_kb(db)?
        db = kr.db
        vec_set(c.shards, i, db)
        let mut j: i64 = 0
        while j < vec_len(kr.keys) {
            vec_push(all, vec_get(kr.keys, j))
            j = j + 1
        }
        i = i + 1
    }
    sort_bytes(all)
    return LsmClusterKeysB { c: c, keys: all }
}

// Merge KEYS from all shards (sorted). str wrapper — NUL keys truncate
// (use lsm_cluster_keys_kb on the wire path, R68).
fn lsm_cluster_keys(c: LsmCluster) -> LsmClusterKeys !IO !Time {
    let r = lsm_cluster_keys_kb(c)?
    let out: Vec<str> = vec_new()
    for i in 0..vec_len(r.keys) {
        vec_push(out, str_of_bytes(vec_get(r.keys, i)))
    }
    return LsmClusterKeys { c: r.c, keys: out }
}

struct LsmClusterSize {
    c: LsmCluster,
    n: i64
}

fn lsm_cluster_dbsize(c: LsmCluster) -> LsmClusterSize !IO !Time {
    let mut total: i64 = 0
    let mut i: i64 = 0
    while i < c.n {
        let mut db = vec_get(c.shards, i)
        let ds = lsm_dbsize(db)?
        db = ds.db
        vec_set(c.shards, i, db)
        total = total + ds.n
        i = i + 1
    }
    return LsmClusterSize { c: c, n: total }
}

struct LsmClusterScan {
    c: LsmCluster,
    next: i64,
    keys: Vec<str>
}

// R68: bytes-key sibling of LsmClusterScan (wire path).
struct LsmClusterScanB {
    c: LsmCluster,
    next: i64,
    keys: Vec<bytes>
}

// Sum of per-shard write_epochs — cluster SCAN cache key.
fn lsm_cluster_write_epoch(c: LsmCluster) -> i64 {
    let mut e: i64 = 0
    let mut i: i64 = 0
    while i < c.n {
        let db = vec_get(c.shards, i)
        e = e + db.write_epoch
        i = i + 1
    }
    return e
}

// R68: rebuild cluster SCAN snapshot from a raw-bytes MATCH pattern
// (unordered, MATCH-filtered over raw key bytes).
fn lsm_cluster_scan_rebuild_b(c: LsmCluster, match_pat: bytes) -> LsmCluster !IO !Time {
    // Gather live keys per shard without global sort (SCAN is unordered).
    let filtered: Vec<bytes> = vec_new()
    let mut i: i64 = 0
    while i < c.n {
        let mut db = vec_get(c.shards, i)
        let r = lsm_live_map_kb(db)?
        db = r.db
        vec_set(c.shards, i, db)
        let mut j: i64 = 0
        while j < vec_len(r.keys) {
            let k = vec_get(r.keys, j)
            if lsm_match_glob_b(match_pat, k) == 1 {
                vec_push(filtered, k)
            }
            j = j + 1
        }
        i = i + 1
    }
    if vec_len(c.scan_keys) > 0 {
        let old = c.scan_keys
        c.scan_keys = filtered
        drop(old)
    } else {
        c.scan_keys = filtered
    }
    c.scan_pat = match_pat
    c.scan_epoch = lsm_cluster_write_epoch(c)
    return c
}

// True byte-prefix rebuild (no glob) — boilaDB K2.
// Sorted for secondary index range seek (boilaDB K3h).
// K3i: per-shard prefix fold (no full live_map + post-filter).
fn lsm_cluster_scan_rebuild_prefix_b(c: LsmCluster, prefix: bytes) -> LsmCluster !IO !Time {
    let filtered: Vec<bytes> = vec_new()
    let mut i: i64 = 0
    while i < c.n {
        let mut db = vec_get(c.shards, i)
        let r = lsm_live_map_prefix_kb(db, prefix)?
        db = r.db
        vec_set(c.shards, i, db)
        let mut j: i64 = 0
        while j < vec_len(r.keys) {
            vec_push(filtered, vec_get(r.keys, j))
            j = j + 1
        }
        i = i + 1
    }
    sort_bytes(filtered)
    if vec_len(c.scan_keys) > 0 {
        let old = c.scan_keys
        c.scan_keys = filtered
        drop(old)
    } else {
        c.scan_keys = filtered
    }
    let mut tag = bytes_new(1)
    bytes_set(tag, 0, 1)
    c.scan_pat = bytes_concat(tag, prefix)
    c.scan_epoch = lsm_cluster_write_epoch(c)
    return c
}

fn lsm_cluster_scan_prefix_kb(c: LsmCluster, cursor: i64, count: i64, prefix: bytes) -> LsmClusterScanB !IO !Time {
    let mut tag = bytes_new(1)
    bytes_set(tag, 0, 1)
    let pat = bytes_concat(tag, prefix)
    let epoch = lsm_cluster_write_epoch(c)
    if c.scan_epoch != epoch || bytes_eq_b(c.scan_pat, pat) == false {
        c = lsm_cluster_scan_rebuild_prefix_b(c, prefix)?
    }
    let n = vec_len(c.scan_keys)
    let mut cur = cursor
    if cur < 0 { cur = 0 }
    if cur > n { cur = n }
    let mut cnt = count
    if cnt < 1 { cnt = 10 }
    if cnt > 1000 { cnt = 1000 }
    let out: Vec<bytes> = vec_new()
    let mut j = cur
    let mut taken: i64 = 0
    while j < n && taken < cnt {
        vec_push(out, vec_get(c.scan_keys, j))
        j = j + 1
        taken = taken + 1
    }
    // Keep sorted prefix cache (K3h seek / warm reuse); invalidated on write or pat change.
    let mut next: i64 = j
    if next >= n {
        next = 0
    }
    return LsmClusterScanB { c: c, next: next, keys: out }
}

// Full sorted prefix snapshot (one live fold; cache kept). boilaDB K3h.
fn lsm_cluster_scan_prefix_all_kb(c: LsmCluster, prefix: bytes) -> LsmClusterScanB !IO !Time {
    let mut tag = bytes_new(1)
    bytes_set(tag, 0, 1)
    let pat = bytes_concat(tag, prefix)
    let epoch = lsm_cluster_write_epoch(c)
    if c.scan_epoch != epoch || bytes_eq_b(c.scan_pat, pat) == false {
        c = lsm_cluster_scan_rebuild_prefix_b(c, prefix)?
    }
    let out: Vec<bytes> = vec_new()
    let mut j: i64 = 0
    while j < vec_len(c.scan_keys) {
        vec_push(out, vec_get(c.scan_keys, j))
        j = j + 1
    }
    return LsmClusterScanB { c: c, next: 0, keys: out }
}

// R68: bytes-key SCAN core over merged live keys of all shards.
// R63: one live fold per write-epoch×MATCH; subsequent pages are O(count).
fn lsm_cluster_scan_kb(c: LsmCluster, cursor: i64, count: i64, match_pat: bytes) -> LsmClusterScanB !IO !Time {
    let epoch = lsm_cluster_write_epoch(c)
    if c.scan_epoch != epoch || bytes_eq_b(c.scan_pat, match_pat) == false {
        c = lsm_cluster_scan_rebuild_b(c, match_pat)?
    }
    let n = vec_len(c.scan_keys)
    let mut cur = cursor
    if cur < 0 {
        cur = 0
    }
    if cur > n {
        cur = n
    }
    let mut cnt = count
    if cnt < 1 {
        cnt = 10
    }
    if cnt > 1000 {
        cnt = 1000
    }
    let out: Vec<bytes> = vec_new()
    let mut j = cur
    let mut taken: i64 = 0
    while j < n && taken < cnt {
        vec_push(out, vec_get(c.scan_keys, j))
        j = j + 1
        taken = taken + 1
    }
    let mut next: i64 = j
    if next >= n {
        next = 0
        if vec_len(c.scan_keys) > 0 {
            let old = c.scan_keys
            c.scan_keys = vec_new()
            drop(old)
        }
        c.scan_epoch = 0 - 1
        c.scan_pat = bytes_new(0)
    }
    return LsmClusterScanB { c: c, next: next, keys: out }
}

// str-keyed compat wrapper (NUL keys truncate in the result — R68 wire path
// uses lsm_cluster_scan_kb).
fn lsm_cluster_scan(c: LsmCluster, cursor: i64, count: i64, match_pat: str) -> LsmClusterScan !IO !Time {
    let r = lsm_cluster_scan_kb(c, cursor, count, bytes_of_str(match_pat))?
    let out: Vec<str> = vec_new()
    for i in 0..vec_len(r.keys) {
        vec_push(out, str_of_bytes(vec_get(r.keys, i)))
    }
    return LsmClusterScan { c: r.c, next: r.next, keys: out }
}

