// engine.baga — open/put/get/flush/recovery (orchestration).
// Compaction: compact.baga. Types: types.baga.

import "types.baga"
import "compact.baga"
import "../util/codec.baga"
import "../cache/page.baga"
import "../wal/wal.baga"
import "../table/sstable.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn lsm_wal_path(dir: str) -> str {
    return concat(dir, ".wal")
}


fn lsm_empty_db(dir: str) -> LsmDB {
    let gens: Vec<i64> = vec_new()
    let levels: Vec<i64> = vec_new()
    // Default page cache: 256 × 4 KiB ≈ 1 MiB (R11; was 32 pages).
    return LsmDB {
        dir: dir, mem: map_new(), tomb: map_new(), mem_n: 0,
        flush_at: 32, compact_at: 3, target_bytes: 0, merge_pick: 0,
        wal_fd: -1, wal_off: 0,
        gens: gens, levels: levels, next_gen: 1, cache: pc_new(4096, 256),
        blooms: bloom_cache_new(),
        sst_fds: map_new(), sst_sizes: map_new(),
        sync_every: 1, since_sync: 0, ok: 1
    }
}

fn lsm_read_manifest(dir: str) -> LsmDB !IO {
    let gens: Vec<i64> = vec_new()
    let levels: Vec<i64> = vec_new()
    let body = read_file(lsm_manifest_path(dir))?
    if body == "" {
        return lsm_empty_db(dir)
    }
    let lines = str_split(body, "\n")
    let mut next_gen: i64 = 1
    if vec_len(lines) > 0 && vec_get(lines, 0) != "" {
        next_gen = parse_int(vec_get(lines, 0))
        if next_gen < 1 {
            next_gen = 1
        }
    }
    for i in 1..vec_len(lines) {
        let ln = vec_get(lines, i)
        if ln != "" {
            // "gen level" or legacy "gen"
            let parts = str_split(ln, " ")
            let g = parse_int(vec_get(parts, 0))
            if g > 0 {
                vec_push(gens, g)
                let mut lv: i64 = 0
                if vec_len(parts) >= 2 {
                    lv = parse_int(vec_get(parts, 1))
                    if lv < 0 {
                        lv = 0
                    }
                    if lv > 3 {
                        lv = 3
                    }
                }
                vec_push(levels, lv)
            }
        }
    }
    return LsmDB {
        dir: dir, mem: map_new(), tomb: map_new(), mem_n: 0,
        flush_at: 32, compact_at: 3, target_bytes: 0, merge_pick: 0,
        wal_fd: -1, wal_off: 0,
        gens: gens, levels: levels, next_gen: next_gen, cache: pc_new(4096, 256),
        blooms: bloom_cache_new(),
        sst_fds: map_new(), sst_sizes: map_new(),
        sync_every: 1, since_sync: 0, ok: 1
    }
}

fn lsm_open(dir: str, flush_at: i64, compact_at: i64) -> LsmDB !IO {
    let mut db = lsm_read_manifest(dir)?
    db.dir = dir
    if flush_at > 0 {
        db.flush_at = flush_at
    }
    if compact_at > 0 {
        db.compact_at = compact_at
    }
    let wfd = open(lsm_wal_path(dir), 66, 420)?
    if wfd < 0 {
        db.ok = 0
        return db
    }
    db.wal_fd = wfd
    let rp = wal_replay(wfd)?
    db.wal_off = rp.end_off
    for i in 0..vec_len(rp.ops) {
        let op = vec_get(rp.ops, i)
        let k = vec_get(rp.keys, i)
        let v = vec_get(rp.vals, i)
        if op == 1 {
            map_set(db.mem, k, v)
            map_del(db.tomb, k)
        } else {
            map_del(db.mem, k)
            map_set(db.tomb, k, 1)
        }
        db.mem_n = db.mem_n + 1
    }
    db.ok = 1
    return db
}

fn lsm_close(db: LsmDB) -> i64 !IO {
    if db.wal_fd >= 0 {
        fdatasync(db.wal_fd)?
        close(db.wal_fd)
    }
    // Maps are shared — close cached SST fds without return-updated dance.
    let ks = map_keys(db.sst_fds)
    for i in 0..vec_len(ks) {
        let g = vec_get(ks, i)
        let fd = map_get(db.sst_fds, g)
        if fd >= 0 {
            close(fd)
        }
        map_del(db.sst_fds, g)
        map_del(db.sst_sizes, g)
    }
    return 0
}

fn lsm_maybe_sync(db: LsmDB) -> LsmDB !IO {
    db.since_sync = db.since_sync + 1
    if db.since_sync >= db.sync_every {
        fdatasync(db.wal_fd)?
        db.since_sync = 0
    }
    return db
}

fn lsm_put_b(db: LsmDB, key: str, val: bytes) -> LsmDB !IO {
    let off = wal_append(db.wal_fd, db.wal_off, 1, key, val)?
    if off < 0 {
        db.ok = 0
        return db
    }
    db.wal_off = off
    map_set(db.mem, key, val)
    map_del(db.tomb, key)
    db.mem_n = db.mem_n + 1
    db = lsm_maybe_sync(db)?
    if db.mem_n >= db.flush_at {
        db = lsm_flush(db)?
    }
    return db
}

fn lsm_put(db: LsmDB, key: str, val: str) -> LsmDB !IO {
    return lsm_put_b(db, key, bytes_of_str(val))?
}

fn lsm_del(db: LsmDB, key: str) -> LsmDB !IO {
    let off = wal_append(db.wal_fd, db.wal_off, 2, key, bytes_new(0))?
    if off < 0 {
        db.ok = 0
        return db
    }
    db.wal_off = off
    map_del(db.mem, key)
    map_set(db.tomb, key, 1)
    db.mem_n = db.mem_n + 1
    db = lsm_maybe_sync(db)?
    if db.mem_n >= db.flush_at {
        db = lsm_flush(db)?
    }
    return db
}

struct LsmGet {
    db: LsmDB,
    found: i64,
    val: bytes
}

fn lsm_get(db: LsmDB, key: str) -> LsmGet !IO {
    if map_has(db.tomb, key) == 1 {
        return LsmGet { db: db, found: 0, val: bytes_new(0) }
    }
    if map_has(db.mem, key) == 1 {
        return LsmGet { db: db, found: 1, val: map_get(db.mem, key) }
    }
    let lk = sst_get(db.cache, db.blooms, db.sst_fds, db.sst_sizes, db.dir, db.gens, key)?
    db.cache = lk.pc
    db.blooms = lk.blooms
    db.sst_fds = lk.sst_fds
    db.sst_sizes = lk.sst_sizes
    if lk.found == 1 {
        if lk.alive == 1 {
            return LsmGet { db: db, found: 1, val: lk.val }
        }
        return LsmGet { db: db, found: 0, val: bytes_new(0) }
    }
    return LsmGet { db: db, found: 0, val: bytes_new(0) }
}

fn lsm_exists(db: LsmDB, key: str) -> LsmGet !IO {
    return lsm_get(db, key)?
}

fn lsm_flush(db: LsmDB) -> LsmDB !IO {
    let mk = map_keys(db.mem)
    let tk = map_keys(db.tomb)
    let all: Vec<str> = vec_new()
    for i in 0..vec_len(mk) {
        vec_push(all, vec_get(mk, i))
    }
    for i in 0..vec_len(tk) {
        let k = vec_get(tk, i)
        if map_has(db.mem, k) == 0 {
            vec_push(all, k)
        }
    }
    sort_strs(all)
    let rows: Vec<SstRow> = vec_new()
    for i in 0..vec_len(all) {
        let k = vec_get(all, i)
        if map_has(db.tomb, k) == 1 && map_has(db.mem, k) == 0 {
            vec_push(rows, SstRow { op: 2, key: k, val: bytes_new(0) })
        } else {
            vec_push(rows, SstRow { op: 1, key: k, val: map_get(db.mem, k) })
        }
    }
    let gen = db.next_gen
    if vec_len(rows) > 0 {
        if sst_write(db.dir, gen, rows)? != 0 {
            db.ok = 0
            return db
        }
        vec_push(db.gens, gen)
        vec_push(db.levels, 0)   // L0
        db.next_gen = gen + 1
    }
    if lsm_write_manifest(db.dir, db.next_gen, db.gens, db.levels)? != 0 {
        db.ok = 0
        return db
    }
    close(db.wal_fd)
    unlink(lsm_wal_path(db.dir))?
    let wfd = open(lsm_wal_path(db.dir), 578, 420)?
    if wfd < 0 {
        db.ok = 0
        return db
    }
    db.wal_fd = wfd
    db.wal_off = 0
    db.mem = map_new()
    db.tomb = map_new()
    db.mem_n = 0
    db.since_sync = 0
    // L0..L3 compaction (chain while any level is over file or byte threshold)
    let mut guard: i64 = 0
    let mut more: i64 = 1
    while more == 1 && guard < 32 {
        let n0 = lsm_count_level(db.levels, 0)
        let n1 = lsm_count_level(db.levels, 1)
        let n2 = lsm_count_level(db.levels, 2)
        let n3 = lsm_count_level(db.levels, 3)
        let b0 = lsm_level_bytes(db, 0)?
        let b1 = lsm_level_bytes(db, 1)?
        let b2 = lsm_level_bytes(db, 2)?
        let b3 = lsm_level_bytes(db, 3)?
        let over0 = lsm_level_over(db, 0, n0, b0)
        let over1 = lsm_level_over(db, 1, n1, b1)
        let over2 = lsm_level_over(db, 2, n2, b2)
        let over3 = lsm_level_over(db, 3, n3, b3)
        // File-count legacy: pair collapse L1/L2/L3 when byte targets off
        let mut pair: i64 = 0
        if db.target_bytes <= 0 {
            if n1 >= 2 || n2 >= 2 || n3 >= 2 {
                pair = 1
            }
        }
        if over0 == 1 || over1 == 1 || over2 == 1 || over3 == 1 || pair == 1 {
            db = lsm_compact(db)?
            guard = guard + 1
        } else {
            more = 0
        }
    }
    return db
}

fn lsm_flush_force(db: LsmDB) -> LsmDB !IO {
    if db.mem_n == 0 {
        return db
    }
    return lsm_flush(db)?
}

struct LsmGetKeys {
    db: LsmDB,
    keys: Vec<str>
}

fn lsm_keys(db: LsmDB) -> LsmGetKeys !IO {
    let seen: Map<str, i64> = map_new()
    let mut cur = db.cache
    for i in 0..vec_len(db.gens) {
        let gen = vec_get(db.gens, i)
        let ld = sst_load(cur, db.dir, gen)?
        cur = ld.pc
        if ld.parse.ok == 1 {
            for j in 0..vec_len(ld.parse.rows) {
                let r = vec_get(ld.parse.rows, j)
                if r.op == 2 {
                    map_del(seen, r.key)
                } else {
                    map_set(seen, r.key, 1)
                }
            }
        }
    }
    db.cache = cur
    let mk = map_keys(db.mem)
    for i in 0..vec_len(mk) {
        map_set(seen, vec_get(mk, i), 1)
    }
    let tk = map_keys(db.tomb)
    for i in 0..vec_len(tk) {
        map_del(seen, vec_get(tk, i))
    }
    let out = map_keys(seen)
    sort_strs(out)
    return LsmGetKeys { db: db, keys: out }
}
