// engine.baga — open/put/get/flush/recovery (orchestration).
// Compaction: compact.baga. Types: types.baga. Manifest: manifest.baga.
// R67: engine core holds keys as raw bytes end-to-end (Map<bytes, …>, WAL
// record/replay, SST rows). Every public str-keyed API (lsm_put, lsm_get, …)
// is unchanged — a thin wrapper doing bytes_of_str(key) into the *_kb core.
// On-disk formats are unchanged (WAL/SST records were already
// length-prefixed, so they were binary-safe all along).

import "types.baga"
import "manifest.baga"
import "compact.baga"
import "../util/codec.baga"
import "../util/ttl.baga"
import "../cache/page.baga"
import "../wal/wal.baga"
import "../table/sstable.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/time/time.baga"

fn lsm_wal_path(dir: str) -> str {
    return concat(dir, ".wal")
}


fn lsm_empty_db(dir: str) -> LsmDB {
    let gens: Vec<i64> = vec_new()
    let levels: Vec<i64> = vec_new()
    // R25: default page cache 2048 × 4 KiB ≈ 8 MiB (was R11 256×4 KiB = 1 MiB).
    // Random GET at n≥10k thrashed the 1 MiB pool (~27% of RocksDB at n=20k).
    let sk: Vec<bytes> = vec_new()
    return LsmDB {
        dir: dir, mem: map_new(), tomb: map_new(), mem_n: 0,
        flush_at: 32, compact_at: 3, target_bytes: 0, merge_pick: 0,
        wal_fd: -1, wal_off: 0,
        wal_buf: bytes_new(0), wal_buf_max: 65536, wal_buf_len: 0,
        gens: gens, levels: levels, next_gen: 1, cache: pc_new(4096, 2048),
        blooms: bloom_cache_new(),
        sst_fds: map_new(), sst_sizes: map_new(), sst_meta: map_new(),
        hot_gen: 0 - 1, hot_off: 0 - 1, hot_n: 0, hot_data: bytes_new(0),
        sync_every: 1, since_sync: 0, manifest_edits: 0,
        write_epoch: 0, scan_epoch: 0 - 1, scan_pat: bytes_new(0), scan_keys: sk,
        ok: 1
    }
}

// Build LsmDB skeleton from on-disk MANIFEST (R26 via manifest.baga).
// R40: snapshot + edit log replay.
fn lsm_read_manifest(dir: str) -> LsmDB !IO {
    let m = lsm_load_manifest(dir)?
    if vec_len(m.gens) == 0 && m.next_gen == 1 {
        // Empty / missing file — same as fresh DB (WAL may still exist).
        let body = read_file(lsm_manifest_path(dir))?
        let logb = read_file(lsm_manifest_log_path(dir))?
        if body == "" && logb == "" {
            return lsm_empty_db(dir)
        }
    }
    // Count pending log lines so compact threshold still works after reopen.
    let edits = lsm_manifest_log_lines(dir)?
    let sk: Vec<bytes> = vec_new()
    return LsmDB {
        dir: dir, mem: map_new(), tomb: map_new(), mem_n: 0,
        flush_at: 32, compact_at: 3, target_bytes: 0, merge_pick: 0,
        wal_fd: -1, wal_off: 0,
        wal_buf: bytes_new(0), wal_buf_max: 65536, wal_buf_len: 0,
        gens: m.gens, levels: m.levels, next_gen: m.next_gen,
        cache: pc_new(4096, 2048),
        blooms: bloom_cache_new(),
        sst_fds: map_new(), sst_sizes: map_new(), sst_meta: map_new(),
        hot_gen: 0 - 1, hot_off: 0 - 1, hot_n: 0, hot_data: bytes_new(0),
        sync_every: 1, since_sync: 0, manifest_edits: edits,
        write_epoch: 0, scan_epoch: 0 - 1, scan_pat: bytes_new(0), scan_keys: sk,
        ok: 1
    }
}

fn lsm_open(dir: str, flush_at: i64, compact_at: i64) -> LsmDB !IO {
    let mut db = lsm_read_manifest(dir)?
    db.dir = dir
    if flush_at > 0 {
        db.flush_at = flush_at
    }
    if compact_at > 0 {
        db.compact_at = compact_at
    }
    let wfd = open(lsm_wal_path(dir), 66, 420)?
    if wfd < 0 {
        db.ok = 0
        return db
    }
    db.wal_fd = wfd
    let rp = wal_replay(wfd)?
    db.wal_off = rp.end_off
    for i in 0..vec_len(rp.ops) {
        // R44: single-store open only applies CF 0 / legacy records.
        let mut cf: i64 = 0
        if i < vec_len(rp.cfs) {
            cf = vec_get(rp.cfs, i)
        }
        if cf == 0 {
            let op = vec_get(rp.ops, i)
            let k = vec_get(rp.keys, i)   // R67: bytes key straight off the wire
            let v = vec_get(rp.vals, i)
            if op == 1 {
                map_set(db.mem, k, v)
                map_del(db.tomb, k)
            } else {
                map_del(db.mem, k)
                map_set(db.tomb, k, 1)
            }
            db.mem_n = db.mem_n + 1
        }
    }
    db.ok = 1
    return db
}

// Flush pending WAL buffer to the fd (no fdatasync).
fn lsm_wal_flush_buf(db: LsmDB) -> LsmDB !IO {
    if db.wal_buf_len <= 0 {
        return db
    }
    let view = bytes_slice(db.wal_buf, 0, db.wal_buf_len)
    if fd_pwrite_bytes(db.wal_fd, view, db.wal_off) != 0 {
        db.ok = 0
        return db
    }
    drop(view)
    db.wal_off = db.wal_off + db.wal_buf_len
    db.wal_buf_len = 0  // buffer stays allocated, reused next window
    return db
}

fn lsm_close(db: LsmDB) -> i64 !IO {
    let mut d = db
    // R40: fold edit log into atomic snapshot on close (clean on-disk form).
    if d.manifest_edits > 0 {
        if lsm_write_manifest(d.dir, d.next_gen, d.gens, d.levels)? != 0 {
            // still try to close WAL below
        } else {
            d.manifest_edits = 0
        }
    }
    if d.wal_fd >= 0 {
        d = lsm_wal_flush_buf(d)?
        fdatasync(d.wal_fd)?
        close(d.wal_fd)
    }
    // Maps are shared — close cached SST fds without return-updated dance.
    // R19: unregister each gen from the page-cache fd registry.
    let ks = map_keys(d.sst_fds)
    for i in 0..vec_len(ks) {
        let g = vec_get(ks, i)
        let fd = map_get(d.sst_fds, g)
        if fd >= 0 {
            close(fd)
        }
        map_del(d.sst_fds, g)
        map_del(d.sst_sizes, g)
        pc_unregister_file(d.cache, g)
    }
    return 0
}

// R42: delete all durable files for one store path (after close).
// WAL, MANIFEST(+log/tmp), SST/bloom gens 1..512.
fn lsm_path_wipe(path: str) -> i64 !IO {
    unlink(concat(path, ".wal"))?
    unlink(concat(path, ".manifest"))?
    unlink(concat(path, ".manifest.log"))?
    unlink(concat(path, ".manifest.tmp"))?
    let mut g: i64 = 1
    while g <= 512 {
        unlink(concat(concat(path, ".sst."), int_to_str(g)))?
        unlink(concat(concat(path, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

// R42: close, wipe files, reopen empty store (preserves path + knobs).
fn lsm_flushdb(db: LsmDB) -> LsmDB !IO {
    let path = db.dir
    let flush_at = db.flush_at
    let compact_at = db.compact_at
    let sync_every = db.sync_every
    let target_bytes = db.target_bytes
    let merge_pick = db.merge_pick
    lsm_close(db)?
    lsm_path_wipe(path)?
    let mut ndb = lsm_open(path, flush_at, compact_at)?
    if sync_every > 0 {
        ndb.sync_every = sync_every
    }
    ndb.target_bytes = target_bytes
    ndb.merge_pick = merge_pick
    return ndb
}

// R58: binary file copy (1 MiB chunks; O_RDONLY → O_CREAT|O_TRUNC).
fn lsm_copy_file(src: str, dst: str) -> i64 !IO {
    let fd = open(src, 0, 0)?
    if fd < 0 {
        return 0 - 1
    }
    let sz = fd_size(fd)?
    let out = open(dst, 578, 420)?
    if out < 0 {
        close(fd)
        return 0 - 1
    }
    let mut off: i64 = 0
    while off < sz {
        let chunk = fd_pread_bytes(fd, 1048576, off)?
        let n = bytes_len(chunk)
        if n == 0 {
            off = sz
        } else {
            fd_write_bytes(out, chunk)?
            drop(chunk)
            off = off + n
        }
    }
    close(fd)
    close(out)
    return 0
}

// R58: RocksDB-style checkpoint — durable point-in-time copy of the store
// at `dest`. Flushes the memtable first (WAL rotates empty), then copies
// every live SST + bloom sidecar and writes a fresh MANIFEST. The source
// store stays usable (in MT mode call under the shard mutex). Recovery
// path for the copy is the ordinary lsm_open(dest).
fn lsm_checkpoint(db: LsmDB, dest: str) -> LsmDB !IO !Time {
    db = lsm_flush_force(db)?
    if db.ok == 0 {
        return db
    }
    let mut i: i64 = 0
    while i < vec_len(db.gens) {
        let g = vec_get(db.gens, i)
        let gs = int_to_str(g)
        if lsm_copy_file(concat(concat(db.dir, ".sst."), gs), concat(concat(dest, ".sst."), gs))? != 0 {
            db.ok = 0
            return db
        }
        let bl_src = concat(concat(db.dir, ".bloom."), gs)
        if file_exists(bl_src) == 1 {
            if lsm_copy_file(bl_src, concat(concat(dest, ".bloom."), gs))? != 0 {
                db.ok = 0
                return db
            }
        }
        i = i + 1
    }
    if lsm_write_manifest(dest, db.next_gen, db.gens, db.levels)? != 0 {
        db.ok = 0
    }
    return db
}

fn lsm_maybe_sync(db: LsmDB) -> LsmDB !IO {
    db.since_sync = db.since_sync + 1
    if db.since_sync >= db.sync_every {
        db = lsm_wal_flush_buf(db)?
        if db.ok == 0 {
            return db
        }
        fdatasync(db.wal_fd)?
        db.since_sync = 0
    }
    return db
}

// Append WAL record into buffer (or direct write if buf disabled).
// R18: offset append into a preallocated buffer (wal_buf_len) — the old
// push_bytes concat leaked the whole accumulated buffer per append, and
// blocks >1 KiB never reach the free list (~12 KB/PUT in the soak test).
// R67: key arrives as raw bytes (written into the record without conversion).
fn lsm_wal_append(db: LsmDB, op: i64, key: bytes, val: bytes) -> LsmDB !IO {
    let rec = wal_record_b(op, key, val)
    let rl = bytes_len(rec)
    if db.wal_buf_max <= 0 {
        if fd_pwrite_bytes(db.wal_fd, rec, db.wal_off) != 0 {
            drop(rec)
            db.ok = 0
            return db
        }
        db.wal_off = db.wal_off + rl
        drop(rec)
        return db
    }
    if rl >= db.wal_buf_max {
        // oversized record: drain pending, then write directly
        db = lsm_wal_flush_buf(db)?
        if db.ok == 0 {
            drop(rec)
            return db
        }
        if fd_pwrite_bytes(db.wal_fd, rec, db.wal_off) != 0 {
            drop(rec)
            db.ok = 0
            return db
        }
        db.wal_off = db.wal_off + rl
        drop(rec)
        return db
    }
    if db.wal_buf_len + rl > db.wal_buf_max {
        db = lsm_wal_flush_buf(db)?
        if db.ok == 0 {
            drop(rec)
            return db
        }
    }
    if bytes_len(db.wal_buf) < db.wal_buf_max {
        db.wal_buf = bytes_new(db.wal_buf_max)
        db.wal_buf_len = 0
    }
    let mut i: i64 = 0
    while i < rl {
        bytes_set(db.wal_buf, db.wal_buf_len + i, bytes_at(rec, i))
        i = i + 1
    }
    db.wal_buf_len = db.wal_buf_len + rl
    drop(rec)
    return db
}

// R63: invalidate SCAN snapshot after a write/flush that changes the live set.
fn lsm_scan_touch(db: LsmDB) -> LsmDB {
    db.write_epoch = db.write_epoch + 1
    if vec_len(db.scan_keys) > 0 {
        let old = db.scan_keys
        db.scan_keys = vec_new()
        drop(old)
    }
    db.scan_epoch = 0 - 1
    db.scan_pat = bytes_new(0)
    return db
}

// R67: bytes-key core — put raw value bytes under a raw key (no TTL envelope).
// Clears any previous TTL.
fn lsm_put_kb(db: LsmDB, key: bytes, val: bytes) -> LsmDB !IO !Time {
    db = lsm_wal_append(db, 1, key, val)?
    if db.ok == 0 {
        return db
    }
    map_set(db.mem, key, val)
    // R22: skip tomb probe when empty (hot put path).
    if map_len(db.tomb) > 0 {
        map_del(db.tomb, key)
    }
    db.mem_n = db.mem_n + 1
    db = lsm_scan_touch(db)
    db = lsm_maybe_sync(db)?
    if db.mem_n >= db.flush_at {
        db = lsm_flush(db)?
    }
    return db
}

// Put raw value bytes (no TTL envelope). Clears any previous TTL.
fn lsm_put_b(db: LsmDB, key: str, val: bytes) -> LsmDB !IO !Time {
    return lsm_put_kb(db, bytes_of_str(key), val)?
}

fn lsm_put(db: LsmDB, key: str, val: str) -> LsmDB !IO !Time {
    return lsm_put_b(db, key, bytes_of_str(val))?
}

// Put with TTL seconds from now (Redis SETEX). ttl_sec <= 0 → plain put.
fn lsm_put_ex(db: LsmDB, key: str, val: str, ttl_sec: i64) -> LsmDB !IO !Time {
    if ttl_sec <= 0 {
        return lsm_put(db, key, val)?
    }
    return lsm_put_ex_b(db, key, bytes_of_str(val), ttl_sec)?
}

// R65: binary-safe SETEX (value bytes, may contain NUL).
fn lsm_put_ex_b(db: LsmDB, key: str, val: bytes, ttl_sec: i64) -> LsmDB !IO !Time {
    return lsm_put_ex_kb(db, bytes_of_str(key), val, ttl_sec)?
}

// R67: bytes-key SETEX core.
fn lsm_put_ex_kb(db: LsmDB, key: bytes, val: bytes, ttl_sec: i64) -> LsmDB !IO !Time {
    if ttl_sec <= 0 {
        return lsm_put_kb(db, key, val)?
    }
    let now = time_now_ms()?
    let exp = now + ttl_sec * 1000
    let packed = ttl_pack(val, exp)
    return lsm_put_kb(db, key, packed)?
}

// R67: bytes-key delete core.
fn lsm_del_kb(db: LsmDB, key: bytes) -> LsmDB !IO !Time {
    db = lsm_wal_append(db, 2, key, bytes_new(0))?
    if db.ok == 0 {
        return db
    }
    map_del(db.mem, key)
    map_set(db.tomb, key, 1)
    db.mem_n = db.mem_n + 1
    db = lsm_scan_touch(db)
    db = lsm_maybe_sync(db)?
    if db.mem_n >= db.flush_at {
        db = lsm_flush(db)?
    }
    return db
}

fn lsm_del(db: LsmDB, key: str) -> LsmDB !IO !Time {
    return lsm_del_kb(db, bytes_of_str(key))?
}

struct LsmGet {
    db: LsmDB,
    found: i64,
    val: bytes
}

// Internal: resolve raw stored bytes → user val, lazy-delete if expired.
fn lsm_resolve(db: LsmDB, key: bytes, raw: bytes, now: i64) -> LsmGet !IO !Time {
    let u = ttl_unpack(raw)
    if ttl_expired(u.expire_at, now) == 1 {
        db = lsm_del_kb(db, key)?
        return LsmGet { db: db, found: 0, val: bytes_new(0) }
    }
    return LsmGet { db: db, found: 1, val: u.val }
}

// R67: bytes-key get core.
fn lsm_get_kb(db: LsmDB, key: bytes) -> LsmGet !IO !Time {
    // R23: defer time_now until a live value needs TTL check.
    // R25: skip map probes when empty (post-flush SST-only path).
    if map_len(db.tomb) > 0 {
        if map_has(db.tomb, key) == 1 {
            return LsmGet { db: db, found: 0, val: bytes_new(0) }
        }
    }
    if map_len(db.mem) > 0 {
        if map_has(db.mem, key) == 1 {
            let now = time_now_ms()?
            return lsm_resolve(db, key, map_get(db.mem, key), now)?
        }
    }
    let lk = sst_get(db.cache, db.blooms, db.sst_fds, db.sst_sizes, db.sst_meta,
                     db.dir, db.gens, key,
                     db.hot_gen, db.hot_off, db.hot_n, db.hot_data)?
    db.cache = lk.pc
    db.blooms = lk.blooms
    db.sst_fds = lk.sst_fds
    db.sst_sizes = lk.sst_sizes
    db.sst_meta = lk.sst_meta
    db.hot_gen = lk.hot_gen
    db.hot_off = lk.hot_off
    db.hot_n = lk.hot_n
    db.hot_data = lk.hot_data
    if lk.found == 1 {
        if lk.alive == 1 {
            let now = time_now_ms()?
            return lsm_resolve(db, key, lk.val, now)?
        }
        return LsmGet { db: db, found: 0, val: bytes_new(0) }
    }
    return LsmGet { db: db, found: 0, val: bytes_new(0) }
}

fn lsm_get(db: LsmDB, key: str) -> LsmGet !IO !Time {
    return lsm_get_kb(db, bytes_of_str(key))?
}

fn lsm_exists_kb(db: LsmDB, key: bytes) -> LsmGet !IO !Time {
    return lsm_get_kb(db, key)?
}

fn lsm_exists(db: LsmDB, key: str) -> LsmGet !IO !Time {
    return lsm_get(db, key)?
}

// EXPIRE key seconds — Redis: 1 if timeout set, 0 if key missing.
struct LsmExpire {
    db: LsmDB,
    ok: i64
}

// R67: bytes-key EXPIRE core.
fn lsm_expire_kb(db: LsmDB, key: bytes, ttl_sec: i64) -> LsmExpire !IO !Time {
    let g = lsm_get_kb(db, key)?
    db = g.db
    if g.found == 0 {
        return LsmExpire { db: db, ok: 0 }
    }
    if ttl_sec <= 0 {
        // Redis EXPIRE 0 → delete
        db = lsm_del_kb(db, key)?
        return LsmExpire { db: db, ok: 1 }
    }
    let now = time_now_ms()?
    let packed = ttl_pack(g.val, now + ttl_sec * 1000)
    db = lsm_put_kb(db, key, packed)?
    return LsmExpire { db: db, ok: 1 }
}

fn lsm_expire(db: LsmDB, key: str, ttl_sec: i64) -> LsmExpire !IO !Time {
    return lsm_expire_kb(db, bytes_of_str(key), ttl_sec)?
}

// TTL key — Redis: -2 missing, -1 no expire, else remaining seconds.
struct LsmTtl {
    db: LsmDB,
    n: i64
}

// R67: bytes-key TTL core.
fn lsm_ttl_kb(db: LsmDB, key: bytes) -> LsmTtl !IO !Time {
    let now = time_now_ms()?
    if map_has(db.tomb, key) == 1 {
        return LsmTtl { db: db, n: 0 - 2 }
    }
    let mut raw = bytes_new(0)
    let mut have: i64 = 0
    if map_has(db.mem, key) == 1 {
        raw = map_get(db.mem, key)
        have = 1
    } else {
        let lk = sst_get(db.cache, db.blooms, db.sst_fds, db.sst_sizes, db.sst_meta,
                         db.dir, db.gens, key,
                         db.hot_gen, db.hot_off, db.hot_n, db.hot_data)?
        db.cache = lk.pc
        db.blooms = lk.blooms
        db.sst_fds = lk.sst_fds
        db.sst_sizes = lk.sst_sizes
        db.sst_meta = lk.sst_meta
        db.hot_gen = lk.hot_gen
        db.hot_off = lk.hot_off
        db.hot_n = lk.hot_n
        db.hot_data = lk.hot_data
        if lk.found == 1 && lk.alive == 1 {
            raw = lk.val
            have = 1
        }
    }
    if have == 0 {
        return LsmTtl { db: db, n: 0 - 2 }
    }
    let u = ttl_unpack(raw)
    if ttl_expired(u.expire_at, now) == 1 {
        db = lsm_del_kb(db, key)?
        return LsmTtl { db: db, n: 0 - 2 }
    }
    return LsmTtl { db: db, n: ttl_remaining_sec(u.expire_at, now) }
}

fn lsm_ttl(db: LsmDB, key: str) -> LsmTtl !IO !Time {
    return lsm_ttl_kb(db, bytes_of_str(key))?
}

// R67: bytes-key PERSIST core — remove TTL, keep value. 1 if removed, 0 if none/missing.
fn lsm_persist_kb(db: LsmDB, key: bytes) -> LsmExpire !IO !Time {
    let now = time_now_ms()?
    if map_has(db.tomb, key) == 1 {
        return LsmExpire { db: db, ok: 0 }
    }
    let mut raw = bytes_new(0)
    let mut have: i64 = 0
    if map_has(db.mem, key) == 1 {
        raw = map_get(db.mem, key)
        have = 1
    } else {
        let lk = sst_get(db.cache, db.blooms, db.sst_fds, db.sst_sizes, db.sst_meta,
                         db.dir, db.gens, key,
                         db.hot_gen, db.hot_off, db.hot_n, db.hot_data)?
        db.cache = lk.pc
        db.blooms = lk.blooms
        db.sst_fds = lk.sst_fds
        db.sst_sizes = lk.sst_sizes
        db.sst_meta = lk.sst_meta
        db.hot_gen = lk.hot_gen
        db.hot_off = lk.hot_off
        db.hot_n = lk.hot_n
        db.hot_data = lk.hot_data
        if lk.found == 1 && lk.alive == 1 {
            raw = lk.val
            have = 1
        }
    }
    if have == 0 {
        return LsmExpire { db: db, ok: 0 }
    }
    let u = ttl_unpack(raw)
    if ttl_expired(u.expire_at, now) == 1 {
        db = lsm_del_kb(db, key)?
        return LsmExpire { db: db, ok: 0 }
    }
    if u.expire_at <= 0 {
        return LsmExpire { db: db, ok: 0 }
    }
    db = lsm_put_kb(db, key, u.val)?
    return LsmExpire { db: db, ok: 1 }
}

// PERSIST key — remove TTL, keep value. 1 if removed, 0 if none/missing.
fn lsm_persist(db: LsmDB, key: str) -> LsmExpire !IO !Time {
    return lsm_persist_kb(db, bytes_of_str(key))?
}

fn lsm_flush(db: LsmDB) -> LsmDB !IO !Time {
    let now = time_now_ms()?
    // R21: sort map_keys in place (no mem-key copy); append pure tombs only.
    // R67: keys are raw bytes — sort via bytes_cmp.
    let all = map_keys(db.mem)
    let tk = map_keys(db.tomb)
    let ntom = vec_len(tk)
    let mut ti: i64 = 0
    while ti < ntom {
        let k = vec_get(tk, ti)
        if map_has(db.mem, k) == 0 {
            vec_push(all, k)
        }
        ti = ti + 1
    }
    sort_bytes(all)
    let nall = vec_len(all)
    let rows: Vec<SstRow> = vec_new()
    let mut i: i64 = 0
    while i < nall {
        let k = vec_get(all, i)
        // Pure tomb: in tomb set and not in mem (already filtered for keys only
        // in tomb; live keys may still be tomb-superseded — use mem presence).
        if map_has(db.mem, k) == 0 {
            vec_push(rows, SstRow { op: 2, key: k, val: bytes_new(0) })
        } else {
            let raw = map_get(db.mem, k)
            let u = ttl_unpack(raw)
            if ttl_expired(u.expire_at, now) == 1 {
                // drop expired; write tomb so older SST versions are hidden
                vec_push(rows, SstRow { op: 2, key: k, val: bytes_new(0) })
            } else {
                vec_push(rows, SstRow { op: 1, key: k, val: raw })
            }
        }
        i = i + 1
    }
    // Durable boundary before SST: drain WAL buffer then fsync.
    db = lsm_wal_flush_buf(db)?
    if db.ok == 0 {
        return db
    }
    fdatasync(db.wal_fd)?
    let gen = db.next_gen
    if vec_len(rows) > 0 {
        if sst_write(db.dir, gen, rows)? != 0 {
            db.ok = 0
            return db
        }
        vec_push(db.gens, gen)
        vec_push(db.levels, 0)   // L0
        db.next_gen = gen + 1
    }
    drop(rows)  // R18: on disk; vals stay with db.mem until it is replaced
    // R40: append version edit (ADD+NEXT) instead of full snapshot rewrite.
    if gen < db.next_gen {
        // we wrote an L0 SST at `gen` and bumped next_gen
        let na = lsm_manifest_log_add(db.dir, gen, 0, db.next_gen)?
        if na < 0 {
            db.ok = 0
            return db
        }
        db.manifest_edits = db.manifest_edits + na
    } else {
        // empty flush still durable-rotate WAL — snapshot next_gen only via N
        let t = concat(concat("N ", int_to_str(db.next_gen)), "\n")
        if lsm_manifest_log_append(db.dir, t)? != 0 {
            db.ok = 0
            return db
        }
        db.manifest_edits = db.manifest_edits + 1
    }
    let ec = lsm_manifest_maybe_compact(
        db.dir, db.next_gen, db.gens, db.levels, db.manifest_edits
    )?
    if ec < 0 {
        db.ok = 0
        return db
    }
    db.manifest_edits = ec
    close(db.wal_fd)
    unlink(lsm_wal_path(db.dir))?
    let wfd = open(lsm_wal_path(db.dir), 578, 420)?
    if wfd < 0 {
        db.ok = 0
        return db
    }
    db.wal_fd = wfd
    db.wal_off = 0
    db.wal_buf_len = 0  // R18: keep the allocated buffer
    db.mem = map_new()
    db.tomb = map_new()
    db.mem_n = 0
    db.since_sync = 0
    // L0..L3 compaction (chain while any level is over file or byte threshold)
    let mut guard: i64 = 0
    let mut more: i64 = 1
    while more == 1 && guard < 32 {
        let n0 = lsm_count_level(db.levels, 0)
        let n1 = lsm_count_level(db.levels, 1)
        let n2 = lsm_count_level(db.levels, 2)
        let n3 = lsm_count_level(db.levels, 3)
        let b0 = lsm_level_bytes(db, 0)?
        let b1 = lsm_level_bytes(db, 1)?
        let b2 = lsm_level_bytes(db, 2)?
        let b3 = lsm_level_bytes(db, 3)?
        let over0 = lsm_level_over(db, 0, n0, b0)
        let over1 = lsm_level_over(db, 1, n1, b1)
        let over2 = lsm_level_over(db, 2, n2, b2)
        let over3 = lsm_level_over(db, 3, n3, b3)
        // File-count legacy: pair collapse L1/L2/L3 when byte targets off
        let mut pair: i64 = 0
        if db.target_bytes <= 0 {
            if n1 >= 2 || n2 >= 2 || n3 >= 2 {
                pair = 1
            }
        }
        if over0 == 1 || over1 == 1 || over2 == 1 || over3 == 1 || pair == 1 {
            db = lsm_compact(db)?
            guard = guard + 1
        } else {
            more = 0
        }
    }
    return db
}

fn lsm_flush_force(db: LsmDB) -> LsmDB !IO !Time {
    if db.mem_n == 0 {
        return db
    }
    return lsm_flush(db)?
}

struct LsmGetKeys {
    db: LsmDB,
    keys: Vec<str>
}

// R67: bytes-key sibling of LsmGetKeys (internal fold result).
struct LsmGetKeysB {
    db: LsmDB,
    keys: Vec<bytes>
}

struct LsmDbSize {
    db: LsmDB,
    n: i64
}

// R67: build live key→raw map (mem + SST fold) keyed by raw bytes.
// Shared by KEYS / DBSIZE / SCAN (R31).
fn lsm_live_map_kb(db: LsmDB) -> LsmGetKeysB !IO !Time {
    let now = time_now_ms()?
    let seen: Map<bytes, bytes> = map_new()
    let dead: Map<bytes, i64> = map_new()
    let mut cur = db.cache
    for i in 0..vec_len(db.gens) {
        let gen = vec_get(db.gens, i)
        cur = sst_fold_into(cur, db.dir, gen, db.sst_fds, db.sst_sizes, seen, dead)?
    }
    db.cache = cur
    let mk = map_keys(db.mem)
    for i in 0..vec_len(mk) {
        let k = vec_get(mk, i)
        map_set(seen, k, map_get(db.mem, k))
        map_del(dead, k)
    }
    let tk = map_keys(db.tomb)
    for i in 0..vec_len(tk) {
        let k = vec_get(tk, i)
        map_del(seen, k)
        map_set(dead, k, 1)
    }
    // Drop expired (TTL) without sorting — caller decides order.
    let ks = map_keys(seen)
    let out: Vec<bytes> = vec_new()
    for i in 0..vec_len(ks) {
        let k = vec_get(ks, i)
        let u = ttl_unpack(map_get(seen, k))
        if ttl_expired(u.expire_at, now) == 0 {
            vec_push(out, k)
        }
    }
    drop(seen)
    drop(dead)
    return LsmGetKeysB { db: db, keys: out }
}

// Build live key list as str (mem + SST fold). R26: block scan fold.
// R67: keys live as bytes internally; converting to str here is LOSSY for
// keys with embedded NUL (str can't hold 0x00) — binary KEYS/MATCH is R68.
fn lsm_live_map(db: LsmDB) -> LsmGetKeys !IO !Time {
    let r = lsm_live_map_kb(db)?
    let out: Vec<str> = vec_new()
    for i in 0..vec_len(r.keys) {
        vec_push(out, str_of_bytes(vec_get(r.keys, i)))
    }
    return LsmGetKeys { db: r.db, keys: out }
}

// List live keys (mem + SST). R26: block scan fold. R31: shared live map + sort.
fn lsm_keys(db: LsmDB) -> LsmGetKeys !IO !Time {
    let r = lsm_live_map(db)?
    sort_strs(r.keys)
    return r
}

// R68: bytes-key KEYS core — raw live keys sorted via bytes_cmp (wire path).
fn lsm_keys_kb(db: LsmDB) -> LsmGetKeysB !IO !Time {
    let r = lsm_live_map_kb(db)?
    sort_bytes(r.keys)
    return r
}

// Live key count without sorting (RESP DBSIZE). Same semantics as KEYS length.
fn lsm_dbsize(db: LsmDB) -> LsmDbSize !IO !Time {
    let r = lsm_live_map_kb(db)?
    let n = vec_len(r.keys)
    return LsmDbSize { db: r.db, n: n }
}

// R43: simple glob for SCAN MATCH — supports *, prefix*, *suffix, *mid*, exact.
// Empty pattern or "*" matches all.
fn lsm_match_glob(pat: str, s: str) -> i64 {
    if pat == "" || pat == "*" {
        return 1
    }
    let np = len(pat)
    let ns = len(s)
    // find first '*'
    let mut star: i64 = 0 - 1
    let mut i: i64 = 0
    while i < np {
        if char_at(pat, i) == 42 {
            star = i
            i = np
        } else {
            i = i + 1
        }
    }
    if star < 0 {
        // exact
        if pat == s {
            return 1
        }
        return 0
    }
    // prefix before star
    let pre = substr(pat, 0, star)
    if str_starts_with(s, pre) == false {
        return 0
    }
    // suffix after star (only one * supported; rest is literal suffix)
    let suf = substr(pat, star + 1, np)
    if suf == "" {
        return 1
    }
    // if another * in suf, treat remaining as contains
    let mut star2: i64 = 0 - 1
    let mut j: i64 = 0
    while j < len(suf) {
        if char_at(suf, j) == 42 {
            star2 = j
            j = len(suf)
        } else {
            j = j + 1
        }
    }
    if star2 < 0 {
        if str_ends_with(s, suf) {
            return 1
        }
        return 0
    }
    // *a*b form: require contains middle between prefix and suffix
    let mid = substr(suf, 0, star2)
    let suf2 = substr(suf, star2 + 1, len(suf))
    if mid != "" {
        if str_find(s, mid) < 0 {
            return 0
        }
    }
    if suf2 != "" {
        if str_ends_with(s, suf2) == false {
            return 0
        }
    }
    return 1
}

// --- R68: bytes glob helpers (SCAN MATCH over raw key bytes) ---

// s starts with pat[0, n).
fn lsm_bytes_has_prefix(s: bytes, pat: bytes, n: i64) -> i64 {
    if bytes_len(s) < n {
        return 0
    }
    let mut i: i64 = 0
    while i < n {
        if bytes_at(s, i) != bytes_at(pat, i) {
            return 0
        }
        i = i + 1
    }
    return 1
}

// s ends with pat[poff, poff+n).
fn lsm_bytes_has_suffix(s: bytes, pat: bytes, poff: i64, n: i64) -> i64 {
    let ns = bytes_len(s)
    if ns < n {
        return 0
    }
    let base = ns - n
    let mut i: i64 = 0
    while i < n {
        if bytes_at(s, base + i) != bytes_at(pat, poff + i) {
            return 0
        }
        i = i + 1
    }
    return 1
}

// Index of pat[poff, poff+n) inside s, or -1.
fn lsm_bytes_find(s: bytes, pat: bytes, poff: i64, n: i64) -> i64 {
    let ns = bytes_len(s)
    if n <= 0 {
        return 0
    }
    let mut i: i64 = 0
    while i + n <= ns {
        let mut j: i64 = 0
        let mut same: i64 = 1
        while j < n && same == 1 {
            if bytes_at(s, i + j) != bytes_at(pat, poff + j) {
                same = 0
            }
            j = j + 1
        }
        if same == 1 {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// R68: bytes glob for SCAN MATCH — same grammar as lsm_match_glob
// (*, prefix*, *suffix, *mid*, exact) but NUL-safe over raw bytes.
fn lsm_match_glob_b(pat: bytes, s: bytes) -> i64 {
    let np = bytes_len(pat)
    if np == 0 {
        return 1
    }
    if np == 1 && bytes_at(pat, 0) == 42 {
        return 1
    }
    // find first '*'
    let mut star: i64 = 0 - 1
    let mut i: i64 = 0
    while i < np {
        if bytes_at(pat, i) == 42 {
            star = i
            i = np
        } else {
            i = i + 1
        }
    }
    if star < 0 {
        // exact
        if bytes_eq_b(pat, s) {
            return 1
        }
        return 0
    }
    // prefix before star
    if lsm_bytes_has_prefix(s, pat, star) == 0 {
        return 0
    }
    // suffix after star (only one * supported; rest is literal suffix)
    let nsuf = np - star - 1
    if nsuf == 0 {
        return 1
    }
    // if another * in suffix, treat remaining as contains
    let mut star2: i64 = 0 - 1
    let mut j: i64 = 0
    while j < nsuf {
        if bytes_at(pat, star + 1 + j) == 42 {
            star2 = j
            j = nsuf
        } else {
            j = j + 1
        }
    }
    if star2 < 0 {
        if lsm_bytes_has_suffix(s, pat, star + 1, nsuf) == 1 {
            return 1
        }
        return 0
    }
    // *a*b form: require contains middle between prefix and suffix
    if star2 > 0 {
        if lsm_bytes_find(s, pat, star + 1, star2) < 0 {
            return 0
        }
    }
    let nsuf2 = nsuf - star2 - 1
    if nsuf2 > 0 {
        if lsm_bytes_has_suffix(s, pat, star + 1 + star2 + 1, nsuf2) == 0 {
            return 0
        }
    }
    return 1
}

struct LsmScan {
    db: LsmDB,
    next: i64,
    keys: Vec<str>
}

// R68: bytes-key sibling of LsmScan (wire path emits raw key bytes).
struct LsmScanB {
    db: LsmDB,
    next: i64,
    keys: Vec<bytes>
}

// R68: (re)build SCAN snapshot from a raw-bytes MATCH pattern.
// Unordered live keys + MATCH filter — Redis SCAN does not promise order
// (KEYS remains sorted via lsm_keys). Snapshot and pattern stay raw bytes;
// the glob never sees a lossy str conversion.
fn lsm_scan_rebuild_b(db: LsmDB, match_pat: bytes) -> LsmDB !IO !Time {
    let r = lsm_live_map_kb(db)?
    db = r.db
    let all = r.keys
    let filtered: Vec<bytes> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(all) {
        let k = vec_get(all, i)
        if lsm_match_glob_b(match_pat, k) == 1 {
            vec_push(filtered, k)
        }
        i = i + 1
    }
    if vec_len(db.scan_keys) > 0 {
        let old = db.scan_keys
        db.scan_keys = filtered
        drop(old)
    } else {
        db.scan_keys = filtered
    }
    db.scan_pat = match_pat
    db.scan_epoch = db.write_epoch
    return db
}

// R43 + R63 + R68: SCAN page over live keys, raw-bytes pattern and results.
// Cursor is a 0-based index into the filtered snapshot; 0 = start/end
// (Redis-compatible). count is a page size hint (default 10, clamp 1..1000).
// R63: the live fold runs once per write_epoch×MATCH; later pages are
// O(count) slices of the cached snapshot (no per-page full re-fold).
fn lsm_scan_kb(db: LsmDB, cursor: i64, count: i64, match_pat: bytes) -> LsmScanB !IO !Time {
    // Rebuild when: no cache, write since last build, or MATCH changed.
    // Cursor 0 always accepts a rebuild if cache is stale; mid-cursor with
    // a stale cache also rebuilds (caller may see duplicates / skips —
    // same honesty class as Redis under concurrent writes).
    if db.scan_epoch != db.write_epoch || bytes_eq_b(db.scan_pat, match_pat) == false {
        db = lsm_scan_rebuild_b(db, match_pat)?
    }
    let n = vec_len(db.scan_keys)
    let mut cur = cursor
    if cur < 0 {
        cur = 0
    }
    // Cursor past end after a rebuild → treat as finished (next=0).
    if cur > n {
        cur = n
    }
    let mut cnt = count
    if cnt < 1 {
        cnt = 10
    }
    if cnt > 1000 {
        cnt = 1000
    }
    let out: Vec<bytes> = vec_new()
    let mut j = cur
    let mut taken: i64 = 0
    while j < n && taken < cnt {
        vec_push(out, vec_get(db.scan_keys, j))
        j = j + 1
        taken = taken + 1
    }
    let mut next: i64 = j
    if next >= n {
        next = 0
        // Full iteration done — free snapshot until next SCAN 0.
        if vec_len(db.scan_keys) > 0 {
            let old = db.scan_keys
            db.scan_keys = vec_new()
            drop(old)
        }
        db.scan_epoch = 0 - 1
        db.scan_pat = bytes_new(0)
    }
    return LsmScanB { db: db, next: next, keys: out }
}

// str-keyed compat wrapper: pattern converts losslessly (bytes_of_str);
// returned keys convert via str_of_bytes — NUL keys truncate (use
// lsm_scan_kb on the wire path, R68).
fn lsm_scan(db: LsmDB, cursor: i64, count: i64, match_pat: str) -> LsmScan !IO !Time {
    let r = lsm_scan_kb(db, cursor, count, bytes_of_str(match_pat))?
    let out: Vec<str> = vec_new()
    for i in 0..vec_len(r.keys) {
        vec_push(out, str_of_bytes(vec_get(r.keys, i)))
    }
    return LsmScan { db: r.db, next: r.next, keys: out }
}
