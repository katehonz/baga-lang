// engine.baga — open/put/get/flush/recovery (orchestration).
// Compaction: compact.baga. Types: types.baga.

import "types.baga"
import "compact.baga"
import "../util/codec.baga"
import "../util/ttl.baga"
import "../cache/page.baga"
import "../wal/wal.baga"
import "../table/sstable.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/time/time.baga"

fn lsm_wal_path(dir: str) -> str {
    return concat(dir, ".wal")
}


fn lsm_empty_db(dir: str) -> LsmDB {
    let gens: Vec<i64> = vec_new()
    let levels: Vec<i64> = vec_new()
    // Default page cache: 256 × 4 KiB ≈ 1 MiB (R11; was 32 pages).
    return LsmDB {
        dir: dir, mem: map_new(), tomb: map_new(), mem_n: 0,
        flush_at: 32, compact_at: 3, target_bytes: 0, merge_pick: 0,
        wal_fd: -1, wal_off: 0,
        wal_buf: bytes_new(0), wal_buf_max: 65536, wal_buf_len: 0,
        gens: gens, levels: levels, next_gen: 1, cache: pc_new(4096, 256),
        blooms: bloom_cache_new(),
        sst_fds: map_new(), sst_sizes: map_new(), sst_meta: map_new(),
        sync_every: 1, since_sync: 0, ok: 1
    }
}

fn lsm_read_manifest(dir: str) -> LsmDB !IO {
    let gens: Vec<i64> = vec_new()
    let levels: Vec<i64> = vec_new()
    let body = read_file(lsm_manifest_path(dir))?
    if body == "" {
        return lsm_empty_db(dir)
    }
    let lines = str_split(body, "\n")
    let mut next_gen: i64 = 1
    if vec_len(lines) > 0 && vec_get(lines, 0) != "" {
        next_gen = parse_int(vec_get(lines, 0))
        if next_gen < 1 {
            next_gen = 1
        }
    }
    for i in 1..vec_len(lines) {
        let ln = vec_get(lines, i)
        if ln != "" {
            // "gen level" or legacy "gen"
            let parts = str_split(ln, " ")
            let g = parse_int(vec_get(parts, 0))
            if g > 0 {
                vec_push(gens, g)
                let mut lv: i64 = 0
                if vec_len(parts) >= 2 {
                    lv = parse_int(vec_get(parts, 1))
                    if lv < 0 {
                        lv = 0
                    }
                    if lv > 3 {
                        lv = 3
                    }
                }
                vec_push(levels, lv)
            }
        }
    }
    return LsmDB {
        dir: dir, mem: map_new(), tomb: map_new(), mem_n: 0,
        flush_at: 32, compact_at: 3, target_bytes: 0, merge_pick: 0,
        wal_fd: -1, wal_off: 0,
        wal_buf: bytes_new(0), wal_buf_max: 65536, wal_buf_len: 0,
        gens: gens, levels: levels, next_gen: next_gen, cache: pc_new(4096, 256),
        blooms: bloom_cache_new(),
        sst_fds: map_new(), sst_sizes: map_new(), sst_meta: map_new(),
        sync_every: 1, since_sync: 0, ok: 1
    }
}

fn lsm_open(dir: str, flush_at: i64, compact_at: i64) -> LsmDB !IO {
    let mut db = lsm_read_manifest(dir)?
    db.dir = dir
    if flush_at > 0 {
        db.flush_at = flush_at
    }
    if compact_at > 0 {
        db.compact_at = compact_at
    }
    let wfd = open(lsm_wal_path(dir), 66, 420)?
    if wfd < 0 {
        db.ok = 0
        return db
    }
    db.wal_fd = wfd
    let rp = wal_replay(wfd)?
    db.wal_off = rp.end_off
    for i in 0..vec_len(rp.ops) {
        let op = vec_get(rp.ops, i)
        let k = vec_get(rp.keys, i)
        let v = vec_get(rp.vals, i)
        if op == 1 {
            map_set(db.mem, k, v)
            map_del(db.tomb, k)
        } else {
            map_del(db.mem, k)
            map_set(db.tomb, k, 1)
        }
        db.mem_n = db.mem_n + 1
    }
    db.ok = 1
    return db
}

// Flush pending WAL buffer to the fd (no fdatasync).
fn lsm_wal_flush_buf(db: LsmDB) -> LsmDB !IO {
    if db.wal_buf_len <= 0 {
        return db
    }
    let view = bytes_slice(db.wal_buf, 0, db.wal_buf_len)
    if fd_pwrite_bytes(db.wal_fd, view, db.wal_off) != 0 {
        db.ok = 0
        return db
    }
    drop(view)
    db.wal_off = db.wal_off + db.wal_buf_len
    db.wal_buf_len = 0  // buffer stays allocated, reused next window
    return db
}

fn lsm_close(db: LsmDB) -> i64 !IO {
    let mut d = db
    if d.wal_fd >= 0 {
        d = lsm_wal_flush_buf(d)?
        fdatasync(d.wal_fd)?
        close(d.wal_fd)
    }
    // Maps are shared — close cached SST fds without return-updated dance.
    let ks = map_keys(d.sst_fds)
    for i in 0..vec_len(ks) {
        let g = vec_get(ks, i)
        let fd = map_get(d.sst_fds, g)
        if fd >= 0 {
            close(fd)
        }
        map_del(d.sst_fds, g)
        map_del(d.sst_sizes, g)
    }
    return 0
}

fn lsm_maybe_sync(db: LsmDB) -> LsmDB !IO {
    db.since_sync = db.since_sync + 1
    if db.since_sync >= db.sync_every {
        db = lsm_wal_flush_buf(db)?
        if db.ok == 0 {
            return db
        }
        fdatasync(db.wal_fd)?
        db.since_sync = 0
    }
    return db
}

// Append WAL record into buffer (or direct write if buf disabled).
// R18: offset append into a preallocated buffer (wal_buf_len) — the old
// push_bytes concat leaked the whole accumulated buffer per append, and
// blocks >1 KiB never reach the free list (~12 KB/PUT in the soak test).
fn lsm_wal_append(db: LsmDB, op: i64, key: str, val: bytes) -> LsmDB !IO {
    let rec = wal_record(op, key, val)
    let rl = bytes_len(rec)
    if db.wal_buf_max <= 0 {
        if fd_pwrite_bytes(db.wal_fd, rec, db.wal_off) != 0 {
            drop(rec)
            db.ok = 0
            return db
        }
        db.wal_off = db.wal_off + rl
        drop(rec)
        return db
    }
    if rl >= db.wal_buf_max {
        // oversized record: drain pending, then write directly
        db = lsm_wal_flush_buf(db)?
        if db.ok == 0 {
            drop(rec)
            return db
        }
        if fd_pwrite_bytes(db.wal_fd, rec, db.wal_off) != 0 {
            drop(rec)
            db.ok = 0
            return db
        }
        db.wal_off = db.wal_off + rl
        drop(rec)
        return db
    }
    if db.wal_buf_len + rl > db.wal_buf_max {
        db = lsm_wal_flush_buf(db)?
        if db.ok == 0 {
            drop(rec)
            return db
        }
    }
    if bytes_len(db.wal_buf) < db.wal_buf_max {
        db.wal_buf = bytes_new(db.wal_buf_max)
        db.wal_buf_len = 0
    }
    let mut i: i64 = 0
    while i < rl {
        bytes_set(db.wal_buf, db.wal_buf_len + i, bytes_at(rec, i))
        i = i + 1
    }
    db.wal_buf_len = db.wal_buf_len + rl
    drop(rec)
    return db
}

// Put raw value bytes (no TTL envelope). Clears any previous TTL.
fn lsm_put_b(db: LsmDB, key: str, val: bytes) -> LsmDB !IO !Time {
    db = lsm_wal_append(db, 1, key, val)?
    if db.ok == 0 {
        return db
    }
    map_set(db.mem, key, val)
    map_del(db.tomb, key)
    db.mem_n = db.mem_n + 1
    db = lsm_maybe_sync(db)?
    if db.mem_n >= db.flush_at {
        db = lsm_flush(db)?
    }
    return db
}

fn lsm_put(db: LsmDB, key: str, val: str) -> LsmDB !IO !Time {
    return lsm_put_b(db, key, bytes_of_str(val))?
}

// Put with TTL seconds from now (Redis SETEX). ttl_sec <= 0 → plain put.
fn lsm_put_ex(db: LsmDB, key: str, val: str, ttl_sec: i64) -> LsmDB !IO !Time {
    if ttl_sec <= 0 {
        return lsm_put(db, key, val)?
    }
    let now = time_now_ms()?
    let exp = now + ttl_sec * 1000
    let packed = ttl_pack(bytes_of_str(val), exp)
    return lsm_put_b(db, key, packed)?
}

fn lsm_del(db: LsmDB, key: str) -> LsmDB !IO !Time {
    db = lsm_wal_append(db, 2, key, bytes_new(0))?
    if db.ok == 0 {
        return db
    }
    map_del(db.mem, key)
    map_set(db.tomb, key, 1)
    db.mem_n = db.mem_n + 1
    db = lsm_maybe_sync(db)?
    if db.mem_n >= db.flush_at {
        db = lsm_flush(db)?
    }
    return db
}

struct LsmGet {
    db: LsmDB,
    found: i64,
    val: bytes
}

// Internal: resolve raw stored bytes → user val, lazy-delete if expired.
fn lsm_resolve(db: LsmDB, key: str, raw: bytes, now: i64) -> LsmGet !IO !Time {
    let u = ttl_unpack(raw)
    if ttl_expired(u.expire_at, now) == 1 {
        db = lsm_del(db, key)?
        return LsmGet { db: db, found: 0, val: bytes_new(0) }
    }
    return LsmGet { db: db, found: 1, val: u.val }
}

fn lsm_get(db: LsmDB, key: str) -> LsmGet !IO !Time {
    let now = time_now_ms()?
    if map_has(db.tomb, key) == 1 {
        return LsmGet { db: db, found: 0, val: bytes_new(0) }
    }
    if map_has(db.mem, key) == 1 {
        return lsm_resolve(db, key, map_get(db.mem, key), now)?
    }
    let lk = sst_get(db.cache, db.blooms, db.sst_fds, db.sst_sizes, db.sst_meta,
                     db.dir, db.gens, key)?
    db.cache = lk.pc
    db.blooms = lk.blooms
    db.sst_fds = lk.sst_fds
    db.sst_sizes = lk.sst_sizes
    db.sst_meta = lk.sst_meta
    if lk.found == 1 {
        if lk.alive == 1 {
            return lsm_resolve(db, key, lk.val, now)?
        }
        return LsmGet { db: db, found: 0, val: bytes_new(0) }
    }
    return LsmGet { db: db, found: 0, val: bytes_new(0) }
}

fn lsm_exists(db: LsmDB, key: str) -> LsmGet !IO !Time {
    return lsm_get(db, key)?
}

// EXPIRE key seconds — Redis: 1 if timeout set, 0 if key missing.
struct LsmExpire {
    db: LsmDB,
    ok: i64
}

fn lsm_expire(db: LsmDB, key: str, ttl_sec: i64) -> LsmExpire !IO !Time {
    let g = lsm_get(db, key)?
    db = g.db
    if g.found == 0 {
        return LsmExpire { db: db, ok: 0 }
    }
    if ttl_sec <= 0 {
        // Redis EXPIRE 0 → delete
        db = lsm_del(db, key)?
        return LsmExpire { db: db, ok: 1 }
    }
    let now = time_now_ms()?
    let packed = ttl_pack(g.val, now + ttl_sec * 1000)
    db = lsm_put_b(db, key, packed)?
    return LsmExpire { db: db, ok: 1 }
}

// TTL key — Redis: -2 missing, -1 no expire, else remaining seconds.
struct LsmTtl {
    db: LsmDB,
    n: i64
}

fn lsm_ttl(db: LsmDB, key: str) -> LsmTtl !IO !Time {
    let now = time_now_ms()?
    if map_has(db.tomb, key) == 1 {
        return LsmTtl { db: db, n: 0 - 2 }
    }
    let mut raw = bytes_new(0)
    let mut have: i64 = 0
    if map_has(db.mem, key) == 1 {
        raw = map_get(db.mem, key)
        have = 1
    } else {
        let lk = sst_get(db.cache, db.blooms, db.sst_fds, db.sst_sizes, db.sst_meta,
                         db.dir, db.gens, key)?
        db.cache = lk.pc
        db.blooms = lk.blooms
        db.sst_fds = lk.sst_fds
        db.sst_sizes = lk.sst_sizes
        db.sst_meta = lk.sst_meta
        if lk.found == 1 && lk.alive == 1 {
            raw = lk.val
            have = 1
        }
    }
    if have == 0 {
        return LsmTtl { db: db, n: 0 - 2 }
    }
    let u = ttl_unpack(raw)
    if ttl_expired(u.expire_at, now) == 1 {
        db = lsm_del(db, key)?
        return LsmTtl { db: db, n: 0 - 2 }
    }
    return LsmTtl { db: db, n: ttl_remaining_sec(u.expire_at, now) }
}

// PERSIST key — remove TTL, keep value. 1 if removed, 0 if none/missing.
fn lsm_persist(db: LsmDB, key: str) -> LsmExpire !IO !Time {
    let now = time_now_ms()?
    if map_has(db.tomb, key) == 1 {
        return LsmExpire { db: db, ok: 0 }
    }
    let mut raw = bytes_new(0)
    let mut have: i64 = 0
    if map_has(db.mem, key) == 1 {
        raw = map_get(db.mem, key)
        have = 1
    } else {
        let lk = sst_get(db.cache, db.blooms, db.sst_fds, db.sst_sizes, db.sst_meta,
                         db.dir, db.gens, key)?
        db.cache = lk.pc
        db.blooms = lk.blooms
        db.sst_fds = lk.sst_fds
        db.sst_sizes = lk.sst_sizes
        db.sst_meta = lk.sst_meta
        if lk.found == 1 && lk.alive == 1 {
            raw = lk.val
            have = 1
        }
    }
    if have == 0 {
        return LsmExpire { db: db, ok: 0 }
    }
    let u = ttl_unpack(raw)
    if ttl_expired(u.expire_at, now) == 1 {
        db = lsm_del(db, key)?
        return LsmExpire { db: db, ok: 0 }
    }
    if u.expire_at <= 0 {
        return LsmExpire { db: db, ok: 0 }
    }
    db = lsm_put_b(db, key, u.val)?
    return LsmExpire { db: db, ok: 1 }
}

fn lsm_flush(db: LsmDB) -> LsmDB !IO !Time {
    let now = time_now_ms()?
    let mk = map_keys(db.mem)
    let tk = map_keys(db.tomb)
    let all: Vec<str> = vec_new()
    for i in 0..vec_len(mk) {
        vec_push(all, vec_get(mk, i))
    }
    for i in 0..vec_len(tk) {
        let k = vec_get(tk, i)
        if map_has(db.mem, k) == 0 {
            vec_push(all, k)
        }
    }
    sort_strs(all)
    let rows: Vec<SstRow> = vec_new()
    for i in 0..vec_len(all) {
        let k = vec_get(all, i)
        if map_has(db.tomb, k) == 1 && map_has(db.mem, k) == 0 {
            vec_push(rows, SstRow { op: 2, key: k, val: bytes_new(0) })
        } else {
            let raw = map_get(db.mem, k)
            let u = ttl_unpack(raw)
            if ttl_expired(u.expire_at, now) == 1 {
                // drop expired; write tomb so older SST versions are hidden
                vec_push(rows, SstRow { op: 2, key: k, val: bytes_new(0) })
            } else {
                vec_push(rows, SstRow { op: 1, key: k, val: raw })
            }
        }
    }
    // Durable boundary before SST: drain WAL buffer then fsync.
    db = lsm_wal_flush_buf(db)?
    if db.ok == 0 {
        return db
    }
    fdatasync(db.wal_fd)?
    let gen = db.next_gen
    if vec_len(rows) > 0 {
        if sst_write(db.dir, gen, rows)? != 0 {
            db.ok = 0
            return db
        }
        vec_push(db.gens, gen)
        vec_push(db.levels, 0)   // L0
        db.next_gen = gen + 1
    }
    drop(rows)  // R18: on disk; vals stay with db.mem until it is replaced
    if lsm_write_manifest(db.dir, db.next_gen, db.gens, db.levels)? != 0 {
        db.ok = 0
        return db
    }
    close(db.wal_fd)
    unlink(lsm_wal_path(db.dir))?
    let wfd = open(lsm_wal_path(db.dir), 578, 420)?
    if wfd < 0 {
        db.ok = 0
        return db
    }
    db.wal_fd = wfd
    db.wal_off = 0
    db.wal_buf_len = 0  // R18: keep the allocated buffer
    db.mem = map_new()
    db.tomb = map_new()
    db.mem_n = 0
    db.since_sync = 0
    // L0..L3 compaction (chain while any level is over file or byte threshold)
    let mut guard: i64 = 0
    let mut more: i64 = 1
    while more == 1 && guard < 32 {
        let n0 = lsm_count_level(db.levels, 0)
        let n1 = lsm_count_level(db.levels, 1)
        let n2 = lsm_count_level(db.levels, 2)
        let n3 = lsm_count_level(db.levels, 3)
        let b0 = lsm_level_bytes(db, 0)?
        let b1 = lsm_level_bytes(db, 1)?
        let b2 = lsm_level_bytes(db, 2)?
        let b3 = lsm_level_bytes(db, 3)?
        let over0 = lsm_level_over(db, 0, n0, b0)
        let over1 = lsm_level_over(db, 1, n1, b1)
        let over2 = lsm_level_over(db, 2, n2, b2)
        let over3 = lsm_level_over(db, 3, n3, b3)
        // File-count legacy: pair collapse L1/L2/L3 when byte targets off
        let mut pair: i64 = 0
        if db.target_bytes <= 0 {
            if n1 >= 2 || n2 >= 2 || n3 >= 2 {
                pair = 1
            }
        }
        if over0 == 1 || over1 == 1 || over2 == 1 || over3 == 1 || pair == 1 {
            db = lsm_compact(db)?
            guard = guard + 1
        } else {
            more = 0
        }
    }
    return db
}

fn lsm_flush_force(db: LsmDB) -> LsmDB !IO !Time {
    if db.mem_n == 0 {
        return db
    }
    return lsm_flush(db)?
}

struct LsmGetKeys {
    db: LsmDB,
    keys: Vec<str>
}

fn lsm_keys(db: LsmDB) -> LsmGetKeys !IO !Time {
    let now = time_now_ms()?
    let seen: Map<str, bytes> = map_new()  // key → raw val (latest)
    let dead: Map<str, i64> = map_new()
    let mut cur = db.cache
    for i in 0..vec_len(db.gens) {
        let gen = vec_get(db.gens, i)
        let ld = sst_load(cur, db.dir, gen)?
        cur = ld.pc
        if ld.parse.ok == 1 {
            for j in 0..vec_len(ld.parse.rows) {
                let r = vec_get(ld.parse.rows, j)
                if r.op == 2 {
                    map_del(seen, r.key)
                    map_set(dead, r.key, 1)
                } else {
                    map_set(seen, r.key, r.val)
                    map_del(dead, r.key)
                }
            }
        }
    }
    db.cache = cur
    let mk = map_keys(db.mem)
    for i in 0..vec_len(mk) {
        let k = vec_get(mk, i)
        map_set(seen, k, map_get(db.mem, k))
        map_del(dead, k)
    }
    let tk = map_keys(db.tomb)
    for i in 0..vec_len(tk) {
        let k = vec_get(tk, i)
        map_del(seen, k)
        map_set(dead, k, 1)
    }
    let ks = map_keys(seen)
    let out: Vec<str> = vec_new()
    for i in 0..vec_len(ks) {
        let k = vec_get(ks, i)
        let u = ttl_unpack(map_get(seen, k))
        if ttl_expired(u.expire_at, now) == 0 {
            vec_push(out, k)
        }
    }
    sort_strs(out)
    return LsmGetKeys { db: db, keys: out }
}
