// engine.baga — LsmDB ядро: open/close (MANIFEST via manifest.baga),
// flushdb, checkpoint, put/del, get/exists, flush/flush_force (memtable →
// SST + compact gate). WAL кодекът е в engine_wal.baga; TTL — в
// engine_ttl.baga; keys/glob — в engine_keys.baga; scan — в engine_scan.baga.

import "types.baga"
import "manifest.baga"
import "engine_wal.baga"
import "compact.baga"
import "../util/codec.baga"
import "../util/ttl.baga"
import "../cache/page.baga"
import "../wal/wal.baga"
import "../table/sstable.baga"
import "../table/sstable_parse.baga"
import "../table/sstable_lookup.baga"
import "../table/sstable_meta.baga"
import "../table/sstable_scan.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/time/time.baga"
import "std/bytes/bytes.baga"

fn lsm_empty_db(dir: str) -> LsmDB {
    let gens: Vec<i64> = vec_new()
    let levels: Vec<i64> = vec_new()
    // R25: default page cache 2048 × 4 KiB ≈ 8 MiB (was R11 256×4 KiB = 1 MiB).
    // Random GET at n≥10k thrashed the 1 MiB pool (~27% of RocksDB at n=20k).
    let sk: Vec<bytes> = vec_new()
    return LsmDB {
        dir: dir, mem: map_new(), tomb: map_new(), mem_n: 0,
        flush_at: 32, compact_at: 3, target_bytes: 0, merge_pick: 0,
        wal_fd: -1, wal_off: 0,
        wal_buf: bytes_new(0), wal_buf_max: 65536, wal_buf_len: 0,
        gens: gens, levels: levels, next_gen: 1, cache: pc_new(4096, 2048),
        blooms: bloom_cache_new(),
        sst_fds: map_new(), sst_sizes: map_new(), sst_meta: map_new(),
        hot_gen: 0 - 1, hot_off: 0 - 1, hot_n: 0, hot_data: bytes_new(0),
        sync_every: 1, since_sync: 0, manifest_edits: 0,
        write_epoch: 0, scan_epoch: 0 - 1, scan_pat: bytes_new(0), scan_keys: sk,
        ok: 1
    }
}

// Build LsmDB skeleton from on-disk MANIFEST (R26 via manifest.baga).
// R40: snapshot + edit log replay.

fn lsm_read_manifest(dir: str) -> LsmDB !IO {
    let m = lsm_load_manifest(dir)?
    if vec_len(m.gens) == 0 && m.next_gen == 1 {
        // Empty / missing file — same as fresh DB (WAL may still exist).
        let body = read_file(lsm_manifest_path(dir))?
        let logb = read_file(lsm_manifest_log_path(dir))?
        if body == "" && logb == "" {
            return lsm_empty_db(dir)
        }
    }
    // Count pending log lines so compact threshold still works after reopen.
    let edits = lsm_manifest_log_lines(dir)?
    let sk: Vec<bytes> = vec_new()
    return LsmDB {
        dir: dir, mem: map_new(), tomb: map_new(), mem_n: 0,
        flush_at: 32, compact_at: 3, target_bytes: 0, merge_pick: 0,
        wal_fd: -1, wal_off: 0,
        wal_buf: bytes_new(0), wal_buf_max: 65536, wal_buf_len: 0,
        gens: m.gens, levels: m.levels, next_gen: m.next_gen,
        cache: pc_new(4096, 2048),
        blooms: bloom_cache_new(),
        sst_fds: map_new(), sst_sizes: map_new(), sst_meta: map_new(),
        hot_gen: 0 - 1, hot_off: 0 - 1, hot_n: 0, hot_data: bytes_new(0),
        sync_every: 1, since_sync: 0, manifest_edits: edits,
        write_epoch: 0, scan_epoch: 0 - 1, scan_pat: bytes_new(0), scan_keys: sk,
        ok: 1
    }
}


fn lsm_open(dir: str, flush_at: i64, compact_at: i64) -> LsmDB !IO {
    let mut db = lsm_read_manifest(dir)?
    db.dir = dir
    if flush_at > 0 {
        db.flush_at = flush_at
    }
    if compact_at > 0 {
        db.compact_at = compact_at
    }
    let wfd = open(lsm_wal_path(dir), 66, 420)?
    if wfd < 0 {
        db.ok = 0
        return db
    }
    db.wal_fd = wfd
    let rp = wal_replay(wfd)?
    db.wal_off = rp.end_off
    for i in 0..vec_len(rp.ops) {
        // R44: single-store open only applies CF 0 / legacy records.
        let mut cf: i64 = 0
        if i < vec_len(rp.cfs) {
            cf = vec_get(rp.cfs, i)
        }
        if cf == 0 {
            let op = vec_get(rp.ops, i)
            let k = vec_get(rp.keys, i)   // R67: bytes key straight off the wire
            let v = vec_get(rp.vals, i)
            if op == 1 {
                map_set(db.mem, k, v)
                map_del(db.tomb, k)
            } else {
                map_del(db.mem, k)
                map_set(db.tomb, k, 1)
            }
            db.mem_n = db.mem_n + 1
        }
    }
    db.ok = 1
    return db
}

// Flush pending WAL buffer to the fd (no fdatasync).

fn lsm_close(db: LsmDB) -> i64 !IO {
    let mut d = db
    // R40: fold edit log into atomic snapshot on close (clean on-disk form).
    if d.manifest_edits > 0 {
        if lsm_write_manifest(d.dir, d.next_gen, d.gens, d.levels)? != 0 {
            // still try to close WAL below
        } else {
            d.manifest_edits = 0
        }
    }
    if d.wal_fd >= 0 {
        d = lsm_wal_flush_buf(d)?
        fdatasync(d.wal_fd)?
        close(d.wal_fd)
    }
    // Maps are shared — close cached SST fds without return-updated dance.
    // R19: unregister each gen from the page-cache fd registry.
    let ks = map_keys(d.sst_fds)
    for i in 0..vec_len(ks) {
        let g = vec_get(ks, i)
        let fd = map_get(d.sst_fds, g)
        if fd >= 0 {
            close(fd)
        }
        map_del(d.sst_fds, g)
        map_del(d.sst_sizes, g)
        pc_unregister_file(d.cache, g)
    }
    return 0
}

// R42: delete all durable files for one store path (after close).
// WAL, MANIFEST(+log/tmp), SST/bloom gens 1..512.

fn lsm_flushdb(db: LsmDB) -> LsmDB !IO {
    let path = db.dir
    let flush_at = db.flush_at
    let compact_at = db.compact_at
    let sync_every = db.sync_every
    let target_bytes = db.target_bytes
    let merge_pick = db.merge_pick
    lsm_close(db)?
    lsm_path_wipe(path)?
    let mut ndb = lsm_open(path, flush_at, compact_at)?
    if sync_every > 0 {
        ndb.sync_every = sync_every
    }
    ndb.target_bytes = target_bytes
    ndb.merge_pick = merge_pick
    return ndb
}

// R58: binary file copy (1 MiB chunks; O_RDONLY → O_CREAT|O_TRUNC).

fn lsm_checkpoint(db: LsmDB, dest: str) -> LsmDB !IO !Time {
    db = lsm_flush_force(db)?
    if db.ok == 0 {
        return db
    }
    let mut i: i64 = 0
    while i < vec_len(db.gens) {
        let g = vec_get(db.gens, i)
        let gs = int_to_str(g)
        if lsm_copy_file(concat(concat(db.dir, ".sst."), gs), concat(concat(dest, ".sst."), gs))? != 0 {
            db.ok = 0
            return db
        }
        let bl_src = concat(concat(db.dir, ".bloom."), gs)
        if file_exists(bl_src) == 1 {
            if lsm_copy_file(bl_src, concat(concat(dest, ".bloom."), gs))? != 0 {
                db.ok = 0
                return db
            }
        }
        i = i + 1
    }
    if lsm_write_manifest(dest, db.next_gen, db.gens, db.levels)? != 0 {
        db.ok = 0
    }
    return db
}


fn lsm_scan_keys_free_data(ks: Vec<bytes>) {
    let mut i: i64 = 0
    while i < vec_len(ks) {
        let k = vec_get(ks, i)
        drop(k)
        i = i + 1
    }
}

// R63: invalidate SCAN snapshot after a write/flush that changes the live set.

fn lsm_scan_touch(db: LsmDB) -> LsmDB {
    db.write_epoch = db.write_epoch + 1
    if vec_len(db.scan_keys) > 0 {
        let old = db.scan_keys
        // MEM-4: заместващият vec остава в shared store след rewind
        mem_persist_begin()
        db.scan_keys = vec_new()
        mem_persist_end()
        lsm_scan_keys_free_data(old)
        drop(old)
    }
    db.scan_epoch = 0 - 1
    let opat = db.scan_pat
    mem_persist_begin()
    db.scan_pat = bytes_new(0)
    mem_persist_end()
    drop(opat)
    return db
}

// R67: bytes-key core — put raw value bytes under a raw key (no TTL envelope).
// Clears any previous TTL.

fn lsm_put_kb(db: LsmDB, key: bytes, val: bytes) -> LsmDB !IO !Time {
    db = lsm_wal_append(db, 1, key, val)?
    if db.ok == 0 {
        return db
    }
    // MEM-4: memtable-ът е cross-request state; map_set пази указатели
    // (без deep-copy) → bytes_slice в persist регион.
    mem_persist_begin()
    map_set(db.mem, bytes_slice(key, 0, bytes_len(key)), bytes_slice(val, 0, bytes_len(val)))
    mem_persist_end()
    // R22: skip tomb probe when empty (hot put path).
    if map_len(db.tomb) > 0 {
        map_del(db.tomb, key)
    }
    db.mem_n = db.mem_n + 1
    db = lsm_scan_touch(db)
    db = lsm_maybe_sync(db)?
    if db.mem_n >= db.flush_at {
        db = lsm_flush(db)?
    }
    return db
}

// Put raw value bytes (no TTL envelope). Clears any previous TTL.

fn lsm_put_b(db: LsmDB, key: str, val: bytes) -> LsmDB !IO !Time {
    return lsm_put_kb(db, bytes_of_str(key), val)?
}


fn lsm_put(db: LsmDB, key: str, val: str) -> LsmDB !IO !Time {
    return lsm_put_b(db, key, bytes_of_str(val))?
}

// Put with TTL seconds from now (Redis SETEX). ttl_sec <= 0 → plain put.

fn lsm_put_ex(db: LsmDB, key: str, val: str, ttl_sec: i64) -> LsmDB !IO !Time {
    if ttl_sec <= 0 {
        return lsm_put(db, key, val)?
    }
    return lsm_put_ex_b(db, key, bytes_of_str(val), ttl_sec)?
}

// R65: binary-safe SETEX (value bytes, may contain NUL).

fn lsm_put_ex_b(db: LsmDB, key: str, val: bytes, ttl_sec: i64) -> LsmDB !IO !Time {
    return lsm_put_ex_kb(db, bytes_of_str(key), val, ttl_sec)?
}

// R67: bytes-key SETEX core.

fn lsm_put_ex_kb(db: LsmDB, key: bytes, val: bytes, ttl_sec: i64) -> LsmDB !IO !Time {
    if ttl_sec <= 0 {
        return lsm_put_kb(db, key, val)?
    }
    let now = time_now_ms()?
    let exp = now + ttl_sec * 1000
    let packed = ttl_pack(val, exp)
    return lsm_put_kb(db, key, packed)?
}

// R67: bytes-key delete core.

fn lsm_del_kb(db: LsmDB, key: bytes) -> LsmDB !IO !Time {
    db = lsm_wal_append(db, 2, key, bytes_new(0))?
    if db.ok == 0 {
        return db
    }
    map_del(db.mem, key)
    // MEM-4: tomb ключът е cross-request state — deep-copy в persist
    mem_persist_begin()
    map_set(db.tomb, bytes_slice(key, 0, bytes_len(key)), 1)
    mem_persist_end()
    db.mem_n = db.mem_n + 1
    db = lsm_scan_touch(db)
    db = lsm_maybe_sync(db)?
    if db.mem_n >= db.flush_at {
        db = lsm_flush(db)?
    }
    return db
}


fn lsm_del(db: LsmDB, key: str) -> LsmDB !IO !Time {
    return lsm_del_kb(db, bytes_of_str(key))?
}


struct LsmGet {
    db: LsmDB,
    found: i64,
    val: bytes
}

// Internal: resolve raw stored bytes → user val, lazy-delete if expired.

fn lsm_resolve(db: LsmDB, key: bytes, raw: bytes, now: i64) -> LsmGet !IO !Time {
    let u = ttl_unpack(raw)
    if ttl_expired(u.expire_at, now) == 1 {
        db = lsm_del_kb(db, key)?
        return LsmGet { db: db, found: 0, val: bytes_new(0) }
    }
    return LsmGet { db: db, found: 1, val: u.val }
}

// R67: bytes-key get core.

fn lsm_get_kb(db: LsmDB, key: bytes) -> LsmGet !IO !Time {
    // R23: defer time_now until a live value needs TTL check.
    // R25: skip map probes when empty (post-flush SST-only path).
    if map_len(db.tomb) > 0 {
        if map_has(db.tomb, key) == 1 {
            return LsmGet { db: db, found: 0, val: bytes_new(0) }
        }
    }
    if map_len(db.mem) > 0 {
        if map_has(db.mem, key) == 1 {
            let now = time_now_ms()?
            return lsm_resolve(db, key, map_get(db.mem, key), now)?
        }
    }
    let lk = sst_get(db.cache, db.blooms, db.sst_fds, db.sst_sizes, db.sst_meta,
                     db.dir, db.gens, key,
                     db.hot_gen, db.hot_off, db.hot_n, db.hot_data)?
    db.cache = lk.pc
    db.blooms = lk.blooms
    db.sst_fds = lk.sst_fds
    db.sst_sizes = lk.sst_sizes
    db.sst_meta = lk.sst_meta
    db.hot_gen = lk.hot_gen
    db.hot_off = lk.hot_off
    db.hot_n = lk.hot_n
    db.hot_data = lk.hot_data
    if lk.found == 1 {
        if lk.alive == 1 {
            let now = time_now_ms()?
            return lsm_resolve(db, key, lk.val, now)?
        }
        return LsmGet { db: db, found: 0, val: bytes_new(0) }
    }
    return LsmGet { db: db, found: 0, val: bytes_new(0) }
}


fn lsm_get(db: LsmDB, key: str) -> LsmGet !IO !Time {
    return lsm_get_kb(db, bytes_of_str(key))?
}


fn lsm_exists_kb(db: LsmDB, key: bytes) -> LsmGet !IO !Time {
    return lsm_get_kb(db, key)?
}


fn lsm_exists(db: LsmDB, key: str) -> LsmGet !IO !Time {
    return lsm_get(db, key)?
}

// EXPIRE key seconds — Redis: 1 if timeout set, 0 if key missing.

fn lsm_flush(db: LsmDB) -> LsmDB !IO !Time {
    let now = time_now_ms()?
    // R21: sort map_keys in place (no mem-key copy); append pure tombs only.
    // R67: keys are raw bytes — sort via bytes_cmp.
    let all = map_keys(db.mem)
    let tk = map_keys(db.tomb)
    let ntom = vec_len(tk)
    let mut ti: i64 = 0
    while ti < ntom {
        let k = vec_get(tk, ti)
        if map_has(db.mem, k) == 0 {
            vec_push(all, k)
        }
        ti = ti + 1
    }
    sort_bytes(all)
    let nall = vec_len(all)
    let rows: Vec<SstRow> = vec_new()
    let mut i: i64 = 0
    while i < nall {
        let k = vec_get(all, i)
        // Pure tomb: in tomb set and not in mem (already filtered for keys only
        // in tomb; live keys may still be tomb-superseded — use mem presence).
        if map_has(db.mem, k) == 0 {
            vec_push(rows, SstRow { op: 2, key: k, val: bytes_new(0) })
        } else {
            let raw = map_get(db.mem, k)
            let u = ttl_unpack(raw)
            if ttl_expired(u.expire_at, now) == 1 {
                // drop expired; write tomb so older SST versions are hidden
                vec_push(rows, SstRow { op: 2, key: k, val: bytes_new(0) })
            } else {
                vec_push(rows, SstRow { op: 1, key: k, val: raw })
            }
        }
        i = i + 1
    }
    // Durable boundary before SST: drain WAL buffer then fsync.
    db = lsm_wal_flush_buf(db)?
    if db.ok == 0 {
        return db
    }
    fdatasync(db.wal_fd)?
    let gen = db.next_gen
    if vec_len(rows) > 0 {
        if sst_write(db.dir, gen, rows)? != 0 {
            db.ok = 0
            return db
        }
        // MEM-4: gens/levels са cross-request state — grow в persist
        mem_persist_begin()
        vec_push(db.gens, gen)
        vec_push(db.levels, 0)   // L0
        mem_persist_end()
        db.next_gen = gen + 1
    }
    drop(rows)  // R18: on disk; vals stay with db.mem until it is replaced
    // R40: append version edit (ADD+NEXT) instead of full snapshot rewrite.
    if gen < db.next_gen {
        // we wrote an L0 SST at `gen` and bumped next_gen
        let na = lsm_manifest_log_add(db.dir, gen, 0, db.next_gen)?
        if na < 0 {
            db.ok = 0
            return db
        }
        db.manifest_edits = db.manifest_edits + na
    } else {
        // empty flush still durable-rotate WAL — snapshot next_gen only via N
        let t = concat(concat("N ", int_to_str(db.next_gen)), "\n")
        if lsm_manifest_log_append(db.dir, t)? != 0 {
            db.ok = 0
            return db
        }
        db.manifest_edits = db.manifest_edits + 1
    }
    let ec = lsm_manifest_maybe_compact(
        db.dir, db.next_gen, db.gens, db.levels, db.manifest_edits
    )?
    if ec < 0 {
        db.ok = 0
        return db
    }
    db.manifest_edits = ec
    close(db.wal_fd)
    unlink(lsm_wal_path(db.dir))?
    let wfd = open(lsm_wal_path(db.dir), 578, 420)?
    if wfd < 0 {
        db.ok = 0
        return db
    }
    db.wal_fd = wfd
    db.wal_off = 0
    db.wal_buf_len = 0  // R18: keep the allocated buffer
    // MEM-4: свежите memtable maps живеят в shared store след rewind
    mem_persist_begin()
    db.mem = map_new()
    db.tomb = map_new()
    mem_persist_end()
    db.mem_n = 0
    db.since_sync = 0
    // L0..L3 compaction (chain while any level is over file or byte threshold)
    let mut guard: i64 = 0
    let mut more: i64 = 1
    while more == 1 && guard < 32 {
        let n0 = lsm_count_level(db.levels, 0)
        let n1 = lsm_count_level(db.levels, 1)
        let n2 = lsm_count_level(db.levels, 2)
        let n3 = lsm_count_level(db.levels, 3)
        let b0 = lsm_level_bytes(db, 0)?
        let b1 = lsm_level_bytes(db, 1)?
        let b2 = lsm_level_bytes(db, 2)?
        let b3 = lsm_level_bytes(db, 3)?
        let over0 = lsm_level_over(db, 0, n0, b0)
        let over1 = lsm_level_over(db, 1, n1, b1)
        let over2 = lsm_level_over(db, 2, n2, b2)
        let over3 = lsm_level_over(db, 3, n3, b3)
        // File-count legacy: pair collapse L1/L2/L3 when byte targets off
        let mut pair: i64 = 0
        if db.target_bytes <= 0 {
            if n1 >= 2 || n2 >= 2 || n3 >= 2 {
                pair = 1
            }
        }
        if over0 == 1 || over1 == 1 || over2 == 1 || over3 == 1 || pair == 1 {
            db = lsm_compact(db)?
            guard = guard + 1
        } else {
            more = 0
        }
    }
    return db
}


fn lsm_flush_force(db: LsmDB) -> LsmDB !IO !Time {
    if db.mem_n == 0 {
        return db
    }
    return lsm_flush(db)?
}

