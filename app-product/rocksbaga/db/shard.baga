// shard.baga — key-hash multi-shard cluster (R32 multi-writer foundation).
//
// Model (honest):
//   • Keys are partitioned by hash into N independent LsmDB instances
//     (separate WAL/SST/MANIFEST prefixes: <dir>.s0 … <dir>.s{N-1}).
//   • The RESP poll loop remains single-threaded; shards shrink per-key
//     working sets and enable future per-shard workers without API break.
//   • Not RocksDB ColumnFamily / concurrent memtable writers.
//
// Env: LSM_SHARDS=N (default 1).

import "engine.baga"
import "../cache/page.baga"
import "../util/codec.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"
import "std/os/os.baga"

struct LsmCluster {
    shards: Vec<LsmDB>,
    n: i64,
    // R63: cluster-level SCAN snapshot (merged live keys).
    // Valid while scan_epoch equals sum of shard write_epochs and MATCH matches.
    // R68: snapshot and MATCH pattern are raw bytes.
    scan_epoch: i64,
    scan_pat: bytes,
    scan_keys: Vec<bytes>,
    ok: i64
}

// djb2-ish over key bytes (stable, fast).
fn lsm_key_hash(key: str) -> i64 {
    let mut h: i64 = 5381
    let n = len(key)
    let mut i: i64 = 0
    while i < n {
        h = ((h * 33) + (char_at(key, i) & 255)) & 2147483647
        i = i + 1
    }
    return h
}

// R67: same djb2-ish hash over raw key bytes — identical digest for the same
// byte sequence, so str and bytes callers route to the same shard.
fn lsm_key_hash_b(key: bytes) -> i64 {
    let mut h: i64 = 5381
    let n = bytes_len(key)
    let mut i: i64 = 0
    while i < n {
        h = ((h * 33) + (bytes_at(key, i) & 255)) & 2147483647
        i = i + 1
    }
    return h
}

fn lsm_shard_ix(nshards: i64, key: str) -> i64 {
    let mut n = nshards
    if n < 1 {
        n = 1
    }
    let mut i = lsm_key_hash(key) % n
    if i < 0 {
        i = 0 - i
    }
    return i
}

// R67: bytes-key shard routing (engine _kb path).
fn lsm_shard_ix_b(nshards: i64, key: bytes) -> i64 {
    let mut n = nshards
    if n < 1 {
        n = 1
    }
    let mut i = lsm_key_hash_b(key) % n
    if i < 0 {
        i = 0 - i
    }
    return i
}

// Path for shard i. N=1 uses `dir` unchanged (compat with pre-R32 single store).
fn lsm_shard_path(dir: str, i: i64, nshards: i64) -> str {
    if nshards <= 1 {
        return dir
    }
    return concat(concat(dir, ".s"), int_to_str(i))
}

fn lsm_cluster_open(dir: str, nshards: i64, flush_at: i64, compact_at: i64) -> LsmCluster !IO {
    let mut n = nshards
    if n < 1 {
        n = 1
    }
    if n > 64 {
        n = 64
    }
    let shards: Vec<LsmDB> = vec_new()
    let mut i: i64 = 0
    let mut ok: i64 = 1
    while i < n {
        let path = lsm_shard_path(dir, i, n)
        let db = lsm_open(path, flush_at, compact_at)?
        if db.ok == 0 {
            ok = 0
        }
        vec_push(shards, db)
        i = i + 1
    }
    let sk: Vec<bytes> = vec_new()
    return LsmCluster {
        shards: shards, n: n,
        scan_epoch: 0 - 1, scan_pat: bytes_new(0), scan_keys: sk,
        ok: ok
    }
}

fn lsm_cluster_close(c: LsmCluster) -> i64 !IO {
    let mut i: i64 = 0
    while i < c.n {
        let db = vec_get(c.shards, i)
        lsm_close(db)?
        i = i + 1
    }
    return 0
}

fn lsm_cluster_get_shard(c: LsmCluster, i: i64) -> LsmDB {
    return vec_get(c.shards, i)
}

fn lsm_cluster_set_shard(c: LsmCluster, i: i64, db: LsmDB) -> LsmCluster {
    vec_set(c.shards, i, db)
    return c
}

fn lsm_cluster_put(c: LsmCluster, key: str, val: str) -> LsmCluster !IO !Time {
    return lsm_cluster_put_b(c, key, bytes_of_str(val))?
}

// R65: binary-safe put (value may contain NUL).
fn lsm_cluster_put_b(c: LsmCluster, key: str, val: bytes) -> LsmCluster !IO !Time {
    return lsm_cluster_put_kb(c, bytes_of_str(key), val)?
}

// R68: bytes-key put core — routes via lsm_shard_ix_b (same digest as the
// str hash for the same byte sequence, so str and bytes callers share shards).
fn lsm_cluster_put_kb(c: LsmCluster, key: bytes, val: bytes) -> LsmCluster !IO !Time {
    let i = lsm_shard_ix_b(c.n, key)
    let mut db = vec_get(c.shards, i)
    db = lsm_put_kb(db, key, val)?
    vec_set(c.shards, i, db)
    c.ok = db.ok
    return c
}

fn lsm_cluster_put_ex(c: LsmCluster, key: str, val: str, ttl_sec: i64) -> LsmCluster !IO !Time {
    return lsm_cluster_put_ex_b(c, key, bytes_of_str(val), ttl_sec)?
}

fn lsm_cluster_put_ex_b(c: LsmCluster, key: str, val: bytes, ttl_sec: i64) -> LsmCluster !IO !Time {
    return lsm_cluster_put_ex_kb(c, bytes_of_str(key), val, ttl_sec)?
}

// R68: bytes-key SETEX core.
fn lsm_cluster_put_ex_kb(c: LsmCluster, key: bytes, val: bytes, ttl_sec: i64) -> LsmCluster !IO !Time {
    let i = lsm_shard_ix_b(c.n, key)
    let mut db = vec_get(c.shards, i)
    db = lsm_put_ex_kb(db, key, val, ttl_sec)?
    vec_set(c.shards, i, db)
    c.ok = db.ok
    return c
}

fn lsm_cluster_del(c: LsmCluster, key: str) -> LsmCluster !IO !Time {
    return lsm_cluster_del_kb(c, bytes_of_str(key))?
}

// R68: bytes-key delete core.
fn lsm_cluster_del_kb(c: LsmCluster, key: bytes) -> LsmCluster !IO !Time {
    let i = lsm_shard_ix_b(c.n, key)
    let mut db = vec_get(c.shards, i)
    db = lsm_del_kb(db, key)?
    vec_set(c.shards, i, db)
    c.ok = db.ok
    return c
}

// R60: checkpoint every shard — dest for n==1, dest.s{i} for n>1.
fn lsm_cluster_checkpoint(c: LsmCluster, dest: str) -> LsmCluster !IO !Time {
    let mut i: i64 = 0
    while i < c.n {
        let mut db = vec_get(c.shards, i)
        let mut d = dest
        if c.n > 1 {
            d = concat(concat(dest, ".s"), int_to_str(i))
        }
        db = lsm_checkpoint(db, d)?
        vec_set(c.shards, i, db)
        if db.ok == 0 {
            c.ok = 0
            return c
        }
        i = i + 1
    }
    return c
}

struct LsmClusterGet {
    c: LsmCluster,
    found: i64,
    val: bytes
}

fn lsm_cluster_get(c: LsmCluster, key: str) -> LsmClusterGet !IO !Time {
    return lsm_cluster_get_kb(c, bytes_of_str(key))?
}

// R68: bytes-key get core.
fn lsm_cluster_get_kb(c: LsmCluster, key: bytes) -> LsmClusterGet !IO !Time {
    let i = lsm_shard_ix_b(c.n, key)
    let mut db = vec_get(c.shards, i)
    let g = lsm_get_kb(db, key)?
    db = g.db
    vec_set(c.shards, i, db)
    return LsmClusterGet { c: c, found: g.found, val: g.val }
}

fn lsm_cluster_flush_force(c: LsmCluster) -> LsmCluster !IO !Time {
    let mut i: i64 = 0
    while i < c.n {
        let mut db = vec_get(c.shards, i)
        db = lsm_flush_force(db)?
        vec_set(c.shards, i, db)
        if db.ok == 0 {
            c.ok = 0
        }
        i = i + 1
    }
    return c
}

// R42: wipe every shard path and reopen empty (Redis FLUSHDB).
fn lsm_cluster_flushdb(c: LsmCluster) -> LsmCluster !IO {
    let n = c.n
    let mut ok: i64 = 1
    let shards: Vec<LsmDB> = vec_new()
    let mut i: i64 = 0
    while i < n {
        let db = vec_get(c.shards, i)
        let ndb = lsm_flushdb(db)?
        if ndb.ok == 0 {
            ok = 0
        }
        vec_push(shards, ndb)
        i = i + 1
    }
    let sk: Vec<bytes> = vec_new()
    return LsmCluster {
        shards: shards, n: n,
        scan_epoch: 0 - 1, scan_pat: bytes_new(0), scan_keys: sk,
        ok: ok
    }
}

struct LsmClusterKeys {
    c: LsmCluster,
    keys: Vec<str>
}

// R68: bytes-key sibling of LsmClusterKeys (wire path).
struct LsmClusterKeysB {
    c: LsmCluster,
    keys: Vec<bytes>
}

// R68: bytes-key KEYS core — merge raw live keys from all shards (sorted).
fn lsm_cluster_keys_kb(c: LsmCluster) -> LsmClusterKeysB !IO !Time {
    let all: Vec<bytes> = vec_new()
    let mut i: i64 = 0
    while i < c.n {
        let mut db = vec_get(c.shards, i)
        let kr = lsm_keys_kb(db)?
        db = kr.db
        vec_set(c.shards, i, db)
        let mut j: i64 = 0
        while j < vec_len(kr.keys) {
            vec_push(all, vec_get(kr.keys, j))
            j = j + 1
        }
        i = i + 1
    }
    sort_bytes(all)
    return LsmClusterKeysB { c: c, keys: all }
}

// Merge KEYS from all shards (sorted). str wrapper — NUL keys truncate
// (use lsm_cluster_keys_kb on the wire path, R68).
fn lsm_cluster_keys(c: LsmCluster) -> LsmClusterKeys !IO !Time {
    let r = lsm_cluster_keys_kb(c)?
    let out: Vec<str> = vec_new()
    for i in 0..vec_len(r.keys) {
        vec_push(out, str_of_bytes(vec_get(r.keys, i)))
    }
    return LsmClusterKeys { c: r.c, keys: out }
}

struct LsmClusterSize {
    c: LsmCluster,
    n: i64
}

fn lsm_cluster_dbsize(c: LsmCluster) -> LsmClusterSize !IO !Time {
    let mut total: i64 = 0
    let mut i: i64 = 0
    while i < c.n {
        let mut db = vec_get(c.shards, i)
        let ds = lsm_dbsize(db)?
        db = ds.db
        vec_set(c.shards, i, db)
        total = total + ds.n
        i = i + 1
    }
    return LsmClusterSize { c: c, n: total }
}

struct LsmClusterScan {
    c: LsmCluster,
    next: i64,
    keys: Vec<str>
}

// R68: bytes-key sibling of LsmClusterScan (wire path).
struct LsmClusterScanB {
    c: LsmCluster,
    next: i64,
    keys: Vec<bytes>
}

// Sum of per-shard write_epochs — cluster SCAN cache key.
fn lsm_cluster_write_epoch(c: LsmCluster) -> i64 {
    let mut e: i64 = 0
    let mut i: i64 = 0
    while i < c.n {
        let db = vec_get(c.shards, i)
        e = e + db.write_epoch
        i = i + 1
    }
    return e
}

// R68: rebuild cluster SCAN snapshot from a raw-bytes MATCH pattern
// (unordered, MATCH-filtered over raw key bytes).
fn lsm_cluster_scan_rebuild_b(c: LsmCluster, match_pat: bytes) -> LsmCluster !IO !Time {
    // Gather live keys per shard without global sort (SCAN is unordered).
    let filtered: Vec<bytes> = vec_new()
    let mut i: i64 = 0
    while i < c.n {
        let mut db = vec_get(c.shards, i)
        let r = lsm_live_map_kb(db)?
        db = r.db
        vec_set(c.shards, i, db)
        let mut j: i64 = 0
        while j < vec_len(r.keys) {
            let k = vec_get(r.keys, j)
            if lsm_match_glob_b(match_pat, k) == 1 {
                vec_push(filtered, k)
            }
            j = j + 1
        }
        i = i + 1
    }
    if vec_len(c.scan_keys) > 0 {
        let old = c.scan_keys
        c.scan_keys = filtered
        drop(old)
    } else {
        c.scan_keys = filtered
    }
    c.scan_pat = match_pat
    c.scan_epoch = lsm_cluster_write_epoch(c)
    return c
}

// R68: bytes-key SCAN core over merged live keys of all shards.
// R63: one live fold per write-epoch×MATCH; subsequent pages are O(count).
fn lsm_cluster_scan_kb(c: LsmCluster, cursor: i64, count: i64, match_pat: bytes) -> LsmClusterScanB !IO !Time {
    let epoch = lsm_cluster_write_epoch(c)
    if c.scan_epoch != epoch || bytes_eq_b(c.scan_pat, match_pat) == false {
        c = lsm_cluster_scan_rebuild_b(c, match_pat)?
    }
    let n = vec_len(c.scan_keys)
    let mut cur = cursor
    if cur < 0 {
        cur = 0
    }
    if cur > n {
        cur = n
    }
    let mut cnt = count
    if cnt < 1 {
        cnt = 10
    }
    if cnt > 1000 {
        cnt = 1000
    }
    let out: Vec<bytes> = vec_new()
    let mut j = cur
    let mut taken: i64 = 0
    while j < n && taken < cnt {
        vec_push(out, vec_get(c.scan_keys, j))
        j = j + 1
        taken = taken + 1
    }
    let mut next: i64 = j
    if next >= n {
        next = 0
        if vec_len(c.scan_keys) > 0 {
            let old = c.scan_keys
            c.scan_keys = vec_new()
            drop(old)
        }
        c.scan_epoch = 0 - 1
        c.scan_pat = bytes_new(0)
    }
    return LsmClusterScanB { c: c, next: next, keys: out }
}

// str-keyed compat wrapper (NUL keys truncate in the result — R68 wire path
// uses lsm_cluster_scan_kb).
fn lsm_cluster_scan(c: LsmCluster, cursor: i64, count: i64, match_pat: str) -> LsmClusterScan !IO !Time {
    let r = lsm_cluster_scan_kb(c, cursor, count, bytes_of_str(match_pat))?
    let out: Vec<str> = vec_new()
    for i in 0..vec_len(r.keys) {
        vec_push(out, str_of_bytes(vec_get(r.keys, i)))
    }
    return LsmClusterScan { c: r.c, next: r.next, keys: out }
}

struct LsmClusterExpire {
    c: LsmCluster,
    ok: i64
}

fn lsm_cluster_expire(c: LsmCluster, key: str, ttl_sec: i64) -> LsmClusterExpire !IO !Time {
    return lsm_cluster_expire_kb(c, bytes_of_str(key), ttl_sec)?
}

// R68: bytes-key EXPIRE core.
fn lsm_cluster_expire_kb(c: LsmCluster, key: bytes, ttl_sec: i64) -> LsmClusterExpire !IO !Time {
    let i = lsm_shard_ix_b(c.n, key)
    let mut db = vec_get(c.shards, i)
    let e = lsm_expire_kb(db, key, ttl_sec)?
    db = e.db
    vec_set(c.shards, i, db)
    return LsmClusterExpire { c: c, ok: e.ok }
}

struct LsmClusterTtl {
    c: LsmCluster,
    n: i64
}

fn lsm_cluster_ttl(c: LsmCluster, key: str) -> LsmClusterTtl !IO !Time {
    return lsm_cluster_ttl_kb(c, bytes_of_str(key))?
}

// R68: bytes-key TTL core.
fn lsm_cluster_ttl_kb(c: LsmCluster, key: bytes) -> LsmClusterTtl !IO !Time {
    let i = lsm_shard_ix_b(c.n, key)
    let mut db = vec_get(c.shards, i)
    let t = lsm_ttl_kb(db, key)?
    db = t.db
    vec_set(c.shards, i, db)
    return LsmClusterTtl { c: c, n: t.n }
}

fn lsm_cluster_persist(c: LsmCluster, key: str) -> LsmClusterExpire !IO !Time {
    return lsm_cluster_persist_kb(c, bytes_of_str(key))?
}

// R68: bytes-key PERSIST core.
fn lsm_cluster_persist_kb(c: LsmCluster, key: bytes) -> LsmClusterExpire !IO !Time {
    let i = lsm_shard_ix_b(c.n, key)
    let mut db = vec_get(c.shards, i)
    let p = lsm_persist_kb(db, key)?
    db = p.db
    vec_set(c.shards, i, db)
    return LsmClusterExpire { c: c, ok: p.ok }
}

// Apply open-time knobs (sync_every, merge_pick, target_bytes, cache) to every shard.
fn lsm_cluster_apply_sync(c: LsmCluster, sync_every: i64) -> LsmCluster {
    if sync_every <= 0 {
        return c
    }
    let mut i: i64 = 0
    while i < c.n {
        let mut db = vec_get(c.shards, i)
        db.sync_every = sync_every
        vec_set(c.shards, i, db)
        i = i + 1
    }
    return c
}

fn lsm_cluster_apply_merge_pick(c: LsmCluster, mp: i64) -> LsmCluster {
    let mut i: i64 = 0
    while i < c.n {
        let mut db = vec_get(c.shards, i)
        db.merge_pick = mp
        vec_set(c.shards, i, db)
        i = i + 1
    }
    return c
}

fn lsm_cluster_apply_target_bytes(c: LsmCluster, tb: i64) -> LsmCluster {
    let mut i: i64 = 0
    while i < c.n {
        let mut db = vec_get(c.shards, i)
        db.target_bytes = tb
        vec_set(c.shards, i, db)
        i = i + 1
    }
    return c
}

fn lsm_cluster_apply_cache(c: LsmCluster, pages: i64) -> LsmCluster {
    if pages < 16 {
        return c
    }
    // Split cache budget across shards (min 16 pages each).
    let mut per = pages / c.n
    if per < 16 {
        per = 16
    }
    let mut i: i64 = 0
    while i < c.n {
        let mut db = vec_get(c.shards, i)
        db.cache = pc_new(4096, per)
        vec_set(c.shards, i, db)
        i = i + 1
    }
    return c
}
