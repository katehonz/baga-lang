// shard.baga — LsmCluster: shard пътища, hash рутиране, open/close,
// put/del/checkpoint. Четенето (get/keys/scan) е в shard_read.baga;
// TTL/EXPIRE/PERSIST — в shard_ttl.baga.

// shard.baga — key-hash multi-shard cluster (R32 multi-writer foundation).
//
// Model (honest):
//   • Keys are partitioned by hash into N independent LsmDB instances
//     (separate WAL/SST/MANIFEST prefixes: <dir>.s0 … <dir>.s{N-1}).
//   • The RESP poll loop remains single-threaded; shards shrink per-key
//     working sets and enable future per-shard workers without API break.
//   • Not RocksDB ColumnFamily / concurrent memtable writers.
//
// Env: LSM_SHARDS=N (default 1).

import "engine.baga"
import "../cache/page.baga"
import "../util/codec.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"
import "std/os/os.baga"

struct LsmCluster {
    shards: Vec<LsmDB>,
    n: i64,
    // R63: cluster-level SCAN snapshot (merged live keys).
    // Valid while scan_epoch equals sum of shard write_epochs and MATCH matches.
    // R68: snapshot and MATCH pattern are raw bytes.
    scan_epoch: i64,
    scan_pat: bytes,
    scan_keys: Vec<bytes>,
    ok: i64
}

// djb2-ish over key bytes (stable, fast).
fn lsm_key_hash(key: str) -> i64 {
    let mut h: i64 = 5381
    let n = len(key)
    let mut i: i64 = 0
    while i < n {
        h = ((h * 33) + (char_at(key, i) & 255)) & 2147483647
        i = i + 1
    }
    return h
}

// R67: same djb2-ish hash over raw key bytes — identical digest for the same
// byte sequence, so str and bytes callers route to the same shard.
fn lsm_key_hash_b(key: bytes) -> i64 {
    let mut h: i64 = 5381
    let n = bytes_len(key)
    let mut i: i64 = 0
    while i < n {
        h = ((h * 33) + (bytes_at(key, i) & 255)) & 2147483647
        i = i + 1
    }
    return h
}

fn lsm_shard_ix(nshards: i64, key: str) -> i64 {
    let mut n = nshards
    if n < 1 {
        n = 1
    }
    let mut i = lsm_key_hash(key) % n
    if i < 0 {
        i = 0 - i
    }
    return i
}

// R67: bytes-key shard routing (engine _kb path).
fn lsm_shard_ix_b(nshards: i64, key: bytes) -> i64 {
    let mut n = nshards
    if n < 1 {
        n = 1
    }
    let mut i = lsm_key_hash_b(key) % n
    if i < 0 {
        i = 0 - i
    }
    return i
}

// Path for shard i. N=1 uses `dir` unchanged (compat with pre-R32 single store).
fn lsm_shard_path(dir: str, i: i64, nshards: i64) -> str {
    if nshards <= 1 {
        return dir
    }
    return concat(concat(dir, ".s"), int_to_str(i))
}

fn lsm_cluster_open(dir: str, nshards: i64, flush_at: i64, compact_at: i64) -> LsmCluster !IO {
    let mut n = nshards
    if n < 1 {
        n = 1
    }
    if n > 64 {
        n = 64
    }
    let shards: Vec<LsmDB> = vec_new()
    let mut i: i64 = 0
    let mut ok: i64 = 1
    while i < n {
        let path = lsm_shard_path(dir, i, n)
        let db = lsm_open(path, flush_at, compact_at)?
        if db.ok == 0 {
            ok = 0
        }
        vec_push(shards, db)
        i = i + 1
    }
    let sk: Vec<bytes> = vec_new()
    return LsmCluster {
        shards: shards, n: n,
        scan_epoch: 0 - 1, scan_pat: bytes_new(0), scan_keys: sk,
        ok: ok
    }
}

fn lsm_cluster_close(c: LsmCluster) -> i64 !IO {
    let mut i: i64 = 0
    while i < c.n {
        let db = vec_get(c.shards, i)
        lsm_close(db)?
        i = i + 1
    }
    return 0
}

fn lsm_cluster_get_shard(c: LsmCluster, i: i64) -> LsmDB {
    return vec_get(c.shards, i)
}

fn lsm_cluster_set_shard(c: LsmCluster, i: i64, db: LsmDB) -> LsmCluster {
    vec_set(c.shards, i, db)
    return c
}

fn lsm_cluster_put(c: LsmCluster, key: str, val: str) -> LsmCluster !IO !Time {
    return lsm_cluster_put_b(c, key, bytes_of_str(val))?
}

// R65: binary-safe put (value may contain NUL).
fn lsm_cluster_put_b(c: LsmCluster, key: str, val: bytes) -> LsmCluster !IO !Time {
    return lsm_cluster_put_kb(c, bytes_of_str(key), val)?
}

// R68: bytes-key put core — routes via lsm_shard_ix_b (same digest as the
// str hash for the same byte sequence, so str and bytes callers share shards).
fn lsm_cluster_put_kb(c: LsmCluster, key: bytes, val: bytes) -> LsmCluster !IO !Time {
    let i = lsm_shard_ix_b(c.n, key)
    let mut db = vec_get(c.shards, i)
    db = lsm_put_kb(db, key, val)?
    vec_set(c.shards, i, db)
    c.ok = db.ok
    return c
}

fn lsm_cluster_put_ex(c: LsmCluster, key: str, val: str, ttl_sec: i64) -> LsmCluster !IO !Time {
    return lsm_cluster_put_ex_b(c, key, bytes_of_str(val), ttl_sec)?
}

fn lsm_cluster_put_ex_b(c: LsmCluster, key: str, val: bytes, ttl_sec: i64) -> LsmCluster !IO !Time {
    return lsm_cluster_put_ex_kb(c, bytes_of_str(key), val, ttl_sec)?
}

// R68: bytes-key SETEX core.
fn lsm_cluster_put_ex_kb(c: LsmCluster, key: bytes, val: bytes, ttl_sec: i64) -> LsmCluster !IO !Time {
    let i = lsm_shard_ix_b(c.n, key)
    let mut db = vec_get(c.shards, i)
    db = lsm_put_ex_kb(db, key, val, ttl_sec)?
    vec_set(c.shards, i, db)
    c.ok = db.ok
    return c
}

fn lsm_cluster_del(c: LsmCluster, key: str) -> LsmCluster !IO !Time {
    return lsm_cluster_del_kb(c, bytes_of_str(key))?
}

// R68: bytes-key delete core.
fn lsm_cluster_del_kb(c: LsmCluster, key: bytes) -> LsmCluster !IO !Time {
    let i = lsm_shard_ix_b(c.n, key)
    let mut db = vec_get(c.shards, i)
    db = lsm_del_kb(db, key)?
    vec_set(c.shards, i, db)
    c.ok = db.ok
    return c
}

// R60: checkpoint every shard — dest for n==1, dest.s{i} for n>1.
fn lsm_cluster_checkpoint(c: LsmCluster, dest: str) -> LsmCluster !IO !Time {
    let mut i: i64 = 0
    while i < c.n {
        let mut db = vec_get(c.shards, i)
        let mut d = dest
        if c.n > 1 {
            d = concat(concat(dest, ".s"), int_to_str(i))
        }
        db = lsm_checkpoint(db, d)?
        vec_set(c.shards, i, db)
        if db.ok == 0 {
            c.ok = 0
            return c
        }
        i = i + 1
    }
    return c
}

