// manifest.baga — version set on disk (snapshot + edit log).
//
// R26: flat MANIFEST (next_gen + gen/level lines).
// R39: atomic snapshot publish (tmp + fsync + rename).
// R40: append-only version edit log (dir.manifest.log):
//   A <gen> <level>   — add SST
//   D <gen>           — delete SST
//   N <next_gen>      — bump next_gen
// Load = snapshot + replay log. After many edits (or on close) compact:
//   atomic snapshot of full state + truncate log.
//
// Legacy snapshot lines with only <gen> mean level 0.

import "std/os/os.baga"
import "std/str/str.baga"

fn lsm_manifest_path(dir: str) -> str {
    return concat(dir, ".manifest")
}

fn lsm_manifest_tmp_path(dir: str) -> str {
    return concat(dir, ".manifest.tmp")
}

fn lsm_manifest_log_path(dir: str) -> str {
    return concat(dir, ".manifest.log")
}

// Compact log into snapshot after this many edit lines (R40).
fn LSM_MANIFEST_LOG_COMPACT_AT() -> i64 { return 32 }

struct LsmManifest {
    next_gen: i64,
    gens: Vec<i64>,
    levels: Vec<i64>,
    ok: i64
}

fn lsm_manifest_empty() -> LsmManifest {
    let gens: Vec<i64> = vec_new()
    let levels: Vec<i64> = vec_new()
    return LsmManifest { next_gen: 1, gens: gens, levels: levels, ok: 1 }
}

// Encode snapshot body (no IO).
fn lsm_format_manifest(next_gen: i64, gens: Vec<i64>, levels: Vec<i64>) -> str {
    let mut s = concat(int_to_str(next_gen), "\n")
    let n = vec_len(gens)
    let mut i: i64 = 0
    while i < n {
        let mut lv: i64 = 0
        if i < vec_len(levels) {
            lv = vec_get(levels, i)
        }
        s = concat(s, concat(int_to_str(vec_get(gens, i)), " "))
        s = concat(s, concat(int_to_str(lv), "\n"))
        i = i + 1
    }
    return s
}

// Parse snapshot body text into gens/levels/next_gen.
fn lsm_parse_manifest(body: str) -> LsmManifest {
    let gens: Vec<i64> = vec_new()
    let levels: Vec<i64> = vec_new()
    if body == "" {
        return LsmManifest { next_gen: 1, gens: gens, levels: levels, ok: 1 }
    }
    let lines = str_split(body, "\n")
    let mut next_gen: i64 = 1
    if vec_len(lines) > 0 && vec_get(lines, 0) != "" {
        next_gen = parse_int(vec_get(lines, 0))
        if next_gen < 1 {
            next_gen = 1
        }
    }
    for i in 1..vec_len(lines) {
        let ln = vec_get(lines, i)
        if ln != "" {
            let parts = str_split(ln, " ")
            let g = parse_int(vec_get(parts, 0))
            if g > 0 {
                vec_push(gens, g)
                let mut lv: i64 = 0
                if vec_len(parts) >= 2 {
                    lv = parse_int(vec_get(parts, 1))
                    if lv < 0 {
                        lv = 0
                    }
                    if lv > 3 {
                        lv = 3
                    }
                }
                vec_push(levels, lv)
            }
        }
    }
    return LsmManifest {
        next_gen: next_gen, gens: gens, levels: levels, ok: 1
    }
}

// Remove gen from gens/levels (first match).
fn lsm_manifest_del_gen(m: LsmManifest, gen: i64) -> LsmManifest {
    let ng: Vec<i64> = vec_new()
    let nl: Vec<i64> = vec_new()
    let n = vec_len(m.gens)
    let mut i: i64 = 0
    while i < n {
        if vec_get(m.gens, i) != gen {
            vec_push(ng, vec_get(m.gens, i))
            let mut lv: i64 = 0
            if i < vec_len(m.levels) {
                lv = vec_get(m.levels, i)
            }
            vec_push(nl, lv)
        }
        i = i + 1
    }
    m.gens = ng
    m.levels = nl
    return m
}

// Apply one edit-log line. Returns updated manifest.
fn lsm_manifest_apply_line(m: LsmManifest, ln: str) -> LsmManifest {
    if ln == "" {
        return m
    }
    let parts = str_split(ln, " ")
    if vec_len(parts) < 1 {
        return m
    }
    let op = vec_get(parts, 0)
    // ADD: A gen level
    if op == "A" && vec_len(parts) >= 3 {
        let g = parse_int(vec_get(parts, 1))
        let mut lv = parse_int(vec_get(parts, 2))
        if g > 0 {
            // skip duplicate gen
            let mut has: i64 = 0
            let mut i: i64 = 0
            while i < vec_len(m.gens) {
                if vec_get(m.gens, i) == g {
                    has = 1
                }
                i = i + 1
            }
            if has == 0 {
                vec_push(m.gens, g)
                if lv < 0 {
                    lv = 0
                }
                if lv > 3 {
                    lv = 3
                }
                vec_push(m.levels, lv)
            }
        }
        return m
    }
    // DEL: D gen
    if op == "D" && vec_len(parts) >= 2 {
        let g = parse_int(vec_get(parts, 1))
        if g > 0 {
            m = lsm_manifest_del_gen(m, g)
        }
        return m
    }
    // NEXT: N next_gen
    if op == "N" && vec_len(parts) >= 2 {
        let ng = parse_int(vec_get(parts, 1))
        if ng > 0 {
            m.next_gen = ng
        }
        return m
    }
    // Legacy / ignore unknown
    return m
}

fn lsm_manifest_apply_log(m: LsmManifest, body: str) -> LsmManifest {
    if body == "" {
        return m
    }
    let lines = str_split(body, "\n")
    let mut i: i64 = 0
    while i < vec_len(lines) {
        m = lsm_manifest_apply_line(m, vec_get(lines, i))
        i = i + 1
    }
    return m
}

// Load snapshot + replay edit log (R40).
fn lsm_load_manifest(dir: str) -> LsmManifest !IO {
    let body = read_file(lsm_manifest_path(dir))?
    let mut m = lsm_parse_manifest(body)
    let logb = read_file(lsm_manifest_log_path(dir))?
    m = lsm_manifest_apply_log(m, logb)
    return m
}

// Count non-empty lines in log (for tests / compact decisions).
fn lsm_manifest_log_lines(dir: str) -> i64 !IO {
    let body = read_file(lsm_manifest_log_path(dir))?
    if body == "" {
        return 0
    }
    let lines = str_split(body, "\n")
    let mut n: i64 = 0
    let mut i: i64 = 0
    while i < vec_len(lines) {
        if vec_get(lines, i) != "" {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// Append edit lines to the log and fsync (O_WRONLY|O_CREAT|O_APPEND = 1089).
// Linux: O_WRONLY=1 O_CREAT=64 O_APPEND=1024 → 1089.
fn lsm_manifest_log_append(dir: str, text: str) -> i64 !IO {
    if text == "" {
        return 0
    }
    let path = lsm_manifest_log_path(dir)
    let fd = open(path, 1089, 420)?
    if fd < 0 {
        return 0 - 1
    }
    if fd_write(fd, text)? != 0 {
        close(fd)
        return 0 - 1
    }
    fsync(fd)?
    close(fd)
    return 0
}

fn lsm_manifest_log_clear(dir: str) -> i64 !IO {
    unlink(lsm_manifest_log_path(dir))?
    return 0
}

// R39: atomic durable snapshot publish (does not touch the edit log).
fn lsm_write_manifest_snapshot(dir: str, next_gen: i64, gens: Vec<i64>, levels: Vec<i64>) -> i64 !IO {
    let body = lsm_format_manifest(next_gen, gens, levels)
    let tmp = lsm_manifest_tmp_path(dir)
    let live = lsm_manifest_path(dir)
    let fd = open(tmp, 577, 420)?
    if fd < 0 {
        return 0 - 1
    }
    if fd_write(fd, body)? != 0 {
        close(fd)
        unlink(tmp)?
        return 0 - 1
    }
    fsync(fd)?
    close(fd)
    unlink(live)?
    if fs_rename(tmp, live)? != 0 {
        if write_file(live, body)? != 0 {
            return 0 - 1
        }
        unlink(tmp)?
        let fd2 = open(live, 0, 0)?
        if fd2 >= 0 {
            fsync(fd2)?
            close(fd2)
        }
        return 0
    }
    return 0
}

// Compact: atomic snapshot of full state + clear edit log.
fn lsm_write_manifest(dir: str, next_gen: i64, gens: Vec<i64>, levels: Vec<i64>) -> i64 !IO {
    if lsm_write_manifest_snapshot(dir, next_gen, gens, levels)? != 0 {
        return 0 - 1
    }
    lsm_manifest_log_clear(dir)?
    return 0
}

// R40: append ADD+NEXT for a new L0 (or any level) SST.
// Returns number of edit lines appended (2), or -1 on error.
fn lsm_manifest_log_add(dir: str, gen: i64, level: i64, next_gen: i64) -> i64 !IO {
    let mut t = concat("A ", int_to_str(gen))
    t = concat(t, concat(" ", int_to_str(level)))
    t = concat(t, "\n")
    t = concat(t, concat(concat("N ", int_to_str(next_gen)), "\n"))
    if lsm_manifest_log_append(dir, t)? != 0 {
        return 0 - 1
    }
    return 2
}

// R40: append DELs for dropped gens, optional ADD for new SST, then NEXT.
// dels = vec of gen ids to delete; add_gen<=0 means no add.
fn lsm_manifest_log_merge(
    dir: str,
    dels: Vec<i64>,
    add_gen: i64,
    add_level: i64,
    next_gen: i64
) -> i64 !IO {
    let mut t = ""
    let mut n: i64 = 0
    let mut i: i64 = 0
    while i < vec_len(dels) {
        t = concat(t, concat(concat("D ", int_to_str(vec_get(dels, i))), "\n"))
        n = n + 1
        i = i + 1
    }
    if add_gen > 0 {
        t = concat(t, concat("A ", int_to_str(add_gen)))
        t = concat(t, concat(" ", int_to_str(add_level)))
        t = concat(t, "\n")
        n = n + 1
    }
    t = concat(t, concat(concat("N ", int_to_str(next_gen)), "\n"))
    n = n + 1
    if lsm_manifest_log_append(dir, t)? != 0 {
        return 0 - 1
    }
    return n
}

// If edits_since >= compact_at, rewrite snapshot and clear log; returns new
// edits_since (0 if compacted, else unchanged).
fn lsm_manifest_maybe_compact(
    dir: str,
    next_gen: i64,
    gens: Vec<i64>,
    levels: Vec<i64>,
    edits_since: i64
) -> i64 !IO {
    if edits_since < LSM_MANIFEST_LOG_COMPACT_AT() {
        return edits_since
    }
    if lsm_write_manifest(dir, next_gen, gens, levels)? != 0 {
        return 0 - 1
    }
    return 0
}
