// cf.baga — column families: cfs map формат (load/save), LsmCFDB open/
// ensure/create/resolve/list/drop, setopt. IO пътят (WAL/put/get/flush/
// close) е в cf_io.baga.

// cf.baga — shared-WAL column families (R44).
//
// Model (honest RocksDB-lite):
//   • One WAL at <dir>.wal shared by all CFs.
//   • Each CF has its own memtable/tomb/SST/MANIFEST under:
//       CF 0 → <dir>            (compat with single-store)
//       CF n → <dir>.cf{n}
//   • WAL records: legacy op 1/2 = CF 0; op 17/18 = CF put/del + cf_id.
//   • Not full RocksDB CF (no shared global block-cache pool). Each CF has
//     its own page cache; R64 sets per-CF capacity (cache_pages) as policy.
//     Enough for multi-namespace durability with one fsync stream.
//
// API: lsm_cf_open / create / put / get / del / flush / drop / close.
// R46: durable name map at <dir>.cfs (atomic publish like MANIFEST).
// R48: per-CF compaction chain on flush + shared WAL rotation once every
//      family is clean (mem_n == 0) — WAL no longer grows/replays forever.
// R49: lsm_cf_drop / RESP CF.DROP — unlink family files, forget the name;
//      WAL replay skips records of dropped families.

import "engine.baga"
import "manifest.baga"
import "compact.baga"
import "../cache/page.baga"
import "../wal/wal.baga"
import "../table/sstable.baga"
import "../table/sstable_parse.baga"
import "../table/sstable_meta.baga"
import "../table/sstable_scan.baga"
import "../util/codec.baga"
import "../util/ttl.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"
import "std/time/time.baga"

fn lsm_cf_path(dir: str, cf_id: i64) -> str {
    if cf_id <= 0 {
        return dir
    }
    return concat(concat(dir, ".cf"), int_to_str(cf_id))
}

fn lsm_cfs_map_path(dir: str) -> str {
    return concat(dir, ".cfs")
}

fn lsm_cfs_map_tmp_path(dir: str) -> str {
    return concat(dir, ".cfs.tmp")
}

// Format:
//   <next_cf_id>\n
//   <name> <id> [<flush_at> <compact_at> [<cache_pages>]]\n
//   R61: flush/compact; R64: optional cache_pages (0 = no override in file).
//   ...
fn lsm_cfs_format(next_id: i64, names: Map<str, i64>, of: Map<i64, i64>, oc: Map<i64, i64>, ocache: Map<i64, i64>) -> str {
    let mut s = concat(int_to_str(next_id), "\n")
    let ks = map_keys(names)
    let mut i: i64 = 0
    while i < vec_len(ks) {
        let name = vec_get(ks, i)
        let id = map_get(names, name)
        // skip default — always implied as 0
        if name != "default" {
            s = concat(s, concat(name, " "))
            s = concat(s, int_to_str(id))
            let has_o = map_has(of, id) == 1 || map_has(oc, id) == 1 || map_has(ocache, id) == 1
            if has_o {
                let mut fa: i64 = 0
                let mut ca: i64 = 0
                if map_has(of, id) == 1 {
                    fa = map_get(of, id)
                }
                if map_has(oc, id) == 1 {
                    ca = map_get(oc, id)
                }
                s = concat(s, concat(concat(concat(" ", int_to_str(fa)), " "), int_to_str(ca)))
                if map_has(ocache, id) == 1 {
                    s = concat(s, concat(" ", int_to_str(map_get(ocache, id))))
                }
            }
            s = concat(s, "\n")
        }
        i = i + 1
    }
    return s
}

struct LsmCfsMap {
    next_id: i64,
    names: Map<str, i64>,
    of: Map<i64, i64>,
    oc: Map<i64, i64>,
    ocache: Map<i64, i64>,
    ok: i64
}

fn lsm_cfs_load(dir: str) -> LsmCfsMap !IO {
    let names: Map<str, i64> = map_new()
    map_set(names, "default", 0)
    let of: Map<i64, i64> = map_new()
    let oc: Map<i64, i64> = map_new()
    let ocache: Map<i64, i64> = map_new()
    let body = read_file(lsm_cfs_map_path(dir))?
    if body == "" {
        return LsmCfsMap {
            next_id: 1, names: names, of: of, oc: oc, ocache: ocache, ok: 1
        }
    }
    let lines = str_split(body, "\n")
    let mut next_id: i64 = 1
    if vec_len(lines) > 0 && vec_get(lines, 0) != "" {
        next_id = parse_int(vec_get(lines, 0))
        if next_id < 1 {
            next_id = 1
        }
    }
    let mut i: i64 = 1
    while i < vec_len(lines) {
        let ln = vec_get(lines, i)
        if ln != "" {
            let parts = str_split(ln, " ")
            if vec_len(parts) >= 2 {
                let name = vec_get(parts, 0)
                let id = parse_int(vec_get(parts, 1))
                if name != "" && id > 0 {
                    map_set(names, name, id)
                    if id >= next_id {
                        next_id = id + 1
                    }
                    // R61/R64: optional per-CF options on the same line
                    if vec_len(parts) >= 4 {
                        let fa = parse_int(vec_get(parts, 2))
                        let ca = parse_int(vec_get(parts, 3))
                        if fa > 0 {
                            map_set(of, id, fa)
                        }
                        if ca > 0 {
                            map_set(oc, id, ca)
                        }
                    }
                    if vec_len(parts) >= 5 {
                        let cp = parse_int(vec_get(parts, 4))
                        if cp >= 16 {
                            map_set(ocache, id, cp)
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return LsmCfsMap {
        next_id: next_id, names: names, of: of, oc: oc, ocache: ocache, ok: 1
    }
}

// Atomic publish of name map (tmp + fsync + rename).
fn lsm_cfs_save(dir: str, next_id: i64, names: Map<str, i64>, of: Map<i64, i64>, oc: Map<i64, i64>, ocache: Map<i64, i64>) -> i64 !IO {
    let body = lsm_cfs_format(next_id, names, of, oc, ocache)
    let tmp = lsm_cfs_map_tmp_path(dir)
    let live = lsm_cfs_map_path(dir)
    let fd = open(tmp, 577, 420)?
    if fd < 0 {
        return 0 - 1
    }
    if fd_write(fd, body)? != 0 {
        close(fd)
        unlink(tmp)?
        return 0 - 1
    }
    fsync(fd)?
    close(fd)
    unlink(live)?
    if fs_rename(tmp, live)? != 0 {
        if write_file(live, body)? != 0 {
            return 0 - 1
        }
        unlink(tmp)?
        let fd2 = open(live, 0, 0)?
        if fd2 >= 0 {
            fsync(fd2)?
            close(fd2)
        }
    }
    return 0
}

struct LsmCFDB {
    dir: str,
    // shared WAL
    wal_fd: i64,
    wal_off: i64,
    wal_buf: bytes,
    wal_buf_max: i64,
    wal_buf_len: i64,
    sync_every: i64,
    since_sync: i64,
    flush_at: i64,
    compact_at: i64,
    // cf_id → LsmDB (SST path = lsm_cf_path; WAL fields ignored for n>0)
    families: Map<i64, LsmDB>,
    names: Map<str, i64>,
    // R61/R64: per-CF options (cf_id → value); absent → db-level default
    opt_flush: Map<i64, i64>,
    opt_compact: Map<i64, i64>,
    opt_cache: Map<i64, i64>,   // R64: page-cache capacity (pages × 4 KiB)
    cache_pages: i64,           // R64: default for families without override (0 → engine 2048)
    next_cf_id: i64,
    ok: i64
}

// R64: apply page-cache capacity to a family (min 16 pages).
fn lsm_cf_apply_cache(fam: LsmDB, pages: i64) -> LsmDB {
    let mut p = pages
    if p < 16 {
        return fam
    }
    // Same pattern as lsm_cluster_apply_cache: replace buffer pool.
    // SST pages are read-mostly; open fds re-register on next get.
    fam.cache = pc_new(4096, p)
    return fam
}

fn lsm_cf_ensure(db: LsmCFDB, cf_id: i64) -> LsmCFDB !IO {
    if map_has(db.families, cf_id) == 1 {
        return db
    }
    let path = lsm_cf_path(db.dir, cf_id)
    // Open family SST/manifest only — do not open a separate WAL.
    let mut fam = lsm_read_manifest(path)?
    fam.dir = path
    fam.flush_at = db.flush_at
    if map_has(db.opt_flush, cf_id) == 1 {
        fam.flush_at = map_get(db.opt_flush, cf_id)
    }
    fam.compact_at = db.compact_at
    if map_has(db.opt_compact, cf_id) == 1 {
        fam.compact_at = map_get(db.opt_compact, cf_id)
    }
    // R64: per-CF or db-level page cache budget
    let mut cp: i64 = db.cache_pages
    if map_has(db.opt_cache, cf_id) == 1 {
        cp = map_get(db.opt_cache, cf_id)
    }
    if cp >= 16 {
        fam = lsm_cf_apply_cache(fam, cp)
    }
    fam.sync_every = db.sync_every
    fam.wal_fd = 0 - 1
    fam.wal_off = 0
    fam.wal_buf_len = 0
    fam.ok = 1
    map_set(db.families, cf_id, fam)
    return db
}

fn lsm_cf_open(dir: str, flush_at: i64, compact_at: i64) -> LsmCFDB !IO {
    let mut fa = flush_at
    if fa < 1 {
        fa = 32
    }
    let mut ca = compact_at
    if ca < 1 {
        ca = 3
    }
    let families: Map<i64, LsmDB> = map_new()
    // R46: load durable name map
    let nm = lsm_cfs_load(dir)?
    let names = nm.names
    let mut next_cf_id = nm.next_id
    // Shared WAL
    let wfd = open(concat(dir, ".wal"), 66, 420)?
    if wfd < 0 {
        return LsmCFDB {
            dir: dir, wal_fd: -1, wal_off: 0,
            wal_buf: bytes_new(0), wal_buf_max: 65536, wal_buf_len: 0,
            sync_every: 1, since_sync: 0, flush_at: fa, compact_at: ca,
            families: families, names: names,
            opt_flush: map_new(), opt_compact: map_new(), opt_cache: map_new(),
            cache_pages: 0,
            next_cf_id: next_cf_id, ok: 0
        }
    }
    let mut db = LsmCFDB {
        dir: dir, wal_fd: wfd, wal_off: 0,
        wal_buf: bytes_new(0), wal_buf_max: 65536, wal_buf_len: 0,
        sync_every: 1, since_sync: 0, flush_at: fa, compact_at: ca,
        families: families, names: names,
        opt_flush: nm.of, opt_compact: nm.oc, opt_cache: nm.ocache,
        cache_pages: 0,
        next_cf_id: next_cf_id, ok: 1
    }
    // Always ensure default CF 0 (loads its SST manifest)
    db = lsm_cf_ensure(db, 0)?
    // Ensure all named CFs from durable map (load their SST manifests)
    let nks = map_keys(db.names)
    let mut ni: i64 = 0
    while ni < vec_len(nks) {
        let nm0 = vec_get(nks, ni)
        let id0 = map_get(db.names, nm0)
        db = lsm_cf_ensure(db, id0)?
        ni = ni + 1
    }
    // Replay shared WAL into CF memtables
    let rp = wal_replay(wfd)?
    db.wal_off = rp.end_off
    let mut i: i64 = 0
    while i < vec_len(rp.ops) {
        let mut cf: i64 = 0
        if i < vec_len(rp.cfs) {
            cf = vec_get(rp.cfs, i)
        }
        // R49: skip records of dropped families (name no longer in .cfs)
        if lsm_cf_id_known(db, cf) == 1 {
            db = lsm_cf_ensure(db, cf)?
            let mut fam = map_get(db.families, cf)
            let op = vec_get(rp.ops, i)
            let k = vec_get(rp.keys, i)
            let v = vec_get(rp.vals, i)
            if op == 1 {
                map_set(fam.mem, k, v)
                map_del(fam.tomb, k)
            } else {
                map_del(fam.mem, k)
                map_set(fam.tomb, k, 1)
            }
            fam.mem_n = fam.mem_n + 1
            map_set(db.families, cf, fam)
            if cf >= db.next_cf_id {
                db.next_cf_id = cf + 1
            }
        }
        i = i + 1
    }
    return db
}

// Create or lookup named CF. Persists name map (R46).
fn lsm_cf_create(db: LsmCFDB, name: str) -> LsmCFCreate !IO {
    if name == "" || name == "default" {
        return LsmCFCreate { db: db, id: 0 }
    }
    if map_has(db.names, name) == 1 {
        return LsmCFCreate { db: db, id: map_get(db.names, name) }
    }
    let id = db.next_cf_id
    db.next_cf_id = id + 1
    map_set(db.names, name, id)
    db = lsm_cf_ensure(db, id)?
    if lsm_cfs_save(db.dir, db.next_cf_id, db.names, db.opt_flush, db.opt_compact, db.opt_cache)? != 0 {
        db.ok = 0
        return LsmCFCreate { db: db, id: 0 - 1 }
    }
    return LsmCFCreate { db: db, id: id }
}

struct LsmCFCreate {
    db: LsmCFDB,
    id: i64
}

fn lsm_cf_id_of(db: LsmCFDB, name: str) -> i64 {
    if map_has(db.names, name) == 1 {
        return map_get(db.names, name)
    }
    if name == "" || name == "default" {
        return 0
    }
    return 0 - 1
}

// Resolve name; auto-create if missing (for CF.SET).
fn lsm_cf_resolve(db: LsmCFDB, name: str, create: i64) -> LsmCFCreate !IO {
    let id = lsm_cf_id_of(db, name)
    if id >= 0 {
        return LsmCFCreate { db: db, id: id }
    }
    if create == 0 {
        return LsmCFCreate { db: db, id: 0 - 1 }
    }
    return lsm_cf_create(db, name)?
}

// List CF names (including "default").
fn lsm_cf_list(db: LsmCFDB) -> Vec<str> {
    let ks = map_keys(db.names)
    sort_strs(ks)
    return ks
}

// R49: is cf_id a live family? 0 = default (always); else must hold a name.
// WAL replay uses this to skip records of dropped families.
fn lsm_cf_id_known(db: LsmCFDB, cf_id: i64) -> i64 {
    if cf_id <= 0 {
        return 1
    }
    let ks = map_keys(db.names)
    let mut i: i64 = 0
    while i < vec_len(ks) {
        if map_get(db.names, vec_get(ks, i)) == cf_id {
            return 1
        }
        i = i + 1
    }
    return 0
}

struct LsmCFDrop {
    db: LsmCFDB,
    rc: i64
}

// R49: drop a named column family — discard memtable, close SST fd caches,
// unlink its files, forget the name (persisted via .cfs). Default CF cannot
// be dropped. rc: 1 dropped, 0 not found, -1 refused / io error.
fn lsm_cf_drop(db: LsmCFDB, name: str) -> LsmCFDrop !IO !Time {
    if name == "" || name == "default" {
        return LsmCFDrop { db: db, rc: 0 - 1 }
    }
    if map_has(db.names, name) == 0 {
        return LsmCFDrop { db: db, rc: 0 }
    }
    let id = map_get(db.names, name)
    db = lsm_cf_ensure(db, id)?
    let mut fam = map_get(db.families, id)
    // Discard in-memory state; family has no WAL of its own.
    fam.mem = map_new()
    fam.tomb = map_new()
    fam.mem_n = 0
    fam.wal_fd = 0 - 1
    lsm_close(fam)?
    let path = lsm_cf_path(db.dir, id)
    let mut gi: i64 = 0
    while gi < vec_len(fam.gens) {
        let g = vec_get(fam.gens, gi)
        unlink(concat(concat(path, ".sst."), int_to_str(g)))?
        unlink(concat(concat(path, ".bloom."), int_to_str(g)))?
        gi = gi + 1
    }
    unlink(concat(path, ".manifest"))?
    unlink(concat(path, ".manifest.log"))?
    unlink(concat(path, ".manifest.tmp"))?
    map_del(db.families, id)
    map_del(db.names, name)
    if lsm_cfs_save(db.dir, db.next_cf_id, db.names, db.opt_flush, db.opt_compact, db.opt_cache)? != 0 {
        db.ok = 0
        return LsmCFDrop { db: db, rc: 0 - 1 }
    }
    return LsmCFDrop { db: db, rc: 1 }
}

// R64: set a single per-CF option by name (does not touch other options).
// Keys: "flush_at" | "compact_at" | "cache_pages" (case-sensitive API;
// RESP normalizes via lsm_eq_ci before call).
// val > 0 → set override; val <= 0 → clear override (db default).
// cache_pages minimum effective is 16.
fn lsm_cf_setopt_one(db: LsmCFDB, name: str, key: str, val: i64) -> LsmCFDB !IO {
    if lsm_cf_id_of(db, name) < 0 {
        db.ok = 0
        return db
    }
    let id = map_get(db.names, name)
    if key == "flush_at" {
        if val > 0 {
            map_set(db.opt_flush, id, val)
        } else {
            if map_has(db.opt_flush, id) == 1 {
                map_del(db.opt_flush, id)
            }
        }
    } else {
        if key == "compact_at" {
            if val > 0 {
                map_set(db.opt_compact, id, val)
            } else {
                if map_has(db.opt_compact, id) == 1 {
                    map_del(db.opt_compact, id)
                }
            }
        } else {
            if key == "cache_pages" {
                if val >= 16 {
                    map_set(db.opt_cache, id, val)
                } else {
                    if map_has(db.opt_cache, id) == 1 {
                        map_del(db.opt_cache, id)
                    }
                }
            } else {
                db.ok = 0
                return db
            }
        }
    }
    if lsm_cfs_save(db.dir, db.next_cf_id, db.names, db.opt_flush, db.opt_compact, db.opt_cache)? != 0 {
        db.ok = 0
        return db
    }
    // apply live if the family is loaded
    if map_has(db.families, id) == 1 {
        let mut fam = map_get(db.families, id)
        if key == "flush_at" {
            if val > 0 {
                fam.flush_at = val
            } else {
                fam.flush_at = db.flush_at
            }
        }
        if key == "compact_at" {
            if val > 0 {
                fam.compact_at = val
            } else {
                fam.compact_at = db.compact_at
            }
        }
        if key == "cache_pages" {
            let mut cp = db.cache_pages
            if val >= 16 {
                cp = val
            }
            if cp >= 16 {
                fam = lsm_cf_apply_cache(fam, cp)
            } else {
                // clear → engine default pool
                fam = lsm_cf_apply_cache(fam, 2048)
            }
        }
        map_set(db.families, id, fam)
    }
    return db
}

// R61: bulk set flush_at / compact_at (0 clears that option). Prefer
// lsm_cf_setopt_one for single-key updates so other options are left alone.
fn lsm_cf_setopt(db: LsmCFDB, name: str, flush_at: i64, compact_at: i64) -> LsmCFDB !IO {
    db = lsm_cf_setopt_one(db, name, "flush_at", flush_at)?
    if db.ok == 0 {
        return db
    }
    return lsm_cf_setopt_one(db, name, "compact_at", compact_at)?
}

// Shared WAL append (CF-aware record). R68: key arrives as raw bytes.
