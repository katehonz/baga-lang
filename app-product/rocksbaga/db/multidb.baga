// multidb.baga — Redis-style logical databases / CF-like namespaces (R41).
//
// Model (honest):
//   • Each DB index is an independent LsmCluster on disk:
//       0 → <dir>           (compat; same as pre-R41)
//       n → <dir>.db{n}     then shards as <dir>.db{n}.s{i} when LSM_SHARDS>1
//   • Not RocksDB ColumnFamily (no shared WAL across DBs). Closer to Redis
//     SELECT: separate keyspaces, separate durability files.
//   • Lazy open on first use. Max index 0..15 (Redis default range).
//
// Env: LSM_MAX_DB (default 16, clamp 1..16).

import "engine.baga"
import "shard.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn LSM_MAX_DB_DEFAULT() -> i64 { return 16 }

struct LsmMulti {
    dir: str,
    nshards: i64,
    flush_at: i64,
    compact_at: i64,
    max_db: i64,
    // applied to every newly opened cluster
    sync_every: i64,
    cache_pages: i64,
    target_bytes: i64,
    merge_pick: i64,
    // db index → opened cluster (lazy)
    open: Map<i64, LsmCluster>,
    ok: i64
}

fn lsm_multi_tune_cluster(m: LsmMulti, c: LsmCluster) -> LsmCluster {
    if m.sync_every > 0 {
        c = lsm_cluster_apply_sync(c, m.sync_every)
    }
    if m.cache_pages >= 16 {
        c = lsm_cluster_apply_cache(c, m.cache_pages)
    }
    if m.target_bytes > 0 {
        c = lsm_cluster_apply_target_bytes(c, m.target_bytes)
    }
    if m.merge_pick > 0 {
        c = lsm_cluster_apply_merge_pick(c, m.merge_pick)
    }
    return c
}

fn lsm_db_path(dir: str, dbix: i64) -> str {
    if dbix <= 0 {
        return dir
    }
    return concat(concat(dir, ".db"), int_to_str(dbix))
}

fn lsm_multi_open(dir: str, nshards: i64, flush_at: i64, compact_at: i64, max_db: i64) -> LsmMulti !IO {
    let mut md = max_db
    if md < 1 {
        md = 1
    }
    if md > 16 {
        md = 16
    }
    let open: Map<i64, LsmCluster> = map_new()
    // Eagerly open DB 0 (default SELECT)
    let c0 = lsm_cluster_open(lsm_db_path(dir, 0), nshards, flush_at, compact_at)?
    map_set(open, 0, c0)
    let mut ok: i64 = 1
    if c0.ok == 0 {
        ok = 0
    }
    return LsmMulti {
        dir: dir, nshards: nshards, flush_at: flush_at, compact_at: compact_at,
        max_db: md, sync_every: 0, cache_pages: 0, target_bytes: 0, merge_pick: 0,
        open: open, ok: ok
    }
}

struct LsmMultiGet {
    multi: LsmMulti,
    c: LsmCluster
}

// Ensure dbix is open; returns updated multi + cluster copy.
fn lsm_multi_ensure(m: LsmMulti, dbix: i64) -> LsmMultiGet !IO {
    let mut ix = dbix
    if ix < 0 {
        ix = 0
    }
    if ix >= m.max_db {
        // caller should reject SELECT out of range; clamp for safety
        ix = m.max_db - 1
    }
    if map_has(m.open, ix) == 1 {
        return LsmMultiGet { multi: m, c: map_get(m.open, ix) }
    }
    let path = lsm_db_path(m.dir, ix)
    let mut c = lsm_cluster_open(path, m.nshards, m.flush_at, m.compact_at)?
    c = lsm_multi_tune_cluster(m, c)
    map_set(m.open, ix, c)
    if c.ok == 0 {
        m.ok = 0
    }
    return LsmMultiGet { multi: m, c: c }
}

fn lsm_multi_put(m: LsmMulti, dbix: i64, c: LsmCluster) -> LsmMulti {
    map_set(m.open, dbix, c)
    m.ok = c.ok
    return m
}

fn lsm_multi_close(m: LsmMulti) -> i64 !IO {
    let ks = map_keys(m.open)
    let mut i: i64 = 0
    while i < vec_len(ks) {
        let ix = vec_get(ks, i)
        let c = map_get(m.open, ix)
        lsm_cluster_close(c)?
        i = i + 1
    }
    return 0
}

fn lsm_multi_valid_db(m: LsmMulti, dbix: i64) -> i64 {
    if dbix < 0 {
        return 0
    }
    if dbix >= m.max_db {
        return 0
    }
    return 1
}

// R42: FLUSHDB for one logical DB index (open or wipe-on-disk if closed).
fn lsm_multi_flushdb(m: LsmMulti, dbix: i64) -> LsmMulti !IO {
    if lsm_multi_valid_db(m, dbix) == 0 {
        return m
    }
    if map_has(m.open, dbix) == 1 {
        let c = map_get(m.open, dbix)
        let nc = lsm_cluster_flushdb(c)?
        let nct = lsm_multi_tune_cluster(m, nc)
        m = lsm_multi_put(m, dbix, nct)
        return m
    }
    // Not open: wipe disk files so a later open is empty.
    let path = lsm_db_path(m.dir, dbix)
    if m.nshards <= 1 {
        lsm_path_wipe(path)?
    } else {
        let mut i: i64 = 0
        while i < m.nshards {
            lsm_path_wipe(lsm_shard_path(path, i, m.nshards))?
            i = i + 1
        }
    }
    return m
}

// R42: FLUSHALL — every logical DB 0..max_db-1.
fn lsm_multi_flushall(m: LsmMulti) -> LsmMulti !IO {
    let mut i: i64 = 0
    while i < m.max_db {
        m = lsm_multi_flushdb(m, i)?
        i = i + 1
    }
    return m
}
