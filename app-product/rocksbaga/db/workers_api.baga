// workers_api.baga — удобни LsmParallel API-та: set/get/del/stop върху
// пула (submit + wait), try_done и take_rep за неблокиращо чакане.
// Пуловете са в workers_par.baga.

import "workers_par.baga"
import "workers.baga"
import "engine.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

    return str_of_bytes(lsm_parallel_wait_b(p, id)?)
}

// Sync helper: submit + wait (tests / simple clients).
fn lsm_parallel_set(p: LsmParallel, key: str, val: str) -> str !Par {
    let id = lsm_parallel_submit(p, LSM_OP_SET(), key, val, "")?
    return lsm_parallel_wait(p, id)?
}

fn lsm_parallel_set_b(p: LsmParallel, key: str, val: bytes) -> bytes !Par {
    let id = lsm_parallel_submit_b(p, LSM_OP_SET(), key, val, "")?
    return lsm_parallel_wait_b(p, id)?
}

fn lsm_parallel_get(p: LsmParallel, key: str) -> str !Par {
    let id = lsm_parallel_submit(p, LSM_OP_GET(), key, "", "")?
    return lsm_parallel_wait(p, id)?
}

fn lsm_parallel_get_b(p: LsmParallel, key: str) -> bytes !Par {
    let id = lsm_parallel_submit_b(p, LSM_OP_GET(), key, bytes_new(0), "")?
    return lsm_parallel_wait_b(p, id)?
}

fn lsm_parallel_del(p: LsmParallel, key: str) -> str !Par {
    let id = lsm_parallel_submit(p, LSM_OP_DEL(), key, "", "")?
    return lsm_parallel_wait(p, id)?
}

fn lsm_parallel_stop(p: LsmParallel) -> i64 !Par {
    let mut i: i64 = 0
    while i < p.n {
        chan_send(vec_get(p.work, i), 0 - 1)
        i = i + 1
    }
    sleep_ms(150)
    return 0
}

// Non-blocking poll of completion. Returns job id (>0), 0 empty, -1 closed.
fn lsm_parallel_try_done(p: LsmParallel) -> i64 !Par {
    let pr = chan_try_recv(p.done)
    let st = cell2_0(pr)
    if st == 1 {
        let msg = cell2_1(pr)
        lsm_parallel_stash_done(p, msg)
        return cell2_0(msg)
    }
    if st == 2 {
        return 0 - 1
    }
    return 0
}

// Expand typed reply for completed job (str view).
fn lsm_parallel_take_rep(p: LsmParallel, id: i64) -> str {
    return str_of_bytes(lsm_parallel_take_rep_b(p, id))
}
