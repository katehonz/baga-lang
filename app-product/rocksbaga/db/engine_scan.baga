// engine_scan.baga — Redis SCAN върху LsmDB: snapshot кеш (epoch),
// prefix (K3i), MATCH филтър, курсор страници. Live map-ът е в
// engine_keys.baga.

import "engine.baga"
import "engine_keys.baga"
import "../table/sstable.baga"
import "../table/sstable_scan.baga"
import "std/bytes/bytes.baga"
import "std/str/str.baga"

struct LsmScan {
    db: LsmDB,
    next: i64,
    keys: Vec<str>
}

// R68: bytes-key sibling of LsmScan (wire path emits raw key bytes).

struct LsmScanB {
    db: LsmDB,
    next: i64,
    keys: Vec<bytes>
}

// R68: (re)build SCAN snapshot from a raw-bytes MATCH pattern.
// Unordered live keys + MATCH filter — Redis SCAN does not promise order
// (KEYS remains sorted via lsm_keys). Snapshot and pattern stay raw bytes;
// the glob never sees a lossy str conversion.

fn lsm_scan_rebuild_b(db: LsmDB, match_pat: bytes) -> LsmDB !IO !Time {
    let r = lsm_live_map_kb(db)?
    db = r.db
    let all = r.keys
    let filtered: Vec<bytes> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(all) {
        let k = vec_get(all, i)
        if lsm_match_glob_b(match_pat, k) == 1 {
            vec_push(filtered, k)
        }
        i = i + 1
    }
    // MEM-4: snapshot-ът е cross-request state на store-а (boilaDB serve
    // rewind-ва ephemeral arena-та на заявката) — deep-copy в persist,
    // иначе drop(old)/четене след rewind е use-after-free.
    mem_persist_begin()
    let pf: Vec<bytes> = vec_new()
    i = 0
    while i < vec_len(filtered) {
        let k2 = vec_get(filtered, i)
        vec_push(pf, bytes_slice(k2, 0, bytes_len(k2)))
        i = i + 1
    }
    let ppat = bytes_slice(match_pat, 0, bytes_len(match_pat))
    mem_persist_end()
    if vec_len(db.scan_keys) > 0 {
        let old = db.scan_keys
        db.scan_keys = pf
        lsm_scan_keys_free_data(old)
        drop(old)
    } else {
        db.scan_keys = pf
    }
    let opat = db.scan_pat
    db.scan_pat = ppat
    drop(opat)
    db.scan_epoch = db.write_epoch
    return db
}

// True prefix filter (no glob meta) — boilaDB K2.
// Sorted for secondary index range seek (boilaDB K3h).
// K3i: prefix fold (no full live_map + post-filter).

fn lsm_scan_rebuild_prefix_b(db: LsmDB, prefix: bytes) -> LsmDB !IO !Time {
    let r = lsm_live_map_prefix_kb(db, prefix)?
    db = r.db
    let filtered = r.keys
    sort_bytes(filtered)
    // MEM-4: snapshot-ът е cross-request state на store-а (boilaDB serve
    // rewind-ва ephemeral arena-та на заявката) — deep-copy в persist,
    // иначе drop(old)/четене след rewind е use-after-free.
    mem_persist_begin()
    let pf: Vec<bytes> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(filtered) {
        let k = vec_get(filtered, i)
        vec_push(pf, bytes_slice(k, 0, bytes_len(k)))
        i = i + 1
    }
    // tag prefix mode: pat = 0x01 ‖ prefix (won't collide with glob pats that
    // are bare keys or * patterns from RESP)
    let mut tag = bytes_new(1)
    bytes_set(tag, 0, 1)
    let ppat = bytes_concat(tag, prefix)
    mem_persist_end()
    if vec_len(db.scan_keys) > 0 {
        let old = db.scan_keys
        db.scan_keys = pf
        lsm_scan_keys_free_data(old)
        drop(old)
    } else {
        db.scan_keys = pf
    }
    let opat = db.scan_pat
    db.scan_pat = ppat
    drop(opat)
    db.scan_epoch = db.write_epoch
    return db
}


fn lsm_scan_prefix_kb(db: LsmDB, cursor: i64, count: i64, prefix: bytes) -> LsmScanB !IO !Time {
    let mut tag = bytes_new(1)
    bytes_set(tag, 0, 1)
    let pat = bytes_concat(tag, prefix)
    if db.scan_epoch != db.write_epoch || bytes_eq_b(db.scan_pat, pat) == false {
        db = lsm_scan_rebuild_prefix_b(db, prefix)?
    }
    let n = vec_len(db.scan_keys)
    let mut cur = cursor
    if cur < 0 { cur = 0 }
    if cur > n { cur = n }
    let mut cnt = count
    if cnt < 1 { cnt = 10 }
    if cnt > 1000 { cnt = 1000 }
    let out: Vec<bytes> = vec_new()
    let mut j = cur
    let mut taken: i64 = 0
    while j < n && taken < cnt {
        vec_push(out, vec_get(db.scan_keys, j))
        j = j + 1
        taken = taken + 1
    }
    // Keep sorted prefix cache for reuse (secondary range seek / warm queries).
    // Invalidated on write_epoch or prefix change in the rebuild check above.
    let mut next: i64 = j
    if next >= n {
        next = 0
    }
    return LsmScanB { db: db, next: next, keys: out }
}

// Full sorted prefix snapshot (one live fold; cache kept). boilaDB K3h.

fn lsm_scan_prefix_all_kb(db: LsmDB, prefix: bytes) -> LsmScanB !IO !Time {
    let mut tag = bytes_new(1)
    bytes_set(tag, 0, 1)
    let pat = bytes_concat(tag, prefix)
    if db.scan_epoch != db.write_epoch || bytes_eq_b(db.scan_pat, pat) == false {
        db = lsm_scan_rebuild_prefix_b(db, prefix)?
    }
    let out: Vec<bytes> = vec_new()
    let mut j: i64 = 0
    while j < vec_len(db.scan_keys) {
        vec_push(out, vec_get(db.scan_keys, j))
        j = j + 1
    }
    return LsmScanB { db: db, next: 0, keys: out }
}

// R43 + R63 + R68: SCAN page over live keys, raw-bytes pattern and results.
// Cursor is a 0-based index into the filtered snapshot; 0 = start/end
// (Redis-compatible). count is a page size hint (default 10, clamp 1..1000).
// R63: the live fold runs once per write_epoch×MATCH; later pages are
// O(count) slices of the cached snapshot (no per-page full re-fold).

fn lsm_scan_kb(db: LsmDB, cursor: i64, count: i64, match_pat: bytes) -> LsmScanB !IO !Time {
    // Rebuild when: no cache, write since last build, or MATCH changed.
    // Cursor 0 always accepts a rebuild if cache is stale; mid-cursor with
    // a stale cache also rebuilds (caller may see duplicates / skips —
    // same honesty class as Redis under concurrent writes).
    if db.scan_epoch != db.write_epoch || bytes_eq_b(db.scan_pat, match_pat) == false {
        db = lsm_scan_rebuild_b(db, match_pat)?
    }
    let n = vec_len(db.scan_keys)
    let mut cur = cursor
    if cur < 0 {
        cur = 0
    }
    // Cursor past end after a rebuild → treat as finished (next=0).
    if cur > n {
        cur = n
    }
    let mut cnt = count
    if cnt < 1 {
        cnt = 10
    }
    if cnt > 1000 {
        cnt = 1000
    }
    let out: Vec<bytes> = vec_new()
    let mut j = cur
    let mut taken: i64 = 0
    while j < n && taken < cnt {
        vec_push(out, vec_get(db.scan_keys, j))
        j = j + 1
        taken = taken + 1
    }
    let mut next: i64 = j
    if next >= n {
        next = 0
        // Full iteration done — free snapshot until next SCAN 0.
        if vec_len(db.scan_keys) > 0 {
            let old = db.scan_keys
            // MEM-4: заместващият vec/pat остават в shared store след rewind
            // → persist. Ключовите ДАННИ тук не се free-ват нарочно: out
            // по-горе alias-ва същите байтове и се сериализира след return.
            mem_persist_begin()
            db.scan_keys = vec_new()
            mem_persist_end()
            drop(old)
        }
        db.scan_epoch = 0 - 1
        let opat = db.scan_pat
        mem_persist_begin()
        db.scan_pat = bytes_new(0)
        mem_persist_end()
        drop(opat)
    }
    return LsmScanB { db: db, next: next, keys: out }
}

// str-keyed compat wrapper: pattern converts losslessly (bytes_of_str);
// returned keys convert via str_of_bytes — NUL keys truncate (use
// lsm_scan_kb on the wire path, R68).

fn lsm_scan(db: LsmDB, cursor: i64, count: i64, match_pat: str) -> LsmScan !IO !Time {
    let r = lsm_scan_kb(db, cursor, count, bytes_of_str(match_pat))?
    let out: Vec<str> = vec_new()
    for i in 0..vec_len(r.keys) {
        vec_push(out, str_of_bytes(vec_get(r.keys, i)))
    }
    return LsmScan { db: r.db, next: r.next, keys: out }
}

