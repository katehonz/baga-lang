// workers.baga — mailbox протокол (op/rep kind, job/req/rep пътища).
// shard worker-ите и LsmParallel пулът са в workers_par.baga;
// удобните API (parallel_set/get/del/stop) — в workers_api.baga.

// workers.baga — per-shard exclusive workers (R33 multi-core writers).
//
// LSM_PARALLEL=1 + LSM_SHARDS=N:
//   N go_bg workers; worker i exclusively owns <dir> / <dir>.s{i}.
// Network / test harness enqueues jobs as i64 cell2 trees (no disk hop).
//
// R35: in-memory mailbox — payloads on channels (i64 only).
// R37: cheaper hop —
//   • short-string pack (n≤8 = one cell2, empty = 0)
//   • typed reply codes (no pack of "+OK\r\n" every SET)
//   • skip unpack val/extra when op does not need them
//   • id alloc lock-free (single submitter thread)
// R51: zero-copy hop — key/extra are str handles (str_h/h_str).
// R66: SET/SETEX values + GET bulk payloads are bytes handles
// (bytes_h/h_bytes) so embedded NUL survives the hop. Reply expansion
// builds RESP as bytes (lsm_mb_rep_to_bytes).
//
// PING stays on the caller thread. SET/GET/DEL hop to the key's shard worker.

import "engine.baga"
import "shard.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

fn LSM_OP_SET() -> i64 { return 1 }
fn LSM_OP_GET() -> i64 { return 2 }
fn LSM_OP_DEL() -> i64 { return 3 }
fn LSM_OP_SETEX() -> i64 { return 4 }
fn LSM_OP_FLUSH() -> i64 { return 5 }

// Reply kinds on done channel: cell2(id, cell2(kind, payload_h))
// payload_h is 0 for fixed replies; packed bulk/err body for BULK/ERR.
fn LSM_REP_OK() -> i64 { return 1 }
fn LSM_REP_NIL() -> i64 { return 2 }
fn LSM_REP_INT0() -> i64 { return 3 }
fn LSM_REP_INT1() -> i64 { return 4 }
fn LSM_REP_BULK() -> i64 { return 5 }
fn LSM_REP_ERR() -> i64 { return 6 }

// --- R35/R37: pack str ↔ cell2 (LEGACY — superseded by R51 str handles;
// kept for reference/fallback, not used on the hot path) ---
// empty → 0
// n≤8  → cell2(n, word)          (one node; word holds LE bytes)
// n>8  → cell2(n, cell2(w0, …))  (word list)

fn lsm_mb_pack_str(s: str) -> i64 {
    let n = len(s)
    if n <= 0 {
        return 0
    }
    if n <= 8 {
        let mut w: i64 = 0
        let mut j: i64 = 0
        while j < n {
            let c = char_at(s, j) & 255
            w = w | (c << (j * 8))
            j = j + 1
        }
        return cell2(n, w)
    }
    let nwords = (n + 7) / 8
    let mut rest: i64 = 0
    let mut wi = nwords - 1
    while wi >= 0 {
        let off = wi * 8
        let mut w: i64 = 0
        let mut j: i64 = 0
        while j < 8 && off + j < n {
            let c = char_at(s, off + j) & 255
            w = w | (c << (j * 8))
            j = j + 1
        }
        rest = cell2(w, rest)
        wi = wi - 1
    }
    return cell2(n, rest)
}

fn lsm_mb_unpack_str(h: i64) -> str {
    if h == 0 {
        return ""
    }
    let n = cell2_0(h)
    if n <= 0 {
        return ""
    }
    let b = bytes_new(n)
    if n <= 8 {
        let w = cell2_1(h)
        let mut j: i64 = 0
        while j < n {
            bytes_set(b, j, (w >> (j * 8)) & 255)
            j = j + 1
        }
        return str_of_bytes(b)
    }
    let mut words = cell2_1(h)
    let mut off: i64 = 0
    while off < n {
        let w = cell2_0(words)
        words = cell2_1(words)
        let mut j: i64 = 0
        while j < 8 && off + j < n {
            bytes_set(b, off + j, (w >> (j * 8)) & 255)
            j = j + 1
        }
        off = off + 8
    }
    return str_of_bytes(b)
}

// Job: cell2(id, cell2(rc, cell2(op, cell2(kh, cell2(vh, eh)))))
// rc = reply chan (R47). R68: kh = bytes_h (NUL-safe key hop — keys were
// str_h until R68). R66: vh = bytes_h for SET/SETEX (0 if unused).
// eh = str_h (SETEX seconds — ASCII).
fn lsm_mb_job_kb(rc: i64, id: i64, op: i64, key: bytes, val: bytes, extra: str) -> i64 {
    let kh = bytes_h(key)
    let mut vh: i64 = 0
    let mut eh: i64 = 0
    if op == LSM_OP_SET() || op == LSM_OP_SETEX() {
        vh = bytes_h(val)
    }
    if op == LSM_OP_SETEX() {
        eh = str_h(extra)
    }
    return cell2(id, cell2(rc, cell2(op, cell2(kh, cell2(vh, eh)))))
}

// str-key wrapper (bytes_of_str is lossless).
fn lsm_mb_job_b(rc: i64, id: i64, op: i64, key: str, val: bytes, extra: str) -> i64 {
    return lsm_mb_job_kb(rc, id, op, bytes_of_str(key), val, extra)
}

// Text-value submit (workers_test / simple clients) — wraps bytes_of_str.
fn lsm_mb_job(rc: i64, id: i64, op: i64, key: str, val: str, extra: str) -> i64 {
    return lsm_mb_job_b(rc, id, op, key, bytes_of_str(val), extra)
}

fn lsm_mb_done(id: i64, kind: i64, payload_h: i64) -> i64 {
    return cell2(id, cell2(kind, payload_h))
}

// R66: expand typed reply to RESP bytes (binary-safe bulk).
fn lsm_mb_rep_to_bytes(kind: i64, payload_h: i64) -> bytes {
    if kind == LSM_REP_OK() {
        return bytes_of_str("+OK\r\n")
    }
    if kind == LSM_REP_NIL() {
        return bytes_of_str("$-1\r\n")
    }
    if kind == LSM_REP_INT0() {
        return bytes_of_str(":0\r\n")
    }
    if kind == LSM_REP_INT1() {
        return bytes_of_str(":1\r\n")
    }
    if kind == LSM_REP_BULK() {
        let b = h_bytes(payload_h)
        let n = bytes_len(b)
        let head = bytes_of_str(concat(concat("$", int_to_str(n)), "\r\n"))
        let crlf = bytes_of_str("\r\n")
        let mut out = bytes_concat(head, b)
        out = bytes_concat(out, crlf)
        return out
    }
    if kind == LSM_REP_ERR() {
        if payload_h == 0 {
            return bytes_of_str("-ERR worker\r\n")
        }
        let e = h_str(payload_h)
        if e == "" {
            return bytes_of_str("-ERR worker\r\n")
        }
        return bytes_of_str(concat(concat("-ERR ", e), "\r\n"))
    }
    return bytes_of_str("-ERR bad reply kind\r\n")
}

// Legacy str view of a reply (text-only OK/int/ASCII bulk). Prefer _bytes.
fn lsm_mb_rep_to_str(kind: i64, payload_h: i64) -> str {
    return str_of_bytes(lsm_mb_rep_to_bytes(kind, payload_h))
}

// Kept for wipe/tests that still clean leftover disk from older runs.
fn lsm_job_req_path(dir: str, id: i64) -> str {
    return concat(concat(dir, ".jobs."), concat(int_to_str(id), ".req"))
}

fn lsm_job_rep_path(dir: str, id: i64) -> str {
    return concat(concat(dir, ".jobs."), concat(int_to_str(id), ".rep"))
}

fn lsm_job_next_path(dir: str) -> str {
    return concat(dir, ".jobs.next")
}

// Worker ctx = cell2(work_ch, cell2(shard_id, done_ch))
// R47: done_ch in ctx is now only a legacy fallback; each job carries its
// own reply chan (see lsm_mb_job) so MT conn threads never compete on one
// shared done chan.
