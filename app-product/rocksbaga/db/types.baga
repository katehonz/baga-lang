// types.baga — shared engine types (LsmDB).

import "../cache/page.baga"
import "../table/bloom.baga"
import "../table/sstable.baga"
import "../table/sstable_parse.baga"
import "../table/sstable_lookup.baga"
import "../table/sstable_meta.baga"
import "../table/sstable_scan.baga"

struct LsmDB {
    dir: str,
    // R67: in-memory keys are raw bytes (NUL-safe); str APIs adapt at the edge.
    mem: Map<bytes, bytes>,
    tomb: Map<bytes, i64>,
    mem_n: i64,
    flush_at: i64,
    compact_at: i64,
    target_bytes: i64,  // 0 = byte triggers off; L0 target size
    merge_pick: i64,    // 0 = merge all over files; >0 = oldest-N (R8)
    wal_fd: i64,
    wal_off: i64,
    wal_buf: bytes,   // R14: pending WAL bytes (flushed on sync / full)
    wal_buf_max: i64, // flush buffer when len >= this (0 = unbuffered)
    wal_buf_len: i64, // R18: used prefix of wal_buf (offset append, no concat)
    gens: Vec<i64>,
    levels: Vec<i64>,   // parallel: 0=L0 … 3=L3
    next_gen: i64,
    cache: PageCache,
    blooms: BloomCache, // R11: sidecar bloom filters loaded once per gen
    sst_fds: Map<i64, i64>,   // R11: open SST fd cache (gen → fd)
    sst_sizes: Map<i64, i64>, // gen → file size
    sst_meta: Map<i64, SstMeta>, // R12: footer/index/minmax per gen
    // R23: last SST restart-block span for get (avoids re-copy on sequential hits).
    // Owned by LsmDB only — not shared with compact/scan drop paths.
    hot_gen: i64,
    hot_off: i64,
    hot_n: i64,
    hot_data: bytes,
    sync_every: i64,
    since_sync: i64,
    // R40: edit lines appended to dir.manifest.log since last snapshot compact.
    manifest_edits: i64,
    // R63: SCAN streaming snapshot — live keys for one MATCH, reused across
    // cursor pages until write_epoch advances (put/del/flush/compact).
    write_epoch: i64,
    scan_epoch: i64,       // equals write_epoch when scan_keys is valid
    scan_pat: bytes,       // R68: MATCH pattern (raw bytes) used to build scan_keys
    scan_keys: Vec<bytes>, // R67: filtered live keys as raw bytes (unordered — Redis SCAN style)
    ok: i64
}

