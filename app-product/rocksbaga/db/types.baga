// types.baga — shared engine types (LsmDB).

import "../cache/page.baga"
import "../table/bloom.baga"
import "../table/sstable.baga"

struct LsmDB {
    dir: str,
    mem: Map<str, bytes>,
    tomb: Map<str, i64>,
    mem_n: i64,
    flush_at: i64,
    compact_at: i64,
    target_bytes: i64,  // 0 = byte triggers off; L0 target size
    merge_pick: i64,    // 0 = merge all over files; >0 = oldest-N (R8)
    wal_fd: i64,
    wal_off: i64,
    wal_buf: bytes,   // R14: pending WAL bytes (flushed on sync / full)
    wal_buf_max: i64, // flush buffer when len >= this (0 = unbuffered)
    wal_buf_len: i64, // R18: used prefix of wal_buf (offset append, no concat)
    gens: Vec<i64>,
    levels: Vec<i64>,   // parallel: 0=L0 … 3=L3
    next_gen: i64,
    cache: PageCache,
    blooms: BloomCache, // R11: sidecar bloom filters loaded once per gen
    sst_fds: Map<i64, i64>,   // R11: open SST fd cache (gen → fd)
    sst_sizes: Map<i64, i64>, // gen → file size
    sst_meta: Map<i64, SstMeta>, // R12: footer/index/minmax per gen
    sync_every: i64,
    since_sync: i64,
    ok: i64
}

