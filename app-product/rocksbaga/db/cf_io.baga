// cf_io.baga — column family IO: WAL append/flush/sync/rotate, put/get/
// del (str + bytes), compact loop, flush, close. Отварянето/сетоптите
// са в cf.baga.

import "cf.baga"
import "engine.baga"
import "manifest.baga"
import "compact.baga"
import "../cache/page.baga"
import "../wal/wal.baga"
import "../table/sstable.baga"
import "../table/sstable_parse.baga"
import "../table/sstable_meta.baga"
import "../table/sstable_scan.baga"
import "../util/codec.baga"
import "../util/ttl.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"
import "std/time/time.baga"

fn lsm_cf_wal_append(db: LsmCFDB, op: i64, cf_id: i64, key: bytes, val: bytes) -> LsmCFDB !IO {
    let rec = wal_record_cf_b(op, cf_id, key, val)
    let rl = bytes_len(rec)
    if db.wal_buf_max <= 0 {
        if fd_pwrite_bytes(db.wal_fd, rec, db.wal_off) != 0 {
            drop(rec)
            db.ok = 0
            return db
        }
        db.wal_off = db.wal_off + rl
        drop(rec)
        return db
    }
    if rl >= db.wal_buf_max {
        db = lsm_cf_wal_flush_buf(db)?
        if db.ok == 0 {
            drop(rec)
            return db
        }
        if fd_pwrite_bytes(db.wal_fd, rec, db.wal_off) != 0 {
            drop(rec)
            db.ok = 0
            return db
        }
        db.wal_off = db.wal_off + rl
        drop(rec)
        return db
    }
    if db.wal_buf_len + rl > db.wal_buf_max {
        db = lsm_cf_wal_flush_buf(db)?
        if db.ok == 0 {
            drop(rec)
            return db
        }
    }
    if bytes_len(db.wal_buf) < db.wal_buf_max {
        db.wal_buf = bytes_new(db.wal_buf_max)
        db.wal_buf_len = 0
    }
    let mut i: i64 = 0
    while i < rl {
        bytes_set(db.wal_buf, db.wal_buf_len + i, bytes_at(rec, i))
        i = i + 1
    }
    db.wal_buf_len = db.wal_buf_len + rl
    drop(rec)
    return db
}

fn lsm_cf_wal_flush_buf(db: LsmCFDB) -> LsmCFDB !IO {
    if db.wal_buf_len <= 0 {
        return db
    }
    let view = bytes_slice(db.wal_buf, 0, db.wal_buf_len)
    let rec = wal_wrap_batch(view)
    drop(view)
    let rl = bytes_len(rec)
    if fd_pwrite_bytes(db.wal_fd, rec, db.wal_off) != 0 {
        drop(rec)
        db.ok = 0
        return db
    }
    drop(rec)
    db.wal_off = db.wal_off + rl
    db.wal_buf_len = 0
    return db
}

fn lsm_cf_maybe_sync(db: LsmCFDB) -> LsmCFDB !IO {
    db.since_sync = db.since_sync + 1
    if db.since_sync >= db.sync_every {
        db = lsm_cf_wal_flush_buf(db)?
        if db.ok == 0 {
            return db
        }
        fdatasync(db.wal_fd)?
        db.since_sync = 0
    }
    return db
}

// R68: bytes-key CF put core (memtable keys are bytes since R67).
fn lsm_cf_put_kb(db: LsmCFDB, cf_id: i64, key: bytes, val: bytes) -> LsmCFDB !IO !Time {
    db = lsm_cf_ensure(db, cf_id)?
    db = lsm_cf_wal_append(db, 1, cf_id, key, val)?
    if db.ok == 0 {
        return db
    }
    let mut fam = map_get(db.families, cf_id)
    map_set(fam.mem, key, val)
    if map_len(fam.tomb) > 0 {
        map_del(fam.tomb, key)
    }
    fam.mem_n = fam.mem_n + 1
    map_set(db.families, cf_id, fam)
    db = lsm_cf_maybe_sync(db)?
    // Auto-flush this CF when full
    fam = map_get(db.families, cf_id)
    if fam.mem_n >= fam.flush_at {
        db = lsm_cf_flush(db, cf_id)?
    }
    return db
}

// R65: binary-safe CF put (value may contain NUL).
fn lsm_cf_put_b(db: LsmCFDB, cf_id: i64, key: str, val: bytes) -> LsmCFDB !IO !Time {
    return lsm_cf_put_kb(db, cf_id, bytes_of_str(key), val)?
}

fn lsm_cf_put(db: LsmCFDB, cf_id: i64, key: str, val: str) -> LsmCFDB !IO !Time {
    return lsm_cf_put_b(db, cf_id, key, bytes_of_str(val))?
}

struct LsmCFGet {
    db: LsmCFDB,
    found: i64,
    val: bytes
}

fn lsm_cf_get(db: LsmCFDB, cf_id: i64, key: str) -> LsmCFGet !IO !Time {
    return lsm_cf_get_kb(db, cf_id, bytes_of_str(key))?
}

// R68: bytes-key CF get core.
fn lsm_cf_get_kb(db: LsmCFDB, cf_id: i64, key: bytes) -> LsmCFGet !IO !Time {
    db = lsm_cf_ensure(db, cf_id)?
    let mut fam = map_get(db.families, cf_id)
    // Reuse single-store get on the family LsmDB (SST path only; no WAL on fam)
    let g = lsm_get_kb(fam, key)?
    fam = g.db
    map_set(db.families, cf_id, fam)
    return LsmCFGet { db: db, found: g.found, val: g.val }
}

fn lsm_cf_del(db: LsmCFDB, cf_id: i64, key: str) -> LsmCFDB !IO !Time {
    return lsm_cf_del_kb(db, cf_id, bytes_of_str(key))?
}

// R68: bytes-key CF delete core.
fn lsm_cf_del_kb(db: LsmCFDB, cf_id: i64, key: bytes) -> LsmCFDB !IO !Time {
    db = lsm_cf_ensure(db, cf_id)?
    let empty = bytes_new(0)
    db = lsm_cf_wal_append(db, 2, cf_id, key, empty)?
    if db.ok == 0 {
        return db
    }
    let mut fam = map_get(db.families, cf_id)
    map_del(fam.mem, key)
    map_set(fam.tomb, key, 1)
    fam.mem_n = fam.mem_n + 1
    map_set(db.families, cf_id, fam)
    db = lsm_cf_maybe_sync(db)?
    return db
}

// R48: L0..L3 compaction chain for one family (same policy as lsm_flush).
fn lsm_cf_compact_loop(fam: LsmDB) -> LsmDB !IO !Time {
    let mut db = fam
    let mut guard: i64 = 0
    let mut more: i64 = 1
    while more == 1 && guard < 32 {
        let n0 = lsm_count_level(db.levels, 0)
        let n1 = lsm_count_level(db.levels, 1)
        let n2 = lsm_count_level(db.levels, 2)
        let n3 = lsm_count_level(db.levels, 3)
        let b0 = lsm_level_bytes(db, 0)?
        let b1 = lsm_level_bytes(db, 1)?
        let b2 = lsm_level_bytes(db, 2)?
        let b3 = lsm_level_bytes(db, 3)?
        let over0 = lsm_level_over(db, 0, n0, b0)
        let over1 = lsm_level_over(db, 1, n1, b1)
        let over2 = lsm_level_over(db, 2, n2, b2)
        let over3 = lsm_level_over(db, 3, n3, b3)
        if over0 == 1 || over1 == 1 || over2 == 1 || over3 == 1 {
            db = lsm_compact(db)?
            guard = guard + 1
        } else {
            more = 0
        }
    }
    return db
}

// R48: rotate the shared WAL once every family is clean (all memtables
// flushed). Before this the shared WAL grew forever and every reopen
// replayed already-flushed records back into memtables.
fn lsm_cf_wal_rotate(db: LsmCFDB) -> LsmCFDB !IO {
    let ks = map_keys(db.families)
    let mut i: i64 = 0
    while i < vec_len(ks) {
        let fam = map_get(db.families, vec_get(ks, i))
        if fam.mem_n > 0 {
            return db
        }
        i = i + 1
    }
    close(db.wal_fd)
    unlink(lsm_wal_path(db.dir))?
    let wfd = open(lsm_wal_path(db.dir), 578, 420)?
    if wfd < 0 {
        db.ok = 0
        return db
    }
    db.wal_fd = wfd
    db.wal_off = 0
    db.wal_buf_len = 0
    return db
}

// Flush one CF's memtable to its SST path. R48: runs the L0..L3 compaction
// chain on the family afterwards, and rotates the shared WAL when every
// family is clean.
fn lsm_cf_flush(db: LsmCFDB, cf_id: i64) -> LsmCFDB !IO !Time {
    db = lsm_cf_ensure(db, cf_id)?
    let mut fam = map_get(db.families, cf_id)
    if fam.mem_n == 0 {
        return db
    }
    db = lsm_cf_wal_flush_buf(db)?
    if db.ok == 0 {
        return db
    }
    fdatasync(db.wal_fd)?
    let now = time_now_ms()?
    // R67: family memtable keys are bytes (sort via bytes_cmp).
    let all = map_keys(fam.mem)
    let tk = map_keys(fam.tomb)
    let mut ti: i64 = 0
    while ti < vec_len(tk) {
        let k = vec_get(tk, ti)
        if map_has(fam.mem, k) == 0 {
            vec_push(all, k)
        }
        ti = ti + 1
    }
    sort_bytes(all)
    let rows: Vec<SstRow> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(all) {
        let k = vec_get(all, i)
        if map_has(fam.mem, k) == 0 {
            vec_push(rows, SstRow { op: 2, key: k, val: bytes_new(0) })
        } else {
            let raw = map_get(fam.mem, k)
            let u = ttl_unpack(raw)
            if ttl_expired(u.expire_at, now) == 1 {
                vec_push(rows, SstRow { op: 2, key: k, val: bytes_new(0) })
            } else {
                vec_push(rows, SstRow { op: 1, key: k, val: raw })
            }
        }
        i = i + 1
    }
    let gen = fam.next_gen
    if vec_len(rows) > 0 {
        if sst_write(fam.dir, gen, rows)? != 0 {
            db.ok = 0
            return db
        }
        vec_push(fam.gens, gen)
        vec_push(fam.levels, 0)
        fam.next_gen = gen + 1
        let na = lsm_manifest_log_add(fam.dir, gen, 0, fam.next_gen)?
        if na < 0 {
            db.ok = 0
            return db
        }
        fam.manifest_edits = fam.manifest_edits + na
        let ec = lsm_manifest_maybe_compact(
            fam.dir, fam.next_gen, fam.gens, fam.levels, fam.manifest_edits
        )?
        if ec < 0 {
            db.ok = 0
            return db
        }
        fam.manifest_edits = ec
    }
    drop(rows)
    fam.mem = map_new()
    fam.tomb = map_new()
    fam.mem_n = 0
    fam.wal_fd = 0 - 1
    // R48: per-CF compaction chain (SSTs no longer pile up per family)
    if db.ok == 1 {
        fam = lsm_cf_compact_loop(fam)?
    }
    map_set(db.families, cf_id, fam)
    // R48: shared WAL rotation once all families are clean
    if db.ok == 1 {
        db = lsm_cf_wal_rotate(db)?
    }
    return db
}

fn lsm_cf_close(db: LsmCFDB) -> i64 !IO !Time {
    // Flush all non-empty families
    let ks = map_keys(db.families)
    let mut i: i64 = 0
    while i < vec_len(ks) {
        let id = vec_get(ks, i)
        let fam = map_get(db.families, id)
        if fam.mem_n > 0 {
            db = lsm_cf_flush(db, id)?
        }
        i = i + 1
    }
    db = lsm_cf_wal_flush_buf(db)?
    if db.wal_fd >= 0 {
        fdatasync(db.wal_fd)?
        close(db.wal_fd)
    }
    // Persist name map
    lsm_cfs_save(db.dir, db.next_cf_id, db.names, db.opt_flush, db.opt_compact, db.opt_cache)?
    // Close family SST caches (no WAL)
    i = 0
    while i < vec_len(ks) {
        let id2 = vec_get(ks, i)
        let mut fam2 = map_get(db.families, id2)
        fam2.wal_fd = 0 - 1
        lsm_close(fam2)?
        i = i + 1
    }
    return 0
}
