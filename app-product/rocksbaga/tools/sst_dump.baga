// sst_dump.baga — offline SST / MANIFEST inspector (R26).
//
// Usage (repo root):
//   ./baga -I . -I app-product app-product/rocksbaga/tools/sst_dump.baga
// Env:
//   LSMPATH   data prefix (default /tmp/baga_lsm)
//   SST_GEN   dump one gen only (default 0 = all gens from MANIFEST)
//   SST_KEYS  1 = print every key (default 0 = summary only)
//   SST_MAX   max keys to print when SST_KEYS=1 (default 50)

import "rocksbaga/db/manifest.baga"
import "rocksbaga/table/sstable.baga"
import "rocksbaga/table/sstable_parse.baga"
import "rocksbaga/table/sstable_lookup.baga"
import "rocksbaga/table/sstable_meta.baga"
import "rocksbaga/table/sstable_scan.baga"
import "rocksbaga/table/bloom.baga"
import "rocksbaga/cache/page.baga"
import "rocksbaga/util/codec.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

fn cfg(name: str, def: str) -> str !IO {
    let v = env(name)?
    if v == "" {
        return def
    }
    return v
}

fn dump_one(dir: str, gen: i64, print_keys: i64, max_keys: i64) -> i64 !IO {
    let path = sst_path(dir, gen)
    let fd = open(path, 0, 0)?
    if fd < 0 {
        print(concat(concat("gen=", int_to_str(gen)), " MISSING_SST"))
        return 0
    }
    let fsize = fd_size(fd)?
    close(fd)
    let bpath = bloom_path(dir, gen)
    let bfd = open(bpath, 0, 0)?
    let mut has_bloom: i64 = 0
    let mut bsize: i64 = 0
    if bfd >= 0 {
        has_bloom = 1
        bsize = fd_size(bfd)?
        close(bfd)
    }
    let mut pc = pc_new(4096, 64)
    let fds: Map<i64, i64> = map_new()
    let sizes: Map<i64, i64> = map_new()
    let fd2 = sst_fd_get(pc, fds, sizes, dir, gen)?
    if fd2 < 0 {
        print(concat(concat("gen=", int_to_str(gen)), " OPEN_FAIL"))
        return 1
    }
    let ml = sst_meta_load(pc, fd2, gen, fsize)?
    pc = ml.pc
    let mut nkeys: i64 = 0
    let mut ntomb: i64 = 0
    let mut shown: i64 = 0
    if ml.meta.ok == 1 {
        let mut sc = sst_scan_begin(pc, fd2, gen, fsize)?
        pc = sc.pc
        if sc.open == 1 {
            let mut go: i64 = 1
            while go == 1 {
                let st = sst_scan_next(sc)?
                sc = st.scan
                if st.done == 1 {
                    go = 0
                } else {
                    if st.ok == 1 {
                        if st.row.op == 2 {
                            ntomb = ntomb + 1
                        } else {
                            nkeys = nkeys + 1
                        }
                        if print_keys == 1 && shown < max_keys {
                            let mut tag = "PUT"
                            if st.row.op == 2 {
                                tag = "DEL"
                            }
                            print(concat(concat(concat(concat("  ", tag), " "), str_of_bytes(st.row.key)),
                                concat(" vlen=", int_to_str(bytes_len(st.row.val)))))
                            shown = shown + 1
                        }
                    }
                }
            }
            pc = sc.pc
        }
        print(concat(
            concat(
                concat(
                    concat(
                        concat(
                            concat(
                                concat(
                                    concat(
                                        concat(concat("gen=", int_to_str(gen)), " size="),
                                        int_to_str(fsize)
                                    ),
                                    " tag="
                                ),
                                int_to_str(ml.meta.tag)
                            ),
                            " restarts="
                        ),
                        int_to_str(ml.meta.n_restarts)
                    ),
                    " first="
                ),
                str_of_bytes(ml.meta.first_key)
            ),
            concat(
                concat(
                    concat(
                        concat(concat(" last=", str_of_bytes(ml.meta.last_key)), " puts="),
                        int_to_str(nkeys)
                    ),
                    " tombs="
                ),
                int_to_str(ntomb)
            )
        ))
        print(concat(
            concat(
                concat(concat("  bloom_sidecar=", int_to_str(has_bloom)), " bloom_bytes="),
                int_to_str(bsize)
            ),
            ""
        ))
    } else {
        // Legacy / unreadable meta — full load count
        let ld = sst_load(pc, dir, gen)?
        pc = ld.pc
        if ld.parse.ok == 1 {
            for j in 0..vec_len(ld.parse.rows) {
                let r = vec_get(ld.parse.rows, j)
                if r.op == 2 {
                    ntomb = ntomb + 1
                } else {
                    nkeys = nkeys + 1
                }
            }
            print(concat(
                concat(
                    concat(
                        concat(
                            concat(concat("gen=", int_to_str(gen)), " size="),
                            int_to_str(fsize)
                        ),
                        " legacy puts="
                    ),
                    int_to_str(nkeys)
                ),
                concat(" tombs=", int_to_str(ntomb))
            ))
        } else {
            print(concat(concat("gen=", int_to_str(gen)), " UNREADABLE"))
        }
    }
    sst_fd_drop(pc, fds, sizes, gen)?
    return 0
}

fn main() -> i64 !IO {
    let dir = cfg("LSMPATH", "/tmp/baga_lsm")?
    let genv = cfg("SST_GEN", "0")?
    let want_gen = parse_int(genv)
    let kenv = cfg("SST_KEYS", "0")?
    let print_keys = parse_int(kenv)
    let menv = cfg("SST_MAX", "50")?
    let mut max_keys = parse_int(menv)
    if max_keys < 1 {
        max_keys = 50
    }

    print(concat("sst_dump path=", dir))
    let m = lsm_load_manifest(dir)?
    print(concat(
        concat(
            concat(concat("manifest next_gen=", int_to_str(m.next_gen)), " nfiles="),
            int_to_str(vec_len(m.gens))
        ),
        ""
    ))
    for i in 0..vec_len(m.gens) {
        let g = vec_get(m.gens, i)
        let mut lv: i64 = 0
        if i < vec_len(m.levels) {
            lv = vec_get(m.levels, i)
        }
        print(concat(
            concat(
                concat(concat("  file gen=", int_to_str(g)), " level="),
                int_to_str(lv)
            ),
            ""
        ))
    }

    if want_gen > 0 {
        return dump_one(dir, want_gen, print_keys, max_keys)?
    }
    if vec_len(m.gens) == 0 {
        print("(no SST gens in manifest)")
        return 0
    }
    for i in 0..vec_len(m.gens) {
        let g = vec_get(m.gens, i)
        let rc = dump_one(dir, g, print_keys, max_keys)?
        if rc != 0 {
            return rc
        }
    }
    print("OK")
    return 0
}
