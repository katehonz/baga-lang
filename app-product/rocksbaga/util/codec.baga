// codec.baga — little-endian u32 + string compare/sort for rocksbaga.

import "std/str/str.baga"

// Write u32 le into b at off (b must already be large enough).
fn put_u32_le(b: bytes, off: i64, v: i64) {
    bytes_set(b, off, v & 255)
    bytes_set(b, off + 1, (v >> 8) & 255)
    bytes_set(b, off + 2, (v >> 16) & 255)
    bytes_set(b, off + 3, (v >> 24) & 255)
}

fn get_u32_le(b: bytes, off: i64) -> i64 {
    return (bytes_at(b, off) & 255)
        | ((bytes_at(b, off + 1) & 255) << 8)
        | ((bytes_at(b, off + 2) & 255) << 16)
        | ((bytes_at(b, off + 3) & 255) << 24)
}

fn put_i64_le(b: bytes, off: i64, v: i64) {
    put_u32_le(b, off, v)
    put_u32_le(b, off + 4, v >> 32)
}

fn get_i64_le(b: bytes, off: i64) -> i64 {
    let lo = get_u32_le(b, off)
    let hi = get_u32_le(b, off + 4)
    return lo | (hi << 32)
}

// Append one u32 le to a growing buffer (returns new bytes).
// One concat of a 4-byte chunk — not 4× bytes_push (R14).
fn push_u32_le(b: bytes, v: i64) -> bytes {
    let chunk = bytes_new(4)
    put_u32_le(chunk, 0, v)
    return bytes_concat(b, chunk)
}

// Append a single byte without O(n) per-byte realloc chain when possible.
fn push_u8(b: bytes, v: i64) -> bytes {
    let chunk = bytes_new(1)
    bytes_set(chunk, 0, v & 255)
    return bytes_concat(b, chunk)
}

fn push_bytes(dst: bytes, src: bytes) -> bytes {
    return bytes_concat(dst, src)
}

fn push_str_bytes(dst: bytes, s: str) -> bytes {
    return bytes_concat(dst, bytes_of_str(s))
}

// Lexicographic compare: -1 if a<b, 0 if equal, 1 if a>b.
fn str_cmp(a: str, b: str) -> i64 {
    let na = len(a)
    let nb = len(b)
    let mut i: i64 = 0
    let mut n = na
    if nb < n {
        n = nb
    }
    while i < n {
        let ca = char_at(a, i)
        let cb = char_at(b, i)
        if ca < cb {
            return -1
        }
        if ca > cb {
            return 1
        }
        i = i + 1
    }
    if na < nb {
        return -1
    }
    if na > nb {
        return 1
    }
    return 0
}

// In-place insertion sort (small n).
fn sort_strs_ins(v: Vec<str>, lo: i64, hi: i64) {
    let mut i = lo + 1
    while i <= hi {
        let key = vec_get(v, i)
        let mut j = i - 1
        let mut moving = 1
        while moving == 1 {
            if j < lo {
                moving = 0
            } else {
                if str_cmp(vec_get(v, j), key) <= 0 {
                    moving = 0
                } else {
                    vec_set(v, j + 1, vec_get(v, j))
                    j = j - 1
                }
            }
        }
        vec_set(v, j + 1, key)
        i = i + 1
    }
}

// Quicksort partition (last element pivot).
fn sort_strs_part(v: Vec<str>, lo: i64, hi: i64) -> i64 {
    let pivot = vec_get(v, hi)
    let mut i = lo
    let mut j = lo
    while j < hi {
        if str_cmp(vec_get(v, j), pivot) <= 0 {
            let tmp = vec_get(v, i)
            vec_set(v, i, vec_get(v, j))
            vec_set(v, j, tmp)
            i = i + 1
        }
        j = j + 1
    }
    let tmp = vec_get(v, i)
    vec_set(v, i, vec_get(v, hi))
    vec_set(v, hi, tmp)
    return i
}

fn sort_strs_qs(v: Vec<str>, lo: i64, hi: i64) {
    if hi - lo < 16 {
        if lo < hi {
            sort_strs_ins(v, lo, hi)
        }
        return
    }
    if lo < hi {
        let p = sort_strs_part(v, lo, hi)
        sort_strs_qs(v, lo, p - 1)
        sort_strs_qs(v, p + 1, hi)
    }
}

// In-place sort of Vec<str> ascending.
// R21: quicksort (O(n log n)) + insertion for small slices. Former full-range
// insertion sort was O(n²) and dominated flush ROWS at n≥1k (~56% of flush).
fn sort_strs(v: Vec<str>) {
    let n = vec_len(v)
    if n > 1 {
        sort_strs_qs(v, 0, n - 1)
    }
}

// R67: lexicographic compare of raw key bytes (NUL-safe — a Baga str cannot
// hold an embedded 0x00, so binary keys must live and compare as bytes).
// -1 if a<b, 0 if equal, 1 if a>b.
fn bytes_cmp(a: bytes, b: bytes) -> i64 {
    let na = bytes_len(a)
    let nb = bytes_len(b)
    let mut n = na
    if nb < n {
        n = nb
    }
    let mut i: i64 = 0
    while i < n {
        let ca = bytes_at(a, i) & 255
        let cb = bytes_at(b, i) & 255
        if ca < cb {
            return 0 - 1
        }
        if ca > cb {
            return 1
        }
        i = i + 1
    }
    if na < nb {
        return 0 - 1
    }
    if na > nb {
        return 1
    }
    return 0
}

// In-place insertion sort (small n), bytes variant of sort_strs_ins.
fn sort_bytes_ins(v: Vec<bytes>, lo: i64, hi: i64) {
    let mut i = lo + 1
    while i <= hi {
        let key = vec_get(v, i)
        let mut j = i - 1
        let mut moving = 1
        while moving == 1 {
            if j < lo {
                moving = 0
            } else {
                if bytes_cmp(vec_get(v, j), key) <= 0 {
                    moving = 0
                } else {
                    vec_set(v, j + 1, vec_get(v, j))
                    j = j - 1
                }
            }
        }
        vec_set(v, j + 1, key)
        i = i + 1
    }
}

// Quicksort partition (last element pivot), bytes variant.
fn sort_bytes_part(v: Vec<bytes>, lo: i64, hi: i64) -> i64 {
    let pivot = vec_get(v, hi)
    let mut i = lo
    let mut j = lo
    while j < hi {
        if bytes_cmp(vec_get(v, j), pivot) <= 0 {
            let tmp = vec_get(v, i)
            vec_set(v, i, vec_get(v, j))
            vec_set(v, j, tmp)
            i = i + 1
        }
        j = j + 1
    }
    let tmp = vec_get(v, i)
    vec_set(v, i, vec_get(v, hi))
    vec_set(v, hi, tmp)
    return i
}

fn sort_bytes_qs(v: Vec<bytes>, lo: i64, hi: i64) {
    if hi - lo < 16 {
        if lo < hi {
            sort_bytes_ins(v, lo, hi)
        }
        return
    }
    if lo < hi {
        let p = sort_bytes_part(v, lo, hi)
        sort_bytes_qs(v, lo, p - 1)
        sort_bytes_qs(v, p + 1, hi)
    }
}

// R67: in-place sort of Vec<bytes> ascending (same shape as sort_strs).
fn sort_bytes(v: Vec<bytes>) {
    let n = vec_len(v)
    if n > 1 {
        sort_bytes_qs(v, 0, n - 1)
    }
}
