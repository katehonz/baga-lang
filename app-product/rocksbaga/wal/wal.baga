// wal.baga — append-only write-ahead log with crc32c records.
// Values are binary-safe bytes (R3). R67: keys are binary-safe bytes too —
// the *_b cores take key: bytes; the plain names stay str wrappers
// (bytes_of_str is lossless). On-disk layout unchanged (length-prefixed).

import "../util/codec.baga"
import "std/os/os.baga"
import "std/crypto/crc32c.baga"
import "std/str/str.baga"

// op: 1 = Put, 2 = Del (CF 0 / legacy)
// op: 17 = CF Put, 18 = CF Del — payload includes u32 cf_id after op (R44)
// Payload layout (no framing):
//   legacy: op | u32 klen | key | u32 vlen | val
//   cf:     op | u32 cf_id | u32 klen | key | u32 vlen | val
fn WAL_OP_PUT() -> i64 { return 1 }
fn WAL_OP_DEL() -> i64 { return 2 }
fn WAL_OP_CF_PUT() -> i64 { return 17 }
fn WAL_OP_CF_DEL() -> i64 { return 18 }
// K5: one CRC over a flush window (row+index+… as one record).
fn WAL_OP_BATCH() -> i64 { return 19 }

fn wal_payload_b(op: i64, key: bytes, val: bytes) -> bytes {
    let klen = bytes_len(key)
    let vlen = bytes_len(val)
    let plen = 1 + 4 + klen + 4 + vlen
    let p = bytes_new(plen)
    bytes_set(p, 0, op & 255)
    put_u32_le(p, 1, klen)
    let mut i: i64 = 0
    while i < klen {
        bytes_set(p, 5 + i, bytes_at(key, i))
        i = i + 1
    }
    put_u32_le(p, 5 + klen, vlen)
    i = 0
    while i < vlen {
        bytes_set(p, 9 + klen + i, bytes_at(val, i))
        i = i + 1
    }
    return p
}

fn wal_payload(op: i64, key: str, val: bytes) -> bytes {
    return wal_payload_b(op, bytes_of_str(key), val)
}

// Encode one WAL record (len | payload | crc) without writing.
// R14: prealloc. R22: single buffer — write payload at off=4, CRC over that
// span (no separate payload alloc + full copy into rec).
// R67: bytes-key core.
fn wal_record_b(op: i64, key: bytes, val: bytes) -> bytes {
    let klen = bytes_len(key)
    let vlen = bytes_len(val)
    let plen = 1 + 4 + klen + 4 + vlen
    let rec = bytes_new(4 + plen + 4)
    put_u32_le(rec, 0, plen)
    bytes_set(rec, 4, op & 255)
    put_u32_le(rec, 5, klen)
    let mut i: i64 = 0
    while i < klen {
        bytes_set(rec, 9 + i, bytes_at(key, i))
        i = i + 1
    }
    put_u32_le(rec, 9 + klen, vlen)
    i = 0
    while i < vlen {
        bytes_set(rec, 13 + klen + i, bytes_at(val, i))
        i = i + 1
    }
    // CRC over payload only (bytes [4, 4+plen))
    let payload_view = bytes_slice(rec, 4, 4 + plen)
    let crc = crc32c_b(payload_view)
    put_u32_le(rec, 4 + plen, crc)
    // drop slice view if droppable — slice may share or copy; drop if owned
    drop(payload_view)
    return rec
}

fn wal_record(op: i64, key: str, val: bytes) -> bytes {
    return wal_record_b(op, bytes_of_str(key), val)
}

// R44: CF-aware WAL record (op 17/18). R67: bytes-key core.
fn wal_record_cf_b(op: i64, cf_id: i64, key: bytes, val: bytes) -> bytes {
    // Normalize to CF ops
    let mut o = op
    if o == 1 {
        o = WAL_OP_CF_PUT()
    }
    if o == 2 {
        o = WAL_OP_CF_DEL()
    }
    let klen = bytes_len(key)
    let vlen = bytes_len(val)
    // plen = op + cf_id + klen + key + vlen + val
    let plen = 1 + 4 + 4 + klen + 4 + vlen
    let rec = bytes_new(4 + plen + 4)
    put_u32_le(rec, 0, plen)
    bytes_set(rec, 4, o & 255)
    put_u32_le(rec, 5, cf_id)
    put_u32_le(rec, 9, klen)
    let mut i: i64 = 0
    while i < klen {
        bytes_set(rec, 13 + i, bytes_at(key, i))
        i = i + 1
    }
    put_u32_le(rec, 13 + klen, vlen)
    i = 0
    while i < vlen {
        bytes_set(rec, 17 + klen + i, bytes_at(val, i))
        i = i + 1
    }
    let payload_view = bytes_slice(rec, 4, 4 + plen)
    let crc = crc32c_b(payload_view)
    put_u32_le(rec, 4 + plen, crc)
    drop(payload_view)
    return rec
}

fn wal_record_cf(op: i64, cf_id: i64, key: str, val: bytes) -> bytes {
    return wal_record_cf_b(op, cf_id, bytes_of_str(key), val)
}

// Wrap already-framed inner records (len|payload|crc)* as one BATCH.
// Torn pwrite fails the outer CRC → replay skips the whole window (K5).
fn wal_wrap_batch(inner: bytes) -> bytes {
    let ilen = bytes_len(inner)
    let plen = 1 + ilen
    let rec = bytes_new(4 + plen + 4)
    put_u32_le(rec, 0, plen)
    bytes_set(rec, 4, WAL_OP_BATCH())
    let mut i: i64 = 0
    while i < ilen {
        bytes_set(rec, 5 + i, bytes_at(inner, i))
        i = i + 1
    }
    let payload_view = bytes_slice(rec, 4, 4 + plen)
    let crc = crc32c_b(payload_view)
    put_u32_le(rec, 4 + plen, crc)
    drop(payload_view)
    return rec
}

// Append one record; returns new file offset after the write, or -1.
fn wal_append(fd: i64, off: i64, op: i64, key: str, val: bytes) -> i64 !IO {
    let rec = wal_record(op, key, val)
    if fd_pwrite_bytes(fd, rec, off) != 0 {
        return -1
    }
    return off + bytes_len(rec)
}

// Replay callback result is accumulated by the engine; this returns a
// decoded list of ops as parallel vectors (ops, keys, vals, cfs).
// R44: cfs[i] is column-family id (0 for legacy op 1/2).
// R67: keys are raw bytes slices (no str_of_bytes — NUL keys survive replay).
struct WalReplay {
    ok: i64,
    ops: Vec<i64>,
    keys: Vec<bytes>,
    vals: Vec<bytes>,
    cfs: Vec<i64>,
    end_off: i64
}

// Decode one CRC-checked payload into the replay vectors. BATCH (19)
// expands to its inner framed records. Returns 1 if at least the
// payload was well-formed (batch may contribute 0..N ops).
fn wal_push_payload(payload: bytes, ops: Vec<i64>, keys: Vec<bytes>, vals: Vec<bytes>, cfs: Vec<i64>) -> i64 {
    if bytes_len(payload) < 1 {
        return 0
    }
    let op = bytes_at(payload, 0) & 255
    if op == 19 {
        let inner = bytes_slice(payload, 1, bytes_len(payload))
        let inn = bytes_len(inner)
        let mut ioff: i64 = 0
        while ioff + 8 <= inn {
            let iplen = get_u32_le(inner, ioff)
            if iplen <= 0 || ioff + 4 + iplen + 4 > inn {
                return 1
            }
            let ipay = bytes_slice(inner, ioff + 4, ioff + 4 + iplen)
            let icrc = get_u32_le(inner, ioff + 4 + iplen)
            if crc32c_b(ipay) != icrc {
                return 1
            }
            if wal_push_payload(ipay, ops, keys, vals, cfs) == 0 {
                return 1
            }
            ioff = ioff + 4 + iplen + 4
        }
        return 1
    }
    if bytes_len(payload) < 1 + 4 {
        return 0
    }
    let mut cf_id: i64 = 0
    let mut koff: i64 = 1
    if op == 17 || op == 18 {
        if bytes_len(payload) < 1 + 4 + 4 {
            return 0
        }
        cf_id = get_u32_le(payload, 1)
        koff = 5
    }
    let klen = get_u32_le(payload, koff)
    let kstart = koff + 4
    if bytes_len(payload) < kstart + klen + 4 {
        return 0
    }
    let key = bytes_slice(payload, kstart, kstart + klen)
    let vlen = get_u32_le(payload, kstart + klen)
    let vstart = kstart + klen + 4
    if bytes_len(payload) < vstart + vlen {
        return 0
    }
    let val = bytes_slice(payload, vstart, vstart + vlen)
    let mut nop = op
    if op == 17 {
        nop = 1
    }
    if op == 18 {
        nop = 2
    }
    vec_push(ops, nop)
    vec_push(keys, key)
    vec_push(vals, val)
    vec_push(cfs, cf_id)
    return 1
}

fn wal_replay(fd: i64) -> WalReplay !IO {
    let ops: Vec<i64> = vec_new()
    let keys: Vec<bytes> = vec_new()
    let vals: Vec<bytes> = vec_new()
    let cfs: Vec<i64> = vec_new()
    let mut off: i64 = 0
    let mut running: i64 = 1
    while running == 1 {
        let hdr = fd_pread_bytes(fd, 4, off)?
        if bytes_len(hdr) < 4 {
            running = 0
        } else {
            let plen = get_u32_le(hdr, 0)
            if plen <= 0 || plen > 67108864 {
                running = 0
            } else {
                let body = fd_pread_bytes(fd, plen + 4, off + 4)?
                if bytes_len(body) < plen + 4 {
                    running = 0
                } else {
                    let payload = bytes_slice(body, 0, plen)
                    let got_crc = get_u32_le(body, plen)
                    if crc32c_b(payload) != got_crc {
                        running = 0
                    } else {
                        if wal_push_payload(payload, ops, keys, vals, cfs) == 0 {
                            running = 0
                        } else {
                            off = off + 4 + plen + 4
                        }
                    }
                }
            }
        }
    }
    return WalReplay {
        ok: 1, ops: ops, keys: keys, vals: vals, cfs: cfs, end_off: off
    }
}
