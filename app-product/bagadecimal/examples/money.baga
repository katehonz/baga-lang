// money.baga — bagaDecimal demo (rust-decimal README example).
//
//   price 25.12, tax 8.5% → total 27.26

import "../src/decimal.baga"
import "std/str/str.baga"

fn main() {
    let price = dec_parse("25.12")
    let rate = dec_parse("0.085")
    if price.ok == 0 || rate.ok == 0 {
        eprintln("parse error")
        exit(1)
    }
    let tax = dec_mul(price.value, rate.value)
    if tax.ok == 0 {
        eprintln(tax.err)
        exit(1)
    }
    let tax2 = dec_round_dp(tax.value, 2)
    let total = dec_add(price.value, tax2.value)
    let total2 = dec_round_dp(total.value, 2)
    print(concat("price=", dec_to_string(price.value)))
    print(concat("tax=", dec_to_string(tax2.value)))
    print(concat("total=", dec_to_string(total2.value)))
}
