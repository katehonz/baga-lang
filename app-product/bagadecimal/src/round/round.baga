// round.baga — rounding to `places` digits after the decimal point.
//
// Modes (dec_round_impl):
//   0  half-away-from-zero (dec_round_dp)   1.25 → 1.3,  -1.25 → -1.3
//   1  half-even / bankers  (dec_round_bankers_dp)  1.225 → 1.22, 1.235 → 1.24
//   2  toward zero / trunc  (dec_trunc_dp)  1.29 → 1.2,  -1.29 → -1.2
//   3  toward -inf / floor  (dec_floor_dp)  1.21 → 1.2,  -1.21 → -1.3
//   4  toward +inf / ceil   (dec_ceil_dp)   1.21 → 1.3,  -1.21 → -1.2
// Zero results are always unsigned (+0.00), same convention as dec_parse.

import "../types.baga"
import "../limb.baga"

struct DecDrop {
    q: Vec<i64>,
    msd: i64,
    sticky: i64
}

// Drop `drop` least significant decimal digits: q keeps the rest, msd is
// the most significant dropped digit, sticky is 1 when any lower dropped
// digit was nonzero.
fn dec_drop_digits(v0: Vec<i64>, drop: i64) -> DecDrop {
    let mut v = v0
    let mut i: i64 = 0
    let mut msd: i64 = 0
    let mut sticky: i64 = 0
    while i < drop {
        let dv = dec_limb_div_small(v, 10)
        v = dv.q
        if msd != 0 {
            sticky = 1
        }
        msd = dv.rem
        i = i + 1
    }
    return DecDrop { q: v, msd: msd, sticky: sticky }
}

fn dec_round_impl(d: Decimal, places: i64, mode: i64) -> DecResult {
    if places < 0 || places > 28 {
        return dec_err("invalid places")
    }
    let scale = dec_scale(d)
    if scale <= places {
        if scale == places {
            return dec_ok(d)
        }
        // increase scale with trailing zeros = multiply by 10^diff (same value)
        let p = dec_limb_mul_pow10(dec_limb_from_dec(d), places - scale, 1)
        if p.ok == 0 {
            return dec_err("overflow rounding (pad)")
        }
        return dec_ok(dec_from_limb3(p.v, dec_is_negative(d), places))
    }
    let neg = dec_is_negative(d)
    let dd = dec_drop_digits(dec_limb_from_dec(d), scale - places)
    let mut v = dd.q
    let mut bump: i64 = 0
    if mode == 0 {
        if dd.msd >= 5 {
            bump = 1
        }
    } else {
        if mode == 1 {
            // half-even: up when strictly above the midpoint, or exactly at
            // it with a nonzero tail, or at it with an odd kept digit
            if dd.msd > 5 {
                bump = 1
            }
            if dd.msd == 5 {
                if dd.sticky != 0 {
                    bump = 1
                } else {
                    if vec_len(v) > 0 && (vec_get(v, 0) & 1) == 1 {
                        bump = 1
                    }
                }
            }
        } else {
            if mode == 3 {
                if neg != 0 && (dd.msd != 0 || dd.sticky != 0) {
                    bump = 1
                }
            } else {
                if mode == 4 {
                    if neg == 0 && (dd.msd != 0 || dd.sticky != 0) {
                        bump = 1
                    }
                }
            }
        }
    }
    if bump != 0 {
        v = dec_limb_add(v, dec_limb3(1, 0, 0))
    }
    if dec_limb_fits96(v) == 0 {
        return dec_err("overflow rounding")
    }
    let mut n = neg
    if dec_limb_is_zero(v) == 1 {
        n = 0
    }
    return dec_ok(dec_from_limb3(v, n, places))
}

// MidpointAwayFromZero: 1.25 → 1.3 at 1 dp; -1.25 → -1.3.
fn dec_round_dp(d: Decimal, places: i64) -> DecResult {
    return dec_round_impl(d, places, 0)
}

// MidpointToEven (banker's): 1.225 → 1.22, 1.235 → 1.24 at 2 dp.
fn dec_round_bankers_dp(d: Decimal, places: i64) -> DecResult {
    return dec_round_impl(d, places, 1)
}

// Toward zero (truncation): 1.29 → 1.2, -1.29 → -1.2.
fn dec_trunc_dp(d: Decimal, places: i64) -> DecResult {
    return dec_round_impl(d, places, 2)
}

// Toward -inf: 1.21 → 1.2, -1.21 → -1.3.
fn dec_floor_dp(d: Decimal, places: i64) -> DecResult {
    return dec_round_impl(d, places, 3)
}

// Toward +inf: 1.21 → 1.3, -1.21 → -1.2.
fn dec_ceil_dp(d: Decimal, places: i64) -> DecResult {
    return dec_round_impl(d, places, 4)
}
