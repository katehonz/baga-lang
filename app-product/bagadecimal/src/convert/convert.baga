// convert.baga — i64 bridges (P0)

import "../types.baga"
import "../limb.baga"

fn dec_from_i64(n: i64) -> Decimal {
    return dec_from_i64_scale(n, 0)
}

fn dec_from_i64_scale(n: i64, scale: i64) -> Decimal {
    if scale < 0 || scale > 28 {
        return dec_zero()
    }
    // INT64_MIN
    if n == 0 - 9223372036854775807 - 1 {
        return dec_from_parts(0, 2147483648, 0, 1, scale)
    }
    let mut neg: i64 = 0
    let mut mag = n
    if n < 0 {
        neg = 1
        mag = 0 - n
    }
    let lo = mag & 4294967295
    let mid = (mag >> 32) & 4294967295
    return dec_from_parts(lo, mid, 0, neg, scale)
}

struct DecI64 {
    ok: i64,
    err: str,
    value: i64
}

fn dec_to_i64(d: Decimal) -> DecI64 {
    let scale = dec_scale(d)
    let mut v = dec_limb_from_dec(d)
    let mut i: i64 = 0
    while i < scale {
        let dv = dec_limb_div_small(v, 10)
        v = dv.q
        i = i + 1
    }
    let mut hi32: i64 = 0
    if vec_len(v) > 2 {
        hi32 = vec_get(v, 2) & 4294967295
    }
    if hi32 != 0 {
        return DecI64 { ok: 0, err: "to_i64 overflow", value: 0 }
    }
    let mut mid: i64 = 0
    if vec_len(v) > 1 {
        mid = vec_get(v, 1) & 4294967295
    }
    let mut lo: i64 = 0
    if vec_len(v) > 0 {
        lo = vec_get(v, 0) & 4294967295
    }
    if mid > 2147483647 {
        if dec_is_negative(d) != 0 && mid == 2147483648 && lo == 0 {
            return DecI64 { ok: 1, err: "", value: 0 - 9223372036854775807 - 1 }
        }
        return DecI64 { ok: 0, err: "to_i64 overflow", value: 0 }
    }
    let mag = lo + (mid << 32)
    if dec_is_negative(d) != 0 {
        return DecI64 { ok: 1, err: "", value: 0 - mag }
    }
    return DecI64 { ok: 1, err: "", value: mag }
}
