// arith.baga — Decimal + − × ÷

import "../types.baga"
import "../limb.baga"
import "cmp.baga"

fn dec_align_to(d: Decimal, target: i64) -> DecResult {
    let s = dec_scale(d)
    if target < s {
        return dec_err("align: target < scale")
    }
    if target > 28 {
        return dec_err("scale overflow")
    }
    let p = dec_limb_mul_pow10(dec_limb_from_dec(d), target - s, 1)
    if p.ok == 0 {
        return dec_err("overflow aligning scale")
    }
    if dec_limb_fits96(p.v) == 0 {
        return dec_err("overflow aligning scale")
    }
    return dec_ok(dec_from_limb3(p.v, dec_is_negative(d), target))
}

fn dec_add(a: Decimal, b: Decimal) -> DecResult {
    if dec_is_zero(a) == 1 {
        return dec_ok(b)
    }
    if dec_is_zero(b) == 1 {
        return dec_ok(a)
    }
    let sa = dec_scale(a)
    let sb = dec_scale(b)
    let mut scale = sa
    if sb > scale {
        scale = sb
    }
    let aa = dec_align_to(a, scale)
    if aa.ok == 0 {
        return aa
    }
    let bb = dec_align_to(b, scale)
    if bb.ok == 0 {
        return bb
    }
    let na = dec_is_negative(aa.value)
    let nb = dec_is_negative(bb.value)
    let la = dec_limb_from_dec(aa.value)
    let lb = dec_limb_from_dec(bb.value)
    if na == nb {
        let sum = dec_limb_add(la, lb)
        if dec_limb_fits96(sum) == 0 {
            return dec_err("overflow in add")
        }
        return dec_ok(dec_from_limb3(sum, na, scale))
    }
    let c = dec_limb_cmp(la, lb)
    if c == 0 {
        return dec_ok(dec_from_parts(0, 0, 0, 0, scale))
    }
    if c > 0 {
        return dec_ok(dec_from_limb3(dec_limb_sub(la, lb), na, scale))
    }
    return dec_ok(dec_from_limb3(dec_limb_sub(lb, la), nb, scale))
}

fn dec_sub(a: Decimal, b: Decimal) -> DecResult {
    return dec_add(a, dec_neg(b))
}

fn dec_mul(a: Decimal, b: Decimal) -> DecResult {
    if dec_is_zero(a) == 1 || dec_is_zero(b) == 1 {
        let mut s = dec_scale(a) + dec_scale(b)
        if s > 28 {
            s = 28
        }
        return dec_ok(dec_from_parts(0, 0, 0, 0, s))
    }
    let scale = dec_scale(a) + dec_scale(b)
    let mut n: i64 = 0
    if dec_is_negative(a) != dec_is_negative(b) {
        n = 1
    }
    let mut v = dec_limb_mul(dec_limb_from_dec(a), dec_limb_from_dec(b))
    let mut sc = scale
    if sc > 28 {
        let extra = sc - 28
        let mut i: i64 = 0
        let mut rem: i64 = 0
        while i < extra {
            let dv = dec_limb_div_small(v, 10)
            v = dv.q
            rem = dv.rem
            i = i + 1
        }
        if rem >= 5 {
            v = dec_limb_add(v, dec_limb3(1, 0, 0))
        }
        sc = 28
    }
    if dec_limb_fits96(v) == 0 {
        return dec_err("overflow in mul")
    }
    return dec_ok(dec_from_limb3(v, n, sc))
}

// Division: result at result_scale, half-away-from-zero.
fn dec_div_scale(a: Decimal, b: Decimal, result_scale: i64) -> DecResult {
    if dec_is_zero(b) == 1 {
        return dec_err("division by zero")
    }
    if result_scale < 0 || result_scale > 28 {
        return dec_err("invalid result scale")
    }
    if dec_is_zero(a) == 1 {
        return dec_ok(dec_from_parts(0, 0, 0, 0, result_scale))
    }
    let mut n: i64 = 0
    if dec_is_negative(a) != dec_is_negative(b) {
        n = 1
    }
    let sa = dec_scale(a)
    let sb = dec_scale(b)
    // mant_r / 10^rs = (mant_a/10^sa) / (mant_b/10^sb)
    // mant_r = mant_a * 10^(sb - sa + rs) / mant_b
    let exp = sb - sa + result_scale
    let mut num = dec_limb_from_dec(a)
    let mut den = dec_limb_from_dec(b)
    if exp >= 0 {
        let p = dec_limb_mul_pow10(num, exp, 0)
        num = p.v
    } else {
        let p2 = dec_limb_mul_pow10(den, 0 - exp, 0)
        den = p2.v
    }
    // guard digit: compute (num*10)/den then round
    let num10 = dec_limb_mul_small(num, 10)
    let dv = dec_limb_div(num10, den)
    let split = dec_limb_div_small(dv.q, 10)
    let mut q = split.q
    if split.rem >= 5 {
        q = dec_limb_add(q, dec_limb3(1, 0, 0))
    }
    if dec_limb_fits96(q) == 0 {
        return dec_err("overflow in div")
    }
    return dec_ok(dec_from_limb3(q, n, result_scale))
}

fn dec_div(a: Decimal, b: Decimal) -> DecResult {
    let mut rs = dec_scale(a)
    if dec_scale(b) > rs {
        rs = dec_scale(b)
    }
    if rs < 6 {
        rs = 6
    }
    if rs > 28 {
        rs = 28
    }
    return dec_div_scale(a, b, rs)
}
