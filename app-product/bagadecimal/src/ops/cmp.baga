// cmp.baga — comparison and unary sign ops.

import "../types.baga"
import "../limb.baga"

fn dec_cmp(a: Decimal, b: Decimal) -> i64 {
    if dec_is_zero(a) == 1 && dec_is_zero(b) == 1 {
        return 0
    }
    let na = dec_is_negative(a)
    let nb = dec_is_negative(b)
    if na != 0 && nb == 0 {
        return -1
    }
    if na == 0 && nb != 0 {
        return 1
    }
    let sa = dec_scale(a)
    let sb = dec_scale(b)
    let mut la = dec_limb_from_dec(a)
    let mut lb = dec_limb_from_dec(b)
    if sa > sb {
        let p = dec_limb_mul_pow10(lb, sa - sb, 0)
        lb = p.v
    }
    if sb > sa {
        let p2 = dec_limb_mul_pow10(la, sb - sa, 0)
        la = p2.v
    }
    let c = dec_limb_cmp(la, lb)
    if na != 0 {
        if c < 0 {
            return 1
        }
        if c > 0 {
            return -1
        }
        return 0
    }
    return c
}

fn dec_eq(a: Decimal, b: Decimal) -> i64 {
    if dec_cmp(a, b) == 0 {
        return 1
    }
    return 0
}

fn dec_lt(a: Decimal, b: Decimal) -> i64 {
    if dec_cmp(a, b) < 0 {
        return 1
    }
    return 0
}

fn dec_abs(d: Decimal) -> Decimal {
    return dec_from_parts(d.lo, d.mid, d.hi, 0, dec_scale(d))
}

fn dec_neg(d: Decimal) -> Decimal {
    if dec_is_zero(d) == 1 {
        return dec_from_parts(0, 0, 0, 0, dec_scale(d))
    }
    if dec_is_negative(d) == 0 {
        return dec_from_parts(d.lo, d.mid, d.hi, 1, dec_scale(d))
    }
    return dec_from_parts(d.lo, d.mid, d.hi, 0, dec_scale(d))
}
