// types.baga — Decimal core type (rust-decimal shape).

// flags: bit 31 = negative; bits 16..23 = scale (0..28)
// lo/mid/hi: 32-bit limbs of the unsigned mantissa (in i64, high bits 0)
struct Decimal {
    lo: i64,
    mid: i64,
    hi: i64,
    flags: i64
}

// Parse / overflow stand-in until L3 Result (gaps D4).
struct DecResult {
    ok: i64,
    err: str,
    value: Decimal
}

fn dec_ok(v: Decimal) -> DecResult {
    return DecResult { ok: 1, err: "", value: v }
}

fn dec_err(msg: str) -> DecResult {
    return DecResult { ok: 0, err: msg, value: dec_zero() }
}

fn dec_scale(d: Decimal) -> i64 {
    return (d.flags >> 16) & 255
}

fn dec_is_negative(d: Decimal) -> i64 {
    if (d.flags & 2147483648) != 0 {
        return 1
    }
    return 0
}

fn dec_zero() -> Decimal {
    return Decimal { lo: 0, mid: 0, hi: 0, flags: 0 }
}

fn dec_one() -> Decimal {
    return Decimal { lo: 1, mid: 0, hi: 0, flags: 0 }
}

fn dec_from_parts(lo: i64, mid: i64, hi: i64, negative: i64, scale: i64) -> Decimal {
    let mut flags: i64 = (scale & 255) << 16
    if negative != 0 {
        flags = flags | 2147483648
    }
    return Decimal {
        lo: lo & 4294967295,
        mid: mid & 4294967295,
        hi: hi & 4294967295,
        flags: flags
    }
}

fn dec_set_sign(d: Decimal, negative: i64) -> Decimal {
    return dec_from_parts(d.lo, d.mid, d.hi, negative, dec_scale(d))
}

fn dec_set_scale(d: Decimal, scale: i64) -> Decimal {
    return dec_from_parts(d.lo, d.mid, d.hi, dec_is_negative(d), scale)
}

fn dec_is_zero(d: Decimal) -> i64 {
    if d.lo == 0 && d.mid == 0 && d.hi == 0 {
        return 1
    }
    return 0
}
