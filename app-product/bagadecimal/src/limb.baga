// limb.baga — unsigned multi-limb helpers (32-bit limbs in i64).
// Little-endian Vec: index 0 = least significant limb.

import "types.baga"

fn dec_limb3(lo: i64, mid: i64, hi: i64) -> Vec<i64> {
    let v = vec_new()
    vec_push(v, lo & 4294967295)
    vec_push(v, mid & 4294967295)
    vec_push(v, hi & 4294967295)
    return v
}

fn dec_limb_from_dec(d: Decimal) -> Vec<i64> {
    return dec_limb3(d.lo, d.mid, d.hi)
}

fn dec_from_limb3(v: Vec<i64>, negative: i64, scale: i64) -> Decimal {
    let mut lo: i64 = 0
    let mut mid: i64 = 0
    let mut hi: i64 = 0
    if vec_len(v) > 0 {
        lo = vec_get(v, 0) & 4294967295
    }
    if vec_len(v) > 1 {
        mid = vec_get(v, 1) & 4294967295
    }
    if vec_len(v) > 2 {
        hi = vec_get(v, 2) & 4294967295
    }
    return dec_from_parts(lo, mid, hi, negative, scale)
}

fn dec_limb_is_zero(v: Vec<i64>) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(v) {
        if (vec_get(v, i) & 4294967295) != 0 {
            return 0
        }
        i = i + 1
    }
    return 1
}

fn dec_limb_cmp(a: Vec<i64>, b: Vec<i64>) -> i64 {
    let mut na = vec_len(a)
    let mut nb = vec_len(b)
    while na > 0 && (vec_get(a, na - 1) & 4294967295) == 0 {
        na = na - 1
    }
    while nb > 0 && (vec_get(b, nb - 1) & 4294967295) == 0 {
        nb = nb - 1
    }
    if na < nb {
        return -1
    }
    if na > nb {
        return 1
    }
    let mut i = na - 1
    while i >= 0 {
        let x = vec_get(a, i) & 4294967295
        let y = vec_get(b, i) & 4294967295
        if x < y {
            return -1
        }
        if x > y {
            return 1
        }
        i = i - 1
    }
    return 0
}

fn dec_limb_add(a: Vec<i64>, b: Vec<i64>) -> Vec<i64> {
    let n = vec_len(a)
    let m = vec_len(b)
    let mut len = n
    if m > len {
        len = m
    }
    let out = vec_new()
    let mut carry: i64 = 0
    let mut i: i64 = 0
    while i < len || carry != 0 {
        let mut s = carry
        if i < n {
            s = s + (vec_get(a, i) & 4294967295)
        }
        if i < m {
            s = s + (vec_get(b, i) & 4294967295)
        }
        vec_push(out, s & 4294967295)
        carry = s >> 32
        i = i + 1
    }
    return out
}

fn dec_limb_sub(a: Vec<i64>, b: Vec<i64>) -> Vec<i64> {
    let n = vec_len(a)
    let m = vec_len(b)
    let out = vec_new()
    let mut borrow: i64 = 0
    let mut i: i64 = 0
    while i < n {
        let av = vec_get(a, i) & 4294967295
        let mut bv: i64 = 0
        if i < m {
            bv = vec_get(b, i) & 4294967295
        }
        let mut d = av - bv - borrow
        if d < 0 {
            d = d + 4294967296
            borrow = 1
        } else {
            borrow = 0
        }
        vec_push(out, d & 4294967295)
        i = i + 1
    }
    return out
}

fn dec_limb_mul_small(a: Vec<i64>, m: i64) -> Vec<i64> {
    let mm = m & 4294967295
    let out = vec_new()
    let mut carry: i64 = 0
    let mut i: i64 = 0
    while i < vec_len(a) || carry != 0 {
        let mut cur = carry
        if i < vec_len(a) {
            cur = cur + (vec_get(a, i) & 4294967295) * mm
        }
        vec_push(out, cur & 4294967295)
        carry = cur >> 32
        i = i + 1
    }
    return out
}

fn dec_limb_mul(a: Vec<i64>, b: Vec<i64>) -> Vec<i64> {
    let n = vec_len(a)
    let m = vec_len(b)
    let out = vec_new()
    let mut k: i64 = 0
    while k < n + m + 1 {
        vec_push(out, 0)
        k = k + 1
    }
    let mut i: i64 = 0
    while i < n {
        let ai = vec_get(a, i) & 4294967295
        if ai != 0 {
            let mut carry: i64 = 0
            let mut j: i64 = 0
            while j < m {
                let cur = (vec_get(out, i + j) & 4294967295) + ai * (vec_get(b, j) & 4294967295) + carry
                vec_set(out, i + j, cur & 4294967295)
                carry = cur >> 32
                j = j + 1
            }
            let mut t = i + m
            while carry != 0 {
                let cur2 = (vec_get(out, t) & 4294967295) + carry
                vec_set(out, t, cur2 & 4294967295)
                carry = cur2 >> 32
                t = t + 1
            }
        }
        i = i + 1
    }
    return out
}

struct DecLimbDiv {
    q: Vec<i64>,
    rem: i64
}

fn dec_limb_div_small(a: Vec<i64>, m: i64) -> DecLimbDiv {
    let mm = m & 4294967295
    let q = vec_new()
    let mut i: i64 = 0
    while i < vec_len(a) {
        vec_push(q, 0)
        i = i + 1
    }
    let mut rem: i64 = 0
    let mut j = vec_len(a) - 1
    while j >= 0 {
        let cur = rem * 4294967296 + (vec_get(a, j) & 4294967295)
        let digit = cur / mm
        rem = cur - digit * mm
        vec_set(q, j, digit & 4294967295)
        j = j - 1
    }
    return DecLimbDiv { q: q, rem: rem }
}

fn dec_limb_fits96(v: Vec<i64>) -> i64 {
    let mut i: i64 = 3
    while i < vec_len(v) {
        if (vec_get(v, i) & 4294967295) != 0 {
            return 0
        }
        i = i + 1
    }
    return 1
}

struct DecLimbPow {
    ok: i64,
    v: Vec<i64>
}

fn dec_limb_mul_pow10(a: Vec<i64>, k: i64, require96: i64) -> DecLimbPow {
    let mut v = a
    let mut i: i64 = 0
    while i < k {
        v = dec_limb_mul_small(v, 10)
        if require96 != 0 {
            if dec_limb_fits96(v) == 0 {
                return DecLimbPow { ok: 0, v: v }
            }
        }
        i = i + 1
    }
    return DecLimbPow { ok: 1, v: v }
}

// Bit length of limb vector (0 if zero).
fn dec_limb_bitlen(a: Vec<i64>) -> i64 {
    let mut an = vec_len(a)
    while an > 0 && (vec_get(a, an - 1) & 4294967295) == 0 {
        an = an - 1
    }
    if an == 0 {
        return 0
    }
    let limb = vec_get(a, an - 1) & 4294967295
    let mut bpos: i64 = 31
    while bpos >= 0 {
        if ((limb >> bpos) & 1) == 1 {
            return (an - 1) * 32 + bpos + 1
        }
        bpos = bpos - 1
    }
    return (an - 1) * 32
}

fn dec_limb_get_bit(a: Vec<i64>, bit: i64) -> i64 {
    let limb_i = bit / 32
    let bit_i = bit % 32
    if limb_i < 0 || limb_i >= vec_len(a) {
        return 0
    }
    return (vec_get(a, limb_i) >> bit_i) & 1
}

fn dec_limb_set_bit(q: Vec<i64>, bit: i64) {
    let qlimb = bit / 32
    let qbit = bit % 32
    while vec_len(q) <= qlimb {
        vec_push(q, 0)
    }
    vec_set(q, qlimb, (vec_get(q, qlimb) & 4294967295) | (1 << qbit))
}

// Full limb division q = floor(a/b). rem field unused (0).
fn dec_limb_div(a: Vec<i64>, b: Vec<i64>) -> DecLimbDiv {
    let mut bn = vec_len(b)
    while bn > 1 && (vec_get(b, bn - 1) & 4294967295) == 0 {
        bn = bn - 1
    }
    if bn <= 0 {
        return DecLimbDiv { q: dec_limb3(0, 0, 0), rem: 0 }
    }
    if bn == 1 {
        return dec_limb_div_small(a, vec_get(b, 0))
    }
    if dec_limb_cmp(a, b) < 0 {
        return DecLimbDiv { q: dec_limb3(0, 0, 0), rem: 0 }
    }
    let bits = dec_limb_bitlen(a)
    let mut r = dec_limb3(0, 0, 0)
    let q = dec_limb3(0, 0, 0)
    let mut bit = bits - 1
    while bit >= 0 {
        r = dec_limb_mul_small(r, 2)
        if dec_limb_get_bit(a, bit) == 1 {
            r = dec_limb_add(r, dec_limb3(1, 0, 0))
        }
        if dec_limb_cmp(r, b) >= 0 {
            r = dec_limb_sub(r, b)
            dec_limb_set_bit(q, bit)
        }
        bit = bit - 1
    }
    return DecLimbDiv { q: q, rem: 0 }
}
