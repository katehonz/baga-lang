// format.baga — Decimal → string

import "../types.baga"
import "../limb.baga"
import "std/str/str.baga"

fn dec_to_string(d: Decimal) -> str {
    let scale = dec_scale(d)
    let mut v = dec_limb_from_dec(d)
    let digits = vec_new()
    if dec_limb_is_zero(v) == 1 {
        vec_push(digits, 0)
    } else {
        while dec_limb_is_zero(v) == 0 {
            let dv = dec_limb_div_small(v, 10)
            v = dv.q
            vec_push(digits, dv.rem)
        }
    }
    let mut nd = vec_len(digits)
    while nd <= scale {
        vec_push(digits, 0)
        nd = nd + 1
    }
    let mut out = ""
    if dec_is_negative(d) != 0 {
        out = "-"
    }
    let mut i = nd - 1
    let mut started: i64 = 0
    while i >= scale {
        let dig = vec_get(digits, i)
        if started != 0 || dig != 0 || i == scale {
            out = concat(out, int_to_str(dig))
            started = 1
        }
        i = i - 1
    }
    if started == 0 {
        out = concat(out, "0")
    }
    if scale > 0 {
        out = concat(out, ".")
        let mut j = scale - 1
        while j >= 0 {
            out = concat(out, int_to_str(vec_get(digits, j)))
            j = j - 1
        }
    }
    return out
}

// Strip trailing fractional zeros; zero → "0".
fn dec_to_string_normalized(d: Decimal) -> str {
    if dec_is_zero(d) == 1 {
        return "0"
    }
    let mut scale = dec_scale(d)
    let mut v = dec_limb_from_dec(d)
    while scale > 0 {
        let dv = dec_limb_div_small(v, 10)
        if dv.rem != 0 {
            return dec_to_string(dec_from_limb3(v, dec_is_negative(d), scale))
        }
        v = dv.q
        scale = scale - 1
    }
    return dec_to_string(dec_from_limb3(v, dec_is_negative(d), 0))
}
