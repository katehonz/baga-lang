// tpl.baga — HTML template engine (apps-roadmap №7).
//
// Mustache-ish subset over plain HTML:
//   {{ name }}             interpolated, HTML-escaped (missing → "")
//   {{ name | trim | upper }}  filter chain (name switch — no L5 values)
//   {{{ name }}}           raw interpolation (no escape)
//   {% if name %} … {% else %} … {% endif %}   nestable truthiness blocks
//   {% if !name %}         negation
//   {# comment #}          dropped
//
// Context is Map<str,str>; truthy = present, non-empty, not "0".
// Design: the source is tokenized into prefix-encoded Vec<str> ("T"ext,
// "V"ar, "R"aw, "I"f, "E"lse, endif "X"), blocks are paired into a
// Map<i64,i64> jump table, and the render is a single iterative walk —
// no recursion, no Vec<struct> (L4), no function values (L5).
// Errors use TplOut { ok, html, err } — honest stand-in for L3 Result
// (pgbaga G1 / jsonrpcbaga R1 convention).

import "std/str/str.baga"

// ---------- result type (L3 stand-in) ----------

struct TplOut {
    ok: i64,      // 1 = html holds the render; 0 = err holds the reason
    html: str,
    err: str
}

fn tpl_ok(html: str) -> TplOut {
    return TplOut { ok: 1, html: html, err: "" }
}

fn tpl_err(err: str) -> TplOut {
    return TplOut { ok: 0, html: "", err: err }
}

// ---------- escape ----------

fn tpl_escape(s: str) -> str {
    let mut out = ""
    let mut i: i64 = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c == 38 {
            out = concat(out, "&amp;")
        } else {
            if c == 60 {
                out = concat(out, "&lt;")
            } else {
                if c == 62 {
                    out = concat(out, "&gt;")
                } else {
                    if c == 34 {
                        out = concat(out, "&quot;")
                    } else {
                        out = concat(out, substr(s, i, i + 1))
                    }
                }
            }
        }
        i = i + 1
    }
    return out
}

// ---------- small string helpers ----------

// First occurrence of needle at or after `from`, or -1.
fn tpl_find_from(s: str, needle: str, from: i64) -> i64 {
    let n = len(needle)
    if n == 0 { return from }
    let mut i = from
    while i + n <= len(s) {
        if substr(s, i, i + n) == needle { return i }
        i = i + 1
    }
    return -1
}

// ---------- tokenizer ----------

// Fills toks with prefixed tokens; comments are dropped. Returns "" on
// success or an error message. Token prefixes: "T" literal text, "V"
// escaped interpolation, "R" raw interpolation, "I" if-condition,
// "E" else, "X" endif.
fn tpl_tokenize(src: str, toks: Vec<str>) -> str {
    let n = len(src)
    let mut i: i64 = 0
    while i < n {
        let t_var = tpl_find_from(src, "{{", i)
        let t_tag = tpl_find_from(src, "{%", i)
        let t_com = tpl_find_from(src, "{#", i)
        let mut k = -1
        if t_var >= 0 { k = t_var }
        if t_tag >= 0 && (k < 0 || t_tag < k) { k = t_tag }
        if t_com >= 0 && (k < 0 || t_com < k) { k = t_com }
        if k < 0 {
            vec_push(toks, concat("T", substr(src, i, n)))
            i = n
        } else {
            if k > i {
                vec_push(toks, concat("T", substr(src, i, k)))
            }
            if substr(src, k, k + 2) == "{#" {
                let close = tpl_find_from(src, "#}", k + 2)
                if close < 0 {
                    return concat("незатворен коментар {# при позиция ", int_to_str(k))
                }
                i = close + 2
            } else {
                if substr(src, k, k + 2) == "{%" {
                    let close = tpl_find_from(src, "%}", k + 2)
                    if close < 0 {
                        return concat("незатворен таг {% при позиция ", int_to_str(k))
                    }
                    let body = str_trim(substr(src, k + 2, close))
                    if body == "else" {
                        vec_push(toks, "E")
                    } else {
                        if body == "endif" {
                            vec_push(toks, "X")
                        } else {
                            if str_starts_with(body, "if ") {
                                let cond = str_trim(substr(body, 3, len(body)))
                                if cond == "" {
                                    return concat("празно условие на if при позиция ", int_to_str(k))
                                }
                                vec_push(toks, concat("I", cond))
                            } else {
                                return concat("непознат таг: ", body)
                            }
                        }
                    }
                    i = close + 2
                } else {
                    // {{ expr }} or {{{ expr }}}
                    let mut raw: i64 = 0
                    let mut open_len: i64 = 2
                    if k + 2 < n && char_at(src, k + 2) == 123 {
                        raw = 1
                        open_len = 3
                    }
                    let mut closer = "}}"
                    if raw == 1 { closer = "}}}" }
                    let close = tpl_find_from(src, closer, k + open_len)
                    if close < 0 {
                        return concat("незатворен израз {{ при позиция ", int_to_str(k))
                    }
                    let expr = str_trim(substr(src, k + open_len, close))
                    if expr == "" {
                        return concat("празен израз при позиция ", int_to_str(k))
                    }
                    if raw == 1 {
                        vec_push(toks, concat("R", expr))
                    } else {
                        vec_push(toks, concat("V", expr))
                    }
                    i = close + len(closer)
                }
            }
        }
    }
    return ""
}

// ---------- block jump table ----------

// Pairs if/else/endif tokens: jump[if] → its else (or endif),
// jump[else] → its endif. The walker always skips the token it lands on.
// Returns "" on success or an error message.
fn tpl_jumps(toks: Vec<str>, jump: Map<i64, i64>) -> str {
    let open: Map<i64, i64> = map_new()   // depth → if-token index
    let els: Map<i64, i64> = map_new()    // if-token index → else index
    let mut depth: i64 = 0
    let n = vec_len(toks)
    let mut i: i64 = 0
    while i < n {
        let t = vec_get(toks, i)
        if str_starts_with(t, "I") {
            depth = depth + 1
            map_set(open, depth, i)
        } else {
            if t == "E" {
                if depth == 0 {
                    return "else без съответен if"
                }
                let a = map_get(open, depth)
                if map_has(els, a) == 1 {
                    return "втори else в един if"
                }
                map_set(els, a, i)
            } else {
                if t == "X" {
                    if depth == 0 {
                        return "endif без съответен if"
                    }
                    let a = map_get(open, depth)
                    depth = depth - 1
                    if map_has(els, a) == 1 {
                        let e = map_get(els, a)
                        map_set(jump, a, e)
                        map_set(jump, e, i)
                    } else {
                        map_set(jump, a, i)
                    }
                }
            }
        }
        i = i + 1
    }
    if depth > 0 {
        return "if без съответен endif"
    }
    return ""
}

// ---------- truthiness ----------

// Truthy = present, non-empty, not "0". A leading "!" negates.
fn tpl_truthy(ctx: Map<str, str>, name: str) -> bool {
    if str_starts_with(name, "!") {
        return !tpl_truthy(ctx, str_trim(substr(name, 1, len(name))))
    }
    if map_has(ctx, name) == 0 {
        return false
    }
    let v = map_get(ctx, name)
    return v != "" && v != "0"
}

// ---------- filters (L5 probe: name switch) ----------

fn tpl_filter_known(name: str) -> bool {
    return name == "upper" || name == "lower" || name == "trim" || name == "len" || name == "default"
}

// ASCII only (same honesty as grebaga -i).
fn tpl_upper(s: str) -> str {
    let mut out = ""
    let mut i: i64 = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c >= 97 && c <= 122 {
            out = concat(out, chr(c - 32))
        } else {
            out = concat(out, substr(s, i, i + 1))
        }
        i = i + 1
    }
    return out
}

fn tpl_lower(s: str) -> str {
    let mut out = ""
    let mut i: i64 = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c >= 65 && c <= 90 {
            out = concat(out, chr(c + 32))
        } else {
            out = concat(out, substr(s, i, i + 1))
        }
        i = i + 1
    }
    return out
}

// One filter spec: "upper", "default:fallback". Only `default` reads the
// argument; other filters ignore it. Unknown name → err.
fn tpl_filter_apply(v: str, fs: str) -> TplOut {
    let mut name = fs
    let mut arg = ""
    let colon = tpl_find_from(fs, ":", 0)
    if colon >= 0 {
        name = str_trim(substr(fs, 0, colon))
        arg = substr(fs, colon + 1, len(fs))
    }
    if !tpl_filter_known(name) {
        return tpl_err(concat("непознат филтър: ", name))
    }
    if name == "upper" {
        return tpl_ok(tpl_upper(v))
    }
    if name == "lower" {
        return tpl_ok(tpl_lower(v))
    }
    if name == "trim" {
        return tpl_ok(str_trim(v))
    }
    if name == "len" {
        return tpl_ok(int_to_str(len(v)))
    }
    // default
    if v == "" {
        return tpl_ok(arg)
    }
    return tpl_ok(v)
}

// Evaluates "name | f1 | f2" against the context (missing name → "").
fn tpl_expr(expr: str, ctx: Map<str, str>) -> TplOut {
    let parts = str_split(expr, "|")
    let name = str_trim(vec_get(parts, 0))
    if name == "" {
        return tpl_err("празно име на променлива")
    }
    let mut v = map_get(ctx, name)
    let mut i: i64 = 1
    let n = vec_len(parts)
    while i < n {
        let r = tpl_filter_apply(v, str_trim(vec_get(parts, i)))
        if r.ok == 0 {
            return r
        }
        v = r.html
        i = i + 1
    }
    return tpl_ok(v)
}

// ---------- render ----------

fn tpl_render(src: str, ctx: Map<str, str>) -> TplOut {
    let toks: Vec<str> = vec_new()
    let terr = tpl_tokenize(src, toks)
    if terr != "" {
        return tpl_err(terr)
    }
    let jump: Map<i64, i64> = map_new()
    let jerr = tpl_jumps(toks, jump)
    if jerr != "" {
        return tpl_err(jerr)
    }
    let mut out = ""
    let mut i: i64 = 0
    let n = vec_len(toks)
    while i < n {
        let t = vec_get(toks, i)
        let head = substr(t, 0, 1)
        if head == "T" {
            out = concat(out, substr(t, 1, len(t)))
            i = i + 1
        } else {
            if head == "V" {
                let r = tpl_expr(substr(t, 1, len(t)), ctx)
                if r.ok == 0 {
                    return r
                }
                out = concat(out, tpl_escape(r.html))
                i = i + 1
            } else {
                if head == "R" {
                    let r = tpl_expr(substr(t, 1, len(t)), ctx)
                    if r.ok == 0 {
                        return r
                    }
                    out = concat(out, r.html)
                    i = i + 1
                } else {
                    if head == "I" {
                        if tpl_truthy(ctx, substr(t, 1, len(t))) {
                            i = i + 1
                        } else {
                            i = map_get(jump, i) + 1
                        }
                    } else {
                        // "E" reached through the taken branch → jump to
                        // endif; "X" has no jump entry → just skip.
                        if map_has(jump, i) == 1 {
                            i = map_get(jump, i) + 1
                        } else {
                            i = i + 1
                        }
                    }
                }
            }
        }
    }
    return tpl_ok(out)
}
