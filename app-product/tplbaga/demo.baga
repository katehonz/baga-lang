// demo.baga — HTML template CLI (apps-roadmap №7).
// Package imports (language §18.1): sandak.toml → -I parents.
//   cd app-product/tplbaga && sandak build
//   baga -I ../.. -I .. demo.baga <template.tpl> [data.kv]
//
// data.kv: one "key=value" per line (first '=' splits; blank lines and
// '#' comments skipped; key and value trimmed). Without a data file the
// context is empty. Exit 0 on success, 1 on render/read error, 2 usage.
//
// Honest limit (same as mdbaga M2): read_file returns "" for both a
// missing file and an empty one, so a missing template renders empty.

import "tpl.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn demo_load_ctx(path: str) -> Map<str, str> !IO {
    let ctx: Map<str, str> = map_new()
    let raw = read_file(path)?
    let lines = str_split(raw, "\n")
    let mut i: i64 = 0
    while i < vec_len(lines) {
        let line = str_trim(vec_get(lines, i))
        if line != "" && !str_starts_with(line, "#") {
            let eq = str_find(line, "=")
            if eq > 0 {
                let k = str_trim(substr(line, 0, eq))
                let v = str_trim(substr(line, eq + 1, len(line)))
                map_set(ctx, k, v)
            }
        }
        i = i + 1
    }
    return ctx
}

fn main() -> i64 !IO {
    if arg_count() < 1 {
        eprintln("usage: tplbaga <template.tpl> [data.kv]")
        return 2
    }
    let src = read_file(arg(0))?
    let mut ctx: Map<str, str> = map_new()
    if arg_count() >= 2 {
        let loaded = demo_load_ctx(arg(1))?
        ctx = loaded
    }
    let r = tpl_render(src, ctx)
    if r.ok == 0 {
        eprintln(concat("tplbaga: ", r.err))
        return 1
    }
    print(r.html)
    return 0
}
