// webp_vp8.baga — VP8 keyframe decode (RFC 6386, golang.org/x/image/vp8).
// Still images only (no Golden/AltRef).

import "types.baga"
import "webp_vp8_tab.baga"

struct Vp8Br {
    data: bytes,
    r: i64,
    range1: i64,
    bits: i64,
    nbits: i64,
    eof: i64,
    v: i64
}

fn vp8br_init(data: bytes) -> Vp8Br {
    return Vp8Br { data: data, r: 0, range1: 254, bits: 0, nbits: 0, eof: 0, v: 0 }
}

fn vp8br_bit(br: Vp8Br, prob: i64) -> Vp8Br {
    if br.eof == 1 {
        br.v = 0
        return br
    }
    if br.nbits < 8 {
        if br.r >= bytes_len(br.data) {
            br.eof = 1
            br.v = 0
            return br
        }
        br.bits = br.bits | ((bytes_at(br.data, br.r) & 255) << (8 - br.nbits))
        br.r = br.r + 1
        br.nbits = br.nbits + 8
    }
    let split = ((br.range1 * prob) >> 8) + 1
    let mut bit: i64 = 0
    if br.bits >= (split << 8) {
        bit = 1
        br.range1 = br.range1 - split
        br.bits = br.bits - (split << 8)
    } else {
        br.range1 = split - 1
    }
    if br.range1 < 127 {
        let luts = vp8_tab_luts()
        let lutr = vp8_tab_lutr()
        let sh = bytes_at(luts, br.range1) & 255
        br.range1 = bytes_at(lutr, br.range1) & 255
        br.bits = br.bits << sh
        br.nbits = br.nbits - sh
    }
    br.v = bit
    return br
}

fn vp8br_uint(br0: Vp8Br, n: i64) -> Vp8Br {
    let mut br = br0
    let mut u: i64 = 0
    let mut k = n
    while k > 0 {
        k = k - 1
        br = vp8br_bit(br, 128)
        if br.v == 1 {
            u = u | (1 << k)
        }
    }
    br.v = u
    return br
}

fn vp8br_int(br0: Vp8Br, n: i64) -> Vp8Br {
    let mut br = vp8br_uint(br0, n)
    let u = br.v
    br = vp8br_bit(br, 128)
    if br.v == 1 {
        br.v = 0 - u
    } else {
        br.v = u
    }
    return br
}

fn vp8br_optint(br0: Vp8Br, n: i64) -> Vp8Br {
    let br = vp8br_bit(br0, 128)
    if br.v == 0 {
        br.v = 0
        return br
    }
    return vp8br_int(br, n)
}

fn vp8_clip(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}

fn vp8_clip8(x: i64) -> i64 {
    return vp8_clip(x, 0, 255)
}

fn vp8_band(n: i64) -> i64 {
    // RFC 6386 / Go bands[17] = {0,1,2,3,6,4,5,6,6,6,6,6,6,6,6,7,0}
    if n == 0 { return 0 }
    if n == 1 { return 1 }
    if n == 2 { return 2 }
    if n == 3 { return 3 }
    if n == 4 { return 6 }
    if n == 5 { return 4 }
    if n == 6 { return 5 }
    if n == 15 { return 7 }
    if n == 16 { return 0 }
    return 6
}

fn vp8_zig(n: i64) -> i64 {
    if n == 0 { return 0 }
    if n == 1 { return 1 }
    if n == 2 { return 4 }
    if n == 3 { return 8 }
    if n == 4 { return 5 }
    if n == 5 { return 2 }
    if n == 6 { return 3 }
    if n == 7 { return 6 }
    if n == 8 { return 9 }
    if n == 9 { return 12 }
    if n == 10 { return 13 }
    if n == 11 { return 10 }
    if n == 12 { return 7 }
    if n == 13 { return 11 }
    if n == 14 { return 14 }
    return 15
}

fn vp8_cat_prob(cat: i64, i: i64) -> i64 {
    if cat == 0 {
        if i == 0 { return 173 }
        if i == 1 { return 148 }
        if i == 2 { return 140 }
        return 0
    }
    if cat == 1 {
        if i == 0 { return 176 }
        if i == 1 { return 155 }
        if i == 2 { return 140 }
        if i == 3 { return 135 }
        return 0
    }
    if cat == 2 {
        if i == 0 { return 180 }
        if i == 1 { return 157 }
        if i == 2 { return 141 }
        if i == 3 { return 134 }
        if i == 4 { return 130 }
        return 0
    }
    if i == 0 { return 254 }
    if i == 1 { return 254 }
    if i == 2 { return 243 }
    if i == 3 { return 230 }
    if i == 4 { return 196 }
    if i == 5 { return 177 }
    if i == 6 { return 153 }
    if i == 7 { return 140 }
    if i == 8 { return 133 }
    if i == 9 { return 130 }
    if i == 10 { return 129 }
    return 0
}

fn vp8_ybr_get(ybr: bytes, y: i64, x: i64) -> i64 {
    return bytes_at(ybr, y * 32 + x) & 255
}

fn vp8_ybr_set(ybr: bytes, y: i64, x: i64, v: i64) {
    bytes_set(ybr, y * 32 + x, v)
}

fn vp8_pred16(ybr: bytes, mode: i64, mbx: i64, mby: i64) {
    // dest at y=1..16, x=8..23
    // 0=DC 1=TM 2=VE 3=HE 10=DCTop (left only) 11=DCLeft (top only) 12=128
    if mode == 12 {
        let mut y: i64 = 0
        while y < 16 {
            let mut x: i64 = 0
            while x < 16 {
                vp8_ybr_set(ybr, 1 + y, 8 + x, 128)
                x = x + 1
            }
            y = y + 1
        }
        return
    }
    if mode == 0 || mode == 10 || mode == 11 {
        let mut s: i64 = 0
        let mut nt: i64 = 0
        let mut nl: i64 = 0
        if mode != 10 {
            let mut x: i64 = 0
            while x < 16 {
                s = s + vp8_ybr_get(ybr, 0, 8 + x)
                nt = nt + 1
                x = x + 1
            }
        }
        if mode != 11 {
            let mut y: i64 = 0
            while y < 16 {
                s = s + vp8_ybr_get(ybr, 1 + y, 7)
                nl = nl + 1
                y = y + 1
            }
        }
        let mut dc: i64 = 128
        if nt + nl > 0 {
            dc = (s + ((nt + nl) / 2)) / (nt + nl)
        }
        let mut y: i64 = 0
        while y < 16 {
            let mut x: i64 = 0
            while x < 16 {
                vp8_ybr_set(ybr, 1 + y, 8 + x, dc)
                x = x + 1
            }
            y = y + 1
        }
        return
    }
    if mode == 2 {
        let mut y: i64 = 0
        while y < 16 {
            let mut x: i64 = 0
            while x < 16 {
                vp8_ybr_set(ybr, 1 + y, 8 + x, vp8_ybr_get(ybr, 0, 8 + x))
                x = x + 1
            }
            y = y + 1
        }
        return
    }
    if mode == 3 {
        let mut y: i64 = 0
        while y < 16 {
            let L = vp8_ybr_get(ybr, 1 + y, 7)
            let mut x: i64 = 0
            while x < 16 {
                vp8_ybr_set(ybr, 1 + y, 8 + x, L)
                x = x + 1
            }
            y = y + 1
        }
        return
    }
    // TM
    let a = vp8_ybr_get(ybr, 0, 7)
    let mut y: i64 = 0
    while y < 16 {
        let L = vp8_ybr_get(ybr, 1 + y, 7)
        let mut x: i64 = 0
        while x < 16 {
            vp8_ybr_set(ybr, 1 + y, 8 + x, vp8_clip8(L + vp8_ybr_get(ybr, 0, 8 + x) - a))
            x = x + 1
        }
        y = y + 1
    }
}

fn vp8_pred8(ybr: bytes, mode: i64, by: i64, bx: i64, mbx: i64, mby: i64) {
    if mode == 12 {
        let mut y: i64 = 0
        while y < 8 {
            let mut x: i64 = 0
            while x < 8 {
                vp8_ybr_set(ybr, by + y, bx + x, 128)
                x = x + 1
            }
            y = y + 1
        }
        return
    }
    if mode == 0 || mode == 10 || mode == 11 {
        let mut s: i64 = 0
        let mut n: i64 = 0
        if mode != 10 {
            let mut x: i64 = 0
            while x < 8 {
                s = s + vp8_ybr_get(ybr, by - 1, bx + x)
                n = n + 1
                x = x + 1
            }
        }
        if mode != 11 {
            let mut y: i64 = 0
            while y < 8 {
                s = s + vp8_ybr_get(ybr, by + y, bx - 1)
                n = n + 1
                y = y + 1
            }
        }
        let mut dc: i64 = 128
        if n > 0 {
            dc = (s + n / 2) / n
        }
        let mut y: i64 = 0
        while y < 8 {
            let mut x: i64 = 0
            while x < 8 {
                vp8_ybr_set(ybr, by + y, bx + x, dc)
                x = x + 1
            }
            y = y + 1
        }
        return
    }
    if mode == 2 {
        let mut y: i64 = 0
        while y < 8 {
            let mut x: i64 = 0
            while x < 8 {
                vp8_ybr_set(ybr, by + y, bx + x, vp8_ybr_get(ybr, by - 1, bx + x))
                x = x + 1
            }
            y = y + 1
        }
        return
    }
    if mode == 3 {
        let mut y: i64 = 0
        while y < 8 {
            let L = vp8_ybr_get(ybr, by + y, bx - 1)
            let mut x: i64 = 0
            while x < 8 {
                vp8_ybr_set(ybr, by + y, bx + x, L)
                x = x + 1
            }
            y = y + 1
        }
        return
    }
    let a = vp8_ybr_get(ybr, by - 1, bx - 1)
    let mut y: i64 = 0
    while y < 8 {
        let L = vp8_ybr_get(ybr, by + y, bx - 1)
        let mut x: i64 = 0
        while x < 8 {
            vp8_ybr_set(ybr, by + y, bx + x, vp8_clip8(L + vp8_ybr_get(ybr, by - 1, bx + x) - a))
            x = x + 1
        }
        y = y + 1
    }
}

fn vp8_avg2(a: i64, b: i64) -> i64 {
    return (a + b + 1) / 2
}

fn vp8_avg3(a: i64, b: i64, c: i64) -> i64 {
    return (a + 2 * b + c + 2) / 4
}

fn vp8_pred4(ybr: bytes, mode: i64, y: i64, x: i64) {
    // Go predfunc.go: a=TL, b.. = top[0..], then top-right to x+7; p..s = left.
    let a = vp8_ybr_get(ybr, y - 1, x - 1)
    let b = vp8_ybr_get(ybr, y - 1, x)
    let c = vp8_ybr_get(ybr, y - 1, x + 1)
    let d = vp8_ybr_get(ybr, y - 1, x + 2)
    let e = vp8_ybr_get(ybr, y - 1, x + 3)
    let f = vp8_ybr_get(ybr, y - 1, x + 4)
    let g = vp8_ybr_get(ybr, y - 1, x + 5)
    let h = vp8_ybr_get(ybr, y - 1, x + 6)
    let hh = vp8_ybr_get(ybr, y - 1, x + 7)
    let p = vp8_ybr_get(ybr, y, x - 1)
    let q = vp8_ybr_get(ybr, y + 1, x - 1)
    let r = vp8_ybr_get(ybr, y + 2, x - 1)
    let s = vp8_ybr_get(ybr, y + 3, x - 1)
    if mode == 0 {
        let dc = (b + c + d + e + p + q + r + s + 4) / 8
        let mut j: i64 = 0
        while j < 4 {
            let mut i: i64 = 0
            while i < 4 {
                vp8_ybr_set(ybr, y + j, x + i, dc)
                i = i + 1
            }
            j = j + 1
        }
        return
    }
    if mode == 1 {
        let mut j: i64 = 0
        while j < 4 {
            let L = vp8_ybr_get(ybr, y + j, x - 1)
            let mut i: i64 = 0
            while i < 4 {
                vp8_ybr_set(ybr, y + j, x + i, vp8_clip8(L + vp8_ybr_get(ybr, y - 1, x + i) - a))
                i = i + 1
            }
            j = j + 1
        }
        return
    }
    if mode == 2 {
        let c0 = vp8_avg3(a, b, c)
        let c1 = vp8_avg3(b, c, d)
        let c2 = vp8_avg3(c, d, e)
        let c3 = vp8_avg3(d, e, f)
        let mut j: i64 = 0
        while j < 4 {
            vp8_ybr_set(ybr, y + j, x, c0)
            vp8_ybr_set(ybr, y + j, x + 1, c1)
            vp8_ybr_set(ybr, y + j, x + 2, c2)
            vp8_ybr_set(ybr, y + j, x + 3, c3)
            j = j + 1
        }
        return
    }
    if mode == 3 {
        let r0 = vp8_avg3(a, p, q)
        let r1 = vp8_avg3(p, q, r)
        let r2 = vp8_avg3(q, r, s)
        let r3 = vp8_avg3(r, s, s)
        let mut i: i64 = 0
        while i < 4 {
            vp8_ybr_set(ybr, y, x + i, r0)
            vp8_ybr_set(ybr, y + 1, x + i, r1)
            vp8_ybr_set(ybr, y + 2, x + i, r2)
            vp8_ybr_set(ybr, y + 3, x + i, r3)
            i = i + 1
        }
        return
    }
    if mode == 4 {
        let pab = vp8_avg3(p, a, b)
        let abc = vp8_avg3(a, b, c)
        let bcd = vp8_avg3(b, c, d)
        let cde = vp8_avg3(c, d, e)
        let qpa = vp8_avg3(q, p, a)
        let rqp = vp8_avg3(r, q, p)
        let srq = vp8_avg3(s, r, q)
        vp8_ybr_set(ybr, y, x, pab)
        vp8_ybr_set(ybr, y, x + 1, abc)
        vp8_ybr_set(ybr, y, x + 2, bcd)
        vp8_ybr_set(ybr, y, x + 3, cde)
        vp8_ybr_set(ybr, y + 1, x, qpa)
        vp8_ybr_set(ybr, y + 1, x + 1, pab)
        vp8_ybr_set(ybr, y + 1, x + 2, abc)
        vp8_ybr_set(ybr, y + 1, x + 3, bcd)
        vp8_ybr_set(ybr, y + 2, x, rqp)
        vp8_ybr_set(ybr, y + 2, x + 1, qpa)
        vp8_ybr_set(ybr, y + 2, x + 2, pab)
        vp8_ybr_set(ybr, y + 2, x + 3, abc)
        vp8_ybr_set(ybr, y + 3, x, srq)
        vp8_ybr_set(ybr, y + 3, x + 1, rqp)
        vp8_ybr_set(ybr, y + 3, x + 2, qpa)
        vp8_ybr_set(ybr, y + 3, x + 3, pab)
        return
    }
    if mode == 5 {
        vp8_ybr_set(ybr, y, x, vp8_avg2(a, b))
        vp8_ybr_set(ybr, y, x + 1, vp8_avg2(b, c))
        vp8_ybr_set(ybr, y, x + 2, vp8_avg2(c, d))
        vp8_ybr_set(ybr, y, x + 3, vp8_avg2(d, e))
        vp8_ybr_set(ybr, y + 1, x, vp8_avg3(p, a, b))
        vp8_ybr_set(ybr, y + 1, x + 1, vp8_avg3(a, b, c))
        vp8_ybr_set(ybr, y + 1, x + 2, vp8_avg3(b, c, d))
        vp8_ybr_set(ybr, y + 1, x + 3, vp8_avg3(c, d, e))
        vp8_ybr_set(ybr, y + 2, x, vp8_avg3(q, p, a))
        vp8_ybr_set(ybr, y + 2, x + 1, vp8_avg2(a, b))
        vp8_ybr_set(ybr, y + 2, x + 2, vp8_avg2(b, c))
        vp8_ybr_set(ybr, y + 2, x + 3, vp8_avg2(c, d))
        vp8_ybr_set(ybr, y + 3, x, vp8_avg3(r, q, p))
        vp8_ybr_set(ybr, y + 3, x + 1, vp8_avg3(p, a, b))
        vp8_ybr_set(ybr, y + 3, x + 2, vp8_avg3(a, b, c))
        vp8_ybr_set(ybr, y + 3, x + 3, vp8_avg3(b, c, d))
        return
    }
    if mode == 6 {
        vp8_ybr_set(ybr, y, x, vp8_avg3(b, c, d))
        vp8_ybr_set(ybr, y, x + 1, vp8_avg3(c, d, e))
        vp8_ybr_set(ybr, y, x + 2, vp8_avg3(d, e, f))
        vp8_ybr_set(ybr, y, x + 3, vp8_avg3(e, f, g))
        vp8_ybr_set(ybr, y + 1, x, vp8_avg3(c, d, e))
        vp8_ybr_set(ybr, y + 1, x + 1, vp8_avg3(d, e, f))
        vp8_ybr_set(ybr, y + 1, x + 2, vp8_avg3(e, f, g))
        vp8_ybr_set(ybr, y + 1, x + 3, vp8_avg3(f, g, h))
        vp8_ybr_set(ybr, y + 2, x, vp8_avg3(d, e, f))
        vp8_ybr_set(ybr, y + 2, x + 1, vp8_avg3(e, f, g))
        vp8_ybr_set(ybr, y + 2, x + 2, vp8_avg3(f, g, h))
        vp8_ybr_set(ybr, y + 2, x + 3, vp8_avg3(g, h, hh))
        vp8_ybr_set(ybr, y + 3, x, vp8_avg3(e, f, g))
        vp8_ybr_set(ybr, y + 3, x + 1, vp8_avg3(f, g, h))
        vp8_ybr_set(ybr, y + 3, x + 2, vp8_avg3(g, h, hh))
        vp8_ybr_set(ybr, y + 3, x + 3, vp8_avg3(h, hh, hh))
        return
    }
    if mode == 7 {
        vp8_ybr_set(ybr, y, x, vp8_avg2(b, c))
        vp8_ybr_set(ybr, y, x + 1, vp8_avg2(c, d))
        vp8_ybr_set(ybr, y, x + 2, vp8_avg2(d, e))
        vp8_ybr_set(ybr, y, x + 3, vp8_avg2(e, f))
        vp8_ybr_set(ybr, y + 1, x, vp8_avg3(b, c, d))
        vp8_ybr_set(ybr, y + 1, x + 1, vp8_avg3(c, d, e))
        vp8_ybr_set(ybr, y + 1, x + 2, vp8_avg3(d, e, f))
        vp8_ybr_set(ybr, y + 1, x + 3, vp8_avg3(e, f, g))
        vp8_ybr_set(ybr, y + 2, x, vp8_avg2(c, d))
        vp8_ybr_set(ybr, y + 2, x + 1, vp8_avg2(d, e))
        vp8_ybr_set(ybr, y + 2, x + 2, vp8_avg2(e, f))
        vp8_ybr_set(ybr, y + 2, x + 3, vp8_avg3(f, g, h))
        vp8_ybr_set(ybr, y + 3, x, vp8_avg3(c, d, e))
        vp8_ybr_set(ybr, y + 3, x + 1, vp8_avg3(d, e, f))
        vp8_ybr_set(ybr, y + 3, x + 2, vp8_avg3(e, f, g))
        vp8_ybr_set(ybr, y + 3, x + 3, vp8_avg3(f, g, h))
        return
    }
    if mode == 8 {
        vp8_ybr_set(ybr, y, x, vp8_avg2(p, a))
        vp8_ybr_set(ybr, y, x + 1, vp8_avg3(p, a, b))
        vp8_ybr_set(ybr, y, x + 2, vp8_avg3(a, b, c))
        vp8_ybr_set(ybr, y, x + 3, vp8_avg3(b, c, d))
        vp8_ybr_set(ybr, y + 1, x, vp8_avg2(q, p))
        vp8_ybr_set(ybr, y + 1, x + 1, vp8_avg3(q, p, a))
        vp8_ybr_set(ybr, y + 1, x + 2, vp8_avg2(p, a))
        vp8_ybr_set(ybr, y + 1, x + 3, vp8_avg3(p, a, b))
        vp8_ybr_set(ybr, y + 2, x, vp8_avg2(r, q))
        vp8_ybr_set(ybr, y + 2, x + 1, vp8_avg3(r, q, p))
        vp8_ybr_set(ybr, y + 2, x + 2, vp8_avg2(q, p))
        vp8_ybr_set(ybr, y + 2, x + 3, vp8_avg3(q, p, a))
        vp8_ybr_set(ybr, y + 3, x, vp8_avg2(s, r))
        vp8_ybr_set(ybr, y + 3, x + 1, vp8_avg3(s, r, q))
        vp8_ybr_set(ybr, y + 3, x + 2, vp8_avg2(r, q))
        vp8_ybr_set(ybr, y + 3, x + 3, vp8_avg3(r, q, p))
        return
    }
    // HU
    vp8_ybr_set(ybr, y, x, vp8_avg2(p, q))
    vp8_ybr_set(ybr, y, x + 1, vp8_avg3(p, q, r))
    vp8_ybr_set(ybr, y, x + 2, vp8_avg2(q, r))
    vp8_ybr_set(ybr, y, x + 3, vp8_avg3(q, r, s))
    vp8_ybr_set(ybr, y + 1, x, vp8_avg2(q, r))
    vp8_ybr_set(ybr, y + 1, x + 1, vp8_avg3(q, r, s))
    vp8_ybr_set(ybr, y + 1, x + 2, vp8_avg2(r, s))
    vp8_ybr_set(ybr, y + 1, x + 3, vp8_avg3(r, s, s))
    vp8_ybr_set(ybr, y + 2, x, vp8_avg2(r, s))
    vp8_ybr_set(ybr, y + 2, x + 1, vp8_avg3(r, s, s))
    vp8_ybr_set(ybr, y + 2, x + 2, s)
    vp8_ybr_set(ybr, y + 2, x + 3, s)
    vp8_ybr_set(ybr, y + 3, x, s)
    vp8_ybr_set(ybr, y + 3, x + 1, s)
    vp8_ybr_set(ybr, y + 3, x + 2, s)
    vp8_ybr_set(ybr, y + 3, x + 3, s)
}

fn vp8_idct4(ybr: bytes, coeff: Vec<i64>, y: i64, x: i64, base: i64) {
    let c1 = 85627
    let c2 = 35468
    let m = vec_new()
    let mut t: i64 = 0
    while t < 16 {
        vec_push(m, 0)
        t = t + 1
    }
    let mut i: i64 = 0
    while i < 4 {
        let a = vec_get(coeff, base + i) + vec_get(coeff, base + 8 + i)
        let b = vec_get(coeff, base + i) - vec_get(coeff, base + 8 + i)
        let c = ((vec_get(coeff, base + 4 + i) * c2) >> 16) - ((vec_get(coeff, base + 12 + i) * c1) >> 16)
        let d = ((vec_get(coeff, base + 4 + i) * c1) >> 16) + ((vec_get(coeff, base + 12 + i) * c2) >> 16)
        vec_set(m, i * 4 + 0, a + d)
        vec_set(m, i * 4 + 1, b + c)
        vec_set(m, i * 4 + 2, b - c)
        vec_set(m, i * 4 + 3, a - d)
        i = i + 1
    }
    let mut j: i64 = 0
    while j < 4 {
        let dc = vec_get(m, j) + 4
        let a = dc + vec_get(m, 8 + j)
        let b = dc - vec_get(m, 8 + j)
        let c = ((vec_get(m, 4 + j) * c2) >> 16) - ((vec_get(m, 12 + j) * c1) >> 16)
        let d = ((vec_get(m, 4 + j) * c1) >> 16) + ((vec_get(m, 12 + j) * c2) >> 16)
        vp8_ybr_set(ybr, y + j, x, vp8_clip8(vp8_ybr_get(ybr, y + j, x) + ((a + d) >> 3)))
        vp8_ybr_set(ybr, y + j, x + 1, vp8_clip8(vp8_ybr_get(ybr, y + j, x + 1) + ((b + c) >> 3)))
        vp8_ybr_set(ybr, y + j, x + 2, vp8_clip8(vp8_ybr_get(ybr, y + j, x + 2) + ((b - c) >> 3)))
        vp8_ybr_set(ybr, y + j, x + 3, vp8_clip8(vp8_ybr_get(ybr, y + j, x + 3) + ((a - d) >> 3)))
        j = j + 1
    }
}

fn vp8_abs(x: i64) -> i64 {
    if x < 0 {
        return 0 - x
    }
    return x
}

fn vp8_clamp15(x: i64) -> i64 {
    if x < 0 - 16 {
        return 0 - 16
    }
    if x > 15 {
        return 15
    }
    return x
}

fn vp8_clamp127(x: i64) -> i64 {
    if x < 0 - 128 {
        return 0 - 128
    }
    if x > 127 {
        return 127
    }
    return x
}

fn vp8_filter2(pix: bytes, level: i64, index0: i64, i_step: i64, j_step: i64, n0: i64) {
    let mut n = n0
    let mut index = index0
    while n > 0 {
        let p1 = bytes_at(pix, index - 2 * j_step) & 255
        let p0 = bytes_at(pix, index - 1 * j_step) & 255
        let q0 = bytes_at(pix, index) & 255
        let q1 = bytes_at(pix, index + j_step) & 255
        if (vp8_abs(p0 - q0) << 1) + (vp8_abs(p1 - q1) >> 1) > level {
            n = n - 1
            index = index + i_step
            continue
        }
        let a = 3 * (q0 - p0) + vp8_clamp127(p1 - q1)
        let a1 = vp8_clamp15((a + 4) >> 3)
        let a2 = vp8_clamp15((a + 3) >> 3)
        bytes_set(pix, index - j_step, vp8_clip8(p0 + a2))
        bytes_set(pix, index, vp8_clip8(q0 - a1))
        n = n - 1
        index = index + i_step
    }
}

fn vp8_filter246(pix: bytes, n0: i64, level: i64, ilevel: i64, hlevel: i64, index0: i64, i_step: i64, j_step: i64, four: i64) {
    let mut n = n0
    let mut index = index0
    while n > 0 {
        let p3 = bytes_at(pix, index - 4 * j_step) & 255
        let p2 = bytes_at(pix, index - 3 * j_step) & 255
        let p1 = bytes_at(pix, index - 2 * j_step) & 255
        let p0 = bytes_at(pix, index - 1 * j_step) & 255
        let q0 = bytes_at(pix, index) & 255
        let q1 = bytes_at(pix, index + j_step) & 255
        let q2 = bytes_at(pix, index + 2 * j_step) & 255
        let q3 = bytes_at(pix, index + 3 * j_step) & 255
        if (vp8_abs(p0 - q0) << 1) + (vp8_abs(p1 - q1) >> 1) > level {
            n = n - 1
            index = index + i_step
            continue
        }
        if vp8_abs(p3 - p2) > ilevel || vp8_abs(p2 - p1) > ilevel || vp8_abs(p1 - p0) > ilevel || vp8_abs(q1 - q0) > ilevel || vp8_abs(q2 - q1) > ilevel || vp8_abs(q3 - q2) > ilevel {
            n = n - 1
            index = index + i_step
            continue
        }
        if vp8_abs(p1 - p0) > hlevel || vp8_abs(q1 - q0) > hlevel {
            let a = 3 * (q0 - p0) + vp8_clamp127(p1 - q1)
            let a1 = vp8_clamp15((a + 4) >> 3)
            let a2 = vp8_clamp15((a + 3) >> 3)
            bytes_set(pix, index - j_step, vp8_clip8(p0 + a2))
            bytes_set(pix, index, vp8_clip8(q0 - a1))
        } else {
            if four == 1 {
                let a = 3 * (q0 - p0)
                let a1 = vp8_clamp15((a + 4) >> 3)
                let a2 = vp8_clamp15((a + 3) >> 3)
                let a3 = (a1 + 1) >> 1
                bytes_set(pix, index - 2 * j_step, vp8_clip8(p1 + a3))
                bytes_set(pix, index - j_step, vp8_clip8(p0 + a2))
                bytes_set(pix, index, vp8_clip8(q0 - a1))
                bytes_set(pix, index + j_step, vp8_clip8(q1 - a3))
            } else {
                let a = vp8_clamp127(3 * (q0 - p0) + vp8_clamp127(p1 - q1))
                let a1 = (27 * a + 63) >> 7
                let a2 = (18 * a + 63) >> 7
                let a3 = (9 * a + 63) >> 7
                bytes_set(pix, index - 3 * j_step, vp8_clip8(p2 + a3))
                bytes_set(pix, index - 2 * j_step, vp8_clip8(p1 + a2))
                bytes_set(pix, index - j_step, vp8_clip8(p0 + a1))
                bytes_set(pix, index, vp8_clip8(q0 - a1))
                bytes_set(pix, index + j_step, vp8_clip8(q1 - a2))
                bytes_set(pix, index + 2 * j_step, vp8_clip8(q2 - a3))
            }
        }
        n = n - 1
        index = index + i_step
    }
}

fn vp8_idct4dc(ybr: bytes, coeff: Vec<i64>, y: i64, x: i64, base: i64) {
    let dc = (vec_get(coeff, base) + 4) >> 3
    let mut j: i64 = 0
    while j < 4 {
        let mut i: i64 = 0
        while i < 4 {
            vp8_ybr_set(ybr, y + j, x + i, vp8_clip8(vp8_ybr_get(ybr, y + j, x + i) + dc))
            i = i + 1
        }
        j = j + 1
    }
}
