// jpeg_enc.baga — baseline SOF0 encode, 4:2:0, Annex K Huffman (image-rs jpeg).
// Integer separable FDCT (scaled cosines). Default quality 85.

import "types.baga"

fn je_zeros(n: i64) -> Vec<i64> {
    let v = vec_new()
    let mut i: i64 = 0
    while i < n {
        vec_push(v, 0)
        i = i + 1
    }
    return v
}

