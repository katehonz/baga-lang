fn vp8l_dist_code(code: i64, w: i64, map: Vec<i64>) -> i64 {
    if code > 120 {
        return code - 120
    }
    if code < 1 {
        return 1
    }
    let p = vec_get(map, code - 1)
    let xi = p / 32 - 16
    let yi = p % 32 - 16
    let dist = xi + yi * w
    if dist < 1 {
        return 1
    }
    return dist
}

fn vp8l_pack(a: i64, r: i64, g: i64, b: i64) -> i64 {
    return ((a & 255) << 24) | ((r & 255) << 16) | ((g & 255) << 8) | (b & 255)
}

fn vp8l_hash(argb: i64, bits: i64) -> i64 {
    let p = (argb * 506832829) & 4294967295
    return p >> (32 - bits)
}

fn vp8l_put(px: bytes, i: i64, argb: i64) {
    bytes_set(px, i * 4, (argb >> 16) & 255)
    bytes_set(px, i * 4 + 1, (argb >> 8) & 255)
    bytes_set(px, i * 4 + 2, argb & 255)
    bytes_set(px, i * 4 + 3, (argb >> 24) & 255)
}

fn vp8l_get(px: bytes, i: i64) -> i64 {
    let r = bytes_at(px, i * 4) & 255
    let g = bytes_at(px, i * 4 + 1) & 255
    let b = bytes_at(px, i * 4 + 2) & 255
    let a = bytes_at(px, i * 4 + 3) & 255
    return vp8l_pack(a, r, g, b)
}

struct Vp8Pix {
    br: Vp8b,
    px: bytes,
    ok: i64,
    err: str
}

fn vp8l_image(br0: Vp8b, w: i64, h: i64, with_meta: i64) -> Vp8Pix {
    if br0.ok == 0 {
        return Vp8Pix { br: br0, px: bytes_new(0), ok: 0, err: br0.err }
    }
    let mut br = vp8b_bits(br0, 1)
    if br.ok == 0 {
        return Vp8Pix { br: br, px: bytes_new(0), ok: 0, err: br.err }
    }
    let mut cache_bits: i64 = 0
    if br.v == 1 {
        br = vp8b_bits(br, 4)
        cache_bits = br.v
        if cache_bits < 1 || cache_bits > 11 {
            return Vp8Pix { br: br, px: bytes_new(0), ok: 0, err: "webp: bad color cache" }
        }
    }
    let cache_size = 0
    if cache_bits > 0 {
        // set below
    }
    let mut cs = 0
    if cache_bits > 0 {
        cs = 1 << cache_bits
    }
    let mut ngrp: i64 = 1
    let mut ebits: i64 = 0
    let mut ew: i64 = 1
    let mut eh: i64 = 1
    let mut epx = bytes_new(0)
    if with_meta == 1 {
        br = vp8b_bits(br, 1)
        if br.ok == 0 {
            return Vp8Pix { br: br, px: bytes_new(0), ok: 0, err: br.err }
        }
        if br.v == 1 {
            br = vp8b_bits(br, 3)
            ebits = br.v + 2
            ew = (w + (1 << ebits) - 1) / (1 << ebits)
            eh = (h + (1 << ebits) - 1) / (1 << ebits)
            let sub = vp8l_image(br, ew, eh, 0)
            if sub.ok == 0 {
                return sub
            }
            br = sub.br
            epx = sub.px
            let mut mx: i64 = 0
            let mut p: i64 = 0
            while p < ew * eh {
                let meta = ((bytes_at(epx, p * 4) & 255) << 8) | (bytes_at(epx, p * 4 + 1) & 255)
                if meta > mx {
                    mx = meta
                }
                p = p + 1
            }
            ngrp = mx + 1
        }
    }
    let ag = 256 + 24 + cs
    let hg = vec_new()
    let hr = vec_new()
    let hb = vec_new()
    let ha = vec_new()
    let hd = vec_new()
    let mut g: i64 = 0
    while g < ngrp {
        let rg = vp8l_huffman(br, ag)
        br = rg.br
        vec_push(hg, rg.h)
        let rr = vp8l_huffman(br, 256)
        br = rr.br
        vec_push(hr, rr.h)
        let rb = vp8l_huffman(br, 256)
        br = rb.br
        vec_push(hb, rb.h)
        let ra = vp8l_huffman(br, 256)
        br = ra.br
        vec_push(ha, ra.h)
        let rd = vp8l_huffman(br, 40)
        br = rd.br
        vec_push(hd, rd.h)
        if br.ok == 0 {
            return Vp8Pix { br: br, px: bytes_new(0), ok: 0, err: br.err }
        }
        g = g + 1
    }
    let cache = vp8_zeros(cs)
    if cs == 0 {
        vec_push(cache, 0)
    }
    let dmap = vp8l_distmap()
    let np = w * h
    let px = bytes_new(np * 4)
    let mut i: i64 = 0
    while i < np {
        let mut gi: i64 = 0
        if ngrp > 1 {
            let x = i % w
            let y = i / w
            let pos = (y >> ebits) * ew + (x >> ebits)
            gi = ((bytes_at(epx, pos * 4) & 255) << 8) | (bytes_at(epx, pos * 4 + 1) & 255)
            if gi < 0 || gi >= ngrp {
                return Vp8Pix { br: br, px: bytes_new(0), ok: 0, err: "webp: meta prefix" }
            }
        }
        br = huff_dec(br, vec_get(hg, gi))
        if br.ok == 0 {
            return Vp8Pix { br: br, px: bytes_new(0), ok: 0, err: br.err }
        }
        let s = br.v
        if s < 256 {
            br = huff_dec(br, vec_get(hr, gi))
            let rv = br.v
            br = huff_dec(br, vec_get(hb, gi))
            let bv = br.v
            br = huff_dec(br, vec_get(ha, gi))
            let av = br.v
            if br.ok == 0 {
                return Vp8Pix { br: br, px: bytes_new(0), ok: 0, err: br.err }
            }
            let argb = vp8l_pack(av, rv, s, bv)
            vp8l_put(px, i, argb)
            if cache_bits > 0 {
                vec_set(cache, vp8l_hash(argb, cache_bits), argb)
            }
            i = i + 1
        } else {
            if s < 280 {
                br = vp8l_prefix(br, s - 256)
                let length = br.v
                br = huff_dec(br, vec_get(hd, gi))
                if br.ok == 0 {
                    return Vp8Pix { br: br, px: bytes_new(0), ok: 0, err: br.err }
                }
                br = vp8l_prefix(br, br.v)
                let dist = vp8l_dist_code(br.v, w, dmap)
                if length < 1 || i + length > np {
                    return Vp8Pix { br: br, px: bytes_new(0), ok: 0, err: "webp: bad LZ77" }
                }
                let mut k: i64 = 0
                while k < length {
                    let src = i - dist
                    if src < 0 {
                        return Vp8Pix { br: br, px: bytes_new(0), ok: 0, err: "webp: LZ77 dist" }
                    }
                    let argb = vp8l_get(px, src)
                    vp8l_put(px, i, argb)
                    if cache_bits > 0 {
                        vec_set(cache, vp8l_hash(argb, cache_bits), argb)
                    }
                    i = i + 1
                    k = k + 1
                }
            } else {
                let idx = s - 280
                if idx < 0 || idx >= cs {
                    return Vp8Pix { br: br, px: bytes_new(0), ok: 0, err: "webp: cache idx" }
                }
                let argb = vec_get(cache, idx)
                vp8l_put(px, i, argb)
                if cache_bits > 0 {
                    vec_set(cache, vp8l_hash(argb, cache_bits), argb)
                }
                i = i + 1
            }
        }
    }
    return Vp8Pix { br: br, px: px, ok: 1, err: "" }
}

fn vp8l_i8(u: i64) -> i64 {
    let v = u & 255
    if v >= 128 {
        return v - 256
    }
    return v
}

fn vp8l_ctd(t: i64, c: i64) -> i64 {
    return (vp8l_i8(t) * vp8l_i8(c)) >> 5
}

fn vp8l_avg2(a: i64, b: i64) -> i64 {
    return ((a & 255) + (b & 255)) / 2
}

fn vp8l_clamp(a: i64) -> i64 {
    if a < 0 { return 0 }
    if a > 255 { return 255 }
    return a
}

fn vp8l_pred_px(px: bytes, w: i64, h: i64, x: i64, y: i64) -> i64 {
    if x < 0 || y < 0 || x >= w || y >= h {
        return vp8l_pack(255, 0, 0, 0)
    }
    return vp8l_get(px, y * w + x)
}

fn vp8l_predict(mode: i64, L: i64, T: i64, TL: i64, TR: i64) -> i64 {
    if mode == 0 { return vp8l_pack(255, 0, 0, 0) }
    if mode == 1 { return L }
    if mode == 2 { return T }
    if mode == 3 { return TR }
    if mode == 4 { return TL }
    let la = (L >> 24) & 255
    let lr = (L >> 16) & 255
    let lg = (L >> 8) & 255
    let lb = L & 255
    let ta = (T >> 24) & 255
    let tr = (T >> 16) & 255
    let tg = (T >> 8) & 255
    let tb = T & 255
    let tla = (TL >> 24) & 255
    let tlr = (TL >> 16) & 255
    let tlg = (TL >> 8) & 255
    let tlb = TL & 255
    let tra = (TR >> 24) & 255
    let trr = (TR >> 16) & 255
    let trg = (TR >> 8) & 255
    let trb = TR & 255
    if mode == 5 {
        return vp8l_pack(
            vp8l_avg2(vp8l_avg2(la, tra), ta),
            vp8l_avg2(vp8l_avg2(lr, trr), tr),
            vp8l_avg2(vp8l_avg2(lg, trg), tg),
            vp8l_avg2(vp8l_avg2(lb, trb), tb))
    }
    if mode == 6 {
        return vp8l_pack(vp8l_avg2(la, tla), vp8l_avg2(lr, tlr), vp8l_avg2(lg, tlg), vp8l_avg2(lb, tlb))
    }
    if mode == 7 {
        return vp8l_pack(vp8l_avg2(la, ta), vp8l_avg2(lr, tr), vp8l_avg2(lg, tg), vp8l_avg2(lb, tb))
    }
    if mode == 8 {
        return vp8l_pack(vp8l_avg2(tla, ta), vp8l_avg2(tlr, tr), vp8l_avg2(tlg, tg), vp8l_avg2(tlb, tb))
    }
    if mode == 9 {
        return vp8l_pack(vp8l_avg2(ta, tra), vp8l_avg2(tr, trr), vp8l_avg2(tg, trg), vp8l_avg2(tb, trb))
    }
    if mode == 10 {
        return vp8l_pack(
            vp8l_avg2(vp8l_avg2(la, tla), vp8l_avg2(ta, tra)),
            vp8l_avg2(vp8l_avg2(lr, tlr), vp8l_avg2(tr, trr)),
            vp8l_avg2(vp8l_avg2(lg, tlg), vp8l_avg2(tg, trg)),
            vp8l_avg2(vp8l_avg2(lb, tlb), vp8l_avg2(tb, trb)))
    }
    if mode == 11 {
        let pa = la + ta - tla
        let pr = lr + tr - tlr
        let pg = lg + tg - tlg
        let pb = lb + tb - tlb
        let pL = vp8l_abs(pa - la) + vp8l_abs(pr - lr) + vp8l_abs(pg - lg) + vp8l_abs(pb - lb)
        let pT = vp8l_abs(pa - ta) + vp8l_abs(pr - tr) + vp8l_abs(pg - tg) + vp8l_abs(pb - tb)
        if pL < pT { return L }
        return T
    }
    if mode == 12 {
        return vp8l_pack(
            vp8l_clamp(la + ta - tla),
            vp8l_clamp(lr + tr - tlr),
            vp8l_clamp(lg + tg - tlg),
            vp8l_clamp(lb + tb - tlb))
    }
    if mode == 13 {
        let aa = vp8l_avg2(la, ta)
        let ar = vp8l_avg2(lr, tr)
        let ag = vp8l_avg2(lg, tg)
        let ab = vp8l_avg2(lb, tb)
        return vp8l_pack(
            vp8l_clamp(aa + (aa - tla) / 2),
            vp8l_clamp(ar + (ar - tlr) / 2),
            vp8l_clamp(ag + (ag - tlg) / 2),
            vp8l_clamp(ab + (ab - tlb) / 2))
    }
    return T
}

fn vp8l_abs(x: i64) -> i64 {
    if x < 0 { return 0 - x }
    return x
}

fn vp8l_add_pred(res: i64, pred: i64) -> i64 {
    let a = ((res >> 24) + (pred >> 24)) & 255
    let r = ((res >> 16) + (pred >> 16)) & 255
    let g = ((res >> 8) + (pred >> 8)) & 255
    let b = (res + pred) & 255
    return vp8l_pack(a, r, g, b)
}

fn vp8l_inv_predictor(px: bytes, w: i64, h: i64, bits: i64, modes: bytes) {
    let tw = (w + (1 << bits) - 1) / (1 << bits)
    let mut y: i64 = 0
    while y < h {
        let mut x: i64 = 0
        while x < w {
            let i = y * w + x
            let res = vp8l_get(px, i)
            let mut pred = vp8l_pack(255, 0, 0, 0)
            if x == 0 && y == 0 {
                pred = vp8l_pack(255, 0, 0, 0)
            } else {
                if y == 0 {
                    pred = vp8l_pred_px(px, w, h, x - 1, y)
                } else {
                    if x == 0 {
                        pred = vp8l_pred_px(px, w, h, x, y - 1)
                    } else {
                        let bi = (y >> bits) * tw + (x >> bits)
                        let mode = bytes_at(modes, bi * 4 + 1) & 255
                        let L = vp8l_pred_px(px, w, h, x - 1, y)
                        let T = vp8l_pred_px(px, w, h, x, y - 1)
                        let TL = vp8l_pred_px(px, w, h, x - 1, y - 1)
                        let mut trx = x + 1
                        let mut try_ = y - 1
                        if x == w - 1 {
                            trx = 0
                            try_ = y
                        }
                        let TR = vp8l_pred_px(px, w, h, trx, try_)
                        pred = vp8l_predict(mode, L, T, TL, TR)
                    }
                }
            }
            vp8l_put(px, i, vp8l_add_pred(res, pred))
            x = x + 1
        }
        y = y + 1
    }
}

fn vp8l_inv_color(px: bytes, w: i64, h: i64, bits: i64, cte: bytes) {
    let tw = (w + (1 << bits) - 1) / (1 << bits)
    let mut y: i64 = 0
    while y < h {
        let mut x: i64 = 0
        while x < w {
            let i = y * w + x
            let p = vp8l_get(px, i)
            let bi = (y >> bits) * tw + (x >> bits)
            // cte pixel: R=red_to_blue, G=green_to_blue, B=green_to_red
            let rtb = bytes_at(cte, bi * 4) & 255
            let gtb = bytes_at(cte, bi * 4 + 1) & 255
            let gtr = bytes_at(cte, bi * 4 + 2) & 255
            let a = (p >> 24) & 255
            let r0 = (p >> 16) & 255
            let g = (p >> 8) & 255
            let b0 = p & 255
            let nr = (r0 + vp8l_ctd(gtr, g)) & 255
            let nb = (b0 + vp8l_ctd(gtb, g) + vp8l_ctd(rtb, nr)) & 255
            vp8l_put(px, i, vp8l_pack(a, nr, g, nb))
            x = x + 1
        }
        y = y + 1
    }
}

fn vp8l_inv_subgreen(px: bytes, n: i64) {
    let mut i: i64 = 0
    while i < n {
        let g = bytes_at(px, i * 4 + 1) & 255
        bytes_set(px, i * 4, (bytes_at(px, i * 4) + g) & 255)
        bytes_set(px, i * 4 + 2, (bytes_at(px, i * 4 + 2) + g) & 255)
        i = i + 1
    }
}

fn vp8l_inv_index(px: bytes, rw: i64, h: i64, full_w: i64, wb: i64, pal: bytes, psz: i64) -> bytes {
    let out = bytes_new(full_w * h * 4)
    let mut y: i64 = 0
    while y < h {
        let mut x: i64 = 0
        while x < full_w {
            let mut idx: i64 = 0
            if wb == 0 {
                if x < rw {
                    idx = bytes_at(px, (y * rw + x) * 4 + 1) & 255
                }
            } else {
                let packed = bytes_at(px, (y * rw + (x >> wb)) * 4 + 1) & 255
                let bpp = 8 >> wb
                let slot = x & ((1 << wb) - 1)
                idx = (packed >> (slot * bpp)) & ((1 << bpp) - 1)
            }
            if idx < psz {
                let o = (y * full_w + x) * 4
                bytes_set(out, o, bytes_at(pal, idx * 4))
                bytes_set(out, o + 1, bytes_at(pal, idx * 4 + 1))
                bytes_set(out, o + 2, bytes_at(pal, idx * 4 + 2))
                bytes_set(out, o + 3, bytes_at(pal, idx * 4 + 3))
            }
            x = x + 1
        }
        y = y + 1
    }
    return out
}

fn vp8l_delta_pal(pal: bytes, n: i64) {
    let mut i: i64 = 1
    while i < n {
        let o = i * 4
        let p = o - 4
        bytes_set(pal, o, (bytes_at(pal, o) + bytes_at(pal, p)) & 255)
        bytes_set(pal, o + 1, (bytes_at(pal, o + 1) + bytes_at(pal, p + 1)) & 255)
        bytes_set(pal, o + 2, (bytes_at(pal, o + 2) + bytes_at(pal, p + 2)) & 255)
        bytes_set(pal, o + 3, (bytes_at(pal, o + 3) + bytes_at(pal, p + 3)) & 255)
        i = i + 1
    }
}

fn vp8l_decode(src: bytes, expect_w: i64, expect_h: i64) -> Image {
    if bytes_len(src) < 5 || (bytes_at(src, 0) & 255) != 47 {
        return img_fail("webp: bad VP8L sig")
    }
    let mut br = vp8b_new(src)
    br = vp8b_bits(br, 8)
    br = vp8b_bits(br, 14)
    let w = br.v + 1
    br = vp8b_bits(br, 14)
    let h = br.v + 1
    br = vp8b_bits(br, 1)
    br = vp8b_bits(br, 3)
    if br.ok == 0 {
        return img_fail(br.err)
    }
    if w != expect_w || h != expect_h || w > 4096 || h > 4096 {
        return img_fail("webp: size mismatch")
    }
    let ttype = vec_new()
    let tbits = vec_new()
    let timg = vec_new()
    let twid = vec_new()
    let tpaln = vec_new()
    let mut cur_w = w
    let orig_w = w
    br = vp8b_bits(br, 1)
    while br.ok != 0 && br.v == 1 {
        br = vp8b_bits(br, 2)
        let ty = br.v
        vec_push(ttype, ty)
        vec_push(tbits, 0)
        vec_push(twid, 0)
        vec_push(tpaln, 0)
        vec_push(timg, bytes_new(0))
        let ti = vec_len(ttype) - 1
        if ty == 2 {
            // subtract-green: no data
        } else {
            if ty == 3 {
                br = vp8b_bits(br, 8)
                let psz = br.v + 1
                let sub = vp8l_image(br, psz, 1, 0)
                if sub.ok == 0 {
                    return img_fail(sub.err)
                }
                br = sub.br
                vp8l_delta_pal(sub.px, psz)
                vec_set(timg, ti, sub.px)
                vec_set(tpaln, ti, psz)
                let mut wb: i64 = 0
                if psz <= 2 { wb = 3 }
                if psz > 2 && psz <= 4 { wb = 2 }
                if psz > 4 && psz <= 16 { wb = 1 }
                vec_set(twid, ti, wb)
                cur_w = (orig_w + (1 << wb) - 1) / (1 << wb)
                // subsequent transforms use reduced width; orig_w stays for later index inverse
                // but if indexing is not last, more transforms see cur_w
            } else {
                br = vp8b_bits(br, 3)
                let sb = br.v + 2
                vec_set(tbits, ti, sb)
                let tw = (cur_w + (1 << sb) - 1) / (1 << sb)
                let th = (h + (1 << sb) - 1) / (1 << sb)
                let sub = vp8l_image(br, tw, th, 0)
                if sub.ok == 0 {
                    return img_fail(sub.err)
                }
                br = sub.br
                vec_set(timg, ti, sub.px)
            }
        }
        br = vp8b_bits(br, 1)
    }
    if br.ok == 0 {
        return img_fail(br.err)
    }
    // If color indexing happened, image is decoded at last cur_w.
    // Multiple indexings aren't allowed; cur_w is after all index transforms.
    let img = vp8l_image(br, cur_w, h, 1)
    if img.ok == 0 {
        return img_fail(img.err)
    }
    let mut px = img.px
    let mut cw = cur_w
    let mut ti = vec_len(ttype) - 1
    while ti >= 0 {
        let ty = vec_get(ttype, ti)
        if ty == 0 {
            vp8l_inv_predictor(px, cw, h, vec_get(tbits, ti), vec_get(timg, ti))
        }
        if ty == 1 {
            vp8l_inv_color(px, cw, h, vec_get(tbits, ti), vec_get(timg, ti))
        }
        if ty == 2 {
            vp8l_inv_subgreen(px, cw * h)
        }
        if ty == 3 {
            let wb = vec_get(twid, ti)
            px = vp8l_inv_index(px, cw, h, orig_w, wb, vec_get(timg, ti), vec_get(tpaln, ti))
            cw = orig_w
        }
        ti = ti - 1
    }
    return img_ok(orig_w, h, px)
}
