// ops.baga — imageops subset (image-rs): crop, flip, rotate, nearest resize, gray, invert.

import "types.baga"

fn img_crop(im: Image, x: i64, y: i64, w: i64, h: i64) -> Image {
    if im.ok == 0 {
        return img_fail(im.err)
    }
    if x < 0 || y < 0 || w <= 0 || h <= 0 || x + w > im.w || y + h > im.h {
        return img_fail("img: crop out of bounds")
    }
    let px = bytes_new(w * h * 4)
    let mut yy: i64 = 0
    while yy < h {
        let mut xx: i64 = 0
        while xx < w {
            img_copy_px(im.px, ((y + yy) * im.w + (x + xx)) * 4, px, (yy * w + xx) * 4)
            xx = xx + 1
        }
        yy = yy + 1
    }
    return img_ok(w, h, px)
}

fn img_flip_h(im: Image) -> Image {
    if im.ok == 0 {
        return img_fail(im.err)
    }
    let px = bytes_new(im.w * im.h * 4)
    let mut y: i64 = 0
    while y < im.h {
        let mut x: i64 = 0
        while x < im.w {
            img_copy_px(im.px, (y * im.w + x) * 4, px, (y * im.w + (im.w - 1 - x)) * 4)
            x = x + 1
        }
        y = y + 1
    }
    return img_ok(im.w, im.h, px)
}

fn img_flip_v(im: Image) -> Image {
    if im.ok == 0 {
        return img_fail(im.err)
    }
    let px = bytes_new(im.w * im.h * 4)
    let mut y: i64 = 0
    while y < im.h {
        let mut x: i64 = 0
        while x < im.w {
            img_copy_px(im.px, (y * im.w + x) * 4, px, ((im.h - 1 - y) * im.w + x) * 4)
            x = x + 1
        }
        y = y + 1
    }
    return img_ok(im.w, im.h, px)
}

// Clockwise 90°. Output size is (h, w).
fn img_rotate90(im: Image) -> Image {
    if im.ok == 0 {
        return img_fail(im.err)
    }
    let nw = im.h
    let nh = im.w
    let px = bytes_new(nw * nh * 4)
    let mut y: i64 = 0
    while y < im.h {
        let mut x: i64 = 0
        while x < im.w {
            let nx = im.h - 1 - y
            let ny = x
            img_copy_px(im.px, (y * im.w + x) * 4, px, (ny * nw + nx) * 4)
            x = x + 1
        }
        y = y + 1
    }
    return img_ok(nw, nh, px)
}

fn img_rotate180(im: Image) -> Image {
    return img_flip_h(img_flip_v(im))
}

fn img_resize(im: Image, nw: i64, nh: i64) -> Image {
    if im.ok == 0 {
        return img_fail(im.err)
    }
    if nw <= 0 || nh <= 0 {
        return img_fail("img: bad resize")
    }
    if nw > 4096 || nh > 4096 {
        return img_fail("img: size over 4096 (v1 limit)")
    }
    let px = bytes_new(nw * nh * 4)
    let mut y: i64 = 0
    while y < nh {
        let sy = y * im.h / nh
        let mut x: i64 = 0
        while x < nw {
            let sx = x * im.w / nw
            img_copy_px(im.px, (sy * im.w + sx) * 4, px, (y * nw + x) * 4)
            x = x + 1
        }
        y = y + 1
    }
    return img_ok(nw, nh, px)
}

fn img_resize_nearest(im: Image, nw: i64, nh: i64) -> Image {
    return img_resize(im, nw, nh)
}

fn img_lerp4(c00: i64, c10: i64, c01: i64, c11: i64, fx: i64, fy: i64) -> i64 {
    let w00 = (256 - fx) * (256 - fy)
    let w10 = fx * (256 - fy)
    let w01 = (256 - fx) * fy
    let w11 = fx * fy
    return (c00 * w00 + c10 * w10 + c01 * w01 + c11 * w11 + 32768) / 65536
}

// Bilinear (image-rs FilterType::Triangle / bilinear).
fn img_resize_bilinear(im: Image, nw: i64, nh: i64) -> Image {
    if im.ok == 0 {
        return img_fail(im.err)
    }
    if nw <= 0 || nh <= 0 {
        return img_fail("img: bad resize")
    }
    if nw > 4096 || nh > 4096 {
        return img_fail("img: size over 4096 (v1 limit)")
    }
    if nw == im.w && nh == im.h {
        let px = bytes_new(im.w * im.h * 4)
        let n = im.w * im.h * 4
        let mut i: i64 = 0
        while i < n {
            bytes_set(px, i, bytes_at(im.px, i))
            i = i + 1
        }
        return img_ok(nw, nh, px)
    }
    let px = bytes_new(nw * nh * 4)
    let mut xden = nw - 1
    let mut yden = nh - 1
    if xden < 1 { xden = 1 }
    let mut xnum = im.w - 1
    if xnum < 0 { xnum = 0 }
    if yden < 1 { yden = 1 }
    let mut ynum = im.h - 1
    if ynum < 0 { ynum = 0 }
    let mut y: i64 = 0
    while y < nh {
        let sy = y * ynum * 256 / yden
        let iy = sy / 256
        let fy = sy % 256
        let mut iy1 = iy + 1
        if iy1 >= im.h { iy1 = im.h - 1 }
        let mut iy0 = iy
        if iy0 >= im.h { iy0 = im.h - 1 }
        if iy0 < 0 { iy0 = 0 }
        let mut x: i64 = 0
        while x < nw {
            let sx = x * xnum * 256 / xden
            let ix = sx / 256
            let fx = sx % 256
            let mut ix1 = ix + 1
            if ix1 >= im.w { ix1 = im.w - 1 }
            let mut ix0 = ix
            if ix0 >= im.w { ix0 = im.w - 1 }
            if ix0 < 0 { ix0 = 0 }
            let p00 = img_pixel(im, ix0, iy0)
            let p10 = img_pixel(im, ix1, iy0)
            let p01 = img_pixel(im, ix0, iy1)
            let p11 = img_pixel(im, ix1, iy1)
            let o = (y * nw + x) * 4
            bytes_set(px, o, img_lerp4(p00.r, p10.r, p01.r, p11.r, fx, fy))
            bytes_set(px, o + 1, img_lerp4(p00.g, p10.g, p01.g, p11.g, fx, fy))
            bytes_set(px, o + 2, img_lerp4(p00.b, p10.b, p01.b, p11.b, fx, fy))
            bytes_set(px, o + 3, img_lerp4(p00.a, p10.a, p01.a, p11.a, fx, fy))
            x = x + 1
        }
        y = y + 1
    }
    return img_ok(nw, nh, px)
}

// Rec. 601 luma, keep alpha.
fn img_grayscale(im: Image) -> Image {
    if im.ok == 0 {
        return img_fail(im.err)
    }
    let px = bytes_new(im.w * im.h * 4)
    let n = im.w * im.h
    let mut i: i64 = 0
    while i < n {
        let o = i * 4
        let r = bytes_at(im.px, o) & 255
        let g = bytes_at(im.px, o + 1) & 255
        let b = bytes_at(im.px, o + 2) & 255
        let a = bytes_at(im.px, o + 3) & 255
        let y = (77 * r + 150 * g + 29 * b) / 256
        bytes_set(px, o, y)
        bytes_set(px, o + 1, y)
        bytes_set(px, o + 2, y)
        bytes_set(px, o + 3, a)
        i = i + 1
    }
    return img_ok(im.w, im.h, px)
}

fn img_invert(im: Image) -> Image {
    if im.ok == 0 {
        return img_fail(im.err)
    }
    let px = bytes_new(im.w * im.h * 4)
    let n = im.w * im.h
    let mut i: i64 = 0
    while i < n {
        let o = i * 4
        bytes_set(px, o, 255 - (bytes_at(im.px, o) & 255))
        bytes_set(px, o + 1, 255 - (bytes_at(im.px, o + 1) & 255))
        bytes_set(px, o + 2, 255 - (bytes_at(im.px, o + 2) & 255))
        bytes_set(px, o + 3, bytes_at(im.px, o + 3))
        i = i + 1
    }
    return img_ok(im.w, im.h, px)
}
