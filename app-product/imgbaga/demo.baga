// demo.baga — CLI: info / convert / make
//
//   baga -I . -I app-product app-product/imgbaga/demo.baga info FILE
//   baga -I . -I app-product app-product/imgbaga/demo.baga convert IN OUT
//   baga -I . -I app-product app-product/imgbaga/demo.baga make OUT.png
//
// IN: png jpg gif bmp ppm qoi ico tif webp.  OUT: png jpg bmp ppm qoi ico.

import "imgbaga/img.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn usage() {
    eprintln("imgbaga demo")
    eprintln("  info FILE")
    eprintln("  convert IN.{png,jpg,gif,bmp,ppm,qoi,ico,tif,webp} OUT.{png,jpg,bmp,ppm,qoi,ico}")
    eprintln("  make OUT.png   (2x2 RGB probe)")
}

fn main() -> i64 !IO {
    if arg_count() < 1 {
        usage()
        return 1
    }
    let cmd = arg(0)
    if cmd == "info" {
        if arg_count() < 2 {
            usage()
            return 1
        }
        let im = img_open(arg(1))?
        if im.ok == 0 {
            let inf = img_info(read_file_bytes(arg(1))?)
            if inf.ok == 1 {
                print(concat(concat(img_fmt_name(inf.format), " "), concat(concat(int_to_str(inf.w), "x"), int_to_str(inf.h))))
                return 0
            }
            eprintln(im.err)
            return 1
        }
        print(concat(concat(int_to_str(im.w), "x"), int_to_str(im.h)))
        let p = img_pixel(im, 0, 0)
        print(concat(concat(concat("rgba0 ", int_to_str(p.r)), " "), concat(int_to_str(p.g), concat(" ", int_to_str(p.b)))))
        return 0
    }
    if cmd == "convert" {
        if arg_count() < 3 {
            usage()
            return 1
        }
        let im = img_open(arg(1))?
        if im.ok == 0 {
            eprintln(im.err)
            return 1
        }
        let n = img_save(im, arg(2))?
        if n == 0 {
            eprintln("save failed (need .png/.jpg/.bmp/.ppm/.qoi/.ico)")
            return 1
        }
        print(concat("wrote ", arg(2)))
        return 0
    }
    if cmd == "make" {
        if arg_count() < 2 {
            usage()
            return 1
        }
        let im = img_new(2, 2, 0, 0, 0, 255)
        img_put(im, 0, 0, 255, 0, 0, 255)
        img_put(im, 1, 0, 0, 255, 0, 255)
        img_put(im, 0, 1, 0, 0, 255, 255)
        img_put(im, 1, 1, 255, 255, 255, 255)
        let n = img_save(im, arg(1))?
        if n == 0 {
            eprintln("save failed")
            return 1
        }
        print(concat("wrote ", arg(1)))
        return 0
    }
    usage()
    return 1
}
