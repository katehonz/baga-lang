// gif.baga — GIF87a/89a decode (image-rs gif). First frame + animation (disposal, delay).

import "types.baga"

fn gif_skip_sub(b: bytes, i0: i64) -> i64 {
    let n = bytes_len(b)
    let mut i = i0
    while i < n {
        let sz = bytes_at(b, i) & 255
        i = i + 1
        if sz == 0 {
            return i
        }
        i = i + sz
    }
    return n
}

fn gif_concat_sub(b: bytes, i0: i64) -> bytes {
    let n = bytes_len(b)
    let mut i = i0
    let mut total: i64 = 0
    while i < n {
        let sz = bytes_at(b, i) & 255
        i = i + 1
        if sz == 0 {
            i = n
        } else {
            total = total + sz
            i = i + sz
        }
    }
    let out = bytes_new(total)
    i = i0
    let mut o: i64 = 0
    while i < bytes_len(b) {
        let sz = bytes_at(b, i) & 255
        i = i + 1
        if sz == 0 {
            return out
        }
        let mut k: i64 = 0
        while k < sz && i < bytes_len(b) {
            bytes_set(out, o, bytes_at(b, i))
            o = o + 1
            i = i + 1
            k = k + 1
        }
    }
    return out
}

fn gif_lzw(src: bytes, min_cs: i64, npix: i64) -> bytes {
    let clear = 1 << min_cs
    let eoi = clear + 1
    let out = bytes_new(npix)
    let prefix = vec_new()
    let suffix = vec_new()
    let mut t: i64 = 0
    while t < 4096 {
        vec_push(prefix, 0 - 1)
        vec_push(suffix, 0)
        t = t + 1
    }
    let mut next = eoi + 1
    let mut cs = min_cs + 1
    let mut bitbuf: i64 = 0
    let mut nbits: i64 = 0
    let mut spos: i64 = 0
    let mut o: i64 = 0
    let mut old: i64 = 0 - 1
    let mut running = 1
    while running == 1 && o < npix {
        while nbits < cs && spos < bytes_len(src) {
            bitbuf = bitbuf | ((bytes_at(src, spos) & 255) << nbits)
            nbits = nbits + 8
            spos = spos + 1
        }
        if nbits < cs {
            running = 0
        } else {
            let mask = (1 << cs) - 1
            let code = bitbuf & mask
            bitbuf = bitbuf >> cs
            nbits = nbits - cs
            if code == eoi {
                running = 0
            } else {
                if code == clear {
                    next = eoi + 1
                    cs = min_cs + 1
                    old = 0 - 1
                } else {
                    if old < 0 {
                        if code < clear {
                            bytes_set(out, o, code)
                            o = o + 1
                        }
                        old = code
                    } else {
                        let mut c = code
                        if c >= next {
                            c = old
                        }
                        let stack = vec_new()
                        let mut guard: i64 = 0
                        while c >= clear && guard < 4096 {
                            vec_push(stack, vec_get(suffix, c))
                            c = vec_get(prefix, c)
                            guard = guard + 1
                        }
                        vec_push(stack, c)
                        let mut si = vec_len(stack) - 1
                        while si >= 0 && o < npix {
                            bytes_set(out, o, vec_get(stack, si))
                            o = o + 1
                            si = si - 1
                        }
                        if code >= next && o < npix {
                            bytes_set(out, o, c)
                            o = o + 1
                        }
                        if next < 4096 {
                            vec_set(prefix, next, old)
                            vec_set(suffix, next, c)
                            next = next + 1
                            if next == (1 << cs) && cs < 12 {
                                cs = cs + 1
                            }
                        }
                        old = code
                    }
                }
            }
        }
    }
    return out
}

struct GifAnim {
    w: i64,
    h: i64,
    n: i64,
    ok: i64,
    err: str,
    delays: Vec<i64>,
    px: bytes
}

fn gif_anim_fail(msg: str) -> GifAnim {
    return GifAnim { w: 0, h: 0, n: 0, ok: 0, err: msg, delays: vec_new(), px: bytes_new(0) }
}

fn gif_copy_canvas(src: bytes, n: i64) -> bytes {
    let d = bytes_new(n)
    let mut i: i64 = 0
    while i < n {
        bytes_set(d, i, bytes_at(src, i))
        i = i + 1
    }
    return d
}

fn gif_decode(src: bytes) -> Image {
    let a = gif_anim_decode(src)
    if a.ok == 0 {
        return img_fail(a.err)
    }
    return gif_anim_frame(a, 0)
}

fn gif_anim_frame(a: GifAnim, i: i64) -> Image {
    if a.ok == 0 || i < 0 || i >= a.n {
        return img_fail("gif: no frame")
    }
    let sz = a.w * a.h * 4
    let px = bytes_new(sz)
    let off = i * sz
    let mut k: i64 = 0
    while k < sz {
        bytes_set(px, k, bytes_at(a.px, off + k))
        k = k + 1
    }
    return img_ok(a.w, a.h, px)
}

fn gif_anim_delay(a: GifAnim, i: i64) -> i64 {
    if a.ok == 0 || i < 0 || i >= vec_len(a.delays) {
        return 0
    }
    return vec_get(a.delays, i)
}

fn gif_anim_decode(src: bytes) -> GifAnim {
    if bytes_len(src) < 13 {
        return gif_anim_fail("gif: truncated")
    }
    if (bytes_at(src, 0) & 255) != 71 || (bytes_at(src, 1) & 255) != 73 || (bytes_at(src, 2) & 255) != 70 {
        return gif_anim_fail("gif: bad header")
    }
    let w = img_le16(src, 6)
    let h = img_le16(src, 8)
    if w <= 0 || h <= 0 || w > 4096 || h > 4096 {
        return gif_anim_fail("gif: bad size")
    }
    let packed = bytes_at(src, 10) & 255
    let bg = bytes_at(src, 11) & 255
    let mut i: i64 = 13
    let gct = bytes_new(768)
    let mut gct_n: i64 = 0
    if (packed & 128) != 0 {
        gct_n = 1 << ((packed & 7) + 1)
        if i + gct_n * 3 > bytes_len(src) {
            return gif_anim_fail("gif: truncated GCT")
        }
        let mut k: i64 = 0
        while k < gct_n * 3 {
            bytes_set(gct, k, bytes_at(src, i + k))
            k = k + 1
        }
        i = i + gct_n * 3
    }
    return gif_anim_walk(src, i, w, h, gct, gct_n, bg)
}

fn gif_anim_walk(src: bytes, i0: i64, w: i64, h: i64, gct: bytes, gct_n: i64, bg: i64) -> GifAnim {
    let nsrc = bytes_len(src)
    let mut i = i0
    let mut trans: i64 = 0 - 1
    let mut delay: i64 = 0
    let mut dispose: i64 = 0
    let csz = w * h * 4
    let canvas = bytes_new(csz)
    if gct_n > 0 && bg < gct_n {
        let br = bytes_at(gct, bg * 3)
        let bg_ = bytes_at(gct, bg * 3 + 1)
        let bb = bytes_at(gct, bg * 3 + 2)
        let mut p: i64 = 0
        while p < w * h {
            bytes_set(canvas, p * 4, br)
            bytes_set(canvas, p * 4 + 1, bg_)
            bytes_set(canvas, p * 4 + 2, bb)
            bytes_set(canvas, p * 4 + 3, 255)
            p = p + 1
        }
    }
    let mut backup = gif_copy_canvas(canvas, csz)
    let delays = vec_new()
    let mut acc = bytes_new(0)
    let mut nf: i64 = 0
    while i < nsrc {
        let b = bytes_at(src, i) & 255
        i = i + 1
        if b == 59 {
            if nf == 0 {
                return gif_anim_fail("gif: no image")
            }
            return GifAnim { w: w, h: h, n: nf, ok: 1, err: "", delays: delays, px: acc }
        }
        if b == 33 {
            if i >= nsrc {
                return gif_anim_fail("gif: truncated ext")
            }
            let lab = bytes_at(src, i) & 255
            i = i + 1
            if lab == 249 {
                if i + 5 > nsrc {
                    return gif_anim_fail("gif: truncated GCE")
                }
                let sz = bytes_at(src, i) & 255
                let fl = bytes_at(src, i + 1) & 255
                delay = img_le16(src, i + 2)
                let ti = bytes_at(src, i + 4) & 255
                dispose = (fl >> 2) & 7
                trans = 0 - 1
                if (fl & 1) == 1 {
                    trans = ti
                }
                i = i + 1 + sz
                if i < nsrc && (bytes_at(src, i) & 255) == 0 {
                    i = i + 1
                }
            } else {
                i = gif_skip_sub(src, i)
            }
        } else {
            if b == 44 {
                if dispose == 3 {
                    backup = gif_copy_canvas(canvas, csz)
                }
                let nxt = gif_blit(src, i, w, h, gct, gct_n, canvas, trans)
                if nxt < 0 {
                    return gif_anim_fail("gif: bad frame")
                }
                i = nxt
                acc = bytes_concat(acc, canvas)
                vec_push(delays, delay)
                nf = nf + 1
                if dispose == 2 {
                    gif_clear_rect(src, i, w, h, canvas, gct, gct_n, bg)
                }
                if dispose == 3 {
                    canvas_restore(canvas, backup, csz)
                }
                trans = 0 - 1
                delay = 0
                dispose = 0
            }
        }
    }
    if nf == 0 {
        return gif_anim_fail("gif: no image")
    }
    return GifAnim { w: w, h: h, n: nf, ok: 1, err: "", delays: delays, px: acc }
}

fn canvas_restore(dst: bytes, src: bytes, n: i64) {
    let mut k: i64 = 0
    while k < n {
        bytes_set(dst, k, bytes_at(src, k))
        k = k + 1
    }
}

fn gif_clear_rect(src: bytes, after: i64, w: i64, h: i64, canvas: bytes, gct: bytes, gct_n: i64, bg: i64) {
    // Best-effort: clear whole canvas to background (frame rect already drawn).
    // Full rect-clear needs the previous descriptor; leave canvas (dispose 2
    // on full-frame GIFs is equivalent).
    if gct_n > 0 && bg < gct_n {
        let br = bytes_at(gct, bg * 3)
        let bg_ = bytes_at(gct, bg * 3 + 1)
        let bb = bytes_at(gct, bg * 3 + 2)
        let mut p: i64 = 0
        while p < w * h {
            bytes_set(canvas, p * 4, br)
            bytes_set(canvas, p * 4 + 1, bg_)
            bytes_set(canvas, p * 4 + 2, bb)
            bytes_set(canvas, p * 4 + 3, 255)
            p = p + 1
        }
    }
}

// Blit one image descriptor at i (after the 0x2C). Returns next stream pos, or -1.
fn gif_blit(src: bytes, i0: i64, lw: i64, lh: i64, gct: bytes, gct_n: i64, canvas: bytes, trans: i64) -> i64 {
    if i0 + 9 > bytes_len(src) {
        return 0 - 1
    }
    let left = img_le16(src, i0)
    let top = img_le16(src, i0 + 2)
    let fw = img_le16(src, i0 + 4)
    let fh = img_le16(src, i0 + 6)
    let packed = bytes_at(src, i0 + 8) & 255
    let mut i = i0 + 9
    let pal = bytes_new(768)
    let mut pal_n = gct_n
    let mut k: i64 = 0
    while k < gct_n * 3 {
        bytes_set(pal, k, bytes_at(gct, k))
        k = k + 1
    }
    if (packed & 128) != 0 {
        let n = 1 << ((packed & 7) + 1)
        if i + n * 3 > bytes_len(src) {
            return 0 - 1
        }
        pal_n = n
        let mut j: i64 = 0
        while j < n * 3 {
            bytes_set(pal, j, bytes_at(src, i + j))
            j = j + 1
        }
        i = i + n * 3
    }
    if pal_n <= 0 || i >= bytes_len(src) {
        return 0 - 1
    }
    let min_cs = bytes_at(src, i) & 255
    i = i + 1
    if min_cs < 2 || min_cs > 8 {
        return 0 - 1
    }
    let data = gif_concat_sub(src, i)
    i = gif_skip_sub(src, i)
    let idxs = gif_lzw(data, min_cs, fw * fh)
    let inter = packed & 64
    let mut yi: i64 = 0
    while yi < fh {
        let mut dest_y = top + yi
        if inter != 0 {
            dest_y = top + gif_ilace_y(yi, fh)
        }
        let mut xi: i64 = 0
        while xi < fw {
            let dest_x = left + xi
            if dest_x >= 0 && dest_y >= 0 && dest_x < lw && dest_y < lh {
                let idx = bytes_at(idxs, yi * fw + xi) & 255
                if idx != trans && idx < pal_n {
                    let o = (dest_y * lw + dest_x) * 4
                    bytes_set(canvas, o, bytes_at(pal, idx * 3))
                    bytes_set(canvas, o + 1, bytes_at(pal, idx * 3 + 1))
                    bytes_set(canvas, o + 2, bytes_at(pal, idx * 3 + 2))
                    bytes_set(canvas, o + 3, 255)
                }
            }
            xi = xi + 1
        }
        yi = yi + 1
    }
    return i
}

fn gif_frame(src: bytes, i0: i64, lw: i64, lh: i64, gct: bytes, gct_n: i64, bg: i64, trans: i64) -> Image {
    if i0 + 9 > bytes_len(src) {
        return img_fail("gif: truncated descriptor")
    }
    let left = img_le16(src, i0)
    let top = img_le16(src, i0 + 2)
    let fw = img_le16(src, i0 + 4)
    let fh = img_le16(src, i0 + 6)
    let packed = bytes_at(src, i0 + 8) & 255
    let mut i = i0 + 9
    let pal = bytes_new(768)
    let mut pal_n = gct_n
    let mut k: i64 = 0
    while k < gct_n * 3 {
        bytes_set(pal, k, bytes_at(gct, k))
        k = k + 1
    }
    if (packed & 128) != 0 {
        let n = 1 << ((packed & 7) + 1)
        if i + n * 3 > bytes_len(src) {
            return img_fail("gif: truncated LCT")
        }
        pal_n = n
        let mut j: i64 = 0
        while j < n * 3 {
            bytes_set(pal, j, bytes_at(src, i + j))
            j = j + 1
        }
        i = i + n * 3
    }
    if pal_n <= 0 {
        return img_fail("gif: no color table")
    }
    if i >= bytes_len(src) {
        return img_fail("gif: no LZW size")
    }
    let min_cs = bytes_at(src, i) & 255
    i = i + 1
    if min_cs < 2 || min_cs > 8 {
        return img_fail("gif: bad LZW size")
    }
    let data = gif_concat_sub(src, i)
    let idxs = gif_lzw(data, min_cs, fw * fh)
    let px = bytes_new(lw * lh * 4)
    if bg < pal_n {
        let br = bytes_at(pal, bg * 3)
        let bg_ = bytes_at(pal, bg * 3 + 1)
        let bb = bytes_at(pal, bg * 3 + 2)
        let mut p: i64 = 0
        while p < lw * lh {
            bytes_set(px, p * 4, br)
            bytes_set(px, p * 4 + 1, bg_)
            bytes_set(px, p * 4 + 2, bb)
            bytes_set(px, p * 4 + 3, 255)
            p = p + 1
        }
    }
    let inter = packed & 64
    let mut yi: i64 = 0
    while yi < fh {
        let mut dest_y = top + yi
        if inter != 0 {
            dest_y = top + gif_ilace_y(yi, fh)
        }
        let mut xi: i64 = 0
        while xi < fw {
            let dest_x = left + xi
            if dest_x >= 0 && dest_y >= 0 && dest_x < lw && dest_y < lh {
                let idx = bytes_at(idxs, yi * fw + xi) & 255
                if idx != trans && idx < pal_n {
                    let o = (dest_y * lw + dest_x) * 4
                    bytes_set(px, o, bytes_at(pal, idx * 3))
                    bytes_set(px, o + 1, bytes_at(pal, idx * 3 + 1))
                    bytes_set(px, o + 2, bytes_at(pal, idx * 3 + 2))
                    bytes_set(px, o + 3, 255)
                }
                if idx == trans && dest_x >= 0 {
                    let o = (dest_y * lw + dest_x) * 4
                    bytes_set(px, o + 3, 0)
                }
            }
            xi = xi + 1
        }
        yi = yi + 1
    }
    return img_ok(lw, lh, px)
}

fn gif_ilace_y(i: i64, h: i64) -> i64 {
    let mut n: i64 = 0
    let mut y: i64 = 0
    while y < h {
        if n == i { return y }
        n = n + 1
        y = y + 8
    }
    y = 4
    while y < h {
        if n == i { return y }
        n = n + 1
        y = y + 8
    }
    y = 2
    while y < h {
        if n == i { return y }
        n = n + 1
        y = y + 4
    }
    y = 1
    while y < h {
        if n == i { return y }
        n = n + 1
        y = y + 2
    }
    return i
}
