// tiff.baga — TIFF decode: uncompressed + PackBits, 8-bit gray/RGB/RGBA (image-rs tiff subset).

import "types.baga"

fn tf_u16(b: bytes, i: i64, be: i64) -> i64 {
    if be == 1 {
        return img_be16(b, i)
    }
    return img_le16(b, i)
}

fn tf_u32(b: bytes, i: i64, be: i64) -> i64 {
    if be == 1 {
        return img_be32(b, i)
    }
    return img_le32(b, i)
}

fn tiff_info(b: bytes) -> ImgInfo {
    if bytes_len(b) < 8 {
        return img_info_fail("tiff: truncated")
    }
    let mut be: i64 = 0
    if (bytes_at(b, 0) & 255) == 77 && (bytes_at(b, 1) & 255) == 77 {
        be = 1
    } else {
        if (bytes_at(b, 0) & 255) != 73 || (bytes_at(b, 1) & 255) != 73 {
            return img_info_fail("tiff: bad endian")
        }
    }
    if tf_u16(b, 2, be) != 42 {
        return img_info_fail("tiff: not classic TIFF")
    }
    let ifd = tf_u32(b, 4, be)
    if ifd + 2 > bytes_len(b) {
        return img_info_fail("tiff: bad IFD")
    }
    let w = tiff_tag(b, ifd, be, 256)
    let h = tiff_tag(b, ifd, be, 257)
    if w <= 0 || h <= 0 {
        return img_info_fail("tiff: no size")
    }
    return img_info_ok(img_fmt_tiff(), w, h)
}

fn tiff_tag(b: bytes, ifd: i64, be: i64, want: i64) -> i64 {
    let n = tf_u16(b, ifd, be)
    let mut i: i64 = 0
    while i < n {
        let o = ifd + 2 + i * 12
        if o + 12 > bytes_len(b) {
            return 0
        }
        if tf_u16(b, o, be) == want {
            return tiff_entry_val(b, o, be, 0)
        }
        i = i + 1
    }
    return 0
}

fn tiff_entry_off(b: bytes, ifd: i64, be: i64, want: i64) -> i64 {
    let n = tf_u16(b, ifd, be)
    let mut i: i64 = 0
    while i < n {
        let o = ifd + 2 + i * 12
        if o + 12 > bytes_len(b) {
            return 0 - 1
        }
        if tf_u16(b, o, be) == want {
            return o
        }
        i = i + 1
    }
    return 0 - 1
}

fn tiff_entry_val(b: bytes, o: i64, be: i64, idx: i64) -> i64 {
    let typ = tf_u16(b, o + 2, be)
    let cnt = tf_u32(b, o + 4, be)
    let raw = tf_u32(b, o + 8, be)
    if idx < 0 || idx >= cnt {
        return 0
    }
    if typ == 3 {
        if cnt <= 2 {
            if be == 1 {
                if idx == 0 {
                    return (raw >> 16) & 65535
                }
                return raw & 65535
            }
            if idx == 0 {
                return raw & 65535
            }
            return (raw >> 16) & 65535
        }
        let p = raw + idx * 2
        if p + 2 > bytes_len(b) {
            return 0
        }
        return tf_u16(b, p, be)
    }
    if typ == 4 {
        if cnt == 1 {
            return raw
        }
        let p = raw + idx * 4
        if p + 4 > bytes_len(b) {
            return 0
        }
        return tf_u32(b, p, be)
    }
    if typ == 1 {
        if cnt <= 4 {
            return (raw >> (8 * idx)) & 255
        }
        let p = raw + idx
        if p >= bytes_len(b) {
            return 0
        }
        return bytes_at(b, p) & 255
    }
    return raw
}

fn tiff_entry_cnt(b: bytes, o: i64, be: i64) -> i64 {
    return tf_u32(b, o + 4, be)
}

fn packbits_decode(src: bytes, want: i64) -> bytes {
    let out = bytes_new(want)
    let mut i: i64 = 0
    let mut o: i64 = 0
    while i < bytes_len(src) && o < want {
        let n = bytes_at(src, i) & 255
        i = i + 1
        if n <= 127 {
            let cnt = n + 1
            let mut k: i64 = 0
            while k < cnt && i < bytes_len(src) && o < want {
                bytes_set(out, o, bytes_at(src, i))
                o = o + 1
                i = i + 1
                k = k + 1
            }
        } else {
            if n != 128 {
                let cnt = 257 - n
                if i >= bytes_len(src) {
                    i = bytes_len(src)
                } else {
                    let v = bytes_at(src, i) & 255
                    i = i + 1
                    let mut k: i64 = 0
                    while k < cnt && o < want {
                        bytes_set(out, o, v)
                        o = o + 1
                        k = k + 1
                    }
                }
            }
        }
    }
    return out
}

fn tiff_decode(src: bytes) -> Image {
    if bytes_len(src) < 8 {
        return img_fail("tiff: truncated")
    }
    let mut be: i64 = 0
    if (bytes_at(src, 0) & 255) == 77 && (bytes_at(src, 1) & 255) == 77 {
        be = 1
    } else {
        if (bytes_at(src, 0) & 255) != 73 || (bytes_at(src, 1) & 255) != 73 {
            return img_fail("tiff: bad endian")
        }
    }
    if tf_u16(src, 2, be) != 42 {
        return img_fail("tiff: not classic TIFF")
    }
    let ifd = tf_u32(src, 4, be)
    if ifd + 2 > bytes_len(src) {
        return img_fail("tiff: bad IFD")
    }
    let w = tiff_tag(src, ifd, be, 256)
    let h = tiff_tag(src, ifd, be, 257)
    if w <= 0 || h <= 0 || w > 4096 || h > 4096 {
        return img_fail("tiff: bad size")
    }
    let mut comp = tiff_tag(src, ifd, be, 259)
    if comp == 0 {
        comp = 1
    }
    if comp != 1 && comp != 32773 {
        return img_fail("tiff: only uncompressed/PackBits")
    }
    let photo = tiff_tag(src, ifd, be, 262)
    let mut spp = tiff_tag(src, ifd, be, 277)
    if spp == 0 {
        if photo == 2 {
            spp = 3
        } else {
            spp = 1
        }
    }
    let bps_e = tiff_entry_off(src, ifd, be, 258)
    let mut bps: i64 = 8
    if bps_e >= 0 {
        bps = tiff_entry_val(src, bps_e, be, 0)
    }
    if bps != 8 {
        return img_fail("tiff: only 8-bit")
    }
    let off_e = tiff_entry_off(src, ifd, be, 273)
    let cnt_e = tiff_entry_off(src, ifd, be, 279)
    if off_e < 0 {
        return img_fail("tiff: no StripOffsets")
    }
    let nstrips = tiff_entry_cnt(src, off_e, be)
    let mut raw = bytes_new(0)
    let mut s: i64 = 0
    while s < nstrips {
        let off = tiff_entry_val(src, off_e, be, s)
        let mut n = 0
        if cnt_e >= 0 {
            n = tiff_entry_val(src, cnt_e, be, s)
        }
        if n <= 0 {
            n = bytes_len(src) - off
        }
        if off < 0 || off + n > bytes_len(src) {
            return img_fail("tiff: bad strip")
        }
        raw = bytes_concat(raw, bytes_slice(src, off, off + n))
        s = s + 1
    }
    let want = w * h * spp
    if comp == 32773 {
        raw = packbits_decode(raw, want)
    }
    if bytes_len(raw) < want {
        return img_fail("tiff: short pixels")
    }
    let px = bytes_new(w * h * 4)
    let mut i: i64 = 0
    while i < w * h {
        let o = i * 4
        if spp == 1 {
            let mut y = bytes_at(raw, i) & 255
            if photo == 0 {
                y = 255 - y
            }
            bytes_set(px, o, y)
            bytes_set(px, o + 1, y)
            bytes_set(px, o + 2, y)
            bytes_set(px, o + 3, 255)
        } else {
            let s0 = i * spp
            bytes_set(px, o, bytes_at(raw, s0))
            bytes_set(px, o + 1, bytes_at(raw, s0 + 1))
            bytes_set(px, o + 2, bytes_at(raw, s0 + 2))
            let mut a: i64 = 255
            if spp >= 4 {
                a = bytes_at(raw, s0 + 3) & 255
            }
            bytes_set(px, o + 3, a)
        }
        i = i + 1
    }
    return img_ok(w, h, px)
}
