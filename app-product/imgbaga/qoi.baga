// qoi.baga — Quite OK Image Format (qoiformat.org / image-rs qoi).

import "types.baga"

fn qoi_hash(r: i64, g: i64, b: i64, a: i64) -> i64 {
    return (r * 3 + g * 5 + b * 7 + a * 11) % 64
}

fn qoi_u8(x: i64) -> i64 {
    return x & 255
}

fn qoi_sdiff(a: i64, b: i64) -> i64 {
    let d = (a - b) & 255
    if d >= 128 {
        return d - 256
    }
    return d
}

fn qoi_info(b: bytes) -> ImgInfo {
    if bytes_len(b) < 14 {
        return img_info_fail("qoi: truncated")
    }
    if (bytes_at(b, 0) & 255) != 113 || (bytes_at(b, 1) & 255) != 111 {
        return img_info_fail("qoi: bad magic")
    }
    let w = img_be32(b, 4)
    let h = img_be32(b, 8)
    return img_info_ok(img_fmt_qoi(), w, h)
}

fn qoi_decode(src: bytes) -> Image {
    if bytes_len(src) < 22 {
        return img_fail("qoi: truncated")
    }
    if (bytes_at(src, 0) & 255) != 113 || (bytes_at(src, 1) & 255) != 111 || (bytes_at(src, 2) & 255) != 105 || (bytes_at(src, 3) & 255) != 102 {
        return img_fail("qoi: bad magic")
    }
    let w = img_be32(src, 4)
    let h = img_be32(src, 8)
    let ch = bytes_at(src, 12) & 255
    if w <= 0 || h <= 0 || w > 4096 || h > 4096 {
        return img_fail("qoi: bad size")
    }
    if ch != 3 && ch != 4 {
        return img_fail("qoi: channels")
    }
    let n = w * h
    let px = bytes_new(n * 4)
    let idx = bytes_new(256)
    let mut r: i64 = 0
    let mut g: i64 = 0
    let mut b: i64 = 0
    let mut a: i64 = 255
    let mut i: i64 = 14
    let mut p: i64 = 0
    let mut run: i64 = 0
    let lim = bytes_len(src) - 8
    while p < n {
        if run > 0 {
            run = run - 1
        } else {
            if i >= lim {
                return img_fail("qoi: short stream")
            }
            let b1 = bytes_at(src, i) & 255
            i = i + 1
            if b1 == 254 {
                if i + 2 >= bytes_len(src) {
                    return img_fail("qoi: truncated RGB")
                }
                r = bytes_at(src, i) & 255
                g = bytes_at(src, i + 1) & 255
                b = bytes_at(src, i + 2) & 255
                i = i + 3
            } else {
                if b1 == 255 {
                    if i + 3 >= bytes_len(src) {
                        return img_fail("qoi: truncated RGBA")
                    }
                    r = bytes_at(src, i) & 255
                    g = bytes_at(src, i + 1) & 255
                    b = bytes_at(src, i + 2) & 255
                    a = bytes_at(src, i + 3) & 255
                    i = i + 4
                } else {
                    let tag = b1 & 192
                    if tag == 0 {
                        let o = (b1 & 63) * 4
                        r = bytes_at(idx, o) & 255
                        g = bytes_at(idx, o + 1) & 255
                        b = bytes_at(idx, o + 2) & 255
                        a = bytes_at(idx, o + 3) & 255
                    } else {
                        if tag == 64 {
                            r = qoi_u8(r + ((b1 >> 4) & 3) - 2)
                            g = qoi_u8(g + ((b1 >> 2) & 3) - 2)
                            b = qoi_u8(b + (b1 & 3) - 2)
                        } else {
                            if tag == 128 {
                                if i >= bytes_len(src) {
                                    return img_fail("qoi: truncated LUMA")
                                }
                                let b2 = bytes_at(src, i) & 255
                                i = i + 1
                                let vg = (b1 & 63) - 32
                                r = qoi_u8(r + vg - 8 + ((b2 >> 4) & 15))
                                g = qoi_u8(g + vg)
                                b = qoi_u8(b + vg - 8 + (b2 & 15))
                            } else {
                                run = b1 & 63
                            }
                        }
                    }
                }
            }
            let hsh = qoi_hash(r, g, b, a) * 4
            bytes_set(idx, hsh, r)
            bytes_set(idx, hsh + 1, g)
            bytes_set(idx, hsh + 2, b)
            bytes_set(idx, hsh + 3, a)
        }
        let o = p * 4
        bytes_set(px, o, r)
        bytes_set(px, o + 1, g)
        bytes_set(px, o + 2, b)
        bytes_set(px, o + 3, a)
        p = p + 1
    }
    return img_ok(w, h, px)
}

struct QoiW {
    data: bytes,
    len: i64
}

fn qw_new(cap: i64) -> QoiW {
    return QoiW { data: bytes_new(cap), len: 0 }
}

fn qw_put(w: QoiW, b: i64) -> QoiW {
    let mut d = w.data
    let mut n = w.len
    if n >= bytes_len(d) {
        let nd = bytes_new(bytes_len(d) * 2 + 32)
        let mut i: i64 = 0
        while i < n {
            bytes_set(nd, i, bytes_at(d, i))
            i = i + 1
        }
        d = nd
    }
    bytes_set(d, n, b)
    return QoiW { data: d, len: n + 1 }
}

fn qoi_encode(im: Image) -> bytes {
    if im.ok == 0 || im.w <= 0 || im.h <= 0 {
        return bytes_new(0)
    }
    if im.w > 4096 || im.h > 4096 {
        return bytes_new(0)
    }
    let cap = 14 + im.w * im.h * 5 + 8
    let mut w = qw_new(cap)
    w = qw_put(w, 113)
    w = qw_put(w, 111)
    w = qw_put(w, 105)
    w = qw_put(w, 102)
    w = qw_put(w, (im.w >> 24) & 255)
    w = qw_put(w, (im.w >> 16) & 255)
    w = qw_put(w, (im.w >> 8) & 255)
    w = qw_put(w, im.w & 255)
    w = qw_put(w, (im.h >> 24) & 255)
    w = qw_put(w, (im.h >> 16) & 255)
    w = qw_put(w, (im.h >> 8) & 255)
    w = qw_put(w, im.h & 255)
    w = qw_put(w, 4)
    w = qw_put(w, 0)
    let idx = bytes_new(256)
    let mut pr: i64 = 0
    let mut pg: i64 = 0
    let mut pb: i64 = 0
    let mut pa: i64 = 255
    let mut run: i64 = 0
    let n = im.w * im.h
    let mut p: i64 = 0
    while p < n {
        let o = p * 4
        let r = bytes_at(im.px, o) & 255
        let g = bytes_at(im.px, o + 1) & 255
        let b = bytes_at(im.px, o + 2) & 255
        let a = bytes_at(im.px, o + 3) & 255
        if r == pr && g == pg && b == pb && a == pa {
            run = run + 1
            if run == 62 || p == n - 1 {
                w = qw_put(w, 192 | (run - 1))
                run = 0
            }
        } else {
            if run > 0 {
                w = qw_put(w, 192 | (run - 1))
                run = 0
            }
            let hsh = qoi_hash(r, g, b, a)
            let io = hsh * 4
            if (bytes_at(idx, io) & 255) == r && (bytes_at(idx, io + 1) & 255) == g && (bytes_at(idx, io + 2) & 255) == b && (bytes_at(idx, io + 3) & 255) == a {
                w = qw_put(w, hsh)
            } else {
                bytes_set(idx, io, r)
                bytes_set(idx, io + 1, g)
                bytes_set(idx, io + 2, b)
                bytes_set(idx, io + 3, a)
                if a == pa {
                    let vr = qoi_sdiff(r, pr)
                    let vg = qoi_sdiff(g, pg)
                    let vb = qoi_sdiff(b, pb)
                    let vg_r = vr - vg
                    let vg_b = vb - vg
                    if vr > 0 - 3 && vr < 2 && vg > 0 - 3 && vg < 2 && vb > 0 - 3 && vb < 2 {
                        w = qw_put(w, 64 | ((vr + 2) << 4) | ((vg + 2) << 2) | (vb + 2))
                    } else {
                        if vg_r > 0 - 9 && vg_r < 8 && vg > 0 - 33 && vg < 32 && vg_b > 0 - 9 && vg_b < 8 {
                            w = qw_put(w, 128 | (vg + 32))
                            w = qw_put(w, ((vg_r + 8) << 4) | (vg_b + 8))
                        } else {
                            w = qw_put(w, 254)
                            w = qw_put(w, r)
                            w = qw_put(w, g)
                            w = qw_put(w, b)
                        }
                    }
                } else {
                    w = qw_put(w, 255)
                    w = qw_put(w, r)
                    w = qw_put(w, g)
                    w = qw_put(w, b)
                    w = qw_put(w, a)
                }
            }
        }
        pr = r
        pg = g
        pb = b
        pa = a
        p = p + 1
    }
    let mut z: i64 = 0
    while z < 7 {
        w = qw_put(w, 0)
        z = z + 1
    }
    w = qw_put(w, 1)
    return bytes_slice(w.data, 0, w.len)
}
