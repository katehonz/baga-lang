// types.baga — Image (RGBA8, image-rs DynamicImage analogue) + endian helpers.

struct Image {
    w: i64,
    h: i64,
    px: bytes,
    ok: i64,
    err: str
}

struct ImgInfo {
    format: i64,
    w: i64,
    h: i64,
    ok: i64,
    err: str
}

struct Pixel {
    r: i64,
    g: i64,
    b: i64,
    a: i64
}

fn img_fmt_unknown() -> i64 { return 0 }
fn img_fmt_png() -> i64 { return 1 }
fn img_fmt_jpeg() -> i64 { return 2 }
fn img_fmt_gif() -> i64 { return 3 }
fn img_fmt_bmp() -> i64 { return 4 }
fn img_fmt_webp() -> i64 { return 5 }
fn img_fmt_pnm() -> i64 { return 6 }
fn img_fmt_ico() -> i64 { return 7 }
fn img_fmt_tiff() -> i64 { return 8 }
fn img_fmt_qoi() -> i64 { return 9 }
fn img_fmt_hdr() -> i64 { return 10 }

fn img_fmt_name(f: i64) -> str {
    if f == 1 { return "png" }
    if f == 2 { return "jpeg" }
    if f == 3 { return "gif" }
    if f == 4 { return "bmp" }
    if f == 5 { return "webp" }
    if f == 6 { return "pnm" }
    if f == 7 { return "ico" }
    if f == 8 { return "tiff" }
    if f == 9 { return "qoi" }
    if f == 10 { return "hdr" }
    return "unknown"
}

fn img_fail(msg: str) -> Image {
    return Image { w: 0, h: 0, px: bytes_new(0), ok: 0, err: msg }
}

fn img_ok(w: i64, h: i64, px: bytes) -> Image {
    return Image { w: w, h: h, px: px, ok: 1, err: "" }
}

fn img_info_fail(msg: str) -> ImgInfo {
    return ImgInfo { format: 0, w: 0, h: 0, ok: 0, err: msg }
}

fn img_info_ok(fmt: i64, w: i64, h: i64) -> ImgInfo {
    return ImgInfo { format: fmt, w: w, h: h, ok: 1, err: "" }
}

fn img_clamp8(x: i64) -> i64 {
    if x < 0 { return 0 }
    if x > 255 { return 255 }
    return x
}

fn img_be16(b: bytes, i: i64) -> i64 {
    return ((bytes_at(b, i) & 255) << 8) | (bytes_at(b, i + 1) & 255)
}

fn img_be32(b: bytes, i: i64) -> i64 {
    return ((bytes_at(b, i) & 255) << 24)
        | ((bytes_at(b, i + 1) & 255) << 16)
        | ((bytes_at(b, i + 2) & 255) << 8)
        | (bytes_at(b, i + 3) & 255)
}

fn img_le16(b: bytes, i: i64) -> i64 {
    return (bytes_at(b, i) & 255) | ((bytes_at(b, i + 1) & 255) << 8)
}

fn img_le32(b: bytes, i: i64) -> i64 {
    return (bytes_at(b, i) & 255)
        | ((bytes_at(b, i + 1) & 255) << 8)
        | ((bytes_at(b, i + 2) & 255) << 16)
        | ((bytes_at(b, i + 3) & 255) << 24)
}

fn img_put_be16(b: bytes, i: i64, v: i64) {
    bytes_set(b, i, (v >> 8) & 255)
    bytes_set(b, i + 1, v & 255)
}

fn img_put_be32(b: bytes, i: i64, v: i64) {
    bytes_set(b, i, (v >> 24) & 255)
    bytes_set(b, i + 1, (v >> 16) & 255)
    bytes_set(b, i + 2, (v >> 8) & 255)
    bytes_set(b, i + 3, v & 255)
}

fn img_put_le16(b: bytes, i: i64, v: i64) {
    bytes_set(b, i, v & 255)
    bytes_set(b, i + 1, (v >> 8) & 255)
}

fn img_put_le32(b: bytes, i: i64, v: i64) {
    bytes_set(b, i, v & 255)
    bytes_set(b, i + 1, (v >> 8) & 255)
    bytes_set(b, i + 2, (v >> 16) & 255)
    bytes_set(b, i + 3, (v >> 24) & 255)
}

fn img_new(w: i64, h: i64, r: i64, g: i64, b: i64, a: i64) -> Image {
    if w <= 0 || h <= 0 {
        return img_fail("img: bad size")
    }
    if w > 4096 || h > 4096 {
        return img_fail("img: size over 4096 (v1 limit)")
    }
    let px = bytes_new(w * h * 4)
    let n = w * h
    let mut i: i64 = 0
    while i < n {
        let o = i * 4
        bytes_set(px, o, r)
        bytes_set(px, o + 1, g)
        bytes_set(px, o + 2, b)
        bytes_set(px, o + 3, a)
        i = i + 1
    }
    return img_ok(w, h, px)
}

fn img_pixel(im: Image, x: i64, y: i64) -> Pixel {
    if im.ok == 0 || x < 0 || y < 0 || x >= im.w || y >= im.h {
        return Pixel { r: 0, g: 0, b: 0, a: 0 }
    }
    let o = (y * im.w + x) * 4
    return Pixel {
        r: bytes_at(im.px, o) & 255,
        g: bytes_at(im.px, o + 1) & 255,
        b: bytes_at(im.px, o + 2) & 255,
        a: bytes_at(im.px, o + 3) & 255
    }
}

fn img_put(im: Image, x: i64, y: i64, r: i64, g: i64, b: i64, a: i64) {
    if im.ok == 0 || x < 0 || y < 0 || x >= im.w || y >= im.h {
        return
    }
    let o = (y * im.w + x) * 4
    bytes_set(im.px, o, r)
    bytes_set(im.px, o + 1, g)
    bytes_set(im.px, o + 2, b)
    bytes_set(im.px, o + 3, a)
}

fn img_copy_px(src: bytes, so: i64, dst: bytes, doff: i64) {
    bytes_set(dst, doff, bytes_at(src, so))
    bytes_set(dst, doff + 1, bytes_at(src, so + 1))
    bytes_set(dst, doff + 2, bytes_at(src, so + 2))
    bytes_set(dst, doff + 3, bytes_at(src, so + 3))
}

fn img_version() -> str {
    return "0.6.0"
}
