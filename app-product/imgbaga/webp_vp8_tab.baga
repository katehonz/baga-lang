// webp_vp8_tab.baga — VP8 default token/pred/dequant tables (RFC 6386).

fn vp8_tab_dft() -> bytes {
    return hex_decode("")
}

fn vp8_tab_upd() -> bytes {
    return hex_decode("")
}

fn vp8_tab_pred() -> bytes {
    return hex_decode("")
}

fn vp8_tab_luts() -> bytes {
    return hex_decode("07060605050505040404040404040403030303030303030303030303030303020202020202020202020202020202020202020202020202020202020202020201010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101")
}

fn vp8_tab_lutr() -> bytes {
    return hex_decode("7f7fbf7f9fbfdf7f8f9fafbfcfdfef7f878f979fa7afb7bfc7cfd7dfe7eff77f83878b8f93979b9fa3a7abafb3b7bbbfc3c7cbcfd3d7dbdfe3e7ebeff3f7fb7f81838587898b8d8f91939597999b9d9fa1a3a5a7a9abadafb1b3b5b7b9bbbdbfc1c3c5c7c9cbcdcfd1d3d5d7d9dbdddfe1e3e5e7e9ebedeff1f3f5f7f9fbfd")
}

fn vp8_tab_dqdc() -> bytes {
    return hex_decode("")
}

fn vp8_tab_dqac() -> bytes {
    return hex_decode("")
}

fn vp8_prob_at(tab: bytes, plane: i64, band: i64, ctx: i64, i: i64) -> i64 {
    return bytes_at(tab, plane * 264 + band * 33 + ctx * 11 + i) & 255
}

fn vp8_pred_prob(tab: bytes, above: i64, left: i64, i: i64) -> i64 {
    return bytes_at(tab, above * 90 + left * 9 + i) & 255
}

fn vp8_dq16(tab: bytes, i0: i64) -> i64 {
    let mut i = i0
    if i < 0 { i = 0 }
    if i > 127 { i = 127 }
    return (bytes_at(tab, i * 2) & 255) | ((bytes_at(tab, i * 2 + 1) & 255) << 8)
}
