// sniff.baga — magic-byte format guess (image-rs guess_format).

import "types.baga"

fn img_starts(b: bytes, sig: bytes) -> i64 {
    let n = bytes_len(sig)
    if bytes_len(b) < n {
        return 0
    }
    let mut i: i64 = 0
    while i < n {
        if (bytes_at(b, i) & 255) != (bytes_at(sig, i) & 255) {
            return 0
        }
        i = i + 1
    }
    return 1
}

fn img_guess(b: bytes) -> i64 {
    if img_starts(b, hex_decode("89504e470d0a1a0a")) == 1 {
        return img_fmt_png()
    }
    if bytes_len(b) >= 3 {
        if (bytes_at(b, 0) & 255) == 255 && (bytes_at(b, 1) & 255) == 216 && (bytes_at(b, 2) & 255) == 255 {
            return img_fmt_jpeg()
        }
    }
    if img_starts(b, bytes_of_str("GIF89a")) == 1 || img_starts(b, bytes_of_str("GIF87a")) == 1 {
        return img_fmt_gif()
    }
    if bytes_len(b) >= 12 {
        if img_starts(b, bytes_of_str("RIFF")) == 1 {
            if (bytes_at(b, 8) & 255) == 87 && (bytes_at(b, 9) & 255) == 69 && (bytes_at(b, 10) & 255) == 66 && (bytes_at(b, 11) & 255) == 80 {
                return img_fmt_webp()
            }
        }
    }
    if img_starts(b, hex_decode("4d4d002a")) == 1 || img_starts(b, hex_decode("49492a00")) == 1 {
        return img_fmt_tiff()
    }
    if img_starts(b, bytes_of_str("BM")) == 1 {
        return img_fmt_bmp()
    }
    if bytes_len(b) >= 4 {
        if (bytes_at(b, 0) & 255) == 0 && (bytes_at(b, 1) & 255) == 0 && (bytes_at(b, 2) & 255) == 1 && (bytes_at(b, 3) & 255) == 0 {
            return img_fmt_ico()
        }
    }
    if img_starts(b, bytes_of_str("qoif")) == 1 {
        return img_fmt_qoi()
    }
    if img_starts(b, bytes_of_str("#?RADIANCE")) == 1 {
        return img_fmt_hdr()
    }
    if bytes_len(b) >= 2 {
        if (bytes_at(b, 0) & 255) == 80 {
            let c = bytes_at(b, 1) & 255
            if c >= 49 && c <= 55 {
                return img_fmt_pnm()
            }
        }
    }
    return img_fmt_unknown()
}

fn img_fmt_from_ext(ext: str) -> i64 {
    if ext == ".png" || ext == ".PNG" {
        return img_fmt_png()
    }
    if ext == ".jpg" || ext == ".jpeg" || ext == ".JPG" || ext == ".JPEG" {
        return img_fmt_jpeg()
    }
    if ext == ".gif" || ext == ".GIF" {
        return img_fmt_gif()
    }
    if ext == ".bmp" || ext == ".BMP" {
        return img_fmt_bmp()
    }
    if ext == ".webp" || ext == ".WEBP" {
        return img_fmt_webp()
    }
    if ext == ".ppm" || ext == ".pgm" || ext == ".pbm" || ext == ".pnm" {
        return img_fmt_pnm()
    }
    if ext == ".ico" || ext == ".ICO" {
        return img_fmt_ico()
    }
    if ext == ".tif" || ext == ".tiff" || ext == ".TIF" || ext == ".TIFF" {
        return img_fmt_tiff()
    }
    if ext == ".qoi" {
        return img_fmt_qoi()
    }
    return img_fmt_unknown()
}

fn gif_info(b: bytes) -> ImgInfo {
    if bytes_len(b) < 10 {
        return img_info_fail("gif: truncated header")
    }
    let w = img_le16(b, 6)
    let h = img_le16(b, 8)
    return img_info_ok(img_fmt_gif(), w, h)
}
