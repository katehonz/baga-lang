// scan.baga — line-oriented file/fd scan for grebaga.
//
// Uses chunked fd_read + residual buffer so empty lines are distinct from EOF
// (std read_line collapses both to ""). Probes streaming I/O (apps-roadmap №9).

import "match.baga"
import "std/os/os.baga"
import "std/str/str.baga"

struct GreStream {
    fd: i64,
    buf: str,
    eof: i64,       // 1 = no more input
    lineno: i64     // last emitted line number (1-based)
}

struct GreLine {
    stream: GreStream,
    ok: i64,        // 1 = got a line (may be empty), 0 = EOF
    line: str
}

fn gre_stream_fd(fd: i64) -> GreStream {
    return GreStream { fd: fd, buf: "", eof: 0, lineno: 0 }
}

fn gre_stream_file(path: str) -> GreStream !IO {
    let fd = open(path, 0, 0)?
    // open failure → fd < 0; caller checks
    return GreStream { fd: fd, buf: "", eof: 0, lineno: 0 }
}

// Next line without trailing \n/\r. ok=0 only at true EOF.
fn gre_next_line(s: GreStream) -> GreLine !IO {
    let mut st = s
    while true {
        // look for newline in buffer
        let nl = str_find(st.buf, "\n")
        if nl >= 0 {
            let mut line = substr(st.buf, 0, nl)
            if len(line) > 0 && char_at(line, len(line) - 1) == 13 {
                line = substr(line, 0, len(line) - 1)
            }
            st = GreStream {
                fd: st.fd, buf: substr(st.buf, nl + 1, len(st.buf)),
                eof: st.eof, lineno: st.lineno + 1
            }
            return GreLine { stream: st, ok: 1, line: line }
        }
        if st.eof == 1 {
            if len(st.buf) == 0 {
                return GreLine { stream: st, ok: 0, line: "" }
            }
            // last partial line without newline
            let mut line = st.buf
            if len(line) > 0 && char_at(line, len(line) - 1) == 13 {
                line = substr(line, 0, len(line) - 1)
            }
            st = GreStream { fd: st.fd, buf: "", eof: 1, lineno: st.lineno + 1 }
            return GreLine { stream: st, ok: 1, line: line }
        }
        // fill
        let chunk = fd_read(st.fd, 4096)?
        if len(chunk) == 0 {
            st = GreStream { fd: st.fd, buf: st.buf, eof: 1, lineno: st.lineno }
        } else {
            st = GreStream {
                fd: st.fd, buf: concat(st.buf, chunk),
                eof: 0, lineno: st.lineno
            }
        }
    }
    return GreLine { stream: st, ok: 0, line: "" }
}

struct GreHit {
    path: str,
    lineno: i64,
    line: str
}

// Scan one stream; print matches. Returns hit count.
// show_path: 1 = prefix path:; show_num: 1 = prefix N:
fn gre_scan_print(s: GreStream, path: str, pat: str, fold: i64, show_path: i64, show_num: i64) -> i64 !IO {
    let mut st = s
    let mut hits: i64 = 0
    let mut running: i64 = 1
    while running == 1 {
        let r = gre_next_line(st)?
        st = r.stream
        if r.ok == 0 {
            running = 0
        } else {
            if gre_match(r.line, pat, fold) {
                hits = hits + 1
                let mut out = ""
                if show_path == 1 {
                    out = concat(concat(path, ":"), out)
                }
                if show_num == 1 {
                    out = concat(out, concat(int_to_str(st.lineno), ":"))
                }
                out = concat(out, r.line)
                print(out)
            }
        }
    }
    if st.fd >= 0 {
        close(st.fd)
    }
    return hits
}

// Pure: count matches in a string treated as whole file content.
fn gre_count_in(src: str, pat: str, fold: i64) -> i64 {
    let text = str_replace(str_replace(src, "\r\n", "\n"), "\r", "\n")
    let lines = str_split(text, "\n")
    // str_split keeps trailing empty after final \n — Common for files ending in \n
    let mut hits: i64 = 0
    let mut i: i64 = 0
    let n = vec_len(lines)
    while i < n {
        // if last empty from trailing newline and we already counted lines — still check empty line
        if gre_match(vec_get(lines, i), pat, fold) {
            hits = hits + 1
        }
        i = i + 1
    }
    // if source ends with \n, split adds trailing ""; if src is "a\n", lines = ["a",""]
    // good for empty line match. if src is "a" without nl, lines = ["a"]. OK.
    return hits
}
