// demo.baga — grep-like CLI (apps-roadmap №9).
//
//   baga -I ../.. -I .. demo.baga [--] [-n] [-i] <pattern> [file...]
//
// Flags (before pattern):
//   -n   print line numbers
//   -i   ASCII case-insensitive
// No files → read stdin (fd 0). Exit 0 if any hit, 1 if none, 2 on usage/open error.

import "scan.baga"
import "match.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn main() -> i64 !IO {
    let n = arg_count()
    if n < 1 {
        eprintln("usage: grebaga [-n] [-i] <pattern> [file...]")
        return 2
    }

    let mut fold: i64 = 0
    let mut show_num: i64 = 0
    let mut ai: i64 = 0
    let mut parsing: i64 = 1
    while parsing == 1 && ai < n {
        let a = arg(ai)
        if a == "-i" {
            fold = 1
            ai = ai + 1
        } else {
            if a == "-n" {
                show_num = 1
                ai = ai + 1
            } else {
                if a == "--" {
                    ai = ai + 1
                    parsing = 0
                } else {
                    parsing = 0
                }
            }
        }
    }
    if ai >= n {
        eprintln("usage: grebaga [-n] [-i] <pattern> [file...]")
        return 2
    }
    let pat = arg(ai)
    ai = ai + 1

    let mut total: i64 = 0
    let mut errors: i64 = 0

    if ai >= n {
        // stdin
        let st = gre_stream_fd(0)
        let h = gre_scan_print(st, "(stdin)", pat, fold, 0, show_num)?
        total = total + h
    } else {
        let multi: i64 = 0
        if ai + 1 < n {
            // more than one file — show paths always
            // count files
            let mut show_path: i64 = 1
            while ai < n {
                let path = arg(ai)
                let st = gre_stream_file(path)?
                if st.fd < 0 {
                    eprintln(concat("grebaga: cannot open ", path))
                    errors = errors + 1
                } else {
                    let h = gre_scan_print(st, path, pat, fold, show_path, show_num)?
                    total = total + h
                }
                ai = ai + 1
            }
        } else {
            let path = arg(ai)
            let st = gre_stream_file(path)?
            if st.fd < 0 {
                eprintln(concat("grebaga: cannot open ", path))
                return 2
            }
            let h = gre_scan_print(st, path, pat, fold, 0, show_num)?
            total = total + h
        }
    }

    if errors > 0 && total == 0 {
        return 2
    }
    if total == 0 {
        return 1
    }
    return 0
}
