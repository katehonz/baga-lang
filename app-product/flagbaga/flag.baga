// flag.baga — typed CLI flags from arg() (Track C7).
// Supports: --name value | --name=value | --flag (bool) | -p short
//           | -- end-of-flags | positionals | FlagDef usage (P1).

import "std/str/str.baga"

struct Flags {
    keys: Vec<str>,
    vals: Vec<str>,
    positionals: Vec<str>,
    ok: i64,
    err: str
}

// Optional schema for usage text and bool-aware parse (P1).
struct FlagDef {
    name: str,
    short: str,
    help: str,
    is_bool: i64
}

fn flag_def(name: str, short: str, help: str, is_bool: i64) -> FlagDef {
    return FlagDef { name: name, short: short, help: help, is_bool: is_bool }
}

fn flags_empty() -> Flags {
    return Flags {
        keys: vec_new(),
        vals: vec_new(),
        positionals: vec_new(),
        ok: 1,
        err: ""
    }
}

fn flags_set(f: Flags, k: str, v: str) -> Flags {
    // overwrite if present
    let mut i: i64 = 0
    while i < vec_len(f.keys) {
        if vec_get(f.keys, i) == k {
            vec_set(f.vals, i, v)
            return f
        }
        i = i + 1
    }
    vec_push(f.keys, k)
    vec_push(f.vals, v)
    return f
}

// Parse a single flag token: --name, --name=value, -p, -p=value, or -- (end).
struct FlagTok {
    is_flag: i64,    // 1 if starts with - or --
    is_end: i64,     // 1 if bare --
    name: str,
    has_eq: i64,     // 1 if name=value
    val: str,        // value after = or ""
    raw: str
}

fn flag_parse_tok(s: str) -> FlagTok {
    if len(s) >= 2 && char_at(s, 0) == 45 && char_at(s, 1) == 45 {
        if len(s) == 2 {
            return FlagTok {
                is_flag: 1,
                is_end: 1,
                name: "",
                has_eq: 0,
                val: "",
                raw: s
            }
        }
        let body = substr(s, 2, len(s))
        let eq = str_find(body, "=")
        if eq >= 0 {
            return FlagTok {
                is_flag: 1,
                is_end: 0,
                name: substr(body, 0, eq),
                has_eq: 1,
                val: substr(body, eq + 1, len(body)),
                raw: s
            }
        }
        return FlagTok {
            is_flag: 1,
            is_end: 0,
            name: body,
            has_eq: 0,
            val: "",
            raw: s
        }
    }
    if len(s) >= 2 && char_at(s, 0) == 45 {
        let body = substr(s, 1, len(s))
        let eq = str_find(body, "=")
        if eq >= 0 {
            return FlagTok {
                is_flag: 1,
                is_end: 0,
                name: substr(body, 0, eq),
                has_eq: 1,
                val: substr(body, eq + 1, len(body)),
                raw: s
            }
        }
        return FlagTok {
            is_flag: 1,
            is_end: 0,
            name: body,
            has_eq: 0,
            val: "",
            raw: s
        }
    }
    return FlagTok {
        is_flag: 0,
        is_end: 0,
        name: "",
        has_eq: 0,
        val: "",
        raw: s
    }
}

fn flags_lookup_def(defs: Vec<FlagDef>, name: str) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(defs) {
        let d = vec_get(defs, i)
        if d.name == name || (d.short != "" && d.short == name) {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn flags_canon(defs: Vec<FlagDef>, name: str) -> str {
    let i = flags_lookup_def(defs, name)
    if i < 0 {
        return name
    }
    return vec_get(defs, i).name
}

fn flags_known_bool(defs: Vec<FlagDef>, name: str) -> i64 {
    let i = flags_lookup_def(defs, name)
    if i < 0 {
        return 0
    }
    return vec_get(defs, i).is_bool
}

// Parse from process args (arg(0) is first user arg in baga).
fn flags_parse() -> Flags {
    let args = vec_new()
    let n = arg_count()
    let mut i: i64 = 0
    while i < n {
        vec_push(args, arg(i))
        i = i + 1
    }
    return flags_parse_vec(args)
}

// Parse from an explicit Vec<str> (tests / embedded).
// Valued: --k=v / -k=v or --k v / -k v. Bare --k / -k → "true".
// Bare `--` ends flags: everything after is positional (F2).
fn flags_parse_vec(args: Vec<str>) -> Flags {
    return flags_parse_defs(args, vec_new())
}

// Schema-aware parse: bool FlagDefs do not consume the next token;
// short names are canonicalized to the long name (F1).
fn flags_parse_defs(args: Vec<str>, defs: Vec<FlagDef>) -> Flags {
    let mut f = flags_empty()
    let n = vec_len(args)
    let mut i: i64 = 0
    let mut flags_on: i64 = 1
    while i < n {
        let a = vec_get(args, i)
        if flags_on == 0 {
            vec_push(f.positionals, a)
            i = i + 1
        } else {
            let t = flag_parse_tok(a)
            if t.is_end == 1 {
                flags_on = 0
                i = i + 1
            } else {
                if t.is_flag == 0 {
                    vec_push(f.positionals, a)
                    i = i + 1
                } else {
                    if t.name == "" {
                        f.ok = 0
                        f.err = "empty flag name"
                        return f
                    }
                    let name = flags_canon(defs, t.name)
                    if t.has_eq == 1 {
                        f = flags_set(f, name, t.val)
                        i = i + 1
                    } else {
                        if flags_known_bool(defs, t.name) == 1 {
                            f = flags_set(f, name, "true")
                            i = i + 1
                        } else {
                            if i + 1 < n {
                                let next = vec_get(args, i + 1)
                                let nt = flag_parse_tok(next)
                                if nt.is_flag == 0 && nt.is_end == 0 {
                                    f = flags_set(f, name, next)
                                    i = i + 2
                                } else {
                                    f = flags_set(f, name, "true")
                                    i = i + 1
                                }
                            } else {
                                f = flags_set(f, name, "true")
                                i = i + 1
                            }
                        }
                    }
                }
            }
        }
    }
    return f
}

fn flags_usage(prog: str, defs: Vec<FlagDef>) -> str {
    let mut out = concat(concat("usage: ", prog), " [flags] [args]\n")
    let mut i: i64 = 0
    while i < vec_len(defs) {
        let d = vec_get(defs, i)
        out = concat(out, "  ")
        if d.short != "" {
            out = concat(out, concat(concat("-", d.short), ", "))
        }
        out = concat(out, concat("--", d.name))
        if d.is_bool == 0 {
            out = concat(out, " VALUE")
        }
        if d.help != "" {
            out = concat(out, concat("  ", d.help))
        }
        out = concat(out, "\n")
        i = i + 1
    }
    return out
}

fn flags_has(f: Flags, name: str) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(f.keys) {
        if vec_get(f.keys, i) == name {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn flags_str(f: Flags, name: str, def: str) -> str {
    let mut i: i64 = 0
    while i < vec_len(f.keys) {
        if vec_get(f.keys, i) == name {
            return vec_get(f.vals, i)
        }
        i = i + 1
    }
    return def
}

fn flags_i64(f: Flags, name: str, def: i64) -> i64 {
    if flags_has(f, name) == 0 {
        return def
    }
    return parse_int(flags_str(f, name, "0"))
}

// true for "true"/"1"/"yes"/"on" (case-sensitive simple set).
fn flags_bool(f: Flags, name: str) -> i64 {
    if flags_has(f, name) == 0 {
        return 0
    }
    let v = flags_str(f, name, "")
    if v == "true" || v == "1" || v == "yes" || v == "on" || v == "" {
        return 1
    }
    if v == "false" || v == "0" || v == "no" || v == "off" {
        return 0
    }
    return 1
}

fn flags_positional(f: Flags, i: i64) -> str {
    if i < 0 || i >= vec_len(f.positionals) {
        return ""
    }
    return vec_get(f.positionals, i)
}

fn flags_n_positional(f: Flags) -> i64 {
    return vec_len(f.positionals)
}
