// flag.baga — typed CLI flags from arg() (Track C7).
// Supports: --name value | --name=value | --flag (bool) | positionals.

import "std/str/str.baga"

struct Flags {
    keys: Vec<str>,
    vals: Vec<str>,
    positionals: Vec<str>,
    ok: i64,
    err: str
}

fn flags_empty() -> Flags {
    return Flags {
        keys: vec_new(),
        vals: vec_new(),
        positionals: vec_new(),
        ok: 1,
        err: ""
    }
}

fn flags_set(f: Flags, k: str, v: str) -> Flags {
    // overwrite if present
    let mut i: i64 = 0
    while i < vec_len(f.keys) {
        if vec_get(f.keys, i) == k {
            vec_set(f.vals, i, v)
            return f
        }
        i = i + 1
    }
    vec_push(f.keys, k)
    vec_push(f.vals, v)
    return f
}

// Parse a single --name or --name=value token. Returns cell2(kind, …) via struct.
struct FlagTok {
    is_flag: i64,    // 1 if starts with --
    name: str,
    has_eq: i64,     // 1 if --name=value
    val: str,        // value after = or ""
    raw: str
}

fn flag_parse_tok(s: str) -> FlagTok {
    if len(s) >= 2 && char_at(s, 0) == 45 && char_at(s, 1) == 45 {
        // --...
        let body = substr(s, 2, len(s))
        let eq = str_find(body, "=")
        if eq >= 0 {
            return FlagTok {
                is_flag: 1,
                name: substr(body, 0, eq),
                has_eq: 1,
                val: substr(body, eq + 1, len(body)),
                raw: s
            }
        }
        return FlagTok {
            is_flag: 1,
            name: body,
            has_eq: 0,
            val: "",
            raw: s
        }
    }
    return FlagTok {
        is_flag: 0,
        name: "",
        has_eq: 0,
        val: "",
        raw: s
    }
}

// Parse from process args (skip program name — arg(0) is first user arg in baga).
fn flags_parse() -> Flags {
    let mut f = flags_empty()
    let n = arg_count()
    let mut i: i64 = 0
    while i < n {
        let a = arg(i)
        let t = flag_parse_tok(a)
        if t.is_flag == 0 {
            vec_push(f.positionals, a)
            i = i + 1
        } else {
            if t.name == "" {
                f.ok = 0
                f.err = "empty flag name"
                return f
            }
            if t.has_eq == 1 {
                f = flags_set(f, t.name, t.val)
                i = i + 1
            } else {
                // --name value (next non-flag) or bare --name → "true"
                if i + 1 < n {
                    let next = arg(i + 1)
                    let nt = flag_parse_tok(next)
                    if nt.is_flag == 0 {
                        f = flags_set(f, t.name, next)
                        i = i + 2
                    } else {
                        f = flags_set(f, t.name, "true")
                        i = i + 1
                    }
                } else {
                    f = flags_set(f, t.name, "true")
                    i = i + 1
                }
            }
        }
    }
    return f
}

// Parse from an explicit Vec<str> (tests / embedded).
// Valued: --k=v or --k v. Bare --k → "true". Positionals: non-flag tokens.
// Tip: put positionals before bool flags, or use --verbose=true.
fn flags_parse_vec(args: Vec<str>) -> Flags {
    let mut f = flags_empty()
    let n = vec_len(args)
    let mut i: i64 = 0
    while i < n {
        let a = vec_get(args, i)
        let t = flag_parse_tok(a)
        if t.is_flag == 0 {
            vec_push(f.positionals, a)
            i = i + 1
        } else {
            if t.name == "" {
                f.ok = 0
                f.err = "empty flag name"
                return f
            }
            if t.has_eq == 1 {
                f = flags_set(f, t.name, t.val)
                i = i + 1
            } else {
                if i + 1 < n {
                    let next = vec_get(args, i + 1)
                    let nt = flag_parse_tok(next)
                    if nt.is_flag == 0 {
                        f = flags_set(f, t.name, next)
                        i = i + 2
                    } else {
                        f = flags_set(f, t.name, "true")
                        i = i + 1
                    }
                } else {
                    f = flags_set(f, t.name, "true")
                    i = i + 1
                }
            }
        }
    }
    return f
}

fn flags_has(f: Flags, name: str) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(f.keys) {
        if vec_get(f.keys, i) == name {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn flags_str(f: Flags, name: str, def: str) -> str {
    let mut i: i64 = 0
    while i < vec_len(f.keys) {
        if vec_get(f.keys, i) == name {
            return vec_get(f.vals, i)
        }
        i = i + 1
    }
    return def
}

fn flags_i64(f: Flags, name: str, def: i64) -> i64 {
    if flags_has(f, name) == 0 {
        return def
    }
    return parse_int(flags_str(f, name, "0"))
}

// true for "true"/"1"/"yes"/"on" (case-sensitive simple set).
fn flags_bool(f: Flags, name: str) -> i64 {
    if flags_has(f, name) == 0 {
        return 0
    }
    let v = flags_str(f, name, "")
    if v == "true" || v == "1" || v == "yes" || v == "on" || v == "" {
        return 1
    }
    if v == "false" || v == "0" || v == "no" || v == "off" {
        return 0
    }
    return 1
}

fn flags_positional(f: Flags, i: i64) -> str {
    if i < 0 || i >= vec_len(f.positionals) {
        return ""
    }
    return vec_get(f.positionals, i)
}

fn flags_n_positional(f: Flags) -> i64 {
    return vec_len(f.positionals)
}
