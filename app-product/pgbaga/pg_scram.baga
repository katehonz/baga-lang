// pg_scram.baga — SCRAM-SHA-256 (RFC 5802 / 7677) for PostgreSQL SASL. Pure.
// Password is treated as UTF-8 bytes without full SASLprep (ASCII-safe;
// non-ASCII passwords may need Normalize — logged in gaps.md).
//
// Flow (after AuthenticationSASL lists SCRAM-SHA-256):
//   client-first  → server-first → client-final → server-final → AuthOk

import "../../std/crypto/hmac.baga"
import "../../std/crypto/sha256.baga"
import "../../std/bytes/bytes.baga"
import "../../std/str/str.baga"

// ---------- byte helpers ----------

fn scram_vec_xor(a: Vec<i64>, b: Vec<i64>) -> Vec<i64> {
    let out = vec_new()
    let n = vec_len(a)
    let mut i: i64 = 0
    while i < n {
        vec_push(out, (vec_get(a, i) ^ vec_get(b, i)) & 255)
        i = i + 1
    }
    return out
}

fn scram_hmac(key: Vec<i64>, msg: Vec<i64>) -> Vec<i64> {
    return vec_from_bytes(hmac_sha256_b(bytes_from_vec(key), bytes_from_vec(msg)))
}

fn scram_hmac_str(key: Vec<i64>, msg: str) -> Vec<i64> {
    return scram_hmac(key, bytes_from_str(msg))
}

fn scram_h(data: Vec<i64>) -> Vec<i64> {
    return sha256_bytes(data)
}

// PBKDF2-HMAC-SHA256, one 32-byte block (dkLen = hLen). INT(1) = 00 00 00 01.
fn pbkdf2_hmac_sha256(password: Vec<i64>, salt: Vec<i64>, iterations: i64) -> Vec<i64> {
    let mut msg = vec_new()
    let mut i: i64 = 0
    while i < vec_len(salt) {
        vec_push(msg, vec_get(salt, i))
        i = i + 1
    }
    vec_push(msg, 0)
    vec_push(msg, 0)
    vec_push(msg, 0)
    vec_push(msg, 1)
    let mut u = scram_hmac(password, msg)
    let mut out = vec_new()
    i = 0
    while i < vec_len(u) {
        vec_push(out, vec_get(u, i))
        i = i + 1
    }
    let mut round: i64 = 1
    while round < iterations {
        u = scram_hmac(password, u)
        // rebuild out = out XOR u (vectors are immutable-by-default)
        let mut next = vec_new()
        i = 0
        while i < vec_len(out) {
            vec_push(next, (vec_get(out, i) ^ vec_get(u, i)) & 255)
            i = i + 1
        }
        out = next
        round = round + 1
    }
    return out
}

// ---------- attribute parsing (comma-separated k=v) ----------

// Value of attribute `key` in a SCRAM message (e.g. key "r", "s", "i", "v").
// Returns "" if missing.
fn scram_attr(msg: str, key: str) -> str {
    let parts = str_split(msg, ",")
    let prefix = concat(key, "=")
    let plen = len(prefix)
    for i in 0..vec_len(parts) {
        let p = vec_get(parts, i)
        if len(p) >= plen {
            if substr(p, 0, plen) == prefix {
                return substr(p, plen, len(p))
            }
        }
    }
    return ""
}

// ---------- client messages ----------

// client-first-message-bare: n=,r=<nonce>  (empty user — PG uses StartupMessage user)
fn scram_client_first_bare(nonce: str) -> str {
    return concat("n=,r=", nonce)
}

// Full client-first with gs2-header n,, (no channel binding)
fn scram_client_first(nonce: str) -> str {
    return concat("n,,", scram_client_first_bare(nonce))
}

// c=biws is base64("n,,")
fn scram_cbind_input() -> str {
    return "biws"
}

// client-final-without-proof: c=biws,r=<server_nonce>
fn scram_client_final_without_proof(server_nonce: str) -> str {
    return concat(concat("c=", scram_cbind_input()), concat(",r=", server_nonce))
}

// Build ClientProof and full client-final message.
struct ScramFinal {
    message: str,     // client-final to send
    server_sig: str   // expected base64 ServerSignature (for verification)
}

fn scram_build_final(password: str, client_first_bare: str, server_first: str) -> ScramFinal {
    let snonce = scram_attr(server_first, "r")
    let salt_b64 = scram_attr(server_first, "s")
    let iter_s = scram_attr(server_first, "i")
    let iterations = parse_int(iter_s)
    if snonce == "" || salt_b64 == "" || iterations <= 0 {
        return ScramFinal { message: "", server_sig: "" }
    }
    let salt = base64_decode(salt_b64)
    let pw = bytes_from_str(password)
    let salted = pbkdf2_hmac_sha256(pw, salt, iterations)
    let client_key = scram_hmac_str(salted, "Client Key")
    let stored_key = scram_h(client_key)
    let cfwp = scram_client_final_without_proof(snonce)
    let auth_msg = concat(concat(concat(concat(client_first_bare, ","), server_first), ","), cfwp)
    let client_sig = scram_hmac_str(stored_key, auth_msg)
    let client_proof = scram_vec_xor(client_key, client_sig)
    let proof_b64 = base64_encode(client_proof)
    let message = concat(concat(cfwp, ",p="), proof_b64)
    let server_key = scram_hmac_str(salted, "Server Key")
    let server_sig = base64_encode(scram_hmac_str(server_key, auth_msg))
    return ScramFinal { message: message, server_sig: server_sig }
}

// server-final is "v=<base64>" or "e=<error>"
fn scram_check_server_final(server_final: str, expected_sig_b64: str) -> i64 {
    let err = scram_attr(server_final, "e")
    if err != "" {
        return 0
    }
    let v = scram_attr(server_final, "v")
    if v == "" {
        return 0
    }
    if v == expected_sig_b64 {
        return 1
    }
    return 0
}

// Encode a random-byte nonce as base64 (no strip — standard alphabet is fine).
fn scram_nonce_from_bytes(raw: Vec<i64>) -> str {
    // drop padding for a cleaner nonce (still valid as printable SCRAM nonce)
    let s = base64_encode(raw)
    let mut out = ""
    for i in 0..len(s) {
        let c = char_at(s, i)
        if c != 61 {
            out = concat(out, chr(c))
        }
    }
    return out
}
