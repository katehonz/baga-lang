// wire/proto.baga — PostgreSQL frontend/backend protocol v3 framing (pure).
// Message formats: https://www.postgresql.org/docs/current/protocol-message-formats.html
// All multi-byte integers are network (big-endian). Regular messages are
//   Byte1(type) + Int32(len including self) + payload(len-4)
// StartupMessage / CancelRequest / SSLRequest have no type byte.

import "std/bytes/bytes.baga"
import "std/str/str.baga"

// ---------- endian / single-byte helpers ----------

fn pg_one(v: i64) -> bytes {
    let v2 = vec_new()
    vec_push(v2, v & 255)
    return bytes_from_vec(v2)
}

fn pg_be16(v: i64) -> bytes {
    let v2 = vec_new()
    vec_push(v2, (v >> 8) & 255)
    vec_push(v2, v & 255)
    return bytes_from_vec(v2)
}

fn pg_be32(v: i64) -> bytes {
    let v2 = vec_new()
    vec_push(v2, (v >> 24) & 255)
    vec_push(v2, (v >> 16) & 255)
    vec_push(v2, (v >> 8) & 255)
    vec_push(v2, v & 255)
    return bytes_from_vec(v2)
}

// Read a big-endian integer of `n` bytes starting at `off`.
fn pg_be_read(b: bytes, off: i64, n: i64) -> i64 {
    let mut v: i64 = 0
    let mut i: i64 = 0
    while i < n {
        v = v * 256 + (bytes_at(b, off + i) & 255)
        i = i + 1
    }
    return v
}

// Signed i32 from 4 big-endian bytes (needed for column lengths: -1 = NULL).
fn pg_i32_be(b: bytes, off: i64) -> i64 {
    let u = pg_be_read(b, off, 4)
    if u >= 2147483648 {
        return u - 4294967296
    }
    return u
}

fn pg_empty() -> bytes {
    return bytes_from_vec(vec_new())
}

// C-string: text bytes + NUL.
fn pg_cstr(s: str) -> bytes {
    return bytes_concat(bytes_of_str(s), pg_one(0))
}

// Append key\0 value\0 to body.
fn pg_kv(body: bytes, key: str, val: str) -> bytes {
    let mut b = body
    b = bytes_concat(b, pg_cstr(key))
    b = bytes_concat(b, pg_cstr(val))
    return b
}

// ---------- message builders ----------

// Regular frontend message: type + length + body.
fn pg_msg(typ: i64, body: bytes) -> bytes {
    let ln = 4 + bytes_len(body)
    return bytes_concat(pg_one(typ), bytes_concat(pg_be32(ln), body))
}

// StartupMessage (no type byte). Protocol 3.0 = 196608.
// user is required; database may be "" (server default = user).
fn pg_startup(user: str, database: str) -> bytes {
    let mut body = pg_be32(196608)
    body = pg_kv(body, "user", user)
    if database != "" {
        body = pg_kv(body, "database", database)
    }
    body = pg_kv(body, "client_encoding", "UTF8")
    body = pg_kv(body, "application_name", "pgbaga")
    body = bytes_concat(body, pg_one(0))
    let ln = 4 + bytes_len(body)
    return bytes_concat(pg_be32(ln), body)
}

// PasswordMessage / SASL response shell: 'p' + body.
fn pg_password_msg(payload: bytes) -> bytes {
    return pg_msg(112, payload)   // 'p' = 112
}

// Cleartext password: password string + NUL.
fn pg_cleartext_password(password: str) -> bytes {
    return pg_password_msg(pg_cstr(password))
}

// SASLInitialResponse: mechanism\0 + Int32(len) + initial response bytes.
fn pg_sasl_initial(mech: str, initial: bytes) -> bytes {
    let mut body = pg_cstr(mech)
    body = bytes_concat(body, pg_be32(bytes_len(initial)))
    body = bytes_concat(body, initial)
    return pg_password_msg(body)
}

// SASLResponse (subsequent): raw mechanism data.
fn pg_sasl_response(data: bytes) -> bytes {
    return pg_password_msg(data)
}

// Simple Query: 'Q' + query\0
fn pg_query_msg(sql: str) -> bytes {
    return pg_msg(81, pg_cstr(sql))   // 'Q' = 81
}

// Terminate: 'X' + empty
fn pg_terminate_msg() -> bytes {
    return pg_msg(88, pg_empty())     // 'X' = 88
}

// Sync: 'S' (extended protocol resync point after Parse/Bind/Execute).
fn pg_sync_msg() -> bytes {
    return pg_msg(83, pg_empty())     // 'S' = 83
}

// CancelRequest (no type byte, sent on a FRESH connection):
// Int32(16) + Int32(80877102) + pid + 4-byte secret key from BackendKeyData.
fn pg_cancel_msg(pid: i64, key: bytes) -> bytes {
    let mut b = pg_be32(16)
    b = bytes_concat(b, pg_be32(80877102))
    b = bytes_concat(b, pg_be32(pid))
    if bytes_len(key) >= 4 {
        b = bytes_concat(b, bytes_slice(key, 0, 4))
    }
    return b
}

// ---------- Extended Query (parameterized $1..$n) ----------

// Parse: 'P' + dest_stmt\0 + query\0 + Int16(nparams) + Int32 type_oids (0 = unspecified).
// Empty dest_stmt = unnamed prepared statement.
fn pg_parse_msg(stmt_name: str, sql: str, nparams: i64) -> bytes {
    let mut body = pg_cstr(stmt_name)
    body = bytes_concat(body, pg_cstr(sql))
    body = bytes_concat(body, pg_be16(nparams))
    let mut i: i64 = 0
    while i < nparams {
        body = bytes_concat(body, pg_be32(0))   // unspecified type OID
        i = i + 1
    }
    return pg_msg(80, body)   // 'P' = 80
}

// Bind: 'B' + portal\0 + stmt\0 + formats + values (text) + result formats.
// vals/nulls parallel; nulls[i]==1 → NULL parameter (no value bytes).
// All parameters and results use text format (code 0).
fn pg_bind_msg(portal: str, stmt_name: str, vals: Vec<str>, nulls: Vec<i64>) -> bytes {
    let n = vec_len(vals)
    let mut body = pg_cstr(portal)
    body = bytes_concat(body, pg_cstr(stmt_name))
    // parameter format codes: 0 codes → all text default
    body = bytes_concat(body, pg_be16(0))
    body = bytes_concat(body, pg_be16(n))
    let mut i: i64 = 0
    while i < n {
        if i < vec_len(nulls) {
            if vec_get(nulls, i) == 1 {
                // Int32(-1) = NULL
                body = bytes_concat(body, pg_be32(4294967295))
            } else {
                let v = bytes_of_str(vec_get(vals, i))
                body = bytes_concat(body, pg_be32(bytes_len(v)))
                body = bytes_concat(body, v)
            }
        } else {
            let v = bytes_of_str(vec_get(vals, i))
            body = bytes_concat(body, pg_be32(bytes_len(v)))
            body = bytes_concat(body, v)
        }
        i = i + 1
    }
    // result format codes: 0 → all text
    body = bytes_concat(body, pg_be16(0))
    return pg_msg(66, body)   // 'B' = 66
}

// Describe portal: 'D' + 'P' + portal\0  → RowDescription or NoData
fn pg_describe_portal_msg(portal: str) -> bytes {
    let mut body = pg_one(80)   // 'P'
    body = bytes_concat(body, pg_cstr(portal))
    return pg_msg(68, body)     // 'D' = 68
}

// Describe statement: 'D' + 'S' + stmt\0
fn pg_describe_stmt_msg(stmt_name: str) -> bytes {
    let mut body = pg_one(83)   // 'S'
    body = bytes_concat(body, pg_cstr(stmt_name))
    return pg_msg(68, body)
}

// Execute: 'E' + portal\0 + Int32 max_rows (0 = all)
fn pg_execute_msg(portal: str, max_rows: i64) -> bytes {
    let mut body = pg_cstr(portal)
    body = bytes_concat(body, pg_be32(max_rows))
    return pg_msg(69, body)     // 'E' = 69
}

// Close statement or portal: 'C' + 'S'|'P' + name\0
fn pg_close_msg(kind: i64, name: str) -> bytes {
    let mut body = pg_one(kind)
    body = bytes_concat(body, pg_cstr(name))
    return pg_msg(67, body)     // 'C' = 67  (Close frontend)
}

// Flush: 'H'
fn pg_flush_msg() -> bytes {
    return pg_msg(72, pg_empty())  // 'H' = 72
}

// ---------- parsing helpers ----------

// Find first NUL at or after `off`; -1 if none.
fn pg_find_nul(b: bytes, off: i64) -> i64 {
    let n = bytes_len(b)
    let mut i = off
    while i < n {
        if bytes_at(b, i) == 0 {
            return i
        }
        i = i + 1
    }
    return -1
}

// C-string at `off` as str (bytes until NUL). "" if missing.
fn pg_get_cstr(b: bytes, off: i64) -> str {
    let end = pg_find_nul(b, off)
    if end < 0 {
        if off >= bytes_len(b) {
            return ""
        }
        return str_of_bytes(bytes_slice(b, off, bytes_len(b)))
    }
    if end <= off {
        return ""
    }
    return str_of_bytes(bytes_slice(b, off, end))
}

// Length of a C-string field including the NUL (or remaining bytes).
fn pg_cstr_span(b: bytes, off: i64) -> i64 {
    let end = pg_find_nul(b, off)
    if end < 0 {
        return bytes_len(b) - off
    }
    return end - off + 1
}

// ---------- type OIDs (pg_type.dat, stable across supported versions) ----------

fn pg_oid_bool() -> i64 { return 16 }
fn pg_oid_int8() -> i64 { return 20 }
fn pg_oid_text() -> i64 { return 25 }
fn pg_oid_json() -> i64 { return 114 }
fn pg_oid_json_array() -> i64 { return 199 }
fn pg_oid_float8() -> i64 { return 701 }
fn pg_oid_timestamptz() -> i64 { return 1184 }
fn pg_oid_jsonb() -> i64 { return 3802 }
fn pg_oid_jsonb_array() -> i64 { return 3807 }

// ---------- decoded backend message ----------

struct PgMsg {
    typ: i64,      // ASCII type code, 0 = error/empty
    body: bytes
}

// Auth subtype from 'R' body: first Int32. 0=Ok, 3=Cleartext, 5=MD5, 10=SASL, 11=Continue, 12=Final
fn pg_auth_kind(body: bytes) -> i64 {
    if bytes_len(body) < 4 {
        return -1
    }
    return pg_be_read(body, 0, 4)
}

// SASL mechanism list from AuthenticationSASL body (after the Int32 kind).
// Returns mechanisms joined by "," for simple scanning.
fn pg_auth_sasl_mechs(body: bytes) -> str {
    if bytes_len(body) < 4 {
        return ""
    }
    let mut off: i64 = 4
    let mut out = ""
    while off < bytes_len(body) {
        if bytes_at(body, off) == 0 {
            break
        }
        let m = pg_get_cstr(body, off)
        if out != "" {
            out = concat(out, ",")
        }
        out = concat(out, m)
        off = off + pg_cstr_span(body, off)
    }
    return out
}

// Bytes after the auth Int32 (SASL continue/final payload, MD5 salt, …).
fn pg_auth_payload(body: bytes) -> bytes {
    if bytes_len(body) <= 4 {
        return pg_empty()
    }
    return bytes_slice(body, 4, bytes_len(body))
}

// Error/Notice field map: walk Byte1 + String pairs until 0.
// Returns severity|code|message as "SEV|SQLSTATE|message" (best effort).
fn pg_error_fields(body: bytes) -> str {
    let mut sev = ""
    let mut code = ""
    let mut msg = ""
    let mut off: i64 = 0
    while off < bytes_len(body) {
        let tag = bytes_at(body, off)
        if tag == 0 {
            break
        }
        off = off + 1
        let val = pg_get_cstr(body, off)
        off = off + pg_cstr_span(body, off)
        if tag == 83 || tag == 86 {   // 'S' severity or 'V' severity non-localized
            if sev == "" {
                sev = val
            }
        }
        if tag == 67 {                // 'C' SQLSTATE
            code = val
        }
        if tag == 77 {                // 'M' message
            msg = val
        }
    }
    return concat(concat(concat(concat(sev, "|"), code), "|"), msg)
}

// RowDescription column count (Int16 at start of 'T' body).
fn pg_rowdesc_ncols(body: bytes) -> i64 {
    if bytes_len(body) < 2 {
        return 0
    }
    return pg_be_read(body, 0, 2)
}

// Parse RowDescription into parallel vectors (names, type OIDs).
// Returns via out-params pattern: caller passes empty vecs we fill? Baga has
// no out-params — return a packed struct.
struct PgRowDesc {
    names: Vec<str>,
    type_oids: Vec<i64>
}

fn pg_parse_rowdesc(body: bytes) -> PgRowDesc {
    let names = vec_new()
    let oids = vec_new()
    if bytes_len(body) < 2 {
        return PgRowDesc { names: names, type_oids: oids }
    }
    let ncols = pg_be_read(body, 0, 2)
    let mut off: i64 = 2
    let mut i: i64 = 0
    while i < ncols {
        if off >= bytes_len(body) {
            break
        }
        let name = pg_get_cstr(body, off)
        off = off + pg_cstr_span(body, off)
        // table_oid i32, col_attr i16, type_oid i32, typlen i16, typmod i32, format i16
        if off + 18 > bytes_len(body) {
            break
        }
        // skip table_oid (4) + attr (2)
        let type_oid = pg_be_read(body, off + 6, 4)
        off = off + 18
        vec_push(names, name)
        vec_push(oids, type_oid)
        i = i + 1
    }
    return PgRowDesc { names: names, type_oids: oids }
}

// One DataRow → cell strings + null flags (1 = NULL).
struct PgDataRow {
    cells: Vec<str>,
    nulls: Vec<i64>
}

fn pg_parse_datarow(body: bytes) -> PgDataRow {
    let cells = vec_new()
    let nulls = vec_new()
    if bytes_len(body) < 2 {
        return PgDataRow { cells: cells, nulls: nulls }
    }
    let ncols = pg_be_read(body, 0, 2)
    let mut off: i64 = 2
    let mut i: i64 = 0
    while i < ncols {
        if off + 4 > bytes_len(body) {
            break
        }
        let clen = pg_i32_be(body, off)
        off = off + 4
        if clen < 0 {
            vec_push(cells, "")
            vec_push(nulls, 1)
        } else {
            if off + clen > bytes_len(body) {
                break
            }
            if clen == 0 {
                vec_push(cells, "")
            } else {
                vec_push(cells, str_of_bytes(bytes_slice(body, off, off + clen)))
            }
            vec_push(nulls, 0)
            off = off + clen
        }
        i = i + 1
    }
    return PgDataRow { cells: cells, nulls: nulls }
}

// CommandComplete tag string from 'C' body.
fn pg_command_tag(body: bytes) -> str {
    return pg_get_cstr(body, 0)
}

// ReadyForQuery transaction status: 'I'/'T'/'E' as i64 codepoint.
fn pg_ready_status(body: bytes) -> i64 {
    if bytes_len(body) < 1 {
        return 0
    }
    return bytes_at(body, 0)
}

// BackendKeyData: pid (i32) + secret (rest; historically 4 bytes).
struct PgBackendKey {
    pid: i64,
    key: bytes
}

fn pg_parse_backend_key(body: bytes) -> PgBackendKey {
    if bytes_len(body) < 4 {
        return PgBackendKey { pid: 0, key: pg_empty() }
    }
    let pid = pg_be_read(body, 0, 4)
    let key = bytes_slice(body, 4, bytes_len(body))
    return PgBackendKey { pid: pid, key: key }
}

// ParameterStatus: name\0 value\0
struct PgParamStatus {
    name: str,
    value: str
}

fn pg_parse_param_status(body: bytes) -> PgParamStatus {
    let name = pg_get_cstr(body, 0)
    let off = pg_cstr_span(body, 0)
    let value = pg_get_cstr(body, off)
    return PgParamStatus { name: name, value: value }
}
