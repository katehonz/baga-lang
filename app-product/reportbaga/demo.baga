// demo.baga — report CLI
//   html-xlsx|html-csv|html-pdf|html-html  in.html out
//   csv-xlsx in.csv out.xlsx
//   data-xlsx|data-pdf|data-html  out   (built-in sample oborotna data)

import "report.baga"
import "csvbaga/csv.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn sample_table() -> CsvTable {
    let tsv = "Сметка\tНаименование\tНД\tНК\tОД\tОК\tКД\tКК\n401\tДоставчици\t0.00\t1200.00\t500.00\t300.00\t0.00\t1000.00\n503\tРазплащателна сметка\t5000.00\t0.00\t2000.00\t1500.00\t5500.00\t0.00\n\tОбщо\t5000.00\t1200.00\t2500.00\t1800.00\t5500.00\t1000.00"
    return csv_from_tsv(tsv)
}

fn main() -> i64 !IO {
    if arg_count() < 1 {
        eprintln("usage: demo.baga html-xlsx|html-csv|html-pdf|html-html <in.html> <out>")
        eprintln("       demo.baga csv-xlsx <in.csv> <out.xlsx>")
        eprintln("       demo.baga data-xlsx|data-pdf|data-html <out>")
        eprintln("       demo.baga tpl-html|tpl-xlsx|tpl-pdf <out>   (template + sample data)")
        return 1
    }
    let cmd = arg(0)

    if cmd == "html-xlsx" || cmd == "html-csv" || cmd == "html-pdf" || cmd == "html-html" {
        if arg_count() < 3 {
            eprintln("need in.html out")
            return 1
        }
        let html = str_of_bytes(read_file_bytes(arg(1))?)
        let mut fmt = "xlsx"
        if cmd == "html-csv" { fmt = "csv" }
        if cmd == "html-pdf" { fmt = "pdf" }
        if cmd == "html-html" { fmt = "html" }
        let out = report_from_html_io(html, fmt)?
        if out.ok == 0 {
            eprintln(out.err)
            return 1
        }
        if report_write_path(arg(2), out)? != 0 {
            eprintln("write failed")
            return 2
        }
        print(concat("wrote ", arg(2)))
        return 0
    }

    if cmd == "csv-xlsx" {
        if arg_count() < 3 {
            eprintln("need in.csv out.xlsx")
            return 1
        }
        let t = csv_read_path(arg(1))?
        let out = report_csv_to_xlsx(t)
        if out.ok == 0 {
            eprintln(out.err)
            return 1
        }
        if report_write_path(arg(2), out)? != 0 {
            return 2
        }
        print(concat("wrote ", arg(2)))
        return 0
    }

    if cmd == "data-xlsx" || cmd == "data-pdf" || cmd == "data-html" {
        if arg_count() < 2 {
            eprintln("need out path")
            return 1
        }
        let t = sample_table()
        let mut fmt = "xlsx"
        if cmd == "data-pdf" { fmt = "pdf" }
        if cmd == "data-html" { fmt = "html" }
        let out = report_from_table_io("Оборотно-салдова ведомост", "2026-01-01 — 2026-01-31 · Демо ООД", t, fmt)?
        if out.ok == 0 {
            eprintln(out.err)
            return 1
        }
        if report_write_path(arg(1), out)? != 0 {
            return 2
        }
        print(concat("wrote ", arg(1)))
        return 0
    }

    if cmd == "tpl-html" || cmd == "tpl-xlsx" || cmd == "tpl-pdf" {
        if arg_count() < 2 {
            eprintln("need out path")
            return 1
        }
        let tpl = str_of_bytes(read_file_bytes("app-product/reportbaga/fixtures/oborotna.tpl.html")?)
        let mut use_tpl = tpl
        if tpl == "" {
            use_tpl = report_default_tpl()
        }
        let ctx: Map<str, str> = map_new()
        map_set(ctx, "title", "Оборотно-салдова ведомост")
        map_set(ctx, "period", "2026-01-01 — 2026-01-31")
        map_set(ctx, "firm", "Демо ООД")
        let t = sample_table()
        let mut fmt = "html"
        if cmd == "tpl-xlsx" { fmt = "xlsx" }
        if cmd == "tpl-pdf" { fmt = "pdf" }
        let out = report_from_template_io(use_tpl, ctx, t, fmt)?
        if out.ok == 0 {
            eprintln(out.err)
            return 1
        }
        if report_write_path(arg(1), out)? != 0 {
            return 2
        }
        print(concat("wrote ", arg(1)))
        return 0
    }

    eprintln("unknown command")
    return 1
}
