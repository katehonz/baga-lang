// report.baga — accounting reports: data/HTML → XLSX | CSV | PDF | HTML preview.
// Path: DB rows / CSV → ReportIR → Excel+PDF (UTF-8); optional tplbaga shell.

import "csvbaga/csv.baga"
import "officebaga/xlsx/write.baga"
import "pdfbaga/pdf.baga"
import "tplbaga/tpl.baga"
import "html_table.baga"
import "ir.baga"
import "std/str/str.baga"
import "std/os/os.baga"

struct ReportOut {
    ok: i64,
    err: str,
    data: bytes,
    format: str
}

fn report_version() -> str {
    return "0.3.1"
}

fn report_fail(msg: str) -> ReportOut {
    return ReportOut { ok: 0, err: msg, data: bytes_new(0), format: "" }
}

fn report_ok(data: bytes, format: str) -> ReportOut {
    return ReportOut { ok: 1, err: "", data: data, format: format }
}

// ---------- emit from ReportIR ----------

fn report_sheet_name(title: str) -> str {
    let mut name = title
    if name == "" {
        name = "Отчет"
    }
    if len(name) > 31 {
        name = substr(name, 0, 31)
    }
    return name
}

fn report_ir_to_xlsx(ir: ReportIR) -> ReportOut {
    if ir.ok == 0 {
        return report_fail(ir.err)
    }
    let lines = csv_to_row_lines(ir.table)
    if vec_len(lines) == 0 {
        return report_fail("report: empty table")
    }
    // Freeze header row; sheet tab = report title (accounting UX)
    return report_ok(xlsx_create_bytes_opts(lines, report_sheet_name(ir.title), 1), "xlsx")
}

fn report_ir_to_csv(ir: ReportIR) -> ReportOut {
    if ir.ok == 0 {
        return report_fail(ir.err)
    }
    return report_ok(bytes_of_str(csv_stringify(ir.table)), "csv")
}

fn report_ir_to_html_bytes(ir: ReportIR) -> ReportOut {
    if ir.ok == 0 {
        return report_fail(ir.err)
    }
    let h = report_ir_to_html(ir.title, ir.meta, ir.table)
    return report_ok(bytes_of_str(h), "html")
}

fn report_ir_to_pdf_font(ir: ReportIR, font_path: str) -> ReportOut !IO {
    if ir.ok == 0 {
        return report_fail(ir.err)
    }
    let lines = csv_to_row_lines(ir.table)
    let mut ttl = ir.title
    if ir.meta != "" {
        ttl = concat(concat(ir.title, " — "), ir.meta)
    }
    let r = pdf_from_table_file(font_path, ttl, lines)?
    if r.ok == 0 {
        return report_fail(r.err)
    }
    return report_ok(r.data, "pdf")
}

fn report_ir_to_pdf(ir: ReportIR) -> ReportOut !IO {
    return report_ir_to_pdf_font(ir, pdf_default_font_path())?
}

fn report_emit(ir: ReportIR, format: str) -> ReportOut {
    if format == "xlsx" {
        return report_ir_to_xlsx(ir)
    }
    if format == "csv" {
        return report_ir_to_csv(ir)
    }
    if format == "html" {
        return report_ir_to_html_bytes(ir)
    }
    return report_fail(concat("report: use report_emit_io for ", format))
}

fn report_emit_io(ir: ReportIR, format: str) -> ReportOut !IO {
    if format == "pdf" {
        return report_ir_to_pdf(ir)?
    }
    return report_emit(ir, format)
}

// ---------- from HTML / CSV / table ----------

fn report_csv_to_xlsx(t: CsvTable) -> ReportOut {
    return report_ir_to_xlsx(report_ir_from_table("Sheet", "", t))
}

fn report_csv_text_to_xlsx(csv_src: str) -> ReportOut {
    return report_csv_to_xlsx(csv_parse(csv_src))
}

fn report_html_to_xlsx(html: str) -> ReportOut {
    return report_ir_to_xlsx(report_ir_from_html(html))
}

fn report_html_to_csv(html: str) -> ReportOut {
    return report_ir_to_csv(report_ir_from_html(html))
}

fn report_html_to_pdf_font(html: str, font_path: str) -> ReportOut !IO {
    return report_ir_to_pdf_font(report_ir_from_html(html), font_path)?
}

fn report_html_to_pdf(html: str) -> ReportOut !IO {
    return report_html_to_pdf_font(html, pdf_default_font_path())?
}

fn report_csv_to_pdf(t: CsvTable, title: str) -> ReportOut !IO {
    return report_ir_to_pdf(report_ir_from_table(title, "", t))?
}

// App path: title + meta + table (from DB) → any format
fn report_from_table(title: str, meta: str, table: CsvTable, format: str) -> ReportOut {
    return report_emit(report_ir_from_table(title, meta, table), format)
}

fn report_from_table_io(title: str, meta: str, table: CsvTable, format: str) -> ReportOut !IO {
    return report_emit_io(report_ir_from_table(title, meta, table), format)?
}

fn report_from_html(html: str, format: str) -> ReportOut {
    return report_emit(report_ir_from_html(html), format)
}

fn report_from_html_io(html: str, format: str) -> ReportOut !IO {
    return report_emit_io(report_ir_from_html(html), format)?
}

// ---------- tplbaga: shell with {{title}} {{period}} {{firm}} {{{table}}} ----------

// Build table HTML + fill template. Context keys used by default template:
// title, period, firm — plus table injected as {{{table}}}.
fn report_from_template(tpl: str, ctx: Map<str, str>, table: CsvTable, format: str) -> ReportOut {
    if table.ok == 0 {
        return report_fail(table.err)
    }
    let th = report_table_to_html(table)
    map_set(ctx, "table", th)
    let tr = tpl_render(tpl, ctx)
    if tr.ok == 0 {
        return report_fail(tr.err)
    }
    // Prefer IR from data (accurate numbers) over re-parse HTML
    let mut title = ""
    let mut meta = ""
    if map_has(ctx, "title") == 1 {
        title = map_get(ctx, "title")
    }
    if map_has(ctx, "period") == 1 {
        meta = map_get(ctx, "period")
    }
    if map_has(ctx, "firm") == 1 {
        if meta != "" {
            meta = concat(concat(meta, " · "), map_get(ctx, "firm"))
        } else {
            meta = map_get(ctx, "firm")
        }
    }
    if title == "" {
        title = "Report"
    }
    if format == "html" {
        // return rendered template (browser preview)
        return report_ok(bytes_of_str(tr.html), "html")
    }
    return report_emit(report_ir_from_table(title, meta, table), format)
}

fn report_from_template_io(tpl: str, ctx: Map<str, str>, table: CsvTable, format: str) -> ReportOut !IO {
    if format == "pdf" {
        let out = report_from_template(tpl, ctx, table, "xlsx")
        // rebuild IR for pdf
        if table.ok == 0 {
            return report_fail(table.err)
        }
        let mut title = "Report"
        let mut meta = ""
        if map_has(ctx, "title") == 1 {
            title = map_get(ctx, "title")
        }
        if map_has(ctx, "period") == 1 {
            meta = map_get(ctx, "period")
        }
        if map_has(ctx, "firm") == 1 {
            if meta != "" {
                meta = concat(concat(meta, " · "), map_get(ctx, "firm"))
            } else {
                meta = map_get(ctx, "firm")
            }
        }
        return report_ir_to_pdf(report_ir_from_table(title, meta, table))?
    }
    return report_from_template(tpl, ctx, table, format)
}

fn report_write_path(path: str, out: ReportOut) -> i64 !IO {
    if out.ok == 0 {
        return -1
    }
    return write_file_bytes(path, out.data)?
}

// Default accounting XHTML shell for tplbaga
fn report_default_tpl() -> str {
    return "<?xml version=\"1.0\" encoding=\"UTF-8\"?><html xmlns=\"http://www.w3.org/1999/xhtml\"><head><meta charset=\"utf-8\"/><title>{{ title }}</title><style type=\"text/css\">body{font-family:sans-serif}table{border-collapse:collapse;width:100%}th,td{border:1px solid #333;padding:4px 8px;text-align:left}th{background:#eee}</style></head><body><h1>{{ title }}</h1><p>Период: {{ period }} · Фирма: {{ firm }}</p>{{{ table }}}</body></html>"
}
