// otel.baga — W3C Trace Context + OTLP/JSON span export lite (C8).
// Parses/generates `traceparent`; builds OTLP JSON batches; optional
// HTTP POST / file sink. No full SDK / metrics / logs pipeline.

import "std/str/str.baga"
import "std/random/random.baga"
import "std/os/os.baga"
import "std/net/http_client.baga"
import "std/json/json.baga"
import "std/json/json_write.baga"
import "std/json/json_strict.baga"
import "std/time/time.baga"

// version-traceid-spanid-flags  (hex, lowercase preferred)
// 00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01

struct TraceCtx {
    ok: i64,
    version: str,
    trace_id: str,   // 32 hex
    span_id: str,    // 16 hex
    flags: str       // 2 hex
}

fn otel_empty() -> TraceCtx {
    return TraceCtx {
        ok: 0, version: "00", trace_id: "", span_id: "", flags: "00"
    }
}

fn otel_is_hex(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return 1 }   // 0-9
    if c >= 97 && c <= 102 { return 1 }  // a-f
    if c >= 65 && c <= 70 { return 1 }   // A-F
    return 0
}

fn otel_hex_ok(s: str, n: i64) -> i64 {
    if len(s) != n {
        return 0
    }
    for i in 0..n {
        if otel_is_hex(char_at(s, i)) == 0 {
            return 0
        }
    }
    return 1
}

fn otel_to_lower_hex(s: str) -> str {
    let mut out = ""
    for i in 0..len(s) {
        let mut c = char_at(s, i)
        if c >= 65 && c <= 70 {
            c = c + 32
        }
        out = concat(out, chr(c))
    }
    return out
}

// Parse W3C traceparent. Returns ok=0 on malformed.
fn otel_parse_traceparent(s: str) -> TraceCtx {
    let parts = str_split(s, "-")
    if vec_len(parts) != 4 {
        return otel_empty()
    }
    let ver = vec_get(parts, 0)
    let tid = otel_to_lower_hex(vec_get(parts, 1))
    let sid = otel_to_lower_hex(vec_get(parts, 2))
    let fl = otel_to_lower_hex(vec_get(parts, 3))
    if len(ver) != 2 || otel_hex_ok(tid, 32) == 0 || otel_hex_ok(sid, 16) == 0 ||
       otel_hex_ok(fl, 2) == 0 {
        return otel_empty()
    }
    // all-zero trace/span invalid per W3C
    if tid == str_repeat("0", 32) || sid == str_repeat("0", 16) {
        return otel_empty()
    }
    return TraceCtx {
        ok: 1, version: ver, trace_id: tid, span_id: sid, flags: fl
    }
}

fn otel_format(t: TraceCtx) -> str {
    if t.ok == 0 {
        return ""
    }
    return concat(concat(concat(concat(concat(concat(t.version, "-"), t.trace_id), "-"),
        t.span_id), "-"), t.flags)
}

// Hex from random_bytes (Vec 0..255).
fn otel_hex_of(b: Vec<i64>) -> str {
    return hex_encode(bytes_from_vec(b))
}

fn otel_new_trace() -> TraceCtx !Random {
    let tid = otel_hex_of(random_bytes(16)?)
    let sid = otel_hex_of(random_bytes(8)?)
    // force non-zero (extremely unlikely zeros)
    let mut t = tid
    let mut s = sid
    if t == str_repeat("0", 32) {
        t = "4bf92f3577b34da6a3ce929d0e0e4736"
    }
    if s == str_repeat("0", 16) {
        s = "00f067aa0ba902b7"
    }
    return TraceCtx {
        ok: 1, version: "00", trace_id: t, span_id: s, flags: "01"
    }
}

// Child span: same trace_id, new span_id, sampled if parent was.
fn otel_child(parent: TraceCtx) -> TraceCtx !Random {
    if parent.ok == 0 {
        return otel_new_trace()?
    }
    let sid = otel_hex_of(random_bytes(8)?)
    let mut s = sid
    if s == str_repeat("0", 16) {
        s = "00f067aa0ba902b7"
    }
    return TraceCtx {
        ok: 1,
        version: parent.version,
        trace_id: parent.trace_id,
        span_id: s,
        flags: parent.flags
    }
}

// Extract from HTTP header value (or empty → new root).
fn otel_from_header(h: str) -> TraceCtx !Random {
    if h == "" {
        return otel_new_trace()?
    }
    let t = otel_parse_traceparent(h)
    if t.ok == 1 {
        return otel_child(t)?
    }
    return otel_new_trace()?
}

// Header name (canonical).
fn otel_header_name() -> str {
    return "traceparent"
}

// ---------- OTLP/JSON spans (export lite) ----------
// OTLP protobuf-JSON maps bytes to base64; we also emit hex in attributes
// for human debugging. Collector-compatible path uses base64 ids.

fn otel_b64_table() -> str {
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
}

fn otel_hex_nibble(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    if c >= 65 && c <= 70 { return c - 55 }
    return 0
}

fn otel_b64_char(alpha: str, idx: i64) -> str {
    return substr(alpha, idx, idx + 1)
}

// Hex string → base64 (OTLP JSON bytes fields).
fn otel_hex_to_b64_fixed(hex: str) -> str {
    let n = len(hex)
    let mut i: i64 = 0
    let mut raw: Vec<i64> = vec_new()
    while i + 1 < n {
        let v = otel_hex_nibble(char_at(hex, i)) * 16 + otel_hex_nibble(char_at(hex, i + 1))
        vec_push(raw, v)
        i = i + 2
    }
    let alpha = otel_b64_table()
    let mut out = ""
    let rn = vec_len(raw)
    let mut j: i64 = 0
    while j + 3 <= rn {
        let v = vec_get(raw, j) * 65536 + vec_get(raw, j + 1) * 256 + vec_get(raw, j + 2)
        out = concat(out, otel_b64_char(alpha, (v >> 18) & 63))
        out = concat(out, otel_b64_char(alpha, (v >> 12) & 63))
        out = concat(out, otel_b64_char(alpha, (v >> 6) & 63))
        out = concat(out, otel_b64_char(alpha, v & 63))
        j = j + 3
    }
    let rem = rn - j
    if rem == 1 {
        let v = vec_get(raw, j) * 65536
        out = concat(out, otel_b64_char(alpha, (v >> 18) & 63))
        out = concat(out, otel_b64_char(alpha, (v >> 12) & 63))
        out = concat(out, "==")
    }
    if rem == 2 {
        let v = vec_get(raw, j) * 65536 + vec_get(raw, j + 1) * 256
        out = concat(out, otel_b64_char(alpha, (v >> 18) & 63))
        out = concat(out, otel_b64_char(alpha, (v >> 12) & 63))
        out = concat(out, otel_b64_char(alpha, (v >> 6) & 63))
        out = concat(out, "=")
    }
    return out
}

struct OtelSpan {
    trace: TraceCtx,
    name: str,
    start_ns: str,   // decimal string of unix nanos
    end_ns: str,
    kind: i64        // 1=internal 2=server 3=client
}

// Wall clock ms → unix nanos string (ms * 1_000_000).
fn otel_ms_to_nanos(ms: i64) -> str {
    // avoid overflow: print ms and append "000000"
    return concat(int_to_str(ms), "000000")
}

fn otel_span_now(name: str, t: TraceCtx, kind: i64) -> OtelSpan !Time {
    let ms = time_now_ms()?
    let ns = otel_ms_to_nanos(ms)
    return OtelSpan {
        trace: t, name: name, start_ns: ns, end_ns: ns, kind: kind
    }
}

fn otel_span_end(s: OtelSpan) -> OtelSpan !Time {
    let ms = time_now_ms()?
    s.end_ns = otel_ms_to_nanos(ms)
    return s
}

// One-span OTLP/JSON ExportTraceServiceRequest body.
fn otel_span_to_otlp_json(s: OtelSpan, service: str) -> str {
    let tid_b64 = otel_hex_to_b64_fixed(s.trace.trace_id)
    let sid_b64 = otel_hex_to_b64_fixed(s.trace.span_id)
    let mut j = "{\"resourceSpans\":[{\"resource\":{\"attributes\":["
    j = concat(j, "{\"key\":\"service.name\",\"value\":{\"stringValue\":")
    j = concat(j, json_escape(service))
    j = concat(j, "}}]},\"scopeSpans\":[{\"scope\":{\"name\":\"otelbaga\",\"version\":\"0.1.0\"},\"spans\":[{")
    j = concat(j, "\"traceId\":\"")
    j = concat(j, tid_b64)
    j = concat(j, "\",\"spanId\":\"")
    j = concat(j, sid_b64)
    j = concat(j, "\",\"name\":")
    j = concat(j, json_escape(s.name))
    j = concat(j, ",\"kind\":")
    j = concat(j, int_to_str(s.kind))
    j = concat(j, ",\"startTimeUnixNano\":\"")
    j = concat(j, s.start_ns)
    j = concat(j, "\",\"endTimeUnixNano\":\"")
    j = concat(j, s.end_ns)
    j = concat(j, "\",\"attributes\":[{\"key\":\"trace_id_hex\",\"value\":{\"stringValue\":")
    j = concat(j, json_escape(s.trace.trace_id))
    j = concat(j, "}},{\"key\":\"span_id_hex\",\"value\":{\"stringValue\":")
    j = concat(j, json_escape(s.trace.span_id))
    j = concat(j, "}}]}]}]}]}")
    return j
}

// Append JSON body to a file (ndjson-friendly if caller adds newlines).
fn otel_export_file(path: str, body: str) -> i64 !IO {
    // append: open O_WRONLY|O_CREAT|O_APPEND = 1|64|1024 = 1089
    let fd = open(path, 1089, 420)?
    if fd < 0 {
        return -1
    }
    let line = concat(body, "\n")
    let rc = fd_write(fd, line)?
    close(fd)
    return rc
}

// POST OTLP/JSON to collector URL (e.g. http://localhost:4318/v1/traces).
// Content-Type application/json. Returns HTTP status or -1.
fn otel_export_http(url: str, body: str, timeout_s: i64) -> i64 !Net !IO !Random {
    let headers: Map<str, str> = map_new()
    map_set(headers, "content-type", "application/json")
    let resp = http_request("POST", url, headers, body, timeout_s)?
    if resp.ok == 0 {
        return -1
    }
    return resp.status
}

// Convenience: finish span and write OTLP JSON line to path.
fn otel_export_span_file(path: str, s: OtelSpan, service: str) -> i64 !IO {
    return otel_export_file(path, otel_span_to_otlp_json(s, service))?
}
