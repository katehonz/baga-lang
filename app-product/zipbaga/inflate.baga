// inflate.baga — raw DEFLATE inflate (RFC 1951), ZIP method 8.
// Блоковият цикъл: stored / fixed / dynamic. Bit reader-ът е в
// inflate_bits.baga; Huffman кодеците — в inflate_huff.baga.
// No zlib/gzip wrapper (those add a header; ZIP uses raw DEFLATE).

import "inflate_bits.baga"
import "inflate_huff.baga"
import "std/bytes/bytes.baga"

fn inf_stored(br: InfBit, out0: bytes) -> InfBody {
    let mut br2 = inf_align(br)
    let g1 = inf_take(br2, 16)
    br2 = g1.br
    if br2.ok == 0 {
        return InfBody { br: br2, out: out0, ok: 0, err: br2.err }
    }
    let g2 = inf_take(br2, 16)
    br2 = g2.br
    if br2.ok == 0 {
        return InfBody { br: br2, out: out0, ok: 0, err: br2.err }
    }
    let len = g1.v
    let nlen = g2.v
    if (len ^ 65535) != nlen {
        return InfBody { br: br2, out: out0, ok: 0, err: "deflate: bad stored nlen" }
    }
    // After align, bitcnt should be 0; read raw bytes from pos
    if br2.bitcnt != 0 {
        return InfBody { br: br2, out: out0, ok: 0, err: "deflate: stored not aligned" }
    }
    let pos = br2.pos
    if pos + len > bytes_len(br2.data) {
        return InfBody { br: br2, out: out0, ok: 0, err: "deflate: stored truncated" }
    }
    let chunk = bytes_slice(br2.data, pos, pos + len)
    let out = bytes_concat(out0, chunk)
    let br3 = InfBit {
        data: br2.data, pos: pos + len, bitbuf: 0, bitcnt: 0, ok: 1, err: ""
    }
    return InfBody { br: br3, out: out, ok: 1, err: "" }
}

// Dynamic Huffman block: header + body into out0

fn inflate_raw(src: bytes) -> InfResult {
    let mut br = inf_br(src)
    let mut out = bytes_new(0)
    let mut done = 0
    while done == 0 {
        let gbfinal = inf_take(br, 1)
        br = gbfinal.br
        if br.ok == 0 {
            return inf_err(br.err)
        }
        let bfinal = gbfinal.v
        let gbtype = inf_take(br, 2)
        br = gbtype.br
        if br.ok == 0 {
            return inf_err(br.err)
        }
        let btype = gbtype.v
        if btype == 0 {
            let body = inf_stored(br, out)
            if body.ok == 0 {
                return inf_err(body.err)
            }
            br = body.br
            out = body.out
        } else {
            if btype == 1 {
                let lit_lens = inf_fixed_lit_lens()
                let dist_lens = inf_fixed_dist_lens()
                let lit_codes = inf_huff_codes(lit_lens)
                let dist_codes = inf_huff_codes(dist_lens)
                let body = inf_body(br, lit_lens, lit_codes, dist_lens, dist_codes, out)
                if body.ok == 0 {
                    return inf_err(body.err)
                }
                br = body.br
                out = body.out
            } else {
                if btype == 2 {
                    let body = inf_dynamic_block(br, out)
                    if body.ok == 0 {
                        return inf_err(body.err)
                    }
                    br = body.br
                    out = body.out
                } else {
                    return inf_err("deflate: reserved block type")
                }
            }
        }
        if bfinal == 1 {
            done = 1
        }
    }
    return inf_ok(out)
}
