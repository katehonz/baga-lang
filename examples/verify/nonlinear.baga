spec product_sign {
    input:
        x: i64
        y: i64
    output: i64
    ensures:
        output >= 0
}

// M8b: x * y за независими x и y без знакова информация — твърдението е
// невярно и се ОБОРВА с истински контрапример (x = -1, y = 1 → произведение
// -1). Продуктовите променливи се изчисляват конкретно от факторите при
// witness search, затова контрапримерът е реализируем, не абстрактен.
// (Обратно: x * x >= 0 се ДОКАЗВА — виж square.baga.)
fn product_sign(x: i64, y: i64) -> i64 {
    return x * y
}

fn main() {
    print(product_sign(3, 4))
}
