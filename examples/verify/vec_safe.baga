spec first {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// A locally-built vector has a concrete tracked length (2 here), so the
// constant index 0 is provably in range. (The ensures about the element VALUE
// is honestly UNKNOWN — M2 tracks lengths/bounds, not element contents.)
fn first(n: i64) -> i64 {
    let v = vec_new()
    vec_push(v, 10)
    vec_push(v, 20)
    return vec_get(v, 0)
}

fn main() {
    print(first(1))
}
