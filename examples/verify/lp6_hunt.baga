// LP6 soundness hunt — adversarial specs. Every claim here is FALSE or
// UNPROVABLE; the verifier must answer ОБРОЧЕНО (with counterexample) or
// НЕ МОГА ДА РЕША — never ДОКАЗАНО. A ПРОДОКАЗАНО verdict on any of these
// is a soundness bug.

// ── div/mod sign reasoning beyond the guarded fragment ─────────────────

// n >= 0, m <= -1: n/m is <= 0 in C; claiming >= 0 is false.
spec lp6_div_neg_bad {
    input: n: i64, m: i64
    output: i64
    requires: n >= 1, m <= 0 - 1
    ensures: output >= 1
}
fn lp6_div_neg_bad(n: i64, m: i64) -> i64 { return n / m }

// C remainder takes the sign of the dividend; for m < 0 claiming
// output < m is false (7 % -2 = 1, which is not < -2).
spec lp6_mod_neg_bad {
    input: n: i64, m: i64
    output: i64
    requires: n >= 0, m <= 0 - 1
    ensures: output <= m
}
fn lp6_mod_neg_bad(n: i64, m: i64) -> i64 { return n % m }

// ── bitwise without guards ───────────────────────────────────────────────

// n&1 == n%2 is FALSE for negative n in C (-3 & 1 = 1, -3 % 2 = -1).
spec lp6_lsb_mod2_bad {
    input: n: i64
    output: i64
    ensures: output == 0
}
fn lp6_lsb_mod2_bad(n: i64) -> i64 { return (n & 1) - (n % 2) }

// n >> 1 >= 0 without the n >= 0 guard is false (-4 >> 1 = -2).
spec lp6_shr_neg_bad {
    input: n: i64
    output: i64
    ensures: output >= 0
}
fn lp6_shr_neg_bad(n: i64) -> i64 { return n >> 1 }

// M22: `>>` е аритметично отместване (floor), не C trunc. При n = -5:
// -5 >> 1 = -3 и 2*(-3) - (-5) = -1 < 0 — твърдението е лъжа. Ако
// верификаторът вярва на trunc аксиомата d*q >= n, ще каже ДОКАЗАНО.
spec lp6_shr_floor_bad {
    input: n: i64
    requires: n <= -1
    output: i64
    ensures: 2 * output - n >= 0
}
fn lp6_shr_floor_bad(n: i64) -> i64 { return n >> 1 }

// M23: `>>>` е логическо отместване (zero-fill) — за n <= -1 резултатът е
// ГОЛЯМО положително число (знаковият бит е изчистен), не <= 0. Ако
// верификаторът преизползва аксиомата q <= 0 на аритметичното `>>` за
// n <= 0, ще каже ДОКАЗАНО.
spec lp6_lshr_neg_bad {
    input: n: i64
    requires: n <= -1
    output: i64
    ensures: output <= 0
}
fn lp6_lshr_neg_bad(n: i64) -> i64 { return n >>> 1 }

// M23: отрицателният клон на `>>` (q <= 0) е лъжа за `>>>` — резултатът е
// голямо положително число и output + n > 0 поне за n = -1 ((-1) >>> 2 =
// 4611686018427387903). Ако верификаторът преизползва аксиомите на
// отрицателния клон на `>>` (q <= 0 ∧ n <= -1 ⇒ q + n <= 0), ще каже
// ДОКАЗАНО.
spec lp6_lshr_floor_bad {
    input: n: i64
    requires: n <= -1
    output: i64
    ensures: output + n <= 0
}
fn lp6_lshr_floor_bad(n: i64) -> i64 { return n >>> 2 }

// ── products without sign premises ───────────────────────────────────────

// x*y <= 0 with no sign information: false at x=y=1.
spec lp6_prod_bad {
    input: x: i64, y: i64
    output: i64
    ensures: output <= 0
}
fn lp6_prod_bad(x: i64, y: i64) -> i64 { return x * y }

// x*x <= 0 is false except at 0.
spec lp6_sq_neg_bad {
    input: x: i64
    output: i64
    ensures: output <= 0
}
fn lp6_sq_neg_bad(x: i64) -> i64 { return x * x }

// ── loops: contradictory invariant, broken preservation ──────────────────

// Contradictory invariant (x >= 100 AND x <= 0). Init must fail →
// downstream UNKNOWN, never a proof from false premises.
spec lp6_contra_inv {
    input: n: i64
    output: i64
    ensures: output == 42
}
fn lp6_contra_inv(n: i64) -> i64 {
    let mut x = 5
    while x > 0 invariant x >= 100, x <= 0 {
        x = x - 1
    }
    return x
}

// Invariant true initially, NOT preserved: i*i <= n breaks when i grows.
spec lp6_broken_inv {
    input: n: i64
    output: i64
    requires: n >= 1
    ensures: output * output <= n
}
fn lp6_broken_inv(n: i64) -> i64 {
    let mut i = 0
    while i < n invariant i * i <= n, i >= 0 {
        i = i + 1
    }
    return i
}

// ── decreases misuse ─────────────────────────────────────────────────────

// Measure n - 5 is not >= 0 for all of requires (n >= 0): termination
// must NOT be claimed. Call in statement position (M5 skips calls nested
// in expressions).
spec lp6_dec_neg {
    input: n: i64
    output: i64
    requires: n >= 0
    ensures: output >= 0
    decreases: n - 5
}
fn lp6_dec_neg(n: i64) -> i64 {
    if n <= 0 { return 0 }
    let r = lp6_dec_neg(n - 1)
    return r + 1
}

// ── element invariants dropped after violating write ─────────────────────

// v[*] >= 0 must be dropped after vec_set(v, 0, -5); the read claim is
// then UNKNOWN, not proven.
spec lp6_elem_drop {
    input: v: [i64]
    output: i64
    requires: v[*] >= 0, vec_len(v) >= 2
    ensures: output >= 0
}
fn lp6_elem_drop(v: [i64]) -> i64 {
    vec_set(v, 0, -5)
    return vec_get(v, 0)
}

// ── M24: send-blocking on a full bounded buffer ────────────────────────
// A second send into a full cap-1 buffer with no consumer blocks forever;
// a deadlock-free verdict here was the false PROVEN this guards. Both fns
// stay out of main — running them would hang (that is the point).
spec lp6_sendblk_full_bad {
    input: n: i64
    output: i64
    requires: n >= 1
    ensures: output >= 0
}
fn lp6_sendblk_full_bad(n: i64) -> i64 !Par {
    let c = chan_new(1)
    invariant c[*] >= 1
    chan_send(c, n)
    chan_send(c, n)
    let v = chan_recv(c)
    return v
}

// A worker with two sends into cap 1 never finishes when nobody recvs;
// joining it must be REFUTED, never marked fitting.
spec lp6_sendblk_worker_bad {
    input: n: i64
    output: i64
    requires: n >= 1
    ensures: output >= 0
}
fn lp6_sendblk_worker2(c: i64) -> i64 !Par {
    chan_send(c, 1)
    chan_send(c, 1)
    return 0
}
fn lp6_sendblk_worker_bad(n: i64) -> i64 !Par {
    let c = chan_new(1)
    invariant c[*] >= 1
    let h = go(lp6_sendblk_worker2, c)
    return join(h)
}

// ── M25: known-N fan-in counting must not overclaim ────────────────────
// A loop producer with 2 sends covers exactly 2 parent recvs; a third recv
// is a deadlock and must be REFUTED — an "N covers anything" shortcut here
// would be a false PROVEN. Both fns stay out of main() — they hang.
spec lp6_fanin_short_bad {
    input: n: i64
    output: i64
    requires: n >= 1
    ensures: output >= 0
}
fn lp6_fanin_prod2(c: i64) -> i64 !Par {
    for i in 0..2 { chan_send(c, i + 1) }
    return 0
}
fn lp6_fanin_short_bad(n: i64) -> i64 !Par {
    let c = chan_new(3)
    invariant c[*] >= 1
    let h = go(lp6_fanin_prod2, c)
    let a = chan_recv(c)
    let b = chan_recv(c)
    let d = chan_recv(c)
    join(h)
    return a
}

// A loop producer with 3 sends into cap 2 cannot finish when nobody recvs;
// the join must be REFUTED, never "fits the buffer".
spec lp6_fanin_over_bad {
    input: n: i64
    output: i64
    requires: n >= 1
    ensures: output >= 0
}
fn lp6_fanin_prod3(c: i64) -> i64 !Par {
    for i in 0..3 { chan_send(c, i + 1) }
    return 0
}
fn lp6_fanin_over_bad(n: i64) -> i64 !Par {
    let c = chan_new(2)
    invariant c[*] >= 1
    let h = go(lp6_fanin_prod3, c)
    return join(h)
}

// ── M26: recv2/select2_wait are blocking ops ───────────────────────────
// recv2 blocks exactly like recv; a producer-less recv2 must be REFUTED
// (it had no wait-for claim at all before M26 — a silent deadlock).
spec lp6_recv2_dead_bad {
    input: n: i64
    output: i64
    requires: n >= 1
    ensures: output >= 0
}
fn lp6_recv2_dead_bad(n: i64) -> i64 !Par {
    let c = chan_new(1)
    invariant c[*] >= 1
    let r = chan_recv2(c)
    return cell2_0(r)
}

// select2_wait with two empty open channels and no producers spins
// forever; treating select as non-blocking would be a false PROVEN.
spec lp6_select_dead_bad {
    input: n: i64
    output: i64
    requires: n >= 1
    ensures: output >= 0
}
fn lp6_select_dead_bad(n: i64) -> i64 !Par {
    let c1 = chan_new(1)
    invariant c1[*] >= 1
    let c2 = chan_new(1)
    invariant c2[*] >= 1
    let r = chan_select2_wait(c1, c2)
    return cell2_0(r)
}

// The closed channel's only item was already drained by a recv; recv on a
// closed channel never blocks but its consumption must count, otherwise
// the select below looks satisfiable and would be a false PROVEN.
spec lp6_select_drained_bad {
    input: n: i64
    output: i64
    requires: n >= 1
    ensures: output >= 0
}
fn lp6_select_drained_bad(n: i64) -> i64 !Par {
    let c1 = chan_new(1)
    invariant c1[*] >= 1
    let c2 = chan_new(1)
    invariant c2[*] >= 1
    chan_send(c1, n)
    chan_close(c1)
    let v = chan_recv(c1)
    let r = chan_select2_wait(c1, c2)
    return v
}

fn main() {
    print(lp6_div_neg_bad(7, -2))
    print(lp6_mod_neg_bad(7, -2))
    print(lp6_lsb_mod2_bad(-3))
    print(lp6_shr_neg_bad(-4))
    print(lp6_prod_bad(2, 3))
    print(lp6_sq_neg_bad(3))
    print(lp6_contra_inv(1))
    print(lp6_broken_inv(9))
    print(lp6_dec_neg(3))
}
