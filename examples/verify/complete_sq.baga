// M11: complete the square — (x-1)^2 and (x+1)^2 always >= 0 over ℤ.
spec complete_m1 {
    input: x: i64
    output: i64
    ensures: output >= 0
}
fn complete_m1(x: i64) -> i64 {
    return x * x - 2 * x + 1
}

spec complete_p1 {
    input: x: i64
    output: i64
    ensures: output >= 0
}
fn complete_p1(x: i64) -> i64 {
    return x * x + 2 * x + 1
}

// (x+1)^2 >= 1 is false at x = -1
spec too_strong {
    input: x: i64
    output: i64
    ensures: output >= 1
}
fn too_strong(x: i64) -> i64 {
    let y = x + 1
    return y * y
}

fn main() {
    print(complete_m1(5))
}
