// M18: същото преливащо тяло като ovf_eff_refuted, но inc декларира !Overflow.
// Декларацията DISCHARGE-ва задължението: преливането пак се отпечатва като
// доказателство, но вече не е нарушение на контракта (типът е честен) и
// верификацията не се проваля. ensures вердиктите са в идеализирания ℤ модел.

spec inc {
    input:
        n: i64
    output: i64
    requires:
        n >= 0
    ensures:
        output >= 1
}

fn inc(n: i64) -> i64 !Overflow {
    return n + 1
}

fn main() {
    print(0)   // main не вика inc (тя носи !Overflow)
}
