/* Soundness: sorted(v) must NOT be treated as v[*] <= 0. */
spec first {
    input:
        v: [i64]
    output: i64
    requires:
        sorted(v),
        vec_len(v) >= 1
    ensures:
        output <= 0
}
fn first(v: [i64]) -> i64 {
    return vec_get(v, 0)
}
fn main() {
    let v = vec_new()
    vec_push(v, 5)
    print(first(v))
}
