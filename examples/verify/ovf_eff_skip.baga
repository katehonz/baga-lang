// M18: io_fn декларира !IO (не Par/Overflow), затова фрагментът я ПРОПУСКА —
// никога не се анализира и M18 НЕ прави твърдение за безопасност въпреки n + 1.
// „Никога анализирана" никога не е „доказано безопасна": няма ефект !Overflow ред.

spec io_fn {
    input:
        n: i64
    output: i64
    requires:
        n >= 0
    ensures:
        output >= 1
}

fn io_fn(n: i64) -> i64 !IO {
    return n + 1
}

fn main() {
    print(0)   // main не вика io_fn (тя носи !IO)
}
