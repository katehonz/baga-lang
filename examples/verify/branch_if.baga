// branch_if.baga — M27: if/else merge in the worker scan.
//
// Both branches are scanned separately; the merged counts are guaranteed
// minimums — exactly what credits, producer capacity, and the over-send
// check need for their PROVEN directions. A body whose branch counts
// differ is wf_imprecise: minimums still prove, REFUTED directions see
// unknown. The first blocking op is classified only when both branches
// agree. docs/thesis-open-problems.md §1.4:
//
//   send in both branches (equal counts)   → exact producer, fits
//   recv then conditional send             → recv-first credit
//   recv in one branch, send in the other  → complex, honest silence
//   2 sends in both branches into cap 1    → join REFUTED (over-send)
//   1-send producer + 2 parent recvs       → 2nd recv REFUTED
//   counted loop of branchy sends          → M25×M27 composition
//   1-or-3-send producer + 2 recvs         → 1st PROVEN, rest silent
//   2-or-4-send producer into cap 3, join  → silent (no false PROVEN)
//
//   ./baga --verify examples/verify/branch_if.baga
//   ./baga examples/verify/branch_if.baga     # runs only the live paths

spec prod_if {
    input:
        c: i64
    output: i64
    requires:
        c[*] >= 1
    ensures:
        output >= 0
}

fn prod_if(c: i64) -> i64 !Par {
    if c > 0 { chan_send(c, 1) } else { chan_send(c, 2) }
    return 0
}

spec prod2_if {
    input:
        c: i64
    output: i64
    requires:
        c[*] >= 1
    ensures:
        output >= 0
}

fn prod2_if(c: i64) -> i64 !Par {
    if c > 0 {
        chan_send(c, 1)
        chan_send(c, 1)
    } else {
        chan_send(c, 2)
        chan_send(c, 2)
    }
    return 0
}

spec prod13_if {
    input:
        c: i64
    output: i64
    requires:
        c[*] >= 1
    ensures:
        output >= 0
}

fn prod13_if(c: i64) -> i64 !Par {
    if c > 0 {
        chan_send(c, 1)
    } else {
        chan_send(c, 1)
        chan_send(c, 2)
        chan_send(c, 3)
    }
    return 0
}

spec prod24_if {
    input:
        c: i64
    output: i64
    requires:
        c[*] >= 1
    ensures:
        output >= 0
}

fn prod24_if(c: i64) -> i64 !Par {
    if c > 0 {
        chan_send(c, 1)
        chan_send(c, 2)
    } else {
        chan_send(c, 1)
        chan_send(c, 2)
        chan_send(c, 3)
        chan_send(c, 4)
    }
    return 0
}

spec cons_if {
    input:
        c: i64
    output: i64
    requires:
        c[*] >= 1
    ensures:
        output >= 0
}

fn cons_if(c: i64) -> i64 !Par {
    let v = chan_recv(c)
    if v > 1 { chan_send(c, 1) }
    return v
}

spec mixed_if {
    input:
        c: i64
    output: i64
    requires:
        c[*] >= 1
    ensures:
        output >= 0
}

fn mixed_if(c: i64) -> i64 !Par {
    if c > 0 {
        chan_recv(c)
    } else {
        chan_send(c, 1)
    }
    return 0
}

spec prod_loop_if {
    input:
        c: i64
    output: i64
    requires:
        c[*] >= 1
    ensures:
        output >= 0
}

fn prod_loop_if(c: i64) -> i64 !Par {
    for i in 0..2 {
        if c > 0 { chan_send(c, 1) } else { chan_send(c, 2) }
    }
    return 0
}

// --- equal branch counts: an exact producer ---
spec if_producer {
    input:
        n: i64
    output: i64
    requires:
        n >= 1
    ensures:
        output >= 1
}

fn if_producer(n: i64) -> i64 !Par {
    let c = chan_new(1)
    invariant c[*] >= 1
    let h = go(prod_if, c)
    let v = chan_recv(c)
    join(h)
    return v
}

// --- recv-first with a conditional send after: still a clean credit ---
spec if_credit {
    input:
        n: i64
    output: i64
    requires:
        n >= 1
    ensures:
        output >= 0
}

fn if_credit(n: i64) -> i64 !Par {
    let c = chan_new(1)
    invariant c[*] >= 1
    let h = go(cons_if, c)
    chan_send(c, n)
    chan_send(c, n)
    return join(h)
}

// --- one branch recvs, the other sends: complex, honest silence ---
spec if_mismatch {
    input:
        n: i64
    output: i64
    requires:
        n >= 1
    ensures:
        output >= 0
}

fn if_mismatch(n: i64) -> i64 !Par {
    let c = chan_new(1)
    invariant c[*] >= 1
    let h = go(mixed_if, c)
    let v = chan_recv(c)
    join(h)
    return v
}

// --- two guaranteed sends into cap 1: the join can never complete ---
spec if_over {
    input:
        n: i64
    output: i64
    requires:
        n >= 1
    ensures:
        output >= 0
}

fn if_over(n: i64) -> i64 !Par {
    let c = chan_new(1)
    invariant c[*] >= 1
    let h = go(prod2_if, c)
    return join(h)
}

// --- a one-send producer cannot cover two recvs ---
spec if_short {
    input:
        n: i64
    output: i64
    requires:
        n >= 1
    ensures:
        output >= 0
}

fn if_short(n: i64) -> i64 !Par {
    let c = chan_new(2)
    invariant c[*] >= 1
    let h = go(prod_if, c)
    let a = chan_recv(c)
    let b = chan_recv(c)
    join(h)
    return a
}

// --- counted loop of branchy sends: M25 x M27 ---
spec loop_if {
    input:
        n: i64
    output: i64
    requires:
        n >= 1
    ensures:
        output >= 1
}

fn loop_if(n: i64) -> i64 !Par {
    let c = chan_new(2)
    invariant c[*] >= 1
    let h = go(prod_loop_if, c)
    let a = chan_recv(c)
    let b = chan_recv(c)
    join(h)
    return a
}

// --- guaranteed one send covers the first recv; the rest is unknown ---
spec if_range {
    input:
        n: i64
    output: i64
    requires:
        n >= 1
    ensures:
        output >= 0
}

fn if_range(n: i64) -> i64 !Par {
    let c = chan_new(2)
    invariant c[*] >= 1
    let h = go(prod13_if, c)
    let a = chan_recv(c)
    let b = chan_recv(c)
    join(h)
    return a
}

// --- 2-or-4 sends into cap 3: neither REFUTED nor "fits". The verifier
// --- cannot exclude the 4-send branch (the condition is opaque), and the
// --- branch would overflow the buffer if taken — a false PROVEN here is
// --- what the wf_imprecise gate guards against. ---
spec if_over_range {
    input:
        n: i64
    output: i64
    requires:
        n >= 1
    ensures:
        output >= 0
}

fn if_over_range(n: i64) -> i64 !Par {
    let c = chan_new(3)
    invariant c[*] >= 1
    let h = go(prod24_if, c)
    return join(h)
}

fn main() -> i64 !Par {
    print(if_producer(7))
    print(if_credit(1))
    print(loop_if(7))
    return 0
}
