// select_wait.baga — M26: recv2 and select2_wait in the wait-for fragment.
//
// chan_recv2 blocks exactly like chan_recv (it had no wait-for claim at
// all — a silent deadlock), and chan_select2_wait blocks until either
// channel yields an item (or both are closed — then it returns (3,0)).
// select2 / try_recv / the timeout forms never block — no claims. The
// winning side of a select is unknown, so both channels are taxed and
// later drain-sensitive claims stay silent (REFUTED directions stay
// sound). recv on a closed channel never blocks but its consumption
// counts. docs/thesis-open-problems.md §1.4:
//
//   producer on c1 + select2_wait(c1, c2)      → PROVEN
//   buffered item on c1 + select2_wait          → PROVEN
//   both channels closed + select2_wait         → PROVEN (returns (3,0))
//   empty open channels, no producers           → REFUTED (select без producer)
//   drained closed channel + empty open channel → REFUTED (consumption counts)
//   recv2 with a prior send                     → PROVEN (последователни)
//   recv2 with no producer                      → REFUTED (recv без send)
//   recv after a select                         → honest silence
//   recv2-first worker credit                   → join след send
//
//   ./baga --verify examples/verify/select_wait.baga
//   ./baga examples/verify/select_wait.baga     # runs only the live paths

spec producer {
    input:
        c: i64
    output: i64
    requires:
        c[*] >= 1
    ensures:
        output >= 0
}

fn producer(c: i64) -> i64 !Par {
    chan_send(c, 1)
    return 0
}

spec r2c {
    input:
        c: i64
    output: i64
    requires:
        c[*] >= 1
    ensures:
        output >= 0
}

fn r2c(c: i64) -> i64 !Par {
    let r = chan_recv2(c)
    return r
}

// --- a producer on either side satisfies the select ---
spec select_prod {
    input:
        n: i64
    output: i64
    requires:
        n >= 1
    ensures:
        output >= 1
}

fn select_prod(n: i64) -> i64 !Par {
    let c1 = chan_new(1)
    invariant c1[*] >= 1
    let c2 = chan_new(1)
    invariant c2[*] >= 1
    let h = go(producer, c1)
    let r = chan_select2_wait(c1, c2)
    join(h)
    if cell2_0(r) <= 1 {
        return cell2_1(r)
    }
    return 1
}

// --- an already-buffered item satisfies the select ---
spec select_buffered {
    input:
        n: i64
    output: i64
    requires:
        n >= 1
    ensures:
        output >= 1
}

fn select_buffered(n: i64) -> i64 !Par {
    let c1 = chan_new(1)
    invariant c1[*] >= 1
    let c2 = chan_new(1)
    invariant c2[*] >= 1
    chan_send(c1, n)
    let r = chan_select2_wait(c1, c2)
    if cell2_0(r) <= 1 {
        return cell2_1(r)
    }
    return 1
}

// --- both closed: select returns (3,0) at once ---
spec select_both_closed {
    input:
        n: i64
    output: i64
    requires:
        n >= 1
    ensures:
        output >= 0
}

fn select_both_closed(n: i64) -> i64 !Par {
    let c1 = chan_new(1)
    let c2 = chan_new(1)
    chan_close(c1)
    chan_close(c2)
    let r = chan_select2_wait(c1, c2)
    return cell2_0(r)
}

// --- empty open channels, no producers: the select spins forever ---
spec select_dead {
    input:
        n: i64
    output: i64
    requires:
        n >= 1
    ensures:
        output >= 0
}

fn select_dead(n: i64) -> i64 !Par {
    let c1 = chan_new(1)
    invariant c1[*] >= 1
    let c2 = chan_new(1)
    invariant c2[*] >= 1
    let r = chan_select2_wait(c1, c2)
    return cell2_0(r)
}

// --- the closed channel was drained first; nothing is left anywhere ---
spec select_drained {
    input:
        n: i64
    output: i64
    requires:
        n >= 1
    ensures:
        output >= 0
}

fn select_drained(n: i64) -> i64 !Par {
    let c1 = chan_new(1)
    invariant c1[*] >= 1
    let c2 = chan_new(1)
    invariant c2[*] >= 1
    chan_send(c1, n)
    chan_close(c1)
    let v = chan_recv(c1)
    let r = chan_select2_wait(c1, c2)
    return v
}

// --- recv2 after a send: the sequential contract ---
spec recv2_ok {
    input:
        n: i64
    output: i64
    requires:
        n >= 1
    ensures:
        output >= 1
}

fn recv2_ok(n: i64) -> i64 !Par {
    let c = chan_new(1)
    invariant c[*] >= 1
    chan_send(c, n)
    let r = chan_recv2(c)
    if cell2_0(r) == 1 {
        return cell2_1(r)
    }
    return 1
}

// --- recv2 with no producer: blocks forever ---
spec recv2_dead {
    input:
        n: i64
    output: i64
    requires:
        n >= 1
    ensures:
        output >= 0
}

fn recv2_dead(n: i64) -> i64 !Par {
    let c = chan_new(1)
    invariant c[*] >= 1
    let r = chan_recv2(c)
    return cell2_0(r)
}

// --- after a select the drained side is unknown: the recv stays silent ---
spec select_silence {
    input:
        n: i64
    output: i64
    requires:
        n >= 1
    ensures:
        output >= 1
}

fn select_silence(n: i64) -> i64 !Par {
    let c1 = chan_new(1)
    invariant c1[*] >= 1
    let c2 = chan_new(1)
    invariant c2[*] >= 1
    chan_send(c1, n)
    chan_send(c2, n)
    let r = chan_select2_wait(c1, c2)
    let v = chan_recv(c2)
    return v
}

// --- a recv2-first worker is a consumer credit; join after send ---
spec worker_r2 {
    input:
        n: i64
    output: i64
    requires:
        n >= 1
    ensures:
        output == 0
}

fn worker_r2(n: i64) -> i64 !Par {
    let c = chan_new(1)
    invariant c[*] >= 1
    let h = go(r2c, c)
    chan_send(c, n)
    join(h)
    return 0
}

fn main() -> i64 !Par {
    print(select_prod(7))
    print(select_buffered(7))
    print(select_both_closed(7))
    print(recv2_ok(7))
    print(select_silence(7))
    print(worker_r2(7))
    return 0
}
