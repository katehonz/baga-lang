// M18: inc НЕ декларира !Overflow, но n + 1 прелива при n = INT64_MAX
// (requires е само n >= 0). Липсата на ефекта е твърдение за безопасност;
// верификаторът го оборва — ОБРОЧЕНО с точния контрапример, ненулев exit.

spec inc {
    input:
        n: i64
    output: i64
    requires:
        n >= 0
    ensures:
        output >= 1
}

fn inc(n: i64) -> i64 {
    return n + 1
}

fn main() {
    print(inc(41))   // 42 — безопасно за този вход; нарушението е в контракта
}
