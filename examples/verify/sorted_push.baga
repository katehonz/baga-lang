/* push of x with v[*] <= x preserves element axioms; sorted is tracked alongside. */
spec append {
    input:
        v: [i64]
        x: i64
    output: i64
    requires:
        sorted(v),
        v[*] <= x,
        v[*] >= 0,
        x >= 0,
        vec_len(v) >= 1
    ensures:
        output >= 0
}
fn append(v: [i64], x: i64) -> i64 {
    vec_push(v, x)
    return vec_get(v, 0)
}
fn main() {
    let v = vec_new()
    vec_push(v, 1)
    print(append(v, 5))
}
