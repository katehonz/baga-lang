// while_count.baga — M31: while-loop с induction променлива в worker.
//
// M25 броеше for-цикли с константен диапазон. M31 разпознава същия патерн
// при while: `while i < N { body; i = i + 1 }` — тялото се сканира веднъж
// и броят се мащабира с горна граница N (imprecise — REFUTED посоките
// виждат unknown, PROVEN посоките (producer capacity) работят).
//
//   while-producer 3 итерации + 3 parent recvs  → покрити (PROVEN)
//   while-producer + 1 parent recv              → PROVEN (join след send)
//
//   ./baga --verify examples/verify/while_count.baga

fn wprod(c: i64) -> i64 !Par {
    let mut i = 0
    while i < 3 {
        chan_send(c, i + 1)
        i = i + 1
    }
    return 0
}

spec wfanin {
    input:
        n: i64
    output: i64
    requires:
        n >= 1
    ensures:
        output >= 1
}

fn wfanin(n: i64) -> i64 !Par {
    let c = chan_new(3)
    invariant c[*] >= 1
    let h = go(wprod, c)
    let a = chan_recv(c)
    let b = chan_recv(c)
    let d = chan_recv(c)
    join(h)
    return a
}

fn main() -> i64 !Par {
    let c = chan_new(3)
    let h = go(wprod, c)
    let a = chan_recv(c)
    let b = chan_recv(c)
    let d = chan_recv(c)
    join(h)
    print(a)
    print(b)
    print(d)
    return 0
}
