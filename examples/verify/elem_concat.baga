spec concat_nonneg {
    input:
        v: [i64]
        w: [i64]
    output: i64
    requires:
        v[*] >= 0,
        w[*] >= 0,
        vec_len(v) >= 1,
        vec_len(w) >= 1
    ensures:
        output >= 0
}
fn concat_nonneg(v: [i64], w: [i64]) -> i64 {
    let c = vec_concat(v, w)
    return vec_get(c, 0)
}
fn main() { let v = vec_new(); vec_push(v, 1); let w = vec_new(); vec_push(w, 2); print(concat_nonneg(v, w)) }
