spec slice_oob {
    input:
        v: [i64]
    output: i64
    requires:
        v[*] >= 0,
        vec_len(v) >= 1
    ensures:
        output >= 0
}
fn slice_oob(v: [i64]) -> i64 {
    let s = vec_slice(v, 0, 1)
    return vec_get(s, 5)
}
fn main() { let v = vec_new(); vec_push(v, 1); print(slice_oob(v)) }
