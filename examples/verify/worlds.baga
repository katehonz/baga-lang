// worlds.baga — светове: жизнен цикъл и протокол на РЕГИОНА (W0/W1/W1.5).
//
// HK_WORLD ghost протокол (като MEM-2 drop, но с четири състояния):
//   0 mutable → 1 frozen → 2 freed;  3 = moved (предаване на изключителна
//   собственост — Pony iso стил, Verona linear-region дух).
// Нарушение на жив път → ОБРОЧЕНО с контрапример; на мъртъв път →
// vacuously PROVEN (M8/MEM-2 дисциплина). Runtime-ът е арената + frozen бит
// (seatbelt: world_alloc върху замразен свят е чиста грешка).
//
// Договорите и споделянето (W2.1 requires world_frozen, W2.3 wcache, W2.4
// N читателя на замразен свят) са в examples/verify/worlds_cap.baga — файлът
// се дели, защото gate-ът е 600 реда.
//
// W1.6: checker-ът има собствен seatbelt за ПРАВОЛИНЕЙНИ нарушения
// (freeze→mutate, двоен freeze, достъп след world_free) и те не стигат дотук
// — компилацията гърми. Затова всяко bad_* тук е path-sensitive: нарушаващото
// действие е след join на if-клон, където checker-ът не е сигурен (maybe
// frozen / maybe freed) и честно мълчи, а верификаторът изследва пътевите и
// оборва лошата. Същото разделение като при mem_drop.baga.
//
//   ./baga --verify examples/verify/worlds.baga

spec ok_lifecycle {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Чист жизнен цикъл: new → alloc → freeze → state → free.
fn ok_lifecycle(n: i64) -> i64 {
    let w = world_new()
    let p = world_alloc(w, 64)
    world_freeze(w)
    let s = world_state(w)
    world_free(w)
    return n - n
}

spec ok_shared_frozen {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Легалното zero-copy споделяне: замразен свят минава през канал —
// move-ът на FROZEN свят не е нарушение (собствеността пътува, писатели
// няма). Приемникът би четнал offset-платформата в W1.
fn ok_shared_frozen(n: i64) -> i64 !Par {
    let w = world_new()
    let p = world_alloc(w, 64)
    world_freeze(w)
    let ch = chan_new(1)
    chan_send(ch, w)
    chan_close(ch)
    return n - n
}

spec bad_freeze_mutate {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Мутиране след freeze — freeze е САМО в then-клона, така че след join
// checker-ът (W1.6 seatbelt) не знае със сигурност, че светът е замразен, и
// оставя реда легален. Верификаторът минава по двата пътя и оборва n > 0.
fn bad_freeze_mutate(n: i64) -> i64 {
    let w = world_new()
    if n > 0 {
        world_freeze(w)
    }
    let p = world_alloc(w, 16)
    world_free(w)
    return 0
}

spec bad_double_free {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Двоен free — първият е само в then-клона, така че след join вторият не е
// „сигурно върху освободен свят" за checker-а (W1.6); верификаторът го
// оборва по пътя n > 0.
fn bad_double_free(n: i64) -> i64 {
    let w = world_new()
    if n > 0 {
        world_free(w)
    }
    world_free(w)
    return 0
}

spec bad_use_after_free {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Четене на състоянието след free — use-after-free. Free-ът е само в
// then-клона ⇒ checker-ът (W1.6) не е сигурен; верификаторът е.
fn bad_use_after_free(n: i64) -> i64 {
    let w = world_new()
    if n > 0 {
        world_free(w)
    }
    let s = world_state(w)
    return 0
}

spec bad_use_after_move {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Собствеността е прехвърлена през chan_send — локалният freeze след това
// е use-after-move (двама писатели върху един свят = race).
fn bad_use_after_move(n: i64) -> i64 !Par {
    let w = world_new()
    let ch = chan_new(1)
    chan_send(ch, w)
    if n > 0 {
        world_freeze(w)
    }
    chan_close(ch)
    return 0
}

spec ok_frozen_read {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// W1: замразен свят се ЧЕТЕ — wvec_get/wvec_len са легални върху frozen.
// Това е цялата идея: споделен zero-copy регион с произволно много четци
// и нито един писател.
fn ok_frozen_read(n: i64) -> i64 {
    let w = world_new()
    let v = wvec_new(w)
    wvec_push(w, v, 7)
    world_freeze(w)
    let x = wvec_get(w, v, 0)
    world_free(w)
    return n - n
}

spec bad_push_frozen {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// W1: wvec_push върху замразен свят — mutate-after-freeze. Freeze-ът е само
// в then-клона ⇒ checker-legal (W1.6 join), верификаторът оборва n > 0.
fn bad_push_frozen(n: i64) -> i64 {
    let w = world_new()
    let v = wvec_new(w)
    if n > 0 {
        world_freeze(w)
    }
    wvec_push(w, v, 2)
    world_free(w)
    return 0
}

spec bad_push_after_move {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// W1: собствеността е прехвърлена през chan_send — локалният push след
// това е use-after-move (двама писатели върху един свят = race).
fn bad_push_after_move(n: i64) -> i64 !Par {
    let w = world_new()
    let v = wvec_new(w)
    let ch = chan_new(1)
    chan_send(ch, w)
    if n > 0 {
        wvec_push(w, v, 3)
    }
    chan_close(ch)
    return 0
}

spec w_worker {
    input:
        ctx: i64
    output: i64
    requires:
        world_owned(ctx)
    ensures:
        output >= 0
}

// W2.7: работникът-приемник на mutable свят декларира договор — собствеността
// се прехвърля (world_owned), което е точно move-семантиката на W1.5/W2.4.
fn w_worker(ctx: i64) -> i64 !Par {
    // връщаме 0, не handle-а: i64-ът на света няма знак според договора, а
    // ensures output >= 0 трябва да е доказуем, не оборен от произвол handle.
    return ctx - ctx
}

spec ok_frozen_read_str {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// W1.5: низовете живеят в региона като ОФСЕТИ — frozen свят се чете,
// dump/load носи текстовете position-independent.
fn ok_frozen_read_str(n: i64) -> i64 {
    let w = world_new()
    let v = wvec_new(w)
    wvec_push_str(w, v, "свят")
    world_freeze(w)
    let s = wvec_get_str(w, v, 0)
    world_free(w)
    return n - n
}

spec bad_push_str_frozen {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// W1.5: низов push върху замразен свят — mutate-after-freeze. Freeze-ът е
// само в then-клона ⇒ checker-legal (W1.6 join), верификаторът оборва n > 0.
fn bad_push_str_frozen(n: i64) -> i64 {
    let w = world_new()
    let v = wvec_new(w)
    if n > 0 {
        world_freeze(w)
    }
    wvec_push_str(w, v, "x")
    world_free(w)
    return 0
}

spec bad_go_move {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// W1.5: go(worker, w) прехвърля собствеността точно като chan_send —
// локалният push след това е use-after-move.
fn bad_go_move(n: i64) -> i64 !Par {
    let w = world_new()
    let v = wvec_new(w)
    let h = go(w_worker, w)
    if n > 0 {
        wvec_push(w, v, 3)
    }
    let r = join(h)
    return r - r
}

spec ok_map_frozen_read {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// W2.9: wmap е offset-адресиран като wvec — част е от стойността на света и
// оцелява през dump/load (за разлика от wcache). Четците върху замразен свят
// са легални.
fn ok_map_frozen_read(n: i64) -> i64 {
    let w = world_new()
    let m = wmap_new(w)
    wmap_set(w, m, 1, 10)
    wmap_set_str(w, m, 2, "индекс")
    world_freeze(w)
    let x = wmap_get(w, m, 1)
    let h = wmap_has(w, m, 2)
    let l = wmap_len(w, m)
    world_free(w)
    return n - n
}

spec bad_map_frozen {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// W2.9: wmap_set е check-only мутатор като wvec_push — върху замразен свят е
// ОБРОЧЕНО. Freeze-ът е само в then-клона, затова checker-ът (W1.6) мълчи, а
// верификаторът оборва пътя n = 1.
fn bad_map_frozen(n: i64) -> i64 {
    let w = world_new()
    let m = wmap_new(w)
    if n > 0 {
        world_freeze(w)
    }
    wmap_set(w, m, 1, 10)
    world_free(w)
    return n - n
}

spec ok_dump_compact_frozen {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// W2.10: world_dump_compact е ЧЕТЕНЕ — прави компактиран образ, без да пипа
// региона, затова е легално върху замразен свят (за разлика от world_compact).
fn ok_dump_compact_frozen(n: i64) -> i64 {
    let w = world_new()
    let v = wvec_new(w)
    wvec_push(w, v, 1)
    world_freeze(w)
    let d = world_dump_compact(w)
    let b = bytes_len(d)
    world_free(w)
    return n - n
}

spec bad_compact_frozen {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// W2.10: world_compact пренарежда региона — мутатор е, значи върху замразен
// свят е ОБРОЧЕНО (freeze е в then-клона, checker-ът мълчи, верификаторът не).
fn bad_compact_frozen(n: i64) -> i64 {
    let w = world_new()
    let v = wvec_new(w)
    wvec_push(w, v, 1)
    if n > 0 {
        world_freeze(w)
    }
    world_compact(w)
    world_free(w)
    return n - n
}

fn main() {
    print(ok_lifecycle(1))
    print(ok_frozen_read(1))
    print(ok_frozen_read_str(1))
    print(bad_freeze_mutate(0))
    print(bad_double_free(0))
    print(bad_use_after_free(0))
    print(bad_push_frozen(0))
    print(bad_push_str_frozen(0))
    print(ok_map_frozen_read(1))
    print(bad_map_frozen(0))
    print(ok_dump_compact_frozen(1))
    print(bad_compact_frozen(0))
}
