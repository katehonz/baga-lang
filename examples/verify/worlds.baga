// worlds.baga — W0: светове (региони с ownership/freeze дисциплина).
//
// HK_WORLD ghost протокол (като MEM-2 drop, но с четири състояния):
//   0 mutable → 1 frozen → 2 freed;  3 = moved (chan_send прехвърля
//   собствеността — Pony iso стил, Verona linear-region дух).
// Нарушение на жив път → ОБРОЧЕНО с контрапример; на мъртъв път →
// vacuously PROVEN (M8/MEM-2 дисциплина). Runtime-ът е арената + frozen
// бит (seatbelt: world_alloc върху замразен свят е чиста грешка);
// доказателството е тук.
//
// Честни граници на W0: протоколът е по ИМЕ на променливата (алиаси не се
// проследяват — MEM-1 договор); move се моделира само през chan_send
// (go-аргумент е W0.5); cross-world capability връзки още ги няма.
//
//   ./baga --verify examples/verify/worlds.baga

spec ok_lifecycle {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Чист жизнен цикъл: new → alloc → freeze → state → free.
fn ok_lifecycle(n: i64) -> i64 {
    let w = world_new()
    let p = world_alloc(w, 64)
    world_freeze(w)
    let s = world_state(w)
    world_free(w)
    return n - n
}

spec ok_shared_frozen {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Легалното zero-copy споделяне: замразен свят минава през канал —
// move-ът на FROZEN свят не е нарушение (собствеността пътува, писатели
// няма). Приемникът би четнал offset-платформата в W1.
fn ok_shared_frozen(n: i64) -> i64 !Par {
    let w = world_new()
    let p = world_alloc(w, 64)
    world_freeze(w)
    let ch = chan_new(1)
    chan_send(ch, w)
    chan_close(ch)
    return n - n
}

spec bad_freeze_mutate {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Мутиране след freeze — скрито зад if-клон (прав път е само при n > 0).
fn bad_freeze_mutate(n: i64) -> i64 {
    let w = world_new()
    if n > 0 {
        world_freeze(w)
        let p = world_alloc(w, 16)
    }
    world_free(w)
    return 0
}

spec bad_double_free {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Двоен free — вторият е зад if, така че checker-ът не го хваща праволинейно.
fn bad_double_free(n: i64) -> i64 {
    let w = world_new()
    world_free(w)
    if n > 0 {
        world_free(w)
    }
    return 0
}

spec bad_use_after_free {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Четене на състоянието след free — use-after-free.
fn bad_use_after_free(n: i64) -> i64 {
    let w = world_new()
    world_free(w)
    if n > 0 {
        let s = world_state(w)
    }
    return 0
}

spec bad_use_after_move {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Собствеността е прехвърлена през chan_send — локалният freeze след това
// е use-after-move (двама писатели върху един свят = race).
fn bad_use_after_move(n: i64) -> i64 !Par {
    let w = world_new()
    let ch = chan_new(1)
    chan_send(ch, w)
    if n > 0 {
        world_freeze(w)
    }
    chan_close(ch)
    return 0
}

spec ok_frozen_read {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// W1: замразен свят се ЧЕТЕ — wvec_get/wvec_len са легални върху frozen.
// Това е цялата идея: споделен zero-copy регион с произволно много четци
// и нито един писател.
fn ok_frozen_read(n: i64) -> i64 {
    let w = world_new()
    let v = wvec_new(w)
    wvec_push(w, v, 7)
    world_freeze(w)
    let x = wvec_get(w, v, 0)
    world_free(w)
    return n - n
}

spec bad_push_frozen {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// W1: wvec_push върху замразен свят — mutate-after-freeze.
fn bad_push_frozen(n: i64) -> i64 {
    let w = world_new()
    let v = wvec_new(w)
    world_freeze(w)
    if n > 0 {
        wvec_push(w, v, 2)
    }
    world_free(w)
    return 0
}

spec bad_push_after_move {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// W1: собствеността е прехвърлена през chan_send — локалният push след
// това е use-after-move (двама писатели върху един свят = race).
fn bad_push_after_move(n: i64) -> i64 !Par {
    let w = world_new()
    let v = wvec_new(w)
    let ch = chan_new(1)
    chan_send(ch, w)
    if n > 0 {
        wvec_push(w, v, 3)
    }
    chan_close(ch)
    return 0
}

fn w_worker(ctx: i64) -> i64 !Par {
    return ctx
}

spec ok_frozen_read_str {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// W1.5: низовете живеят в региона като ОФСЕТИ — frozen свят се чете,
// dump/load носи текстовете position-independent.
fn ok_frozen_read_str(n: i64) -> i64 {
    let w = world_new()
    let v = wvec_new(w)
    wvec_push_str(w, v, "свят")
    world_freeze(w)
    let s = wvec_get_str(w, v, 0)
    world_free(w)
    return n - n
}

spec bad_push_str_frozen {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// W1.5: низов push върху замразен свят — mutate-after-freeze.
fn bad_push_str_frozen(n: i64) -> i64 {
    let w = world_new()
    let v = wvec_new(w)
    world_freeze(w)
    if n > 0 {
        wvec_push_str(w, v, "x")
    }
    world_free(w)
    return 0
}

spec bad_go_move {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// W1.5: go(worker, w) прехвърля собствеността точно като chan_send —
// локалният push след това е use-after-move.
fn bad_go_move(n: i64) -> i64 !Par {
    let w = world_new()
    let v = wvec_new(w)
    let h = go(w_worker, w)
    if n > 0 {
        wvec_push(w, v, 3)
    }
    let r = join(h)
    return r - r
}

fn main() {
    print(ok_lifecycle(1))
    print(ok_frozen_read(1))
    print(ok_frozen_read_str(1))
    print(bad_freeze_mutate(0))
    print(bad_double_free(0))
    print(bad_use_after_free(0))
    print(bad_push_frozen(0))
    print(bad_push_str_frozen(0))
}
