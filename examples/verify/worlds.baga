// worlds.baga — W0: светове (региони с ownership/freeze дисциплина).
//
// HK_WORLD ghost протокол (като MEM-2 drop, но с четири състояния):
//   0 mutable → 1 frozen → 2 freed;  3 = moved (chan_send прехвърля
//   собствеността — Pony iso стил, Verona linear-region дух).
// Нарушение на жив път → ОБРОЧЕНО с контрапример; на мъртъв път →
// vacuously PROVEN (M8/MEM-2 дисциплина). Runtime-ът е арената + frozen
// бит (seatbelt: world_alloc върху замразен свят е чиста грешка);
// доказателството е тук.
//
// Честни граници на W0: протоколът е по ИМЕ на променливата (алиаси не се
// проследяват — MEM-1 договор); move се моделира само през chan_send
// (go-аргумент е W0.5); cross-world capability връзки още ги няма.
//
// W1.6: checker-ът вече има собствен seatbelt за ПРАВОЛИНЕЙНИ нарушения
// (freeze→mutate, двоен freeze, достъп след world_free) и те не стигат дотук
// — компилацията гърми. Затова всяко bad_* тук е path-sensitive: нарушаващото
// действие е след join на if-клон, където checker-ът не е сигурен (maybe
// frozen / maybe freed) и честно мълчи, а верификаторът изследва пътевите и
// оборва лошата. Същото разделение като при mem_drop.baga.
//
//   ./baga --verify examples/verify/worlds.baga

spec ok_lifecycle {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Чист жизнен цикъл: new → alloc → freeze → state → free.
fn ok_lifecycle(n: i64) -> i64 {
    let w = world_new()
    let p = world_alloc(w, 64)
    world_freeze(w)
    let s = world_state(w)
    world_free(w)
    return n - n
}

spec ok_shared_frozen {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Легалното zero-copy споделяне: замразен свят минава през канал —
// move-ът на FROZEN свят не е нарушение (собствеността пътува, писатели
// няма). Приемникът би четнал offset-платформата в W1.
fn ok_shared_frozen(n: i64) -> i64 !Par {
    let w = world_new()
    let p = world_alloc(w, 64)
    world_freeze(w)
    let ch = chan_new(1)
    chan_send(ch, w)
    chan_close(ch)
    return n - n
}

spec bad_freeze_mutate {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Мутиране след freeze — freeze е САМО в then-клона, така че след join
// checker-ът (W1.6 seatbelt) не знае със сигурност, че светът е замразен, и
// оставя реда легален. Верификаторът минава по двата пътя и оборва n > 0.
fn bad_freeze_mutate(n: i64) -> i64 {
    let w = world_new()
    if n > 0 {
        world_freeze(w)
    }
    let p = world_alloc(w, 16)
    world_free(w)
    return 0
}

spec bad_double_free {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Двоен free — първият е само в then-клона, така че след join вторият не е
// „сигурно върху освободен свят" за checker-а (W1.6); верификаторът го
// оборва по пътя n > 0.
fn bad_double_free(n: i64) -> i64 {
    let w = world_new()
    if n > 0 {
        world_free(w)
    }
    world_free(w)
    return 0
}

spec bad_use_after_free {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Четене на състоянието след free — use-after-free. Free-ът е само в
// then-клона ⇒ checker-ът (W1.6) не е сигурен; верификаторът е.
fn bad_use_after_free(n: i64) -> i64 {
    let w = world_new()
    if n > 0 {
        world_free(w)
    }
    let s = world_state(w)
    return 0
}

spec bad_use_after_move {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Собствеността е прехвърлена през chan_send — локалният freeze след това
// е use-after-move (двама писатели върху един свят = race).
fn bad_use_after_move(n: i64) -> i64 !Par {
    let w = world_new()
    let ch = chan_new(1)
    chan_send(ch, w)
    if n > 0 {
        world_freeze(w)
    }
    chan_close(ch)
    return 0
}

spec ok_frozen_read {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// W1: замразен свят се ЧЕТЕ — wvec_get/wvec_len са легални върху frozen.
// Това е цялата идея: споделен zero-copy регион с произволно много четци
// и нито един писател.
fn ok_frozen_read(n: i64) -> i64 {
    let w = world_new()
    let v = wvec_new(w)
    wvec_push(w, v, 7)
    world_freeze(w)
    let x = wvec_get(w, v, 0)
    world_free(w)
    return n - n
}

spec bad_push_frozen {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// W1: wvec_push върху замразен свят — mutate-after-freeze. Freeze-ът е само
// в then-клона ⇒ checker-legal (W1.6 join), верификаторът оборва n > 0.
fn bad_push_frozen(n: i64) -> i64 {
    let w = world_new()
    let v = wvec_new(w)
    if n > 0 {
        world_freeze(w)
    }
    wvec_push(w, v, 2)
    world_free(w)
    return 0
}

spec bad_push_after_move {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// W1: собствеността е прехвърлена през chan_send — локалният push след
// това е use-after-move (двама писатели върху един свят = race).
fn bad_push_after_move(n: i64) -> i64 !Par {
    let w = world_new()
    let v = wvec_new(w)
    let ch = chan_new(1)
    chan_send(ch, w)
    if n > 0 {
        wvec_push(w, v, 3)
    }
    chan_close(ch)
    return 0
}

fn w_worker(ctx: i64) -> i64 !Par {
    return ctx
}

// ---------------------------------------------------------------------------
// W2.1: двустранен протокол за споделен свят. Ghost предикатът
// `requires: world_frozen(ctx)` е verifier-only (като sorted(v)):
//   • в тялото на ПРИЕМАЩИЯ регистрира ctx като HK_WORLD(1) — мутатор върху
//     получения свят е ОБРОЧЕНО там, а не мълчание (досега работникът беше
//     sound silence: параметърът не беше ghost-регистриран);
//   • при ИЗВИКВАНЕТО се разтоварва срещу състоянието на аргумента — frozen
//     е ДОКАЗАНО, а мутабелен/освободен/преместен свят е ОБРОЧЕНО с witness.
// Работник без spec (w_worker) остава честен silence: няма какво да се поеме.
// ---------------------------------------------------------------------------

spec ok_shared_reader {
    input:
        ctx: i64
    output: i64
    requires:
        world_frozen(ctx)
    ensures:
        output >= 0
}

// Легалният читател: получил е замразен свят и само чете (world_state/
// world_used). Собствената му верификация е чиста — ghost състоянието е
// frozen, а четците са легални върху frozen.
fn ok_shared_reader(ctx: i64) -> i64 {
    let s = world_state(ctx)
    let u = world_used(ctx)
    return ctx - ctx
}

spec bad_shared_writer {
    input:
        ctx: i64
    output: i64
    requires:
        world_frozen(ctx)
    ensures:
        output >= 0
}

// Същият договор, но тялото ПИШЕ в получения свят. Checker-ът мълчи (за него
// параметърът е „неизвестно" състояние — W1.6 не измисля), верификаторът
// оборва в самото тяло: втори писател върху споделен замразен свят = race.
fn bad_shared_writer(ctx: i64) -> i64 {
    let p = world_alloc(ctx, 16)
    return ctx - ctx
}

spec ok_pass_frozen {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Извикващият замразява и предава: requires-ът на читателя се разтоварва
// (ДОКАЗАНО), ensures-ът му се поема. Това е zero-copy споделянето, доказано
// и от двете страни.
fn ok_pass_frozen(n: i64) -> i64 !Par {
    let w = world_new()
    let v = wvec_new(w)
    wvec_push(w, v, 5)
    world_freeze(w)
    let h = go(ok_shared_reader, w)
    let r = join(h)
    return r - r
}

spec bad_pass_mutable {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Freeze-ът е само в then-клона ⇒ по пътя n = 0 светът е мутабелен и
// предаването нарушава requires-а на читателя — ОБРОЧЕНО с контрапример.
fn bad_pass_mutable(n: i64) -> i64 {
    let w = world_new()
    if n > 0 {
        world_freeze(w)
    }
    let r = ok_shared_reader(w)
    world_free(w)
    return r - r
}

spec bad_pass_freed {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Освободен свят не може да се предава: requires world_frozen е ОБРОЧЕНО
// (заедно с use-after-free на самия аргумент) по пътя n = 1.
fn bad_pass_freed(n: i64) -> i64 {
    let w = world_new()
    world_freeze(w)
    if n > 0 {
        world_free(w)
    }
    let r = ok_shared_reader(w)
    return r - r
}

spec bad_pass_twice {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Един свят, двама получатели: първият go прехвърля собствеността, вторият
// предава вече преместен свят — ОБРОЧЕНО (двама писатели/читатели без
// координирана собственост).
fn bad_pass_twice(n: i64) -> i64 !Par {
    let w = world_new()
    world_freeze(w)
    let h1 = go(ok_shared_reader, w)
    let h2 = go(ok_shared_reader, w)
    let a = join(h1)
    let b = join(h2)
    return n - n
}

spec ok_frozen_read_str {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// W1.5: низовете живеят в региона като ОФСЕТИ — frozen свят се чете,
// dump/load носи текстовете position-independent.
fn ok_frozen_read_str(n: i64) -> i64 {
    let w = world_new()
    let v = wvec_new(w)
    wvec_push_str(w, v, "свят")
    world_freeze(w)
    let s = wvec_get_str(w, v, 0)
    world_free(w)
    return n - n
}

spec bad_push_str_frozen {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// W1.5: низов push върху замразен свят — mutate-after-freeze. Freeze-ът е
// само в then-клона ⇒ checker-legal (W1.6 join), верификаторът оборва n > 0.
fn bad_push_str_frozen(n: i64) -> i64 {
    let w = world_new()
    let v = wvec_new(w)
    if n > 0 {
        world_freeze(w)
    }
    wvec_push_str(w, v, "x")
    world_free(w)
    return 0
}

spec bad_go_move {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// W1.5: go(worker, w) прехвърля собствеността точно като chan_send —
// локалният push след това е use-after-move.
fn bad_go_move(n: i64) -> i64 !Par {
    let w = world_new()
    let v = wvec_new(w)
    let h = go(w_worker, w)
    if n > 0 {
        wvec_push(w, v, 3)
    }
    let r = join(h)
    return r - r
}

spec conj_reader {
    input:
        ctx: i64
        n: i64
    output: i64
    requires:
        world_frozen(ctx) && n >= 0
    ensures:
        output >= 0
}

// W2.1: ghost предикатът като КОНЮНКТ. extract_world_ghost минава през AND,
// значи callee-то пак регистрира ctx като frozen — и discharge-ът от страна на
// извикващия трябва да го направи също, иначе assume-guarantee се разминава
// (callee допуска frozen, caller не е длъжен да го гарантира).
fn conj_reader(ctx: i64, n: i64) -> i64 {
    let s = world_state(ctx)
    return n - n
}

spec ok_pass_conj {
    input:
        n: i64
    output: i64
    requires:
        n >= 0
    ensures:
        output >= 0
}

// Замразен свят и n >= 0 от собственото requires — и двата конъюнкта се
// разтоварват, ensures-ът на читателя се поема.
fn ok_pass_conj(n: i64) -> i64 {
    let w = world_new()
    world_freeze(w)
    let r = conj_reader(w, n)
    world_free(w)
    return r - r
}

spec bad_pass_conj {
    input:
        n: i64
    output: i64
    ensures:
        output >= 0
}

// Мутабелен свят и n без предусловие: ОБРОЧЕНИ са и двата конъюнкта —
// ghost-ът (при всеки вход) и аритметиката (контрапример n = -1).
fn bad_pass_conj(n: i64) -> i64 {
    let w = world_new()
    let r = conj_reader(w, n)
    world_free(w)
    return r - r
}

fn main() {
    print(ok_lifecycle(1))
    print(ok_frozen_read(1))
    print(ok_frozen_read_str(1))
    print(bad_freeze_mutate(0))
    print(bad_double_free(0))
    print(bad_use_after_free(0))
    print(bad_push_frozen(0))
    print(bad_push_str_frozen(0))
    print(bad_pass_mutable(0))
    print(bad_pass_freed(0))
    print(ok_pass_conj(1))
    print(bad_pass_conj(1))
}
