// M8b: квадратът е неотрицателен без никакви предусловия — x * x >= 0
// (square правилото не изисква знак на x). Доказва се и за отрицателни x.
spec sq {
    input:
        x: i64
    output: i64
    ensures:
        output >= 0
}

fn sq(x: i64) -> i64 {
    return x * x
}

fn main() {
    print(sq(0 - 7))
}
