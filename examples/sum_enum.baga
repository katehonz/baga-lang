// L3: sum enums (tagged unions) — constructors, match with bindings,
// payload-less variants, qualified paths, struct field, Vec<enum>.
enum Res { Ok(i64), Err(str) }
enum Shape { Pt, Circ(i64) }

fn describe(r: Res) -> str {
    return match r {
        Ok(v) => "ok ${v}",
        Err(e) => "err ${e}",
    }
}

fn area(s: Shape) -> i64 {
    return match s {
        Pt => 0,
        Circ(r) => 3 * r * r,
    }
}

fn main() {
    print(describe(Ok(42)))
    print(describe(Err("лошо")))

    let s = Circ(7)
    print(match s { Pt => 0, Circ(r) => r, })
    print(match s { Shape::Pt => 1, Shape::Circ(r) => r + 1, })
    print(area(s))
    print(area(Pt))

    // payload-less variant as a value; enum as fn param/return
    let p: Shape = Pt
    print(area(p))

    // nested sum enum + match in match
    let w = Ok(5)
    print(match w {
        Ok(v) => match s { Pt => v, Circ(r) => v + r, },
        Err(e) => 0,
    })
}
