fn main() {
    print(6 & 3)             // 2
    print(6 | 3)             // 7
    print(6 ^ 3)             // 5
    print(1 << 4)            // 16
    print(256 >> 4)          // 16
    print(1 + 2 << 3)        // 24  (shift binds looser than +)
    print(5 & 3 | 8)         // 9   (& tighter than |)
    print(5 ^ 3 & 1)         // 4   (& tighter than ^)
    print(4294967295 >> 8)   // 16777215
}
