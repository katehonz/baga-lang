// LP9 — match върху низ сравнява СЪДЪРЖАНИЕ, не указатели.
// Регресия: преди това C бекендът емитуваше `int64_t _mv = s; if (_mv == "a")`
// (указателно равенство) и с изчислен низ винаги падаше в `_` — тихо грешен
// отговор, без compile грешка. LLVM бекендът имаше същото през ptrtoint.
// Литералният случай минаваше само по случайност (интернинг на низовете).
//
// Използваме concat (builtin), а не std/str, за да е покрит и от self
// компилатора (LP7 паритет) — импортираните fn резултати са извън неговите
// типови предикати.

// низов параметър — покрива и случая, в който типът на scrutinee-то не е
// известен на емитера, но патернът е низов литерал
fn classify(s: str) -> i64 {
    return match s {
        "alpha" => 1,
        "beta" => 2,
        "gamma" => 3,
        _ => 99,
    }
}

fn main() {
    // изчислен низ — не сочи към литерала, така че указателното равенство
    // със сигурност би сгрешило
    let вычислен = concat("be", "ta")
    print(match вычислен {
        "alpha" => 1,
        "beta" => 2,
        "gamma" => 3,
        _ => 99,
    })

    // литерал (интернинг случай — работеше и преди)
    let литерал = "gamma"
    print(match литерал {
        "alpha" => 10,
        "beta" => 20,
        "gamma" => 30,
        _ => 90,
    })

    // без съвпадение → wildcard
    let друго = concat("ome", "ga")
    print(match друго {
        "alpha" => 100,
        _ => 999,
    })

    // низов параметър
    print(classify(concat("al", "pha")))
    print(classify(concat("be", "ta")))
    print(classify(concat("zz", "z")))
}
