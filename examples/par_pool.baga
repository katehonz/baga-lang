// par_pool.baga — bounded worker pool via pool_map(fn, vec, nworkers)
// Cloud pattern: fan-out over a batch with a fixed concurrency limit.

fn square(x: i64) -> i64 {
    return x * x
}

fn main() -> i64 !Par {
    let xs = vec_new()
    let mut i: i64 = 1
    while i <= 10 {
        vec_push(xs, i)
        i = i + 1
    }
    // at most 4 OS threads for 10 jobs
    let ys = pool_map(square, xs, 4)
    let mut sum: i64 = 0
    i = 0
    while i < vec_len(ys) {
        sum = sum + vec_get(ys, i)
        i = i + 1
    }
    print(sum)
    // 1^2+...+10^2 = 385
    return sum
}
