// Spec с изпълними гаранции (ensures)
spec факториел {
    input:
        n: i64
    output: i64
    requires:
        n >= 0
    ensures:
        output > 0,
        n <= 1 || output >= n
}

fn факториел(n: i64) -> i64 {
    if n <= 1 {
        return 1
    }
    return n * факториел(n - 1)
}

fn main() {
    print(факториел(10))
}
