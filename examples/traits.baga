// traits.baga — M23: trait декларации + impl per тип + статичен dispatch.
// Методно извикване obj.m(args); trait bounds на generic fn: fn f<T: Show>(…).
struct Rect { w: i64, h: i64 }

trait Area {
    fn area(self) -> i64
}

trait Scale {
    fn scale(self, k: i64) -> Rect
}

impl Area for Rect {
    fn area(self: Rect) -> i64 {
        return self.w * self.h
    }
}

impl Scale for Rect {
    fn scale(self: Rect, k: i64) -> Rect {
        return Rect { w: self.w * k, h: self.h * k }
    }
}

impl Area for i64 {
    fn area(self: i64) -> i64 {
        return self
    }
}

fn total<T: Area>(x: T) -> i64 {
    return x.area()
}

fn main() {
    let r = Rect { w: 3, h: 4 }
    print(r.area())
    print(r.scale(10).area())
    print(total(r))
    print(total(21))
}
