// otel_test.baga — C8 W3C traceparent + OTLP/JSON export lite.

import "otelbaga/otel.baga"
import "std/str/str.baga"
import "std/os/os.baga"

fn check(name: str, ok: bool) {
    if ok {
        print(concat("ok ", name))
    } else {
        eprintln(concat("FAIL ", name))
        exit(1)
    }
}

fn main() -> i64 !Random !Time !IO {
    let sample = "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01"
    let t = otel_parse_traceparent(sample)
    check("parse_ok", t.ok == 1)
    check("trace_id", t.trace_id == "4bf92f3577b34da6a3ce929d0e0e4736")
    check("span_id", t.span_id == "00f067aa0ba902b7")
    check("flags", t.flags == "01")
    check("format", otel_format(t) == sample)

    // uppercase hex accepted, lowercased
    let t2 = otel_parse_traceparent("00-4BF92F3577B34DA6A3CE929D0E0E4736-00F067AA0BA902B7-01")
    check("upper", t2.ok == 1 && t2.trace_id == "4bf92f3577b34da6a3ce929d0e0e4736")

    check("bad_parts", otel_parse_traceparent("00-only").ok == 0)
    check("bad_len", otel_parse_traceparent("00-abcd-ef-01").ok == 0)
    check("zero_trace", otel_parse_traceparent(concat(concat("00-", str_repeat("0", 32)), concat("-", concat(str_repeat("0", 16), "-01")))).ok == 0)

    let root = otel_new_trace()?
    check("new_ok", root.ok == 1 && len(root.trace_id) == 32 && len(root.span_id) == 16)
    let child = otel_child(root)?
    check("child_same_trace", child.trace_id == root.trace_id)
    check("child_new_span", child.span_id != root.span_id)

    let from = otel_from_header(sample)?
    check("from_header", from.ok == 1 && from.trace_id == "4bf92f3577b34da6a3ce929d0e0e4736")
    check("header_name", otel_header_name() == "traceparent")
    check("trim", otel_parse_traceparent(concat("  ", concat(sample, "  "))).ok == 1)
    check("ver_ff", otel_parse_traceparent("ff-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01").ok == 0)
    check("sampled", otel_sampled(t) == 1)
    check("not_sampled", otel_sampled(otel_parse_traceparent("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-00")) == 0)

    // OTLP/JSON export
    let sp = otel_span_now("GET /hello", root, 2)?
    let sp2 = otel_span_end(sp)?
    let js = otel_span_to_otlp_json(sp2, "otel_test")
    check("otlp_has_resource", str_find(js, "resourceSpans") >= 0)
    check("otlp_service", str_find(js, "otel_test") >= 0 || str_find(js, "service.name") >= 0)
    check("otlp_b64", str_find(js, "traceId") >= 0)
    check("otlp_no_parent", str_find(js, "parentSpanId") < 0)
    let ch = otel_span_child("db.query", sp2, 3)?
    let chj = otel_span_to_otlp_json(ch, "otel_test")
    check("child_parent", str_find(chj, "parentSpanId") >= 0)
    check("child_name", str_find(chj, "db.query") >= 0)
    // known hex → base64: "00" → "AA=="
    check("b64_00", otel_hex_to_b64_fixed("00") == "AA==")
    let path = "/tmp/baga_otel_export_test.ndjson"
    unlink(path)?
    check("export_file", otel_export_span_file(path, sp2, "otel_test")? == 0)
    let body = read_file(path)?
    check("file_has_span", str_find(body, "GET /hello") >= 0)

    print("otel_test: all passed")
    return 0
}
