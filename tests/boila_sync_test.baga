// boila_sync_test.baga — P30 delayed fsync: close still makes rows durable.
// Default BOILA_SYNC_EVERY=1; also green with EVERY=64 / COMMIT_WINDOW_MS.

import "boilaDB/server/databases.baga"
import "boilaDB/server/exec_server.baga"
import "boilaDB/sql/exec_scan.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn check(fails: Vec<i64>, name: str, cond: bool) {
    if cond {
        print(concat("  ok  ", name))
    } else {
        print(concat("  FAIL ", name))
        vec_push(fails, 1)
    }
}

fn wipe_shard(prefix: str) -> i64 !IO {
    unlink(concat(prefix, ".wal"))?
    unlink(concat(prefix, ".manifest"))?
    unlink(concat(prefix, ".manifest.log"))?
    let mut g: i64 = 1
    while g <= 40 {
        unlink(concat(concat(prefix, ".sst."), int_to_str(g)))?
        unlink(concat(concat(prefix, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

fn wipe(root: str) -> i64 !IO {
    wipe_shard(concat(root, "/.meta"))?
    wipe_shard(concat(root, "/boila.db"))?
    return 0
}

fn main() -> i64 !IO !Time !Par {
    print("boila_sync_test:")
    let fails: Vec<i64> = vec_new()
    let root = "/tmp/baga_boila_sync"
    wipe(root)?
    let mut srv = boila_server_open(root, 1, 8, 3, 4)?
    check(fails, "open", srv.ok == 1)
    let c = boila_server_exec(srv, "boila", "CREATE TABLE t (id BIGINT, v TEXT, PRIMARY KEY (id))")?
    srv = c.srv
    check(fails, "create", c.ok == 1)
    let mut i: i64 = 0
    let mut okc: i64 = 0
    while i < 80 {
        let sql = concat(concat("INSERT INTO t (id, v) VALUES (", int_to_str(i)), ", 'x')")
        let o = boila_server_exec(srv, "boila", sql)?
        srv = o.srv
        if o.ok == 1 {
            okc = okc + 1
        }
        i = i + 1
    }
    check(fails, "insert80", okc == 80)
    boila_server_close(srv)?
    let mut srv2 = boila_server_open(root, 1, 8, 3, 4)?
    check(fails, "reopen", srv2.ok == 1)
    let q = boila_server_exec(srv2, "boila", "SELECT count(*) FROM t")?
    srv2 = q.srv
    check(fails, "count", q.ok == 1 && vec_len(q.res.rows) == 1 && vec_get(vec_get(q.res.rows, 0), 0).i == 80)
    boila_server_close(srv2)?
    wipe(root)?
    let n = vec_len(fails)
    if n == 0 {
        print("boila_sync_test: all passed")
        return 0
    }
    print(concat("boila_sync_test: FAILED ", int_to_str(n)))
    return 1
}
