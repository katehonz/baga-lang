// boila_fk_test.baga — P21-3 REFERENCES / foreign keys.
// Column-level REFERENCES, parent-existence check on INSERT/UPDATE
// (23503), and ON DELETE actions (RESTRICT default, CASCADE, SET NULL).

import "boilaDB/server/databases.baga"
import "boilaDB/server/exec_server.baga"
import "boilaDB/core/value.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn check(fails: Vec<i64>, name: str, cond: bool) {
    if cond {
        print(concat("  ok  ", name))
    } else {
        print(concat("  FAIL ", name))
        vec_push(fails, 1)
    }
}

fn wipe_shard_path(prefix: str) -> i64 !IO !Par {
    unlink(concat(prefix, ".wal"))?
    unlink(concat(prefix, ".manifest"))?
    unlink(concat(prefix, ".manifest.log"))?
    let mut g: i64 = 1
    while g <= 60 {
        unlink(concat(concat(prefix, ".sst."), int_to_str(g)))?
        unlink(concat(concat(prefix, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

fn wipe_root(root: str) -> i64 !IO !Par {
    wipe_shard_path(concat(root, "/.meta"))?
    let mut i: i64 = 0
    while i < 2 {
        wipe_shard_path(concat(concat(root, "/boila.db.s"), int_to_str(i)))?
        i = i + 1
    }
    return 0
}

fn celli(out: BoilaSrvOut, r: i64, c: i64) -> i64 {
    return vec_get(vec_get(out.res.rows, r), c).i
}

fn main() -> i64 !IO !Time !Par {
    print("boila_fk_test:")
    let fails: Vec<i64> = vec_new()
    let root = "/tmp/baga_boila_fk_test"
    wipe_root(root)?

    let mut srv = boila_server_open(root, 2, 8, 3, 4)?
    check(fails, "open", srv.ok == 1)

    let c0 = boila_server_exec(srv, "boila", "CREATE TABLE clients (id BIGINT, name TEXT, PRIMARY KEY (id))")?
    srv = c0.srv
    check(fails, "create_parent", c0.ok == 1)

    // column-level REFERENCES (default ON DELETE NO ACTION / RESTRICT)
    let c1 = boila_server_exec(srv, "boila", "CREATE TABLE inv (id BIGINT, client_id BIGINT REFERENCES clients (id), PRIMARY KEY (id))")?
    srv = c1.srv
    check(fails, "create_child", c1.ok == 1)

    let p1 = boila_server_exec(srv, "boila", "INSERT INTO clients (id, name) VALUES (1, 'acme'), (2, 'globex')")?
    srv = p1.srv
    check(fails, "seed_parent", p1.ok == 1)

    // child INSERT: parent exists → ok
    let i1 = boila_server_exec(srv, "boila", "INSERT INTO inv (id, client_id) VALUES (1, 1)")?
    srv = i1.srv
    check(fails, "ins_parent_ok", i1.ok == 1)

    // child INSERT: parent missing → 23503
    let i2 = boila_server_exec(srv, "boila", "INSERT INTO inv (id, client_id) VALUES (2, 999)")?
    srv = i2.srv
    check(fails, "ins_missing_23503", i2.ok == 0 && i2.state == "23503")

    // NULL FK value is allowed
    let i3 = boila_server_exec(srv, "boila", "INSERT INTO inv (id, client_id) VALUES (3, NULL)")?
    srv = i3.srv
    check(fails, "ins_null_ok", i3.ok == 1)

    // child UPDATE to missing parent → 23503
    let u1 = boila_server_exec(srv, "boila", "UPDATE inv SET client_id = 42 WHERE id = 1")?
    srv = u1.srv
    check(fails, "upd_missing_23503", u1.ok == 0 && u1.state == "23503")

    // parent DELETE while referenced → 23503 (RESTRICT)
    let d1 = boila_server_exec(srv, "boila", "DELETE FROM clients WHERE id = 1")?
    srv = d1.srv
    check(fails, "del_referenced_23503", d1.ok == 0 && d1.state == "23503")

    // parent DELETE when not referenced → ok
    let d2 = boila_server_exec(srv, "boila", "DELETE FROM clients WHERE id = 2")?
    srv = d2.srv
    check(fails, "del_unreferenced_ok", d2.ok == 1)

    // ON DELETE CASCADE
    let c2 = boila_server_exec(srv, "boila", "CREATE TABLE invc (id BIGINT, client_id BIGINT REFERENCES clients (id) ON DELETE CASCADE, PRIMARY KEY (id))")?
    srv = c2.srv
    let p2 = boila_server_exec(srv, "boila", "INSERT INTO clients (id, name) VALUES (10, 'cascade-co')")?
    srv = p2.srv
    let i4 = boila_server_exec(srv, "boila", "INSERT INTO invc (id, client_id) VALUES (1, 10), (2, 10)")?
    srv = i4.srv
    check(fails, "cascade_seed", c2.ok == 1 && p2.ok == 1 && i4.ok == 1)
    let d3 = boila_server_exec(srv, "boila", "DELETE FROM clients WHERE id = 10")?
    srv = d3.srv
    let q3 = boila_server_exec(srv, "boila", "SELECT count(*) FROM invc")?
    srv = q3.srv
    check(fails, "cascade_deletes", d3.ok == 1 && q3.ok == 1 && celli(q3, 0, 0) == 0)

    // ON DELETE SET NULL
    let c3 = boila_server_exec(srv, "boila", "CREATE TABLE invn (id BIGINT, client_id BIGINT REFERENCES clients (id) ON DELETE SET NULL, PRIMARY KEY (id))")?
    srv = c3.srv
    let p3 = boila_server_exec(srv, "boila", "INSERT INTO clients (id, name) VALUES (20, 'null-co')")?
    srv = p3.srv
    let i5 = boila_server_exec(srv, "boila", "INSERT INTO invn (id, client_id) VALUES (1, 20)")?
    srv = i5.srv
    check(fails, "setnull_seed", c3.ok == 1 && p3.ok == 1 && i5.ok == 1)
    let d4 = boila_server_exec(srv, "boila", "DELETE FROM clients WHERE id = 20")?
    srv = d4.srv
    let q4 = boila_server_exec(srv, "boila", "SELECT client_id FROM invn WHERE id = 1")?
    srv = q4.srv
    check(fails, "setnull_nulls", d4.ok == 1 && q4.ok == 1 && vec_get(vec_get(q4.res.rows, 0), 0).tag == boila_v_null())

    // P29: same-txn parent INSERT then child (PK seek through buffer)
    let tx = boila_server_exec(srv, "boila", "BEGIN")?
    srv = tx.srv
    let tp = boila_server_exec(srv, "boila", "INSERT INTO clients (id, name) VALUES (30, 'txn-co')")?
    srv = tp.srv
    let tc = boila_server_exec(srv, "boila", "INSERT INTO inv (id, client_id) VALUES (30, 30)")?
    srv = tc.srv
    let tcm = boila_server_exec(srv, "boila", "COMMIT")?
    srv = tcm.srv
    check(fails, "same_txn_pk", tx.ok == 1 && tp.ok == 1 && tc.ok == 1 && tcm.ok == 1)

    // P29: REFERENCES a UNIQUE non-PK column
    let k0 = boila_server_exec(srv, "boila", "CREATE TABLE pcode (id BIGINT, code TEXT, PRIMARY KEY (id))")?
    srv = k0.srv
    let k1 = boila_server_exec(srv, "boila", "CREATE UNIQUE INDEX pcode_code ON pcode (code)")?
    srv = k1.srv
    let k2 = boila_server_exec(srv, "boila", "CREATE TABLE ccode (id BIGINT, code TEXT REFERENCES pcode (code), PRIMARY KEY (id))")?
    srv = k2.srv
    let k3 = boila_server_exec(srv, "boila", "INSERT INTO pcode (id, code) VALUES (1, 'BG')")?
    srv = k3.srv
    let k4 = boila_server_exec(srv, "boila", "INSERT INTO ccode (id, code) VALUES (1, 'BG')")?
    srv = k4.srv
    let k5 = boila_server_exec(srv, "boila", "INSERT INTO ccode (id, code) VALUES (2, 'XX')")?
    srv = k5.srv
    check(fails, "uniq_parent_ok", k0.ok == 1 && k1.ok == 1 && k2.ok == 1 && k3.ok == 1 && k4.ok == 1)
    check(fails, "uniq_parent_23503", k5.ok == 0 && k5.state == "23503")

    // P29: child index on FK — CASCADE still finds children
    let x0 = boila_server_exec(srv, "boila", "CREATE INDEX invc2_cid ON inv (client_id)")?
    srv = x0.srv
    let x1 = boila_server_exec(srv, "boila", "INSERT INTO clients (id, name) VALUES (40, 'ix-co')")?
    srv = x1.srv
    let x2 = boila_server_exec(srv, "boila", "INSERT INTO inv (id, client_id) VALUES (40, 40)")?
    srv = x2.srv
    let x3 = boila_server_exec(srv, "boila", "DELETE FROM clients WHERE id = 40")?
    srv = x3.srv
    check(fails, "child_ix_restrict", x0.ok == 1 && x1.ok == 1 && x2.ok == 1 && x3.ok == 0 && x3.state == "23503")

    boila_server_close(srv)?

    // restart: FK metadata persists
    let mut srv2 = boila_server_open(root, 2, 8, 3, 4)?
    check(fails, "reopen", srv2.ok == 1)
    let r1 = boila_server_exec(srv2, "boila", "INSERT INTO inv (id, client_id) VALUES (50, 777)")?
    srv2 = r1.srv
    check(fails, "restart_missing_23503", r1.ok == 0 && r1.state == "23503")
    boila_server_close(srv2)?

    let n = vec_len(fails)
    if n == 0 {
        print("boila_fk_test: all passed")
        return 0
    }
    print(concat("boila_fk_test: FAILED ", int_to_str(n)))
    return 1
}
