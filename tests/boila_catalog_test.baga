// boila_catalog_test.baga — boilaDB P1: каталог в sys key-space + restart.

import "boilaDB/storage/shards.baga"
import "boilaDB/catalog/schema.baga"
import "boilaDB/catalog/ddl_types.baga"
import "boilaDB/sql/ast.baga"
import "boilaDB/core/value.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn check(fails: Vec<i64>, name: str, cond: bool) {
    if cond {
        print(concat("  ok  ", name))
    } else {
        print(concat("  FAIL ", name))
        vec_push(fails, 1)
    }
}

fn wipe_shards(dir: str, n: i64) -> i64 !IO !Par {
    let mut i: i64 = 0
    while i < n {
        let mut p = dir
        if n > 1 {
            p = concat(concat(dir, ".s"), int_to_str(i))
        }
        unlink(concat(p, ".wal"))?
        unlink(concat(p, ".manifest"))?
        unlink(concat(p, ".manifest.log"))?
        let mut g: i64 = 1
        while g <= 30 {
            unlink(concat(concat(p, ".sst."), int_to_str(g)))?
            unlink(concat(concat(p, ".bloom."), int_to_str(g)))?
            g = g + 1
        }
        i = i + 1
    }
    return 0
}

fn cr_users() -> BoilaCreate {
    let cols: Vec<BoilaColDef> = vec_new()
    vec_push(cols, boila_coldef("id", boila_v_i64()))
    vec_push(cols, boila_coldef("name", boila_v_str()))
    let checks: Vec<Vec<BoilaTokP>> = vec_new()
    return BoilaCreate { table: "users", cols: cols, pk_idx: 0, ttl_sec: 0, checks: checks }
}

fn cr_orders() -> BoilaCreate {
    let cols: Vec<BoilaColDef> = vec_new()
    vec_push(cols, boila_coldef("oid", boila_v_str()))
    vec_push(cols, boila_coldef("amount", boila_v_i64()))
    let checks: Vec<Vec<BoilaTokP>> = vec_new()
    return BoilaCreate { table: "orders", cols: cols, pk_idx: 0, ttl_sec: 0, checks: checks }
}

fn main() -> i64 !IO !Time !Par {
    print("boila_catalog_test:")
    let fails: Vec<i64> = vec_new()
    let dir = "/tmp/baga_boila_catalog_test"
    wipe_shards(dir, 2)?

    let mut s = boila_open(dir, 2, 8, 3)?

    // create + id последователност
    let r1 = boila_cat_create(s, cr_users())?
    s = r1.s
    check(fails, "create_users", r1.ok == 1 && r1.id == 1)
    let r2 = boila_cat_create(s, cr_orders())?
    s = r2.s
    check(fails, "create_orders", r2.ok == 1 && r2.id == 2)

    // дубликат → 42P07
    let r3 = boila_cat_create(s, cr_users())?
    s = r3.s
    check(fails, "dup_42P07", r3.ok == 0 && r3.state == "42P07")

    // by_name
    let r4 = boila_cat_by_name(s, "users")?
    s = r4.s
    check(fails, "by_name_ok", r4.ok == 1 && r4.table.id == 1 && r4.table.pk_idx == 0)
    check(fails, "by_name_cols", vec_len(r4.table.cols) == 2)
    if vec_len(r4.table.cols) == 2 {
        let c1 = vec_get(r4.table.cols, 1)
        check(fails, "by_name_col2", c1.name == "name" && c1.typ == boila_v_str())
    }
    let r5 = boila_cat_by_name(s, "nope")?
    s = r5.s
    check(fails, "missing_42P01", r5.ok == 0 && r5.state == "42P01")

    boila_close(s)?

    // --- restart: каталогът е персистентен ---
    let mut s2 = boila_open(dir, 2, 8, 3)?
    let r6 = boila_cat_by_name(s2, "users")?
    s2 = r6.s
    check(fails, "restart_users", r6.ok == 1 && r6.table.id == 1 && vec_len(r6.table.cols) == 2)
    let r7 = boila_cat_by_name(s2, "orders")?
    s2 = r7.s
    check(fails, "restart_orders", r7.ok == 1 && r7.table.id == 2)
    // следващото id продължава от 3
    let r8 = boila_cat_create(s2, BoilaCreate { table: "t3", cols: cr_orders().cols, pk_idx: 0, ttl_sec: 0, checks: cr_orders().checks })?
    s2 = r8.s
    check(fails, "restart_next_id", r8.ok == 1 && r8.id == 3)
    boila_close(s2)?

    wipe_shards(dir, 2)?
    if vec_len(fails) == 0 {
        print("boila_catalog_test: all passed")
        return 0
    }
    print(concat(concat("boila_catalog_test: FAILED (", int_to_str(vec_len(fails))), ")"))
    return 1
}
