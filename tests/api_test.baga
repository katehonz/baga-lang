// api_test.baga — product-level checks for apps/api (no full server link).
// Avoid importing app.baga (needs fmr_dispatch at link time).

import "../apps/api/models/user.baga"
import "../apps/api/models/post.baga"
import "fmrbaga/jsonx.baga"
import "fmrbaga/openapi.baga"
import "ormbaga/orm.baga"
import "std/str/str.baga"

fn check(name: str, cond: bool) {
    if cond {
        print(concat("  ok  ", name))
    } else {
        print(concat("  FAIL ", name))
    }
}

fn main() -> i64 !Net !IO !Random {
    print("api_test:")

    // openapi includes posts + security
    let doc = jobj_encode(fmr_openapi_doc("api", "1.0.0"))
    check("oas_posts", str_find(doc, "/v1/posts") >= 0)
    check("oas_post_schema", str_find(doc, "PostCreate") >= 0)
    check("oas_post_tag", str_find(doc, "\"posts\"") >= 0)
    check("oas_bearer", str_find(doc, "bearerAuth") >= 0)

    // live DB model smoke
    let db = orm_connect_env()?
    if orm_ok_db(db) == 0 {
        print(concat("  skip db: ", orm_err_db(db)))
        print("api_test: all passed (no db)")
        return 0
    }
    let uq = user_all(db)?
    check("user_all", orm_ok_q(uq) == 1)
    let pq = post_all(orm_db_q(uq), 5, 0)?
    check("post_all", orm_ok_q(pq) == 1)
    // create user + post if empty enough
    let email = "api_test@baga.dev"
    let found = user_find_by_email(orm_db_q(pq), email)?
    let mut db2 = orm_db_q(found)
    let mut uid: i64 = 0
    if orm_ok_q(found) == 1 && orm_nrows(found) >= 1 {
        uid = orm_cell_by_i64(found, 0, "id")
        check("user_exists", uid > 0)
    } else {
        let cr = user_create(db2, email, "ApiTest")?
        db2 = orm_db_exec(cr)
        check("user_create", orm_ok(cr) == 1)
        let f2 = user_find_by_email(db2, email)?
        db2 = orm_db_q(f2)
        check("user_created", orm_ok_q(f2) == 1 && orm_nrows(f2) == 1)
        uid = orm_cell_by_i64(f2, 0, "id")
    }
    let pc = post_create(db2, uid, "hello post", "body text")?
    check("post_create", orm_ok(pc) == 1)
    let pl = post_by_user(orm_db_exec(pc), uid, 5, 0)?
    check("post_by_user", orm_ok_q(pl) == 1 && orm_nrows(pl) >= 1)
    let title = orm_cell_by(pl, 0, "title")
    check("post_title", title == "hello post")
    let pid = orm_cell_by_i64(pl, 0, "id")
    let del = post_delete(orm_db_q(pl), pid)?
    check("post_delete", orm_ok(del) == 1)
    orm_close(orm_db_exec(del))?
    print("api_test: all passed")
    return 0
}
