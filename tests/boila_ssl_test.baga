// boila_ssl_test.baga — boilaDB SSL end-to-end: SSLRequest → 'S' → TLS 1.3
// handshake → PG wire v3 over the encrypted transport (simple + extended
// protocol). Server: boila_pg_serve with BOILA_TLS_CERT/BOILA_TLS_KEY set
// (PEM paths, openssl-provisioned by run_tests.sh). Client: pgbaga
// pg_connect_to with PGSSLMODE=require (both env sets come from
// run_tests.sh — without them the test refuses to run).

import "boilaDB/api/pgwire_serve.baga"
import "boilaDB/server/databases.baga"
import "pgbaga/pg.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/net/tcp.baga"
import "std/time/time.baga"

fn check(fails: Vec<i64>, name: str, cond: bool) {
    if cond {
        print(concat("  ok  ", name))
    } else {
        print(concat("  FAIL ", name))
        vec_push(fails, 1)
    }
}

fn wipe_shard_path(prefix: str) -> i64 !IO !Par {
    unlink(concat(prefix, ".wal"))?
    unlink(concat(prefix, ".manifest"))?
    unlink(concat(prefix, ".manifest.log"))?
    let mut g: i64 = 1
    while g <= 60 {
        unlink(concat(concat(prefix, ".sst."), int_to_str(g)))?
        unlink(concat(concat(prefix, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

fn wipe_root(root: str) -> i64 !IO !Par {
    wipe_shard_path(concat(root, "/.meta"))?
    let mut i: i64 = 0
    while i < 2 {
        wipe_shard_path(concat(concat(root, "/boila.db.s"), int_to_str(i)))?
        i = i + 1
    }
    return 0
}

fn ssl_serve(ctx: i64) -> i64 !IO !Net !Time !Par !Random {
    let lfd = cell2_0(ctx)
    let n = cell2_1(ctx)
    let mut i: i64 = 0
    while i < n {
        let fd = tcp_accept(lfd)?
        if fd >= 0 {
            let srv = boila_server_open("/tmp/baga_boila_ssl_test", 2, 8, 3, 4)?
            let _o = boila_pg_serve(fd, srv)?
        }
        i = i + 1
    }
    return 0
}

fn main() -> i64 !IO !Net !Time !Par !Random {
    print("boila_ssl_test:")
    let fails: Vec<i64> = vec_new()

    let certpath = env("BOILA_TLS_CERT")?
    let keypath = env("BOILA_TLS_KEY")?
    if certpath == "" || keypath == "" {
        eprintln("boila_ssl_test: BOILA_TLS_CERT/BOILA_TLS_KEY not set (run via run_tests.sh)")
        return 1
    }

    let root = "/tmp/baga_boila_ssl_test"
    wipe_root(root)?
    let srv = boila_server_open(root, 2, 8, 3, 4)?
    check(fails, "open", srv.ok == 1)
    let _c = boila_server_close(srv)?

    let port: i64 = 16578
    let lst = tcp_listen(port)?
    check(fails, "listen", lst >= 0)
    go_bg(ssl_serve, cell2(lst, 1))
    sleep_ms(300)

    // no ACL users → trust auth; the point is the transport, not auth
    let conn = pg_connect_to("127.0.0.1", port, "ssluser", "", "boila", 300)?
    check(fails, "pg_ok", conn.ok == 1)
    // the gate: TLS must actually be negotiated, not a silent 'N' fallback
    check(fails, "tls_negotiated", conn.tls == 1)
    if conn.ok == 0 {
        print(concat("  (pg err ", concat(conn.err, ")")))
    }
    if conn.ok == 1 && conn.tls == 1 {
        let r1 = pg_query(conn, "CREATE TABLE ssl_t (id BIGINT, nm TEXT, PRIMARY KEY (id))")?
        check(fails, "create", pg_ok(r1) == 1)
        if pg_ok(r1) == 0 {
            print(concat("  (create err ", concat(pg_err(r1), ")")))
        }
        let r2 = pg_query(pg_conn_of(r1), "INSERT INTO ssl_t (id, nm) VALUES (1, 'alfa'), (2, 'beta')")?
        check(fails, "insert", pg_ok(r2) == 1)
        if pg_ok(r2) == 0 {
            print(concat("  (insert err ", concat(pg_err(r2), ")")))
        }
        let r3 = pg_query(pg_conn_of(r2), "SELECT id, nm FROM ssl_t ORDER BY id")?
        check(fails, "select_ok", pg_ok(r3) == 1)
        check(fails, "select_rows", pg_nrows(r3) == 2)
        check(fails, "cell_1a", pg_cell(r3, 0, 1) == "alfa")
        check(fails, "cell_2b", pg_cell(r3, 1, 1) == "beta")
        check(fails, "cell_1id", pg_cell_i64(r3, 0, 0) == 1)
        // extended protocol over TLS (Parse/Bind/Describe/Execute/Sync)
        let vals: Vec<str> = vec_new()
        vec_push(vals, "3")
        vec_push(vals, "gama")
        let nulls: Vec<i64> = vec_new()
        vec_push(nulls, 0)
        vec_push(nulls, 0)
        let r4 = pg_query_params(pg_conn_of(r3), "INSERT INTO ssl_t (id, nm) VALUES ($1, $2)", vals, nulls)?
        check(fails, "ext_insert", pg_ok(r4) == 1)
        if pg_ok(r4) == 0 {
            print(concat("  (ext_insert err ", concat(pg_err(r4), ")")))
        }
        let r5 = pg_query(pg_conn_of(r4), "SELECT nm FROM ssl_t WHERE id = 3")?
        check(fails, "ext_select", pg_ok(r5) == 1 && pg_nrows(r5) == 1 && pg_cell(r5, 0, 0) == "gama")
        pg_close(pg_conn_of(r5))?
    }

    let n = vec_len(fails)
    if n == 0 {
        print("boila_ssl_test: all passed")
        return 0
    }
    print(concat("boila_ssl_test: FAILED ", int_to_str(n)))
    return 1
}
