// orm_test.baga — migrations + table CRUD against baga_orm.

import "ormbaga/orm.baga"
import "ormbaga/migrate.baga"
import "ormbaga/schema.baga"
import "ormbaga/sql.baga"
import "ormbaga/pool.baga"
import "std/str/str.baga"

fn check(name: str, cond: bool) {
    if cond {
        print(concat("  ok  ", name))
    } else {
        print(concat("  FAIL ", name))
    }
}

fn main() -> i64 !Net !IO !Random !Par {
    print("orm_test:")

    // pure SQL quoting
    check("sql_lit_escape", sql_lit("a'b") == "'a''b'")
    check("sql_ident", sql_ident("users") == "users")
    check("sql_ident_q", sql_ident_q("users") == "\"users\"")
    check("sql_i64_neg", sql_i64(0 - 42) == "-42")
    check("sql_ident_empty", sql_ident("") == "")
    let idents: Vec<str> = vec_new()
    vec_push(idents, "id")
    vec_push(idents, "name")
    check("sql_ident_list", sql_ident_list(idents) == "id, name")

    let db0 = orm_connect_env()?
    check("connect", orm_ok_db(db0) == 1)
    if orm_ok_db(db0) == 0 {
        print(concat("  connect err: ", orm_err_db(db0)))
        print("orm_test: FAILED (connect — need baga_orm DB + bagatest)")
        return 1
    }
    let mut db = db0
    let set = ormbaga_migrations()

    // clean slate: down all, then up
    let down_all = migrate_down(db, set, 100)?
    db = migrate_db(down_all)
    check("down_all_ok", migrate_is_ok(down_all) == 1)

    let cur0 = migrate_current(db)?
    db = orm_db_c(cur0)
    check("current_empty_0", orm_ok_c(cur0) == 1 && orm_count_n(cur0) == 0)

    let up1 = migrate_up(db, set)?
    db = migrate_db(up1)
    check("up_ok", migrate_is_ok(up1) == 1)
    check("up_applied_3", migrate_applied_n(up1) == 3)

    let cur1 = migrate_current(db)?
    db = orm_db_c(cur1)
    check("current_max_version", orm_ok_c(cur1) == 1 && orm_count_n(cur1) == 20260803003)

    let up2 = migrate_up(db, set)?
    db = migrate_db(up2)
    check("up_idempotent", migrate_is_ok(up2) == 1 && migrate_applied_n(up2) == 0)

    let st = migrate_status(db, set)?
    db = orm_db_q(st)
    check("status_3", orm_ok_q(st) == 1 && orm_nrows(st) == 3)

    // combined status text (set ∪ history) that keeps the session
    let stt = migrate_status_text(db, set)?
    db = stt.db
    let want_stt = concat("20260803001 create_users [applied]\n",
        concat("20260803002 create_posts [applied]\n",
            "20260803003 index_posts_user_id [applied]\n"))
    check("status_text_all_applied", stt.text == want_stt)
    check("status_text_keeps_db", orm_ok_db(db) == 1)

    // duplicate versions are rejected before touching the DB
    let mut dupset = migrate_set_new()
    dupset = migrate_add(dupset, 1, "a", "SELECT 1", "SELECT 1")
    dupset = migrate_add(dupset, 1, "b", "SELECT 1", "SELECT 1")
    let dupup = migrate_up(db, dupset)?
    db = migrate_db(dupup)
    check("dup_version_rejected", migrate_is_ok(dupup) == 0)
    check("dup_version_err", migrate_err_str(dupup) == "duplicate migration version 1")
    let dupdown = migrate_down(db, dupset, 1)?
    db = migrate_db(dupdown)
    check("dup_version_rejected_down", migrate_is_ok(dupdown) == 0)

    // CRUD users
    let cols = vec_new()
    vec_push(cols, "email")
    vec_push(cols, "name")
    let vals = vec_new()
    vec_push(vals, "test@baga.dev")
    vec_push(vals, "Tester")
    let ins = orm_insert_strs(db, "users", cols, vals)?
    db = orm_db_exec(ins)
    check("insert_user", orm_ok(ins) == 1)

    let q = orm_where_eq_str(db, "users", "email", "test@baga.dev")?
    db = orm_db_q(q)
    check("where_email", orm_ok_q(q) == 1 && orm_nrows(q) == 1)
    check("name_cell", orm_cell_by(q, 0, "name") == "Tester")
    let uid = orm_cell_by_i64(q, 0, "id")
    check("id_positive", uid > 0)

    let find = orm_find_i64(db, "users", "id", uid)?
    db = orm_db_q(find)
    check("find_by_id", orm_ok_q(find) == 1 && orm_nrows(find) == 1)

    let ucols = vec_new()
    vec_push(ucols, "name")
    let uvals = vec_new()
    vec_push(uvals, "Tester2")
    let upd = orm_update_by_id(db, "users", uid, ucols, uvals)?
    db = orm_db_exec(upd)
    check("update", orm_ok(upd) == 1)

    let q2 = orm_find_i64(db, "users", "id", uid)?
    db = orm_db_q(q2)
    check("updated_name", orm_cell_by(q2, 0, "name") == "Tester2")

    // posts FK
    let pcols = vec_new()
    vec_push(pcols, "user_id")
    vec_push(pcols, "title")
    vec_push(pcols, "body")
    let plits = vec_new()
    vec_push(plits, sql_i64(uid))
    vec_push(plits, sql_lit("t1"))
    vec_push(plits, sql_lit("b1"))
    let pins = orm_insert_lits(db, "posts", pcols, plits)?
    db = orm_db_exec(pins)
    check("insert_post", orm_ok(pins) == 1)

    let pc = orm_count(db, "posts")?
    db = orm_db_c(pc)
    check("posts_count", orm_ok_c(pc) == 1 && orm_count_n(pc) >= 1)

    // quote safety / params: email with quote (parameterized path)
    let cols2 = vec_new()
    vec_push(cols2, "email")
    vec_push(cols2, "name")
    let vals2 = vec_new()
    vec_push(vals2, "o'hara@baga.dev")
    vec_push(vals2, "O'Hara")
    let ins2 = orm_insert_strs(db, "users", cols2, vals2)?
    db = orm_db_exec(ins2)
    check("insert_quoted", orm_ok(ins2) == 1)
    let q3 = orm_where_eq_str(db, "users", "email", "o'hara@baga.dev")?
    db = orm_db_q(q3)
    check("find_quoted", orm_ok_q(q3) == 1 && orm_nrows(q3) == 1)
    check("name_quoted", orm_cell_by(q3, 0, "name") == "O'Hara")

    // INSERT … RETURNING * (id without re-query)
    let cols3 = vec_new()
    vec_push(cols3, "email")
    vec_push(cols3, "name")
    let vals3 = vec_new()
    vec_push(vals3, "ret@baga.dev")
    vec_push(vals3, "Returning")
    let ret = orm_insert_returning_strs(db, "users", cols3, vals3)?
    db = orm_db_q(ret)
    check("insert_returning", orm_ok_q(ret) == 1 && orm_nrows(ret) == 1)
    let rid = orm_cell_by_i64(ret, 0, "id")
    check("returning_id", rid > 0)
    check("returning_name", orm_cell_by(ret, 0, "name") == "Returning")
    let delr = orm_delete_by_id(db, "users", rid)?
    db = orm_db_exec(delr)
    check("delete_returning_row", orm_ok(delr) == 1)

    // pure SQL page helpers
    check("sql_page", sql_page("SELECT * FROM t", 10, 20) == "SELECT * FROM t LIMIT 10 OFFSET 20")
    check("sql_offset", sql_offset("SELECT 1", 5) == "SELECT 1 OFFSET 5")

    // ping
    let ping = orm_ping(db)?
    db = orm_db_q(ping)
    check("orm_ping", orm_ok_q(ping) == 1 && orm_cell_i64(ping, 0, 0) == 1)

    // raw params API
    let pv = vec_new()
    vec_push(pv, "param@baga.dev")
    let pq = orm_query_params_str(db, "SELECT $1::text AS e", pv)?
    db = orm_db_q(pq)
    check("orm_params", orm_ok_q(pq) == 1 && orm_cell(pq, 0, 0) == "param@baga.dev")

    let del = orm_delete_by_id(db, "users", uid)?
    db = orm_db_exec(del)
    check("delete_cascades_ok", orm_ok(del) == 1)
    // posts for that user should be gone (ON DELETE CASCADE)
    let pc2 = orm_where_eq_i64(db, "posts", "user_id", uid)?
    db = orm_db_q(pc2)
    check("cascade", orm_ok_q(pc2) == 1 && orm_nrows(pc2) == 0)

    // NULL-capable typed paths (nullable probe table)
    let mkdrop = orm_exec(db, "DROP TABLE IF EXISTS orm_null_probe")?
    db = orm_db_exec(mkdrop)
    let mk = orm_exec(db, "CREATE TABLE orm_null_probe (id BIGSERIAL PRIMARY KEY, note TEXT)")?
    db = orm_db_exec(mk)
    check("null_probe_table", orm_ok(mk) == 1)
    let ncols = vec_new()
    vec_push(ncols, "note")
    let nvals = vec_new()
    vec_push(nvals, "hello")
    let nnulls = vec_new()
    vec_push(nnulls, 0)
    let nins = orm_insert_full(db, "orm_null_probe", ncols, nvals, nnulls)?
    db = orm_db_exec(nins)
    check("insert_full_value", orm_ok(nins) == 1)
    let nvals2 = vec_new()
    vec_push(nvals2, "")
    let nnulls2 = vec_new()
    vec_push(nnulls2, 1)
    let nret = orm_insert_returning_full(db, "orm_null_probe", ncols, nvals2, nnulls2)?
    db = orm_db_q(nret)
    check("insert_returning_full", orm_ok_q(nret) == 1 && orm_nrows(nret) == 1)
    let nid = orm_cell_by_i64(nret, 0, "id")
    check("null_inserted", orm_isnull(nret, 0, orm_col_index(nret, "note")) == 1)
    let nup_cols = vec_new()
    vec_push(nup_cols, "note")
    let nup_vals = vec_new()
    vec_push(nup_vals, "x")
    let nup_nulls = vec_new()
    vec_push(nup_nulls, 1)
    let nup = orm_update_by_id_full(db, "orm_null_probe", nid, nup_cols, nup_vals, nup_nulls)?
    db = orm_db_exec(nup)
    check("update_full_null", orm_ok(nup) == 1)
    let nq = orm_find_i64(db, "orm_null_probe", "id", nid)?
    db = orm_db_q(nq)
    check("update_full_null_held", orm_ok_q(nq) == 1 && orm_isnull(nq, 0, orm_col_index(nq, "note")) == 1)
    let badcols = vec_new()
    vec_push(badcols, "note")
    let badvals = vec_new()
    let badnulls = vec_new()
    vec_push(badnulls, 0)
    let badins = orm_insert_full(db, "orm_null_probe", badcols, badvals, badnulls)?
    db = orm_db_exec(badins)
    check("insert_full_mismatch", orm_ok(badins) == 0)
    let ndrop = orm_exec(db, "DROP TABLE orm_null_probe")?
    db = orm_db_exec(ndrop)
    check("null_probe_drop", orm_ok(ndrop) == 1)

    // rollback one migration
    let d1 = migrate_down(db, set, 1)?
    db = migrate_db(d1)
    check("down_1", migrate_is_ok(d1) == 1 && migrate_applied_n(d1) == 1)
    let st2 = migrate_status(db, set)?
    db = orm_db_q(st2)
    check("status_after_down", orm_ok_q(st2) == 1 && orm_nrows(st2) == 2)
    let cur2 = migrate_current(db)?
    db = orm_db_c(cur2)
    check("current_after_down", orm_ok_c(cur2) == 1 && orm_count_n(cur2) == 20260803002)

    // re-up
    let up3 = migrate_up(db, set)?
    db = migrate_db(up3)
    check("re_up", migrate_is_ok(up3) == 1 && migrate_applied_n(up3) == 1)

    // full down for cleanliness
    let d2 = migrate_down(db, set, 100)?
    db = migrate_db(d2)
    check("full_down", migrate_is_ok(d2) == 1)

    // staged up: apply at most N pending, then the rest
    let us = migrate_up_steps(db, set, 2)?
    db = migrate_db(us)
    check("up_steps_2", migrate_is_ok(us) == 1 && migrate_applied_n(us) == 2)
    let pend = migrate_pending(db, set)?
    db = pend.db
    check("pending_1", pend.count == 1 && pend.next_version == 20260803003)
    let us2 = migrate_up_steps(db, set, 0)?
    db = migrate_db(us2)
    check("up_steps_rest", migrate_is_ok(us2) == 1 && migrate_applied_n(us2) == 1)
    let pend0 = migrate_pending(db, set)?
    db = pend0.db
    check("pending_0", pend0.count == 0 && pend0.next_version == 0)
    let d3 = migrate_down(db, set, 100)?
    db = migrate_db(d3)
    check("down_after_steps", migrate_is_ok(d3) == 1)

    // dirty guard: history [1,3] + set [1,2,3] → out-of-order must fail loud
    let mut skipset = migrate_set_new()
    skipset = migrate_add(skipset, 20260803001, "create_users", "SELECT 1", "SELECT 1")
    skipset = migrate_add(skipset, 20260803003, "index_posts_user_id", "SELECT 1", "SELECT 1")
    let sup = migrate_up(db, skipset)?
    db = migrate_db(sup)
    check("skip_up", migrate_is_ok(sup) == 1 && migrate_applied_n(sup) == 2)
    let dirty = migrate_up(db, set)?
    db = migrate_db(dirty)
    check("dirty_rejected", migrate_is_ok(dirty) == 0)
    check("dirty_err", str_find(migrate_err_str(dirty), "out-of-order migration version 20260803002") >= 0)
    let dclean = migrate_down(db, skipset, 100)?
    db = migrate_db(dclean)
    check("dirty_cleanup", migrate_is_ok(dclean) == 1)
    let up_final = migrate_up(db, set)?
    db = migrate_db(up_final)
    check("up_after_clean", migrate_is_ok(up_final) == 1 && migrate_applied_n(up_final) == 3)

    // prepared statements via ORM
    let pr = orm_prepare(db, "orm_echo", "SELECT $1::int AS n", 1)?
    db = orm_db_exec(pr)
    check("orm_prepare", orm_ok(pr) == 1)
    let pvals = vec_new()
    let pnulls = vec_new()
    pg_param_i64(pvals, pnulls, 99)
    let pqr = orm_query_prepared(db, "orm_echo", pvals, pnulls)?
    db = orm_db_q(pqr)
    check("orm_exec_prepared", orm_ok_q(pqr) == 1 && orm_cell_i64(pqr, 0, 0) == 99)
    let pde = orm_deallocate(db, "orm_echo")?
    db = orm_db_exec(pde)
    check("orm_deallocate", orm_ok(pde) == 1)

    orm_close(db)?

    // connection pool
    let pool = orm_pool_from_env(2)?
    check("pool_size", orm_pool_size(pool) == 2)
    check("pool_idle2", orm_pool_idle(pool) == 2)
    let lease1 = orm_pool_acquire(pool)?
    check("pool_acq1", orm_ok_db(lease1.db) == 1)
    check("pool_idle1", orm_pool_idle(pool) == 1)
    let lease2 = orm_pool_acquire(pool)?
    check("pool_acq2", orm_ok_db(lease2.db) == 1)
    check("pool_idle0", orm_pool_idle(pool) == 0)
    let q1 = orm_query(lease1.db, "SELECT 1 AS n")?
    check("pool_query", orm_ok_q(q1) == 1 && orm_cell_i64(q1, 0, 0) == 1)
    // release updated conn
    let l1b = OrmLease {
        db: orm_db_q(q1),
        slot: lease1.slot,
        free_ch: lease1.free_ch,
        fds: lease1.fds, oks: lease1.oks, pids: lease1.pids, txs: lease1.txs,
        errs: lease1.errs, versions: lease1.versions
    }
    orm_pool_release(l1b)?
    check("pool_idle_after", orm_pool_idle(pool) == 1)
    orm_pool_release(lease2)?
    check("pool_idle_full", orm_pool_idle(pool) == 2)
    // released slot is reusable: written-back state survives checkout
    let lease3 = orm_pool_acquire(pool)?
    check("pool_reacquire", orm_ok_db(lease3.db) == 1)
    let q3p = orm_query(lease3.db, "SELECT 2 AS n")?
    check("pool_reacquire_query", orm_ok_q(q3p) == 1 && orm_cell_i64(q3p, 0, 0) == 2)
    let l3b = OrmLease {
        db: orm_db_q(q3p),
        slot: lease3.slot,
        free_ch: lease3.free_ch,
        fds: lease3.fds, oks: lease3.oks, pids: lease3.pids, txs: lease3.txs,
        errs: lease3.errs, versions: lease3.versions
    }
    orm_pool_release(l3b)?
    check("pool_idle_after_re", orm_pool_idle(pool) == 2)

    // self-heal: force a broken session back into the pool; acquire reconnects
    let lease4 = orm_pool_acquire(pool)?
    orm_close(lease4.db)?
    let dead = OrmLease {
        db: orm_db_bad("dead"),
        slot: lease4.slot,
        free_ch: lease4.free_ch,
        fds: lease4.fds, oks: lease4.oks, pids: lease4.pids, txs: lease4.txs,
        errs: lease4.errs, versions: lease4.versions
    }
    orm_pool_release(dead)?
    let lease5 = orm_pool_acquire(pool)?
    check("pool_heal", orm_ok_db(lease5.db) == 1)
    let q5 = orm_query(lease5.db, "SELECT 3 AS n")?
    check("pool_heal_query", orm_ok_q(q5) == 1 && orm_cell_i64(q5, 0, 0) == 3)
    let l5b = OrmLease {
        db: orm_db_q(q5),
        slot: lease5.slot,
        free_ch: lease5.free_ch,
        fds: lease5.fds, oks: lease5.oks, pids: lease5.pids, txs: lease5.txs,
        errs: lease5.errs, versions: lease5.versions
    }
    orm_pool_release(l5b)?
    check("pool_idle_healed", orm_pool_idle(pool) == 2)

    orm_pool_close(pool)?
    check("pool_closed", true)

    print("orm_test: all passed")
    return 0
}
