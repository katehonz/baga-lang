// boila_vec_test.baga — P8: VECTOR, CREATE INDEX USING hnsw, kNN ops.

import "boilaDB/storage/databases.baga"
import "boilaDB/sql/exec_server.baga"
import "boilaDB/sql/exec_scan.baga"
import "boilaDB/core/value.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn check(fails: Vec<i64>, name: str, cond: bool) {
    if cond {
        print(concat("  ok  ", name))
    } else {
        print(concat("  FAIL ", name))
        vec_push(fails, 1)
    }
}

fn wipe_shard_path(prefix: str) -> i64 !IO !Par {
    unlink(concat(prefix, ".wal"))?
    unlink(concat(prefix, ".manifest"))?
    unlink(concat(prefix, ".manifest.log"))?
    let mut g: i64 = 1
    while g <= 60 {
        unlink(concat(concat(prefix, ".sst."), int_to_str(g)))?
        unlink(concat(concat(prefix, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

fn wipe_root(root: str) -> i64 !IO !Par {
    wipe_shard_path(concat(root, "/.meta"))?
    let mut i: i64 = 0
    while i < 2 {
        wipe_shard_path(concat(concat(root, "/boila.db.s"), int_to_str(i)))?
        i = i + 1
    }
    return 0
}

fn row_id(row: Vec<BoilaVal>) -> str {
    let v = vec_get(row, 0)
    if v.tag == boila_v_i64() {
        return int_to_str(v.i)
    }
    return "?"
}

fn exec1(srv: BoilaServer, sql: str) -> BoilaSrvOut !IO !Time !Par {
    return boila_server_exec(srv, "boila", sql)?
}

fn main() -> i64 !IO !Time !Par {
    print("boila_vec_test:")
    let fails: Vec<i64> = vec_new()
    let root = "/tmp/baga_boila_vec_test"
    wipe_root(root)?

    let mut srv = boila_server_open(root, 2, 8, 3, 4)?
    let c1 = exec1(srv, "CREATE TABLE items (id BIGINT, emb VECTOR(3), PRIMARY KEY (id))")
    srv = c1.srv
    check(fails, "create_table_vector", c1.ok == 1)

    let i1 = exec1(srv, "INSERT INTO items (id, emb) VALUES (1, '[1,0,0]'), (2, '[0,1,0]'), (3, '[0,0,1]'), (4, '[0.9,0.1,0]'), (5, '[0.1,0.9,0]')")
    srv = i1.srv
    check(fails, "insert5", i1.ok == 1 && i1.id == 5)

    let bad = exec1(srv, "INSERT INTO items (id, emb) VALUES (6, '[1,2]')")
    srv = bad.srv
    check(fails, "dim_mismatch", bad.ok == 0)

    let ix = exec1(srv, "CREATE INDEX items_hnsw ON items USING hnsw (emb)")
    srv = ix.srv
    check(fails, "create_hnsw", ix.ok == 1 && ix.kind == 15)

    let ix2 = exec1(srv, "CREATE INDEX items_hnsw ON items USING hnsw (emb)")
    srv = ix2.srv
    check(fails, "dup_hnsw_42710", ix2.ok == 0 && ix2.state == "42710")

    // nearest to [1,0,0] → id 1 then 4
    let q1 = exec1(srv, "SELECT id FROM items WHERE emb <-> '[1,0,0]' LIMIT 2")
    srv = q1.srv
    check(fails, "knn_l2", q1.ok == 1 && vec_len(q1.res.rows) == 2 && row_id(vec_get(q1.res.rows, 0)) == "1")

    let q2 = exec1(srv, "SELECT id FROM items WHERE emb <=> '[0,1,0]' LIMIT 1")
    srv = q2.srv
    check(fails, "knn_cos", q2.ok == 1 && vec_len(q2.res.rows) == 1 && row_id(vec_get(q2.res.rows, 0)) == "2")

    let q3 = exec1(srv, "SELECT id FROM items WHERE emb <#> '[0,0,1]' LIMIT 1")
    srv = q3.srv
    check(fails, "knn_ip", q3.ok == 1 && vec_len(q3.res.rows) >= 1)

    // DML sync: new row searchable
    let i2 = exec1(srv, "INSERT INTO items (id, emb) VALUES (10, '[0,0,0.95]')")
    srv = i2.srv
    let q4 = exec1(srv, "SELECT id FROM items WHERE emb <-> '[0,0,1]' LIMIT 1")
    srv = q4.srv
    check(fails, "dml_insert_sync", q4.ok == 1 && vec_len(q4.res.rows) == 1 && (row_id(vec_get(q4.res.rows, 0)) == "3" || row_id(vec_get(q4.res.rows, 0)) == "10"))

    let d1 = exec1(srv, "DELETE FROM items WHERE id = 10")
    srv = d1.srv
    check(fails, "delete_ok", d1.ok == 1)

    // V5: after delete, kNN still finds remaining vectors (no orphan crash)
    let qdel = exec1(srv, "SELECT id FROM items WHERE emb <-> '[0,0,1]' LIMIT 2")
    srv = qdel.srv
    check(fails, "unindex_knn_ok", qdel.ok == 1 && vec_len(qdel.res.rows) >= 1)

    // delete a seeded point and ensure graph still searchable
    let d2 = exec1(srv, "DELETE FROM items WHERE id = 1")
    srv = d2.srv
    check(fails, "delete_seed", d2.ok == 1)
    let qdel2 = exec1(srv, "SELECT id FROM items WHERE emb <-> '[1,0,0]' LIMIT 1")
    srv = qdel2.srv
    check(fails, "unindex_rev_edges", qdel2.ok == 1 && vec_len(qdel2.res.rows) == 1)

    // restore a near-[1,0,0] vector for restart check
    let i3 = exec1(srv, "INSERT INTO items (id, emb) VALUES (1, '[1,0,0]')")
    srv = i3.srv
    check(fails, "reinsert_1", i3.ok == 1)

    // restart durability
    boila_server_close(srv)?
    let mut srv2 = boila_server_open(root, 2, 8, 3, 4)?
    let q5 = exec1(srv2, "SELECT id FROM items WHERE emb <-> '[1,0,0]' LIMIT 1")
    srv2 = q5.srv
    check(fails, "restart_knn", q5.ok == 1 && vec_len(q5.res.rows) == 1 && row_id(vec_get(q5.res.rows, 0)) == "1")

    let c2 = exec1(srv2, "CREATE TABLE t2 (id BIGINT, x BIGINT, PRIMARY KEY (id))")
    srv2 = c2.srv
    let ixb = exec1(srv2, "CREATE INDEX t2h ON t2 USING hnsw (x)")
    srv2 = ixb.srv
    check(fails, "hnsw_non_vector", ixb.ok == 0)

    boila_server_close(srv2)?
    wipe_root(root)?
    if vec_len(fails) == 0 {
        print("boila_vec_test: ALL PASS")
        return 0
    }
    print(concat("boila_vec_test: FAILS=", int_to_str(vec_len(fails))))
    return 1
}
