// glob_test.baga — globbaga shell-style matching.

import "globbaga/glob.baga"
import "std/str/str.baga"

fn check(name: str, ok: bool) {
    if ok {
        print(concat("ok ", name))
    } else {
        eprintln(concat("FAIL ", name))
        exit(1)
    }
}

fn main() {
    check("exact", glob_match("hello", "hello") == 1)
    check("exact_no", glob_match("hello", "hell") == 0)
    check("star_all", glob_match("*", "anything") == 1)
    check("star_empty", glob_match("*", "") == 1)
    check("prefix", glob_match("user:*", "user:42") == 1)
    check("prefix_no", glob_match("user:*", "admin:1") == 0)
    check("suffix", glob_match("*.baga", "path.baga") == 1)
    check("suffix_no", glob_match("*.baga", "path.md") == 0)
    check("mid", glob_match("a*c", "abc") == 1)
    check("mid_long", glob_match("a*c", "abbbc") == 1)
    check("q_one", glob_match("?.baga", "a.baga") == 1)
    check("q_no", glob_match("?.baga", "ab.baga") == 0)
    check("q_star", glob_match("a?c*", "abcxyz") == 1)
    check("empty_pat", glob_match("", "") == 1)
    check("empty_pat_no", glob_match("", "x") == 0)

    let keys = vec_new()
    vec_push(keys, "user:1")
    vec_push(keys, "user:2")
    vec_push(keys, "admin:1")
    vec_push(keys, "session:abc")
    let hit = glob_filter("user:*", keys)
    check("filter_n", vec_len(hit) == 2)
    check("filter0", vec_get(hit, 0) == "user:1")
    check("filter1", vec_get(hit, 1) == "user:2")

    let none = glob_filter("missing:*", keys)
    check("filter_none", vec_len(none) == 0)

    check("esc_star", glob_match("a\\*b", "a*b") == 1)
    check("esc_star_wild", glob_match("a\\*b", "axb") == 0)
    check("esc_q", glob_match("a\\?", "a?") == 1)
    check("esc_slash", glob_match("\\\\", "\\") == 1)
    check("esc_meta", glob_has_meta("a\\*b") == 0)
    check("has_meta", glob_has_meta("user:*") == 1)
    check("no_meta", glob_has_meta("user:1") == 0)

    check("class", glob_match("[abc]", "b") == 1)
    check("class_no", glob_match("[abc]", "d") == 0)
    check("range", glob_match("[a-c]", "b") == 1)
    check("range_swap", glob_match("[c-a]", "b") == 1)
    check("neg", glob_match("[!0-9]", "a") == 1)
    check("neg_hit", glob_match("[^a]", "a") == 0)
    check("class_rb", glob_match("[]]", "]") == 1)
    check("unclosed", glob_match("[abc", "[abc") == 1)
    check("keys_digit", glob_match("user:[0-9]*", "user:7x") == 1)
    check("keys_digit_no", glob_match("user:[0-9]*", "user:ax") == 0)

    check("star_star", glob_match("**", "xy") == 1)
    check("star_star_mid", glob_match("a**b", "ab") == 1)
    check("star_cross", glob_match("*.baga", "src/a.baga") == 1)

    check("path_star", glob_match_path("*.baga", "src/a.baga") == 0)
    check("path_seg", glob_match_path("*/*.baga", "src/a.baga") == 1)
    check("path_q", glob_match_path("?", "/") == 0)
    check("keys_q_slash", glob_match("?", "/") == 1)
    check("path_class_slash", glob_match_path("[/]", "/") == 0)
    check("path_mid", glob_match_path("a*b", "a/b") == 0)
    check("path_ok", glob_match_path("a*b", "axb") == 1)

    let files = vec_new()
    vec_push(files, "a.baga")
    vec_push(files, "src/a.baga")
    let pf = glob_filter_path("*.baga", files)
    check("filter_path_n", vec_len(pf) == 1)
    check("filter_path0", vec_get(pf, 0) == "a.baga")

    check("utf8_q", glob_match("?", "я") == 0)
    check("utf8_qq", glob_match("??", "я") == 1)

    print("glob_test: all passed")
}
