// decimal_test.baga — bagaDecimal P0 suite (rust-decimal-style money math).

import "bagadecimal/src/decimal.baga"
import "std/str/str.baga"

fn check(name: str, ok: bool) {
    if ok {
        print(concat("ok ", name))
    } else {
        eprintln(concat("FAIL ", name))
        exit(1)
    }
}

fn must_parse(s: str) -> Decimal {
    let r = dec_parse(s)
    if r.ok == 0 {
        eprintln(concat(concat("parse failed: ", s), concat(" — ", r.err)))
        exit(1)
    }
    return r.value
}

fn main() {
    // --- constructors ---
    check("zero", dec_is_zero(dec_zero()) == 1)
    check("one_str", dec_to_string(dec_one()) == "1")
    let p = dec_from_parts(123, 0, 0, 0, 2)
    check("from_parts_scale", dec_scale(p) == 2)
    check("from_parts_str", dec_to_string(p) == "1.23")

    // --- parse / format ---
    check("parse_int", dec_to_string(must_parse("42")) == "42")
    check("parse_neg", dec_to_string(must_parse("-3.5")) == "-3.5")
    check("parse_plus", dec_to_string(must_parse("+0.5")) == "0.5")
    check("parse_trail_zero", dec_to_string(must_parse("1.50")) == "1.50")
    check("parse_lead_dot", dec_to_string(must_parse("0.25")) == "0.25")
    let bad = dec_parse("1.2.3")
    check("parse_bad_dots", bad.ok == 0)
    let bad2 = dec_parse("abc")
    check("parse_bad_alpha", bad2.ok == 0)

    // --- i64 convert ---
    check("from_i64", dec_to_string(dec_from_i64(100)) == "100")
    check("from_i64_scale", dec_to_string(dec_from_i64_scale(202, 2)) == "2.02")
    let ti = dec_to_i64(must_parse("-99"))
    check("to_i64", ti.ok == 1 && ti.value == 0 - 99)

    // --- cmp ---
    check("cmp_lt", dec_lt(must_parse("1.0"), must_parse("1.1")) == 1)
    check("cmp_eq_diff_scale", dec_eq(must_parse("1.0"), must_parse("1.00")) == 1)
    check("cmp_neg", dec_cmp(must_parse("-2"), must_parse("1")) < 0)
    check("abs", dec_to_string(dec_abs(must_parse("-4.2"))) == "4.2")
    check("neg", dec_to_string(dec_neg(must_parse("3"))) == "-3")

    // --- add / sub ---
    let s1 = dec_add(must_parse("1.5"), must_parse("2.25"))
    check("add", s1.ok == 1 && dec_to_string(s1.value) == "3.75")
    let s2 = dec_sub(must_parse("10.00"), must_parse("0.01"))
    check("sub", s2.ok == 1 && dec_to_string(s2.value) == "9.99")
    let s3 = dec_add(must_parse("-1.5"), must_parse("2.0"))
    check("add_mixed_sign", s3.ok == 1 && dec_to_string(s3.value) == "0.5")

    // --- mul ---
    let m1 = dec_mul(must_parse("1.5"), must_parse("2"))
    check("mul", m1.ok == 1 && dec_to_string(m1.value) == "3.0")
    let m2 = dec_mul(must_parse("25.12"), must_parse("0.085"))
    check("mul_tax", m2.ok == 1)
    // 25.12 * 0.085 = 2.1352 (scale may keep trailing zero → 2.13520)
    check("mul_tax_val", dec_to_string_normalized(m2.value) == "2.1352")

    // --- round (money) ---
    let r1 = dec_round_dp(must_parse("2.1352"), 2)
    check("round_dp", r1.ok == 1 && dec_to_string(r1.value) == "2.14")
    let r2 = dec_round_dp(must_parse("1.225"), 2)
    check("round_half_away", r2.ok == 1 && dec_to_string(r2.value) == "1.23")
    let r3 = dec_round_dp(must_parse("-1.225"), 2)
    check("round_half_away_neg", r3.ok == 1 && dec_to_string(r3.value) == "-1.23")

    // rust-decimal README money example: 25.12 * 1.085 → 27.26 at 2 dp
    let price = must_parse("25.12")
    let rate = must_parse("0.085")
    let tax = dec_mul(price, rate)
    check("tax_ok", tax.ok == 1)
    let tax_r = dec_round_dp(tax.value, 2)
    let total = dec_add(price, tax_r.value)
    check("total_ok", total.ok == 1)
    let total_r = dec_round_dp(total.value, 2)
    check("money_total", total_r.ok == 1 && dec_to_string(total_r.value) == "27.26")

    // --- div ---
    let d1 = dec_div_scale(must_parse("10"), must_parse("4"), 2)
    check("div_scale", d1.ok == 1 && dec_to_string(d1.value) == "2.50")
    let d0 = dec_div(must_parse("1"), must_parse("0"))
    check("div_zero", d0.ok == 0)

    // --- normalize string ---
    check("norm", dec_to_string_normalized(must_parse("1.50")) == "1.5")
    check("norm_int", dec_to_string_normalized(must_parse("2.00")) == "2")

    // --- accounting helpers ---
    let mon = dec_money("10.5")
    check("money_scale2", mon.ok == 1 && dec_to_string(mon.value) == "10.50" && dec_is_money(mon.value) == 1)
    let nrm = dec_normalize(must_parse("1.500"))
    check("normalize", dec_scale(nrm) == 1 && dec_to_string(nrm) == "1.5")
    let pct = dec_percent_of(must_parse("200.00"), must_parse("10"))
    check("percent_of", pct.ok == 1 && dec_to_string(pct.value) == "20.00")
    let sm = dec_sum2(must_parse("1.10"), must_parse("2.20"))
    check("sum2", sm.ok == 1 && dec_to_string(sm.value) == "3.30")

    // --- BUG A regression: limb_mul signed overflow (crash / wrong carry) ---
    // limb products >= 2^63 wrapped negative in i64; the carry drain walked
    // out of bounds. The whole upper mantissa range was broken.
    let bma = dec_mul(dec_from_i64(3100000000), dec_from_i64(3100000000))
    check("mul_big_limbs", bma.ok == 1 && dec_to_string(bma.value) == "9610000000000000000")
    let max32 = dec_from_parts(4294967295, 0, 0, 0, 0)
    let bmb = dec_mul(max32, max32)
    check("mul_max32", bmb.ok == 1 && dec_to_string(bmb.value) == "18446744065119617025")
    // 192-bit intermediate + scale-48 → rescale past 28, rescued down to
    // scale 19 so the 96-bit mantissa fits (rust-decimal style)
    let bmc = dec_mul(must_parse("123456789.123456789012345678"), must_parse("9.876543210987654321098765"))
    check("mul_rescale_big", bmc.ok == 1 && dec_to_string(bmc.value) == "1219326312.4676116324950464221")
    let bmd = dec_mul(must_parse("79228162514264337593543950335"), dec_from_i64(1))
    check("mul_max96_identity", bmd.ok == 1 && dec_to_string(bmd.value) == "79228162514264337593543950335")
    // integer part alone overflows 96 bits → loud error, no rescue possible
    let bme = dec_mul(must_parse("79228162514264337593543950335"), dec_from_i64(2))
    check("mul_true_overflow", bme.ok == 0)

    // --- BUG B regression: div_small signed overflow (silent wrong digits) ---
    // single-limb divisor > 2^31: rem * 2^32 + limb wrapped negative.
    let bba = dec_div_scale(dec_from_i64(1), dec_from_i64(3000000000), 28)
    check("div_big_single_limb", bba.ok == 1 && dec_to_string(bba.value) == "0.0000000003333333333333333333")
    let bbb = dec_div_scale(dec_from_i64(1), max32, 20)
    check("div_max32", bbb.ok == 1 && dec_to_string(bbb.value) == "0.00000000023283064371")

    // --- BUG C regression: percent_of pre-rounded the rate to scale 8 ---
    // amount * percent / 100 with one final rounding instead.
    let bca = dec_percent_of(must_parse("999999999.99"), must_parse("33.3333333"))
    check("percent_precise", bca.ok == 1 && dec_to_string(bca.value) == "333333333.00")

    // --- edge coverage ---
    check("parse_empty", dec_parse("").ok == 0)
    check("parse_dash", dec_parse("-").ok == 0)
    check("parse_dot", dec_parse(".").ok == 0)
    check("parse_dot5", dec_to_string(must_parse(".5")) == "0.5")
    check("parse_trailing_dot", dec_to_string(must_parse("1.")) == "1")
    let rd0 = dec_round_dp(must_parse("2.5"), 0)
    check("round_dp0", rd0.ok == 1 && dec_to_string(rd0.value) == "3")
    check("round_dp_bad", dec_round_dp(must_parse("1"), 29).ok == 0)
    check("to_i64_overflow", dec_to_i64(must_parse("9223372036854775808")).ok == 0)
    check("neg_zero_eq", dec_eq(dec_from_parts(0, 0, 0, 1, 2), dec_zero()) == 1)

    print("decimal_test: all passed")
}
