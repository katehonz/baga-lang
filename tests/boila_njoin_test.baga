// boila_njoin_test.baga — P28: N JOIN + EXISTS / IN (SELECT).

import "boilaDB/server/databases.baga"
import "boilaDB/server/exec_server.baga"
import "boilaDB/sql/exec_scan.baga"
import "boilaDB/core/value.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn check(fails: Vec<i64>, name: str, cond: bool) {
    if cond {
        print(concat("  ok  ", name))
    } else {
        print(concat("  FAIL ", name))
        vec_push(fails, 1)
    }
}

fn wipe_shard(prefix: str) -> i64 !IO {
    unlink(concat(prefix, ".wal"))?
    unlink(concat(prefix, ".manifest"))?
    unlink(concat(prefix, ".manifest.log"))?
    let mut g: i64 = 1
    while g <= 40 {
        unlink(concat(concat(prefix, ".sst."), int_to_str(g)))?
        unlink(concat(concat(prefix, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

fn wipe(root: str) -> i64 !IO {
    wipe_shard(concat(root, "/.meta"))?
    wipe_shard(concat(root, "/boila.db"))?
    return 0
}

fn cell(row: Vec<BoilaVal>, ix: i64) -> str {
    let v = vec_get(row, ix)
    if v.tag == 2 { return int_to_str(v.i) }
    if v.tag == 5 { return str_of_bytes(v.b) }
    if v.tag == 0 { return "<null>" }
    return "?"
}

fn exec(srv: BoilaServer, sql: str) -> BoilaSrvOut !IO !Time !Par {
    return boila_server_exec(srv, "boila", sql)?
}

fn main() -> i64 !IO !Time !Par {
    print("boila_njoin_test:")
    let fails: Vec<i64> = vec_new()
    let root = "/tmp/baga_boila_njoin"
    wipe(root)?
    let mut srv = boila_server_open(root, 1, 8, 3, 4)?
    check(fails, "open", srv.ok == 1)
    let a = exec(srv, "CREATE TABLE inv (id BIGINT, cid BIGINT, PRIMARY KEY (id))")?
    srv = a.srv
    let b = exec(srv, "CREATE TABLE cp (id BIGINT, name TEXT, PRIMARY KEY (id))")?
    srv = b.srv
    let c = exec(srv, "CREATE TABLE line (id BIGINT, iid BIGINT, txt TEXT, PRIMARY KEY (id))")?
    srv = c.srv
    check(fails, "ddl", a.ok == 1 && b.ok == 1 && c.ok == 1)
    let i1 = exec(srv, "INSERT INTO inv (id, cid) VALUES (1, 10), (2, 10), (3, 20)")?
    srv = i1.srv
    let i2 = exec(srv, "INSERT INTO cp (id, name) VALUES (10, 'Ана'), (20, 'Борис')")?
    srv = i2.srv
    let i3 = exec(srv, "INSERT INTO line (id, iid, txt) VALUES (1, 1, 'a'), (2, 1, 'b'), (3, 2, 'c')")?
    srv = i3.srv
    check(fails, "seed", i1.ok == 1 && i2.ok == 1 && i3.ok == 1)

    let j2 = exec(srv, "SELECT name, txt FROM inv JOIN cp ON cid = id JOIN line ON iid = id ORDER BY txt")?
    srv = j2.srv
    check(fails, "njoin_ok", j2.ok == 1 && vec_len(j2.res.rows) == 3)
    if vec_len(j2.res.rows) == 3 {
        check(fails, "njoin_a", cell(vec_get(j2.res.rows, 0), 0) == "Ана" && cell(vec_get(j2.res.rows, 0), 1) == "a")
        check(fails, "njoin_c", cell(vec_get(j2.res.rows, 2), 1) == "c")
    }

    let lj = exec(srv, "SELECT txt FROM inv JOIN cp ON cid = id LEFT JOIN line ON iid = id")?
    srv = lj.srv
    check(fails, "left_njoin", lj.ok == 1 && vec_len(lj.res.rows) == 4)

    let ex = exec(srv, "SELECT id FROM inv WHERE EXISTS (SELECT 1 FROM line WHERE iid = id) ORDER BY id")?
    srv = ex.srv
    check(fails, "exists", ex.ok == 1 && vec_len(ex.res.rows) == 2)
    if vec_len(ex.res.rows) >= 1 {
        check(fails, "exists_id", cell(vec_get(ex.res.rows, 0), 0) == "1")
    }

    let nx = exec(srv, "SELECT id FROM inv WHERE NOT EXISTS (SELECT 1 FROM line WHERE iid = id)")?
    srv = nx.srv
    check(fails, "not_exists", nx.ok == 1 && vec_len(nx.res.rows) == 1 && cell(vec_get(nx.res.rows, 0), 0) == "3")

    let inn = exec(srv, "SELECT id FROM inv WHERE id IN (SELECT iid FROM line) ORDER BY id")?
    srv = inn.srv
    check(fails, "in_select", inn.ok == 1 && vec_len(inn.res.rows) == 2)

    let nin = exec(srv, "SELECT id FROM inv WHERE id NOT IN (SELECT iid FROM line)")?
    srv = nin.srv
    check(fails, "not_in_select", nin.ok == 1 && vec_len(nin.res.rows) == 1 && cell(vec_get(nin.res.rows, 0), 0) == "3")

    let bad = exec(srv, "SELECT id FROM inv JOIN cp ON cid = id JOIN line ON iid = id JOIN cp ON cid = id JOIN line ON iid = id JOIN cp ON cid = id JOIN line ON iid = id JOIN cp ON cid = id JOIN line ON iid = id JOIN cp ON cid = id")?
    srv = bad.srv
    check(fails, "join_cap", bad.ok == 0 && bad.state == "0A000")

    boila_server_close(srv)?
    wipe(root)?
    let n = vec_len(fails)
    if n == 0 {
        print("boila_njoin_test: all passed")
        return 0
    }
    print(concat("boila_njoin_test: FAILED ", int_to_str(n)))
    return 1
}
