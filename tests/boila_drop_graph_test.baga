// boila_drop_graph_test.baga — DROP GRAPH name ON table (+ IF EXISTS).

import "boilaDB/server/databases.baga"
import "boilaDB/server/exec_server.baga"
import "boilaDB/core/value.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn check(fails: Vec<i64>, name: str, cond: bool) {
    if cond {
        print(concat("  ok  ", name))
    } else {
        print(concat("  FAIL ", name))
        vec_push(fails, 1)
    }
}

fn wipe_shard_path(prefix: str) -> i64 !IO !Par {
    unlink(concat(prefix, ".wal"))?
    unlink(concat(prefix, ".manifest"))?
    unlink(concat(prefix, ".manifest.log"))?
    let mut g: i64 = 1
    while g <= 60 {
        unlink(concat(concat(prefix, ".sst."), int_to_str(g)))?
        unlink(concat(concat(prefix, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

fn wipe_root(root: str) -> i64 !IO !Par {
    wipe_shard_path(concat(root, "/.meta"))?
    let mut i: i64 = 0
    while i < 2 {
        wipe_shard_path(concat(concat(root, "/boila.db.s"), int_to_str(i)))?
        i = i + 1
    }
    return 0
}

fn exec(srv: BoilaServer, sql: str) -> BoilaSrvOut !IO !Time !Par {
    return boila_server_exec(srv, "boila", sql)?
}

fn main() -> i64 !IO !Time !Par {
    print("boila_drop_graph_test:")
    let fails: Vec<i64> = vec_new()
    let root = "/tmp/baga_boila_drop_graph_test"
    wipe_root(root)?

    let mut srv = boila_server_open(root, 2, 8, 3, 4)?
    let c1 = exec(srv, "CREATE TABLE edges (id BIGINT, src BIGINT, dst BIGINT, w BIGINT, PRIMARY KEY (id))")?
    srv = c1.srv
    let c2 = exec(srv, "INSERT INTO edges (id, src, dst, w) VALUES (1, 1, 2, 1), (2, 2, 3, 1), (3, 1, 3, 5)")?
    srv = c2.srv
    let g1 = exec(srv, "CREATE GRAPH g1 ON edges (src, dst, w)")?
    srv = g1.srv
    check(fails, "seed", c1.ok == 1 && c2.ok == 1 && g1.ok == 1)

    let q1 = exec(srv, "WITH RECURSIVE reach(node, depth) AS (SELECT 1, 0 UNION ALL SELECT dst, 0 FROM edges, reach WHERE src = node AND depth < 2) SELECT node, depth FROM reach")?
    srv = q1.srv
    check(fails, "bfs_before", q1.ok == 1 && vec_len(q1.res.rows) >= 2)

    let d1 = exec(srv, "DROP GRAPH g1 ON edges")?
    srv = d1.srv
    check(fails, "drop_graph", d1.ok == 1 && d1.kind == 24)

    let q2 = exec(srv, "WITH RECURSIVE reach(node, depth) AS (SELECT 1, 0 UNION ALL SELECT dst, 0 FROM edges, reach WHERE src = node AND depth < 2) SELECT node, depth FROM reach")?
    srv = q2.srv
    check(fails, "bfs_after_no_graph", q2.ok == 0)

    let d2 = exec(srv, "DROP GRAPH g1 ON edges")?
    srv = d2.srv
    check(fails, "drop_missing_42704", d2.ok == 0 && d2.state == "42704")

    let d3 = exec(srv, "DROP GRAPH IF EXISTS g1 ON edges")?
    srv = d3.srv
    check(fails, "if_exists", d3.ok == 1)

    let g2 = exec(srv, "CREATE GRAPH g1 ON edges (src, dst, w)")?
    srv = g2.srv
    check(fails, "recreate", g2.ok == 1)
    let q3 = exec(srv, "WITH RECURSIVE reach(node, depth) AS (SELECT 1, 0 UNION ALL SELECT dst, 0 FROM edges, reach WHERE src = node AND depth < 2) SELECT node, depth FROM reach")?
    srv = q3.srv
    check(fails, "bfs_after_recreate", q3.ok == 1 && vec_len(q3.res.rows) >= 2)

    boila_server_close(srv)?

    if vec_len(fails) == 0 {
        print("boila_drop_graph_test: ALL PASS")
        return 0
    }
    print(concat("boila_drop_graph_test: FAILS=", int_to_str(vec_len(fails))))
    return 1
}
