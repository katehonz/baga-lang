// dav_test.baga — протоколът на davbaga, без мрежа и без база.
import "davbaga/dav.baga"
import "testbaga/assert.baga"
import "std/str/str.baga"

fn test_depth() -> i64 !IO {
    assert_eq_i64("empty", dav_depth(""), 0 - 1)
    assert_eq_i64("inf", dav_depth("infinity"), 0 - 1)
    assert_eq_i64("zero", dav_depth("0"), 0)
    assert_eq_i64("one", dav_depth("1"), 1)
    assert_eq_i64("junk", dav_depth("2"), 0 - 2)
    return 0
}

fn test_dest() -> i64 !IO {
    assert_eq_str("abs", dav_url_path("http://127.0.0.1:8085/dav/2/a/b.txt"), "/dav/2/a/b.txt")
    assert_eq_str("path", dav_url_path("/dav/2/a"), "/dav/2/a")
    assert_eq_str("query", dav_url_path("/dav/2/a?x=1"), "/dav/2/a")
    assert_eq_i64("over_default", dav_overwrite(""), 1)
    assert_eq_i64("over_f", dav_overwrite("F"), 0)
    return 0
}

fn test_match() -> i64 !IO {
    assert_eq_i64("none", dav_if_match("", "abc"), 1)
    assert_eq_i64("star", dav_if_match("*", "abc"), 1)
    assert_eq_i64("quoted", dav_if_match("\"abc\"", "abc"), 1)
    assert_eq_i64("other", dav_if_match("\"no\"", "abc"), 0)
    return 0
}

fn test_date() -> i64 !IO {
    assert_eq_str("epoch", dav_http_date(0), "Thu, 01 Jan 1970 00:00:00 GMT")
    assert_eq_str("day", dav_http_date(86400), "Fri, 02 Jan 1970 00:00:00 GMT")
    return 0
}

fn test_xml() -> i64 !IO {
    let one = dav_response("/dav/2/a b", "a & b", 0, 3, "text/plain", "abc", "", "")
    assert_true("href", str_find(one, "/dav/2/a%20b") >= 0)
    assert_true("name", str_find(one, "a &amp; b") >= 0)
    assert_true("len", str_find(one, ">3<") >= 0)
    assert_true("etag", str_find(one, "abc") >= 0)
    let ms = dav_multistatus(one)
    assert_true("root", str_find(ms, "xmlns:D=\"DAV:\"") >= 0)
    assert_true("status", str_find(ms, "HTTP/1.1 200 OK") >= 0)
    return 0
}

fn test_lock() -> i64 !IO {
    assert_eq_i64("self", dav_lock_covers("/a", 0, "/a"), 1)
    assert_eq_i64("child_free", dav_lock_covers("/a", 0, "/a/b"), 0)
    assert_eq_i64("inf_child", dav_lock_covers("/a", 0 - 1, "/a/b"), 1)
    assert_eq_i64("parent_blocked", dav_lock_covers("/a/b", 0, "/a"), 1)
    assert_eq_i64("root_inf", dav_lock_covers("/", 0 - 1, "/a"), 1)
    assert_eq_i64("has", dav_if_has_token("(<opaquelocktoken:aa>)", "opaquelocktoken:aa"), 1)
    assert_eq_i64("miss", dav_if_has_token("(<opaquelocktoken:bb>)", "opaquelocktoken:aa"), 0)
    assert_eq_i64("timeout", dav_timeout_s("Second-120"), 120)
    assert_eq_i64("cap", dav_timeout_s("Infinite"), 86400)
    assert_eq_i64("shared", dav_wants_shared("<D:lockscope><D:shared/></D:lockscope>"), 1)
    let stats = dav_proppatch_stats("<D:propertyupdate xmlns:D=\"DAV:\"><D:set><D:prop><D:displayname>x</D:displayname></D:prop></D:set></D:propertyupdate>")
    assert_true("prop", str_find(stats, "displayname") >= 0)
    assert_true("403", str_find(stats, "403") >= 0)
    return 0
}

fn test_shared_scope() -> i64 !IO {
    let sx = dav_lockdiscovery_scoped("opaquelocktoken:t1", 3600, "me", 0, "/dav/f", "shared")
    assert_true("shared_xml", str_find(sx, "<D:shared/>") >= 0)
    assert_true("no_excl", str_find(sx, "<D:exclusive/>") < 0)
    let ex = dav_lockdiscovery_scoped("opaquelocktoken:t1", 3600, "me", 0, "/dav/f", "exclusive")
    assert_true("excl_xml", str_find(ex, "<D:exclusive/>") >= 0)
    let def = dav_lockdiscovery("opaquelocktoken:t1", 3600, "me", 0, "/dav/f")
    assert_true("default_excl", str_find(def, "<D:exclusive/>") >= 0)
    let lx = dav_lock_xml_scoped("/dav/f", "opaquelocktoken:t1", 60, "o", 1, "shared")
    assert_true("lock_shared", str_find(lx, "<D:shared/>") >= 0)
    return 0
}

fn test_if_eval() -> i64 !IO {
    let mut toks: Vec<str> = vec_new()
    vec_push(toks, "opaquelocktoken:aa")
    vec_push(toks, "opaquelocktoken:bb")
    assert_eq_i64("empty", dav_if_eval("", toks), 1)
    assert_eq_i64("single_hit", dav_if_eval("(<opaquelocktoken:aa>)", toks), 1)
    assert_eq_i64("single_miss", dav_if_eval("(<opaquelocktoken:zz>)", toks), 0)
    assert_eq_i64("or_hit", dav_if_eval("(<opaquelocktoken:zz> OR <opaquelocktoken:aa>)", toks), 1)
    assert_eq_i64("or_miss", dav_if_eval("(<opaquelocktoken:zz> OR <opaquelocktoken:yy>)", toks), 0)
    assert_eq_i64("not_hit", dav_if_eval("(Not <opaquelocktoken:aa>)", toks), 0)
    assert_eq_i64("not_miss", dav_if_eval("(Not <opaquelocktoken:zz>)", toks), 1)
    assert_eq_i64("and_ok", dav_if_eval("(<opaquelocktoken:aa>) (<opaquelocktoken:bb>)", toks), 1)
    assert_eq_i64("and_fail", dav_if_eval("(<opaquelocktoken:aa>) (<opaquelocktoken:zz>)", toks), 0)
    assert_eq_i64("bad_syntax", dav_if_eval("(<opaquelocktoken:aa", toks), 0 - 1)
    return 0
}

fn test_locknull() -> i64 !IO {
    let mut paths: Vec<str> = vec_new()
    paths = dav_locknull_add(paths, "/dav/new.txt")
    paths = dav_locknull_add(paths, "/dav/new.txt")
    paths = dav_locknull_add(paths, "/dav/other.txt")
    assert_eq_i64("ln_has", dav_is_lock_null("/dav/new.txt", paths), 1)
    assert_eq_i64("ln_dedup", vec_len(paths), 2)
    assert_eq_i64("ln_missing", dav_is_lock_null("/dav/x.txt", paths), 0)
    let r = dav_locknull_response("/dav/new.txt", "opaquelocktoken:t", 3600, "me", 0)
    assert_true("ln_rt_empty", str_find(r, "<D:resourcetype/>") >= 0)
    assert_true("ln_lockdisc", str_find(r, "opaquelocktoken:t") >= 0)
    assert_true("ln_size0", str_find(r, "getcontentlength>0") >= 0)
    paths = dav_locknull_remove(paths, "/dav/new.txt")
    assert_eq_i64("ln_removed", dav_is_lock_null("/dav/new.txt", paths), 0)
    assert_eq_i64("ln_len", vec_len(paths), 1)
    return 0
}

fn main() -> i64 !IO {
    test_depth()?
    test_dest()?
    test_match()?
    test_date()?
    test_xml()?
    test_lock()?
    test_shared_scope()?
    test_if_eval()?
    test_locknull()?
    print("dav_test: all passed")
    return 0
}
