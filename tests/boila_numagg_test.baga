// boila_numagg_test.baga — P20-4 sum/avg over NUMERIC (P12b).
// Accounting totals must stay decimal: sum/avg of NUMERIC columns return
// NUMERIC (no i64 truncation), NULLs are skipped, GROUP BY works.

import "boilaDB/server/databases.baga"
import "boilaDB/server/exec_server.baga"
import "boilaDB/core/value.baga"
import "boilaDB/core/numeric.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn check(fails: Vec<i64>, name: str, cond: bool) {
    if cond {
        print(concat("  ok  ", name))
    } else {
        print(concat("  FAIL ", name))
        vec_push(fails, 1)
    }
}

fn wipe_shard_path(prefix: str) -> i64 !IO !Par {
    unlink(concat(prefix, ".wal"))?
    unlink(concat(prefix, ".manifest"))?
    unlink(concat(prefix, ".manifest.log"))?
    let mut g: i64 = 1
    while g <= 60 {
        unlink(concat(concat(prefix, ".sst."), int_to_str(g)))?
        unlink(concat(concat(prefix, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

fn wipe_root(root: str) -> i64 !IO !Par {
    wipe_shard_path(concat(root, "/.meta"))?
    let mut i: i64 = 0
    while i < 2 {
        wipe_shard_path(concat(concat(root, "/boila.db.s"), int_to_str(i)))?
        i = i + 1
    }
    return 0
}

fn cell(out: BoilaSrvOut, r: i64, c: i64) -> BoilaVal {
    return vec_get(vec_get(out.res.rows, r), c)
}

fn nums(v: BoilaVal) -> str {
    if v.tag != boila_v_num() {
        return "?"
    }
    return boila_num_to_string(v.b)
}

fn main() -> i64 !IO !Time !Par {
    print("boila_numagg_test:")
    let fails: Vec<i64> = vec_new()
    let root = "/tmp/baga_boila_numagg_test"
    wipe_root(root)?

    let mut srv = boila_server_open(root, 2, 8, 3, 4)?
    check(fails, "open", srv.ok == 1)
    let c0 = boila_server_exec(srv, "boila", "CREATE TABLE led (id BIGINT, grp TEXT, amt NUMERIC, PRIMARY KEY (id))")?
    srv = c0.srv
    check(fails, "create", c0.ok == 1)
    let i1 = boila_server_exec(srv, "boila", "INSERT INTO led (id, grp, amt) VALUES (1, 'a', '10.50'), (2, 'a', '20.25'), (3, 'b', '0.10'), (4, 'b', '0.20'), (5, 'b', NULL)")?
    srv = i1.srv
    check(fails, "insert", i1.ok == 1)

    // sum over NUMERIC is decimal-exact
    let q1 = boila_server_exec(srv, "boila", "SELECT sum(amt) FROM led")?
    srv = q1.srv
    check(fails, "sum_ok", q1.ok == 1 && vec_len(q1.res.rows) == 1)
    if vec_len(q1.res.rows) == 1 {
        check(fails, "sum_tag", cell(q1, 0, 0).tag == boila_v_num())
        check(fails, "sum_val", nums(cell(q1, 0, 0)) == "31.05")
    }

    // avg over NUMERIC
    let q2 = boila_server_exec(srv, "boila", "SELECT avg(amt) FROM led")?
    srv = q2.srv
    check(fails, "avg_ok", q2.ok == 1 && vec_len(q2.res.rows) == 1)
    if vec_len(q2.res.rows) == 1 {
        // (10.50+20.25+0.10+0.20)/4 = 31.05/4 = 7.7625
        check(fails, "avg_tag", cell(q2, 0, 0).tag == boila_v_num())
        check(fails, "avg_val", nums(cell(q2, 0, 0)) == "7.7625")
    }

    // GROUP BY sum
    let q3 = boila_server_exec(srv, "boila", "SELECT grp, sum(amt) FROM led GROUP BY grp ORDER BY grp")?
    srv = q3.srv
    check(fails, "group_ok", q3.ok == 1 && vec_len(q3.res.rows) == 2)
    if vec_len(q3.res.rows) == 2 {
        check(fails, "group_a", str_of_bytes(cell(q3, 0, 0).b) == "a" && nums(cell(q3, 0, 1)) == "30.75")
        check(fails, "group_b", str_of_bytes(cell(q3, 1, 0).b) == "b" && nums(cell(q3, 1, 1)) == "0.3")
    }

    // min/max over NUMERIC still work (sanity)
    let q4 = boila_server_exec(srv, "boila", "SELECT min(amt), max(amt) FROM led")?
    srv = q4.srv
    check(fails, "minmax_ok", q4.ok == 1 && vec_len(q4.res.rows) == 1)
    if vec_len(q4.res.rows) == 1 {
        check(fails, "min_val", nums(cell(q4, 0, 0)) == "0.1")
        check(fails, "max_val", nums(cell(q4, 0, 1)) == "20.25")
    }

    // i64 sum still i64 (no regression)
    let q5 = boila_server_exec(srv, "boila", "SELECT sum(id) FROM led")?
    srv = q5.srv
    check(fails, "sum_i64", q5.ok == 1 && vec_len(q5.res.rows) == 1 && cell(q5, 0, 0).tag == boila_v_i64() && cell(q5, 0, 0).i == 15)

    // restart then re-aggregate
    let _c = boila_server_close(srv)?
    srv = boila_server_open(root, 2, 8, 3, 4)?
    let q6 = boila_server_exec(srv, "boila", "SELECT sum(amt) FROM led")?
    srv = q6.srv
    check(fails, "restart_sum", q6.ok == 1 && vec_len(q6.res.rows) == 1 && nums(cell(q6, 0, 0)) == "31.05")

    let n = vec_len(fails)
    if n == 0 {
        print("boila_numagg_test: all passed")
        return 0
    }
    print(concat("boila_numagg_test: FAILED ", int_to_str(n)))
    return 1
}
