// worlds_test — W0 runtime: жизнен цикъл на свят (регион-арена + frozen бит).
//
// Протоколните нарушения (mutate-after-freeze, use-after-free/move, двоен
// freeze/free) се ДОКАЗВАТ/ОБОРВАТ от --verify върху
// examples/verify/worlds.baga — тук е функционалната страна: handle-ите са
// живи, alloc-ът връща различни ненулеви офсети, freeze сменя състоянието,
// а MEM-6 телеметрията вижда освобождаването на света.

fn check(name: str, ok: bool) {
    if ok {
        print(concat("ok ", name))
    } else {
        eprintln(concat("FAIL ", name))
        exit(1)
    }
}

fn main() {
    // C-only проверката, че светът не пипа thread-local bump арената, е в
    // tests/world_bump_test.baga — така този тест върви и през LLVM (където
    // mem_arena_bytes е явна грешка).

    let w = world_new()
    check("new_mutable", world_state(w) == 0)

    let p1 = world_alloc(w, 64)
    let p2 = world_alloc(w, 64)
    check("alloc_nonzero", p1 > 0 && p2 > 0)
    check("alloc_distinct", p1 != p2)

    world_freeze(w)
    check("frozen", world_state(w) == 1)
    world_free(w)

    // Втори свят след free на първия — handle-ите са независими.
    let w2 = world_new()
    check("second_new_mutable", world_state(w2) == 0)
    let q = world_alloc(w2, 4096)
    check("second_alloc", q > 0)
    world_freeze(w2)
    check("second_frozen", world_state(w2) == 1)
    world_free(w2)

    // W2.5: capability връзки между светове — насочен ацикличен граф.
    // Таблицата е ИЗВЪН региона (handle-ите са указатели, не офсети), затова
    // dump/load не я носи: зареденият свят няма връзки.
    let p = world_new()
    let c = world_new()
    let vc = wvec_new(c)
    wvec_push(c, vc, 77)
    check("links_zero", world_links(p) == 0)
    world_link(p, c)
    check("links_one", world_links(p) == 1)
    check("linked_handle", world_linked(p, 0) == c)
    check("read_through_link", wvec_get(world_linked(p, 0), vc, 0) == 77)
    world_freeze(c)
    let dp = world_dump(p)
    let gp2 = world_load(dp)
    check("loaded_no_links", world_links(gp2) == 0)
    world_free(gp2)
    // free на owner освобождава връзките му ⇒ детето вече може да се free-не
    world_free(p)
    world_free(c)
    let gafter = world_new()
    check("graph_released", world_links(gafter) == 0)
    world_free(gafter)

    print("worlds_test: all passed")
}
