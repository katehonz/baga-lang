// boila_show_test.baga — SHOW TABLES / SHOW INDEXES FROM t.

import "boilaDB/storage/databases.baga"
import "boilaDB/sql/exec_server.baga"
import "boilaDB/core/value.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn check(fails: Vec<i64>, name: str, cond: bool) {
    if cond {
        print(concat("  ok  ", name))
    } else {
        print(concat("  FAIL ", name))
        vec_push(fails, 1)
    }
}

fn wipe_shard_path(prefix: str) -> i64 !IO !Par {
    unlink(concat(prefix, ".wal"))?
    unlink(concat(prefix, ".manifest"))?
    unlink(concat(prefix, ".manifest.log"))?
    let mut g: i64 = 1
    while g <= 60 {
        unlink(concat(concat(prefix, ".sst."), int_to_str(g)))?
        unlink(concat(concat(prefix, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

fn wipe_root(root: str) -> i64 !IO !Par {
    wipe_shard_path(concat(root, "/.meta"))?
    let mut i: i64 = 0
    while i < 2 {
        wipe_shard_path(concat(concat(root, "/boila.db.s"), int_to_str(i)))?
        i = i + 1
    }
    return 0
}

fn exec(srv: BoilaServer, sql: str) -> BoilaSrvOut !IO !Time !Par {
    return boila_server_exec(srv, "boila", sql)?
}

fn has_name(res: BoilaResult, want: str) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(res.rows) {
        let v = vec_get(vec_get(res.rows, i), 0)
        if v.tag == boila_v_str() && str_of_bytes(v.b) == want {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn main() -> i64 !IO !Time !Par {
    print("boila_show_test:")
    let fails: Vec<i64> = vec_new()
    let root = "/tmp/baga_boila_show_test"
    wipe_root(root)?

    let mut srv = boila_server_open(root, 2, 8, 3, 4)?
    let c1 = exec(srv, "CREATE TABLE alpha (id BIGINT, city TEXT, body TEXT, PRIMARY KEY (id))")?
    srv = c1.srv
    let c2 = exec(srv, "CREATE TABLE beta (id BIGINT, PRIMARY KEY (id))")?
    srv = c2.srv
    let x1 = exec(srv, "CREATE INDEX city_ix ON alpha (city)")?
    srv = x1.srv
    let f1 = exec(srv, "CREATE FTS INDEX body_fts ON alpha (body)")?
    srv = f1.srv
    check(fails, "seed", c1.ok == 1 && c2.ok == 1 && x1.ok == 1 && f1.ok == 1)

    let s1 = exec(srv, "SHOW TABLES")?
    srv = s1.srv
    check(fails, "show_tables_ok", s1.ok == 1 && s1.kind == 1)
    check(fails, "has_alpha", has_name(s1.res, "alpha") == 1)
    check(fails, "has_beta", has_name(s1.res, "beta") == 1)
    check(fails, "ncols_tables", vec_len(s1.res.cols) == 1)

    let s2 = exec(srv, "SHOW INDEXES FROM alpha")?
    srv = s2.srv
    check(fails, "show_ix_ok", s2.ok == 1 && vec_len(s2.res.cols) == 3)
    check(fails, "has_city_ix", has_name(s2.res, "city_ix") == 1)
    check(fails, "has_fts", has_name(s2.res, "body_fts") == 1)

    let s3 = exec(srv, "SHOW INDEX FROM alpha")?
    srv = s3.srv
    check(fails, "show_index_alias", s3.ok == 1 && vec_len(s3.res.rows) >= 2)

    let s4 = exec(srv, "SHOW INDEXES FROM nope")?
    srv = s4.srv
    check(fails, "missing_42P01", s4.ok == 0 && s4.state == "42P01")

    // GUC SHOW still works
    let g1 = exec(srv, "SHOW server_version")?
    srv = g1.srv
    check(fails, "guc_show", g1.ok == 1)

    let d1 = exec(srv, "DROP TABLE beta")?
    srv = d1.srv
    let s5 = exec(srv, "SHOW TABLES")?
    srv = s5.srv
    check(fails, "after_drop", has_name(s5.res, "beta") == 0 && has_name(s5.res, "alpha") == 1)

    // SHOW COLUMNS / DESCRIBE
    let sc = exec(srv, "SHOW COLUMNS FROM alpha")?
    srv = sc.srv
    check(fails, "show_cols", sc.ok == 1 && vec_len(sc.res.cols) == 4 && vec_len(sc.res.rows) == 3)
    if sc.ok == 1 && vec_len(sc.res.rows) >= 1 {
        let r0 = vec_get(sc.res.rows, 0)
        check(fails, "pk_row", str_of_bytes(vec_get(r0, 0).b) == "id" && str_of_bytes(vec_get(r0, 1).b) == "bigint" && str_of_bytes(vec_get(r0, 3).b) == "YES")
    }
    let sd = exec(srv, "DESCRIBE alpha")?
    srv = sd.srv
    check(fails, "describe", sd.ok == 1 && vec_len(sd.res.rows) == 3)
    let se = exec(srv, "DESC alpha")?
    srv = se.srv
    check(fails, "desc", se.ok == 1 && vec_len(se.res.rows) == 3)
    let sf = exec(srv, "SHOW COLUMNS FROM nope")?
    srv = sf.srv
    check(fails, "cols_missing", sf.ok == 0 && sf.state == "42P01")

    // VECTOR type name
    let cv = exec(srv, "CREATE TABLE vecs (id BIGINT, emb VECTOR(3), PRIMARY KEY (id))")?
    srv = cv.srv
    let sv = exec(srv, "SHOW COLUMNS FROM vecs")?
    srv = sv.srv
    check(fails, "vector_type", sv.ok == 1 && vec_len(sv.res.rows) == 2)
    if sv.ok == 1 && vec_len(sv.res.rows) == 2 {
        check(fails, "vector_name", str_of_bytes(vec_get(vec_get(sv.res.rows, 1), 1).b) == "vector(3)")
    }

    boila_server_close(srv)?

    if vec_len(fails) == 0 {
        print("boila_show_test: ALL PASS")
        return 0
    }
    print(concat("boila_show_test: FAILS=", int_to_str(vec_len(fails))))
    return 1
}
