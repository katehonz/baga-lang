// boila_pgwire_test.baga — P6: чисти wire функции (substitution, quoting,
// value encoding, tags). End-to-end с pgbaga е в live smoke-а (docs).

import "boilaDB/api/pgwire_enc.baga"
import "boilaDB/api/pgwire_msg.baga"
import "boilaDB/api/pgwire_prep.baga"
import "boilaDB/api/pgwire_desc.baga"
import "boilaDB/api/pgwire_dml.baga"
import "boilaDB/sql/ast.baga"
import "boilaDB/server/databases.baga"
import "boilaDB/core/value.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

fn check(fails: Vec<i64>, name: str, cond: bool) {
    if cond {
        print(concat("  ok  ", name))
    } else {
        print(concat("  FAIL ", name))
        vec_push(fails, 1)
    }
}

fn main() -> i64 !Par {
    print("boila_pgwire_test:")
    let fails: Vec<i64> = vec_new()

    // --- pgw_is_int ---
    check(fails, "is_int", pgw_is_int("123") == 1 && pgw_is_int("-5") == 1 && pgw_is_int("12a") == 0 && pgw_is_int("") == 0 && pgw_is_int("-") == 0)

    // --- quoting ---
    check(fails, "quote_plain", pgw_quote_lit("abc") == "'abc'")
    check(fails, "quote_apos", pgw_quote_lit("a'b") == "'a''b'")
    check(fails, "quote_bg", pgw_quote_lit("бг") == "'бг'")

    // --- param substitution ---
    let v1: Vec<str> = vec_new()
    vec_push(v1, "42")
    vec_push(v1, "sofia")
    let n1: Vec<i64> = vec_new()
    vec_push(n1, 0)
    vec_push(n1, 0)
    check(fails, "subst_int_str", pgw_subst_params("SELECT * FROM t WHERE id = $1 AND city = $2", v1, n1) == "SELECT * FROM t WHERE id = 42 AND city = 'sofia'")
    check(fails, "subst_repeat", pgw_subst_params("SELECT $1, $1", v1, n1) == "SELECT 42, 42")
    // $ в кавички не се пипа
    check(fails, "subst_in_quotes", pgw_subst_params("SELECT '$1' FROM t WHERE id = $1", v1, n1) == "SELECT '$1' FROM t WHERE id = 42")
    // '' escape в кавички
    let vq: Vec<str> = vec_new()
    vec_push(vq, "x")
    let nq: Vec<i64> = vec_new()
    vec_push(nq, 0)
    check(fails, "subst_escaped_quote", pgw_subst_params("SELECT 'a''b $1' , $1", vq, nq) == "SELECT 'a''b $1' , 'x'")
    // NULL параметър
    let vn: Vec<str> = vec_new()
    vec_push(vn, "")
    let nn: Vec<i64> = vec_new()
    vec_push(nn, 1)
    check(fails, "subst_null", pgw_subst_params("INSERT INTO t (a) VALUES ($1)", vn, nn) == "INSERT INTO t (a) VALUES (NULL)")
    // стринг с кавичка като параметър → екраниран
    let ve: Vec<str> = vec_new()
    vec_push(ve, "a'b")
    let ne: Vec<i64> = vec_new()
    vec_push(ne, 0)
    check(fails, "subst_quote_param", pgw_subst_params("SELECT $1", ve, ne) == "SELECT 'a''b'")
    // липсващ параметър → '$' остава
    check(fails, "subst_missing", pgw_subst_params("SELECT $3", v1, n1) == "SELECT $3")

    // --- value encoding ---
    let tn = pgw_val_text(boila_val_null())
    check(fails, "enc_null", tn.is_null == 1)
    let ti = pgw_val_text(boila_val_i64(-7))
    check(fails, "enc_i64", ti.is_null == 0 && str_of_bytes(ti.b) == "-7")
    let tb = pgw_val_text(boila_val_bool(1))
    check(fails, "enc_bool", str_of_bytes(tb.b) == "t")
    let ts = pgw_val_text(boila_val_str("бг"))
    check(fails, "enc_str", str_of_bytes(ts.b) == "бг")
    let by = bytes_new(2)
    bytes_set(by, 0, 171)
    bytes_set(by, 1, 205)
    let tb2 = pgw_val_text(boila_val_bytes(by))
    check(fails, "enc_bytea_hex", str_of_bytes(tb2.b) == "\\xabcd")

    // --- tags ---
    check(fails, "tag_select", pgw_tag(1, 0, 5) == "SELECT 5")
    check(fails, "tag_insert", pgw_tag(6, 3, 0) == "INSERT 0 3")
    check(fails, "tag_update", pgw_tag(7, 2, 0) == "UPDATE 2")
    check(fails, "tag_delete", pgw_tag(8, 1, 0) == "DELETE 1")
    check(fails, "tag_create", pgw_tag(2, 0, 0) == "CREATE TABLE")
    check(fails, "tag_begin", pgw_tag(10, 0, 0) == "BEGIN")

    // --- framing ---
    let msg = pgw_msg(81, pgw_cstr("SELECT 1"))
    check(fails, "frame_type", bytes_at(msg, 0) == 81)
    check(fails, "frame_len", pgw_be_read(msg, 1, 4) == bytes_len(msg) - 1)

    // --- W2: prep AST + bind ---
    let bv: Vec<str> = vec_new()
    vec_push(bv, "42")
    vec_push(bv, "3")
    let bn: Vec<i64> = vec_new()
    vec_push(bn, 0)
    vec_push(bn, 0)
    let st = boila_pg_try_sel("SELECT * FROM t WHERE id = $1 LIMIT $2")
    check(fails, "try_sel", st.kind == 1 && st.sel.eq_param == 1 && st.sel.lim_param == 2)
    let st2 = boila_pg_try_sel("CREATE TABLE t (id BIGINT, PRIMARY KEY (id))")
    check(fails, "try_text", st2.kind == 0)
    let std = boila_pg_try_sel("DELETE FROM t WHERE id = $1")
    check(fails, "try_del", std.kind == 4 && boila_is_param(std.del.pk_eq) == 1)
    let bd = boila_pg_bind_del(std.del, bv, bn)
    check(fails, "bind_del", bd.pk_eq.tag == boila_v_i64() && bd.pk_eq.i == 42)
    let sti = boila_pg_try_sel("INSERT INTO t (id, name) VALUES ($1, $2)")
    check(fails, "try_ins", sti.kind == 2 && vec_len(sti.ins.rows) == 1)
    let bins = boila_pg_bind_ins(sti.ins, bv, bn)
    check(fails, "bind_ins", boila_is_param(vec_get(vec_get(sti.ins.rows, 0), 0)) == 1 && vec_get(vec_get(bins.rows, 0), 0).i == 42)
    let stu = boila_pg_try_sel("UPDATE t SET name = $1 WHERE id = $2")
    check(fails, "try_upd", stu.kind == 3)
    let uv: Vec<str> = vec_new()
    vec_push(uv, "alice")
    vec_push(uv, "7")
    let un: Vec<i64> = vec_new()
    vec_push(un, 0)
    vec_push(un, 0)
    let bu = boila_pg_bind_upd(stu.upd, uv, un)
    check(fails, "bind_upd", vec_get(bu.set_vals, 0).tag == boila_v_str() && bu.pk_eq.i == 7)
    let bound = boila_pg_bind_sel(st.sel, bv, bn)
    check(fails, "bind_eq", bound.pk_eq.tag == boila_v_i64() && bound.pk_eq.i == 42)
    check(fails, "bind_lim", bound.limit == 3)

    // --- W3/W5: OIDs + ParameterDescription + typed RowDescription ---
    check(fails, "oid_bool", pgw_oid_of(boila_v_bool()) == 16)
    check(fails, "oid_i64", pgw_oid_of(boila_v_i64()) == 20)
    check(fails, "oid_text", pgw_oid_of(boila_v_str()) == 25)
    check(fails, "oid_ts", pgw_oid_of(boila_v_ts()) == 1184)
    check(fails, "nparams", boila_pg_nparams(st.sel) == 2)
    let pd = pgw_param_desc(2)
    check(fails, "param_desc_t", bytes_at(pd, 0) == 116)
    let cn: Vec<str> = vec_new()
    vec_push(cn, "id")
    vec_push(cn, "name")
    let tg: Vec<i64> = vec_new()
    vec_push(tg, boila_v_i64())
    vec_push(tg, boila_v_str())
    let rd = pgw_row_desc_typed(cn, tg)
    check(fails, "row_desc_T", bytes_at(rd, 0) == 84)
    // OID int8 at first column field (after name\0 + tableoid4 + attnum2)
    // spot-check: message contains be32(20) for int8
    let mut found20 = 0
    let mut bi: i64 = 0
    while bi + 4 <= bytes_len(rd) {
        if pgw_be_read(rd, bi, 4) == 20 { found20 = 1 }
        bi = bi + 1
    }
    check(fails, "row_desc_oid20", found20 == 1)
    let m0 = BoilaPgMeta { ok: 0, cols: cn, tags: tg, nparams: 1, s: boila_store_empty() }
    let nd = boila_pg_desc_buf(m0, 1)
    check(fails, "desc_nodata_stmt", bytes_at(nd, 0) == 116)
    let m1 = BoilaPgMeta { ok: 1, cols: cn, tags: tg, nparams: 2, s: boila_store_empty() }
    let db = boila_pg_desc_buf(m1, 1)
    check(fails, "desc_stmt_row", bytes_at(db, 0) == 116)

    if vec_len(fails) == 0 {
        print("boila_pgwire_test: all passed")
        return 0
    }
    print(concat(concat("boila_pgwire_test: FAILED (", int_to_str(vec_len(fails))), ")"))
    return 1
}
