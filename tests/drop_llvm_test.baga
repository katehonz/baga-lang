// drop_llvm_test — Task 4: drop() в LLVM бекенда (RC паритет).
// drop върху bytes (под --rc: tag 2 release; без --rc: free на data),
// върху Vec (под --rc: tag 3 release; без --rc: deep free) и върху Map
// (под --rc: tag 4 release; без --rc: baga_drop_map — deep free на
// entries/buckets/struct).
// Заб.: checker-ът допуска drop само за Vec/Map/bytes/fn — не и за str.
fn main() {
    let b = bytes_of_str("жив")
    let v: Vec<i64> = vec_new()
    vec_push(v, 1)
    drop(b)
    drop(v)
    print("ok drop")
    let m: Map<str, i64> = map_new()
    map_set(m, "едно", 1)
    map_set(m, "две", 2)
    map_set(m, "три", 3)
    print(i64_to_str(map_len(m)))
    drop(m)
    print("ok drop map")
}
