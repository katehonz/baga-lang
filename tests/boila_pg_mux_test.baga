// boila_pg_mux_test.baga — P31: 2 workers, 8 keep-alive PG clients.
// Old pool pinned 1 conn/worker and hung at c>workers (pgbench handshake).
// Raw frontend (no pgbaga) so the binary stays under FNS_MAX.

import "boilaDB/server/databases.baga"
import "boilaDB/api/serve_mt.baga"
import "boilaDB/api/pgwire_mux.baga"
import "pgbaga/wire/proto.baga"
import "std/net/tcp.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

fn check(fails: Vec<i64>, name: str, cond: bool) {
    if cond {
        print(concat("  ok  ", name))
    } else {
        print(concat("  FAIL ", name))
        vec_push(fails, 1)
    }
}

fn wipe_one(prefix: str) -> i64 !IO !Par {
    unlink(concat(prefix, ".wal"))?
    unlink(concat(prefix, ".manifest"))?
    unlink(concat(prefix, ".manifest.log"))?
    let mut g: i64 = 1
    while g <= 20 {
        unlink(concat(concat(prefix, ".sst."), int_to_str(g)))?
        unlink(concat(concat(prefix, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

fn wipe(root: str) -> i64 !IO !Par {
    wipe_one(concat(root, "/.meta"))?
    wipe_one(concat(root, "/boila.db"))?
    wipe_one(concat(root, "/boila.db.s0"))?
    wipe_one(concat(root, "/boila.db.s1"))?
    return 0
}

fn mux_serve(ctx: i64) -> i64 !IO !Net !Time !Par !Random {
    let port = cell2_0(ctx)
    let pack = cell2_1(ctx)
    let listener = tcp_listen(port)?
    if listener < 0 {
        return 1
    }
    return boila_pg_mux_run(listener, pack, 2)?
}

fn be32at(b: bytes, off: i64) -> i64 {
    return ((bytes_at(b, off) & 255) * 16777216) + ((bytes_at(b, off + 1) & 255) * 65536) + ((bytes_at(b, off + 2) & 255) * 256) + (bytes_at(b, off + 3) & 255)
}

fn cli_fill(fd: i64, buf0: bytes, n: i64) -> bytes !IO !Net !Par {
    let mut buf = buf0
    while bytes_len(buf) < n {
        let c = tcp_read_bytes(fd, 8192)?
        if bytes_len(c) == 0 {
            return buf
        }
        buf = bytes_concat(buf, c)
    }
    return buf
}

// 1 = saw ReadyForQuery; 0 = Error/EOF.
fn cli_until_z(fd: i64) -> i64 !IO !Net !Par {
    let mut buf = bytes_new(0)
    let mut pos: i64 = 0
    let mut guard: i64 = 0
    while guard < 64 {
        buf = cli_fill(fd, buf, pos + 5)?
        if bytes_len(buf) < pos + 5 {
            return 0
        }
        let typ = bytes_at(buf, pos) & 255
        let ln = be32at(buf, pos + 1)
        buf = cli_fill(fd, buf, pos + 1 + ln)?
        if bytes_len(buf) < pos + 1 + ln {
            return 0
        }
        if typ == 90 {
            return 1
        }
        if typ == 69 {
            return 0
        }
        pos = pos + 1 + ln
        guard = guard + 1
    }
    return 0
}

fn cli_open(port: i64) -> i64 !IO !Net !Par {
    let fd = tcp_connect("127.0.0.1", port)?
    if fd < 0 {
        return 0 - 1
    }
    tcp_set_nodelay(fd)?
    tcp_set_timeouts(fd, 8)?
    let w = tcp_write_bytes(fd, pg_startup("boila", "boila"))?
    if w != 0 {
        tcp_close(fd)?
        return 0 - 1
    }
    if cli_until_z(fd)? == 0 {
        tcp_close(fd)?
        return 0 - 1
    }
    return fd
}

fn cli_select1(fd: i64) -> i64 !IO !Net !Par {
    let w = tcp_write_bytes(fd, pg_query_msg("SELECT 1"))?
    if w != 0 {
        return 0
    }
    return cli_until_z(fd)?
}

fn client_w(ctx: i64) -> i64 !Net !IO !Time !Par {
    let port = cell2_0(ctx)
    let nops = cell2_1(ctx)
    let fd = cli_open(port)?
    if fd < 0 {
        return 0
    }
    let mut okc: i64 = 0
    let mut i: i64 = 0
    while i < nops {
        okc = okc + cli_select1(fd)?
        i = i + 1
    }
    let _x = tcp_write_bytes(fd, pg_terminate_msg())?
    tcp_close(fd)?
    return okc
}

fn main() -> i64 !Net !IO !Time !Par !Random {
    print("boila_pg_mux_test:")
    let fails: Vec<i64> = vec_new()
    let root = "/tmp/baga_boila_pg_mux"
    let port: i64 = 16621
    wipe(root)?
    let mut srv = boila_server_open(root, 1, 256, 4, 4)?
    check(fails, "open", srv.ok == 1)
    boila_server_close(srv)?
    let srv0 = boila_server_open_mt(root, 1, 256, 4, 4)?
    check(fails, "open_mt", srv0.ok == 1)
    let pack = boila_mt_new(srv0, 32)?
    boila_mt_set_pool(pack, 2, 2)?
    go_bg(mux_serve, cell2(port, pack))
    sleep_ms(400)
    let mut ready: i64 = 0
    let mut w: i64 = 0
    while w < 40 && ready == 0 {
        let fd0 = cli_open(port)?
        if fd0 >= 0 {
            ready = 1
            let _t = tcp_write_bytes(fd0, pg_terminate_msg())?
            tcp_close(fd0)?
        } else {
            sleep_ms(50)
        }
        w = w + 1
    }
    check(fails, "ready", ready == 1)
    let mut seq: i64 = 0
    let mut s: i64 = 0
    while s < 3 {
        seq = seq + client_w(cell2(port, 3))?
        s = s + 1
    }
    check(fails, "seq_9", seq == 9)
    let handles: Vec<i64> = vec_new()
    let mut c: i64 = 0
    while c < 8 {
        vec_push(handles, go(client_w, cell2(port, 5)))
        c = c + 1
    }
    let mut okc: i64 = 0
    let mut i: i64 = 0
    while i < vec_len(handles) {
        okc = okc + join(vec_get(handles, i))
        i = i + 1
    }
    check(fails, "fanout_40", okc == 40)
    if vec_len(fails) == 0 {
        print("boila_pg_mux_test: ALL PASS")
        return 0
    }
    print(concat("boila_pg_mux_test: FAILS=", int_to_str(vec_len(fails))))
    return 1
}
