// boila_rollup_test.baga — K3j CREATE ROLLUP + query path.
import "boilaDB/server/databases.baga"
import "boilaDB/server/exec_server.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn wipe_shard(prefix: str) -> i64 !IO {
    unlink(concat(prefix, ".wal"))?
    unlink(concat(prefix, ".manifest"))?
    unlink(concat(prefix, ".manifest.log"))?
    let mut g: i64 = 1
    while g <= 80 {
        unlink(concat(concat(prefix, ".sst."), int_to_str(g)))?
        unlink(concat(concat(prefix, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

fn wipe(root: str) -> i64 !IO {
    wipe_shard(concat(root, "/.meta"))?
    let mut i: i64 = 0
    while i < 2 {
        wipe_shard(concat(concat(root, "/boila.db.s"), int_to_str(i)))?
        i = i + 1
    }
    return 0
}

fn check(fails: Vec<str>, name: str, ok: bool) {
    if ok == false {
        vec_push(fails, name)
        print(concat("FAIL ", name))
    } else {
        print(concat("  ok  ", name))
    }
}

fn main() -> i64 !IO !Time !Par {
    let fails: Vec<str> = vec_new()
    let root = "/tmp/baga_boila_rollup_test"
    wipe(root)?
    let mut srv = boila_server_open(root, 2, 64, 4, 4)?
    let c = boila_server_exec(srv, "boila", "CREATE TABLE pts (id BIGINT, ts BIGINT, v BIGINT, PRIMARY KEY (id))")?
    srv = c.srv
    check(fails, "create", c.ok == 1)
    let ix = boila_server_exec(srv, "boila", "CREATE INDEX pts_ts_ix ON pts (ts)")?
    srv = ix.srv
    check(fails, "ix", ix.ok == 1)
    let r = boila_server_exec(srv, "boila", "CREATE ROLLUP pts_1m ON pts USING time_bucket('1m', ts) SUM(v)")?
    srv = r.srv
    check(fails, "rollup", r.ok == 1)
    // 3 points in 2 buckets: 1000000,1000030 → same 1m; 1000060 → next
    let i1 = boila_server_exec(srv, "boila", "INSERT INTO pts (id, ts, v) VALUES (1, 1000000, 10), (2, 1000030, 20), (3, 1000060, 5)")?
    srv = i1.srv
    check(fails, "insert", i1.ok == 1)
    let q = boila_server_exec(srv, "boila", "SELECT count(*), sum(v) FROM pts GROUP BY time_bucket('1m', ts)")?
    srv = q.srv
    check(fails, "query_ok", q.ok == 1)
    check(fails, "nbuckets", vec_len(q.res.rows) == 2)
    // totals: count 2+1, sum 30+5
    let mut total_c: i64 = 0
    let mut total_s: i64 = 0
    let mut i: i64 = 0
    while i < vec_len(q.res.rows) {
        let row = vec_get(q.res.rows, i)
        // cols: time_bucket, count, sum_v
        if vec_len(row) >= 3 {
            total_c = total_c + vec_get(row, 1).i
            total_s = total_s + vec_get(row, 2).i
        }
        i = i + 1
    }
    check(fails, "total_count", total_c == 3)
    check(fails, "total_sum", total_s == 35)
    // delete one row
    let d = boila_server_exec(srv, "boila", "DELETE FROM pts WHERE id = 2")?
    srv = d.srv
    check(fails, "delete", d.ok == 1)
    let q2 = boila_server_exec(srv, "boila", "SELECT count(*), sum(v) FROM pts GROUP BY time_bucket('1m', ts)")?
    srv = q2.srv
    check(fails, "after_del_ok", q2.ok == 1)
    total_c = 0
    total_s = 0
    i = 0
    while i < vec_len(q2.res.rows) {
        let row = vec_get(q2.res.rows, i)
        if vec_len(row) >= 3 {
            total_c = total_c + vec_get(row, 1).i
            total_s = total_s + vec_get(row, 2).i
        }
        i = i + 1
    }
    check(fails, "after_del_count", total_c == 2)
    check(fails, "after_del_sum", total_s == 15)
    // dup rollup
    let r2 = boila_server_exec(srv, "boila", "CREATE ROLLUP pts_1m ON pts USING time_bucket('1m', ts) SUM(v)")?
    srv = r2.srv
    check(fails, "dup_42710", r2.ok == 0 && r2.state == "42710")
    // K3k partial window: re-seed
    let i2 = boila_server_exec(srv, "boila", "INSERT INTO pts (id, ts, v) VALUES (2, 1000030, 20)")?
    srv = i2.srv
    check(fails, "reins", i2.ok == 1)
    // window [1000000, 1000060) → pts 1@999960 + 2@1000020; not pt 3 @1000060
    let qw = boila_server_exec(srv, "boila", "SELECT count(*), sum(v) FROM pts WHERE ts >= 1000000 AND ts < 1000060 GROUP BY time_bucket('1m', ts)")?
    srv = qw.srv
    check(fails, "win_ok", qw.ok == 1)
    check(fails, "win_nb", vec_len(qw.res.rows) == 2)
    total_c = 0
    total_s = 0
    i = 0
    while i < vec_len(qw.res.rows) {
        let row = vec_get(qw.res.rows, i)
        if vec_len(row) >= 3 {
            total_c = total_c + vec_get(row, 1).i
            total_s = total_s + vec_get(row, 2).i
        }
        i = i + 1
    }
    check(fails, "win_count", total_c == 2)
    check(fails, "win_sum", total_s == 30)
    // wider window covering both buckets fully for mid + partial edges
    // [999960, 1000080): all 3 points
    let qw2 = boila_server_exec(srv, "boila", "SELECT count(*), sum(v) FROM pts WHERE ts >= 999960 AND ts < 1000080 GROUP BY time_bucket('1m', ts)")?
    srv = qw2.srv
    check(fails, "win2_ok", qw2.ok == 1)
    total_c = 0
    total_s = 0
    i = 0
    while i < vec_len(qw2.res.rows) {
        let row = vec_get(qw2.res.rows, i)
        if vec_len(row) >= 3 {
            total_c = total_c + vec_get(row, 1).i
            total_s = total_s + vec_get(row, 2).i
        }
        i = i + 1
    }
    check(fails, "win2_count", total_c == 3)
    check(fails, "win2_sum", total_s == 35)
    boila_server_close(srv)?
    if vec_len(fails) == 0 {
        print("boila_rollup_test: ALL PASS")
        return 0
    }
    print(concat(concat("boila_rollup_test: FAILED (", int_to_str(vec_len(fails))), ")"))
    return 1
}
