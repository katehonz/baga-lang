// boila_pool_test.baga — P11-1: bounded HTTP worker pool.
// 2 workers, 8 concurrent clients × 5 point SELECTs; default BOILA_WORKERS=4.

import "boilaDB/server/databases.baga"
import "boilaDB/server/exec_server.baga"
import "boilaDB/api/serve_mt.baga"
import "boilaDB/api/serve_mt_pool.baga"
import "boilaDB/api/http_sql.baga"
import "boilaDB/txn/mvcc.baga"
import "httpdbaga/http.baga"
import "std/net/tcp.baga"
import "std/net/poll.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

fn check(fails: Vec<i64>, name: str, cond: bool) {
    if cond {
        print(concat("  ok  ", name))
    } else {
        print(concat("  FAIL ", name))
        vec_push(fails, 1)
    }
}

fn wipe_one(prefix: str) -> i64 !IO !Par {
    unlink(concat(prefix, ".wal"))?
    unlink(concat(prefix, ".manifest"))?
    unlink(concat(prefix, ".manifest.log"))?
    let mut g: i64 = 1
    while g <= 20 {
        unlink(concat(concat(prefix, ".sst."), int_to_str(g)))?
        unlink(concat(concat(prefix, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

fn wipe(root: str) -> i64 !IO !Par {
    wipe_one(concat(root, "/.meta"))?
    wipe_one(concat(root, "/boila.db"))?
    return 0
}

fn pool_http_conn(ctx: i64) -> i64 !IO !Net !Time !Par {
    let fd = cell2_0(ctx)
    let pack = cell2_1(ctx)
    tcp_set_nodelay(fd)?
    let mut txn = boila_txn_new()
    let mut r = http_reader(fd)
    let mut keep = true
    while keep {
        let out = http_read_request_r(r)?
        r = out.reader
        if out.err != 0 || http_method(out.req) == "" {
            keep = false
        } else {
            let ka = http_keepalive(out.req)
            let method = http_method(out.req)
            let path = http_path_only(out.req)
            if method == "POST" && path == "/sql" {
                let mut db = http_query_param(out.req, "db")
                if db == "" {
                    db = "boila"
                }
                let ex = boila_mt_exec(pack, txn, db, http_body(out.req))?
                txn = ex.txn
                let guc: Map<str, str> = map_new()
                let enc = boila_http_encode(ex, db, db, guc)?
                http_respond_keepalive(fd, enc.resp, ka)?
            } else {
                if method == "GET" && path == "/health" {
                    let wn = boila_mt_workers(pack)?
                    let mut body = "{\"ok\":1,\"workers\":"
                    body = concat(body, int_to_str(wn))
                    body = concat(body, "}")
                    http_respond_keepalive(fd, http_json_response(200, body), ka)?
                } else {
                    http_respond_keepalive(fd, http_json_response(404, "{}"), 0)?
                    keep = false
                }
            }
            if ka == 0 {
                keep = false
            }
        }
    }
    if txn.active == 1 {
        txn = boila_txn_rollback(txn)
    }
    tcp_close(fd)?
    boila_mt_end_conn(pack)?
    return 0
}

fn boila_pool_handle(fd: i64, pack: i64) -> i64 !IO !Net !Time !Par {
    return pool_http_conn(cell2(fd, pack))?
}

fn pool_serve(ctx: i64) -> i64 !Net !IO !Time !Par {
    let port = cell2_0(ctx)
    let pack = cell2_1(ctx)
    let ch = boila_pool_start(pack, 2)?
    boila_mt_set_pool(pack, 2, 2)?
    let listener = tcp_listen(port)?
    let pollfds: Vec<i64> = vec_new()
    vec_push(pollfds, listener)
    while true {
        let pr = poll_wait(pollfds, 200)?
        if pr.ok < 0 {
            return 1
        }
        if poll_has(pr.ready, listener) == 1 {
            let fd = tcp_accept(listener)?
            if fd >= 0 {
                if boila_mt_try_conn(pack)? == 0 {
                    tcp_close(fd)?
                } else {
                    chan_send(ch, fd)
                }
            }
        }
    }
    return 0
}

fn sql_post(port: i64, sql: str) -> i64 !Net !IO !Par {
    let fd = tcp_connect("127.0.0.1", port)?
    if fd < 0 {
        return 0
    }
    let mut req = "POST /sql?db=boila HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\nContent-Length: "
    req = concat(req, int_to_str(len(sql)))
    req = concat(req, "\r\n\r\n")
    req = concat(req, sql)
    let w = tcp_write(fd, req)?
    if w != 0 {
        tcp_close(fd)?
        return 0
    }
    let mut body = ""
    let mut rounds: i64 = 0
    while rounds < 80 {
        let chunk = tcp_read(fd, 2048)?
        if chunk == "" {
            rounds = 80
        } else {
            body = concat(body, chunk)
            rounds = rounds + 1
        }
    }
    tcp_close(fd)?
    if str_find(body, "\"ok\":true") >= 0 {
        return 1
    }
    return 0
}

fn health_body(port: i64) -> str !Net !IO !Par {
    let fd = tcp_connect("127.0.0.1", port)?
    if fd < 0 {
        return ""
    }
    let w = tcp_write(fd, "GET /health HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")?
    if w != 0 {
        tcp_close(fd)?
        return ""
    }
    let mut body = ""
    let mut r: i64 = 0
    while r < 40 {
        let c = tcp_read(fd, 1024)?
        if c == "" {
            r = 40
        } else {
            body = concat(body, c)
            r = r + 1
        }
    }
    tcp_close(fd)?
    return body
}

// ctx = cell2(port, nops)
fn client_w(ctx: i64) -> i64 !Net !IO !Time !Par {
    let port = cell2_0(ctx)
    let nops = cell2_1(ctx)
    let mut okc: i64 = 0
    let mut i: i64 = 0
    while i < nops {
        okc = okc + sql_post(port, concat("SELECT id FROM t WHERE id = ", int_to_str(i + 1)))?
        i = i + 1
    }
    return okc
}

fn main() -> i64 !Net !IO !Time !Par {
    print("boila_pool_test:")
    let fails: Vec<i64> = vec_new()
    let defn = boila_workers_n()?
    check(fails, "default_workers", defn == 4)

    let root = "/tmp/baga_boila_pool"
    let port: i64 = 16611
    wipe(root)?
    let mut srv = boila_server_open(root, 1, 256, 4, 4)?
    check(fails, "open", srv.ok == 1)
    let c0 = boila_server_exec(srv, "boila", "CREATE TABLE t (id BIGINT, v TEXT, PRIMARY KEY (id))")?
    srv = c0.srv
    check(fails, "create", c0.ok == 1)
    let i1 = boila_server_exec(srv, "boila", "INSERT INTO t (id, v) VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e')")?
    srv = i1.srv
    check(fails, "seed", i1.ok == 1)
    boila_server_close(srv)?

    let srv0 = boila_server_open_mt(root, 1, 256, 4, 4)?
    check(fails, "open_mt", srv0.ok == 1)
    let pack = boila_mt_new(srv0, 32)?
    go_bg(pool_serve, cell2(port, pack))
    sleep_ms(300)

    let mut ready: i64 = 0
    let mut w: i64 = 0
    let mut hb = ""
    while w < 40 && ready == 0 {
        hb = health_body(port)?
        if str_find(hb, "200") >= 0 {
            ready = 1
        } else {
            sleep_ms(50)
        }
        w = w + 1
    }
    check(fails, "ready", ready == 1)
    check(fails, "health_workers", str_find(hb, "\"workers\":2") >= 0)

    let handles: Vec<i64> = vec_new()
    let mut c: i64 = 0
    while c < 8 {
        vec_push(handles, go(client_w, cell2(port, 5)))
        c = c + 1
    }
    let mut okc: i64 = 0
    let mut i: i64 = 0
    while i < vec_len(handles) {
        okc = okc + join(vec_get(handles, i))
        i = i + 1
    }
    check(fails, "fanout_40", okc == 40)
    check(fails, "drop", sql_post(port, "DROP TABLE t")? == 1)
    check(fails, "after_drop", sql_post(port, "SELECT id FROM t WHERE id = 1")? == 0)

    if vec_len(fails) == 0 {
        print("boila_pool_test: ALL PASS")
        return 0
    }
    print(concat("boila_pool_test: FAILS=", int_to_str(vec_len(fails))))
    return 1
}
