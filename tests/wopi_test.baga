// wopi_test.baga — WOPI заключване и CheckFileInfo (Фаза 7). Без база.

import "wopibaga/wopi.baga"
import "testbaga/assert.baga"
import "std/str/str.baga"

fn wopi_test_lock() -> i64 !IO {
    let a = wopi_apply("lock", "", 0, 100, "abc")
    assert_eq_i64("lock_new", a.status, 200)
    assert_eq_i64("lock_store", a.store, 1)
    assert_eq_str("lock_id", a.new_lock, "abc")
    let same = wopi_apply("LOCK", "abc", 200, 100, "abc")
    assert_eq_i64("lock_refresh", same.status, 200)
    assert_eq_i64("lock_refresh_store", same.store, 1)
    let clash = wopi_apply("LOCK", "abc", 200, 100, "zzz")
    assert_eq_i64("lock_clash", clash.status, 409)
    assert_eq_str("lock_held", clash.lock, "abc")
    let dead = wopi_apply("LOCK", "abc", 50, 100, "zzz")
    assert_eq_i64("lock_expired", dead.status, 200)
    assert_eq_str("lock_take", dead.new_lock, "zzz")
    let empty = wopi_apply("LOCK", "", 0, 100, "")
    assert_eq_i64("lock_empty", empty.status, 400)
    let long = wopi_apply("LOCK", "", 0, 100, wopi_long())
    assert_eq_i64("lock_long", long.status, 400)
    return 0
}

fn wopi_long() -> str {
    let mut s = ""
    let mut i: i64 = 0
    while i < 1025 {
        s = concat(s, "x")
        i = i + 1
    }
    return s
}

fn wopi_test_unlock() -> i64 !IO {
    let bad = wopi_apply("UNLOCK", "abc", 200, 100, "no")
    assert_eq_i64("unlock_bad", bad.status, 409)
    assert_eq_str("unlock_cur", bad.lock, "abc")
    let ok = wopi_apply("UNLOCK", "abc", 200, 100, "abc")
    assert_eq_i64("unlock_ok", ok.status, 200)
    assert_eq_i64("unlock_clear", ok.clear, 1)
    let none = wopi_apply("UNLOCK", "abc", 50, 100, "abc")
    assert_eq_i64("unlock_dead", none.status, 409)
    let ref = wopi_apply("REFRESH_LOCK", "abc", 200, 100, "abc")
    assert_eq_i64("refresh", ref.status, 200)
    assert_eq_i64("refresh_store", ref.store, 1)
    let refbad = wopi_apply("REFRESH_LOCK", "abc", 200, 100, "no")
    assert_eq_i64("refresh_bad", refbad.status, 409)
    let got = wopi_apply("GET_LOCK", "abc", 200, 100, "")
    assert_eq_i64("get", got.status, 200)
    assert_eq_str("get_lock", got.lock, "abc")
    let got0 = wopi_apply("GET_LOCK", "abc", 10, 100, "")
    assert_eq_str("get_empty", got0.lock, "")
    assert_eq_i64("ttl", wopi_lock_ttl_s(), 1800)
    assert_eq_i64("unknown", wopi_apply("BOGUS", "", 0, 1, "").status, 501)
    return 0
}

fn wopi_test_put_relative() -> i64 !IO {
    let ok = wopi_apply_ext("PUT_RELATIVE", "", 0, 100, "", "/dav/new%20file.docx", "")
    assert_eq_i64("pr_free", ok.status, 200)
    assert_eq_str("pr_name", ok.name, "new file.docx")
    let locked = wopi_apply_ext("PUT_RELATIVE", "abc", 200, 100, "abc", "x.txt", "")
    assert_eq_i64("pr_locked", locked.status, 200)
    assert_eq_str("pr_locked_name", locked.name, "x.txt")
    let clash = wopi_apply_ext("PUT_RELATIVE", "abc", 200, 100, "zzz", "x.txt", "")
    assert_eq_i64("pr_clash", clash.status, 409)
    let bad = wopi_apply_ext("PUT_RELATIVE", "", 0, 100, "", "a/b:c.txt", "")
    assert_eq_i64("pr_bad_name", bad.status, 400)
    let empty = wopi_apply_ext("PUT_RELATIVE", "", 0, 100, "", "", "")
    assert_eq_i64("pr_empty", empty.status, 400)
    let bare = wopi_apply_ext("PUT_RELATIVE", "", 0, 100, "", "plain.txt", "")
    assert_eq_str("pr_bare", bare.name, "plain.txt")
    return 0
}

fn wopi_test_rename() -> i64 !IO {
    let ok = wopi_apply_ext("RENAME_FILE", "", 0, 100, "", "", "renamed.docx")
    assert_eq_i64("rn_free", ok.status, 200)
    assert_eq_str("rn_name", ok.name, "renamed.docx")
    let locked = wopi_apply_ext("RENAME_FILE", "abc", 200, 100, "abc", "", "new%20name.txt")
    assert_eq_str("rn_decoded", locked.name, "new name.txt")
    let clash = wopi_apply_ext("RENAME_FILE", "abc", 200, 100, "zzz", "", "x.txt")
    assert_eq_i64("rn_clash", clash.status, 409)
    let bad = wopi_apply_ext("RENAME_FILE", "", 0, 100, "", "", "a/b.txt")
    assert_eq_i64("rn_bad", bad.status, 400)
    let dots = wopi_apply_ext("RENAME_FILE", "", 0, 100, "", "", "...")
    assert_eq_i64("rn_dots", dots.status, 400)
    return 0
}

fn wopi_test_delete() -> i64 !IO {
    let ok = wopi_apply("DELETE", "", 0, 100, "")
    assert_eq_i64("del_free", ok.status, 200)
    assert_eq_i64("del_clear", ok.clear, 1)
    let locked = wopi_apply("DELETE", "abc", 200, 100, "abc")
    assert_eq_i64("del_locked", locked.status, 200)
    let clash = wopi_apply("DELETE", "abc", 200, 100, "zzz")
    assert_eq_i64("del_clash", clash.status, 409)
    assert_eq_str("del_held", clash.lock, "abc")
    return 0
}

fn wopi_test_names() -> i64 !IO {
    assert_eq_i64("valid_simple", wopi_valid_name("file.txt"), 1)
    assert_eq_i64("valid_bg", wopi_valid_name("документ.docx"), 1)
    assert_eq_i64("bad_slash", wopi_valid_name("a/b"), 0)
    assert_eq_i64("bad_colon", wopi_valid_name("a:b"), 0)
    assert_eq_i64("bad_empty", wopi_valid_name(""), 0)
    assert_eq_i64("bad_dots", wopi_valid_name("..."), 0)
    assert_eq_i64("bad_star", wopi_valid_name("*"), 0)
    assert_eq_str("sug_path", wopi_suggested_name("/dav/sub/x.docx"), "x.docx")
    assert_eq_str("sug_encoded", wopi_suggested_name("%D0%94%D0%BE%D0%BA.txt"), "Док.txt")
    assert_eq_str("sug_bare", wopi_suggested_name("plain.txt"), "plain.txt")
    assert_eq_str("sug_empty", wopi_suggested_name(""), "")
    return 0
}

fn wopi_test_put() -> i64 !IO {
    let open = wopi_apply("PUT", "", 0, 100, "")
    assert_eq_i64("put_free", open.status, 200)
    let ok = wopi_apply("PUT", "abc", 200, 100, "abc")
    assert_eq_i64("put_match", ok.status, 200)
    let bad = wopi_apply("PUT", "abc", 200, 100, "no")
    assert_eq_i64("put_bad", bad.status, 409)
    assert_eq_str("put_held", bad.lock, "abc")
    let late = wopi_apply("PUT", "abc", 10, 100, "")
    assert_eq_i64("put_expired", late.status, 200)
    return 0
}

fn wopi_test_json() -> i64 !IO {
    let j = wopi_check_json("a.docx", "7", 12, "3", "abc", "Ада", 1)
    assert_true("name", str_find(j, "\"BaseFileName\":\"a.docx\"") >= 0)
    assert_true("size", str_find(j, "\"Size\":12") >= 0)
    assert_true("write", str_find(j, "\"UserCanWrite\":true") >= 0)
    assert_true("ro", str_find(j, "\"ReadOnly\":false") >= 0)
    assert_true("name_bg", str_find(j, "\"UserFriendlyName\":\"Ада\"") >= 0)
    let ro = wopi_check_json("b.txt", "1", 0, "2", "0", "Bo", 0)
    assert_true("nowrite", str_find(ro, "\"UserCanWrite\":false") >= 0)
    assert_true("readonly", str_find(ro, "\"ReadOnly\":true") >= 0)
    let q = wopi_check_json("a\"b", "1", 1, "2", "v", "n", 1)
    assert_true("escape", str_find(q, "a\\\"b") >= 0)
    return 0
}

fn wopi_test_proof() -> i64 !IO {
    let msg = wopi_proof_message("1700000000", "tok", "GET", "/wopi/files/x", "abc")
    assert_true("proof_msg", str_find(msg, "1700000000tokGET\n/wopi/files/x\nabc") >= 0)
    let mut nb: Vec<i64> = vec_new()
    vec_push(nb, 12); vec_push(nb, 161)
    let mut eb: Vec<i64> = vec_new()
    vec_push(eb, 17)
    let n_b64 = base64_encode(nb)
    let e_b64 = base64_encode(eb)
    let mut bad: Vec<i64> = vec_new()
    vec_push(bad, 1)
    assert_eq_i64("bad_proof", wopi_verify_proof(base64_encode(bad), msg, n_b64, e_b64), 0)
    assert_eq_i64("empty_proof", wopi_verify_proof("", msg, n_b64, e_b64), 0)
    assert_eq_i64("empty_mod", wopi_verify_proof(base64_encode(bad), msg, "", e_b64), 0)
    return 0
}

fn main() -> i64 !IO {
    wopi_test_lock()?
    wopi_test_unlock()?
    wopi_test_put()?
    wopi_test_json()?
    wopi_test_put_relative()?
    wopi_test_rename()?
    wopi_test_delete()?
    wopi_test_names()?
    wopi_test_proof()?
    print("wopi_test: all passed")
    return 0
}
