// pb_test.baga — C5 pbbaga wire codec + gRPC framing.

import "pbbaga/pb.baga"
import "pbbaga/grpc.baga"
import "std/str/str.baga"

fn check(name: str, ok: bool) {
    if ok {
        print(concat("ok ", name))
    } else {
        eprintln(concat("FAIL ", name))
        exit(1)
    }
}

fn main() {
    // varint: 1 → 0x01
    let v1 = pb_put_uvarint(bytes_new(0), 1)
    check("varint_1", bytes_len(v1) == 1 && bytes_at(v1, 0) == 1)

    // 300 → 0xAC 0x02 (protobuf classic example)
    let v300 = pb_put_uvarint(bytes_new(0), 300)
    check("varint_300", bytes_len(v300) == 2 && bytes_at(v300, 0) == 172 && bytes_at(v300, 1) == 2)
    let g300 = pb_get_uvarint(v300, 0)
    check("varint_300_rd", g300.ok == 1 && g300.val == 300)

    // 0
    let z = pb_put_uvarint(bytes_new(0), 0)
    check("varint_0", bytes_len(z) == 1 && bytes_at(z, 0) == 0)

    // field string + int round-trip (L3 HelloReq)
    let msg = hello_request_encode("hi", 7)
    let hr = hello_request_decode(msg)
    check("hello_name", match hr {
        HelloOk(b) => b.name == "hi",
        HelloBad => false,
    })
    check("hello_n", match hr {
        HelloOk(b) => b.n == 7,
        HelloBad => false,
    })

    // cyrillic
    let msg2 = hello_request_encode("Здравей", 1)
    let hr2 = hello_request_decode(msg2)
    check("hello_cyr", match hr2 {
        HelloOk(b) => b.name == "Здравей",
        HelloBad => false,
    })

    // unknown field skip: inject field 9 varint before name
    let mut junk = pb_field_varint(bytes_new(0), 9, 99)
    junk = bytes_concat(junk, hello_request_encode("x", 2))
    let hr3 = hello_request_decode(junk)
    check("skip_unknown", match hr3 {
        HelloOk(b) => b.name == "x" && b.n == 2,
        HelloBad => false,
    })

    // fixed32/64
    let mut fb = pb_field_fixed32(bytes_new(0), 3, 0x01020304)
    fb = pb_field_fixed64(fb, 4, 0x0102030405060708)
    let mut r = pb_reader(fb)
    let t1 = pb_next(r)
    check("f32_tag", t1.ok == 1 && t1.field == 3 && t1.wire == PB_FIXED32())
    r = PbReader { data: r.data, pos: t1.pos, ok: 1 }
    let f32 = pb_take_fixed32(r)
    check("f32_val", f32.ok == 1 && f32.val == 0x01020304)
    r = PbReader { data: r.data, pos: f32.pos, ok: 1 }
    let t2 = pb_next(r)
    r = PbReader { data: r.data, pos: t2.pos, ok: 1 }
    let f64 = pb_take_fixed64(r)
    check("f64_val", f64.ok == 1 && f64.val == 0x0102030405060708)

    // zigzag
    check("zz_neg1", pb_zigzag64(-1) == 1)
    check("zz_1", pb_zigzag64(1) == 2)
    check("unzz", pb_unzigzag64(pb_zigzag64(-42)) == -42)
    let sz = pb_field_sint64(bytes_new(0), 1, -5)
    let ts = pb_next(pb_reader(sz))
    let rv = pb_get_uvarint(sz, ts.pos)
    check("sint_round", pb_unzigzag64(rv.val) == -5)

    // negative int64 encode/decode
    let neg = pb_field_varint(bytes_new(0), 1, -2)
    let tn = pb_next(pb_reader(neg))
    let vn = pb_get_uvarint(neg, tn.pos)
    check("neg_int64", vn.ok == 1 && vn.val == -2)

    // gRPC frame (L3 GrpcMsg)
    let payload = hello_request_encode("a", 1)
    let frame = grpc_encode(payload)
    check("frame_hdr", bytes_len(frame) == 5 + bytes_len(payload) && bytes_at(frame, 0) == 0)
    let gm = grpc_decode(frame)
    check("frame_ok", match gm {
        GFrame(fr) => bytes_len(fr.payload) == bytes_len(payload),
        GBad => false,
    })
    check("frame_payload", match gm {
        GFrame(fr) => match hello_request_decode(fr.payload) {
            HelloOk(b) => b.name == "a" && b.n == 1,
            HelloBad => false,
        },
        GBad => false,
    })

    // short frame fails
    check("frame_short", match grpc_decode(bytes_new(3)) {
        GBad => true,
        GFrame(fr) => false,
    })

    // pure rpc helper
    check("rpc", hello_rpc("X", 2) == "Здравей, X×2")

    // server streaming: 3 frames
    let stream = hello_stream_replies("S", 3)
    check("stream_count", grpc_stream_count(stream) == 3)
    let r0 = grpc_stream_next(stream, 0)
    check("stream0", match r0 { StreamOk(f) => true, StreamEnd => false })
    check("stream0_msg", match r0 {
        StreamOk(f) => match hello_reply_decode(f.payload) {
            ReplyOk(m) => str_find(m, "#1") >= 0,
            ReplyBad => false,
        },
        StreamEnd => false,
    })
    let pos1 = match r0 { StreamOk(f) => f.next, StreamEnd => 0 }
    let r1 = grpc_stream_next(stream, pos1)
    let pos2 = match r1 { StreamOk(f) => f.next, StreamEnd => 0 }
    let r2 = grpc_stream_next(stream, pos2)
    check("stream2", match r2 { StreamOk(f) => true, StreamEnd => false })
    check("stream2_msg", match r2 {
        StreamOk(f) => match hello_reply_decode(f.payload) {
            ReplyOk(m) => str_find(m, "#3") >= 0,
            ReplyBad => false,
        },
        StreamEnd => false,
    })
    let pos3 = match r2 { StreamOk(f) => f.next, StreamEnd => 0 }
    let r3 = grpc_stream_next(stream, pos3)
    check("stream_end", match r3 { StreamEnd => true, StreamOk(f) => false })

    // golden: field 1 string "testing" — known from protoc
    // message { string s = 1; } with s="testing"
    // 0a 07 74 65 73 74 69 6e 67
    let gold = hello_request_encode("testing", 0)
    // only field 1 if n=0 might still encode field 2 as 0 — we always encode n
    let only = pb_field_string(bytes_new(0), 1, "testing")
    check("golden_testing", hex_encode(only) == "0a0774657374696e67")

    print("pb_test: all passed")
}
