// http_test.baga — loopback test for app-product/httpdbaga/http.baga.
// Listen + connect + accept in one process (pattern from tcp_test.baga):
// the server side parses a raw HTTP request and echoes the parsed fields
// as JSON; the client side reads the serialized response bytes.

import "../app-product/httpdbaga/http.baga"

fn check(name: str, ok: bool) {
    if ok {
        print(concat("ok ", name))
    } else {
        eprintln(concat("FAIL ", name))
        exit(1)
    }
}

// Parse the request off the fd, echo the parsed fields back as JSON.
fn serve_one(fd: i64) -> i64 !IO !Net {
    let req = http_read_request(fd)?
    let probe = http_header(req, "x-probe")
    let mut body = "{\"method\":\""
    body = concat(body, http_method(req))
    body = concat(body, "\",\"path\":\"")
    body = concat(body, http_path(req))
    body = concat(body, "\",\"probe\":\"")
    body = concat(body, probe)
    body = concat(body, "\",\"bodylen\":")
    body = concat(body, int_to_str(len(http_body(req))))
    body = concat(body, "}")
    let resp = http_json_response(200, body)
    return http_respond(fd, resp)?
}

fn main() -> i64 !Net !IO {
    let port = 18432
    let listener = tcp_listen(port)?

    // --- case 1: GET, request-line + case-insensitive header ---
    let c1 = tcp_connect("127.0.0.1", port)?
    let s1 = tcp_accept(listener)?
    tcp_write(c1, "GET /hello HTTP/1.1\r\nHost: demo\r\nX-Probe: baga\r\n\r\n")?
    serve_one(s1)?
    let resp1 = tcp_read(c1, 4096)?
    check("get_method", str_find(resp1, "\"method\":\"GET\"") >= 0)
    check("get_path", str_find(resp1, "\"path\":\"/hello\"") >= 0)
    check("header_ci", str_find(resp1, "\"probe\":\"baga\"") >= 0)
    check("status_line", str_starts_with(resp1, "HTTP/1.1 200 OK"))
    check("json_content_type", str_find(resp1, "Content-Type: application/json") >= 0)
    check("content_length", str_find(resp1, "Content-Length: ") >= 0)
    check("connection_close", str_find(resp1, "Connection: close") >= 0)
    tcp_close(c1)?
    tcp_close(s1)?

    // --- case 2: POST with a Content-Length body ---
    let c2 = tcp_connect("127.0.0.1", port)?
    let s2 = tcp_accept(listener)?
    tcp_write(c2, "POST /submit HTTP/1.1\r\nContent-Length: 11\r\n\r\nhello world")?
    serve_one(s2)?
    let resp2 = tcp_read(c2, 4096)?
    check("post_method", str_find(resp2, "\"method\":\"POST\"") >= 0)
    check("post_bodylen", str_find(resp2, "\"bodylen\":11") >= 0)
    tcp_close(c2)?
    tcp_close(s2)?

    // --- case 3: absent header parses to "" ---
    let c3 = tcp_connect("127.0.0.1", port)?
    let s3 = tcp_accept(listener)?
    tcp_write(c3, "GET / HTTP/1.1\r\n\r\n")?
    serve_one(s3)?
    let resp3 = tcp_read(c3, 4096)?
    check("absent_header_empty", str_find(resp3, "\"probe\":\"\"") >= 0)
    tcp_close(c3)?
    tcp_close(s3)?

    // --- case 4: query_param / path_only (G7) ---
    let c4 = tcp_connect("127.0.0.1", port)?
    let s4 = tcp_accept(listener)?
    tcp_write(c4, "GET /token?sub=bagatur&n=1 HTTP/1.1\r\n\r\n")?
    let req4 = http_read_request(s4)?
    check("path_raw_has_query", str_find(http_path(req4), "?") >= 0)
    check("path_only", http_path_only(req4) == "/token")
    check("query_sub", http_query_param(req4, "sub") == "bagatur")
    check("query_n", http_query_param(req4, "n") == "1")
    check("query_missing", http_query_param(req4, "nope") == "")
    http_respond(s4, http_json_response(200, "{}"))?
    tcp_close(c4)?
    tcp_close(s4)?

    // --- case 5: keep-alive — two requests over one connection ---
    let c5 = tcp_connect("127.0.0.1", port)?
    let s5 = tcp_accept(listener)?
    tcp_write(c5, "GET /one HTTP/1.1\r\nHost: x\r\n\r\nGET /two HTTP/1.1\r\nHost: x\r\n\r\n")?
    let o5a = http_read_request_r(http_reader(s5))?
    check("ka1_method", http_method(o5a.req) == "GET")
    check("ka1_path", http_path(o5a.req) == "/one")
    check("ka1_no_err", o5a.err == 0)
    check("ka1_keep", http_keepalive(o5a.req) == 1)
    http_respond_keepalive(s5, http_json_response(200, "{\"n\":\"one\"}"), 1)?
    let o5b = http_read_request_r(o5a.reader)?
    check("ka2_path", http_path(o5b.req) == "/two")
    check("ka2_no_err", o5b.err == 0)
    http_respond_keepalive(s5, http_json_response(200, "{\"n\":\"two\"}"), 0)?
    let mut acc = ""
    let mut tries: i64 = 0
    while str_find(acc, "\"n\":\"two\"") < 0 && tries < 100 {
        acc = concat(acc, tcp_read(c5, 4096)?)
        tries = tries + 1
    }
    check("ka_resp_one", str_find(acc, "\"n\":\"one\"") >= 0)
    check("ka_resp_two", str_find(acc, "\"n\":\"two\"") >= 0)
    check("ka_keepalive_header", str_find(acc, "Connection: keep-alive") >= 0)
    check("ka_close_header", str_find(acc, "Connection: close") >= 0)
    tcp_close(c5)?
    tcp_close(s5)?

    // --- case 6: chunked request body ---
    let c6 = tcp_connect("127.0.0.1", port)?
    let s6 = tcp_accept(listener)?
    tcp_write(c6, "POST /up HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nWiki\r\n5\r\npedia\r\n0\r\n\r\n")?
    let o6 = http_read_request_r(http_reader(s6))?
    check("chunked_no_err", o6.err == 0)
    check("chunked_body", http_body(o6.req) == "Wikipedia")
    check("chunked_body_bytes", bytes_len(http_body_bytes(o6.req)) == 9)
    tcp_close(c6)?
    tcp_close(s6)?

    // --- case 7: Expect: 100-continue (interim response is emitted) ---
    let c7 = tcp_connect("127.0.0.1", port)?
    let s7 = tcp_accept(listener)?
    tcp_write(c7, "POST /up HTTP/1.1\r\nExpect: 100-continue\r\nContent-Length: 5\r\n\r\nhello")?
    let o7 = http_read_request_r(http_reader(s7))?
    check("cont_no_err", o7.err == 0)
    check("cont_body", http_body(o7.req) == "hello")
    http_respond(s7, http_json_response(200, "{}"))?
    let mut acc7 = ""
    let mut tries7: i64 = 0
    while str_find(acc7, "HTTP/1.1 200") < 0 && tries7 < 100 {
        acc7 = concat(acc7, tcp_read(c7, 4096)?)
        tries7 = tries7 + 1
    }
    check("cont_interim_100", str_find(acc7, "HTTP/1.1 100 Continue") >= 0)
    check("cont_final_200", str_find(acc7, "HTTP/1.1 200") >= 0)
    tcp_close(c7)?
    tcp_close(s7)?

    // --- case 8: malformed request line -> err 400, method "" ---
    let c8 = tcp_connect("127.0.0.1", port)?
    let s8 = tcp_accept(listener)?
    tcp_write(c8, "GARBAGE\r\n\r\n")?
    let o8 = http_read_request_r(http_reader(s8))?
    check("bad_err_400", o8.err == 400)
    check("bad_method_empty", http_method(o8.req) == "")
    tcp_close(c8)?
    tcp_close(s8)?

    // --- case 9: body larger than one read() — exactness (old parser truncated) ---
    let c9 = tcp_connect("127.0.0.1", port)?
    let s9 = tcp_accept(listener)?
    let big = str_repeat("A", 10000)
    tcp_write(c9, concat(concat("POST /big HTTP/1.1\r\nContent-Length: 10000\r\n\r\n", big), ""))?
    let o9 = http_read_request_r(http_reader(s9))?
    check("big_no_err", o9.err == 0)
    check("big_body_exact", len(http_body(o9.req)) == 10000)
    tcp_close(c9)?
    tcp_close(s9)?

    tcp_close(listener)?
    print("http_test: all passed")
    return 0
}
