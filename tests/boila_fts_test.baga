// boila_fts_test.baga — P7: FTS — CREATE FTS INDEX, @@ to_tsquery/
// plainto_tsquery, BM25, DML синхронизация, restart.

import "boilaDB/server/databases.baga"
import "boilaDB/server/exec_server.baga"
import "boilaDB/sql/exec_scan.baga"
import "boilaDB/fts/fts.baga"
import "boilaDB/core/value.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn check(fails: Vec<i64>, name: str, cond: bool) {
    if cond {
        print(concat("  ok  ", name))
    } else {
        print(concat("  FAIL ", name))
        vec_push(fails, 1)
    }
}

fn wipe_shard_path(prefix: str) -> i64 !IO !Par {
    unlink(concat(prefix, ".wal"))?
    unlink(concat(prefix, ".manifest"))?
    unlink(concat(prefix, ".manifest.log"))?
    let mut g: i64 = 1
    while g <= 60 {
        unlink(concat(concat(prefix, ".sst."), int_to_str(g)))?
        unlink(concat(concat(prefix, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

fn wipe_root(root: str) -> i64 !IO !Par {
    wipe_shard_path(concat(root, "/.meta"))?
    let mut i: i64 = 0
    while i < 2 {
        wipe_shard_path(concat(concat(root, "/boila.db.s"), int_to_str(i)))?
        i = i + 1
    }
    return 0
}

fn row_id(row: Vec<BoilaVal>) -> str {
    let v = vec_get(row, 0)
    if v.tag == boila_v_i64() {
        return int_to_str(v.i)
    }
    return "?"
}

fn ids_has(res: BoilaResult, want: str) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(res.rows) {
        if row_id(vec_get(res.rows, i)) == want {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn exec1(srv: BoilaServer, sql: str) -> BoilaSrvOut !IO !Time !Par {
    return boila_server_exec(srv, "boila", sql)?
}

fn main() -> i64 !IO !Time !Par {
    print("boila_fts_test:")
    let fails: Vec<i64> = vec_new()
    // F3: idf decreases as df grows; rare term >> common
    check(fails, "idf_mono", fts_bm25_idf(1000, 1) > fts_bm25_idf(1000, 100) && fts_bm25_idf(1000, 100) > fts_bm25_idf(1000, 500))
    check(fails, "idf_pos", fts_bm25_idf(100, 10) > 0 && fts_ln_x1000(1000) > fts_ln_x1000(100))
    let root = "/tmp/baga_boila_fts_test"
    wipe_root(root)?

    let mut srv = boila_server_open(root, 2, 8, 3, 4)?
    let c1 = exec1(srv, "CREATE TABLE docs (id BIGINT, body TEXT, PRIMARY KEY (id))")
    srv = c1.srv
    check(fails, "create_table", c1.ok == 1)
    let c2 = exec1(srv, "CREATE FTS INDEX docs_fts ON docs (body)")
    srv = c2.srv
    check(fails, "create_fts", c2.ok == 1 && c2.kind == 14)
    let c3 = exec1(srv, "CREATE FTS INDEX docs_fts ON docs (body)")
    srv = c3.srv
    check(fails, "dup_fts_42710", c3.ok == 0 && c3.state == "42710")

    // документи (EN + BG)
    let i1 = exec1(srv, "INSERT INTO docs (id, body) VALUES (1, 'the quick brown fox jumps'), (2, 'the brown dog sleeps'), (3, 'quick turtle runs slowly'), (4, 'бързата кафява лисица'), (5, 'кафявото куче спи')")
    srv = i1.srv
    check(fails, "insert5", i1.ok == 1 && i1.id == 5)

    // AND
    let q1 = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('quick & fox')")
    srv = q1.srv
    check(fails, "and_query", q1.ok == 1 && vec_len(q1.res.rows) == 1 && row_id(vec_get(q1.res.rows, 0)) == "1")
    // OR
    let q2 = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('dog | turtle')")
    srv = q2.srv
    check(fails, "or_query", q2.ok == 1 && vec_len(q2.res.rows) == 2 && ids_has(q2.res, "2") == 1 && ids_has(q2.res, "3") == 1)
    // F3b: same tf=1, shorter doc ranks above padded long doc (dl norm)
    let ilong = exec1(srv, "INSERT INTO docs (id, body) VALUES (30, 'zebranoise padding padding padding padding padding padding padding padding padding'), (31, 'zebranoise')")
    srv = ilong.srv
    let qdl = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('zebranoise')")
    srv = qdl.srv
    check(fails, "bm25_dl_short_first", qdl.ok == 1 && vec_len(qdl.res.rows) == 2 && row_id(vec_get(qdl.res.rows, 0)) == "31" && row_id(vec_get(qdl.res.rows, 1)) == "30")
    // plainto
    let q3 = exec1(srv, "SELECT id FROM docs WHERE body @@ plainto_tsquery('quick turtle')")
    srv = q3.srv
    check(fails, "plain_query", q3.ok == 1 && vec_len(q3.res.rows) == 1 && row_id(vec_get(q3.res.rows, 0)) == "3")
    // BG terms
    let q4 = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('бързата')")
    srv = q4.srv
    check(fails, "bg_query", q4.ok == 1 && vec_len(q4.res.rows) == 1 && row_id(vec_get(q4.res.rows, 0)) == "4")
    // F1: Cyrillic case fold — upper query hits lower body; Ё/ё
    let q4a = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('БЪРЗАТА')")
    srv = q4a.srv
    check(fails, "bg_fold_upper", q4a.ok == 1 && vec_len(q4a.res.rows) == 1 && row_id(vec_get(q4a.res.rows, 0)) == "4")
    let q4b = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('КАФЯВА')")
    srv = q4b.srv
    check(fails, "bg_fold_stem", q4b.ok == 1 && ids_has(q4b.res, "4") == 1)
    let iyo = exec1(srv, "INSERT INTO docs (id, body) VALUES (20, 'ёлка расте')")
    srv = iyo.srv
    let qyo = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('ЁЛКА')")
    srv = qyo.srv
    check(fails, "yo_fold", qyo.ok == 1 && vec_len(qyo.res.rows) == 1 && row_id(vec_get(qyo.res.rows, 0)) == "20")
    // F1b: Latin-1 case fold (Café / CAFÉ)
    let ica = exec1(srv, "INSERT INTO docs (id, body) VALUES (21, 'café latte')")
    srv = ica.srv
    let qca = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('CAFÉ')")
    srv = qca.srv
    check(fails, "latin1_fold", qca.ok == 1 && vec_len(qca.res.rows) == 1 && row_id(vec_get(qca.res.rows, 0)) == "21")
    // F1c: Greek case fold (no tonos — plain Α-Ω)
    let igr = exec1(srv, "INSERT INTO docs (id, body) VALUES (22, 'καλημερα ελλαδα')")
    srv = igr.srv
    let qgr = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('ΕΛΛΑΔΑ')")
    srv = qgr.srv
    check(fails, "greek_fold", qgr.ok == 1 && vec_len(qgr.res.rows) == 1 && row_id(vec_get(qgr.res.rows, 0)) == "22")
    // F1d: Turkic İ→i, Şş
    let itr = exec1(srv, "INSERT INTO docs (id, body) VALUES (23, 'İstanbul ve Şişli')")
    srv = itr.srv
    let qtr = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('istanbul')")
    srv = qtr.srv
    check(fails, "turkic_i", qtr.ok == 1 && vec_len(qtr.res.rows) == 1 && row_id(vec_get(qtr.res.rows, 0)) == "23")
    let qtr2 = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('ŞİŞLİ')")
    srv = qtr2.srv
    check(fails, "turkic_s", qtr2.ok == 1 && ids_has(qtr2.res, "23") == 1)
    // F1e: final sigma ς matches σ / Σ
    let isg = exec1(srv, "INSERT INTO docs (id, body) VALUES (24, 'ολυμπος')")
    srv = isg.srv
    let qsg = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('ΟΛΥΜΠΟΣ')")
    srv = qsg.srv
    check(fails, "sigma_fold", qsg.ok == 1 && vec_len(qsg.res.rows) == 1 && row_id(vec_get(qsg.res.rows, 0)) == "24")
    // липсваща дума
    let q5 = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('lipsva')")
    srv = q5.srv
    check(fails, "no_match", q5.ok == 1 && vec_len(q5.res.rows) == 0)
    // смесени & | → 0A000
    let q6 = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('a & b | c')")
    srv = q6.srv
    check(fails, "mix_err", q6.ok == 0 && q6.state == "0A000")
    // колона без fts индекс
    let q7 = exec1(srv, "SELECT id FROM docs WHERE id @@ to_tsquery('x')")
    srv = q7.srv
    check(fails, "no_fts_col", q7.ok == 0 && q7.state == "0A000")

    // F6: @@ AND eq/range post-filter
    let qf1 = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('brown') AND id = 2")
    srv = qf1.srv
    check(fails, "fts_and_eq", qf1.ok == 1 && vec_len(qf1.res.rows) == 1 && row_id(vec_get(qf1.res.rows, 0)) == "2")
    let qf2 = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('brown') AND id = 99")
    srv = qf2.srv
    check(fails, "fts_and_eq_none", qf2.ok == 1 && vec_len(qf2.res.rows) == 0)
    let qf3 = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('quick') AND id >= 1 AND id <= 2")
    srv = qf3.srv
    check(fails, "fts_and_range", qf3.ok == 1 && vec_len(qf3.res.rows) == 1 && row_id(vec_get(qf3.res.rows, 0)) == "1")
    // Q-stream-fts: count without materializing hit rows
    let qfa = exec1(srv, "SELECT count(*) FROM docs WHERE body @@ to_tsquery('quick')")
    srv = qfa.srv
    check(fails, "fts_agg", qfa.ok == 1 && vec_len(qfa.res.rows) == 1 && vec_get(vec_get(qfa.res.rows, 0), 0).i >= 1)

    // F5: phrase — consecutive terms
    let qp1 = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('quick <-> brown')")
    srv = qp1.srv
    check(fails, "phrase_adj", qp1.ok == 1 && vec_len(qp1.res.rows) == 1 && row_id(vec_get(qp1.res.rows, 0)) == "1")
    let qp2 = exec1(srv, "SELECT id FROM docs WHERE body @@ phraseto_tsquery('brown dog')")
    srv = qp2.srv
    check(fails, "phraseto", qp2.ok == 1 && vec_len(qp2.res.rows) == 1 && row_id(vec_get(qp2.res.rows, 0)) == "2")
    let qp3 = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('quick <-> dog')")
    srv = qp3.srv
    check(fails, "phrase_no", qp3.ok == 1 && vec_len(qp3.res.rows) == 0)
    let qp4 = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('quick & fox <-> dog')")
    srv = qp4.srv
    check(fails, "phrase_mix_err", qp4.ok == 0 && qp4.state == "0A000")
    // F5 residual: <N> distance — 'quick brown fox' has fox at +2 from quick
    let qp5 = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('quick <2> fox')")
    srv = qp5.srv
    check(fails, "phrase_dist2", qp5.ok == 1 && vec_len(qp5.res.rows) == 1 && row_id(vec_get(qp5.res.rows, 0)) == "1")
    let qp6 = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('quick <1> fox')")
    srv = qp6.srv
    check(fails, "phrase_dist1_no", qp6.ok == 1 && vec_len(qp6.res.rows) == 0)
    let qp7 = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('brown <1> fox')")
    srv = qp7.srv
    check(fails, "phrase_dist1_yes", qp7.ok == 1 && vec_len(qp7.res.rows) == 1)

    // DML синхронизация: INSERT след CREATE INDEX се вижда
    let i2 = exec1(srv, "INSERT INTO docs (id, body) VALUES (6, 'quick silver')")
    srv = i2.srv
    let q8 = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('silver')")
    srv = q8.srv
    check(fails, "sync_insert", q8.ok == 1 && vec_len(q8.res.rows) == 1 && row_id(vec_get(q8.res.rows, 0)) == "6")
    // UPDATE премества текста
    let u1 = exec1(srv, "UPDATE docs SET body = 'slow silver' WHERE id = 6")
    srv = u1.srv
    check(fails, "upd_ok", u1.ok == 1 && u1.id == 1)
    let q9 = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('silver')")
    srv = q9.srv
    check(fails, "sync_update", q9.ok == 1 && vec_len(q9.res.rows) == 1 && row_id(vec_get(q9.res.rows, 0)) == "6")
    let q10 = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('quick & silver')")
    srv = q10.srv
    check(fails, "update_removed_old", q10.ok == 1 && vec_len(q10.res.rows) == 0)
    // DELETE премахва от индекса
    let d1 = exec1(srv, "DELETE FROM docs WHERE id = 6")
    srv = d1.srv
    let q11 = exec1(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('silver')")
    srv = q11.srv
    check(fails, "sync_delete", q11.ok == 1 && vec_len(q11.res.rows) == 0)

    // restart: индексът е персистентен без rebuild
    boila_server_close(srv)?
    let mut srv2 = boila_server_open(root, 2, 8, 3, 4)?
    let r1 = exec1(srv2, "SELECT id FROM docs WHERE body @@ to_tsquery('quick & fox')")
    srv2 = r1.srv
    check(fails, "restart_query", r1.ok == 1 && vec_len(r1.res.rows) == 1 && row_id(vec_get(r1.res.rows, 0)) == "1")
    boila_server_close(srv2)?

    wipe_root(root)?
    if vec_len(fails) == 0 {
        print("boila_fts_test: all passed")
        return 0
    }
    print(concat(concat("boila_fts_test: FAILED (", int_to_str(vec_len(fails))), ")"))
    return 1
}
