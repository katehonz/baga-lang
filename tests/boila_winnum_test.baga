// boila_winnum_test.baga — P21-5 window SUM/AVG/MIN/MAX over NUMERIC.
// Running/partition aggregates over a NUMERIC column stay decimal-exact.

import "boilaDB/server/databases.baga"
import "boilaDB/server/exec_server.baga"
import "boilaDB/core/value.baga"
import "boilaDB/core/numeric.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn check(fails: Vec<i64>, name: str, cond: bool) {
    if cond {
        print(concat("  ok  ", name))
    } else {
        print(concat("  FAIL ", name))
        vec_push(fails, 1)
    }
}

fn wipe_shard_path(prefix: str) -> i64 !IO !Par {
    unlink(concat(prefix, ".wal"))?
    unlink(concat(prefix, ".manifest"))?
    unlink(concat(prefix, ".manifest.log"))?
    let mut g: i64 = 1
    while g <= 60 {
        unlink(concat(concat(prefix, ".sst."), int_to_str(g)))?
        unlink(concat(concat(prefix, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

fn wipe_root(root: str) -> i64 !IO !Par {
    wipe_shard_path(concat(root, "/.meta"))?
    let mut i: i64 = 0
    while i < 2 {
        wipe_shard_path(concat(concat(root, "/boila.db.s"), int_to_str(i)))?
        i = i + 1
    }
    return 0
}

fn cell(out: BoilaSrvOut, r: i64, c: i64) -> BoilaVal {
    return vec_get(vec_get(out.res.rows, r), c)
}

fn nums(v: BoilaVal) -> str {
    if v.tag != boila_v_num() {
        return "?"
    }
    return boila_num_to_string(v.b)
}

fn main() -> i64 !IO !Time !Par {
    print("boila_winnum_test:")
    let fails: Vec<i64> = vec_new()
    let root = "/tmp/baga_boila_winnum_test"
    wipe_root(root)?

    let mut srv = boila_server_open(root, 2, 8, 3, 4)?
    check(fails, "open", srv.ok == 1)
    let c0 = boila_server_exec(srv, "boila", "CREATE TABLE w (id BIGINT, grp TEXT, amt NUMERIC, PRIMARY KEY (id))")?
    srv = c0.srv
    check(fails, "create", c0.ok == 1)
    let i1 = boila_server_exec(srv, "boila", "INSERT INTO w (id, grp, amt) VALUES (1, 'a', '10.50'), (2, 'a', '20.25'), (3, 'b', '0.10'), (4, 'b', '0.20')")?
    srv = i1.srv
    check(fails, "insert", i1.ok == 1)

    // partition SUM over NUMERIC (whole-partition frame, no ORDER BY)
    let q1 = boila_server_exec(srv, "boila", "SELECT id, SUM(amt) OVER (PARTITION BY grp) AS s FROM w ORDER BY id")?
    srv = q1.srv
    check(fails, "sum_rows", q1.ok == 1 && vec_len(q1.res.rows) == 4)
    if vec_len(q1.res.rows) == 4 {
        check(fails, "sum_tag", cell(q1, 0, 1).tag == boila_v_num())
        check(fails, "sum_a", nums(cell(q1, 0, 1)) == "30.75" && nums(cell(q1, 1, 1)) == "30.75")
        check(fails, "sum_b", nums(cell(q1, 2, 1)) == "0.3" && nums(cell(q1, 3, 1)) == "0.3")
    }

    // partition AVG over NUMERIC
    let q2 = boila_server_exec(srv, "boila", "SELECT id, AVG(amt) OVER (PARTITION BY grp) FROM w ORDER BY id")?
    srv = q2.srv
    check(fails, "avg_rows", q2.ok == 1 && vec_len(q2.res.rows) == 4)
    if vec_len(q2.res.rows) == 4 {
        check(fails, "avg_tag", cell(q2, 0, 1).tag == boila_v_num())
        check(fails, "avg_a", nums(cell(q2, 0, 1)) == "15.375")
        check(fails, "avg_b", nums(cell(q2, 2, 1)) == "0.15")
    }

    // partition MIN over NUMERIC (W2 residual closed)
    let q4 = boila_server_exec(srv, "boila", "SELECT id, MIN(amt) OVER (PARTITION BY grp) AS mn FROM w ORDER BY id")?
    srv = q4.srv
    check(fails, "min_rows", q4.ok == 1 && vec_len(q4.res.rows) == 4)
    if vec_len(q4.res.rows) == 4 {
        check(fails, "min_tag", cell(q4, 0, 1).tag == boila_v_num())
        check(fails, "min_a", nums(cell(q4, 0, 1)) == "10.5" && nums(cell(q4, 1, 1)) == "10.5")
        check(fails, "min_b", nums(cell(q4, 2, 1)) == "0.1" && nums(cell(q4, 3, 1)) == "0.1")
    }

    // partition MAX over NUMERIC
    let q5 = boila_server_exec(srv, "boila", "SELECT id, MAX(amt) OVER (PARTITION BY grp) AS mx FROM w ORDER BY id")?
    srv = q5.srv
    check(fails, "max_rows", q5.ok == 1 && vec_len(q5.res.rows) == 4)
    if vec_len(q5.res.rows) == 4 {
        check(fails, "max_tag", cell(q5, 0, 1).tag == boila_v_num())
        check(fails, "max_a", nums(cell(q5, 0, 1)) == "20.25" && nums(cell(q5, 1, 1)) == "20.25")
        check(fails, "max_b", nums(cell(q5, 2, 1)) == "0.2" && nums(cell(q5, 3, 1)) == "0.2")
    }

    // NULL rows are skipped by numeric MIN/MAX windows (PG semantics)
    let i5 = boila_server_exec(srv, "boila", "INSERT INTO w (id, grp, amt) VALUES (5, 'a', NULL)")?
    srv = i5.srv
    check(fails, "insert_null", i5.ok == 1)
    let q6 = boila_server_exec(srv, "boila", "SELECT id, MIN(amt) OVER (PARTITION BY grp) AS mn, MAX(amt) OVER (PARTITION BY grp) AS mx FROM w ORDER BY id")?
    srv = q6.srv
    check(fails, "nullskip_rows", q6.ok == 1 && vec_len(q6.res.rows) == 5)
    if vec_len(q6.res.rows) == 5 {
        check(fails, "nullskip_min_a", nums(cell(q6, 0, 1)) == "10.5" && nums(cell(q6, 1, 1)) == "10.5" && nums(cell(q6, 4, 1)) == "10.5")
        check(fails, "nullskip_max_a", nums(cell(q6, 0, 2)) == "20.25" && nums(cell(q6, 4, 2)) == "20.25")
    }

    // i64 window MIN/MAX still i64 (no regression)
    let q7 = boila_server_exec(srv, "boila", "SELECT MIN(id) OVER (), MAX(id) OVER () FROM w")?
    srv = q7.srv
    check(fails, "minmax_i64", q7.ok == 1 && vec_len(q7.res.rows) == 5 && cell(q7, 0, 0).tag == boila_v_i64() && cell(q7, 0, 0).i == 1 && cell(q7, 0, 1).tag == boila_v_i64() && cell(q7, 0, 1).i == 5)

    // i64 window SUM still i64 (no regression)
    let q3 = boila_server_exec(srv, "boila", "SELECT SUM(id) OVER () FROM w")?
    srv = q3.srv
    check(fails, "sum_i64", q3.ok == 1 && vec_len(q3.res.rows) == 5 && cell(q3, 0, 0).tag == boila_v_i64() && cell(q3, 0, 0).i == 15)

    let n = vec_len(fails)
    if n == 0 {
        print("boila_winnum_test: all passed")
        return 0
    }
    print(concat("boila_winnum_test: FAILED ", int_to_str(n)))
    return 1
}
