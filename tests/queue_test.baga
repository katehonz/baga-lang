// queue_test.baga — live workers + file-backed jobs (apps-roadmap №5).

import "queuebaga/queue.baga"
import "testbaga/assert.baga"
import "std/str/str.baga"

fn tag_job(s: str) -> str {
    return concat("H:", s)
}

fn main() -> i64 !IO !Par !Time {
    let prefix = "/tmp/baga_queue_test"
    let mut q = q_open(prefix, 3)?
    q = q_start_workers(q, 2)?

    // --- reverse job ---
    let id = q_enqueue(q, "baga")?
    assert_true("enqueue_id", id > 0)
    let st = q_wait(q, id, 2000)?
    assert_eq_str("status_done", st, "done")
    assert_eq_str("result_rev", q_result(q, id)?, "agab")

    // --- second reverse ---
    let id2 = q_enqueue(q, "xyz")?
    let st2 = q_wait(q, id2, 2000)?
    assert_eq_str("second_done", st2, "done")
    assert_eq_str("second_rev", q_result(q, id2)?, "zyx")

    // --- fail until max attempts ---
    let id3 = q_enqueue(q, "fail:x")?
    let st3 = q_wait(q, id3, 3000)?
    assert_eq_str("fail_status", st3, "failed")
    // max_attempts 3
    assert_eq_i64("fail_attempts", q_attempts(q, id3)?, 3)
    assert_true("fail_msg", str_find(q_result(q, id3)?, "failed") >= 0)

    // --- several jobs ---
    let j1 = q_enqueue(q, "one")?
    let j2 = q_enqueue(q, "two")?
    let j3 = q_enqueue(q, "three")?
    assert_eq_str("w1", q_wait(q, j1, 2000)?, "done")
    assert_eq_str("w2", q_wait(q, j2, 2000)?, "done")
    assert_eq_str("w3", q_wait(q, j3, 2000)?, "done")
    assert_eq_str("r1", q_result(q, j1)?, "eno")
    assert_eq_str("r2", q_result(q, j2)?, "owt")
    assert_eq_str("r3", q_result(q, j3)?, "eerht")

    q_close(q)?
    sleep_ms(30)

    // L5 in-process handler (no workers)
    let p2 = "/tmp/baga_queue_fn"
    let q2 = q_open(p2, 1)?
    let hid = q_enqueue(q2, "hi")?
    assert_true("fn_id", hid > 0)
    let prc = q_process_fn(p2, hid, 1, tag_job)?
    assert_eq_i64("fn_rc", prc, 0)
    assert_eq_str("fn_status", q_status(q2, hid)?, "done")
    assert_eq_str("fn_result", q_result(q2, hid)?, "H:hi")
    q_close(q2)?

    assert_eq_str("key_safe", q_key_safe("order-42"), "order-42")
    assert_eq_str("key_strip", q_key_safe("a/b!c"), "abc")
    assert_eq_str("key_empty", q_key_safe("!!!"), "")

    let p3 = concat("/tmp/baga_queue_key_", int_to_str(monotonic_ms()?))
    let mut q3 = q_open(p3, 3)?
    q3 = q_start_workers(q3, 1)?
    let ka = q_enqueue_keyed(q3, "order-1", "keyed")?
    let kb = q_enqueue_keyed(q3, "order-1", "ignored")?
    assert_true("keyed_id", ka > 0)
    assert_eq_i64("keyed_same", ka, kb)
    assert_eq_str("keyed_done", q_wait(q3, ka, 2000)?, "done")
    assert_eq_str("keyed_rev", q_result(q3, ka)?, "deyek")
    assert_eq_i64("keyed_att", q_attempts(q3, ka)?, 1)
    let kc = q_enqueue_keyed(q3, "order-2", "abc")?
    assert_true("keyed_other", kc != ka)
    let u1 = q_enqueue_keyed(q3, "!!!", "aa")?
    let u2 = q_enqueue_keyed(q3, "!!!", "bb")?
    assert_true("unsafe_new", u1 != u2)
    assert_eq_str("u1_done", q_wait(q3, u1, 2000)?, "done")
    assert_eq_str("u2_done", q_wait(q3, u2, 2000)?, "done")
    q_close(q3)?

    print("queue_test: all passed")
    return 0
}
