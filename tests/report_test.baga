// report_test.baga — HTML/IR/tpl → xlsx/csv/pdf/html

import "reportbaga/report.baga"
import "reportbaga/html_table.baga"
import "reportbaga/ir.baga"
import "csvbaga/csv.baga"
import "officebaga/office.baga"
import "zipbaga/archive.baga"
import "std/str/str.baga"
import "std/os/os.baga"
import "std/bytes/bytes.baga"

fn check(name: str, ok: bool) {
    if ok {
        print(concat("ok ", name))
    } else {
        eprintln(concat("FAIL ", name))
        exit(1)
    }
}

fn contains(hay: str, needle: str) -> bool {
    return str_find(hay, needle) >= 0
}

fn main() -> i64 !IO {
    check("version", report_version() == "0.3.4")

    let html = str_of_bytes(read_file_bytes("app-product/reportbaga/fixtures/oborotna.html")?)
    check("fixture_loaded", len(html) > 50)
    check("title", html_report_title(html) == "Оборотно-салдова ведомост")
    let doc = html_doc_parse(html)
    check("doc_ok", doc.ok == 1 && vec_len(doc.kinds) >= 3)

    let t = html_table_to_csv(html)
    check("table_ok", t.ok == 1)
    check("table_cols", t.cols == 8)
    check("table_rows", csv_nrows(t) >= 4)
    check("header_sm", csv_get(t, 0, 0) == "Сметка")
    check("row_401", csv_get(t, 1, 0) == "401")
    check("total_label", csv_get(t, 3, 1) == "Общо")

    let x = report_html_to_xlsx(html)
    check("xlsx_ok", x.ok == 1 && bytes_len(x.data) > 100)
    let rx = office_open_bytes(x.data)
    check("xlsx_open", rx.ok == 1 && office_format_of(rx.doc) == "xlsx")
    let xt = office_plain_text(rx.doc)
    check("xlsx_text_401", contains(xt, "401") && contains(xt, "Доставчици"))
    check("xlsx_text_ob", contains(xt, "Общо") || contains(xt, "503"))
    // freeze pane + sheet name in package parts
    let z = zip_open_bytes(x.data)
    check("xlsx_zip", z.ok == 1)
    let sheet = zip_read(z, "xl/worksheets/sheet1.xml")
    check("xlsx_freeze", sheet.ok == 1 && contains(str_of_bytes(sheet.data), "ySplit"))
    check("xlsx_cols", contains(str_of_bytes(sheet.data), "customWidth"))
    let wb = zip_read(z, "xl/workbook.xml")
    check("xlsx_sheet_name", wb.ok == 1 && contains(str_of_bytes(wb.data), "name="))

    let ods = report_from_html(html, "ods")
    check("ods_ok", ods.ok == 1 && bytes_len(ods.data) > 100)
    let dx = report_from_html(html, "docx")
    check("docx_ok", dx.ok == 1 && bytes_len(dx.data) > 100)
    let odt = report_from_html(html, "odt")
    check("odt_ok", odt.ok == 1 && bytes_len(odt.data) > 100)

    let inv = "<?xml version=\"1.0\" encoding=\"UTF-8\"?><html xmlns=\"http://www.w3.org/1999/xhtml\"><body><h1>ФАКТУРА</h1><p>№ 0000000001</p><table><tr><th>ПОЛУЧАТЕЛ</th><th>ДОСТАВЧИК</th></tr><tr><td>Клиент ООД</td><td>Фирма ООД</td></tr></table><table><tr><th>No</th><th>Стока / услуга</th><th>К-во</th><th>Мярка</th><th>Ед. цена</th><th>Общо</th></tr><tr><td>1</td><td>Услуга консултация</td><td>2</td><td>бр</td><td>50.00</td><td>100.00</td></tr></table></body></html>"
    let inv_odt = report_from_html_io(inv, "odt")?
    check("inv_odt_ok", inv_odt.ok == 1 && bytes_len(inv_odt.data) > 100)
    let zinv = zip_open_bytes(inv_odt.data)
    let invc = zip_read(zinv, "content.xml")
    check("inv_odt_cols", invc.ok == 1 && contains(str_of_bytes(invc.data), "table:table-column"))
    check("inv_odt_border", contains(str_of_bytes(invc.data), "fo:border-left"))
    check("inv_odt_tables", contains(str_of_bytes(invc.data), "table:name=\"T1\"") && contains(str_of_bytes(invc.data), "table:name=\"T2\""))
    let inv_pdf = report_from_html_io(inv, "pdf")?
    check("inv_pdf_ok", inv_pdf.ok == 1 && bytes_len(inv_pdf.data) > 1000)
    check("inv_pdf_magic", bytes_at(inv_pdf.data, 0) == 37 && bytes_at(inv_pdf.data, 1) == 80)
    let inv_dx = report_from_html_io(inv, "docx")?
    check("inv_docx_ok", inv_dx.ok == 1 && bytes_len(inv_dx.data) > 100)

    let c = report_html_to_csv(html)
    check("csv_ok", c.ok == 1)
    let ct = csv_parse(str_of_bytes(c.data))
    check("csv_parse_back", ct.ok == 1 && csv_get(ct, 1, 0) == "401")

    let cx = report_csv_to_xlsx(ct)
    check("csv_to_xlsx", cx.ok == 1 && bytes_len(cx.data) > 50)

    // PDF UTF-8 (Cyrillic) — needs system DejaVu
    let pdf = report_html_to_pdf(html)?
    check("pdf_ok", pdf.ok == 1 && bytes_len(pdf.data) > 1000)
    check("pdf_magic", bytes_at(pdf.data, 0) == 37 && bytes_at(pdf.data, 1) == 80)

    // ReportIR
    let ir = report_ir_from_html(html)
    check("ir_ok", ir.ok == 1 && contains(ir.title, "Оборотно"))
    check("ir_meta", contains(ir.meta, "2026") || contains(ir.meta, "Демо"))
    let hx = report_emit(ir, "html")
    check("ir_html", hx.ok == 1 && contains(str_of_bytes(hx.data), "<table>"))

    // from_table (DB-style)
    let tsv = "A\tB\n1\t2\n"
    let ir2 = report_ir_from_tsv("T", "meta", tsv)
    let x2 = report_from_table("T", "meta", ir2.table, "xlsx")
    check("from_table_xlsx", x2.ok == 1)

    // tplbaga shell
    let ctx: Map<str, str> = map_new()
    map_set(ctx, "title", "Тест отчет")
    map_set(ctx, "period", "2026-01")
    map_set(ctx, "firm", "ООД")
    let th = report_from_template(report_default_tpl(), ctx, t, "html")
    check("tpl_html", th.ok == 1 && contains(str_of_bytes(th.data), "Тест отчет"))
    check("tpl_table", contains(str_of_bytes(th.data), "401"))
    let tx = report_from_template(report_default_tpl(), ctx, t, "xlsx")
    check("tpl_xlsx", tx.ok == 1 && bytes_len(tx.data) > 100)

    print("report_test: all passed")
    return 0
}
