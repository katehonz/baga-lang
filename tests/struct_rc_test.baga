// struct_rc_test — RC5: struct полета като собственици (docs/memory-rc-struct-bg.md).
// Минава с и без --rc.

import "std/str/str.baga"

struct Wrap {
    n: i64,
    s: str
}

struct Bucket {
    items: Vec<str>
}

fn check(name: str, ok: bool) {
    if ok {
        print(concat("  ok  ", name))
    } else {
        eprintln(concat("FAIL ", name))
        exit(1)
    }
}

fn bump(w: Wrap) -> Wrap {
    return Wrap { n: w.n + 1, s: w.s }
}

fn make_w() -> Wrap {
    return Wrap { n: 1, s: concat("ma", "de") }
}

fn main() -> i64 !IO {
    // 1. локален struct — полето оцелява в borrowed binding след drop
    let mut acc = ""
    if true {
        let w = Wrap { n: 1, s: concat("drop", "-me") }
        acc = w.s
    }
    check("local_field_bind", acc == "drop-me")

    // 2. let alias — двете копия четат едно и също
    let a = Wrap { n: 2, s: concat("al", "ias") }
    let b = a
    check("alias", a.s == "alias" && b.s == "alias" && a.n == 2)

    // 3. threading s = f(s) — не dangling
    let mut d = Wrap { n: 3, s: concat("th", "read") }
    d = bump(d)
    check("thread", d.n == 4 && d.s == "thread")

    // 4. return на свеж литерал
    let r = make_w()
    check("ret", r.s == "made" && r.n == 1)

    // 5. vec_push на struct — локалът се пуска, vec държи копие
    let vs: Vec<Wrap> = vec_new()
    if true {
        let p = Wrap { n: 9, s: concat("in", "-vec") }
        vec_push(vs, p)
    }
    check("vec_push_s", vec_len(vs) == 1 && vec_get(vs, 0).s == "in-vec" && vec_get(vs, 0).n == 9)
    let g = vec_get(vs, 0)
    check("vec_get_s", g.s == "in-vec")
    check("vec_after_get", vec_get(vs, 0).s == "in-vec")

    // 6. drop на Vec<S> — полетата на box елементите се release-ват (RC5 v0.2)
    let ws: Vec<Wrap> = vec_new()
    for i in 0..3 {
        vec_push(ws, Wrap { n: i, s: concat("vec", "-elem") })
    }
    drop(ws)
    check("vec_drop_s", true)

    // 7. scope exit на Vec<S> — същото през release на локала
    if true {
        let ws2: Vec<Wrap> = vec_new()
        vec_push(ws2, Wrap { n: 7, s: concat("sc", "ope") })
    }
    check("vec_scope_s", true)

    // 8. drop на Map<str, S> — полетата на стойностите се release-ват
    let mw: Map<str, Wrap> = map_new()
    map_set(mw, "k", Wrap { n: 5, s: concat("map", "-val") })
    drop(mw)
    check("map_drop_s", true)

    // 9. vec елементът оцелява след drop на ДРУГ vec — няма споделен release
    let keep: Vec<Wrap> = vec_new()
    vec_push(keep, Wrap { n: 1, s: concat("ke", "ep") })
    let tmp: Vec<Wrap> = vec_new()
    vec_push(tmp, Wrap { n: 2, s: concat("tm", "p") })
    drop(tmp)
    check("vec_drop_isolated", vec_get(keep, 0).s == "keep")

    // 10. vec_set overwrite release-ва полетата на стария box (RC5 v0.3)
    let ovs: Vec<Wrap> = vec_new()
    vec_push(ovs, Wrap { n: 1, s: concat("ov", "-old") })
    vec_set(ovs, 0, Wrap { n: 2, s: concat("ov", "-new") })
    check("vec_set_ovw", vec_get(ovs, 0).s == "ov-new" && vec_get(ovs, 0).n == 2)

    // 11. alias-safe: overwrite със собствен елемент — няма underflow
    vec_set(ovs, 0, vec_get(ovs, 0))
    check("vec_set_self", vec_get(ovs, 0).s == "ov-new" && vec_get(ovs, 0).n == 2)

    // 12. map_set overwrite release-ва стария box; alias-safe със собствената стойност
    let ovm: Map<str, Wrap> = map_new()
    map_set(ovm, "k", Wrap { n: 1, s: concat("mo", "-ld") })
    map_set(ovm, "k", Wrap { n: 2, s: concat("mn", "-ew") })
    check("map_set_ovw", map_get(ovm, "k").s == "mn-ew" && map_get(ovm, "k").n == 2)
    map_set(ovm, "k", map_get(ovm, "k"))
    check("map_set_self", map_get(ovm, "k").s == "mn-ew")

    // 13. map_del release-ва полетата + box на откаченото entry
    let dm: Map<str, Wrap> = map_new()
    map_set(dm, "d", Wrap { n: 3, s: concat("de", "l") })
    map_del(dm, "d")
    check("map_del_s", map_len(dm) == 0)

    // 14. field overwrite release-ва старото поле (RC5 v0.4)
    let mut fw = Wrap { n: 1, s: concat("fi", "-old") }
    fw.s = concat("fi", "-new")
    check("field_ovw", fw.s == "fi-new" && fw.n == 1)

    // 15. field assign от borrowed поле — retain; двамата четат
    let src = Wrap { n: 5, s: concat("sr", "c") }
    fw.s = src.s
    check("field_borrowed", fw.s == "src" && src.s == "src")

    // 16. self-assign не underflow-ва
    fw.s = fw.s
    check("field_self", fw.s == "src")

    // 17. Vec поле overwrite release-ва стария vec
    let mut bk = Bucket { items: vec_new() }
    vec_push(bk.items, "а")
    bk.items = vec_new()
    vec_push(bk.items, "б")
    check("field_vec_ovw", vec_len(bk.items) == 1 && vec_get(bk.items, 0) == "б")

    print("struct_rc_test: all passed")
    return 0
}
