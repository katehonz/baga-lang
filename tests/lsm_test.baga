// lsm_test.baga — S5+S6 rocksbaga сценарии R7..R67: byte-target compact,
// oldest-N / size-scored pick, bloom sidecar, RESP loopback + два клиента,
// TTL, checkpoint, backup, streaming SCAN, binary values/keys.
// Engine сценарият е в lsm_engine_test.baga; помощниците — в lsm_helpers.baga.

import "lsm_helpers.baga"
import "rocksbaga/engine.baga"
import "rocksbaga/server.baga"
import "rocksbaga/db/backup.baga"
import "kvbaga/resp.baga"
import "std/net/tcp.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"
import "std/time/time.baga"

fn main() -> i64 !Net !IO !Par !Time {
    print("lsm_test:")
    let fails = vec_new()
    // --- R7: byte-size L0 target (file-count alone would not fire) ---
    wipe("/tmp/baga_lsm_bytes")?
    let mut db5 = lsm_open("/tmp/baga_lsm_bytes", 1, 100)?  // flush each put; compact_at huge
    check(fails, "r7_open", db5.ok == 1)
    db5.target_bytes = 400   // small L0 byte target
    let blob = str_repeat("X", 180)
    db5 = lsm_put(db5, "b1", blob)?   // flush L0 #1
    db5 = lsm_put(db5, "b2", blob)?   // flush L0 #2 → over bytes → L0→L1
    // After byte-triggered compact, L0 should be drained (merged to L1+).
    let n0 = lsm_count_level(db5.levels, 0)
    let n1 = lsm_count_level(db5.levels, 1)
    let n2 = lsm_count_level(db5.levels, 2)
    let n3 = lsm_count_level(db5.levels, 3)
    check(fails, "r7_l0_drained", n0 == 0)
    check(fails, "r7_promoted", n1 + n2 + n3 >= 1)
    let r7a = lsm_get(db5, "b1")?
    db5 = r7a.db
    check(fails, "r7_get_b1", r7a.found == 1 && str_of_bytes(r7a.val) == blob)
    let r7b = lsm_get(db5, "b2")?
    db5 = r7b.db
    check(fails, "r7_get_b2", r7b.found == 1 && str_of_bytes(r7b.val) == blob)
    // More L0 files with low target should still keep gens bounded
    db5 = lsm_put(db5, "b3", blob)?
    db5 = lsm_put(db5, "b4", blob)?
    db5 = lsm_put(db5, "b5", blob)?
    db5 = lsm_put(db5, "b6", blob)?
    check(fails, "r7_bounded_gens", vec_len(db5.gens) <= 6)
    let gb6 = lsm_get(db5, "b6")?
    db5 = gb6.db
    check(fails, "r7_get_b6", gb6.found == 1)
    lsm_close(db5)?

    // --- no same-level pair-collapse: 2 L1 files stay 2 (compact_at=4) ---
    wipe("/tmp/baga_lsm_nopair")?
    let mut dbnp = lsm_open("/tmp/baga_lsm_nopair", 1, 4)?
    check(fails, "np_open", dbnp.ok == 1)
    // 2 L0 flushes → not over compact_at=4 → stay L0
    dbnp = lsm_put(dbnp, "n1", "1")?
    dbnp = lsm_put(dbnp, "n2", "2")?
    check(fails, "np_l0_two", lsm_count_level(dbnp.levels, 0) == 2)
    // 2 more → L0=4 → promote to L1 (one file), no L1 pair rewrite
    dbnp = lsm_put(dbnp, "n3", "3")?
    dbnp = lsm_put(dbnp, "n4", "4")?
    check(fails, "np_after4_l0", lsm_count_level(dbnp.levels, 0) == 0)
    check(fails, "np_after4_l1", lsm_count_level(dbnp.levels, 1) == 1)
    // another 4 L0 → second L1; must NOT collapse the two L1s
    dbnp = lsm_put(dbnp, "n5", "5")?
    dbnp = lsm_put(dbnp, "n6", "6")?
    dbnp = lsm_put(dbnp, "n7", "7")?
    dbnp = lsm_put(dbnp, "n8", "8")?
    check(fails, "np_two_l1", lsm_count_level(dbnp.levels, 1) == 2)
    check(fails, "np_no_l2", lsm_count_level(dbnp.levels, 2) == 0)
    let gn8 = lsm_get(dbnp, "n8")?
    dbnp = gn8.db
    check(fails, "np_get", gn8.found == 1 && str_of_bytes(gn8.val) == "8")
    lsm_close(dbnp)?

    // --- R8: oldest-N pick leaves L0 remainder (compact_at=4, merge_pick=2) ---
    wipe("/tmp/baga_lsm_pick")?
    let mut db6 = lsm_open("/tmp/baga_lsm_pick", 1, 4)?
    check(fails, "r8_open", db6.ok == 1)
    db6.merge_pick = 2
    db6 = lsm_put(db6, "p1", "1")?
    db6 = lsm_put(db6, "p2", "2")?
    db6 = lsm_put(db6, "p3", "3")?   // L0=3 < compact_at
    check(fails, "r8_pre_n0", lsm_count_level(db6.levels, 0) == 3)
    db6 = lsm_put(db6, "p4", "4")?   // L0=4 → over → pick 2 → leave 2 L0 + 1 L1
    let r8n0 = lsm_count_level(db6.levels, 0)
    let r8n1 = lsm_count_level(db6.levels, 1)
    check(fails, "r8_l0_remainder", r8n0 == 2)
    check(fails, "r8_l1_has", r8n1 >= 1)
    let gp1 = lsm_get(db6, "p1")?
    db6 = gp1.db
    check(fails, "r8_get_p1", gp1.found == 1 && str_of_bytes(gp1.val) == "1")
    let gp4 = lsm_get(db6, "p4")?
    db6 = gp4.db
    check(fails, "r8_get_p4", gp4.found == 1 && str_of_bytes(gp4.val) == "4")
    lsm_close(db6)?

    // --- R31: size-scored pick prefers larger SST among equals/older ---
    wipe("/tmp/baga_lsm_score")?
    let mut db8 = lsm_open("/tmp/baga_lsm_score", 1, 4)?
    check(fails, "r31_open", db8.ok == 1)
    db8.merge_pick = 2
    // Small single-key SST, then a fat multi-put window via flush_at bump...
    // With flush_at=1 each put is its own SST → equal sizes; score==oldest.
    db8 = lsm_put(db8, "s1", "1")?
    db8 = lsm_put(db8, "s2", "2")?
    db8 = lsm_put(db8, "s3", "3")?
    db8 = lsm_put(db8, "s4", "4")?  // compact: pick 2, leave 2 L0
    check(fails, "r31_l0", lsm_count_level(db8.levels, 0) == 2)
    check(fails, "r31_l1", lsm_count_level(db8.levels, 1) >= 1)
    let ds = lsm_dbsize(db8)?
    db8 = ds.db
    check(fails, "r31_dbsize", ds.n == 4)
    let kr = lsm_keys(db8)?
    db8 = kr.db
    check(fails, "r31_keys_n", vec_len(kr.keys) == 4)
    lsm_close(db8)?

    // --- R9: standalone bloom sidecar (BAGABLM1) ---
    wipe("/tmp/baga_lsm_bloom")?
    let mut db7 = lsm_open("/tmp/baga_lsm_bloom", 2, 100)?
    check(fails, "r9_open", db7.ok == 1)
    db7 = lsm_put(db7, "bloom_hit", "yes")?
    db7 = lsm_put(db7, "other", "x")?   // flush → SST + .bloom.<gen>
    check(fails, "r9_has_gen", vec_len(db7.gens) >= 1)
    let g0 = vec_get(db7.gens, 0)
    let bpath = bloom_path("/tmp/baga_lsm_bloom", g0)
    check(fails, "r9_file_exists", file_exists(bpath)? == 1)
    check(fails, "r9_may_hit", bloom_file_may("/tmp/baga_lsm_bloom", g0, "bloom_hit")? == 1)
    check(fails, "r9_may_miss", bloom_file_may("/tmp/baga_lsm_bloom", g0, "zzz_absent_r9")? == 0)
    let gh = lsm_get(db7, "bloom_hit")?
    db7 = gh.db
    check(fails, "r9_get_hit", gh.found == 1 && str_of_bytes(gh.val) == "yes")
    let gm = lsm_get(db7, "zzz_absent_r9")?
    db7 = gm.db
    check(fails, "r9_get_miss", gm.found == 0)
    lsm_close(db7)?

    // --- RESP loopback ---
    wipe("/tmp/baga_lsm_resp")?
    // server reads LSMPATH from env — set via... we can't set env from baga easily
    // so use default path for serve and a dedicated wipe, OR call engine only.
    // Drive RESP by opening store in-process through lsm_exec (no go_bg needed
    // for protocol checks), plus one go_bg smoke on a free port with shared path.

    let mut sdb = lsm_open("/tmp/baga_lsm_resp", 64, 8)?
    let e1 = lsm_exec(sdb, args1("PING"))?
    sdb = e1.db
    check(fails, "resp_ping", bytes_len(e1.reply) > 0)
    let e2 = lsm_exec(sdb, args3("SET", "greet", "Здравей"))?
    sdb = e2.db
    let e3 = lsm_exec(sdb, args2("GET", "greet"))?
    sdb = e3.db
    let e4 = lsm_exec(sdb, args2("INCR", "n"))?
    sdb = e4.db
    let e5 = lsm_exec(sdb, args2("INCR", "n"))?
    sdb = e5.db
    let e6 = lsm_exec(sdb, args1("DBSIZE"))?
    sdb = e6.db
    let e7 = lsm_exec(sdb, args2("DEL", "greet"))?
    sdb = e7.db
    let e8 = lsm_exec(sdb, args2("GET", "greet"))?
    sdb = e8.db
    check(fails, "resp_set_get_del", e2.quit == 0 && e7.quit == 0)
    lsm_close(sdb)?

    // live TCP server (uses LSMPATH env if set; default /tmp/baga_lsm)
    wipe("/tmp/baga_lsm")?
    let port = 16581
    go_bg(lsm_serve, port)
    sleep_ms(250)
    let fd = tcp_connect_to("localhost", port, 5)?
    check(fails, "tcp_connect", fd >= 0)
    if fd >= 0 {
        tcp_set_timeouts(fd, 5)?
        let p = resp_round_trip(fd, args1("PING"))?
        check(fails, "tcp_ping", p.ok == 1 && p.text == "PONG")
        let s = resp_round_trip(fd, args3("SET", "x", "y"))?
        check(fails, "tcp_set", s.ok == 1 && s.text == "OK")
        let g = resp_round_trip(fd, args2("GET", "x"))?
        check(fails, "tcp_get", g.ok == 1 && g.text == "y")
        let sv = resp_round_trip(fd, args1("SAVE"))?
        check(fails, "tcp_save", sv.ok == 1)
        tcp_close(fd)?
    }

    // reopen default path after SAVE
    let db4 = lsm_open("/tmp/baga_lsm", 64, 8)?
    let gx = lsm_get(db4, "x")?
    check(fails, "tcp_durable", gx.found == 1 && str_of_bytes(gx.val) == "y")
    lsm_close(gx.db)?

    // R15: two concurrent clients on poll multi-conn share one store
    wipe("/tmp/baga_lsm")?
    let port2 = 16582
    go_bg(lsm_serve, port2)
    sleep_ms(250)
    let c1 = tcp_connect_to("localhost", port2, 5)?
    let c2 = tcp_connect_to("localhost", port2, 5)?
    check(fails, "tcp2_connect", c1 >= 0 && c2 >= 0)
    if c1 >= 0 && c2 >= 0 {
        tcp_set_timeouts(c1, 5)?
        tcp_set_timeouts(c2, 5)?
        let s1 = resp_round_trip(c1, args3("SET", "a", "from1"))?
        check(fails, "tcp2_set1", s1.ok == 1 && s1.text == "OK")
        let s2 = resp_round_trip(c2, args3("SET", "b", "from2"))?
        check(fails, "tcp2_set2", s2.ok == 1 && s2.text == "OK")
        let g1 = resp_round_trip(c1, args2("GET", "b"))?
        check(fails, "tcp2_cross_get", g1.ok == 1 && g1.text == "from2")
        let g2 = resp_round_trip(c2, args2("GET", "a"))?
        check(fails, "tcp2_cross_get2", g2.ok == 1 && g2.text == "from1")
        tcp_close(c1)?
        tcp_close(c2)?
    }

    // --- R16: TTL / EXPIRE / SETEX / PERSIST ---
    wipe("/tmp/baga_lsm_ttl")?
    let mut tdb = lsm_open("/tmp/baga_lsm_ttl", 64, 8)?
    check(fails, "ttl_open", tdb.ok == 1)
    tdb = lsm_put_ex(tdb, "temp", "v", 2)?
    let tt = lsm_ttl(tdb, "temp")?
    tdb = tt.db
    check(fails, "ttl_pos", tt.n >= 1 && tt.n <= 2)
    let tg = lsm_get(tdb, "temp")?
    tdb = tg.db
    check(fails, "ttl_get", tg.found == 1 && str_of_bytes(tg.val) == "v")
    let te = lsm_exec(tdb, args3("EXPIRE", "temp", "1"))?
    tdb = te.db
    check(fails, "ttl_expire_cmd", te.quit == 0)
    let tp = lsm_persist(tdb, "temp")?
    tdb = tp.db
    check(fails, "ttl_persist", tp.ok == 1)
    let tt2 = lsm_ttl(tdb, "temp")?
    tdb = tt2.db
    check(fails, "ttl_after_persist", tt2.n == 0 - 1)
    // short expire then wait
    tdb = lsm_put_ex(tdb, "gone", "x", 1)?
    sleep_ms(1100)
    let tg2 = lsm_get(tdb, "gone")?
    tdb = tg2.db
    check(fails, "ttl_expired_get", tg2.found == 0)
    let tt3 = lsm_ttl(tdb, "gone")?
    tdb = tt3.db
    check(fails, "ttl_expired_ttl", tt3.n == 0 - 2)
    // SETEX via RESP + durable across reopen
    let se = lsm_exec(tdb, args4("SETEX", "dur", "30", "ok"))?
    tdb = se.db
    tdb = lsm_flush_force(tdb)?
    lsm_close(tdb)?
    let tdb2 = lsm_open("/tmp/baga_lsm_ttl", 64, 8)?
    let tg3 = lsm_get(tdb2, "dur")?
    check(fails, "ttl_durable", tg3.found == 1 && str_of_bytes(tg3.val) == "ok")
    let tt4 = lsm_ttl(tg3.db, "dur")?
    check(fails, "ttl_durable_ttl", tt4.n > 0)
    lsm_close(tt4.db)?

    // --- R58: checkpoint — durable point-in-time copy ---
    wipe("/tmp/baga_lsm_cp_src")?
    wipe("/tmp/baga_lsm_cp_dst")?
    let mut cdb = lsm_open("/tmp/baga_lsm_cp_src", 8, 4)?
    cdb.sync_every = 1000
    let mut ci: i64 = 0
    while ci < 50 {
        cdb = lsm_put(cdb, concat("ck", int_to_str(ci)), concat("v", int_to_str(ci)))?
        ci = ci + 1
    }
    cdb = lsm_del(cdb, "ck0")?
    cdb = lsm_checkpoint(cdb, "/tmp/baga_lsm_cp_dst")?
    check(fails, "r58_ok", cdb.ok == 1)
    // source stays usable
    let cg = lsm_get(cdb, "ck1")?
    check(fails, "r58_src_alive", cg.found == 1)
    lsm_close(cg.db)?
    // the copy opens and has the same view
    let mut ddb = lsm_open("/tmp/baga_lsm_cp_dst", 8, 4)?
    let dg = lsm_get(ddb, "ck1")?
    check(fails, "r58_dst_get", dg.found == 1 && str_of_bytes(dg.val) == "v1")
    let dg2 = lsm_get(dg.db, "ck49")?
    check(fails, "r58_dst_last", dg2.found == 1 && str_of_bytes(dg2.val) == "v49")
    let dg3 = lsm_get(dg2.db, "ck0")?
    check(fails, "r58_dst_del", dg3.found == 0)
    let dds = lsm_dbsize(dg3.db)?
    check(fails, "r58_dst_size", dds.n == 49)
    lsm_close(dds.db)?

    // --- R62: backup create + verify + ship/restore ---
    wipe("/tmp/baga_lsm_bk_src")?
    wipe("/tmp/baga_lsm_bk_a")?
    wipe("/tmp/baga_lsm_bk_b")?
    unlink("/tmp/baga_lsm_bk_a.backup")?
    unlink("/tmp/baga_lsm_bk_b.backup")?
    let mut bdb = lsm_open("/tmp/baga_lsm_bk_src", 8, 4)?
    bdb.sync_every = 1000
    let mut bi: i64 = 0
    while bi < 30 {
        bdb = lsm_put(bdb, concat("bk", int_to_str(bi)), concat("v", int_to_str(bi)))?
        bi = bi + 1
    }
    bdb = lsm_del(bdb, "bk0")?
    let bcr = lsm_backup_create(bdb, "/tmp/baga_lsm_bk_a")?
    bdb = bcr.db
    check(fails, "r62_create_ok", bcr.stat.ok == 1 && bcr.stat.nfiles >= 1)
    lsm_close(bdb)?
    let bv = lsm_backup_verify("/tmp/baga_lsm_bk_a")?
    check(fails, "r62_verify", bv.ok == 1 && bv.nfiles == bcr.stat.nfiles)
    // open backup as ordinary store
    let mut bopen = lsm_open("/tmp/baga_lsm_bk_a", 8, 4)?
    let bg = lsm_get(bopen, "bk1")?
    check(fails, "r62_open_get", bg.found == 1 && str_of_bytes(bg.val) == "v1")
    let bg2 = lsm_get(bg.db, "bk0")?
    check(fails, "r62_open_del", bg2.found == 0)
    lsm_close(bg2.db)?
    // ship offline to second prefix + restore open
    let sh = lsm_backup_ship("/tmp/baga_lsm_bk_a", "/tmp/baga_lsm_bk_b")?
    check(fails, "r62_ship", sh.ok == 1)
    let bv2 = lsm_backup_verify("/tmp/baga_lsm_bk_b")?
    check(fails, "r62_ship_verify", bv2.ok == 1)
    let mut bopen2 = lsm_open("/tmp/baga_lsm_bk_b", 8, 4)?
    let bg3 = lsm_get(bopen2, "bk29")?
    check(fails, "r62_ship_get", bg3.found == 1 && str_of_bytes(bg3.val) == "v29")
    let bds = lsm_dbsize(bg3.db)?
    check(fails, "r62_ship_size", bds.n == 29)
    lsm_close(bds.db)?
    // --- R63: streaming SCAN snapshot (multi-page, no re-fold per page) ---
    wipe("/tmp/baga_lsm_scan")?
    let mut scandb = lsm_open("/tmp/baga_lsm_scan", 64, 8)?
    scandb.sync_every = 1000
    let mut si: i64 = 0
    while si < 25 {
        scandb = lsm_put(scandb, concat("s", int_to_str(si)), "v")?
        si = si + 1
    }
    // page through all keys with COUNT=7
    let mut cur: i64 = 0
    let mut seen_n: i64 = 0
    let mut rounds: i64 = 0
    let mut done: i64 = 0
    while done == 0 && rounds < 20 {
        let sc = lsm_scan(scandb, cur, 7, "")?
        scandb = sc.db
        seen_n = seen_n + vec_len(sc.keys)
        rounds = rounds + 1
        if sc.next == 0 {
            done = 1
        } else {
            cur = sc.next
        }
    }
    check(fails, "r63_scan_pages", rounds >= 3 && rounds <= 5)
    check(fails, "r63_scan_count", seen_n == 25)
    // MATCH filter
    let sc2 = lsm_scan(scandb, 0, 100, "s1*")?
    scandb = sc2.db
    // s1, s10..s19 → 11 keys
    check(fails, "r63_match", vec_len(sc2.keys) == 11 && sc2.next == 0)
    // write invalidates mid-stream cache; new SCAN sees new key
    scandb = lsm_put(scandb, "s99", "x")?
    let sc3 = lsm_scan(scandb, 0, 1000, "")?
    scandb = sc3.db
    check(fails, "r63_after_write", vec_len(sc3.keys) == 26 && sc3.next == 0)
    // second page after first half — cache hit path (same epoch)
    let sc4 = lsm_scan(scandb, 0, 10, "")?
    scandb = sc4.db
    check(fails, "r63_page1", vec_len(sc4.keys) == 10 && sc4.next == 10)
    let sc5 = lsm_scan(scandb, sc4.next, 10, "")?
    scandb = sc5.db
    check(fails, "r63_page2", vec_len(sc5.keys) == 10 && sc5.next == 20)
    let sc6 = lsm_scan(scandb, sc5.next, 10, "")?
    scandb = sc6.db
    check(fails, "r63_page3", vec_len(sc6.keys) == 6 && sc6.next == 0)
    // K3i: true prefix scan (no full live_map post-filter)
    wipe("/tmp/baga_lsm_pref")?
    let mut prefdb = lsm_open("/tmp/baga_lsm_pref", 8, 3)?
    prefdb.sync_every = 1000
    let mut pi: i64 = 0
    while pi < 30 {
        if pi < 10 {
            prefdb = lsm_put(prefdb, concat("a", int_to_str(pi)), "va")?
        } else {
            if pi < 20 {
                prefdb = lsm_put(prefdb, concat("b", int_to_str(pi)), "vb")?
            } else {
                prefdb = lsm_put(prefdb, concat("c", int_to_str(pi)), "vc")?
            }
        }
        pi = pi + 1
    }
    prefdb = lsm_flush_force(prefdb)?
    let sp = lsm_scan_prefix_kb(prefdb, 0, 1000, bytes_of_str("b"))?
    prefdb = sp.db
    check(fails, "k3i_prefix_n", vec_len(sp.keys) == 10)
    check(fails, "k3i_prefix_first", str_of_bytes(vec_get(sp.keys, 0)) == "b10")
    check(fails, "k3i_prefix_last", str_of_bytes(vec_get(sp.keys, 9)) == "b19")
    // warm cache same prefix
    let sp2 = lsm_scan_prefix_all_kb(prefdb, bytes_of_str("a"))?
    prefdb = sp2.db
    check(fails, "k3i_prefix_a", vec_len(sp2.keys) == 10)
    let sp3 = lsm_scan_prefix_all_kb(prefdb, bytes_of_str("z"))?
    prefdb = sp3.db
    check(fails, "k3i_prefix_empty", vec_len(sp3.keys) == 0)
    lsm_close(prefdb)?
    lsm_close(scandb)?

    // --- R65: binary RESP values (embedded NUL) ---
    wipe("/tmp/baga_lsm_bin")?
    let mut bindb = lsm_open("/tmp/baga_lsm_bin", 64, 8)?
    bindb.sync_every = 1000
    // in-process put_b / get
    let nulval = bytes_new(3)
    bytes_set(nulval, 0, 65)   // 'A'
    bytes_set(nulval, 1, 0)    // NUL
    bytes_set(nulval, 2, 66)   // 'B'
    bindb = lsm_put_b(bindb, "bk", nulval)?
    let bg0 = lsm_get(bindb, "bk")?
    bindb = bg0.db
    check(fails, "r65_put_b", bg0.found == 1 && bytes_len(bg0.val) == 3
        && bytes_at(bg0.val, 0) == 65 && bytes_at(bg0.val, 1) == 0 && bytes_at(bg0.val, 2) == 66)
    // wire: RESP encode_b → serve conn → GET bulk_b
    bindb = lsm_flush_force(bindb)?
    let bport: i64 = 17665
    let blisten = tcp_listen(bport)?
    check(fails, "r65_listen", blisten >= 0)
    if blisten >= 0 {
        let bclient = tcp_connect("127.0.0.1", bport)?
        let bserv = tcp_accept(blisten)?
        check(fails, "r65_accept", bclient >= 0 && bserv >= 0)
        // SET bin A\0B
        let setargs: Vec<bytes> = vec_new()
        vec_push(setargs, bytes_of_str("SET"))
        vec_push(setargs, bytes_of_str("wkey"))
        vec_push(setargs, nulval)
        let setcmd = resp_encode_command_b(setargs)
        tcp_write_bytes(bserv, bytes_new(0))?  // no-op keep type checker happy path
        // drive one command on server side via parse+exec_b (no full serve loop)
        let mut sdb = bindb
        let pset = resp_parse_command_b(setcmd)
        check(fails, "r65_parse_set", pset.ok == 1 && vec_len(pset.args) == 3
            && bytes_len(vec_get(pset.args, 2)) == 3 && bytes_at(vec_get(pset.args, 2), 1) == 0)
        let exs = lsm_exec_b(sdb, pset.args)?
        sdb = exs.db
        check(fails, "r65_exec_set", bytes_len(exs.reply) >= 5)
        let gbin = lsm_get(sdb, "wkey")?
        sdb = gbin.db
        check(fails, "r65_wire_get", gbin.found == 1 && bytes_len(gbin.val) == 3
            && bytes_at(gbin.val, 1) == 0)
        // APPEND binary
        let more = bytes_new(1)
        bytes_set(more, 0, 67)  // 'C'
        let apargs: Vec<bytes> = vec_new()
        vec_push(apargs, bytes_of_str("APPEND"))
        vec_push(apargs, bytes_of_str("wkey"))
        vec_push(apargs, more)
        let exa = lsm_exec_b(sdb, apargs)?
        sdb = exa.db
        let g2 = lsm_get(sdb, "wkey")?
        sdb = g2.db
        check(fails, "r65_append", g2.found == 1 && bytes_len(g2.val) == 4
            && bytes_at(g2.val, 3) == 67)
        // legacy parse still works for text (no regression)
        let leg = resp_parse_command(bytes_of_str("*2\r\n$4\r\nPING\r\n$0\r\n\r\n"))
        // actually PING is *1 — keep simple
        let leg2 = resp_parse_command(resp_encode_command(args1("PING")))
        check(fails, "r65_legacy_parse", leg2.ok == 1 && vec_len(leg2.args) == 1
            && vec_get(leg2.args, 0) == "PING")
        bindb = sdb
        close(bclient)
        close(bserv)
        close(blisten)
    }
    lsm_close(bindb)?

    // --- R67: binary-safe keys via the _kb engine APIs (embedded NUL) ---
    wipe("/tmp/baga_lsm_r67")?
    let mut kdb = lsm_open("/tmp/baga_lsm_r67", 4, 3)?
    kdb.sync_every = 1000
    let k_nul = x"610062"    // "a\0b"
    let k_nul2 = x"610063"   // "a\0c"
    let k_plain = x"6162"    // "ab"
    // put/get with embedded NUL (memtable)
    kdb = lsm_put_kb(kdb, k_nul, bytes_of_str("v-nul"))?
    kdb = lsm_put_kb(kdb, k_nul2, bytes_of_str("v-nul2"))?
    let kg1 = lsm_get_kb(kdb, k_nul)?
    kdb = kg1.db
    check(fails, "r67_get_mem", kg1.found == 1 && str_of_bytes(kg1.val) == "v-nul")
    // "a" is a prefix of "a\0b" but must NOT hit
    let kg1b = lsm_get_kb(kdb, x"61")?
    kdb = kg1b.db
    check(fails, "r67_no_prefix_hit", kg1b.found == 0)
    // auto-flush to SST (flush_at=4)
    kdb = lsm_put_kb(kdb, k_plain, bytes_of_str("v-ab"))?
    kdb = lsm_put_kb(kdb, bytes_of_str("zz"), bytes_of_str("v-zz"))?
    check(fails, "r67_flushed", vec_len(kdb.gens) >= 1 && kdb.mem_n == 0)
    // get NUL keys back from the SST (bloom + restart-index path)
    let kg2 = lsm_get_kb(kdb, k_nul)?
    kdb = kg2.db
    check(fails, "r67_get_sst", kg2.found == 1 && str_of_bytes(kg2.val) == "v-nul")
    let kg2b = lsm_get_kb(kdb, k_nul2)?
    kdb = kg2b.db
    check(fails, "r67_get_sst2", kg2b.found == 1 && str_of_bytes(kg2b.val) == "v-nul2")
    // delete one NUL key — tombstone stays in the memtable (WAL only)
    kdb = lsm_del_kb(kdb, k_nul2)?
    let kg3 = lsm_get_kb(kdb, k_nul2)?
    kdb = kg3.db
    check(fails, "r67_del", kg3.found == 0)
    // close/reopen: WAL recovery must preserve NUL keys and the tomb
    lsm_close(kdb)?
    let mut kdb2 = lsm_open("/tmp/baga_lsm_r67", 4, 3)?
    let kr1 = lsm_get_kb(kdb2, k_nul)?
    kdb2 = kr1.db
    check(fails, "r67_recover_sst", kr1.found == 1 && str_of_bytes(kr1.val) == "v-nul")
    let kr2 = lsm_get_kb(kdb2, k_nul2)?
    kdb2 = kr2.db
    check(fails, "r67_recover_tomb", kr2.found == 0)
    // compaction: one op per flush so L0 piles up and merges (compact_at=3)
    kdb2.flush_at = 1
    kdb2 = lsm_put_kb(kdb2, x"610064", bytes_of_str("v-nul3"))?  // "a\0d", flush
    kdb2 = lsm_del_kb(kdb2, k_plain)?                             // tomb "ab", flush
    kdb2 = lsm_put_kb(kdb2, bytes_of_str("zz2"), bytes_of_str("w"))? // flush → L0 merge
    let kr3 = lsm_get_kb(kdb2, k_nul)?
    kdb2 = kr3.db
    check(fails, "r67_compact_get", kr3.found == 1 && str_of_bytes(kr3.val) == "v-nul")
    let kr4 = lsm_get_kb(kdb2, k_plain)?
    kdb2 = kr4.db
    check(fails, "r67_compact_tomb", kr4.found == 0)
    let kr5 = lsm_get_kb(kdb2, x"610064")?
    kdb2 = kr5.db
    check(fails, "r67_compact_get2", kr5.found == 1 && str_of_bytes(kr5.val) == "v-nul3")
    // str wrapper API still works on the same db (sees the same store)
    kdb2 = lsm_put(kdb2, "plain", "pv")?
    let kw = lsm_get(kdb2, "plain")?
    kdb2 = kw.db
    check(fails, "r67_str_wrapper", kw.found == 1 && str_of_bytes(kw.val) == "pv")
    let kw2 = lsm_get(kdb2, "ab")?   // deleted above via the bytes path
    kdb2 = kw2.db
    check(fails, "r67_str_tomb", kw2.found == 0)
    // live: a\0b, zz, a\0d, zz2, plain (a\0c and ab are tombed)
    let ksz = lsm_dbsize(kdb2)?
    kdb2 = ksz.db
    check(fails, "r67_dbsize", ksz.n == 5)
    lsm_close(kdb2)?

    // corrupt one SST byte → verify must fail
    let mmeta = lsm_backup_load_meta("/tmp/baga_lsm_bk_b")?
    check(fails, "r62_meta_ok", mmeta.ok == 1 && vec_len(mmeta.entries) >= 1)
    let mut ei: i64 = 0
    let mut corrupt_path = ""
    while ei < vec_len(mmeta.entries) {
        let e = vec_get(mmeta.entries, ei)
        if e.kind == "sst" && corrupt_path == "" {
            corrupt_path = lsm_backup_entry_path(
                "/tmp/baga_lsm_bk_b",
                lsm_backup_shard_suffix(mmeta.nshards, e.shard),
                e.kind,
                e.gen
            )
        }
        ei = ei + 1
    }
    check(fails, "r62_found_sst", corrupt_path != "")
    if corrupt_path != "" {
        let cfd = open(corrupt_path, 2, 0)?  // O_RDWR
        if cfd >= 0 {
            let one = bytes_new(1)
            bytes_set(one, 0, 255)
            fd_pwrite_bytes(cfd, one, 0)?
            drop(one)
            close(cfd)
        }
        let bad = lsm_backup_verify("/tmp/baga_lsm_bk_b")?
        check(fails, "r62_verify_corrupt", bad.ok == 0)
    }

    if vec_len(fails) == 0 {
        print("lsm_test: all passed")
        return 0
    }
    print(concat(concat("lsm_test: FAILED (", int_to_str(vec_len(fails))), " checks)"))
    return 1
}
