// office_test.baga — officebaga: docx/xlsx/odt/ods extract + create (no pptx).

import "officebaga/office.baga"
import "officebaga/ir/ir.baga"
import "officebaga/docx/write.baga"
import "officebaga/xlsx/write.baga"
import "officebaga/opc/package.baga"
import "officebaga/core/detect.baga"
import "zipbaga/archive.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"
import "std/os/os.baga"

fn check(name: str, ok: bool) {
    if ok {
        print(concat("ok ", name))
    } else {
        eprintln(concat("FAIL ", name))
        exit(1)
    }
}

fn contains(hay: str, needle: str) -> bool {
    return str_find(hay, needle) >= 0
}

fn main() -> i64 !IO {
    check("version", office_version() == "0.3.0")
    check("pptx_hint", office_detect_path_hint("deck.pptx") == OFFICE_PPTX())
    let miss = office_open("/no/such/office.docx")?
    check("open_missing", miss.ok == 0)

    // --- DOCX create → open → text ---
    let docx_b = docx_create_bytes("Title", "Hello\nWorld & <tag>")
    let rd = office_open_bytes(docx_b)
    check("docx_open", rd.ok == 1)
    check("docx_fmt", office_format(rd.doc) == OFFICE_DOCX())
    check("docx_fmt_name", office_format_of(rd.doc) == "docx")
    let dtext = office_plain_text(rd.doc)
    check("docx_has_title", contains(dtext, "Title"))
    check("docx_has_hello", contains(dtext, "Hello"))
    check("docx_has_world", contains(dtext, "World"))
    check("docx_entities", contains(dtext, "&") && contains(dtext, "<tag>"))

    // --- XLSX create → open → text ---
    let rows: Vec<str> = vec_new()
    vec_push(rows, "Name\tQty")
    vec_push(rows, "Apple\t3")
    vec_push(rows, "Pear\t10")
    let xlsx_b = xlsx_create_bytes(rows)
    let rx = office_open_bytes(xlsx_b)
    check("xlsx_open", rx.ok == 1)
    check("xlsx_fmt", office_format(rx.doc) == OFFICE_XLSX())
    let xt = office_plain_text(rx.doc)
    check("xlsx_header", contains(xt, "Name") && contains(xt, "Qty"))
    check("xlsx_apple", contains(xt, "Apple") && contains(xt, "3"))
    check("xlsx_pear", contains(xt, "Pear") && contains(xt, "10"))

    // --- ODT: hand-built package with content.xml ---
    let odt_names = vec_new()
    let odt_parts = vec_new()
    vec_push(odt_names, "mimetype")
    vec_push(odt_parts, bytes_of_str("application/vnd.oasis.opendocument.text"))
    vec_push(odt_names, "content.xml")
    vec_push(odt_parts, bytes_of_str("<?xml version=\"1.0\"?><office:document-content xmlns:office=\"urn:oasis:names:tc:opendocument:xmlns:office:1.0\" xmlns:text=\"urn:oasis:names:tc:opendocument:xmlns:text:1.0\"><office:body><office:text><text:p>ODT Hello</text:p><text:h>Heading</text:h></office:text></office:body></office:document-content>"))
    let odt_b = zip_write_store(odt_names, odt_parts)
    let ro = office_open_bytes(odt_b)
    check("odt_open", ro.ok == 1)
    check("odt_fmt", office_format(ro.doc) == OFFICE_ODT())
    let ot = office_plain_text(ro.doc)
    check("odt_text", contains(ot, "ODT Hello") && contains(ot, "Heading"))

    // --- ODS ---
    let ods_names = vec_new()
    let ods_parts = vec_new()
    vec_push(ods_names, "mimetype")
    vec_push(ods_parts, bytes_of_str("application/vnd.oasis.opendocument.spreadsheet"))
    vec_push(ods_names, "content.xml")
    vec_push(ods_parts, bytes_of_str("<?xml version=\"1.0\"?><office:document-content xmlns:office=\"urn:oasis:names:tc:opendocument:xmlns:office:1.0\" xmlns:table=\"urn:oasis:names:tc:opendocument:xmlns:table:1.0\" xmlns:text=\"urn:oasis:names:tc:opendocument:xmlns:text:1.0\"><office:body><office:spreadsheet><table:table><table:table-row><table:table-cell><text:p>A1</text:p></table:table-cell><table:table-cell><text:p>B1</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell><text:p>A2</text:p></table:table-cell></table:table-row></table:table></office:spreadsheet></office:body></office:document-content>"))
    let ods_b = zip_write_store(ods_names, ods_parts)
    let rs = office_open_bytes(ods_b)
    check("ods_open", rs.ok == 1)
    check("ods_fmt", office_format(rs.doc) == OFFICE_ODS())
    let st = office_plain_text(rs.doc)
    check("ods_a1", contains(st, "A1"))
    check("ods_b1", contains(st, "B1"))
    check("ods_a2", contains(st, "A2"))

    // --- Markdown export + IR ---
    let md_doc = office_to_markdown(rd.doc)
    check("md_docx_hello", contains(md_doc, "Hello") && contains(md_doc, "World"))
    let md_x = office_to_markdown(rx.doc)
    check("md_xlsx_table", contains(md_x, "|") && contains(md_x, "Apple") && contains(md_x, "---"))
    let irw = office_to_ir(rd.doc)
    check("ir_word", irw.ok == 1 && irw.kind == IR_WORD() && contains(irw.text, "Hello"))
    let irs = office_to_ir(rx.doc)
    check("ir_sheet", irs.ok == 1 && irs.kind == IR_SHEET() && contains(irs.text, "Apple"))

    // --- ODT / ODS create → open → text ---
    let odt_b2 = office_odt_bytes("Hi", "Para one\nPara two")
    let ro2 = office_open_bytes(odt_b2)
    check("odt_create_open", ro2.ok == 1 && office_format(ro2.doc) == OFFICE_ODT())
    let ot2 = office_plain_text(ro2.doc)
    check("odt_create_text", contains(ot2, "Hi") && contains(ot2, "Para one") && contains(ot2, "Para two"))

    let ods_b2 = office_ods_bytes("X\tY\n1\t2")
    let rs2 = office_open_bytes(ods_b2)
    check("ods_create_open", rs2.ok == 1 && office_format(rs2.doc) == OFFICE_ODS())
    let st2 = office_plain_text(rs2.doc)
    check("ods_create_text", contains(st2, "X") && contains(st2, "Y") && contains(st2, "1") && contains(st2, "2"))

    // --- Markdown → DOCX ---
    let md_src = "# Title\n\nHello **world**\n\n- item one\n- item two\n"
    let md_docx = office_md_to_docx_bytes(md_src)
    let rmd = office_open_bytes(md_docx)
    check("md_docx_open", rmd.ok == 1 && office_format(rmd.doc) == OFFICE_DOCX())
    let mdt = office_plain_text(rmd.doc)
    check("md_docx_title", contains(mdt, "Title"))
    check("md_docx_body", contains(mdt, "Hello") && contains(mdt, "item one"))

    // --- edit: replace_text + save path (bytes) ---
    let er = office_replace_text(rd.doc, "Hello", "Zdravei")
    check("edit_replace_ok", er.ok == 1)
    let et = office_plain_text(er.doc)
    check("edit_replaced", contains(et, "Zdravei") && contains(et, "World"))
    check("edit_old_gone", contains(et, "Hello") == false)
    let eb = office_to_bytes(er.doc)
    check("edit_bytes_ok", eb.ok == 1 && bytes_len(eb.data) > 0)
    let er2 = office_open_bytes(eb.data)
    check("edit_reopen", er2.ok == 1 && contains(office_plain_text(er2.doc), "Zdravei"))

    // --- OLE2 CFB fixture ---
    let junk = bytes_new(8)
    bytes_set(junk, 0, 208)
    bytes_set(junk, 1, 207)
    bytes_set(junk, 2, 17)
    bytes_set(junk, 3, 224)
    bytes_set(junk, 4, 161)
    bytes_set(junk, 5, 177)
    bytes_set(junk, 6, 26)
    bytes_set(junk, 7, 225)
    let role = office_open_bytes(junk)
    check("ole_short_fail", role.ok == 0)

    let ole_path = "app-product/officebaga/fixtures/min.doc"
    let ole_b = read_file_bytes(ole_path)?
    if bytes_len(ole_b) > 0 {
        let ro2 = office_open_bytes(ole_b)
        check("ole_open", ro2.ok == 1 && office_format(ro2.doc) == OFFICE_DOC())
        check("ole_streams", vec_len(office_ole_streams(ro2.doc)) >= 1)
        let ot = office_plain_text(ro2.doc)
        check("ole_text", contains(ot, "Hello from ole"))
    }

    // --- PPTX rejected ---
    let ppt_names = vec_new()
    let ppt_parts = vec_new()
    vec_push(ppt_names, "ppt/presentation.xml")
    vec_push(ppt_parts, bytes_of_str("<p:presentation/>"))
    let ppt_b = zip_write_store(ppt_names, ppt_parts)
    let rp = office_open_bytes(ppt_b)
    check("pptx_rejected", rp.ok == 0)

    // --- ZIP writer round-trip (store) still works ---
    let z = zip_open_bytes(docx_b)
    check("zip_round_docx", z.ok == 1 && zip_find(z, "word/document.xml") >= 0)

    print("office_test: all passed")
    return 0
}
