// path_test.baga — pathbaga universal path helpers.

import "pathbaga/path.baga"
import "std/str/str.baga"

fn check(name: str, ok: bool) {
    if ok {
        print(concat("ok ", name))
    } else {
        eprintln(concat("FAIL ", name))
        exit(1)
    }
}

fn main() {
    check("abs", path_is_abs("/tmp") == 1)
    check("rel", path_is_abs("tmp") == 0)
    check("empty_abs", path_is_abs("") == 0)

    check("join", path_join("/var", "log") == "/var/log")
    check("join_trail", path_join("/var/", "log") == "/var/log")
    check("join_abs_b", path_join("/var", "/etc") == "/etc")
    check("join_empty_a", path_join("", "x") == "x")
    check("join_empty_b", path_join("/a", "") == "/a")
    check("join_nested", path_join("/var", "log/app") == "/var/log/app")

    let parts = vec_new()
    vec_push(parts, "/var")
    vec_push(parts, "log")
    vec_push(parts, "app.log")
    check("join_all", path_join_all(parts) == "/var/log/app.log")
    check("join_all_empty", path_join_all(vec_new()) == "")

    check("base", path_basename("/a/b.c") == "b.c")
    check("base_trail", path_basename("/a/b/") == "b")
    check("base_root", path_basename("/") == "")
    check("base_plain", path_basename("file.txt") == "file.txt")

    check("dir", path_dirname("/a/b.c") == "/a")
    check("dir_root", path_dirname("/x") == "/")
    check("dir_plain", path_dirname("file.txt") == ".")
    check("dir_nested", path_dirname("/a/b/c") == "/a/b")

    check("ext", path_ext("x.baga") == ".baga")
    check("ext_multi", path_ext("/a/b.tar.gz") == ".gz")
    check("ext_none", path_ext("README") == "")
    check("ext_dotfile", path_ext(".gitignore") == "")

    check("stem", path_stem("x.baga") == "x")
    check("stem_path", path_stem("/a/b.c") == "b")
    check("stem_none", path_stem("README") == "README")

    check("join_root", path_join("/", "a") == "/a")
    check("join_dbl_slash", path_join("/var//", "log") == "/var/log")
    check("join_many_slash", path_join("foo///", "bar") == "foo/bar")

    check("ext_dot", path_ext(".") == "")
    check("ext_ddot", path_ext("..") == "")
    check("stem_ddot", path_stem("..") == "..")
    check("ext_hidden_txt", path_ext(".hidden.txt") == ".txt")
    check("stem_hidden_txt", path_stem(".hidden.txt") == ".hidden")
    check("ext_trailing_dot", path_ext("foo.") == ".")

    check("with_ext", path_with_ext("x.baga", ".md") == "x.md")
    check("with_ext_bare", path_with_ext("/a/b.c", "png") == "/a/b.png")
    check("with_ext_strip", path_with_ext("x.baga", "") == "x")
    check("with_ext_dotfile", path_with_ext(".gitignore", ".bak") == ".gitignore.bak")

    check("clean_empty", path_clean("") == ".")
    check("clean_dot", path_clean(".") == ".")
    check("clean_slash", path_clean("/") == "/")
    check("clean_dbl", path_clean("a//b") == "a/b")
    check("clean_cur", path_clean("a/./b") == "a/b")
    check("clean_up", path_clean("a/b/../c") == "a/c")
    check("clean_root_up", path_clean("/../a") == "/a")
    check("clean_rel_up", path_clean("../a") == "../a")
    check("clean_to_dot", path_clean("a/..") == ".")
    check("clean_to_root", path_clean("/a/..") == "/")
    check("clean_trail", path_clean("/a/b/") == "/a/b")
    check("clean_nested_up", path_clean("a/../../b") == "../b")

    print("path_test: all passed")
}
