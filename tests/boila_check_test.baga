// boila_check_test.baga — P21-4 CHECK constraints.
// Table-level and column-level CHECK; PG semantics (TRUE/NULL pass,
// FALSE → 23514); enforced on INSERT, upsert and UPDATE; persisted.

import "boilaDB/server/databases.baga"
import "boilaDB/server/exec_server.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn check(fails: Vec<i64>, name: str, cond: bool) {
    if cond {
        print(concat("  ok  ", name))
    } else {
        print(concat("  FAIL ", name))
        vec_push(fails, 1)
    }
}

fn wipe_shard_path(prefix: str) -> i64 !IO !Par {
    unlink(concat(prefix, ".wal"))?
    unlink(concat(prefix, ".manifest"))?
    unlink(concat(prefix, ".manifest.log"))?
    let mut g: i64 = 1
    while g <= 60 {
        unlink(concat(concat(prefix, ".sst."), int_to_str(g)))?
        unlink(concat(concat(prefix, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

fn wipe_root(root: str) -> i64 !IO !Par {
    wipe_shard_path(concat(root, "/.meta"))?
    let mut i: i64 = 0
    while i < 2 {
        wipe_shard_path(concat(concat(root, "/boila.db.s"), int_to_str(i)))?
        i = i + 1
    }
    return 0
}

fn main() -> i64 !IO !Time !Par {
    print("boila_check_test:")
    let fails: Vec<i64> = vec_new()
    let root = "/tmp/baga_boila_check_test"
    wipe_root(root)?

    let mut srv = boila_server_open(root, 2, 8, 3, 4)?
    check(fails, "open", srv.ok == 1)

    // table-level CHECK
    let c0 = boila_server_exec(srv, "boila", "CREATE TABLE chk (id BIGINT, qty BIGINT, PRIMARY KEY (id), CHECK (qty >= 0))")?
    srv = c0.srv
    check(fails, "create_tbl_check", c0.ok == 1)

    let i1 = boila_server_exec(srv, "boila", "INSERT INTO chk (id, qty) VALUES (1, 5)")?
    srv = i1.srv
    check(fails, "ins_ok", i1.ok == 1)

    let i2 = boila_server_exec(srv, "boila", "INSERT INTO chk (id, qty) VALUES (2, -1)")?
    srv = i2.srv
    check(fails, "ins_viol_23514", i2.ok == 0 && i2.state == "23514")

    // NULL passes a CHECK (PG semantics)
    let i3 = boila_server_exec(srv, "boila", "INSERT INTO chk (id, qty) VALUES (3, NULL)")?
    srv = i3.srv
    check(fails, "ins_null_pass", i3.ok == 1)

    // UPDATE enforcement
    let u1 = boila_server_exec(srv, "boila", "UPDATE chk SET qty = -5 WHERE id = 1")?
    srv = u1.srv
    check(fails, "upd_viol_23514", u1.ok == 0 && u1.state == "23514")
    let u2 = boila_server_exec(srv, "boila", "UPDATE chk SET qty = 10 WHERE id = 1")?
    srv = u2.srv
    check(fails, "upd_ok", u2.ok == 1)

    // column-level CHECK
    let c1 = boila_server_exec(srv, "boila", "CREATE TABLE c2 (id BIGINT, v BIGINT CHECK (v > 0), PRIMARY KEY (id))")?
    srv = c1.srv
    check(fails, "create_col_check", c1.ok == 1)
    let i4 = boila_server_exec(srv, "boila", "INSERT INTO c2 (id, v) VALUES (1, 0)")?
    srv = i4.srv
    check(fails, "col_check_viol", i4.ok == 0 && i4.state == "23514")
    let i5 = boila_server_exec(srv, "boila", "INSERT INTO c2 (id, v) VALUES (2, 3)")?
    srv = i5.srv
    check(fails, "col_check_ok", i5.ok == 1)

    // multiple CHECKs (both must hold)
    let c2 = boila_server_exec(srv, "boila", "CREATE TABLE c3 (id BIGINT, a BIGINT, PRIMARY KEY (id), CHECK (a >= 1), CHECK (a <= 100))")?
    srv = c2.srv
    let i6 = boila_server_exec(srv, "boila", "INSERT INTO c3 (id, a) VALUES (1, 50)")?
    srv = i6.srv
    check(fails, "multi_ok", i6.ok == 1)
    let i7 = boila_server_exec(srv, "boila", "INSERT INTO c3 (id, a) VALUES (2, 200)")?
    srv = i7.srv
    check(fails, "multi_viol", i7.ok == 0 && i7.state == "23514")

    boila_server_close(srv)?

    // restart: checks persist in the schema-row tail
    let mut srv2 = boila_server_open(root, 2, 8, 3, 4)?
    check(fails, "reopen", srv2.ok == 1)
    let r1 = boila_server_exec(srv2, "boila", "INSERT INTO chk (id, qty) VALUES (9, -3)")?
    srv2 = r1.srv
    check(fails, "restart_viol", r1.ok == 0 && r1.state == "23514")
    let r2 = boila_server_exec(srv2, "boila", "SELECT count(*) FROM chk")?
    srv2 = r2.srv
    check(fails, "count", r2.ok == 1 && vec_get(vec_get(r2.res.rows, 0), 0).i == 2)
    boila_server_close(srv2)?

    let n = vec_len(fails)
    if n == 0 {
        print("boila_check_test: all passed")
        return 0
    }
    print(concat("boila_check_test: FAILED ", int_to_str(n)))
    return 1
}
