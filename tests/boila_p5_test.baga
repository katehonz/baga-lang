// boila_p5_test.baga — P5: ORDER BY/OFFSET/DISTINCT, агрегати, GROUP BY/
// HAVING, JOIN (NL + index nested loop + LEFT), семантични грешки.

import "boilaDB/storage/databases.baga"
import "boilaDB/sql/exec_server.baga"
import "boilaDB/sql/exec_scan.baga"
import "boilaDB/sql/plan_cache.baga"
import "boilaDB/core/value.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn check(fails: Vec<i64>, name: str, cond: bool) {
    if cond {
        print(concat("  ok  ", name))
    } else {
        print(concat("  FAIL ", name))
        vec_push(fails, 1)
    }
}

fn wipe_shard_path(prefix: str) -> i64 !IO !Par {
    unlink(concat(prefix, ".wal"))?
    unlink(concat(prefix, ".manifest"))?
    unlink(concat(prefix, ".manifest.log"))?
    let mut g: i64 = 1
    while g <= 60 {
        unlink(concat(concat(prefix, ".sst."), int_to_str(g)))?
        unlink(concat(concat(prefix, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

fn wipe_root(root: str) -> i64 !IO !Par {
    wipe_shard_path(concat(root, "/.meta"))?
    let mut i: i64 = 0
    while i < 2 {
        wipe_shard_path(concat(concat(root, "/boila.db.s"), int_to_str(i)))?
        i = i + 1
    }
    return 0
}

fn cell(row: Vec<BoilaVal>, ix: i64) -> str {
    let v = vec_get(row, ix)
    if v.tag == boila_v_str() {
        return str_of_bytes(v.b)
    }
    if v.tag == boila_v_i64() {
        return int_to_str(v.i)
    }
    if v.tag == boila_v_null() {
        return "<null>"
    }
    return "?"
}

fn exec(srv: BoilaServer, sql: str) -> BoilaSrvOut !IO !Time !Par {
    return boila_server_exec(srv, "boila", sql)?
}

fn main() -> i64 !IO !Time !Par {
    print("boila_p5_test:")
    let fails: Vec<i64> = vec_new()
    let root = "/tmp/baga_boila_p5_test"
    wipe_root(root)?

    let mut srv = boila_server_open(root, 2, 8, 3, 4)?
    let c1 = exec(srv, "CREATE TABLE emp (id BIGINT, dept TEXT, salary BIGINT, name TEXT, PRIMARY KEY (id))")?
    srv = c1.srv
    let c2 = exec(srv, "INSERT INTO emp (id, dept, salary, name) VALUES (1, 'eng', 100, 'alice'), (2, 'eng', 120, 'boris'), (3, 'hr', 90, 'cveti'), (4, 'hr', 95, 'dana'), (5, 'eng', 110, 'evgeni')")?
    srv = c2.srv
    check(fails, "seed_emp", c1.ok == 1 && c2.ok == 1 && c2.id == 5)
    let c3 = exec(srv, "CREATE TABLE dep (code TEXT, loc TEXT, PRIMARY KEY (code))")?
    srv = c3.srv
    let c4 = exec(srv, "INSERT INTO dep (code, loc) VALUES ('eng', 'sofia'), ('hr', 'varna'), ('fin', 'plovdiv')")?
    srv = c4.srv
    check(fails, "seed_dep", c3.ok == 1 && c4.ok == 1)

    // --- ORDER BY asc/desc ---
    let o1 = exec(srv, "SELECT name FROM emp ORDER BY salary DESC LIMIT 2")?
    srv = o1.srv
    check(fails, "order_desc", o1.ok == 1 && vec_len(o1.res.rows) == 2 && cell(vec_get(o1.res.rows, 0), 0) == "boris" && cell(vec_get(o1.res.rows, 1), 0) == "evgeni")
    let o2 = exec(srv, "SELECT id FROM emp ORDER BY dept, salary LIMIT 3")?
    srv = o2.srv
    check(fails, "order_multi", o2.ok == 1 && vec_len(o2.res.rows) == 3 && cell(vec_get(o2.res.rows, 0), 0) == "1" && cell(vec_get(o2.res.rows, 1), 0) == "5" && cell(vec_get(o2.res.rows, 2), 0) == "2")

    // --- OFFSET + LIMIT ---
    let o3 = exec(srv, "SELECT id FROM emp ORDER BY id LIMIT 2 OFFSET 2")?
    srv = o3.srv
    check(fails, "offset", o3.ok == 1 && vec_len(o3.res.rows) == 2 && cell(vec_get(o3.res.rows, 0), 0) == "3" && cell(vec_get(o3.res.rows, 1), 0) == "4")

    // --- DISTINCT ---
    let d1 = exec(srv, "SELECT DISTINCT dept FROM emp ORDER BY dept")?
    srv = d1.srv
    check(fails, "distinct", d1.ok == 1 && vec_len(d1.res.rows) == 2 && cell(vec_get(d1.res.rows, 0), 0) == "eng" && cell(vec_get(d1.res.rows, 1), 0) == "hr")

    // --- агрегати без GROUP BY ---
    let a1 = exec(srv, "SELECT count(*), sum(salary), avg(salary), min(salary), max(salary) FROM emp")?
    srv = a1.srv
    check(fails, "agg_all", a1.ok == 1 && vec_len(a1.res.rows) == 1 && cell(vec_get(a1.res.rows, 0), 0) == "5" && cell(vec_get(a1.res.rows, 0), 1) == "515" && cell(vec_get(a1.res.rows, 0), 2) == "103" && cell(vec_get(a1.res.rows, 0), 3) == "90" && cell(vec_get(a1.res.rows, 0), 4) == "120")
    let a2 = exec(srv, "SELECT count(*) FROM emp WHERE id = 999")?
    srv = a2.srv
    check(fails, "agg_empty", a2.ok == 1 && vec_len(a2.res.rows) == 1 && cell(vec_get(a2.res.rows, 0), 0) == "0")
    let a3 = exec(srv, "SELECT count(salary) FROM emp")?
    srv = a3.srv
    check(fails, "agg_count_col", a3.ok == 1 && cell(vec_get(a3.res.rows, 0), 0) == "5")

    // --- GROUP BY ---
    let g1 = exec(srv, "SELECT dept, count(*), sum(salary) FROM emp GROUP BY dept ORDER BY dept")?
    srv = g1.srv
    check(fails, "group_by", g1.ok == 1 && vec_len(g1.res.rows) == 2 && cell(vec_get(g1.res.rows, 0), 0) == "eng" && cell(vec_get(g1.res.rows, 0), 1) == "3" && cell(vec_get(g1.res.rows, 0), 2) == "330" && cell(vec_get(g1.res.rows, 1), 0) == "hr" && cell(vec_get(g1.res.rows, 1), 2) == "185")

    // --- HAVING ---
    let h1 = exec(srv, "SELECT dept, count(*) FROM emp GROUP BY dept HAVING count(*) >= 3")?
    srv = h1.srv
    check(fails, "having", h1.ok == 1 && vec_len(h1.res.rows) == 1 && cell(vec_get(h1.res.rows, 0), 0) == "eng")

    // --- A2: hash join (no index on inner join col yet) ---
    let j1 = exec(srv, "SELECT name, loc FROM emp JOIN dep ON dept = code ORDER BY id LIMIT 2")?
    srv = j1.srv
    check(fails, "join_hash", j1.ok == 1 && vec_len(j1.res.rows) == 2 && cell(vec_get(j1.res.rows, 0), 0) == "alice" && cell(vec_get(j1.res.rows, 0), 1) == "sofia")

    // --- JOIN index nested loop (индекс по вътрешната колона) ---
    let jx = exec(srv, "CREATE INDEX emp_dept_ix ON emp (dept)")?
    srv = jx.srv
    let j2 = exec(srv, "SELECT code, name FROM dep JOIN emp ON code = dept WHERE code = 'hr' ORDER BY id")?
    srv = j2.srv
    check(fails, "join_inl", j2.ok == 1 && vec_len(j2.res.rows) == 2 && cell(vec_get(j2.res.rows, 0), 1) == "cveti" && cell(vec_get(j2.res.rows, 1), 1) == "dana")
    // A3c: multi-eq ON
    let jm = exec(srv, "SELECT name, loc FROM emp JOIN dep ON dept = code AND dept = code WHERE name = 'alice'")?
    srv = jm.srv
    check(fails, "join_on_and", jm.ok == 1 && vec_len(jm.res.rows) == 1 && cell(vec_get(jm.res.rows, 0), 0) == "alice")

    // --- LEFT JOIN: dep ред без съвпадение → NULL ---
    let c5 = exec(srv, "INSERT INTO emp (id, dept, salary, name) VALUES (6, 'ops', 80, 'franko')")?
    srv = c5.srv
    let j3 = exec(srv, "SELECT dept, loc FROM emp LEFT JOIN dep ON dept = code WHERE dept = 'ops'")?
    srv = j3.srv
    check(fails, "left_join_null", j3.ok == 1 && vec_len(j3.res.rows) == 1 && cell(vec_get(j3.res.rows, 0), 1) == "<null>")
    let j4 = exec(srv, "SELECT dept, loc FROM emp JOIN dep ON dept = code WHERE dept = 'ops'")?
    srv = j4.srv
    check(fails, "inner_join_skip", j4.ok == 1 && vec_len(j4.res.rows) == 0)

    // --- A3: WHERE on right table column (post-filter) ---
    let jr = exec(srv, "SELECT name, loc FROM emp JOIN dep ON dept = code WHERE loc = 'sofia' ORDER BY id")?
    srv = jr.srv
    check(fails, "join_where_right", jr.ok == 1 && vec_len(jr.res.rows) >= 1 && cell(vec_get(jr.res.rows, 0), 1) == "sofia")
    let jrl = exec(srv, "SELECT dept, loc FROM emp LEFT JOIN dep ON dept = code WHERE loc = 'sofia'")?
    srv = jrl.srv
    check(fails, "left_where_right", jrl.ok == 1 && vec_len(jrl.res.rows) >= 1)
    // WHERE on right null-eliminates LEFT unmatched (SQL semantics)
    let jrn = exec(srv, "SELECT dept, loc FROM emp LEFT JOIN dep ON dept = code WHERE loc = 'nowhere'")?
    srv = jrn.srv
    check(fails, "left_where_right_empty", jrn.ok == 1 && vec_len(jrn.res.rows) == 0)
    // A3b: range WHERE on right table column
    let jrr = exec(srv, "SELECT name, code FROM emp JOIN dep ON dept = code WHERE code >= 'hr' AND code <= 'hr' ORDER BY id")?
    srv = jrr.srv
    check(fails, "join_range_right", jrr.ok == 1 && vec_len(jrr.res.rows) == 2 && cell(vec_get(jrr.res.rows, 0), 1) == "hr")
    let jrr2 = exec(srv, "SELECT name, loc FROM emp JOIN dep ON dept = code WHERE loc >= 'sof' AND loc <= 'soz' ORDER BY id")?
    srv = jrr2.srv
    check(fails, "join_range_right_loc", jrr2.ok == 1 && vec_len(jrr2.res.rows) >= 1 && cell(vec_get(jrr2.res.rows, 0), 1) == "sofia")

    // --- C1: JOIN plan cache hit + same result on warm path ---
    let jsql = "SELECT name, loc FROM emp JOIN dep ON dept = code ORDER BY id LIMIT 2"
    let jc1 = exec(srv, jsql)?
    srv = jc1.srv
    let hit = boila_pc_get(srv.pc, jsql)
    check(fails, "join_pc_hit", hit.hit == 1 && hit.plan.sel.has_join == 1)
    let jc2 = exec(srv, jsql)?
    srv = jc2.srv
    check(fails, "join_pc_warm", jc2.ok == 1 && vec_len(jc2.res.rows) == 2 && cell(vec_get(jc2.res.rows, 0), 0) == "alice")

    // --- Q-like: LIKE / ILIKE ---
    let lk = exec(srv, "SELECT name FROM emp WHERE name LIKE 'a%' ORDER BY id")?
    srv = lk.srv
    check(fails, "like_prefix", lk.ok == 1 && vec_len(lk.res.rows) == 1 && cell(vec_get(lk.res.rows, 0), 0) == "alice")
    let lk2 = exec(srv, "SELECT name FROM emp WHERE name LIKE '%is' ORDER BY id")?
    srv = lk2.srv
    check(fails, "like_suffix", lk2.ok == 1 && vec_len(lk2.res.rows) == 1 && cell(vec_get(lk2.res.rows, 0), 0) == "boris")
    let lk3 = exec(srv, "SELECT name FROM emp WHERE name LIKE '_veti'")?
    srv = lk3.srv
    check(fails, "like_under", lk3.ok == 1 && vec_len(lk3.res.rows) == 1 && cell(vec_get(lk3.res.rows, 0), 0) == "cveti")
    let lk4 = exec(srv, "SELECT name FROM emp WHERE name ILIKE 'AL%'")?
    srv = lk4.srv
    check(fails, "ilike_fold", lk4.ok == 1 && vec_len(lk4.res.rows) == 1 && cell(vec_get(lk4.res.rows, 0), 0) == "alice")
    let lk5 = exec(srv, "SELECT name FROM emp WHERE name LIKE '%a%' AND dept = 'eng' ORDER BY id")?
    srv = lk5.srv
    check(fails, "like_and_eq", lk5.ok == 1 && vec_len(lk5.res.rows) >= 1)
    let lk6 = exec(srv, "SELECT name FROM emp WHERE name NOT LIKE 'a%' ORDER BY id")?
    srv = lk6.srv
    check(fails, "not_like", lk6.ok == 1 && vec_len(lk6.res.rows) >= 4)
    let lk7 = exec(srv, "SELECT name FROM emp WHERE name NOT ILIKE 'AL%' ORDER BY id")?
    srv = lk7.srv
    check(fails, "not_ilike", lk7.ok == 1 && vec_len(lk7.res.rows) >= 4)

    // --- Q-lt/gt exclusive ---
    let gt = exec(srv, "SELECT id FROM emp WHERE id > 4 ORDER BY id")?
    srv = gt.srv
    check(fails, "gt_pk", gt.ok == 1 && vec_len(gt.res.rows) >= 1 && cell(vec_get(gt.res.rows, 0), 0) == "5")
    let lt = exec(srv, "SELECT id FROM emp WHERE id < 3 ORDER BY id")?
    srv = lt.srv
    check(fails, "lt_pk", lt.ok == 1 && vec_len(lt.res.rows) == 2 && cell(vec_get(lt.res.rows, 1), 0) == "2")
    let gt2 = exec(srv, "SELECT name FROM emp WHERE salary > 100 ORDER BY id")?
    srv = gt2.srv
    check(fails, "gt_nonpk", gt2.ok == 1 && vec_len(gt2.res.rows) >= 1)

    // --- Q-between / Q-in ---
    let bt = exec(srv, "SELECT id FROM emp WHERE id BETWEEN 2 AND 4 ORDER BY id")?
    srv = bt.srv
    check(fails, "between_pk", bt.ok == 1 && vec_len(bt.res.rows) == 3 && cell(vec_get(bt.res.rows, 0), 0) == "2")
    let bt2 = exec(srv, "SELECT name FROM emp WHERE salary BETWEEN 95 AND 110 ORDER BY id")?
    srv = bt2.srv
    check(fails, "between_nonpk", bt2.ok == 1 && vec_len(bt2.res.rows) >= 2)
    let nbt = exec(srv, "SELECT id FROM emp WHERE id NOT BETWEEN 2 AND 5 ORDER BY id")?
    srv = nbt.srv
    check(fails, "not_between", nbt.ok == 1 && vec_len(nbt.res.rows) == 2 && cell(vec_get(nbt.res.rows, 0), 0) == "1" && cell(vec_get(nbt.res.rows, 1), 0) == "6")
    let inn = exec(srv, "SELECT name FROM emp WHERE id IN (1, 3, 5) ORDER BY id")?
    srv = inn.srv
    check(fails, "in_pk", inn.ok == 1 && vec_len(inn.res.rows) == 3 && cell(vec_get(inn.res.rows, 0), 0) == "alice")
    let inn2 = exec(srv, "SELECT name FROM emp WHERE dept IN ('hr', 'ops') ORDER BY id")?
    srv = inn2.srv
    check(fails, "in_text", inn2.ok == 1 && vec_len(inn2.res.rows) >= 2)
    let nin = exec(srv, "SELECT name FROM emp WHERE id NOT IN (1, 2, 3, 4, 6) ORDER BY id")?
    srv = nin.srv
    check(fails, "not_in", nin.ok == 1 && vec_len(nin.res.rows) == 1 && cell(vec_get(nin.res.rows, 0), 0) == "evgeni")
    let or1 = exec(srv, "SELECT name FROM emp WHERE id = 1 OR id = 3 OR id = 5 ORDER BY id")?
    srv = or1.srv
    check(fails, "or_eq_in", or1.ok == 1 && vec_len(or1.res.rows) == 3 && cell(vec_get(or1.res.rows, 0), 0) == "alice")
    let or2 = exec(srv, "SELECT name FROM emp WHERE dept = 'hr' OR dept = 'ops' ORDER BY id")?
    srv = or2.srv
    check(fails, "or_eq_text", or2.ok == 1 && vec_len(or2.res.rows) >= 2)
    let ne = exec(srv, "SELECT name FROM emp WHERE dept <> 'eng' ORDER BY id")?
    srv = ne.srv
    check(fails, "ne_dept", ne.ok == 1 && vec_len(ne.res.rows) >= 2)
    let ne2 = exec(srv, "SELECT name FROM emp WHERE id != 1 ORDER BY id LIMIT 1")?
    srv = ne2.srv
    check(fails, "ne_bang", ne2.ok == 1 && vec_len(ne2.res.rows) == 1 && cell(vec_get(ne2.res.rows, 0), 0) == "boris")

    // --- семантични грешки ---
    let e1 = exec(srv, "SELECT dept, count(*) FROM emp")?
    srv = e1.srv
    check(fails, "err_mix_no_group", e1.ok == 0 && e1.state == "0A000")
    let e2 = exec(srv, "SELECT name FROM emp ORDER BY nope")?
    srv = e2.srv
    check(fails, "err_order_col", e2.ok == 0 && e2.state == "42703")
    let e3 = exec(srv, "SELECT name FROM emp JOIN dep ON dept = code JOIN dep ON dept = code")?
    srv = e3.srv
    check(fails, "err_second_join", e3.ok == 0 && e3.state == "0A000")
    let e4 = exec(srv, "SELECT sum(dept) FROM emp")?
    srv = e4.srv
    check(fails, "err_sum_text", e4.ok == 0 && e4.state == "0A000")

    boila_server_close(srv)?
    wipe_root(root)?
    if vec_len(fails) == 0 {
        print("boila_p5_test: all passed")
        return 0
    }
    print(concat(concat("boila_p5_test: FAILED (", int_to_str(vec_len(fails))), ")"))
    return 1
}
