// boila_sql_read_test.baga — boilaDB P1: end-to-end SQL read path.
// CREATE TABLE през /sql-диспеча, seed през storage фасада (DML е P2),
// SELECT-и, грешки с SQLSTATE, restart персистентност.

import "boilaDB/storage/shards.baga"
import "boilaDB/sql/exec_sql.baga"
import "boilaDB/sql/exec_scan.baga"
import "boilaDB/core/codec.baga"
import "boilaDB/core/value.baga"
import "boilaDB/core/row.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

fn check(fails: Vec<i64>, name: str, cond: bool) {
    if cond {
        print(concat("  ok  ", name))
    } else {
        print(concat("  FAIL ", name))
        vec_push(fails, 1)
    }
}

fn wipe_shards(dir: str, n: i64) -> i64 !IO {
    let mut i: i64 = 0
    while i < n {
        let mut p = dir
        if n > 1 {
            p = concat(concat(dir, ".s"), int_to_str(i))
        }
        unlink(concat(p, ".wal"))?
        unlink(concat(p, ".manifest"))?
        unlink(concat(p, ".manifest.log"))?
        let mut g: i64 = 1
        while g <= 30 {
            unlink(concat(concat(p, ".sst."), int_to_str(g)))?
            unlink(concat(concat(p, ".bloom."), int_to_str(g)))?
            g = g + 1
        }
        i = i + 1
    }
    return 0
}

fn seed_user(s: BoilaStore, tid: i64, id: i64, name: str) -> BoilaStore !IO !Time {
    let row: Vec<BoilaVal> = vec_new()
    vec_push(row, boila_val_i64(id))
    vec_push(row, boila_val_str(name))
    return boila_put(s, boila_cf_data(), tid, boila_val_enc(boila_val_i64(id)), boila_row_enc(row))?
}

fn row_str(row: Vec<BoilaVal>, ix: i64) -> str {
    let v = vec_get(row, ix)
    if v.tag == boila_v_str() {
        return str_of_bytes(v.b)
    }
    if v.tag == boila_v_i64() {
        return int_to_str(v.i)
    }
    return "?"
}

fn main() -> i64 !IO !Time {
    print("boila_sql_read_test:")
    let fails: Vec<i64> = vec_new()
    let dir = "/tmp/baga_boila_sql_read_test"
    wipe_shards(dir, 2)?

    let mut s = boila_open(dir, 2, 8, 3)?

    // --- CREATE TABLE през SQL ---
    let c1 = boila_exec_sql(s, "CREATE TABLE users (id BIGINT, name TEXT, PRIMARY KEY (id));")?
    s = c1.s
    check(fails, "create_ok", c1.ok == 1 && c1.kind == 2 && c1.id == 1)

    // seed: 10 потребителя (INSERT идва в P2 — директно през storage)
    let mut i: i64 = 1
    while i <= 10 {
        s = seed_user(s, c1.id, i, concat("user", int_to_str(i)))?
        i = i + 1
    }

    // --- point lookup ---
    let q1 = boila_exec_sql(s, "SELECT * FROM users WHERE id = 7")?
    s = q1.s
    check(fails, "point_ok", q1.ok == 1 && q1.kind == 1)
    check(fails, "point_cols", vec_len(q1.res.cols) == 2 && vec_get(q1.res.cols, 0) == "id" && vec_get(q1.res.cols, 1) == "name")
    check(fails, "point_row", vec_len(q1.res.rows) == 1 && row_str(vec_get(q1.res.rows, 0), 0) == "7" && row_str(vec_get(q1.res.rows, 0), 1) == "user7")

    // --- range + проекция (SCAN е hash-подреден — проверяваме множеството,
    //     не реда; K3 в gaps.md) ---
    let q2 = boila_exec_sql(s, "SELECT name FROM users WHERE id >= 3 AND id <= 6")?
    s = q2.s
    check(fails, "range_ok", q2.ok == 1 && vec_len(q2.res.rows) == 4 && vec_len(q2.res.cols) == 1)
    let mut seen3: i64 = 0
    let mut seen4: i64 = 0
    let mut seen5: i64 = 0
    let mut seen6: i64 = 0
    let mut j: i64 = 0
    while j < vec_len(q2.res.rows) {
        let nm = row_str(vec_get(q2.res.rows, j), 0)
        if nm == "user3" {
            seen3 = 1
        }
        if nm == "user4" {
            seen4 = 1
        }
        if nm == "user5" {
            seen5 = 1
        }
        if nm == "user6" {
            seen6 = 1
        }
        j = j + 1
    }
    check(fails, "range_set", seen3 + seen4 + seen5 + seen6 == 4)

    // --- LIMIT ---
    let q3 = boila_exec_sql(s, "SELECT * FROM users LIMIT 3")?
    s = q3.s
    check(fails, "limit3", q3.ok == 1 && vec_len(q3.res.rows) == 3)

    // --- липсващ ред → празен резултат, не грешка ---
    let q4 = boila_exec_sql(s, "SELECT * FROM users WHERE id = 999")?
    s = q4.s
    check(fails, "missing_empty", q4.ok == 1 && vec_len(q4.res.rows) == 0)

    // --- грешки с SQLSTATE ---
    let e1 = boila_exec_sql(s, "SELECT * FROM users WHERE name = 'user1'")?
    s = e1.s
    check(fails, "err_where_not_pk", e1.ok == 0 && e1.state == "0A000")
    let e2 = boila_exec_sql(s, "SELECT * FROM nope")?
    s = e2.s
    check(fails, "err_no_table", e2.ok == 0 && e2.state == "42P01")
    let e3 = boila_exec_sql(s, "INSERT INTO users (id) VALUES (11)")?
    s = e3.s
    check(fails, "insert_p3_ok", e3.ok == 1 && e3.kind == 6 && e3.id == 1)
    let e4 = boila_exec_sql(s, "SELECT * FROM users WHERE id = 'текст'")?
    s = e4.s
    check(fails, "err_type_mismatch", e4.ok == 0 && e4.state == "42804")
    let e5 = boila_exec_sql(s, "SELECT missing FROM users WHERE id = 1")?
    s = e5.s
    check(fails, "err_bad_col", e5.ok == 0 && e5.state == "42703")

    // --- str pk таблица ---
    let c2 = boila_exec_sql(s, "CREATE TABLE kv (k TEXT, v BIGINT, PRIMARY KEY (k))")?
    s = c2.s
    check(fails, "create_kv", c2.ok == 1 && c2.id == 2)
    let rowk: Vec<BoilaVal> = vec_new()
    vec_push(rowk, boila_val_str("ключ"))
    vec_push(rowk, boila_val_i64(42))
    s = boila_put(s, boila_cf_data(), c2.id, boila_val_enc(boila_val_str("ключ")), boila_row_enc(rowk))?
    let q5 = boila_exec_sql(s, "SELECT v FROM kv WHERE k = 'ключ'")?
    s = q5.s
    check(fails, "str_pk_lookup", q5.ok == 1 && vec_len(q5.res.rows) == 1 && row_str(vec_get(q5.res.rows, 0), 0) == "42")

    boila_close(s)?

    // --- restart: данни + каталог оцеляват ---
    let mut s2 = boila_open(dir, 2, 8, 3)?
    let q6 = boila_exec_sql(s2, "SELECT * FROM users WHERE id = 7")?
    s2 = q6.s
    check(fails, "restart_point", q6.ok == 1 && vec_len(q6.res.rows) == 1 && row_str(vec_get(q6.res.rows, 0), 1) == "user7")
    let q7 = boila_exec_sql(s2, "SELECT v FROM kv WHERE k = 'ключ'")?
    s2 = q7.s
    check(fails, "restart_kv", q7.ok == 1 && vec_len(q7.res.rows) == 1)
    boila_close(s2)?

    wipe_shards(dir, 2)?
    if vec_len(fails) == 0 {
        print("boila_sql_read_test: all passed")
        return 0
    }
    print(concat(concat("boila_sql_read_test: FAILED (", int_to_str(vec_len(fails))), ")"))
    return 1
}
