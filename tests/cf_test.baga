// cf_test.baga — R44 shared-WAL column families.
import "rocksbaga/db/cf.baga"
import "rocksbaga/net/server.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

fn check(name: str, ok: bool) {
    if ok {
        print(concat("  ok  ", name))
    } else {
        eprintln(concat("FAIL ", name))
        exit(1)
    }
}

fn wipe(p: str) -> i64 !IO {
    unlink(concat(p, ".wal"))?
    unlink(concat(p, ".manifest"))?
    unlink(concat(p, ".manifest.log"))?
    unlink(concat(p, ".cfs"))?
    unlink(concat(p, ".cfs.tmp"))?
    let mut g: i64 = 1
    while g <= 40 {
        unlink(concat(concat(p, ".sst."), int_to_str(g)))?
        unlink(concat(concat(p, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    // CF 1..8
    let mut c: i64 = 1
    while c <= 8 {
        let base = concat(concat(p, ".cf"), int_to_str(c))
        unlink(concat(base, ".wal"))?
        unlink(concat(base, ".manifest"))?
        unlink(concat(base, ".manifest.log"))?
        unlink(concat(base, ".manifest.tmp"))?
        let mut g2: i64 = 1
        while g2 <= 64 {
            unlink(concat(concat(base, ".sst."), int_to_str(g2)))?
            unlink(concat(concat(base, ".bloom."), int_to_str(g2)))?
            g2 = g2 + 1
        }
        c = c + 1
    }
    return 0
}

fn main() -> i64 !IO !Time {
    print("cf_test:")
    let dir = "/tmp/baga_cf_t"
    wipe(dir)?

    let mut db = lsm_cf_open(dir, 32, 8)?
    check("open", db.ok == 1)
    db.sync_every = 1000

    let cr = lsm_cf_create(db, "users")?
    db = cr.db
    let users = cr.id
    check("create_users", users > 0)

    let cr2 = lsm_cf_create(db, "meta")?
    db = cr2.db
    let meta = cr2.id
    check("create_meta", meta > 0 && meta != users)

    db = lsm_cf_put(db, 0, "k", "default")?
    db = lsm_cf_put(db, users, "k", "user-val")?
    db = lsm_cf_put(db, meta, "k", "meta-val")?

    let g0 = lsm_cf_get(db, 0, "k")?
    db = g0.db
    check("get_default", g0.found == 1 && str_of_bytes(g0.val) == "default")
    let gu = lsm_cf_get(db, users, "k")?
    db = gu.db
    check("get_users", gu.found == 1 && str_of_bytes(gu.val) == "user-val")
    let gm = lsm_cf_get(db, meta, "k")?
    db = gm.db
    check("get_meta", gm.found == 1 && str_of_bytes(gm.val) == "meta-val")

    // flush users CF only
    db = lsm_cf_flush(db, users)?
    check("flush_users", db.ok == 1)

    // reopen — shared WAL + SST + durable names (R46)
    lsm_cf_close(db)?
    let db2 = lsm_cf_open(dir, 32, 8)?
    check("reopen", db2.ok == 1)
    check("name_users", lsm_cf_id_of(db2, "users") == users)
    check("name_meta", lsm_cf_id_of(db2, "meta") == meta)
    let g0b = lsm_cf_get(db2, 0, "k")?
    check("reopen_def", g0b.found == 1 && str_of_bytes(g0b.val) == "default")
    let gub = lsm_cf_get(g0b.db, users, "k")?
    check("reopen_users", gub.found == 1 && str_of_bytes(gub.val) == "user-val")
    let gmb = lsm_cf_get(gub.db, meta, "k")?
    check("reopen_meta", gmb.found == 1 && str_of_bytes(gmb.val) == "meta-val")

    // resolve by name after reopen
    let rx = lsm_cf_resolve(gmb.db, "users", 0)?
    check("resolve_users", rx.id == users)
    // CF.SET-style auto create
    let ry = lsm_cf_resolve(rx.db, "newcf", 1)?
    check("autocreate", ry.id > 0)
    let db3 = lsm_cf_put(ry.db, ry.id, "x", "y")?
    lsm_cf_close(db3)?
    let db4 = lsm_cf_open(dir, 32, 8)?
    check("persist_newcf", lsm_cf_id_of(db4, "newcf") == ry.id)
    let gnew = lsm_cf_get(db4, ry.id, "x")?
    check("persist_val", gnew.found == 1 && str_of_bytes(gnew.val) == "y")

    // RESP CF.* dispatch (in-process)
    let args: Vec<str> = vec_new()
    vec_push(args, "CF.SET")
    vec_push(args, "users")
    vec_push(args, "u2")
    vec_push(args, "v2")
    let ex = lsm_exec_cf(gnew.db, args)?
    check("exec_cfset", ex.quit == 0)
    let args2: Vec<str> = vec_new()
    vec_push(args2, "CF.GET")
    vec_push(args2, "users")
    vec_push(args2, "u2")
    let ex2 = lsm_exec_cf(ex.db, args2)?
    check("exec_cfget", ex2.quit == 0 && bytes_len(ex2.reply) > 2)
    let args3: Vec<str> = vec_new()
    vec_push(args3, "CF.LIST")
    let ex3 = lsm_exec_cf(ex2.db, args3)?
    check("exec_cflist", ex3.quit == 0)
    lsm_cf_close(ex3.db)?

    // --- R48: per-CF compaction + shared WAL rotation ---
    wipe(dir)?
    let mut db5 = lsm_cf_open(dir, 8, 2)?
    check("r48_open", db5.ok == 1)
    db5.sync_every = 1000
    let crh = lsm_cf_create(db5, "hot")?
    db5 = crh.db
    let hot = crh.id
    // 40 puts, flush_at=8 → 5 auto-flushes; compact_at=2 must collapse L0
    let mut pi: i64 = 0
    while pi < 40 {
        db5 = lsm_cf_put(db5, hot, concat("hk", int_to_str(pi)), "v")?
        pi = pi + 1
    }
    let famh = map_get(db5.families, hot)
    check("r48_compacted", vec_len(famh.gens) < 5)
    let gh = lsm_cf_get(db5, hot, "hk17")?
    db5 = gh.db
    check("r48_get", gh.found == 1 && str_of_bytes(gh.val) == "v")
    // close flushes everything → shared WAL rotates to empty
    lsm_cf_close(db5)?
    let wfd = open(concat(dir, ".wal"), 0, 0)?
    check("r48_wal_rotated", wfd >= 0 && fd_size(wfd) == 0)
    if wfd >= 0 {
        close(wfd)
    }
    // reopen: values survive compaction + rotation
    let db6 = lsm_cf_open(dir, 8, 2)?
    let gh2 = lsm_cf_get(db6, hot, "hk39")?
    check("r48_reopen_get", gh2.found == 1 && str_of_bytes(gh2.val) == "v")

    // --- R49: CF.DROP ---
    let ddef = lsm_cf_drop(gh2.db, "default")?
    check("r49_drop_default_refused", ddef.rc == 0 - 1)
    let dmiss = lsm_cf_drop(ddef.db, "nosuch")?
    check("r49_drop_missing", dmiss.rc == 0)
    let crt = lsm_cf_create(dmiss.db, "temp")?
    let mut db7 = crt.db
    let temp = crt.id
    db7 = lsm_cf_put(db7, temp, "tk", "tv")?
    db7 = lsm_cf_flush(db7, temp)?
    let d1 = lsm_cf_drop(db7, "temp")?
    check("r49_dropped", d1.rc == 1)
    check("r49_name_gone", lsm_cf_id_of(d1.db, "temp") == 0 - 1)
    let tpath = concat(concat(dir, ".cf"), int_to_str(temp))
    check("r49_files_gone", file_exists(concat(tpath, ".manifest")) == 0)
    // reopen: dropped CF stays gone; WAL replay must skip its records
    lsm_cf_close(d1.db)?
    let db8 = lsm_cf_open(dir, 8, 2)?
    check("r49_reopen_gone", lsm_cf_id_of(db8, "temp") == 0 - 1)
    check("r49_reopen_hot_ok", lsm_cf_id_of(db8, "hot") == hot)
    // RESP CF.DROP dispatch
    let argsd: Vec<str> = vec_new()
    vec_push(argsd, "CF.DROP")
    vec_push(argsd, "hot")
    let exd = lsm_exec_cf(db8, argsd)?
    check("r49_resp_drop", exd.quit == 0)
    check("r49_resp_dropped", lsm_cf_id_of(exd.db, "hot") == 0 - 1)
    lsm_cf_close(exd.db)?

    // --- R61: per-CF options (flush_at/compact_at, persisted) ---
    wipe(dir)?
    let mut db9 = lsm_cf_open(dir, 1000, 1000)?  // db-level: huge thresholds
    let cro = lsm_cf_create(db9, "opts")?
    db9 = cro.db
    let opts = cro.id
    db9 = lsm_cf_setopt(db9, "opts", 4, 0)?
    check("r61_setopt", db9.ok == 1)
    // 4 puts → this CF auto-flushes despite db-level flush_at=1000
    let mut oi: i64 = 0
    while oi < 4 {
        db9 = lsm_cf_put(db9, opts, concat("ok", int_to_str(oi)), "v")?
        oi = oi + 1
    }
    let famo = map_get(db9.families, opts)
    check("r61_auto_flush", vec_len(famo.gens) == 1)
    // default CF untouched by the override (no flush at 4 puts)
    let mut oi2: i64 = 0
    while oi2 < 4 {
        db9 = lsm_cf_put(db9, 0, concat("dk", int_to_str(oi2)), "v")?
        oi2 = oi2 + 1
    }
    let famd = map_get(db9.families, 0)
    check("r61_default_untouched", vec_len(famd.gens) == 0)
    // options survive reopen
    lsm_cf_close(db9)?
    let mut db10 = lsm_cf_open(dir, 1000, 1000)?
    let cro2 = lsm_cf_resolve(db10, "opts", 0)?
    db10 = cro2.db
    let mut oi3: i64 = 0
    while oi3 < 4 {
        db10 = lsm_cf_put(db10, cro2.id, concat("nk", int_to_str(oi3)), "v")?
        oi3 = oi3 + 1
    }
    let famo2 = map_get(db10.families, cro2.id)
    check("r61_persisted", vec_len(famo2.gens) == 2)
    // RESP CF.SETOPT
    let argso: Vec<str> = vec_new()
    vec_push(argso, "CF.SETOPT")
    vec_push(argso, "opts")
    vec_push(argso, "compact_at")
    vec_push(argso, "2")
    let exo = lsm_exec_cf(db10, argso)?
    check("r61_resp_setopt", exo.quit == 0)
    // R61 fix: single-key SETOPT must not clear flush_at
    check("r61_setopt_one_keeps_flush", map_has(exo.db.opt_flush, cro2.id) == 1)

    // --- R64: per-CF block-cache policy (cache_pages) ---
    let mut db11 = exo.db
    db11 = lsm_cf_setopt_one(db11, "opts", "cache_pages", 64)?
    check("r64_setopt_cache", db11.ok == 1)
    check("r64_opt_map", map_has(db11.opt_cache, cro2.id) == 1 && map_get(db11.opt_cache, cro2.id) == 64)
    let famc = map_get(db11.families, cro2.id)
    check("r64_live_cap", famc.cache.cap == 64)
    // flush_at still present after cache set
    check("r64_keeps_flush", map_has(db11.opt_flush, cro2.id) == 1)
    // hot CF without override keeps default engine pool (2048)
    let crh2 = lsm_cf_create(db11, "cold")?
    db11 = crh2.db
    let cold = crh2.id
    db11 = lsm_cf_ensure(db11, cold)?
    let famcold = map_get(db11.families, cold)
    check("r64_default_cap", famcold.cache.cap == 2048)
    // persist across reopen
    lsm_cf_close(db11)?
    let db12 = lsm_cf_open(dir, 1000, 1000)?
    check("r64_persist_map", map_has(db12.opt_cache, cro2.id) == 1 && map_get(db12.opt_cache, cro2.id) == 64)
    let famc2 = map_get(db12.families, cro2.id)
    check("r64_reopen_cap", famc2.cache.cap == 64)
    // RESP CF.SETOPT cache_pages
    let argsc: Vec<str> = vec_new()
    vec_push(argsc, "CF.SETOPT")
    vec_push(argsc, "opts")
    vec_push(argsc, "cache_pages")
    vec_push(argsc, "128")
    let exc = lsm_exec_cf(db12, argsc)?
    check("r64_resp_cache", exc.quit == 0)
    let famc3 = map_get(exc.db.families, cro2.id)
    check("r64_resp_cap", famc3.cache.cap == 128)
    // clear override (<16)
    let mut db13 = exc.db
    db13 = lsm_cf_setopt_one(db13, "opts", "cache_pages", 0)?
    check("r64_clear", map_has(db13.opt_cache, cro2.id) == 0)
    let famc4 = map_get(db13.families, cro2.id)
    check("r64_clear_cap", famc4.cache.cap == 2048)
    lsm_cf_close(db13)?

    print("cf_test: all passed")
    return 0
}
