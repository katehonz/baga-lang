// boila_gexpr_test.baga — Q-gexpr: scalar fns / expressions with GROUP BY
// and aggregates (evaluated on the group's first row).

import "boilaDB/server/databases.baga"
import "boilaDB/server/exec_server.baga"
import "boilaDB/core/value.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn check(fails: Vec<i64>, name: str, cond: bool) {
    if cond {
        print(concat("  ok  ", name))
    } else {
        print(concat("  FAIL ", name))
        vec_push(fails, 1)
    }
}

fn wipe_shard_path(prefix: str) -> i64 !IO !Par {
    unlink(concat(prefix, ".wal"))?
    unlink(concat(prefix, ".manifest"))?
    unlink(concat(prefix, ".manifest.log"))?
    let mut g: i64 = 1
    while g <= 60 {
        unlink(concat(concat(prefix, ".sst."), int_to_str(g)))?
        unlink(concat(concat(prefix, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

fn wipe_root(root: str) -> i64 !IO !Par {
    wipe_shard_path(concat(root, "/.meta"))?
    let mut i: i64 = 0
    while i < 2 {
        wipe_shard_path(concat(concat(root, "/boila.db.s"), int_to_str(i)))?
        i = i + 1
    }
    return 0
}

fn cell(row: Vec<BoilaVal>, ix: i64) -> str {
    let v = vec_get(row, ix)
    if v.tag == boila_v_str() { return str_of_bytes(v.b) }
    if v.tag == boila_v_i64() || v.tag == boila_v_ts() { return int_to_str(v.i) }
    if v.tag == boila_v_null() { return "null" }
    return "?"
}

fn main() -> i64 !IO !Time !Par {
    print("boila_gexpr_test:")
    let fails: Vec<i64> = vec_new()
    let root = "/tmp/baga_boila_gexpr_test"
    wipe_root(root)?

    let mut srv = boila_server_open(root, 2, 8, 3, 4)?
    check(fails, "open", srv.ok == 1)
    let c0 = boila_server_exec(srv, "boila", "CREATE TABLE e (id BIGINT, dept TEXT, sal BIGINT, PRIMARY KEY (id))")?
    srv = c0.srv
    check(fails, "create", c0.ok == 1)
    let s0 = boila_server_exec(srv, "boila", "INSERT INTO e (id, dept, sal) VALUES (1, 'eng', 100), (2, 'eng', 120), (3, 'hr', 90), (4, 'hr', 95)")?
    srv = s0.srv
    check(fails, "seed", s0.ok == 1 && s0.id == 4)

    // sfn + agg + GROUP BY (ORDER BY output alias — group col not always projected)
    let g1 = boila_server_exec(srv, "boila", "SELECT upper(dept) AS d, count(*) AS c, sum(sal) AS s FROM e GROUP BY dept ORDER BY d")?
    srv = g1.srv
    check(fails, "sfn_agg", g1.ok == 1 && vec_len(g1.res.rows) == 2)
    check(fails, "sfn_eng", cell(vec_get(g1.res.rows, 0), 0) == "ENG" && cell(vec_get(g1.res.rows, 0), 1) == "2" && cell(vec_get(g1.res.rows, 0), 2) == "220")
    check(fails, "sfn_hr", cell(vec_get(g1.res.rows, 1), 0) == "HR" && cell(vec_get(g1.res.rows, 1), 1) == "2" && cell(vec_get(g1.res.rows, 1), 2) == "185")

    // expr + agg + GROUP BY
    let g2 = boila_server_exec(srv, "boila", "SELECT dept || '!' AS d, count(*) AS c FROM e GROUP BY dept ORDER BY d")?
    srv = g2.srv
    check(fails, "expr_agg", g2.ok == 1 && vec_len(g2.res.rows) == 2 && cell(vec_get(g2.res.rows, 0), 0) == "eng!" && cell(vec_get(g2.res.rows, 0), 1) == "2")

    // expr only + GROUP BY
    let g3 = boila_server_exec(srv, "boila", "SELECT id * 10 AS x FROM e GROUP BY id ORDER BY x")?
    srv = g3.srv
    check(fails, "expr_only", g3.ok == 1 && vec_len(g3.res.rows) == 4 && cell(vec_get(g3.res.rows, 0), 0) == "10" && cell(vec_get(g3.res.rows, 3), 0) == "40")

    // group col + sfn + agg
    let g4 = boila_server_exec(srv, "boila", "SELECT dept, length(dept) AS ln, count(*) AS c FROM e GROUP BY dept ORDER BY dept")?
    srv = g4.srv
    check(fails, "col_sfn_agg", g4.ok == 1 && vec_len(g4.res.rows) == 2 && cell(vec_get(g4.res.rows, 0), 0) == "eng" && cell(vec_get(g4.res.rows, 0), 1) == "3")

    // CASE in group projection
    let g5 = boila_server_exec(srv, "boila", "SELECT CASE WHEN dept = 'eng' THEN 'E' ELSE 'H' END AS k, sum(sal) AS s FROM e GROUP BY dept ORDER BY k")?
    srv = g5.srv
    check(fails, "case_agg", g5.ok == 1 && cell(vec_get(g5.res.rows, 0), 0) == "E" && cell(vec_get(g5.res.rows, 0), 1) == "220")

    // errors
    let e1 = boila_server_exec(srv, "boila", "SELECT upper(dept), count(*) FROM e")?
    srv = e1.srv
    check(fails, "err_no_group", e1.ok == 0 && e1.state == "0A000")
    let e2 = boila_server_exec(srv, "boila", "SELECT id, count(*) FROM e GROUP BY dept")?
    srv = e2.srv
    check(fails, "err_ungrouped", e2.ok == 0 && e2.state == "42803")
    let e3 = boila_server_exec(srv, "boila", "SELECT foo(dept), count(*) FROM e GROUP BY dept")?
    srv = e3.srv
    check(fails, "err_unknown_fn", e3.ok == 0 && e3.state == "42883")

    // legacy path still works (no sfn/expr)
    let g0 = boila_server_exec(srv, "boila", "SELECT dept, count(*) FROM e GROUP BY dept ORDER BY dept")?
    srv = g0.srv
    check(fails, "legacy_group", g0.ok == 1 && cell(vec_get(g0.res.rows, 0), 0) == "eng" && cell(vec_get(g0.res.rows, 0), 1) == "2")

    boila_server_close(srv)?
    wipe_root(root)?

    if vec_len(fails) == 0 {
        print("boila_gexpr_test: all passed")
        return 0
    }
    print(concat(concat("boila_gexpr_test: FAILED (", int_to_str(vec_len(fails))), ")"))
    return 1
}
