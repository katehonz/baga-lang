// boila_truncate_test.baga — TRUNCATE TABLE keeps schema, wipes rows + index data.

import "boilaDB/storage/databases.baga"
import "boilaDB/sql/exec_server.baga"
import "boilaDB/core/value.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn check(fails: Vec<i64>, name: str, cond: bool) {
    if cond {
        print(concat("  ok  ", name))
    } else {
        print(concat("  FAIL ", name))
        vec_push(fails, 1)
    }
}

fn wipe_shard_path(prefix: str) -> i64 !IO !Par {
    unlink(concat(prefix, ".wal"))?
    unlink(concat(prefix, ".manifest"))?
    unlink(concat(prefix, ".manifest.log"))?
    let mut g: i64 = 1
    while g <= 60 {
        unlink(concat(concat(prefix, ".sst."), int_to_str(g)))?
        unlink(concat(concat(prefix, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

fn wipe_root(root: str) -> i64 !IO !Par {
    wipe_shard_path(concat(root, "/.meta"))?
    let mut i: i64 = 0
    while i < 2 {
        wipe_shard_path(concat(concat(root, "/boila.db.s"), int_to_str(i)))?
        i = i + 1
    }
    return 0
}

fn exec(srv: BoilaServer, sql: str) -> BoilaSrvOut !IO !Time !Par {
    return boila_server_exec(srv, "boila", sql)?
}

fn main() -> i64 !IO !Time !Par {
    print("boila_truncate_test:")
    let fails: Vec<i64> = vec_new()
    let root = "/tmp/baga_boila_truncate_test"
    wipe_root(root)?

    let mut srv = boila_server_open(root, 2, 8, 3, 4)?
    let c1 = exec(srv, "CREATE TABLE t (id BIGINT, city TEXT, PRIMARY KEY (id))")?
    srv = c1.srv
    let c2 = exec(srv, "INSERT INTO t (id, city) VALUES (1, 'a'), (2, 'b'), (3, 'a')")?
    srv = c2.srv
    let x1 = exec(srv, "CREATE INDEX city_ix ON t (city)")?
    srv = x1.srv
    check(fails, "seed", c1.ok == 1 && c2.ok == 1 && x1.ok == 1)

    let s1 = exec(srv, "SELECT id FROM t WHERE city = 'a'")?
    srv = s1.srv
    check(fails, "before_ix", s1.ok == 1 && vec_len(s1.res.rows) == 2)

    let t1 = exec(srv, "TRUNCATE TABLE t")?
    srv = t1.srv
    check(fails, "truncate", t1.ok == 1 && t1.kind == 25)

    let s2 = exec(srv, "SELECT * FROM t")?
    srv = s2.srv
    check(fails, "empty", s2.ok == 1 && vec_len(s2.res.rows) == 0)

    // schema + index def remain; new insert works + ix lookup
    let i3 = exec(srv, "INSERT INTO t (id, city) VALUES (10, 'a'), (11, 'b')")?
    srv = i3.srv
    check(fails, "reinsert", i3.ok == 1)
    let s3 = exec(srv, "SELECT id FROM t WHERE city = 'a'")?
    srv = s3.srv
    check(fails, "ix_after", s3.ok == 1 && vec_len(s3.res.rows) == 1)

    // optional TABLE kw + IF EXISTS
    let t2 = exec(srv, "TRUNCATE t")?
    srv = t2.srv
    check(fails, "truncate_no_table_kw", t2.ok == 1)
    let t3 = exec(srv, "TRUNCATE TABLE IF EXISTS nope")?
    srv = t3.srv
    check(fails, "if_exists", t3.ok == 1)
    let t4 = exec(srv, "TRUNCATE nope")?
    srv = t4.srv
    check(fails, "missing_42P01", t4.ok == 0 && t4.state == "42P01")

    // FTS survives def, data wiped
    let c3 = exec(srv, "CREATE TABLE docs (id BIGINT, body TEXT, PRIMARY KEY (id))")?
    srv = c3.srv
    let f1 = exec(srv, "CREATE FTS INDEX docs_fts ON docs (body)")?
    srv = f1.srv
    let i4 = exec(srv, "INSERT INTO docs (id, body) VALUES (1, 'hello world')")?
    srv = i4.srv
    let q1 = exec(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('hello')")?
    srv = q1.srv
    check(fails, "fts_before", q1.ok == 1 && vec_len(q1.res.rows) == 1)
    let t5 = exec(srv, "TRUNCATE docs")?
    srv = t5.srv
    let q2 = exec(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('hello')")?
    srv = q2.srv
    check(fails, "fts_after_empty", t5.ok == 1 && q2.ok == 1 && vec_len(q2.res.rows) == 0)
    let i5 = exec(srv, "INSERT INTO docs (id, body) VALUES (2, 'hello again')")?
    srv = i5.srv
    let q3 = exec(srv, "SELECT id FROM docs WHERE body @@ to_tsquery('hello')")?
    srv = q3.srv
    check(fails, "fts_reindex", q3.ok == 1 && vec_len(q3.res.rows) == 1)

    boila_server_close(srv)?

    if vec_len(fails) == 0 {
        print("boila_truncate_test: ALL PASS")
        return 0
    }
    print(concat("boila_truncate_test: FAILS=", int_to_str(vec_len(fails))))
    return 1
}
