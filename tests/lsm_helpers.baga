// lsm_helpers.baga — споделени помощници на lsm тестовете (check/args/wipe).
// Не е *_test.baga — baga-test го открива само като import.

import "std/os/os.baga"
import "std/str/str.baga"

fn check(fails: Vec<i64>, name: str, cond: bool) {
    if cond {
        print(concat("  ok  ", name))
    } else {
        print(concat("  FAIL ", name))
        vec_push(fails, 1)
    }
}

fn args1(a: str) -> Vec<str> {
    let v = vec_new()
    vec_push(v, a)
    return v
}

fn args2(a: str, b: str) -> Vec<str> {
    let v = vec_new()
    vec_push(v, a)
    vec_push(v, b)
    return v
}

fn args3(a: str, b: str, c: str) -> Vec<str> {
    let v = vec_new()
    vec_push(v, a)
    vec_push(v, b)
    vec_push(v, c)
    return v
}

fn args4(a: str, b: str, c: str, d: str) -> Vec<str> {
    let v = vec_new()
    vec_push(v, a)
    vec_push(v, b)
    vec_push(v, c)
    vec_push(v, d)
    return v
}

fn wipe(prefix: str) -> i64 !IO {
    // best-effort remove known files for gens 1..40
    unlink(concat(prefix, ".wal"))?
    unlink(concat(prefix, ".manifest"))?
    unlink(concat(prefix, ".manifest.log"))?
    let mut g: i64 = 1
    while g <= 40 {
        unlink(concat(concat(prefix, ".sst."), int_to_str(g)))?
        unlink(concat(concat(prefix, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}
