// g12_bitwise_warn_test.baga — G12: предупреждение при bitwise+comparison без скоби.
// Компилира се (warning, не error) и проверява, че стойностите са тези от C precedence.
fn main() {
    // 6 & 4 == 4  →  6 & (4 == 4)  →  6 & 1  →  0  (C trap, предупреждение)
    let a = 6 & 4 == 4
    print(a)
    // (6 & 4) == 4  →  4 == 4  →  true  (със скоби — без предупреждение)
    let b = (6 & 4) == 4
    print(b)
    // 255 & 128 == 128  →  255 & (128==128)  →  255 & 1  →  1  (C trap)
    let c = 255 & 128 == 128
    print(c)
    // | със сравнение: 0 | 1 == 1  →  0 | true  →  type error (bool не е i64) —
    // но предупреждение пак се излъчва преди грешката; затова го тестваме отделно.
}
