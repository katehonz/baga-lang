// shard_test.baga — R32 key-hash multi-shard cluster.
import "rocksbaga/db/shard.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

fn check(name: str, ok: bool) {
    if ok {
        print(concat("  ok  ", name))
    } else {
        eprintln(concat("FAIL ", name))
        exit(1)
    }
}

fn wipe_prefix(p: str) -> i64 !IO {
    unlink(concat(p, ".wal"))?
    unlink(concat(p, ".manifest"))?
    unlink(concat(p, ".manifest.log"))?
    let mut g: i64 = 1
    while g <= 40 {
        unlink(concat(concat(p, ".sst."), int_to_str(g)))?
        unlink(concat(concat(p, ".bloom."), int_to_str(g)))?
        g = g + 1
    }
    return 0
}

fn wipe_cluster(dir: str, n: i64) -> i64 !IO {
    if n <= 1 {
        return wipe_prefix(dir)?
    }
    let mut i: i64 = 0
    while i < n {
        let p = concat(concat(dir, ".s"), int_to_str(i))
        wipe_prefix(p)?
        i = i + 1
    }
    return 0
}

fn main() -> i64 !IO !Time {
    print("shard_test:")
    let dir = "/tmp/baga_shard_t"
    wipe_cluster(dir, 4)?

    check("hash_stable", lsm_key_hash("abc") == lsm_key_hash("abc"))
    check("shard_range", lsm_shard_ix(4, "abc") >= 0 && lsm_shard_ix(4, "abc") < 4)

    let mut c = lsm_cluster_open(dir, 4, 32, 4)?
    check("open", c.ok == 1 && c.n == 4)
    c = lsm_cluster_apply_sync(c, 1000)

    c = lsm_cluster_put(c, "user:1", "ada")?
    c = lsm_cluster_put(c, "user:2", "bob")?
    c = lsm_cluster_put(c, "order:9", "x")?
    let g1 = lsm_cluster_get(c, "user:1")?
    c = g1.c
    check("get1", g1.found == 1 && str_of_bytes(g1.val) == "ada")
    let g2 = lsm_cluster_get(c, "user:2")?
    c = g2.c
    check("get2", g2.found == 1 && str_of_bytes(g2.val) == "bob")
    let gm = lsm_cluster_get(c, "missing")?
    c = gm.c
    check("miss", gm.found == 0)

    c = lsm_cluster_del(c, "user:2")?
    let g3 = lsm_cluster_get(c, "user:2")?
    c = g3.c
    check("del", g3.found == 0)

    let ds = lsm_cluster_dbsize(c)?
    c = ds.c
    check("dbsize", ds.n == 2)

    let kr = lsm_cluster_keys(c)?
    c = kr.c
    check("keys_n", vec_len(kr.keys) == 2)

    c = lsm_cluster_flush_force(c)?
    check("flush", c.ok == 1)
    // reopen
    lsm_cluster_close(c)?
    c = lsm_cluster_open(dir, 4, 32, 4)?
    let g4 = lsm_cluster_get(c, "user:1")?
    c = g4.c
    check("durable", g4.found == 1 && str_of_bytes(g4.val) == "ada")
    let g5 = lsm_cluster_get(c, "order:9")?
    c = g5.c
    check("durable2", g5.found == 1)

    // different keys should not all land on the same shard (probabilistic)
    let mut seen: Map<i64, i64> = map_new()
    let mut i: i64 = 0
    while i < 64 {
        let k = concat("k", int_to_str(i))
        let s = lsm_shard_ix(4, k)
        map_set(seen, s, 1)
        i = i + 1
    }
    check("spread", map_len(seen) >= 2)

    lsm_cluster_close(c)?
    print("shard_test: all passed")
    return 0
}
