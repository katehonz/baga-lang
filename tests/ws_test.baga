// ws_test.baga — live loopback test for app-product/wsbaga (RFC 6455).
// Boots ws_serve in a go_bg worker; the client does a real handshake
// (verifying Sec-WebSocket-Accept) and exercises the frame codec:
// text/binary echo, 7/16/64-bit length boundaries, ping/pong, close.

import "wsbaga/ws.baga"
import "std/net/tcp.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

fn check(name: str, ok: bool) {
    if ok {
        print(concat("ok ", name))
    } else {
        eprintln(concat("FAIL ", name))
        exit(1)
    }
}

fn raw2(a: i64, b: i64) -> bytes {
    let v: Vec<i64> = vec_new()
    vec_push(v, a)
    vec_push(v, b)
    return bytes_from_vec(v)
}

fn raw3(a: i64, b: i64, c: i64) -> bytes {
    let v: Vec<i64> = vec_new()
    vec_push(v, a)
    vec_push(v, b)
    vec_push(v, c)
    return bytes_from_vec(v)
}

fn hs_req(extra: str) -> bytes {
    return bytes_of_str(concat(concat(
        "GET / HTTP/1.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n",
        extra), "\r\n"))
}

struct RoundTrip {
    conn: WsConn,
    ok: i64
}

// Send text, read the echo, compare. ok=1 only on an exact match.
fn round_trip_text(conn: WsConn, s: str) -> RoundTrip !Net !IO !Random {
    let w = ws_send_text(conn.fd, s)?
    if w != 0 {
        return RoundTrip { conn: conn, ok: 0 }
    }
    let r = ws_read_frame(conn)?
    if r.ok == 0 || r.bad == 1 || r.frame.opcode != WS_TEXT() {
        return RoundTrip { conn: r.conn, ok: 0 }
    }
    if str_of_bytes(r.frame.payload) != s {
        return RoundTrip { conn: r.conn, ok: 0 }
    }
    return RoundTrip { conn: r.conn, ok: 1 }
}

fn main() -> i64 !Net !IO !Par !Random {
    // --- pure RFC 6455 checks (no socket) ---
    check("accept_key", ws_accept_key("dGhlIHNhbXBsZSBub25jZQ==") == "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=")

    let h_ok = ws_parse_handshake_buf(hs_req("Sec-WebSocket-Version: 13\r\n"))
    check("hs_ok", h_ok.ok == 1 && h_ok.bad == 0)
    check("hs_accept", str_find(h_ok.response, "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=") >= 0)

    let h_ver = ws_parse_handshake_buf(hs_req(""))
    check("hs_need_version", h_ver.ok == 0 && h_ver.bad == 1)

    let h_conn = ws_parse_handshake_buf(bytes_of_str(
        "GET / HTTP/1.1\r\nUpgrade: websocket\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n"))
    check("hs_need_connection", h_conn.ok == 0 && h_conn.bad == 1)

    let rsv = ws_try_parse_frame(raw3(193, 1, 120))
    check("rsv1_bad", rsv.ok == 0 && rsv.bad == 1)

    let rop = ws_try_parse_frame(raw2(131, 0))
    check("opcode3_bad", rop.ok == 0 && rop.bad == 1)

    let pfrag = ws_try_parse_frame(raw2(9, 0))
    check("ping_frag_bad", pfrag.ok == 0 && pfrag.bad == 1)

    let nmv: Vec<i64> = vec_new()
    vec_push(nmv, 129)
    vec_push(nmv, 126)
    vec_push(nmv, 0)
    vec_push(nmv, 1)
    vec_push(nmv, 120)
    let nmin = ws_try_parse_frame(bytes_from_vec(nmv))
    check("nonminimal_126", nmin.ok == 0 && nmin.bad == 1)

    let cp = ws_close_payload(1000, "bye")
    check("close_code", ws_close_code(cp) == 1000)
    check("close_reason", ws_close_reason(cp) == "bye")
    check("close_empty", ws_close_code(ws_empty()) == 0)

    let port = 18440
    go_bg(ws_serve, port)
    sleep_ms(300)

    // --- handshake (client verifies Sec-WebSocket-Accept) ---
    let d = ws_client_connect("localhost", port, 5)?
    check("handshake", d.ok == 1)
    if d.ok == 0 {
        eprintln("ws_test: FAILED (handshake)")
        exit(1)
    }
    let mut conn = d.conn
    tcp_set_timeouts(conn.fd, 5)?

    // --- text echo, incl. UTF-8 ---
    let t1 = round_trip_text(conn, "hello")?
    conn = t1.conn
    check("text_echo_hello", t1.ok == 1)
    let t2 = round_trip_text(conn, "Здравей, WebSocket!")?
    conn = t2.conn
    check("text_echo_utf8", t2.ok == 1)

    // --- length boundaries: 125 (7-bit max), 126 (16-bit min), 65535 (16-bit max), 65536 (64-bit min) ---
    let t3 = round_trip_text(conn, str_repeat("a", 125))?
    conn = t3.conn
    check("len_125", t3.ok == 1)
    let t4 = round_trip_text(conn, str_repeat("b", 126))?
    conn = t4.conn
    check("len_126", t4.ok == 1)
    let t5 = round_trip_text(conn, str_repeat("c", 65535))?
    conn = t5.conn
    check("len_65535", t5.ok == 1)
    let t6 = round_trip_text(conn, str_repeat("d", 65536))?
    conn = t6.conn
    check("len_65536", t6.ok == 1)

    // --- binary frame with NUL / 0xFF (bytes are binary-safe) ---
    let bv: Vec<i64> = vec_new()
    vec_push(bv, 0)
    vec_push(bv, 255)
    vec_push(bv, 66)
    vec_push(bv, 0)
    vec_push(bv, 97)
    let bpay = bytes_from_vec(bv)
    let wb = ws_send_binary(conn.fd, bpay)?
    check("binary_send", wb == 0)
    let rb = ws_read_frame(conn)?
    conn = rb.conn
    check("binary_echo", rb.ok == 1 && rb.frame.opcode == WS_BINARY() && bytes_eq_b(rb.frame.payload, bpay))

    // --- ping → pong with the same payload ---
    let pp = bytes_of_str("ping-payload")
    let wp = ws_send_ping(conn.fd, pp)?
    check("ping_send", wp == 0)
    let rp = ws_read_frame(conn)?
    conn = rp.conn
    check("pong", rp.ok == 1 && rp.frame.opcode == WS_PONG() && bytes_eq_b(rp.frame.payload, pp))

    // --- fragmented message (W2): FIN=0 text + continuation FIN=1 ---
    // (client frames are masked — ws_build_frame with a nonzero key)
    let w1 = tcp_write_bytes(conn.fd, ws_build_frame(0, WS_TEXT(), bytes_of_str("Здра"), 7))?
    check("frag_part1_send", w1 == 0)
    let w2 = tcp_write_bytes(conn.fd, ws_build_frame(1, 0, bytes_of_str("вей"), 9))?
    check("frag_part2_send", w2 == 0)
    let rf = ws_read_frame(conn)?
    conn = rf.conn
    check("frag_echo", rf.ok == 1 && rf.frame.opcode == WS_TEXT() && str_of_bytes(rf.frame.payload) == "Здравей")

    // --- control frame interleaved mid-message (RFC 6455 §5.4) ---
    tcp_write_bytes(conn.fd, ws_build_frame(0, WS_TEXT(), bytes_of_str("по"), 11))?
    ws_send_ping(conn.fd, bytes_of_str("mid"))?
    tcp_write_bytes(conn.fd, ws_build_frame(1, 0, bytes_of_str("чив"), 13))?
    let rmid1 = ws_read_frame(conn)?
    conn = rmid1.conn
    check("frag_mid_pong", rmid1.ok == 1 && rmid1.frame.opcode == WS_PONG() && str_of_bytes(rmid1.frame.payload) == "mid")
    let rmid2 = ws_read_frame(conn)?
    conn = rmid2.conn
    check("frag_mid_echo", rmid2.ok == 1 && rmid2.frame.opcode == WS_TEXT() && str_of_bytes(rmid2.frame.payload) == "почив")

    // --- close: server echoes close code+reason, then the socket is done ---
    let wc = ws_send_close_code(conn.fd, 1000, "bye")?
    check("close_send", wc == 0)
    let rc = ws_read_frame(conn)?
    conn = rc.conn
    check("close_echo", rc.ok == 1 && rc.frame.opcode == WS_CLOSE())
    check("close_echo_code", ws_close_code(rc.frame.payload) == 1000)
    check("close_echo_reason", ws_close_reason(rc.frame.payload) == "bye")
    let re = ws_read_frame(conn)?
    check("eof_after_close", re.ok == 0)

    // --- lone continuation on a FRESH connection (the serial server is
    // free only after the previous close): protocol violation → close ---
    let d2 = ws_client_connect("localhost", port, 5)?
    check("frag_handshake2", d2.ok == 1)
    tcp_write_bytes(d2.conn.fd, ws_build_frame(1, 0, bytes_of_str("x"), 15))?
    let rl = ws_read_frame(d2.conn)?
    check("frag_lone_cont_close", rl.ok == 0)

    print("ws_test: all passed")
    return 0
}
