// vec_struct_test.baga — Vec<struct> (L4): struct elements boxed per slot,
// copied in on push/set, copied out on get. Covers push/get/set/slice/
// concat, call-site inference, nested reference fields, and by-value
// mutation semantics.

import "std/str/str.baga"

fn check(name: str, ok: bool) {
    if ok {
        print(concat("ok ", name))
    } else {
        eprintln(concat("FAIL ", name))
        exit(1)
    }
}

struct Line {
    label: str,
    amount: i64,
    tags: Vec<str>
}

fn line_total(lines: Vec<Line>) -> i64 {
    let mut total: i64 = 0
    for i in 0..vec_len(lines) {
        total = total + vec_get(lines, i).amount
    }
    return total
}

fn main() {
    // --- push / get ---
    let v: Vec<Line> = vec_new()
    check("new_len", vec_len(v) == 0)
    vec_push(v, Line { label: "първи", amount: 10, tags: vec_new() })
    vec_push(v, Line { label: "втори", amount: 20, tags: vec_new() })
    check("len_after", vec_len(v) == 2)
    let g = vec_get(v, 0)
    check("get_label", g.label == "първи")
    check("get_amount", g.amount == 10)
    check("get_field_direct", vec_get(v, 1).amount == 20)

    // --- get copies out: mutating the copy does not touch the vec ---
    let mut g2 = vec_get(v, 0)
    g2.amount = 99
    check("get_copies_out", vec_get(v, 0).amount == 10)

    // --- set copies in ---
    let mut repl = Line { label: "заменен", amount: 42, tags: vec_new() }
    vec_set(v, 0, repl)
    check("set_label", vec_get(v, 0).label == "заменен")
    check("set_amount", vec_get(v, 0).amount == 42)
    repl.amount = 7
    check("set_copies_in", vec_get(v, 0).amount == 42)

    // --- reference fields stay shared (shallow box copy) ---
    let l3 = Line { label: "с тагове", amount: 5, tags: vec_new() }
    vec_push(l3.tags, "а")
    vec_push(v, l3)
    vec_push(l3.tags, "б")
    check("ref_field_shared", vec_len(vec_get(v, 2).tags) == 2)

    // --- slice / concat ---
    let s = vec_slice(v, 1, 3)
    check("slice_len", vec_len(s) == 2)
    check("slice_amount", vec_get(s, 0).amount == 20)
    let w: Vec<Line> = vec_new()
    vec_push(w, Line { label: "опашка", amount: 1, tags: vec_new() })
    let cc = vec_concat(v, w)
    check("concat_len", vec_len(cc) == 4)
    check("concat_tail", vec_get(cc, 3).label == "опашка")

    // --- annotated parameter + line_total (42 + 20 + 5 след замяната) ---
    check("param_sum", line_total(v) == 67)

    // --- unannotated vec fixed from the parameter at the call site ---
    let u = vec_new()
    vec_push(u, Line { label: "x", amount: 3, tags: vec_new() })
    check("infer_sum", line_total(u) == 3)

    // --- growth ---
    let big: Vec<Line> = vec_new()
    for i in 0..200 {
        vec_push(big, Line { label: "ел", amount: i, tags: vec_new() })
    }
    check("big_len", vec_len(big) == 200)
    check("big_mid", vec_get(big, 150).amount == 150)

    print("vec_struct_test: all passed")
}
