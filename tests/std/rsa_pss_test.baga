// rsa_pss_test.baga — RSA-PSS-SHA256 + PKCS1 cert verify (TLS T6).
// Oracle: python cryptography, vectors embedded offline.

import "std/crypto/rsa.baga"
import "std/crypto/x509.baga"
import "std/crypto/der.baga"

fn check(name: str, ok: bool) {
    if ok {
        print(concat("ok ", name))
    } else {
        eprintln(concat("FAIL ", name))
        exit(1)
    }
}

fn main() {
    let n = hex_decode("")
    let e = hex_decode("010001")
    let msg = hex_decode("20202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020544c5320312e332c2073657276657220436572746966696361746556657269667900a9b3bf651f93b706e0ff6c53c9ee64f9ef9ec102d7dccd59f78411cfd6c9f25a")
    let sig = hex_decode("")
    let cert_der = hex_decode("")

    check("n_len", bytes_len(n) == 256)
    check("sig_len", bytes_len(sig) == 256)
    check("pss_verify", rsa_pss_sha256_verify(n, e, msg, sig) == 1)

    // Tamper: flip a message byte → must fail
    let bad_msg = bytes_concat(hex_decode("21"), bytes_slice(msg, 1, bytes_len(msg)))
    check("pss_reject_bad_msg", rsa_pss_sha256_verify(n, e, bad_msg, sig) == 0)

    // Tamper: flip a signature byte
    let bad_sig = bytes_concat(hex_decode("00"), bytes_slice(sig, 1, bytes_len(sig)))
    check("pss_reject_bad_sig", rsa_pss_sha256_verify(n, e, msg, bad_sig) == 0)

    // X.509 parse + self-signed PKCS#1 verify
    let cert = x509_parse(cert_der)
    if cert.ok == 0 {
        eprintln(concat("parse err: ", cert.err))
        exit(1)
    }
    check("x509_parse", cert.ok == 1)
    check("x509_is_rsa", cert.is_rsa == 1)
    check("x509_n_match", bytes_len(cert.n) == 256)
    // n may have leading zero stripped from DER integer; compare via bn or length
    check("x509_n_eq", hex_encode(cert.n) == hex_encode(n) || bytes_len(cert.n) == 256)
    // exact n match
    check("x509_n_exact", hex_encode(cert.n) == "")
    check("x509_e_65537", hex_encode(cert.e) == "010001")
    check("x509_self_signed", x509_verify_self_signed(cert) == 1)
    check("x509_trust_self", x509_trust_anchor(cert_der, cert_der) == 1)

    // DER smoke: outer is SEQUENCE
    let d = der_of(cert_der)
    let h = der_read_hdr(d)
    check("der_outer_seq", h.ok == 1 && h.tag == 48)

    print("rsa_pss_test: all passed")
}
