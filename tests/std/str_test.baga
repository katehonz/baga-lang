import "std/str/str.baga"

fn check(name: str, ok: bool) {
    if ok {
        print(concat("ok ", name))
    } else {
        eprintln(concat("FAIL ", name))
        exit(1)
    }
}

fn main() {
    check("starts_with", str_starts_with("hello world", "hello"))
    check("starts_with_neg", !str_starts_with("hello", "hello world"))
    check("ends_with", str_ends_with("hello world", "world"))
    check("ends_with_neg", !str_ends_with("hi", "ohi"))
    check("find", str_find("hello world", "world") == 6)
    check("find_missing", str_find("hello", "zzz") == -1)
    check("find_empty", str_find("abc", "") == 0)

    let parts = str_split("a,b,,c", ",")
    check("split_len", vec_len(parts) == 4)
    check("split_0", vec_get(parts, 0) == "a")
    check("split_2", vec_get(parts, 2) == "")
    check("split_3", vec_get(parts, 3) == "c")

    check("join", str_join(parts, "|") == "a|b||c")
    check("replace", str_replace("a-b-c", "-", "+") == "a+b+c")
    check("replace_longer", str_replace("hello", "ll", "LLL") == "heLLLo")
    check("replace_none", str_replace("abc", "z", "q") == "abc")
    check("trim", str_trim("  hi \n\t") == "hi")
    check("trim_all", str_trim("   ") == "")
    check("repeat", str_repeat("ab", 3) == "ababab")
    check("repeat_zero", str_repeat("x", 0) == "")
    check("repeat_len", len(str_repeat(" ", 4096)) == 4096)
    check("parse_int", parse_int("12345") == 12345)
    check("parse_int_neg", parse_int("-42") == -42)
    check("parse_int_trailing", parse_int("12x") == 12)
    check("int_to_str", int_to_str(12345) == "12345")
    check("int_to_str_neg", int_to_str(-42) == "-42")
    check("int_to_str_zero", int_to_str(0) == "0")
    check("int_to_str_max", int_to_str(9223372036854775807) == "9223372036854775807")
    check("int_to_str_min", int_to_str(0 - 9223372036854775807 - 1) == "-9223372036854775808")
    check("roundtrip", parse_int(int_to_str(98765)) == 98765)

    // S1 затворена: многосимволен разделител (преди str_split цепеше само
    // по първия символ — "\r\n" ставаше на '\r' + водещ '\n' във всяко поле).
    let hp = str_split("GET / HTTP/1.1\r\nHost: x\r\nAccept: */*\r\n", "\r\n")
    check("split_crlf_len", vec_len(hp) == 4)
    check("split_crlf_0", vec_get(hp, 0) == "GET / HTTP/1.1")
    check("split_crlf_1", vec_get(hp, 1) == "Host: x")
    check("split_crlf_last_empty", vec_get(hp, 3) == "")
    let mm = str_split("a::b::::c", "::")
    check("split_multi_len", vec_len(mm) == 4)
    check("split_multi_0", vec_get(mm, 0) == "a")
    check("split_multi_1", vec_get(mm, 1) == "b")
    check("split_multi_2_empty", vec_get(mm, 2) == "")
    check("split_multi_3", vec_get(mm, 3) == "c")
    check("split_empty_delim", vec_len(str_split("abc", "")) == 1)
    check("split_no_hit", vec_len(str_split("abc", "::")) == 1)
    check("find_from", str_find_from("aXaXa", "X", 2) == 3)
    check("find_from_past", str_find_from("abc", "a", 1) == -1)

    // UTF-8: codepoint-и, не байтове (кирилицата е first-class в езика)
    check("utf8_count_ascii", str_char_count("hello") == 5)
    check("utf8_count_bg", str_char_count("здравей") == 7)
    check("utf8_bg_bytes", len("здравей") == 14)
    check("utf8_char_at", str_char_at("здравей", 0) == "з")
    check("utf8_char_at_mid", str_char_at("здравей", 4) == "в")
    check("utf8_char_at_oob", str_char_at("здравей", 7) == "")
    check("utf8_cp_bg", str_codepoint_at("з", 0) == 1079)
    check("utf8_cp_ascii", str_codepoint_at("A", 0) == 65)
    check("utf8_cp_emoji", str_codepoint_at("😀", 0) == 128512)
    check("utf8_cp_oob", str_codepoint_at("abc", 5) == -1)
    check("utf8_from_cp_bg", str_from_codepoint(1079) == "з")
    check("utf8_from_cp_emoji", str_from_codepoint(128512) == "😀")
    check("utf8_from_cp_bad", str_from_codepoint(0 - 1) == "")
    check("utf8_roundtrip", str_from_codepoint(str_codepoint_at("юнакод", 3)) == str_char_at("юнакод", 3))
    check("utf8_mixed_count", str_char_count("aб😀c") == 4)
    print("str_test: all passed")
}
