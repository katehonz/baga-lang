// sha1_test.baga — RFC 3174 known answers + the RFC 6455 handshake vector.

import "std/crypto/sha1.baga"
import "std/bytes/bytes.baga"

fn check(name: str, ok: bool) {
    if ok {
        print(concat("ok ", name))
    } else {
        eprintln(concat("FAIL ", name))
        exit(1)
    }
}

fn main() -> i64 {
    // RFC 3174 §7.3 test vectors
    check("empty", sha1_hex("") == "da39a3ee5e6b4b0d3255bfef95601890afd80709")
    check("abc", sha1_hex("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d")
    check("two_blocks", sha1_hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq") == "84983e441c3bd26ebaae4aa1f95129e5e54670f1")
    check("fox", sha1_hex("The quick brown fox jumps over the lazy dog") == "2fd4e1c67a2d28fced849ee1bb76e7391b93eb12")
    check("fox_cog", sha1_hex("The quick brown fox jumps over the lazy cog") == "de9f2c7fd25e1b3afad3e85a0bd17d9b100db4b3")

    // million 'a' — the classic long-input vector
    let million = str_repeat("a", 1000000)
    check("million_a", sha1_hex(million) == "34aa973cd4c4daa4f61eeb2bdbad27316534016f")

    // RFC 6455 §1.3: Sec-WebSocket-Accept for key "dGhlIHNhbXBsZSBub25jZQ=="
    let ws_key = "dGhlIHNhbXBsZSBub25jZQ==258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
    check("ws_accept", base64_encode(sha1(ws_key)) == "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=")

    // bytes API parity
    check("bytes_api", sha1_b_hex(bytes_of_str("abc")) == "a9993e364706816aba3e25717850c26c9cd0d89d")

    print("sha1_test: all passed")
    return 0
}
