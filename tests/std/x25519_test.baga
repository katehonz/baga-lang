// x25519_test.baga — RFC 7748 vectors for std/crypto/x25519.baga (T2).
// §5.2 first iteration (k = u = 9) + §6.1 Diffie–Hellman. The 1,000-
// iteration vector is documented but not in make test (too slow for CI;
// expected: 684cf59ba83309552800ef566f2f4d3c1c3887c49360e3875f2eb94d99532c51).

import "std/crypto/x25519.baga"
import "std/bytes/bytes.baga"
import "std/str/str.baga"

fn check(name: str, ok: bool) {
    if ok {
        print(concat("ok ", name))
    } else {
        eprintln(concat("FAIL ", name))
        exit(1)
    }
}

fn h(b: bytes) -> str {
    return bytes_to_hex(vec_from_bytes(b))
}

fn main() {
    // --- RFC 7748 §5.2, first iteration: k = u = 9 ---
    let nine = bn_zero(32)
    vec_set(nine, 0, 9)
    let n9 = bytes_from_vec(nine)
    check("iter1", h(x25519(n9, n9)) ==
        "422c8e7a6227d7bca1350b3e2bb7279f7897b87bb6854b783c60e80311ae3079")

    // --- RFC 7748 §6.1 Diffie–Hellman ---
    let alice_priv = bytes_from_vec(bytes_from_hex(
        "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"))
    let bob_priv = bytes_from_vec(bytes_from_hex(
        "5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb"))
    let alice_pub = "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a"
    let bob_pub = "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"
    let shared = "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742"

    check("alice_pub", h(x25519_public(alice_priv)) == alice_pub)
    check("bob_pub", h(x25519_public(bob_priv)) == bob_pub)
    check("shared_ab", h(x25519(alice_priv, bytes_from_vec(bytes_from_hex(bob_pub)))) == shared)
    check("shared_ba", h(x25519(bob_priv, bytes_from_vec(bytes_from_hex(alice_pub)))) == shared)

    print("x25519_test: all passed")
}
