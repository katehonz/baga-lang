// https_test.baga — TLS 1.3 https:// client against openssl mock (T8).
//
// No real OAuth provider account is required: scripts/run_tests.sh boots
// `openssl s_server -tls1_3 -www` with a fresh self-signed cert, and the
// client accepts self-signed trust (empty anchor). That is the honest
// mock for G6 / №10 P2 without third-party credentials.

import "std/net/http_client.baga"
import "std/str/str.baga"

fn check(name: str, ok: bool) {
    if ok {
        print(concat("ok ", name))
    } else {
        eprintln(concat("FAIL ", name))
        exit(1)
    }
}

fn main() -> i64 !Net !IO !Random {
    // URL parsing
    let u = http_parse_url("https://example.com/a?b=1")
    check("url_https_default_port", u.ok == 1 && u.https == 1 && u.port == 443 && u.path == "/a?b=1")
    let u2 = http_parse_url("https://127.0.0.1:18444/")
    check("url_https_explicit_port", u2.ok == 1 && u2.port == 18444 && u2.https == 1)
    let u3 = http_parse_url("http://localhost/x")
    check("url_http_still_works", u3.ok == 1 && u3.https == 0 && u3.port == 80)

    // Live GET over TLS 1.3 against openssl -www on 18444
    let r = http_get("https://127.0.0.1:18444/", 15)?
    check("https_get_ok", r.ok == 1)
    check("https_status_200", r.status == 200)
    check("https_body_html", str_find(r.body, "HTML") >= 0 || str_find(r.body, "html") >= 0 || str_find(r.body, "s_server") >= 0)
    check("https_body_nonempty", len(r.body) > 20)

    // Refused / bad scheme still fail cleanly
    let bad = http_get("https://127.0.0.1:1/", 2)?
    check("https_refused", bad.ok == 0)

    print("https_test: all passed")
    return 0
}
