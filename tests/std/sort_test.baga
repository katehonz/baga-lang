// sort_test — dogfood of testbaga assert API (apps-roadmap №8).

import "std/sort/sort.baga"
import "testbaga/assert.baga"

fn main() {
    let v = vec_new()
    vec_push(v, 5)
    vec_push(v, -3)
    vec_push(v, 42)
    vec_push(v, 0)
    vec_push(v, 7)
    vec_push(v, -100)
    sort_i64(v)
    assert_true("sorted", vec_get(v, 0) == -100 && vec_get(v, 1) == -3 && vec_get(v, 2) == 0 && vec_get(v, 3) == 5 && vec_get(v, 4) == 7 && vec_get(v, 5) == 42)
    assert_eq_i64("bsearch_hit", binary_search_i64(v, 7), 4)
    assert_eq_i64("bsearch_first", binary_search_i64(v, -100), 0)
    assert_eq_i64("bsearch_last", binary_search_i64(v, 42), 5)
    assert_eq_i64("bsearch_miss", binary_search_i64(v, 6), -1)

    let e = vec_new()
    sort_i64(e)
    assert_eq_i64("empty", vec_len(e), 0)
    assert_eq_i64("bsearch_empty", binary_search_i64(e, 1), -1)

    let one = vec_new()
    vec_push(one, 9)
    sort_i64(one)
    assert_eq_i64("single", vec_get(one, 0), 9)
    print("sort_test: all passed")
}
