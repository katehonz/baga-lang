// vec_test.baga — Vec<bytes> (L4): binary-safe element kind next to
// i64/str/f64. push/get/set/slice/concat + annotated parameter passing.
// Bytes elements are boxed baga_bytes (pointer per slot), like Map bytes values.

import "std/str/str.baga"

fn check(name: str, ok: bool) {
    if ok {
        print(concat("ok ", name))
    } else {
        eprintln(concat("FAIL ", name))
        exit(1)
    }
}

// Vec parameters are shared pointers — mutation is visible to the caller.
fn append_nul(v: Vec<bytes>) -> i64 {
    let zv = vec_new()
    vec_push(zv, 0)
    vec_push(zv, 0)
    vec_push(v, bytes_from_vec(zv))   // two NUL bytes
    return vec_len(v)
}

fn main() {
    // --- push/get, binary-safe round-trip (NUL and 0xFF) ---
    let v: Vec<bytes> = vec_new()
    check("new_len", vec_len(v) == 0)

    let raw = vec_new()
    vec_push(raw, 0)
    vec_push(raw, 255)
    vec_push(raw, 66)
    let b1 = bytes_from_vec(raw)
    vec_push(v, b1)
    vec_push(v, bytes_of_str("текст"))
    check("len_after", vec_len(v) == 2)

    let g = vec_get(v, 0)
    check("get_len", bytes_len(g) == 3)
    check("get_nul", bytes_at(g, 0) == 0)
    check("get_ff", bytes_at(g, 1) == 255)
    check("get_b", bytes_at(g, 2) == 66)
    check("get_utf8", str_of_bytes(vec_get(v, 1)) == "текст")

    // --- set replaces the element ---
    let b2 = bytes_of_str("заменен")
    vec_set(v, 0, b2)
    check("set_str", str_of_bytes(vec_get(v, 0)) == "заменен")
    check("set_keeps_len", vec_len(v) == 2)
    check("set_keeps_other", str_of_bytes(vec_get(v, 1)) == "текст")

    // --- annotated parameter: mutation crosses the call boundary ---
    check("param_len", append_nul(v) == 3)
    check("param_nul", bytes_len(vec_get(v, 2)) == 2 && bytes_at(vec_get(v, 2), 0) == 0)

    // --- slice ---
    let s = vec_slice(v, 1, 3)
    check("slice_len", vec_len(s) == 2)
    check("slice_first", str_of_bytes(vec_get(s, 0)) == "текст")
    check("slice_nul", bytes_len(vec_get(s, 1)) == 2)
    check("slice_independent", vec_len(v) == 3)

    // --- concat ---
    let w: Vec<bytes> = vec_new()
    vec_push(w, bytes_of_str("опашка"))
    let cc = vec_concat(v, w)
    check("concat_len", vec_len(cc) == 4)
    check("concat_head", str_of_bytes(vec_get(cc, 0)) == "заменен")
    check("concat_tail", str_of_bytes(vec_get(cc, 3)) == "опашка")

    // --- unannotated vec fixed on first push ---
    let u = vec_new()
    vec_push(u, bytes_of_str("първи"))
    vec_push(u, bytes_of_str("втори"))
    check("infer_len", vec_len(u) == 2)
    check("infer_get", str_of_bytes(vec_get(u, 1)) == "втори")

    // --- growth: 300 elements force several doublings (cap 8 → 16 → ...) ---
    let big: Vec<bytes> = vec_new()
    for i in 0..300 {
        vec_push(big, bytes_of_str(concat("ел", int_to_str(i))))
    }
    check("big_len", vec_len(big) == 300)
    check("big_lo", str_of_bytes(vec_get(big, 0)) == concat("ел", "0"))
    check("big_mid", str_of_bytes(vec_get(big, 150)) == concat("ел", "150"))
    check("big_hi", str_of_bytes(vec_get(big, 299)) == concat("ел", "299"))

    print("vec_test: all passed")
}
