// tls_handshake_test.baga — live TLS 1.3 handshake against openssl
// s_server (apps-roadmap №10 P2, T4–T6). Full client flight in pure
// Baga: ClientHello (x25519) → ServerHello → key schedule → decrypt
// EncryptedExtensions/Certificate/CertificateVerify/Finished → verify
// server Finished HMAC → T6 cert + RSA-PSS CertificateVerify → send
// the client Finished.
//
// The peer is external (baga has no process spawn): scripts/run_tests.sh
// starts `openssl s_server -accept 18443 -tls1_3` with a fresh
// self-signed certificate before running this test.

import "std/net/tls.baga"
import "std/net/tls_crypto.baga"
import "std/net/tls_flight.baga"
import "std/net/tls_conn.baga"
import "std/net/tcp.baga"
import "std/crypto/x25519.baga"
import "std/crypto/x509.baga"
import "std/bytes/bytes.baga"
import "std/str/str.baga"
import "std/random/random.baga"
import "std/os/os.baga"
import "testbaga/assert.baga"

fn chunk_add(acc: bytes, payload: bytes) -> bytes {
    let ln = bytes_len(payload)
    let hd = vec_new()
    vec_push(hd, (ln >> 16) & 255)
    vec_push(hd, (ln >> 8) & 255)
    vec_push(hd, ln & 255)
    return bytes_concat(bytes_concat(acc, bytes_from_vec(hd)), payload)
}

fn main() -> i64 !Net !IO !Par !Random {
    let fd = tcp_connect("127.0.0.1", 18443)?
    if fd < 0 {
        eprintln("tls_handshake_test: connect failed (is the Makefile peer up?)")
        return 1
    }

    // --- ClientHello ---
    let scalar = bytes_from_vec(random_bytes(32))
    let sid = bytes_from_vec(random_bytes(32))
    let rnd = bytes_from_vec(random_bytes(32))
    let pub = x25519_public(scalar)
    let rec0 = tls_client_hello(pub, rnd, sid, "")
    let w = tcp_write_bytes(fd, rec0)?
    assert_eq_i64("hello_written", w, 0)
    let ch_msg = bytes_slice(rec0, 5, bytes_len(rec0))

    // --- ServerHello ---
    let sh_rec = tls_read_record(fd)?
    assert_eq_i64("sh_record", sh_rec.ok, 1)
    let sh_msg = sh_rec.payload
    let shello = tls_parse_server_hello(sh_msg)
    assert_eq_i64("sh_parsed", shello.ok, 1)
    assert_eq_i64("sh_version_tls13", shello.version, 772)
    // expected suite: TLSCIPHER env (4865 default; 4866 for the forced
    // TLS_AES_256_GCM_SHA384 peer run in run_tests.sh)
    let mut want_cipher: i64 = 4865
    let envc = env("TLSCIPHER")?
    if envc != "" {
        want_cipher = parse_int(envc)
    }
    assert_eq_i64("sh_cipher", shello.cipher, want_cipher)
    assert_eq_i64("sh_keyshare_len", bytes_len(shello.server_pub), 32)

    // --- schedule + flight decrypt ---
    let shared = x25519(scalar, shello.server_pub)
    let sched = tls_schedule(shello.cipher, ch_msg, sh_msg, shared)
    assert_eq_i64("schedule", sched.ok, 1)

    let mut chunked = bytes_from_vec(vec_new())
    let mut recs: i64 = 0
    let mut reading: i64 = 1
    while reading == 1 {
        let r = tls_read_record(fd)?
        assert_eq_i64("flight_record", r.ok, 1)
        if r.typ == 23 {
            chunked = chunk_add(chunked, r.payload)
            recs = recs + 1
            if recs >= 4 {
                reading = 0
            }
        } else {
            if r.typ != 20 {   // CCS (middlebox compat) is skipped
                assert_true("unexpected_record", false)
            }
        }
    }
    let flight = tls_open_handshake(sched, ch_msg, sh_msg, chunked)
    if flight.ok == 0 {
        eprintln(concat("tls_handshake_test: ", flight.err))
        return 1
    }
    assert_eq_i64("flight_ok", flight.ok, 1)
    assert_eq_i64("msg_count", vec_len(flight.types), 4)
    assert_eq_i64("msg_ee", vec_get(flight.types, 0), 8)
    assert_eq_i64("msg_cert", vec_get(flight.types, 1), 11)
    assert_eq_i64("msg_certverify", vec_get(flight.types, 2), 15)
    assert_eq_i64("msg_finished", vec_get(flight.types, 3), 20)
    assert_true("cert_der_present", bytes_len(flight.cert_der) > 100)
    assert_true("cv_sig_present", bytes_len(flight.cv_sig) > 0)
    assert_eq_i64("server_finished_verified", flight.finished_ok, 1)
    // 0x0804 rsa_pss_rsae_sha256 or 0x0403 ecdsa_secp256r1_sha256
    assert_true("cv_algo_known", flight.cv_algo == 2052 || flight.cv_algo == 1027)
    assert_eq_i64("cv_hash_len", bytes_len(flight.cv_hash), tls_hash_len(shello.cipher))

    // --- T6/T7: X.509 + CertificateVerify (RSA-PSS or ECDSA-P256) ---
    let leaf = x509_parse(flight.cert_der)
    if leaf.ok == 0 {
        eprintln(concat("tls_handshake_test: x509 ", leaf.err))
        return 1
    }
    assert_eq_i64("x509_parse", leaf.ok, 1)
    assert_true("x509_key_type", leaf.is_rsa == 1 || leaf.is_ec == 1)
    assert_eq_i64("x509_self_signed", x509_verify_self_signed(leaf), 1)
    // empty anchor → accept self-signed leaf (openssl peer)
    let ver = tls_verify_server(flight, bytes_from_vec(vec_new()))
    if ver.ok == 0 {
        eprintln(concat("tls_handshake_test: verify ", ver.err))
        return 1
    }
    assert_eq_i64("cert_ok", ver.cert_ok, 1)
    assert_eq_i64("cv_ok", ver.cv_ok, 1)
    assert_eq_i64("verify_ok", ver.ok, 1)

    // --- client Finished (transcript through server Finished) ---
    let fin = tls_finished_record(sched, flight.flight_hash)
    let w2 = tcp_write_bytes(fd, fin)?
    assert_eq_i64("finished_written", w2, 0)
    // App traffic: first record is NewSessionTicket (inner type 22), not
    // an encrypted decrypt_error alert (outer type 23, inner 21 — T5 used
    // to miss that by only checking the outer type).
    let mut conn = tls_app_secrets(sched, flight.app_hash)
    conn = TlsConn {
        ok: 1, err: "", fd: fd,
        c_key: conn.c_key, c_iv: conn.c_iv, s_key: conn.s_key, s_iv: conn.s_iv,
        c_seq: 0, s_seq: 0
    }
    tcp_set_timeouts(fd, 3)?
    let post = tls_conn_read(conn)?
    assert_eq_i64("post_hs_ok", post.conn.ok, 1)
    assert_true("not_alert", post.typ != 21)
    assert_eq_i64("new_session_ticket", post.typ, 22)

    print("tls_handshake_test: all passed")
    return 0
}
