// sst_scan_test.baga — R20 block-level scan + fold; R27 block CRC verify.
import "rocksbaga/table/sstable.baga"
import "rocksbaga/cache/page.baga"
import "rocksbaga/util/codec.baga"
import "std/os/os.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"

fn check(fails: Vec<str>, name: str, ok: bool) {
    if ok == false {
        vec_push(fails, name)
        print(concat("FAIL ", name))
    } else {
        print(concat("  ok  ", name))
    }
}

fn main() -> i64 !IO {
    let fails: Vec<str> = vec_new()
    let prefix = "/tmp/baga_sst_scan_r20"
    unlink(concat(prefix, ".sst.1"))?
    unlink(concat(prefix, ".bloom.1"))?

    // Build a multi-block SST (restart every 16 → 40 rows ⇒ 3 blocks).
    // R67: SstRow keys are raw bytes.
    let rows: Vec<SstRow> = vec_new()
    let mut i: i64 = 0
    while i < 40 {
        let k = bytes_of_str(concat("k", int_to_str(i)))
        let v = bytes_of_str(concat("v", int_to_str(i)))
        if i == 7 {
            vec_push(rows, SstRow { op: 2, key: k, val: bytes_new(0) })  // tomb
        } else {
            vec_push(rows, SstRow { op: 1, key: k, val: v })
        }
        i = i + 1
    }
    check(fails, "write", sst_write(prefix, 1, rows)? == 0)

    let mut pc = pc_new(4096, 8)
    let fds: Map<i64, i64> = map_new()
    let sizes: Map<i64, i64> = map_new()
    let fd = sst_fd_get(pc, fds, sizes, prefix, 1)?
    check(fails, "fd", fd >= 0)
    let fsize = map_get(sizes, 1)
    check(fails, "fsize", fsize > 0)

    // --- scan yields 40 rows in order ---
    let mut sc = sst_scan_begin(pc, fd, 1, fsize)?
    check(fails, "scan_open", sc.open == 1)
    let mut n: i64 = 0
    let mut saw_tomb: i64 = 0
    let mut order_ok: i64 = 1
    let mut go: i64 = 1
    while go == 1 {
        let st = sst_scan_next(sc)?
        sc = st.scan
        if st.done == 1 {
            go = 0
        } else {
            if st.ok == 1 {
                let expect = bytes_of_str(concat("k", int_to_str(n)))
                if bytes_eq_b(st.row.key, expect) == false {
                    order_ok = 0
                }
                if n == 7 {
                    if st.row.op == 2 {
                        saw_tomb = 1
                    }
                }
                n = n + 1
            }
        }
    }
    pc = sc.pc
    check(fails, "scan_count", n == 40)
    check(fails, "scan_order", order_ok == 1)
    check(fails, "scan_tomb", saw_tomb == 1)

    // --- fold into maps (R67: bytes-keyed accumulators) ---
    let acc: Map<bytes, bytes> = map_new()
    let tomb: Map<bytes, i64> = map_new()
    pc = sst_fold_into(pc, prefix, 1, fds, sizes, acc, tomb)?
    check(fails, "fold_live", map_has(acc, bytes_of_str("k0")) == 1)
    check(fails, "fold_tomb", map_has(tomb, bytes_of_str("k7")) == 1 && map_has(acc, bytes_of_str("k7")) == 0)
    check(fails, "fold_val", str_of_bytes(map_get(acc, bytes_of_str("k10"))) == "v10")
    check(fails, "fold_n_acc", vec_len(map_keys(acc)) == 39)

    // block.baga round-trip
    let body = bytes_new(64)
    let end = block_rec_put(body, 0, 1, bytes_of_str("ab"), bytes_of_str("xy"))
    check(fails, "rec_put", end == block_rec_size(2, 2))
    let r = block_rec_at(body, 0)
    check(fails, "rec_get", r.ok == 1 && bytes_eq_b(r.key, bytes_of_str("ab")) && str_of_bytes(r.val) == "xy")

    // R27: meta loads bcrcs; clean block CRC ok
    let ml = sst_meta_load(pc, fd, 1, fsize)?
    pc = ml.pc
    check(fails, "meta_ok", ml.meta.ok == 1 && ml.meta.tag == 5)
    check(fails, "bcrcs_len", bytes_len(ml.meta.bcrcs) == ml.meta.n_restarts * 4)
    let start0 = get_u32_le(ml.meta.idx, 0)
    let mut end0 = ml.meta.idx_base
    if ml.meta.n_restarts > 1 {
        end0 = get_u32_le(ml.meta.idx, 4)
    }
    let br0 = pc_read_at(pc, fd, 1, 8 + start0, end0 - start0)?
    pc = br0.pc
    check(fails, "crc_ok", sst_block_crc_ok(ml.meta, 0, br0.data) == 1)

    sst_fd_drop(pc, fds, sizes, 1)?

    // Corrupt first data byte after magic → block CRC fails → scan closed
    let path = concat(prefix, ".sst.1")
    let cfd = open(path, 2, 0)?  // O_RDWR = 2
    check(fails, "corrupt_open", cfd >= 0)
    // magic 8 + count 4 + first record: flip a value byte deep in file
    let poke = fd_pread_bytes(cfd, 1, 20)?
    let mut b = bytes_at(poke, 0) ^ 255
    let one = bytes_new(1)
    bytes_set(one, 0, b)
    check(fails, "corrupt_write", fd_pwrite_bytes(cfd, one, 20) == 0)
    close(cfd)

    let mut pc2 = pc_new(4096, 8)
    let fds2: Map<i64, i64> = map_new()
    let sizes2: Map<i64, i64> = map_new()
    let fd2 = sst_fd_get(pc2, fds2, sizes2, prefix, 1)?
    let fsize2 = map_get(sizes2, 1)
    let sc2 = sst_scan_begin(pc2, fd2, 1, fsize2)?
    // meta may still load; first block CRC should fail → open=0
    check(fails, "corrupt_scan_closed", sc2.open == 0 && sc2.meta.ok == 1)
    pc2 = sc2.pc
    // fold must not resurrect via full-load fallback
    let acc2: Map<bytes, bytes> = map_new()
    let tomb2: Map<bytes, i64> = map_new()
    pc2 = sst_fold_into(pc2, prefix, 1, fds2, sizes2, acc2, tomb2)?
    check(fails, "corrupt_fold_empty", map_len(acc2) == 0)

    sst_fd_drop(pc2, fds2, sizes2, 1)?
    unlink(concat(prefix, ".sst.1"))?
    unlink(concat(prefix, ".bloom.1"))?

    if vec_len(fails) == 0 {
        print("sst_scan_test: all passed")
        return 0
    }
    print(concat(concat("sst_scan_test: FAILED (", int_to_str(vec_len(fails))), ")"))
    return 1
}
