// str.baga — string utilities. Pure Baga, no effects.
// Built on the len/char_at/substr/concat/chr/ord/str_eq builtins.

fn str_starts_with(s: str, prefix: str) -> bool {
    if len(prefix) > len(s) { return false }
    return substr(s, 0, len(prefix)) == prefix
}

fn str_ends_with(s: str, suffix: str) -> bool {
    if len(suffix) > len(s) { return false }
    return substr(s, len(s) - len(suffix), len(s)) == suffix
}

// Index of the first occurrence of needle at or after `start`, or -1.
// O(|s|): byte_at е O(1) (няма strlen на всяка проба); substr сравнява само
// при съвпадение на първия байт, за да не стане O(n²) върху дълъг низ.
fn str_find_from(s: str, needle: str, start: i64) -> i64 {
    let n = len(needle)
    if n == 0 { return start }
    let sn = len(s)
    let first = byte_at(needle, 0)
    let mut i: i64 = start
    if i < 0 { i = 0 }
    while i + n <= sn {
        if byte_at(s, i) == first {
            if substr(s, i, i + n) == needle { return i }
        }
        i = i + 1
    }
    return -1
}

// Index of the first occurrence of needle, or -1.
fn str_find(s: str, needle: str) -> i64 {
    return str_find_from(s, needle, 0)
}

// Split on `delim` — един или повече символи. Празни полета се пазят;
// празен delim връща [s]. (S1 от smtpbaga/gaps.md е затворена: преди
// str_split делеше само по ПЪРВИЯ символ на delim — "\r\n" цепеше на '\r'.)
// Линейно по дължината: str_find_from търси по индекси, substr реже само
// изходните части (няма междинни копия на остатъка).
fn str_split(s: str, delim: str) -> Vec<str> {
    let out = vec_new()
    let dn = len(delim)
    if dn == 0 {
        vec_push(out, s)
        return out
    }
    let mut start: i64 = 0
    let mut idx = str_find_from(s, delim, 0)
    while idx >= 0 {
        vec_push(out, substr(s, start, idx))
        start = idx + dn
        idx = str_find_from(s, delim, start)
    }
    vec_push(out, substr(s, start, len(s)))
    return out
}

fn str_join(parts: Vec<str>, sep: str) -> str {
    let mut out = ""
    for i in 0..vec_len(parts) {
        if i > 0 { out = concat(out, sep) }
        out = concat(out, vec_get(parts, i))
    }
    return out
}

// Replace every occurrence of `from` with `to`.
fn str_replace(s: str, from: str, to: str) -> str {
    let n = len(from)
    if n == 0 { return s }
    let mut out = ""
    let mut i: i64 = 0
    while i + n <= len(s) {
        if substr(s, i, i + n) == from {
            out = concat(out, to)
            i = i + n
        } else {
            out = concat(out, substr(s, i, i + 1))
            i = i + 1
        }
    }
    if i < len(s) { out = concat(out, substr(s, i, len(s))) }
    return out
}

// Trim ASCII whitespace (space, tab, LF, CR) from both ends.
fn str_trim(s: str) -> str {
    let mut a: i64 = 0
    let mut b = len(s)
    let mut moving = true
    while a < b && moving {
        let c = char_at(s, a)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            a = a + 1
        } else {
            moving = false
        }
    }
    moving = true
    while b > a && moving {
        let c = char_at(s, b - 1)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            b = b - 1
        } else {
            moving = false
        }
    }
    return substr(s, a, b)
}

// Repeat a string n times (binary doubling — O(log n) concats).
// The result is heap-allocated and may be overwritten in place by libc
// externs that take a `str` buffer (os/net/io rely on this).
fn str_repeat(s: str, n: i64) -> str {
    // P55: runtime builtin — една алокация вместо O(log n) concat блока.
    return str_repeat_b(s, n)
}

// Parse a base-10 integer; stops at the first non-digit. Leading `-` allowed.
fn parse_int(s: str) -> i64 {
    let mut i: i64 = 0
    let mut sign: i64 = 1
    if len(s) > 0 && char_at(s, 0) == 45 {
        sign = -1
        i = 1
    }
    let mut v: i64 = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c < 48 || c > 57 { return sign * v }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    return sign * v
}

fn int_to_str(n: i64) -> str {
    if n == 0 { return "0" }
    // Трупаме в отрицателна посока: 0 - i64_min прелива (i64_min няма
    // положителен двойник), а -i64_min % 10 и / 10 работят коректно.
    let mut neg = false
    let mut v = n
    if v > 0 {
        v = 0 - v
    } else {
        neg = true
    }
    let mut out = ""
    while v < 0 {
        out = concat(chr(48 + (0 - (v % 10))), out)
        v = v / 10
    }
    if neg { out = concat("-", out) }
    return out
}

// ---------- UTF-8: codepoint-и, не байтове ----------
// Lenient инструменти за броене и обхождане, не валидатор: непълна или
// невалидна последователност се третира като един „символ" (сурови байтове).
// За ASCII str_char_count(s) == len(s).

// Широчина в байтове на последователността при `pos` — по водещия байт,
// clamp-ната до наличните continuation байтове. 0 при pos извън низа.
fn str_utf8_width(s: str, pos: i64) -> i64 {
    let n = len(s)
    if pos < 0 || pos >= n { return 0 }
    let b = byte_at(s, pos)
    let mut w: i64 = 1
    if b >= 192 && b < 224 { w = 2 }
    if b >= 224 && b < 240 { w = 3 }
    if b >= 240 { w = 4 }
    let mut j: i64 = 1
    while j < w && pos + j < n {
        let cb = byte_at(s, pos + j)
        if cb < 128 || cb >= 192 {
            w = j
            j = w
        } else {
            j = j + 1
        }
    }
    if pos + w > n { w = n - pos }
    return w
}

// Брой codepoint-и в низа.
fn str_char_count(s: str) -> i64 {
    let n = len(s)
    let mut pos: i64 = 0
    let mut c: i64 = 0
    while pos < n {
        pos = pos + str_utf8_width(s, pos)
        c = c + 1
    }
    return c
}

// i-тият codepoint като низ (празен при i извън броя).
fn str_char_at(s: str, i: i64) -> str {
    let n = len(s)
    let mut pos: i64 = 0
    let mut k: i64 = 0
    while pos < n {
        let w = str_utf8_width(s, pos)
        if k == i { return substr(s, pos, pos + w) }
        k = k + 1
        pos = pos + w
    }
    return ""
}

// i-тият codepoint като число (U+…); -1 при i извън броя.
fn str_codepoint_at(s: str, i: i64) -> i64 {
    let n = len(s)
    let mut pos: i64 = 0
    let mut k: i64 = 0
    while pos < n {
        let w = str_utf8_width(s, pos)
        if k == i {
            let b0 = byte_at(s, pos)
            let mut cp: i64 = b0
            if w == 2 { cp = b0 - 192 }
            if w == 3 { cp = b0 - 224 }
            if w == 4 { cp = b0 - 240 }
            let mut j: i64 = 1
            while j < w {
                cp = cp * 64 + (byte_at(s, pos + j) - 128)
                j = j + 1
            }
            return cp
        }
        k = k + 1
        pos = pos + w
    }
    return -1
}

// Codepoint → UTF-8 низ; "" при невалиден (извън 0..U+10FFFF).
fn str_from_codepoint(cp: i64) -> str {
    if cp < 0 || cp > 1114111 { return "" }
    if cp < 128 { return byte_chr(cp) }
    if cp < 2048 {
        return concat(byte_chr(192 + cp / 64), byte_chr(128 + cp % 64))
    }
    if cp < 65536 {
        let b1 = byte_chr(224 + cp / 4096)
        let b2 = byte_chr(128 + (cp / 64) % 64)
        let b3 = byte_chr(128 + cp % 64)
        return concat(concat(b1, b2), b3)
    }
    let c1 = byte_chr(240 + cp / 262144)
    let c2 = byte_chr(128 + (cp / 4096) % 64)
    let c3 = byte_chr(128 + (cp / 64) % 64)
    let c4 = byte_chr(128 + cp % 64)
    return concat(concat(concat(c1, c2), c3), c4)
}
