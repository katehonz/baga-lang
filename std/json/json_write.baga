// json_write.baga — JSON serialize: hex digit, escape, рекурсивен
// serialize на DOM възел. Парсерът е в json.baga.

import "json.baga"
import "../str/str.baga"

fn json_hex_digit(v: i64) -> str {
    if v < 10 { return chr(48 + v) }
    return chr(87 + v)
}

// Concat per char is O(n²) and leaks (no GC) — a 1 MB base64 PDF OOMs the
// process. Copy safe runs with one substr; only specials are escaped.
fn json_escape_special(c: i64) -> str {
    if c == 34 {
        return "\\\""
    }
    if c == 92 {
        return "\\\\"
    }
    if c == 10 {
        return "\\n"
    }
    if c == 9 {
        return "\\t"
    }
    if c == 13 {
        return "\\r"
    }
    if c < 32 {
        return concat(concat("\\u00", json_hex_digit((c >> 4) & 15)), json_hex_digit(c & 15))
    }
    return ""
}

fn json_escape(s: str) -> str {
    let n = len(s)
    let mut out = "\""
    let mut start: i64 = 0
    let mut i: i64 = 0
    while i < n {
        let c = char_at(s, i)
        if c == 34 || c == 92 || c < 32 {
            if i > start {
                out = concat(out, substr(s, start, i))
            }
            out = concat(out, json_escape_special(c))
            start = i + 1
        }
        i = i + 1
    }
    if n > start {
        out = concat(out, substr(s, start, n))
    }
    return concat(out, "\"")
}

fn json_serialize(d: JsonDoc, n: i64) -> str {
    let tag = vec_get(d.tags, n)
    if tag == 0 { return "null" }
    if tag == 1 { return "false" }
    if tag == 2 { return "true" }
    if tag == 3 { return vec_get(d.strs, n) }       // raw number text
    if tag == 4 { return json_escape(vec_get(d.strs, n)) }
    if tag == 5 {
        let mut out = "["
        let cnt = vec_get(d.klen, n)
        for i in 0..cnt {
            if i > 0 { out = concat(out, ",") }
            out = concat(out, json_serialize(d, json_at(d, n, i)))
        }
        return concat(out, "]")
    }
    if tag == 6 {
        let mut out = "{"
        let cnt = json_count(d, n)
        for i in 0..cnt {
            if i > 0 { out = concat(out, ",") }
            out = concat(out, json_escape(json_key(d, n, i)))
            out = concat(out, ":")
            out = concat(out, json_serialize(d, json_val(d, n, i)))
        }
        return concat(out, "}")
    }
    return "null"   // error node serializes as null
}

// ---------- strict validation (RFC 8259) ----------
// json_parse above is lenient (best-effort shape recovery). json_strict_valid
// accepts exactly one well-formed JSON document with no trailing input —
// the check to run before sending user JSON to a database or another peer.
// Returns pos past the construct, or -1 on error (mutually recursive).

