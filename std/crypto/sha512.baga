// Initial state: which == 384 → SHA-384, else SHA-512 (FIPS 180-4 §5.3).
fn sha512_init(which: i64) -> Vec<i64> {
    let h = vec_new()
    if which == 384 {
        vec_push(h, 3418070365)   // cbbb9d5d c1059ed8
        vec_push(h, 3238371032)
        vec_push(h, 1654270250)   // 629a292a 367cd507
        vec_push(h, 914150663)
        vec_push(h, 2438529370)   // 9159015a 3070dd17
        vec_push(h, 812702999)
        vec_push(h, 355462360)    // 152fecd8 f70e5939
        vec_push(h, 4144912697)
        vec_push(h, 1731405415)   // 67332667 ffc00b31
        vec_push(h, 4290775857)
        vec_push(h, 2394180231)   // 8eb44a87 68581511
        vec_push(h, 1750603025)
        vec_push(h, 3675008525)   // db0c2e0d 64f98fa7
        vec_push(h, 1694076839)
        vec_push(h, 1203062813)   // 47b5481d befa4fa4
        vec_push(h, 3204075428)
    } else {
        vec_push(h, 1779033703)   // 6a09e667 f3bcc908
        vec_push(h, 4089235720)
        vec_push(h, 3144134277)   // bb67ae85 84caa73b
        vec_push(h, 2227873595)
        vec_push(h, 1013904242)   // 3c6ef372 fe94f82b
        vec_push(h, 4271175723)
        vec_push(h, 2773480762)   // a54ff53a 5f1d36f1
        vec_push(h, 1595750129)
        vec_push(h, 1359893119)   // 510e527f ade682d1
        vec_push(h, 2917565137)
        vec_push(h, 2600822924)   // 9b05688c 2b3e6c1f
        vec_push(h, 725511199)
        vec_push(h, 528734635)    // 1f83d9ab fb41bd6b
        vec_push(h, 4215389547)
        vec_push(h, 1541459225)   // 5be0cd19 137e2179
        vec_push(h, 327033209)
    }
    return h
}

// Core: FIPS 180-4 SHA-512 compression over `data`; which = 384 or 512.
fn sha512_core(data: Vec<i64>, which: i64) -> Vec<i64> {
    // padding: 0x80, zeros to len % 128 == 112, then 16-byte BE bit length
    // (high 8 bytes zero — inputs are far below 2^64 bits)
    let msg = vec_new()
    for i in 0..vec_len(data) {
        vec_push(msg, vec_get(data, i) & 255)
    }
    let n = vec_len(msg)
    vec_push(msg, 128)
    while (vec_len(msg) % 128) != 112 {
        vec_push(msg, 0)
    }
    let bitlen = n * 8
    let mut i: i64 = 15
    while i >= 0 {
        if i >= 8 {
            vec_push(msg, 0)
        } else {
            vec_push(msg, (bitlen >> (i * 8)) & 255)
        }
        i = i + 0 - 1
    }

    let k = sha512_k()
    let st = sha512_init(which)
    let mut block: i64 = 0
    while block < vec_len(msg) {
        // message schedule: 80 words
        let w = vec_new()
        for t in 0..16 {
            let base = block + t * 8
            let hi = (((vec_get(msg, base) << 24) | (vec_get(msg, base + 1) << 16)) | (vec_get(msg, base + 2) << 8)) | vec_get(msg, base + 3)
            let lo = (((vec_get(msg, base + 4) << 24) | (vec_get(msg, base + 5) << 16)) | (vec_get(msg, base + 6) << 8)) | vec_get(msg, base + 7)
            vec_push(w, hi)
            vec_push(w, lo)
        }
        for t in 16..80 {
            let s0 = w_xor(w_xor(rotr64(w_hi(w, t - 15), w_lo(w, t - 15), 1), rotr64(w_hi(w, t - 15), w_lo(w, t - 15), 8)), shr64(w_hi(w, t - 15), w_lo(w, t - 15), 7))
            let s1 = w_xor(w_xor(rotr64(w_hi(w, t - 2), w_lo(w, t - 2), 19), rotr64(w_hi(w, t - 2), w_lo(w, t - 2), 61)), shr64(w_hi(w, t - 2), w_lo(w, t - 2), 6))
            let s = add64(vec_get(s1, 0), vec_get(s1, 1), w_hi(w, t - 7), w_lo(w, t - 7))
            let s2 = add64(vec_get(s, 0), vec_get(s, 1), vec_get(s0, 0), vec_get(s0, 1))
            let s3 = add64(vec_get(s2, 0), vec_get(s2, 1), w_hi(w, t - 16), w_lo(w, t - 16))
            vec_push(w, vec_get(s3, 0))
            vec_push(w, vec_get(s3, 1))
        }

        // working variables a..h = words 0..7 of v
        let v = vec_new()
        for t in 0..8 {
            vec_push(v, vec_get(st, t * 2))
            vec_push(v, vec_get(st, t * 2 + 1))
        }

        for t in 0..80 {
            let bs1 = w_xor(w_xor(rotr64(w_hi(v, 4), w_lo(v, 4), 14), rotr64(w_hi(v, 4), w_lo(v, 4), 18)), rotr64(w_hi(v, 4), w_lo(v, 4), 41))
            let ch = w_xor(w_and(w_from(w_hi(v, 4), w_lo(v, 4)), w_from(w_hi(v, 5), w_lo(v, 5))), w_and(w_not(w_from(w_hi(v, 4), w_lo(v, 4))), w_from(w_hi(v, 6), w_lo(v, 6))))
            // t1 = h + BS1 + ch + K[t] + W[t]
            let a1 = add64(w_hi(v, 7), w_lo(v, 7), vec_get(bs1, 0), vec_get(bs1, 1))
            let a2 = add64(vec_get(a1, 0), vec_get(a1, 1), vec_get(ch, 0), vec_get(ch, 1))
            let a3 = add64(vec_get(a2, 0), vec_get(a2, 1), vec_get(k, t * 2), vec_get(k, t * 2 + 1))
            let t1 = add64(vec_get(a3, 0), vec_get(a3, 1), w_hi(w, t), w_lo(w, t))
            let bs0 = w_xor(w_xor(rotr64(w_hi(v, 0), w_lo(v, 0), 28), rotr64(w_hi(v, 0), w_lo(v, 0), 34)), rotr64(w_hi(v, 0), w_lo(v, 0), 39))
            let maj = w_xor(w_xor(w_and(w_from(w_hi(v, 0), w_lo(v, 0)), w_from(w_hi(v, 1), w_lo(v, 1))), w_and(w_from(w_hi(v, 0), w_lo(v, 0)), w_from(w_hi(v, 2), w_lo(v, 2)))), w_and(w_from(w_hi(v, 1), w_lo(v, 1)), w_from(w_hi(v, 2), w_lo(v, 2))))
            let t2 = add64(vec_get(bs0, 0), vec_get(bs0, 1), vec_get(maj, 0), vec_get(maj, 1))
            // rotate: h=g, g=f, f=e, e=d+t1, d=c, c=b, b=a, a=t1+t2
            let e_new = add64(w_hi(v, 3), w_lo(v, 3), vec_get(t1, 0), vec_get(t1, 1))
            let a_new = add64(vec_get(t1, 0), vec_get(t1, 1), vec_get(t2, 0), vec_get(t2, 1))
            w_set(v, 7, w_from(w_hi(v, 6), w_lo(v, 6)))
            w_set(v, 6, w_from(w_hi(v, 5), w_lo(v, 5)))
            w_set(v, 5, w_from(w_hi(v, 4), w_lo(v, 4)))
            w_set(v, 4, e_new)
            w_set(v, 3, w_from(w_hi(v, 2), w_lo(v, 2)))
            w_set(v, 2, w_from(w_hi(v, 1), w_lo(v, 1)))
            w_set(v, 1, w_from(w_hi(v, 0), w_lo(v, 0)))
            w_set(v, 0, a_new)
        }

        for t in 0..8 {
            let s = add64(vec_get(st, t * 2), vec_get(st, t * 2 + 1), w_hi(v, t), w_lo(v, t))
            vec_set(st, t * 2, vec_get(s, 0))
            vec_set(st, t * 2 + 1, vec_get(s, 1))
        }
        block = block + 128
    }

    // digest: big-endian bytes (SHA-384 truncates to the first 6 words)
    let mut words: i64 = 8
    if which == 384 {
        words = 6
    }
    let out = vec_new()
    for t in 0..words {
        let hi = vec_get(st, t * 2)
        let lo = vec_get(st, t * 2 + 1)
        vec_push(out, (hi >> 24) & 255)
        vec_push(out, (hi >> 16) & 255)
        vec_push(out, (hi >> 8) & 255)
        vec_push(out, hi & 255)
        vec_push(out, (lo >> 24) & 255)
        vec_push(out, (lo >> 16) & 255)
        vec_push(out, (lo >> 8) & 255)
        vec_push(out, lo & 255)
    }
    return out
}

fn sha384_bytes(data: Vec<i64>) -> Vec<i64> {
    return sha512_core(data, 384)
}

fn sha512_bytes(data: Vec<i64>) -> Vec<i64> {
    return sha512_core(data, 512)
}

fn sha384_b(data: bytes) -> bytes {
    return bytes_from_vec(sha384_bytes(vec_from_bytes(data)))
}

fn sha512_b(data: bytes) -> bytes {
    return bytes_from_vec(sha512_bytes(vec_from_bytes(data)))
}

fn sha384_hex(data: Vec<i64>) -> str {
    return bytes_to_hex(sha384_bytes(data))
}

fn sha512_hex(data: Vec<i64>) -> str {
    return bytes_to_hex(sha512_bytes(data))
}
