// sha512.baga — SHA-512 / SHA-384 (FIPS 180-4) on signed i64.
//
// 64-bit words are pairs of 32-bit halves in Vec<i64> (hi, lo interleaved).
// Every half stays < 2^32 and every intermediate sum < 2^33, so signed i64
// never wraps — the same discipline as sha256.baga ("stays below 2^36"),
// which does NOT scale to 64-bit words directly (5 addends × 2^64 > 2^63).
//
// Public API (mirrors sha256.baga):
//   sha384_bytes(Vec<i64>) -> Vec<i64>   (48 bytes)
//   sha512_bytes(Vec<i64>) -> Vec<i64>   (64 bytes)
//   sha384_b(bytes) -> bytes             (the TLS/HKDF entry point)
//   sha512_b(bytes) -> bytes
//   sha384_hex / sha512_hex (Vec<i64>) -> str

import "../bytes/bytes.baga"

fn u32(x: i64) -> i64 {
    return x & 4294967295
}

// ---- 64-bit word ops on (hi, lo) halves ----

// (a_hi:a_lo) + (b_hi:b_lo) mod 2^64 → Vec [hi, lo]
fn add64(a_hi: i64, a_lo: i64, b_hi: i64, b_lo: i64) -> Vec<i64> {
    let lo = a_lo + b_lo                 // < 2^33
    let hi = u32(a_hi + b_hi + (lo >> 32))
    let out = vec_new()
    vec_push(out, hi)
    vec_push(out, u32(lo))
    return out
}

// rotate right by n (1..63)
fn rotr64(hi: i64, lo: i64, n: i64) -> Vec<i64> {
    let out = vec_new()
    if n < 32 {
        vec_push(out, u32((hi >> n) | u32(lo << (32 - n))))
        vec_push(out, u32((lo >> n) | u32(hi << (32 - n))))
    } else {
        if n == 32 {
            vec_push(out, lo)
            vec_push(out, hi)
        } else {
            let m = n - 32
            vec_push(out, u32((lo >> m) | u32(hi << (32 - m))))
            vec_push(out, u32((hi >> m) | u32(lo << (32 - m))))
        }
    }
    return out
}

// shift right by n (SHA-512 needs only 6 and 7, both < 32)
fn shr64(hi: i64, lo: i64, n: i64) -> Vec<i64> {
    let out = vec_new()
    vec_push(out, hi >> n)
    vec_push(out, u32((lo >> n) | u32(hi << (32 - n))))
    return out
}

// word access in an interleaved (hi, lo) vector
fn w_hi(w: Vec<i64>, i: i64) -> i64 {
    return vec_get(w, i * 2)
}

fn w_lo(w: Vec<i64>, i: i64) -> i64 {
    return vec_get(w, i * 2 + 1)
}

fn w_set(w: Vec<i64>, i: i64, v: Vec<i64>) {
    vec_set(w, i * 2, vec_get(v, 0))
    vec_set(w, i * 2 + 1, vec_get(v, 1))
}

fn w_from(hi: i64, lo: i64) -> Vec<i64> {
    let out = vec_new()
    vec_push(out, hi)
    vec_push(out, lo)
    return out
}

fn w_xor(a: Vec<i64>, b: Vec<i64>) -> Vec<i64> {
    return w_from(vec_get(a, 0) ^ vec_get(b, 0), vec_get(a, 1) ^ vec_get(b, 1))
}

// bitwise NOT of the low 32 bits (two's complement idiom from sha256.baga)
fn w_not(a: Vec<i64>) -> Vec<i64> {
    return w_from(u32((-1) ^ vec_get(a, 0)), u32((-1) ^ vec_get(a, 1)))
}

fn w_and(a: Vec<i64>, b: Vec<i64>) -> Vec<i64> {
    return w_from(vec_get(a, 0) & vec_get(b, 0), vec_get(a, 1) & vec_get(b, 1))
}

