// tls.baga — TLS 1.3 client core (apps-roadmap №10 P2, T4–T8).
//
// Record layer, ClientHello builder, ServerHello parser (T4), handshake
// key schedule + encrypted flight (T5), X.509 + RSA-PSS verify (T6):
//
//   tls_client_hello(pub32, random32, sid32) -> bytes   // full record
//   tls_read_record(fd) -> TlsRecord { ok, err, typ, payload }
//   tls_parse_server_hello(payload) -> TlsHello
//   tls_schedule(cipher, ch_msg, sh_msg, shared) -> TlsSchedule
//   tls_open_handshake(sched, ch, sh, chunked) -> TlsFlight
//   tls_finished_record(sched, flight_hash) -> bytes
//   tls_verify_server(flight, anchor_der) -> TlsVerify
//
// ClientHello shape: legacy_version 0x0303, 32-byte session id
// (middlebox compatibility), cipher suites TLS_AES_128/256_GCM,
// extensions: supported_groups (x25519, secp256r1), signature_algorithms
// (rsa_pss_rsae_sha256, ecdsa_secp256r1_sha256), supported_versions
// (0x0304), key_share (x25519 pub).
//
// T6/T7: parse leaf cert (DER), self-signed/anchor trust; CertificateVerify
// via RSA-PSS-SHA256 or ECDSA-P256-SHA256 over the TLS 1.3 context string.

import "tcp.baga"
import "../bytes/bytes.baga"
import "../str/str.baga"
import "../crypto/sha256.baga"
import "../crypto/sha512.baga"
import "../crypto/hmac.baga"
import "../crypto/hkdf.baga"
import "../crypto/aes.baga"
import "../crypto/gcm.baga"
import "../crypto/x509.baga"
import "../crypto/rsa.baga"
import "../crypto/p256.baga"
import "../crypto/ct.baga"
import "../crypto/x25519.baga"
import "../random/random.baga"

// ---------- byte-builder helpers ----------

fn tls_push_u8(v: Vec<i64>, x: i64) {
    vec_push(v, x & 255)
}

fn tls_push_u16(v: Vec<i64>, x: i64) {
    vec_push(v, (x >> 8) & 255)
    vec_push(v, x & 255)
}

fn tls_push_u24(v: Vec<i64>, x: i64) {
    vec_push(v, (x >> 16) & 255)
    vec_push(v, (x >> 8) & 255)
    vec_push(v, x & 255)
}

fn tls_push_bytes(v: Vec<i64>, b: bytes) {
    let mut i: i64 = 0
    while i < bytes_len(b) {
        vec_push(v, bytes_at(b, i))
        i = i + 1
    }
}

// ---------- ClientHello ----------

// One extension: id(2) len(2) data.
fn tls_ext(v: Vec<i64>, id: i64, data: Vec<i64>) {
    tls_push_u16(v, id)
    tls_push_u16(v, vec_len(data))
    let mut i: i64 = 0
    while i < vec_len(data) {
        vec_push(v, vec_get(data, i))
        i = i + 1
    }
}

// The full TLS record carrying the ClientHello.
// sni: host name for the server_name extension (empty string = omit).
fn tls_client_hello(pub32: bytes, random32: bytes, sid32: bytes, sni: str) -> bytes {
    // ---- extensions ----
    let exts = vec_new()
    // server_name (type 0) — required by many real hosts
    if len(sni) > 0 {
        let sn = vec_new()
        tls_push_u16(sn, len(sni) + 3)   // NameList length
        tls_push_u8(sn, 0)               // host_name
        tls_push_u16(sn, len(sni))
        tls_push_bytes(sn, tls_ascii(sni))
        tls_ext(exts, 0, sn)
    }
    // supported_groups: x25519 (0x001d), secp256r1 (0x0017)
    let groups = vec_new()
    tls_push_u16(groups, 4)
    tls_push_u16(groups, 29)
    tls_push_u16(groups, 23)
    tls_ext(exts, 10, groups)
    // signature_algorithms: rsa_pss_rsae_sha256 (0x0804),
    //                       ecdsa_secp256r1_sha256 (0x0403)
    let sigs = vec_new()
    tls_push_u16(sigs, 4)
    tls_push_u16(sigs, 2052)
    tls_push_u16(sigs, 1027)
    tls_ext(exts, 13, sigs)
    // supported_versions: TLS 1.3 (0x0304)
    let sv = vec_new()
    tls_push_u8(sv, 2)
    tls_push_u16(sv, 772)
    tls_ext(exts, 43, sv)
    // key_share: x25519 entry (group 0x001d, 32-byte key)
    let ks = vec_new()
    tls_push_u16(ks, 36)      // key exchange list length: 2+2+32
    tls_push_u16(ks, 29)
    tls_push_u16(ks, 32)
    tls_push_bytes(ks, pub32)
    tls_ext(exts, 51, ks)
    // ---- handshake body ----
    let body = vec_new()
    tls_push_u16(body, 771)          // legacy_version 0x0303
    tls_push_bytes(body, random32)
    tls_push_u8(body, bytes_len(sid32))
    tls_push_bytes(body, sid32)
    tls_push_u16(body, 4)            // cipher suites length
    tls_push_u16(body, 4865)         // TLS_AES_128_GCM_SHA256
    tls_push_u16(body, 4866)         // TLS_AES_256_GCM_SHA384
    tls_push_u8(body, 1)             // compression methods length
    tls_push_u8(body, 0)
    tls_push_u16(body, vec_len(exts))
    let mut e: i64 = 0
    while e < vec_len(exts) {
        vec_push(body, vec_get(exts, e))
        e = e + 1
    }
    // ---- handshake header + record header ----
    let hs = vec_new()
    tls_push_u8(hs, 1)               // client_hello
    tls_push_u24(hs, vec_len(body))
    let mut b: i64 = 0
    while b < vec_len(body) {
        vec_push(hs, vec_get(body, b))
        b = b + 1
    }
    let rec = vec_new()
    tls_push_u8(rec, 22)             // handshake
    tls_push_u16(rec, 769)           // legacy record version 0x0301
    tls_push_u16(rec, vec_len(hs))
    let mut h: i64 = 0
    while h < vec_len(hs) {
        vec_push(rec, vec_get(hs, h))
        h = h + 1
    }
    return bytes_from_vec(rec)
}

// ---------- record layer ----------

struct TlsRecord {
    ok: i64,
    err: str,
    typ: i64,
    payload: bytes
}

fn tls_record_bad(err: str) -> TlsRecord {
    return TlsRecord { ok: 0, err: err, typ: 0, payload: bytes_from_vec(vec_new()) }
}

// Read one TLS record (5-byte header + exact payload).
fn tls_read_record(fd: i64) -> TlsRecord !IO !Net {
    let hdr = tcp_read_exact(fd, 5)?
    if bytes_len(hdr) < 5 {
        return tls_record_bad("short header")
    }
    let typ = bytes_at(hdr, 0)
    let plen = (bytes_at(hdr, 3) << 8) | bytes_at(hdr, 4)
    if plen > 32768 {
        return tls_record_bad("record too large")
    }
    let pl = tcp_read_exact(fd, plen)?
    if bytes_len(pl) < plen {
        return tls_record_bad("short payload")
    }
    return TlsRecord { ok: 1, err: "", typ: typ, payload: pl }
}

// ---------- ServerHello ----------

struct TlsHello {
    ok: i64,
    err: str,
    version: i64,          // from supported_versions (772 = TLS 1.3)
    cipher: i64,
    server_random: bytes,
    server_pub: bytes      // x25519 key_share; empty when absent
}

fn tls_hello_bad(err: str) -> TlsHello {
    return TlsHello { ok: 0, err: err, version: 0, cipher: 0,
        server_random: bytes_from_vec(vec_new()), server_pub: bytes_from_vec(vec_new()) }
}

fn tls_u16_at(b: bytes, off: i64) -> i64 {
    return (bytes_at(b, off) << 8) | bytes_at(b, off + 1)
}

fn tls_parse_server_hello(payload: bytes) -> TlsHello {
    let n = bytes_len(payload)
    if n < 4 || bytes_at(payload, 0) != 2 {
        return tls_hello_bad("not a ServerHello")
    }
    let hslen = (bytes_at(payload, 1) << 16) | (bytes_at(payload, 2) << 8) | bytes_at(payload, 3)
    if 4 + hslen > n {
        return tls_hello_bad("truncated handshake")
    }
    let mut p: i64 = 4
    let legacy = tls_u16_at(payload, p)
    if legacy != 771 {
        return tls_hello_bad("bad legacy version")
    }
    p = p + 2
    let rnd = bytes_slice(payload, p, p + 32)
    p = p + 32
    let sidl = bytes_at(payload, p)
    p = p + 1 + sidl
    if p + 3 > n {
        return tls_hello_bad("truncated body")
    }
    let cipher = tls_u16_at(payload, p)
    p = p + 2
    p = p + 1                       // compression
    let extlen = tls_u16_at(payload, p)
    p = p + 2
    let mut vend = p + extlen
    if vend > n {
        vend = n
    }
    let mut version: i64 = 0
    let mut pub = bytes_from_vec(vec_new())
    while p + 4 <= vend {
        let eid = tls_u16_at(payload, p)
        let elen = tls_u16_at(payload, p + 2)
        p = p + 4
        if p + elen > vend {
            return tls_hello_bad("truncated extension")
        }
        if eid == 43 && elen >= 2 {
            version = tls_u16_at(payload, p)
        }
        if eid == 51 && elen >= 4 {
            // ServerHello key_share is a single KeyShareEntry (no list
            // length — that wrapper exists only in the ClientHello)
            let g = tls_u16_at(payload, p)
            let kl = tls_u16_at(payload, p + 2)
            if g == 29 && kl == 32 && p + 4 + 32 <= vend {
                pub = bytes_slice(payload, p + 4, p + 4 + 32)
            }
        }
        p = p + elen
    }
    return TlsHello { ok: 1, err: "", version: version, cipher: cipher,
        server_random: rnd, server_pub: pub }
}

// ---------- T5: key schedule ----------

fn tls_ascii(s: str) -> bytes {
    let v = vec_new()
    let mut i: i64 = 0
    while i < len(s) {
        vec_push(v, char_at(s, i))
        i = i + 1
    }
    return bytes_from_vec(v)
}

fn tls_zeros(n: i64) -> bytes {
    let v = vec_new()
    let mut i: i64 = 0
    while i < n {
        vec_push(v, 0)
        i = i + 1
    }
    return bytes_from_vec(v)
}

// ---- cipher-suite parameterization (4865 = AES_128_GCM_SHA256,
// 4866 = AES_256_GCM_SHA384): hash, HashLen, key length ----

fn tls_hash_len(cipher: i64) -> i64 {
    if cipher == 4866 {
        return 48
    }
    return 32
}

fn tls_key_len(cipher: i64) -> i64 {
    if cipher == 4866 {
        return 32
    }
    return 16
}

fn tls_hash_b(cipher: i64, data: bytes) -> bytes {
    if cipher == 4866 {
        return sha384_b(data)
    }
    return sha256_b(data)
}

fn tls_hmac_b(cipher: i64, key: bytes, msg: bytes) -> bytes {
    if cipher == 4866 {
        return hmac_sha384_b(key, msg)
    }
    return hmac_sha256_b(key, msg)
}

fn tls_hkdf_extract(cipher: i64, salt: bytes, ikm: bytes) -> bytes {
    if cipher == 4866 {
        return hkdf384_extract(salt, ikm)
    }
    return hkdf_extract(salt, ikm)
}

fn tls_hkdf_expand(cipher: i64, prk: bytes, info: bytes, out_len: i64) -> bytes {
    if cipher == 4866 {
        return hkdf384_expand(prk, info, out_len)
    }
    return hkdf_expand(prk, info, out_len)
}

// HkdfLabel (RFC 8446 §7.1): u16 len | u8 |"tls13 "+label| | u8 |ctx|
fn tls_hkdf_label(cipher: i64, secret: bytes, label: str, ctx: bytes, out_len: i64) -> bytes {
    let lab = bytes_concat(tls_ascii("tls13 "), tls_ascii(label))
    let v = vec_new()
    tls_push_u16(v, out_len)
    tls_push_u8(v, bytes_len(lab))
    tls_push_bytes(v, lab)
    tls_push_u8(v, bytes_len(ctx))
    tls_push_bytes(v, ctx)
    return tls_hkdf_expand(cipher, secret, bytes_from_vec(v), out_len)
}

// The "derived" step's context is the transcript hash of zero messages —
// H of the empty string, NOT an empty context (RFC 8446 §7.1).
fn tls_derive(cipher: i64, secret: bytes) -> bytes {
    return tls_hkdf_label(cipher, secret, "derived", tls_hash_b(cipher, bytes_from_vec(vec_new())), tls_hash_len(cipher))
}

struct TlsSchedule {
    ok: i64,
    err: str,
    cipher: i64,          // negotiated suite (4865 / 4866)
    hs_secret: bytes,     // handshake secret (for master derivation, T8)
    server_hs: bytes,     // server_handshake_traffic_secret
    client_hs: bytes,     // client_handshake_traffic_secret
    sh_hash: bytes        // H(ClientHello || ServerHello)
}

fn tls_schedule_bad(err: str) -> TlsSchedule {
    return TlsSchedule { ok: 0, err: err, cipher: 4865,
        hs_secret: bytes_from_vec(vec_new()),
        server_hs: bytes_from_vec(vec_new()),
        client_hs: bytes_from_vec(vec_new()), sh_hash: bytes_from_vec(vec_new()) }
}

// The handshake key schedule up to the handshake traffic secrets.
fn tls_schedule(cipher: i64, ch_msg: bytes, sh_msg: bytes, shared: bytes) -> TlsSchedule {
    if bytes_len(shared) != 32 {
        return tls_schedule_bad("bad shared secret length")
    }
    let hl = tls_hash_len(cipher)
    let zero = tls_zeros(hl)
    let early = tls_hkdf_extract(cipher, zero, zero)
    let d0 = tls_derive(cipher, early)
    let hs_secret = tls_hkdf_extract(cipher, d0, shared)
    let sh_hash = tls_hash_b(cipher, bytes_concat(ch_msg, sh_msg))
    let server_hs = tls_hkdf_label(cipher, hs_secret, "s hs traffic", sh_hash, hl)
    let client_hs = tls_hkdf_label(cipher, hs_secret, "c hs traffic", sh_hash, hl)
    return TlsSchedule { ok: 1, err: "", cipher: cipher, hs_secret: hs_secret,
        server_hs: server_hs, client_hs: client_hs, sh_hash: sh_hash }
}

// nonce = iv XOR 64-bit sequence (in the last 8 bytes of the 12-byte iv).
fn tls_nonce(iv: bytes, seq: i64) -> bytes {
    let v = vec_new()
    let mut i: i64 = 0
    while i < 12 {
        vec_push(v, bytes_at(iv, i))
        i = i + 1
    }
    let mut s = seq
    let mut j: i64 = 11
    while j >= 4 {
        vec_set(v, j, vec_get(v, j) ^ (s & 255))
        s = s >> 8
        j = j - 1
    }
    return bytes_from_vec(v)
}

fn tls_hdr_bytes(typ: i64, plen: i64) -> bytes {
    let v = vec_new()
    tls_push_u8(v, typ)
    tls_push_u16(v, 771)
    tls_push_u16(v, plen)
    return bytes_from_vec(v)
}

// ---------- T5: encrypted server flight ----------

struct TlsFlight {
    ok: i64,
    err: str,
    types: Vec<i64>,       // handshake message types, in order
    cert_der: bytes,       // first certificate (T6 input)
    cv_sig: bytes,         // CertificateVerify signature
    cv_algo: i64,          // SignatureScheme (e.g. 0x0804 = rsa_pss_rsae_sha256)
    cv_hash: bytes,        // H(CH||SH||EE||Cert) — signed by CertificateVerify
    finished_ok: i64,      // server Finished HMAC verified
    flight_hash: bytes,    // H(CH…server Finished) — client Finished + app traffic
    app_hash: bytes        // same as flight_hash (alias for T8 call sites)
}

fn tls_flight_bad(err: str) -> TlsFlight {
    return TlsFlight { ok: 0, err: err, types: vec_new(),
        cert_der: bytes_from_vec(vec_new()), cv_sig: bytes_from_vec(vec_new()),
        cv_algo: 0, cv_hash: bytes_from_vec(vec_new()),
        finished_ok: 0, flight_hash: bytes_from_vec(vec_new()),
        app_hash: bytes_from_vec(vec_new()) }
}

// Decrypt the application-data records carrying the server handshake
// flight and verify the server Finished. `chunked` is the concatenation
// of (u24 length || record payload)* for each type-23 record in order —
// record i has GCM sequence i (openssl splits EncryptedExtensions into
// its own record; the RFC allows any split). The flat u24 shape predates
// Vec<bytes> (L4, since closed); it is kept because the GCM sequence
// numbers must stay aligned with the record order anyway.
fn tls_open_handshake(sched: TlsSchedule, ch_msg: bytes, sh_msg: bytes, chunked: bytes) -> TlsFlight {
    let key = tls_hkdf_label(sched.cipher, sched.server_hs, "key", bytes_from_vec(vec_new()), tls_key_len(sched.cipher))
    let iv = tls_hkdf_label(sched.cipher, sched.server_hs, "iv", bytes_from_vec(vec_new()), 12)
    let aead = aes_expand(key)
    let mut pt = bytes_from_vec(vec_new())
    let mut seq: i64 = 0
    let mut c: i64 = 0
    let cn = bytes_len(chunked)
    while c + 3 <= cn {
        let plen = (bytes_at(chunked, c) << 16) | (bytes_at(chunked, c + 1) << 8) | bytes_at(chunked, c + 2)
        c = c + 3
        if c + plen > cn {
            return tls_flight_bad("truncated chunked flight")
        }
        let payload = bytes_slice(chunked, c, c + plen)
        c = c + plen
        let aad = tls_hdr_bytes(23, plen)
        let open = gcm_open(aead, tls_nonce(iv, seq), aad, payload)
        if open.ok == 0 {
            return tls_flight_bad(concat("flight decrypt failed at record ", int_to_str(seq)))
        }
        // RFC 8446 §5.2: inner plaintext ends with a content-type byte
        // (22 = handshake); strip it, keep only handshake records.
        let in_len = bytes_len(open.pt)
        if in_len == 0 {
            return tls_flight_bad("empty flight record")
        }
        if bytes_at(open.pt, in_len - 1) == 22 {
            pt = bytes_concat(pt, bytes_slice(open.pt, 0, in_len - 1))
        }
        seq = seq + 1
    }
    let n = bytes_len(pt)
    // walk the handshake messages; transcript = CH || SH || flight-so-far
    let mut acc = bytes_concat(ch_msg, sh_msg)
    let types = vec_new()
    let mut cert_der = bytes_from_vec(vec_new())
    let mut cv_sig = bytes_from_vec(vec_new())
    let mut cv_algo: i64 = 0
    let mut cv_hash = bytes_from_vec(vec_new())
    let mut finished_ok: i64 = 0
    let mut flight_hash = bytes_from_vec(vec_new())
    let mut app_hash = bytes_from_vec(vec_new())
    let mut p: i64 = 0
    while p + 4 <= n {
        let mt = bytes_at(pt, p)
        let ml = (bytes_at(pt, p + 1) << 16) | (bytes_at(pt, p + 2) << 8) | bytes_at(pt, p + 3)
        if p + 4 + ml > n {
            return tls_flight_bad("truncated flight message")
        }
        let msg = bytes_slice(pt, p, p + 4 + ml)
        let body = bytes_slice(pt, p + 4, p + 4 + ml)
        vec_push(types, mt)
        if mt == 11 {
            // Certificate: ctx(1) list_len(3) cert_len(3) cert...
            if bytes_len(body) >= 7 {
                let clen = (bytes_at(body, 4) << 16) | (bytes_at(body, 5) << 8) | bytes_at(body, 6)
                if 7 + clen <= bytes_len(body) {
                    cert_der = bytes_slice(body, 7, 7 + clen)
                }
            }
        }
        if mt == 15 {
            // CertificateVerify: algo(2) sig_len(2) sig...
            // Signed content is H(transcript before this message).
            cv_hash = tls_hash_b(sched.cipher, acc)
            if bytes_len(body) >= 4 {
                cv_algo = (bytes_at(body, 0) << 8) | bytes_at(body, 1)
                let sl = (bytes_at(body, 2) << 8) | bytes_at(body, 3)
                if 4 + sl <= bytes_len(body) {
                    cv_sig = bytes_slice(body, 4, 4 + sl)
                }
            }
        }
        if mt == 20 {
            // Finished: HMAC over the transcript BEFORE this message
            let fin_key = tls_hkdf_label(sched.cipher, sched.server_hs, "finished", bytes_from_vec(vec_new()), tls_hash_len(sched.cipher))
            let expect = tls_hmac_b(sched.cipher, fin_key, tls_hash_b(sched.cipher, acc))
            if bytes_len(body) == tls_hash_len(sched.cipher) {
                if ct_eq_b(body, expect) {
                    finished_ok = 1
                }
            }
            // Server Finished verify_data covers the transcript BEFORE this
            // message (acc). Client Finished and application traffic secrets
            // cover the transcript THROUGH server Finished (RFC 8446 §4.4.4
            // and §7.1). T5's live probe only checked outer record type ≠ 21
            // and missed encrypted decrypt_error alerts (outer type 23).
            app_hash = tls_hash_b(sched.cipher, bytes_concat(acc, msg))
            flight_hash = app_hash
        } else {
            acc = bytes_concat(acc, msg)
        }
        p = p + 4 + ml
    }
    return TlsFlight { ok: 1, err: "", types: types, cert_der: cert_der,
        cv_sig: cv_sig, cv_algo: cv_algo, cv_hash: cv_hash,
        finished_ok: finished_ok, flight_hash: flight_hash, app_hash: app_hash }
}

// ---------- T6: certificate + CertificateVerify ----------

// RFC 8446 §4.4.3: 64 spaces || context || 0x00 || transcript_hash
fn tls_cv_signed_content(transcript_hash: bytes) -> bytes {
    let pad = vec_new()
    let mut i: i64 = 0
    while i < 64 {
        vec_push(pad, 32)
        i = i + 1
    }
    let ctx = tls_ascii("TLS 1.3, server CertificateVerify")
    let z = vec_new()
    vec_push(z, 0)
    return bytes_concat(bytes_concat(bytes_concat(bytes_from_vec(pad), ctx), bytes_from_vec(z)), transcript_hash)
}

struct TlsVerify {
    ok: i64,
    err: str,
    cert_ok: i64,
    cv_ok: i64
}

fn tls_verify_bad(err: str) -> TlsVerify {
    return TlsVerify { ok: 0, err: err, cert_ok: 0, cv_ok: 0 }
}

// Verify the leaf certificate against a caller-supplied trust anchor DER
// (self-signed openssl peers: empty anchor accepts self-signed) and the
// CertificateVerify signature:
//   0x0804 rsa_pss_rsae_sha256  (T6)
//   0x0403 ecdsa_secp256r1_sha256 (T7)
fn tls_verify_server(flight: TlsFlight, anchor_der: bytes) -> TlsVerify {
    if flight.ok == 0 {
        return tls_verify_bad(flight.err)
    }
    let cert = x509_parse(flight.cert_der)
    if cert.ok == 0 {
        return tls_verify_bad(cert.err)
    }
    let mut cert_ok: i64 = 0
    if bytes_len(anchor_der) == 0 {
        if x509_verify_self_signed(cert) == 1 {
            cert_ok = 1
        }
    } else {
        if x509_trust_anchor(flight.cert_der, anchor_der) == 1 {
            cert_ok = 1
        }
    }
    if cert_ok == 0 {
        return TlsVerify { ok: 0, err: "certificate not trusted", cert_ok: 0, cv_ok: 0 }
    }
    let content = tls_cv_signed_content(flight.cv_hash)
    let mut cv_ok: i64 = 0
    if flight.cv_algo == 2052 {   // 0x0804 rsa_pss_rsae_sha256
        if cert.is_rsa == 1 {
            cv_ok = rsa_pss_sha256_verify(cert.n, cert.e, content, flight.cv_sig)
        }
        if cv_ok == 0 {
            return TlsVerify { ok: 0, err: "CertificateVerify RSA-PSS failed",
                cert_ok: 1, cv_ok: 0 }
        }
    } else {
        if flight.cv_algo == 1027 {   // 0x0403 ecdsa_secp256r1_sha256
            if cert.is_ec == 1 {
                cv_ok = ecdsa_p256_verify_sha256(cert.qx, cert.qy, content, flight.cv_sig)
            }
            if cv_ok == 0 {
                return TlsVerify { ok: 0, err: "CertificateVerify ECDSA-P256 failed",
                    cert_ok: 1, cv_ok: 0 }
            }
        } else {
            return TlsVerify { ok: 0, err: "unsupported CertificateVerify algorithm",
                cert_ok: 1, cv_ok: 0 }
        }
    }
    return TlsVerify { ok: 1, err: "", cert_ok: 1, cv_ok: 1 }
}

// ---------- T5: client Finished record ----------

// The encrypted record carrying the client Finished (handshake seq 0).
fn tls_finished_record(sched: TlsSchedule, flight_hash: bytes) -> bytes {
    let fin_key = tls_hkdf_label(sched.cipher, sched.client_hs, "finished", bytes_from_vec(vec_new()), tls_hash_len(sched.cipher))
    let body = tls_hmac_b(sched.cipher, fin_key, flight_hash)
    let hs = vec_new()
    tls_push_u8(hs, 20)
    tls_push_u24(hs, bytes_len(body))
    tls_push_bytes(hs, body)
    let plain = bytes_from_vec(hs)
    let key = tls_hkdf_label(sched.cipher, sched.client_hs, "key", bytes_from_vec(vec_new()), tls_key_len(sched.cipher))
    let iv = tls_hkdf_label(sched.cipher, sched.client_hs, "iv", bytes_from_vec(vec_new()), 12)
    let aead = aes_expand(key)
    // TLSInnerPlaintext = content || content_type (22 = handshake)
    let plain_typed = bytes_concat(plain, hex_decode("16"))
    let aad = tls_hdr_bytes(23, bytes_len(plain_typed) + 16)
    let sealed = gcm_seal(aead, tls_nonce(iv, 0), aad, plain_typed)
    return bytes_concat(tls_hdr_bytes(23, bytes_len(sealed)), sealed)
}

// ---------- T8: application traffic + TlsConn ----------

struct TlsConn {
    ok: i64,
    err: str,
    fd: i64,
    c_key: bytes,
    c_iv: bytes,
    s_key: bytes,
    s_iv: bytes,
    c_seq: i64,
    s_seq: i64
}

fn tls_conn_bad(err: str) -> TlsConn {
    return TlsConn {
        ok: 0, err: err, fd: -1,
        c_key: bytes_from_vec(vec_new()), c_iv: bytes_from_vec(vec_new()),
        s_key: bytes_from_vec(vec_new()), s_iv: bytes_from_vec(vec_new()),
        c_seq: 0, s_seq: 0
    }
}

// Derive application traffic secrets from the handshake secret + app_hash
// (transcript through server Finished).
fn tls_app_secrets(sched: TlsSchedule, app_hash: bytes) -> TlsConn {
    let hl = tls_hash_len(sched.cipher)
    let zero = tls_zeros(hl)
    let d1 = tls_derive(sched.cipher, sched.hs_secret)
    let master = tls_hkdf_extract(sched.cipher, d1, zero)
    let c_app = tls_hkdf_label(sched.cipher, master, "c ap traffic", app_hash, hl)
    let s_app = tls_hkdf_label(sched.cipher, master, "s ap traffic", app_hash, hl)
    return TlsConn {
        ok: 1, err: "", fd: -1,
        c_key: tls_hkdf_label(sched.cipher, c_app, "key", bytes_from_vec(vec_new()), tls_key_len(sched.cipher)),
        c_iv: tls_hkdf_label(sched.cipher, c_app, "iv", bytes_from_vec(vec_new()), 12),
        s_key: tls_hkdf_label(sched.cipher, s_app, "key", bytes_from_vec(vec_new()), tls_key_len(sched.cipher)),
        s_iv: tls_hkdf_label(sched.cipher, s_app, "iv", bytes_from_vec(vec_new()), 12),
        c_seq: 0, s_seq: 0
    }
}

// Strip TLSInnerPlaintext padding: zeros then content-type byte.
struct TlsInner {
    ok: i64,
    typ: i64,
    data: bytes
}

fn tls_inner_open(pt: bytes) -> TlsInner {
    let n = bytes_len(pt)
    if n == 0 {
        return TlsInner { ok: 0, typ: 0, data: bytes_from_vec(vec_new()) }
    }
    let mut i = n - 1
    while i >= 0 && bytes_at(pt, i) == 0 {
        i = i - 1
    }
    if i < 0 {
        return TlsInner { ok: 0, typ: 0, data: bytes_from_vec(vec_new()) }
    }
    return TlsInner { ok: 1, typ: bytes_at(pt, i), data: bytes_slice(pt, 0, i) }
}

// Encrypt one application-data record (inner type 23).
fn tls_conn_seal(conn: TlsConn, plain: bytes) -> bytes {
    let typed = bytes_concat(plain, hex_decode("17"))
    let aead = aes_expand(conn.c_key)
    let aad = tls_hdr_bytes(23, bytes_len(typed) + 16)
    let sealed = gcm_seal(aead, tls_nonce(conn.c_iv, conn.c_seq), aad, typed)
    return bytes_concat(tls_hdr_bytes(23, bytes_len(sealed)), sealed)
}

fn tls_conn_write(conn: TlsConn, plain: bytes) -> TlsConn !Net !IO {
    if conn.ok == 0 {
        return conn
    }
    let rec = tls_conn_seal(conn, plain)
    let w = tcp_write_bytes(conn.fd, rec)?
    if w != 0 {
        return TlsConn {
            ok: 0, err: "tls write failed", fd: conn.fd,
            c_key: conn.c_key, c_iv: conn.c_iv, s_key: conn.s_key, s_iv: conn.s_iv,
            c_seq: conn.c_seq, s_seq: conn.s_seq
        }
    }
    return TlsConn {
        ok: 1, err: "", fd: conn.fd,
        c_key: conn.c_key, c_iv: conn.c_iv, s_key: conn.s_key, s_iv: conn.s_iv,
        c_seq: conn.c_seq + 1, s_seq: conn.s_seq
    }
}

// Decrypt one inbound record. Skips CCS (type 20). Returns data + type
// for application (23) or post-handshake (22); empty data on skip/error.
struct TlsRead {
    conn: TlsConn,
    typ: i64,        // inner content type (23 app, 22 hs, 21 alert, 0 skip/eof)
    data: bytes
}

fn tls_conn_read(conn: TlsConn) -> TlsRead !Net !IO {
    if conn.ok == 0 {
        return TlsRead { conn: conn, typ: 0, data: bytes_from_vec(vec_new()) }
    }
    let r = tls_read_record(conn.fd)?
    if r.ok == 0 {
        // EOF / read error — treat as clean end when payload empty
        return TlsRead {
            conn: TlsConn {
                ok: 0, err: r.err, fd: conn.fd,
                c_key: conn.c_key, c_iv: conn.c_iv, s_key: conn.s_key, s_iv: conn.s_iv,
                c_seq: conn.c_seq, s_seq: conn.s_seq
            },
            typ: 0, data: bytes_from_vec(vec_new())
        }
    }
    if r.typ == 20 {
        // ChangeCipherSpec — middlebox compat, ignore
        return TlsRead { conn: conn, typ: 0, data: bytes_from_vec(vec_new()) }
    }
    if r.typ != 23 {
        return TlsRead { conn: conn, typ: r.typ, data: r.payload }
    }
    let aead = aes_expand(conn.s_key)
    let aad = tls_hdr_bytes(23, bytes_len(r.payload))
    let open = gcm_open(aead, tls_nonce(conn.s_iv, conn.s_seq), aad, r.payload)
    let next = TlsConn {
        ok: 1, err: "", fd: conn.fd,
        c_key: conn.c_key, c_iv: conn.c_iv, s_key: conn.s_key, s_iv: conn.s_iv,
        c_seq: conn.c_seq, s_seq: conn.s_seq + 1
    }
    if open.ok == 0 {
        return TlsRead {
            conn: TlsConn {
                ok: 0, err: "tls decrypt failed", fd: conn.fd,
                c_key: conn.c_key, c_iv: conn.c_iv, s_key: conn.s_key, s_iv: conn.s_iv,
                c_seq: conn.c_seq, s_seq: conn.s_seq
            },
            typ: 0, data: bytes_from_vec(vec_new())
        }
    }
    let inner = tls_inner_open(open.pt)
    if inner.ok == 0 {
        return TlsRead { conn: next, typ: 0, data: bytes_from_vec(vec_new()) }
    }
    return TlsRead { conn: next, typ: inner.typ, data: inner.data }
}

// Read application data until the peer closes (or alert). Skips
// NewSessionTicket / other post-handshake messages.
fn tls_conn_read_app(conn: TlsConn) -> TlsRead !Net !IO {
    let mut c = conn
    let mut acc = bytes_from_vec(vec_new())
    let mut running: i64 = 1
    while running == 1 {
        let r = tls_conn_read(c)?
        c = r.conn
        if r.typ == 0 {
            // eof / skip — if we already have data, stop; else keep going once
            if bytes_len(acc) > 0 || c.ok == 0 {
                running = 0
            }
        } else {
            if r.typ == 23 {
                acc = bytes_concat(acc, r.data)
                // HTTP is complete when we see \r\n\r\n and either
                // Content-Length is satisfied or Connection: close with body.
                // For the mock we read until EOF; keep looping until close.
            } else {
                if r.typ == 21 {
                    // alert
                    running = 0
                }
                // typ 22 = post-handshake (NewSessionTicket) — skip
            }
        }
    }
    return TlsRead { conn: c, typ: 23, data: acc }
}

// Full client handshake on an already-connected fd.
// trust_anchor: empty bytes → accept self-signed leaf (dev/mock).
fn tls_handshake(fd: i64, sni: str, trust_anchor: bytes) -> TlsConn !Net !IO !Random {
    let scalar = bytes_from_vec(random_bytes(32))
    let sid = bytes_from_vec(random_bytes(32))
    let rnd = bytes_from_vec(random_bytes(32))
    let pub = x25519_public(scalar)
    let rec0 = tls_client_hello(pub, rnd, sid, sni)
    let w = tcp_write_bytes(fd, rec0)?
    if w != 0 {
        return tls_conn_bad("ClientHello write failed")
    }
    let ch_msg = bytes_slice(rec0, 5, bytes_len(rec0))

    let sh_rec = tls_read_record(fd)?
    if sh_rec.ok == 0 {
        return tls_conn_bad("ServerHello read failed")
    }
    let sh_msg = sh_rec.payload
    let shello = tls_parse_server_hello(sh_msg)
    if shello.ok == 0 {
        return tls_conn_bad(shello.err)
    }
    if shello.cipher != 4865 && shello.cipher != 4866 {
        return tls_conn_bad("unsupported cipher (want TLS_AES_128_GCM_SHA256 or TLS_AES_256_GCM_SHA384)")
    }
    let shared = x25519(scalar, shello.server_pub)
    let sched = tls_schedule(shello.cipher, ch_msg, sh_msg, shared)
    if sched.ok == 0 {
        return tls_conn_bad(sched.err)
    }

    // Collect encrypted handshake flight (skip CCS). openssl s_server
    // typically splits EE | Cert | CV+Fin across 3–4 type-23 records and
    // may send a middlebox CCS. Match the live probe: take 4 app records.
    let mut chunked = bytes_from_vec(vec_new())
    let mut recs: i64 = 0
    while recs < 4 {
        let r = tls_read_record(fd)?
        if r.ok == 0 {
            return tls_conn_bad("flight record failed")
        }
        if r.typ == 23 {
            let ln = bytes_len(r.payload)
            let hd = vec_new()
            vec_push(hd, (ln >> 16) & 255)
            vec_push(hd, (ln >> 8) & 255)
            vec_push(hd, ln & 255)
            chunked = bytes_concat(bytes_concat(chunked, bytes_from_vec(hd)), r.payload)
            recs = recs + 1
        }
        // typ 20 CCS ignored (does not count)
    }
    let flight = tls_open_handshake(sched, ch_msg, sh_msg, chunked)
    if flight.ok == 0 || flight.finished_ok == 0 {
        return tls_conn_bad(concat("handshake flight: ", flight.err))
    }
    let ver = tls_verify_server(flight, trust_anchor)
    if ver.ok == 0 {
        return tls_conn_bad(concat("cert/CV: ", ver.err))
    }

    // client Finished (handshake keys)
    let fin = tls_finished_record(sched, flight.flight_hash)
    let w2 = tcp_write_bytes(fd, fin)?
    if w2 != 0 {
        return tls_conn_bad("client Finished write failed")
    }

    // application traffic keys
    let mut conn = tls_app_secrets(sched, flight.app_hash)
    conn = TlsConn {
        ok: 1, err: "", fd: fd,
        c_key: conn.c_key, c_iv: conn.c_iv, s_key: conn.s_key, s_iv: conn.s_iv,
        c_seq: 0, s_seq: 0
    }
    return conn
}

// True when host is dotted IPv4 (no SNI — many servers reject IP names).
fn tls_host_is_ipv4(host: str) -> i64 {
    let mut i: i64 = 0
    let mut dots: i64 = 0
    while i < len(host) {
        let c = char_at(host, i)
        if c == 46 {
            dots = dots + 1
        } else {
            if c < 48 || c > 57 {
                return 0
            }
        }
        i = i + 1
    }
    if dots == 3 {
        return 1
    }
    return 0
}

// Connect + handshake. Host is used for TCP; SNI is the host name unless
// it is a dotted IPv4 address (then SNI is omitted).
fn tls_connect(host: str, port: i64, timeout_s: i64, trust_anchor: bytes) -> TlsConn !Net !IO !Random {
    let fd = tcp_connect_to(host, port, timeout_s)?
    if fd < 0 {
        return tls_conn_bad("tcp connect failed")
    }
    let mut sni = host
    if tls_host_is_ipv4(host) == 1 {
        sni = ""
    }
    return tls_handshake(fd, sni, trust_anchor)?
}

fn tls_conn_close(conn: TlsConn) -> i64 !Net !IO {
    if conn.fd >= 0 {
        tcp_close(conn.fd)?
    }
    return 0
}
